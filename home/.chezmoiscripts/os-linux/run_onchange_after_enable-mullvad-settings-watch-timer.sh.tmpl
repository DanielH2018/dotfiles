#!/usr/bin/env bash
# Enable the Mullvad settings drift check on a personal, non-WSL Linux desktop; disable it on
# every other Linux host. Two settings on this box are worth 6-12x of the line rate, and both
# can be changed by things that do not announce themselves — the desktop app writes
# settings.json directly, and dnf5-automatic upgrades mullvad-vpn overnight. A tunnel running
# at a tenth of line rate looks exactly like a healthy one from the outside. run_onchange
# re-runs (and reloads systemd) whenever the unit files or this gate change; their hashes are
# embedded so edits retrigger it, and the gate change itself retriggers it once on every host
# to clean up.
#
# Ran unconditionally on every Linux host before this gate. Mullvad is rarely installed on a
# headless server, so the old script's own settings.json guard already no-opped there in
# practice — this makes that explicit and covers the case where Mullvad IS present.
#
# Turn it off with `systemctl --user mask mullvad-settings-watch.timer`; a plain `disable` is
# undone by the next apply.
#   service: {{ include "dot_config/systemd/user/mullvad-settings-watch.service" | sha256sum }}
#   timer:   {{ include "dot_config/systemd/user/mullvad-settings-watch.timer" | sha256sum }}
set -eu
if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  systemctl --user daemon-reload || true
{{ if includeTemplate "is-desktop-linux" . -}}
  # No Mullvad, nothing to watch. The check itself would exit 2 forever on such a machine.
  if [ -r /etc/mullvad-vpn/settings.json ]; then
    # A masked timer is the documented opt-out, so it is the one state this must not undo.
    if [ "$(systemctl --user is-enabled mullvad-settings-watch.timer 2>/dev/null)" != masked ]; then
      systemctl --user enable --now mullvad-settings-watch.timer || true
    fi
  fi
{{ else -}}
  systemctl --user disable --now mullvad-settings-watch.timer 2>/dev/null || true
{{ end -}}
fi

[Unit]
Description=Prune stale Claude config state per the retention manifest
# The server repo's monitoring does not read user units, so without this a failed sweep is
# visible only to someone who asks systemd. The handler records it for the statusline and syslog.
OnFailure=retention-sweep-failed.service

[Service]
Type=oneshot
# --apply is what makes this the automated half of M12. The sweeper's own containment
# (source-level row list, per-row glob prefix, grace floors) is what makes that safe;
# this unit deliberately passes no other argument.
ExecStart=%h/.local/bin/retention-sweep --apply
# The sweep itself deletes %S/retention-sweep/failed when an --apply run finishes with no
# errors. An ExecStartPost here also ran after a run that skipped on the lock, which exits 0.
# Hygiene must never compete with an interactive session for CPU or disk. A19-25's
# lesson: a sweep that makes the machine feel slow gets disabled, and then caps nothing.
Nice=10
IOSchedulingClass=idle
# stdout is the record. journald already rotates it, which is why the sweeper writes no
# log file of its own. A journald that stores only notice and above drops stdout; the
# sweeper marks its stderr lines err so the reason for a failure survives.
StandardOutput=journal
StandardError=journal

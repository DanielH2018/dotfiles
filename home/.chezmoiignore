# tasklist.exe / taskkill.exe symlinks point into /mnt/c (taskkill is used by agentview to
# end Windows panes), so deploy them only on WSL (a linux kernel reporting "microsoft").
# Elsewhere they'd be dangling symlinks.
{{ if not (and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease))) }}
.local/bin/tasklist.exe
.local/bin/taskkill.exe
{{ end }}

# yazi: plugin & flavor code is vendored by `ya pkg install` from the tracked
# package.toml, so don't manage the fetched dirs — except the hand-written
# linemode-cycle plugin, which IS tracked here.
.config/yazi/plugins/*
!.config/yazi/plugins/linemode-cycle.yazi
.config/yazi/flavors

# nvim: lazy's lockfile is machine-local (stable branches, no pinning).
.config/nvim/lazy-lock.json

# Python bytecode. tq imports its library from .local/share/tq, so running it —
# or its tests — from the source tree writes __pycache__ next to the source.
# A global gitignore keeps that out of `git status`, so chezmoi is the only thing
# that sees it, and without this it deploys the .pyc files as managed dotfiles.
**/__pycache__

# Python test and environment scratch, for the same reason and with a worse blast
# radius: the vault-tooling projects are pytest projects living in the source
# tree, so `uv sync` or a bare `pytest` there drops a .venv or .pytest_cache next
# to managed files. The wired suites avoid both (`--no-project`,
# `-p no:cacheprovider`), but running them by hand should not be able to deploy a
# few thousand files into ~/.claude.
**/.venv
**/.pytest_cache

# claude artifacts: ~/.claude/artifacts is local scratch for plan/spec renders.
# Don't manage the dir by default — blocks `chezmoi add` on ad-hoc artifacts so
# scratch can't be swept upstream. Track only the specific plan files kept here.
.claude/artifacts/*
!.claude/artifacts/homelab-mcp-health-sweep_2026-07-23.html
!.claude/artifacts/homelab-mcp-health-sweep_2026-07-23.md

# Machine-local overrides must never enter this (public) repo. Blocks `chezmoi add`
# on any *.local.* file so a permission/secret override can't be swept upstream.
**/*.local.json
**/*.local.md
**/*.local.zsh
**/*.local.env
**/local.config

# Don't regenerate the terminal cheatsheet on every apply. The generator
# (~/.local/bin/terminal-cheatsheet) is still deployed — run it by hand when the
# WezTerm / Neovim / Yazi keybindings change.
.chezmoiscripts/post-install/terminal-cheatsheet.sh

# The work overlay merged into settings.json by modify_settings.json.sh.tmpl. It
# doesn't match *.local.* above, so without this a `chezmoi add` would sweep a
# work-machine permission set into this public repo.
.config/claude/settings.work.json
**/*.work.json

# ~/.ssh/config holds client-side Host entries (IdentityFiles, the artifact-port
# forward) that only mean something from a workstation. The homelab hosts are what
# those entries connect TO, and neither has the referenced keys.
{{ if has .chezmoi.hostname (list "daniel-server" "daniel-pi") }}
.ssh/config
{{ end }}

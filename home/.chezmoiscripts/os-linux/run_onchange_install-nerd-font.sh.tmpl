{{ if includeTemplate "is-desktop-linux" . -}}
#!/bin/sh
# Managed by chezmoi (run_onchange). Installs IosevkaTerm Nerd Font — the family
# .chezmoidata/terminal.toml names and Ghostty/WezTerm/starship all render with — so the prompt's
# Nerd Font glyphs resolve on a Linux desktop. The counterpart to
# os-windows/run_onchange_install-nerd-font.ps1.tmpl.
#
# Per-user (~/.local/share/fonts), unlike the Windows script's system-wide install: fontconfig
# picks up a user font directory automatically for every app in the session, so there is nothing
# to elevate and no UAC-equivalent prompt.
#
# Gated to a non-WSL workstation: fonts are rendered by whatever draws the terminal, so a headless
# server has no use for them and WSL's terminal uses the font installed on the Windows host.
# Re-runs only when this file changes.
# bump-to-reinstall: iosevkaterm-linux v1
set -u
TAG=install-nerd-font
{{ includeTemplate "linux-install.sh" . }}

FONT_DIR="$HOME/.local/share/fonts/IosevkaTermNerdFont"
FAMILY="IosevkaTerm Nerd Font Mono"

command -v unzip >/dev/null 2>&1 || {
  echo "$TAG: unzip missing; skipping (the CLI-tools installer provides it — re-run 'chezmoi apply' after it)" >&2
  exit 0
}

# Version-aware, matching how the CLI-tools installer treats its release binaries: re-fetch when
# the font is absent OR the recorded nerd-fonts tag is stale, so a re-apply upgrades in place.
# install_release_files wants the tag already resolved (see linux-install.sh section 6).
tag="$(latest_tag ryanoasis/nerd-fonts)"
if [ -z "$tag" ]; then
  echo "$TAG: could not resolve the latest nerd-fonts tag" >&2
  exit 0
fi

# Checked here rather than left to install_release_files alone: its return code is 0 both when
# it skips an already-current dest and when it installs fresh files, so distinguishing "no-op"
# from "just installed" — needed below to gate the fc-cache rebuild — means pre-empting the
# no-op case ourselves. Once we're past this, a 0 return always means files actually landed.
old="$(recorded_tag iosevkaterm-font)"
if [ -d "$FONT_DIR" ] && [ "$old" = "$tag" ]; then
  echo "$TAG: [skip] $FAMILY already at $tag."
  exit 0
fi

# Mono only — the same subset the Windows installer takes. The propo/variable faces in the
# archive would otherwise win font matching for the terminal and break cell alignment.
if install_release_files iosevkaterm-font "$tag" \
     "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/IosevkaTerm.zip" \
     "$FONT_DIR" '*Mono*.ttf' 0644; then
  if command -v fc-cache >/dev/null 2>&1; then
    fc-cache -f "$FONT_DIR" >/dev/null 2>&1 || true
  else
    echo "$TAG: fc-cache not found; the font is installed but the cache was not rebuilt" >&2
  fi
fi
{{ end -}}

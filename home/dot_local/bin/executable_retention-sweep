#!/usr/bin/env bash
# retention-sweep: M12 sweeper over the retention manifest (slices 1-3).
#
# Reads retention-manifest.json and, for every row, reports how many entries currently
# match its glob and their combined size. With --apply it also acts on them.
#
# Slice 3 turns this from a hand-run tool into an unattended one, so the containment
# that mattered in slice 2 matters more here:
#
#   1. Acting still requires --apply. The default is a pure report.
#   2. A row acts only if it is in APPLY_ROWS below — a source literal, never derived
#      from the manifest, so adding a manifest row cannot grant itself a delete path.
#   3. Every removal must resolve to a path *underneath its own glob's literal prefix*.
#      That prefix comes from the manifest entry being processed, so a rule can only
#      ever reach inside the directory it names. Symlinks are refused outright.
#   4. An unparseable cap is a refusal, not a default. A typo in the manifest reports
#      "cap not understood" and acts on nothing.
#   5. One sweep at a time, via flock. A hook-fired run colliding with the timer exits
#      quietly rather than racing it.
#
# The grace floor sits under all of it: nothing younger than its row's grace is
# eligible, whatever else is true of it.
#
# SCOPE: removal rules act under --apply, via APPLY_ROWS, same as before. rotate-size
# and truncate-lines rewrite a file a live process may hold open, a different failure
# mode from removing a stale one, so they do not inherit --apply's automation for free.
# They get a second, explicit flag, --rotate, and a second source-level row set,
# ROTATE_ROWS. --apply alone must never rotate or truncate anything: acting on a
# ROTATE_ROWS row requires --apply AND --rotate together. The hourly timer passes
# --apply only, so rotation stays manual until it earns its own supervised run and a
# separate, deliberate decision to add --rotate to the timer unit.
#
# ROTATE_ROWS covers G8, G9, G10, G13, G19. G11 is excluded on purpose: its glob contains the
# literal "cwd" marker and is skipped for every rule, unconditionally, before any row set
# is consulted (see the cwd check in the sweep loop) — it is out of scope for every
# sweeper mode, not specifically for rotation.
#
# There is no log file on purpose. stdout goes to the systemd journal, which is already
# rotated; a hand-rolled ~/.claude/logs/retention-sweep.log would be a new unbounded
# path, and the rotation rule that would have capped it is exactly what this slice
# defers. The run marker below is a fixed-size file, overwritten each run.
#
# On kill -0 and pid reuse: for a *deletion* decision the failure directions are safe.
# A live same-user process always answers "alive", so a live session's file is never
# pruned. A reused pid answers "alive" and the stale file survives to the next run. A
# pid inherited by another user's process answers "dead" (EPERM), but reuse means the
# original exited, so the file it named really is stale. This is NOT the origin
# reaper's problem, which sends SIGTERM and does need identity.sh's (pid, procStart).
#
# Test seams: RETENTION_MANIFEST, RETENTION_SIBLING_CANDIDATES (G12's live-sibling
# search list), RETENTION_STATE_DIR (run marker location), RETENTION_LOCK.
set -u

MANIFEST="${RETENTION_MANIFEST:-$HOME/.claude/retention-manifest.json}"
STATE_DIR="${RETENTION_STATE_DIR:-$HOME/.claude}"
MARKER="$STATE_DIR/.retention-sweep-last-run"
LOCK="${RETENTION_LOCK:-${XDG_RUNTIME_DIR:-/tmp}/retention-sweep.lock}"

# Every row the sweeper may act on: the removal rules only. N1/N2 are native or
# self-managed; G8/G9/G10/G11/G13 are rotate/truncate, gated separately below.
APPLY_ROWS=" G1 G2 G3 G4 G5 G6 G7 G12 G14 G15 G16 G17 "

# The rotate/truncate rows. A source literal, same reasoning as APPLY_ROWS: reading it
# from the manifest would mean a manifest edit could grant itself a rewrite path. Acting
# on a row here additionally requires --rotate, on top of --apply.
ROTATE_ROWS=" G8 G9 G10 G13 G19 "

APPLY=0
ROTATE=0
for arg in "$@"; do
  case "$arg" in
    --apply) APPLY=1 ;;
    --rotate) ROTATE=1 ;;
    -h|--help) sed -n '2,52p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "retention-sweep: unknown argument $arg" >&2; exit 2 ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo "retention-sweep: jq required" >&2; exit 1; }
[ -f "$MANIFEST" ] || { echo "retention-sweep: manifest not found at $MANIFEST" >&2; exit 1; }

NOW=$(date +%s)
MEASURED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# --- stat/du portability --------------------------------------------------------------
# `stat -c` and `du -sb` are GNU spellings. Only the systemd timer that drives this is
# Linux-only; the script itself deploys to every machine (nothing in .chezmoiignore holds
# it back), so on a Mac without coreutils every one of these calls failed and the whole
# sweeper degraded silently: mtime came back empty, so each entry was kept as "unreadable
# mtime", and both rewrite primitives returned 1 before touching a file. A report that
# prunes nothing and blames the filesystem looks exactly like a converged box.
#
# Probed once rather than branched on uname: what matters is which stat is first on PATH,
# and a Mac with coreutils installed gets the GNU one.
if stat -c%Y . >/dev/null 2>&1; then
  file_mtime() { stat -c%Y "$1"; }
  file_size()  { stat -c%s "$1"; }
  file_mode()  { stat -c%a "$1"; }
  dir_bytes()  { du -sb "$1" 2>/dev/null | cut -f1; }
else
  file_mtime() { stat -f%m "$1"; }
  file_size()  { stat -f%z "$1"; }
  file_mode()  { stat -f%Lp "$1"; }
  # BSD du has no apparent-size flag, so this reports allocated KiB rather than the sum of
  # file sizes. It feeds the report's byte totals only — no decision reads it.
  dir_bytes()  { local k; k=$(du -sk "$1" 2>/dev/null | cut -f1) && echo $(( k * 1024 )); }
fi

# --- cap and grace parsing ------------------------------------------------------------
# Caps in the manifest are prose ("14d", "mtime+24h", "kill -0 fails / 14d"). Each
# parser returns empty when it cannot understand its input, and an empty parse is always
# a refusal at the call site — never a fallback value.

grace_seconds() {
  case "$1" in
    ''|null) echo 0 ;;
    *h) echo $(( ${1%h} * 3600 )) ;;
    *d) echo $(( ${1%d} * 86400 )) ;;
    *m) echo $(( ${1%m} * 60 )) ;;
    *) echo 999999999 ;;   # unreadable grace = nothing is ever eligible
  esac
}

# "14d" | "mtime+24h" | "kill -0 fails / 14d" -> seconds
age_cap_seconds() {
  local h d
  h=$(printf '%s' "$1" | grep -oE 'mtime\+[0-9]+h' | head -1)
  if [ -n "$h" ]; then h=${h#mtime+}; echo $(( ${h%h} * 3600 )); return; fi
  d=$(printf '%s' "$1" | grep -oE '[0-9]+d' | head -1)
  if [ -n "$d" ]; then echo $(( ${d%d} * 86400 )); return; fi
  echo ""
}

# "1MB, keep 3 gen" | "5MB" -> bytes. Empty on anything not matching a leading
# <number><MB|KB|GB> — an unparseable cap is a refusal at the call site, never a default.
rotate_size_bytes() {
  local m
  m=$(printf '%s' "$1" | grep -oE '^[0-9]+GB'); [ -n "$m" ] && { echo $(( ${m%GB} * 1024 * 1024 * 1024 )); return; }
  m=$(printf '%s' "$1" | grep -oE '^[0-9]+MB'); [ -n "$m" ] && { echo $(( ${m%MB} * 1024 * 1024 )); return; }
  m=$(printf '%s' "$1" | grep -oE '^[0-9]+KB'); [ -n "$m" ] && { echo $(( ${m%KB} * 1024 )); return; }
  echo ""
}

# "1MB, keep 3 gen" -> 3; "5MB" (no generation count given) -> the default, 3. Unlike the
# size portion, a missing generation count is not a parse failure — the manifest rows
# that omit it (G11) mean "use the default", per spec.
rotate_gens() {
  local g
  g=$(printf '%s' "$1" | grep -oE 'keep [0-9]+ gen')
  if [ -n "$g" ]; then g=${g#keep }; echo "${g% gen}"; return; fi
  echo 3
}

# "keep last 2000" -> 2000. Empty on anything else — refusal, not a default.
truncate_lines_n() {
  local n
  n=$(printf '%s' "$1" | grep -oE 'keep last [0-9]+')
  if [ -n "$n" ]; then echo "${n#keep last }"; return; fi
  echo ""
}

pid_is_live() { kill -0 "$1" 2>/dev/null; }

# The pid comes from the filename shape, not a manifest field, so the manifest stays
# pure policy data. A name matching no known shape yields no pid and is never pruned.
pid_from_path() {
  local base=${1##*/} p=
  case "$base" in
    .agentview-fzfport.*) p=${base#.agentview-fzfport.} ;;
    .claude.json.tmp.*)   p=${base#.claude.json.tmp.}; p=${p%%.*} ;;   # contents never opened
    *.json)               p=${base%.json} ;;
  esac
  case "$p" in
    ''|*[!0-9]*) return 1 ;;
    *) printf '%s' "$p" ;;
  esac
}

# G12 only. Candidates are an explicit, bounded list — never a filesystem walk.
live_sibling_newer_than() {
  local target_mtime=$1 cands=${RETENTION_SIBLING_CANDIDATES:-} c m
  [ -n "$cands" ] || cands="${CLAUDE_PROJECT_DIR:-}/.claude/logs/permissions.json:$PWD/.claude/logs/permissions.json"
  local IFS=:
  for c in $cands; do
    [ -n "$c" ] && [ -f "$c" ] || continue
    m=$(file_mtime "$c" 2>/dev/null) || continue
    [ "$m" -gt "$target_mtime" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

# --- containment ----------------------------------------------------------------------
# The literal directory prefix of a glob: everything before the first wildcard. A rule
# may only remove something underneath its own prefix, so a row's blast radius is the
# directory the manifest names for it and nothing else. This is what makes the recursive
# removal below safe enough to run unattended.
glob_prefix() {
  local p=${1%%[*?[]*}
  printf '%s' "${p%/*}"
}

# Contained iff the resolved entry sits strictly under the resolved prefix. Refuses a
# symlink outright, so a link inside a swept directory cannot redirect a removal out of
# it, and refuses the prefix itself so a rule can never delete its own parent.
contained() {
  local prefix=$1 entry=$2 rp re
  [ -L "$entry" ] && return 1
  rp=$(readlink -f "$prefix" 2>/dev/null) || return 1
  re=$(readlink -f "$entry" 2>/dev/null) || return 1
  { [ -n "$rp" ] && [ -n "$re" ] && [ "$rp" != "$re" ]; } || return 1
  case "$re" in "$rp"/*) return 0 ;; esac
  return 1
}

# --- rotate/truncate primitives ---------------------------------------------------------
# Rotation and truncation rewrite a file a live process may hold open — a different
# failure mode from removing a stale one. Both primitives are rename-then-create-fresh:
# the original inode is never opened for in-place writing, so the worst case of a race
# with a concurrent writer is a few interleaved lines landing in the old segment, never
# data loss. These two functions are the only place `mv` or `tail -n` appear in this
# script — a structural test pins that.

# f -> f.1 -> f.2 ... -> f.$gens, dropping whatever was at f.$gens. Shifting from the
# oldest surviving generation upward means the drop is an ordinary mv overwrite, not a
# separate delete: mv f.$((gens-1)) onto an existing f.$gens replaces it atomically, so
# rotation never needs its own rm call site.
rotate_by_size() {
  local f=$1 gens=$2 mode i
  mode=$(file_mode "$f") || return 1
  i=$((gens - 1))
  while [ "$i" -ge 1 ]; do
    if [ -e "$f.$i" ]; then
      mv -f -- "$f.$i" "$f.$((i + 1))" || return 1
    fi
    i=$((i - 1))
  done
  mv -f -- "$f" "$f.1" || return 1
  touch -- "$f" || return 1
  chmod "$mode" "$f"
}

# Writes the last N lines to a temp file in the same directory, restores the original
# mode on the temp file, then renames it over the original — never truncates in place.
truncate_lines_file() {
  local f=$1 n=$2 mode tmp
  mode=$(file_mode "$f") || return 1
  tmp="$f.tmp.$$"
  tail -n "$n" -- "$f" > "$tmp" || return 1
  chmod "$mode" "$tmp" || return 1
  mv -f -- "$tmp" "$f"
}

# Folds this run's per-row measurements back into the manifest as a `measured: {at,
# count, bytes}` object -- replacing the stale, hand-typed notes prose ("1180 dirs, 4.7M
# dirents", "measured 2026-07-30") with a number the sweep itself just produced. Runs on
# every invocation, dry-run included: the measurement reflects what currently matches,
# independent of whether this run acted on it. `updates` is a JSON array of
# {id, at, count, bytes} objects, one per row the loop in sweep() processed --
# native/self-managed rows never reach it, so they keep whatever notes they already
# have. Every field but `.measured` passes through jq unchanged. Same rename-then-replace
# shape as truncate_lines_file above: never edits the manifest in place.
write_measurements() {
  local manifest=$1 updates=$2 tmp updated
  [ "$updates" = "[]" ] && return 0
  updated=$(jq --argjson updates "$updates" '
      reduce $updates[] as $u (.;
        map(if .id == $u.id then .measured = {at: $u.at, count: $u.count, bytes: $u.bytes} else . end)
      )
    ' "$manifest") || return 1
  [ -n "$updated" ] || return 1
  tmp="$manifest.tmp.$$"
  printf '%s\n' "$updated" > "$tmp" && mv -f -- "$tmp" "$manifest"
}

# --- the sweep ------------------------------------------------------------------------

sweep() {
  local total_pruned=0 total_bytes=0 total_rotated=0 total_rotated_bytes=0 rows=0 errors=0

  if [ "$APPLY" -eq 1 ]; then echo "retention-sweep — APPLY"; else echo "retention-sweep — DRY RUN"; fi
  echo "manifest: $MANIFEST"
  echo

  shopt -s nullglob globstar dotglob

  # Every processed row's live match count/bytes, written back into the manifest as a
  # `measured` object once the loop finishes -- see the write-back after the loop for
  # why this replaces the file's stale, hand-typed notes prose ("1180 dirs, 4.7M
  # dirents", "measured 2026-07-30") with a number the sweep itself produced.
  local measure_updates='[]'

  local row_count i row id rule finding grace cap acting rotating tag
  row_count=$(jq 'length' "$MANIFEST")
  i=0
  while [ "$i" -lt "$row_count" ]; do
    row=$(jq -c ".[$i]" "$MANIFEST")
    i=$((i + 1))
    rows=$((rows + 1))

    id=$(printf '%s' "$row" | jq -r '.id')
    rule=$(printf '%s' "$row" | jq -r '.rule')
    finding=$(printf '%s' "$row" | jq -r '.finding')
    grace=$(printf '%s' "$row" | jq -r '.grace // ""')
    cap=$(printf '%s' "$row" | jq -r '.cap')

    if [ "$rule" = "native" ] || [ "$rule" = "self-managed" ]; then
      echo "[dry-run] $id: rule=$rule -> no action, out of scope for this sweeper ($finding)"
      continue
    fi

    acting=0
    case "$APPLY_ROWS" in *" $id "*) [ "$APPLY" -eq 1 ] && acting=1 ;; esac
    rotating=0
    case "$ROTATE_ROWS" in *" $id "*) [ "$APPLY" -eq 1 ] && [ "$ROTATE" -eq 1 ] && rotating=1 ;; esac
    if [ "$acting" -eq 1 ]; then tag='[apply]'; elif [ "$rotating" -eq 1 ]; then tag='[rotate]'; else tag='[dry-run]'; fi

    local globs count bytes oldest_days pruned pruned_bytes kept_reason min_age
    mapfile -t globs < <(printf '%s' "$row" | jq -r 'if (.path | type) == "array" then .path[] else .path end')
    count=0; bytes=0; oldest_days=""; pruned=0; pruned_bytes=0; kept_reason=""
    min_age=$(grace_seconds "$grace")

    local g expanded prefix f b mtime age_days pid sibling n lc newsize
    for g in "${globs[@]}"; do
      expanded="${g/#\~/$HOME}"
      [[ "$expanded" == *cwd* ]] && continue   # G11: per-cwd, not a fixed glob
      prefix=$(glob_prefix "$expanded")
      for f in $expanded; do
        [ -e "$f" ] || continue
        count=$((count + 1))
        if [ -d "$f" ]; then b=$(dir_bytes "$f"); else b=$(file_size "$f" 2>/dev/null); fi
        bytes=$((bytes + ${b:-0}))
        mtime=$(file_mtime "$f" 2>/dev/null || echo "")
        if [ -n "$mtime" ]; then
          age_days=$(( (NOW - mtime) / 86400 ))
          if [ -z "$oldest_days" ] || [ "$age_days" -gt "$oldest_days" ]; then oldest_days=$age_days; fi
        fi

        [ "$acting" -eq 1 ] || [ "$rotating" -eq 1 ] || continue
        [ -n "$mtime" ] || { kept_reason="unreadable mtime"; continue; }

        # Gate 1: the grace floor, before any rule-specific reasoning.
        if [ $((NOW - mtime)) -lt "$min_age" ]; then
          kept_reason="younger than grace=$grace"; continue
        fi

        # Gate 2: containment. Nothing is removed unless it resolves under its own
        # glob's prefix and is not a symlink.
        if ! contained "$prefix" "$f"; then
          kept_reason="outside its glob prefix or a symlink"; continue
        fi

        # Gate 3: the rule itself.
        case "$rule" in
          prune-dead-pid*)
            pid=$(pid_from_path "$f") || { kept_reason="no pid in filename"; continue; }
            if pid_is_live "$pid"; then kept_reason="pid $pid is alive"; continue; fi
            ;;
          prune-stale-duplicate)
            if [ $((NOW - mtime)) -lt $((48 * 3600)) ]; then kept_reason="newer than 48h"; continue; fi
            if ! sibling=$(live_sibling_newer_than "$mtime"); then
              kept_reason="no live sibling is newer — cannot prove it is the stale copy"; continue
            fi
            echo "  $id: live sibling is $sibling"
            ;;
          prune-age)
            n=$(age_cap_seconds "$cap")
            [ -n "$n" ] || { kept_reason="cap not understood: $cap"; continue; }
            if [ $((NOW - mtime)) -lt "$n" ]; then kept_reason="younger than cap=$cap"; continue; fi
            ;;
          prune-empty-dir)
            [ -d "$f" ] || { kept_reason="not a directory"; continue; }
            # rmdir, not rm -r: it refuses a non-empty directory itself, so "empty" is
            # enforced by the kernel rather than by a check that could race a writer.
            if rmdir "$f" 2>/dev/null; then
              pruned=$((pruned + 1))
            else
              kept_reason="directory is not empty"
            fi
            continue
            ;;
          rotate-size)
            [ "$rotating" -eq 1 ] || { kept_reason="rotate rows require --apply --rotate"; continue; }
            n=$(rotate_size_bytes "$cap")
            [ -n "$n" ] || { kept_reason="cap not understood: $cap"; continue; }
            if [ "${b:-0}" -le "$n" ]; then kept_reason="under cap=$cap"; continue; fi
            if rotate_by_size "$f" "$(rotate_gens "$cap")"; then
              pruned=$((pruned + 1)); pruned_bytes=$((pruned_bytes + ${b:-0}))
            else
              echo "  $id: failed to rotate $f" >&2; errors=$((errors + 1))
            fi
            continue
            ;;
          truncate-lines)
            [ "$rotating" -eq 1 ] || { kept_reason="rotate rows require --apply --rotate"; continue; }
            n=$(truncate_lines_n "$cap")
            [ -n "$n" ] || { kept_reason="cap not understood: $cap"; continue; }
            if ! lc=$(wc -l < "$f" 2>/dev/null); then kept_reason="cannot read"; continue; fi
            if [ "$lc" -le "$n" ]; then kept_reason="under cap=$cap"; continue; fi
            if truncate_lines_file "$f" "$n"; then
              newsize=$(file_size "$f" 2>/dev/null || echo 0)
              pruned=$((pruned + 1)); pruned_bytes=$((pruned_bytes + ${b:-0} - newsize))
            else
              echo "  $id: truncate-lines failed for $f" >&2; errors=$((errors + 1))
            fi
            continue
            ;;
          *)
            kept_reason="rule $rule has no implementation in this slice"; continue
            ;;
        esac

        # Removal. A directory entry (G4's file-history/<uuid>/, G5's task dirs) needs a
        # recursive remove; containment above is what bounds it.
        if [ -d "$f" ]; then
          rm -rf -- "$f" || { echo "  $id: failed to remove $f" >&2; errors=$((errors + 1)); continue; }
        else
          rm -f -- "$f" || { echo "  $id: failed to remove $f" >&2; errors=$((errors + 1)); continue; }
        fi
        pruned=$((pruned + 1)); pruned_bytes=$((pruned_bytes + ${b:-0}))
      done
    done

    local line="$tag $id: rule=$rule cap=$cap matched=$count bytes=$bytes oldest_age_days=${oldest_days:-n/a}"
    if [ "$acting" -eq 1 ]; then
      line="$line pruned=$pruned reclaimed=$pruned_bytes"
      if [ "$pruned" -lt "$count" ] && [ -n "$kept_reason" ]; then line="$line kept_example=\"$kept_reason\""; fi
      total_pruned=$((total_pruned + pruned)); total_bytes=$((total_bytes + pruned_bytes))
    elif [ "$rotating" -eq 1 ]; then
      # "moved" not "reclaimed": rotation relocates bytes to a numbered generation (or, for
      # truncate-lines, drops only the trimmed lines) rather than freeing them outright.
      line="$line rotated=$pruned moved=$pruned_bytes"
      if [ "$pruned" -lt "$count" ] && [ -n "$kept_reason" ]; then line="$line kept_example=\"$kept_reason\""; fi
      total_rotated=$((total_rotated + pruned)); total_rotated_bytes=$((total_rotated_bytes + pruned_bytes))
    fi
    echo "$line ($finding)"

    measure_updates=$(printf '%s' "$measure_updates" | jq -c \
      --arg id "$id" --arg at "$MEASURED_AT" --argjson count "$count" --argjson bytes "$bytes" \
      '. + [{id: $id, at: $at, count: $count, bytes: $bytes}]')
  done

  write_measurements "$MANIFEST" "$measure_updates" \
    || echo "retention-sweep: could not write measurements back to $MANIFEST" >&2

  echo
  if [ "$APPLY" -eq 1 ]; then
    echo "Pruned $total_pruned entries, reclaimed $total_bytes bytes, $errors error(s)."
    if [ "$ROTATE" -eq 1 ]; then
      echo "Rotated/truncated $total_rotated entries, moved $total_rotated_bytes bytes."
    fi
    mkdir -p "$STATE_DIR" 2>/dev/null
    printf '{"timestamp":"%s","rows_processed":%s,"entries_pruned":%s,"bytes_reclaimed":%s,"errors":%s}\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$rows" "$total_pruned" "$total_bytes" "$errors" > "$MARKER"
  else
    echo "Reported matched/bytes/age only — deletes nothing. Re-run with --apply to act."
  fi
  [ "$errors" -eq 0 ]
}

# One sweep at a time: the hourly timer and any hand-run sweep must not overlap.
# Contention is normal, not a failure, so it exits 0.
if command -v flock >/dev/null 2>&1; then
  mkdir -p "$(dirname "$LOCK")" 2>/dev/null
  exec 9>"$LOCK" || { echo "retention-sweep: cannot open $LOCK" >&2; exit 1; }
  if ! flock -n 9; then
    echo "retention-sweep: another sweep is running; skipping this one"
    exit 0
  fi
fi

# fd 9 is closed in the child: a bash redirect sets no close-on-exec, so anything forked
# from a sweep would otherwise inherit the lock and could hold it indefinitely. bin/land
# was bitten by exactly this. The lock lives on the open file description this shell
# keeps, so the mutex itself is unchanged.
( sweep ) 9>&-

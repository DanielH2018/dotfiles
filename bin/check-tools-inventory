#!/usr/bin/env bash
#
# check-tools-inventory — reject a push whose source tree has drifted from tools.json.
#
# `tools-inventory --check` reports a command script with no tools.json entry, and a
# curated entry whose file is gone. Nothing ran it: by 2026-09-24 it had accumulated 46
# lines of drift (#627) before anyone looked, because a new ~/.local/bin script or a
# deleted one failed no gate (#635).
#
# Read-only, and pinned to the tree being pushed rather than the deployed one:
#   TOOLS_INVENTORY_SOURCE  the source tree to scan (this checkout's home/).
#   TOOLS_INVENTORY_DATA    the tools.json to diff it against (this checkout's copy, not
#                           the deployed ~/.local/share one, which is the default).
#   TOOLS_INVENTORY_IGNORED set empty, so the tool never spawns chezmoi. The per-host
#                           ignore list only feeds the rendered page, not drift, and
#                           chezmoi would read the operator's own config and state.
# --check writes nothing: no page, no cache, nothing under $HOME.
#
# Usage: check-tools-inventory [SOURCE_DIR [DATA_FILE]]
#   Defaults to this checkout's home/ and its tools.json; the arguments exist for tests.
#
# Kept bash-3.2 clean (macOS default bash).

set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)" || exit 1
SOURCE="${1:-$ROOT/home}"
DATA="${2:-$ROOT/home/dot_local/share/tools-inventory/tools.json}"

TOOLS_INVENTORY_SOURCE="$SOURCE" \
TOOLS_INVENTORY_DATA="$DATA" \
TOOLS_INVENTORY_IGNORED="" \
  exec node "$ROOT/home/dot_local/bin/executable_tools-inventory" --check

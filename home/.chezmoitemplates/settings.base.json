  "model": "opus[1m]",
  "effortLevel": "xhigh",
  "fallbackModel": [
    "claude-sonnet-5"
  ],
  {{/* availableModels governs the main session AND subagents/skills/judge, so this list
       is the UNION of every model the setup actually requests: opus[1m] (main),
       "opus" alias (eval judge + planner/migration-reviewer agents), "sonnet"
       (implementer/ops-investigator/network-navigator agents), claude-sonnet-5
       (fallbackModel), "haiku" (kept for Claude Code's internal/auxiliary calls, e.g.
       the eval judge's helper call — no agent pins it), and "fable"/claude-fable-5
       (Fable 5, opted in for manual `/model fable` selection).
       Aliases and full IDs are both listed on purpose. enforceAvailableModels snaps the
       Default to the first entry if it would resolve outside the list — a deterministic
       guard against a silent model downgrade (cf. the fable->sonnet incident, which is
       why fable is listed last, never first). SOAK on host: watch a full eval run + a
       subagent invocation before trusting it. */}}
  "availableModels": [
    "opus[1m]",
    "opus",
    "sonnet",
    "claude-sonnet-5",
    "haiku",
    "fable",
    "claude-fable-5"
  ],
  "enforceAvailableModels": true,
  "autoMode": {
    "classifyAllShell": true
  },
  "hooks": {{/* Git Bash runs these on Windows too; notify.sh just no-ops there */}}{
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/allow-compound-bash.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-context.sh",
            "timeout": 5
          }
        ]
      },
      {{/* dev-container network glue (Linux/macOS); skip on Windows */}}{{ if ne .chezmoi.os "windows" }}{
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "docker network connect workspace_default $(hostname) 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },{{ end }}
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/watch-paths.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-update.sh",
            "timeout": 5
          }
        ]
      }{{ if eq .chezmoi.os "linux" }},
      {{/* Linux only: serve ~/.claude/artifacts on localhost:8181 so artifact links are click-to-render from a VS Code Remote-SSH TUI (file:// can't cross the remote boundary) */}}
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/serve-artifacts.sh",
            "timeout": 5
          }
        ]
      }{{ end }}
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-context.sh",
            "timeout": 5
          }
        ]
      }{{ if eq .chezmoi.os "windows" }},
      {{/* agentview: mark this session "working" when a prompt is submitted */}}
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-view-state.sh working",
            "timeout": 5
          }
        ]
      }{{ end }}
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-dangerous-bash.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-format.sh",
            "timeout": 30,
            "statusMessage": "Formatting..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/lint-after-edit.sh",
            "timeout": 300,
            "statusMessage": "Running lint checks..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/chezmoi-guard.sh",
            "timeout": 15,
            "statusMessage": "Syncing chezmoi source..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/link-artifact.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/screen-injection.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/suggest-artifact.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/reprime-nudge.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|task_complete",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh",
            "timeout": 5
          }
        ]
      }{{ if eq .chezmoi.os "windows" }},
      {{/* agentview: needs-input on permission/idle prompts */}}
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-view-state.sh needs-input",
            "timeout": 5
          }
        ]
      },
      {{/* agentview: completed on task-complete notification */}}
      {
        "matcher": "task_complete",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-view-state.sh completed",
            "timeout": 5
          }
        ]
      }{{ end }}
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-compact.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-before-stop.sh",
            "timeout": 10
          }
        ]
      }{{ if eq .chezmoi.os "windows" }},
      {{/* agentview: mark completed when the turn stops */}}
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-view-state.sh completed",
            "timeout": 5
          }
        ]
      }{{ end }}{{ if eq .chezmoi.os "linux" }},
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a' > /dev/tty 2>/dev/null",
            "async": true,
            "timeout": 5
          }
        ]
      }{{ end }}
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-failure.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-end.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }{{ if eq .chezmoi.os "windows" }},
      {{/* agentview: remove this session's state file on end */}}
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-view-state.sh end",
            "timeout": 5
          }
        ]
      }{{ end }}
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/instructions-loaded.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/subagent-stop.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "footerLinksRegexes": [],
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "remember@claude-plugins-official": true,
{{- if ne .chezmoi.os "windows" }}
    "feature-dev@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
{{- end }}
    "ralph-loop@claude-plugins-official": true,
    "claude-permission-audit@daniel-tools": true
  },
  "skillOverrides": {
    "incident-response": "off",
    "git-commit-and-push": "off"
  },
  "extraKnownMarketplaces": {
    "daniel-tools": {
      "source": {
        "source": "github",
        "repo": "DanielH2018/claude-permission-audit"
      },
      "autoUpdate": true
    }
  },
  "sandbox": {{/* macOS-only: the block below is macOS-tuned (1Password agent socket, /System, allowUnixSockets) and Linux lacks bwrap/socat, so an enabled sandbox there just runs unsandboxed and warns about glob Read/Edit rules it can't enforce */}}{{ if eq .chezmoi.os "darwin" }}{
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "registry.npmjs.org",
        "repo1.maven.org",
        "plugins.gradle.org",
        "services.gradle.org",
        "downloads.gradle.org",
        "central.sonatype.com",
        "dl.google.com",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "static.crates.io",
        "ssh.shipyard.rs",
        "jpos.org",
        "clojars.org",
        "ghcr.io"
      ],
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.local/share/chezmoi",
        "~/.claude",
        "~/.gradle",
        "~/.m2",
        "~/.npm",
        "~/.cache",
        "~/.sdkman",
        "~/.local/share/fnm",
        "/tmp"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gcloud",
        "~/.config/gh",
        "~/.netrc",
        "~/.pypirc",
        "~/.npmrc",
        "/etc",
        "/System"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gcloud",
        "~/.config/gh",
        "~/.netrc",
        "~/.pypirc",
        "~/.npmrc"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "enableWeakerNetworkIsolation": false,
    "excludedCommands": [
      "docker",
      "docker-compose"
    ]
  }{{ else }}{ "enabled": false }{{ end }},
  "alwaysThinkingEnabled": true,
{{- if eq .chezmoi.os "linux" }}
  "preferredNotifChannel": "terminal_bell",
{{- end }}
  "advisorModel": "opus",
  "awaySummaryEnabled": true,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "autoConnectIde": true,
  "autoInstallIdeExtension": true,
  "maxSkillDescriptionChars": 800
}

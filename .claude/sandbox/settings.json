      "Bash(gh repo sync*)",
      "Bash(gh repo autolink*)",
      "Bash(gh gist create*)",
      "Bash(gh gist edit*)",
      "Bash(gh gist delete*)",
      "Bash(gh label create*)",
      "Bash(gh label edit*)",
      "Bash(gh label delete*)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow run*)",
      "Bash(gh ssh-key *)",
      "Bash(gh gpg-key *)",
      "Bash(gh codespace create*)",
      "Bash(gh codespace delete*)",
      "Bash(gh codespace stop*)",
      "Bash(gh project *)",
      "Bash(gh cache delete*)",
      "Bash(gh api *-X POST*)",

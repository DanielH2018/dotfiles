#!/usr/bin/env python3
"""tq — run a test or lint command, print a compact digest, keep the full result as JSON.

    tq node --test [files...]
    tq uv run pytest            (also: pytest, python -m pytest)
    tq prek run --all-files
    tq ruff check [paths...]    (also: uv run ruff check)
    tq shellcheck [files...]

tq's own flags come before the command; the first token that is not one of
them starts the runner's argv, which is passed on untouched.

    --scope=all|file|added   which of a linter's findings reach the digest:
                             everything, those in a file the diff touches, or
                             those on a line it changed. Default all. Findings
                             set aside stay in the json, and test failures are
                             never scoped. Also TQ_SCOPE.
    --diff-base=<ref>        what to diff against. Default HEAD, which covers
                             staged and unstaged work. Also TQ_DIFF_BASE.

Any other command is executed untouched. The runner's exit code is always
preserved. TQ_JSON=<path> chooses where the structured result lands; otherwise
it goes to a temp file whose path the digest prints. TQ_TIMEOUT=<seconds>
bounds the run — a runner still going after that is killed and reported as
TIMED OUT with whatever it managed first, 0 to let it run as long as it likes.

Linters are digested as findings, not as a pass rate: silence about a line is
not an assertion that the line is good, so there is no denominator to report.
"""

from __future__ import annotations

import os
import re
import shlex
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.realpath(__file__))
LIB = os.path.normpath(
    os.environ.get("TQ_HOME") or os.path.join(HERE, os.pardir, "share", "tq")
)
sys.path.insert(0, LIB)

from adapters import junit as junit_adapter  # noqa: E402
from adapters import lint as lint_adapter  # noqa: E402
from adapters import node as node_adapter  # noqa: E402
import scope  # noqa: E402
from adapters import rdjson as rdjson_adapter  # noqa: E402
from digest import digest  # noqa: E402
from result import Result  # noqa: E402

REPORTER = os.path.join(LIB, "node-reporter.mjs")
PYTEST_HOOK_ID = "pytest"
HOOK_ID = re.compile(r"^- hook id: (?P<id>\S+)\s*$")
RAW_TAIL = 4000
# Ten minutes, which no suite tq is put in front of comes close to. TQ_TIMEOUT=0
# disables the kill for the one that legitimately does.
TIMEOUT = int(os.environ.get("TQ_TIMEOUT") or 600)

# Tokens that stand in front of the real program without being it.
LAUNCHERS = {"uv", "uvx", "poetry", "pdm", "rye", "hatch", "pipenv", "env", "command"}
SUBCOMMANDS = {"run", "exec", "tool", "--"}
PYTHON = re.compile(r"^python(3(\.\d+)?)?$")


def tool_name(argv):
    """The program a command really runs, seeing through `uv run <tool>` and
    `python -m <tool>`.

    Scanning for the tool's name anywhere in argv is what a first cut does, and
    it misfires on any command that merely mentions it — `grep pytest file` is
    not a test run, and injecting reporter flags into it would be.
    """
    for tok in argv:
        if tok.startswith("-") and tok != "--":
            continue
        base = os.path.basename(tok)
        if base in LAUNCHERS or base in SUBCOMMANDS or PYTHON.match(base):
            continue
        if "=" in base:
            continue  # `env FOO=1 pytest`, and `FOO=1 pytest` via a shell
        return base
    return ""


def detect(argv):
    """Which adapter owns this command, or None to run it untouched."""
    tool = tool_name(argv)
    if tool == "node" and "--test" in argv:
        return "node"
    if tool == "prek":
        return "prek"
    if tool == "pytest":
        return "pytest"
    # `ruff format --check` reports reformatting, not diagnostics, and carries
    # no locations worth digesting — the bare word is what marks a lint run.
    if tool == "ruff" and "check" in argv:
        return "ruff"
    if tool == "shellcheck":
        return "shellcheck"
    return None


def drop_flag(argv, flags):
    """argv without a flag tq is about to set for itself, in either spelling."""
    out, skip = [], False
    for tok in argv:
        if skip:
            skip = False
            continue
        if tok in flags:
            skip = True  # its value is the next token
            continue
        if any(tok.startswith(f"{flag}=") for flag in flags):
            continue
        out.append(tok)
    return out


def run(argv, env):
    """The finished process, plus whether it had to be killed for running long.

    A hung runner is the one failure tq used to handle worse than no tq at all:
    the digest is built after the process exits, so a suite that never exits
    produced no output whatsoever, where the bare runner would at least have
    streamed what it managed first.
    """
    try:
        proc = subprocess.run(
            argv,
            env=env,
            capture_output=True,
            text=True,
            errors="replace",
            timeout=TIMEOUT or None,
        )
        return proc, False
    except subprocess.TimeoutExpired as expired:
        # TimeoutExpired keeps what was captured before the kill, but hands it
        # back as bytes even under text=True, and carries no returncode at all.
        # 124 is what timeout(1) reports, so a caller reading tq's status has
        # something it already recognises.
        return subprocess.CompletedProcess(
            expired.cmd, 124, _text(expired.stdout), _text(expired.stderr)
        ), True


def _text(raw):
    if isinstance(raw, bytes):
        return raw.decode("utf-8", "replace")
    return raw or ""


def parse_junit(xml_path, result, summary_text=""):
    """Parse a JUnit report if there is a readable one, else leave the result be.

    Deliberately broad: a report tq cannot parse must degrade to the raw output
    main() already prints for an unreported failure, never to a traceback in
    place of the digest. A killed runner is the common way to get half a file.
    """
    if not os.path.exists(xml_path):
        return
    try:
        junit_adapter.parse(xml_path, result, summary_text=summary_text)
    except Exception:  # noqa: BLE001 — see above
        pass


def plain_env():
    """Colour off, by both mechanisms. A FORCE_COLOR in the ambient environment
    makes runners emit ANSI even when stdout is a file, and the two runners
    disagree on precedence — pytest lets NO_COLOR win, node lets FORCE_COLOR
    win — so the only portable answer is to drop FORCE_COLOR outright. It is
    not cosmetic: node's coloured assertion diff marks actual-vs-expected with
    colour *only*, so stripping ANSI from it silently merges the two values."""
    env = os.environ.copy()
    env.pop("FORCE_COLOR", None)
    env["NO_COLOR"] = "1"
    # Leaked into a nested run — tq invoked from inside a test — this makes
    # `node --test` collect nothing and exit 0, which reads as a clean pass.
    env.pop("NODE_TEST_CONTEXT", None)
    # json_target() has already read TQ_JSON by the time the runner starts, so no
    # child needs it, and a nested tq inheriting it writes its own record over
    # this run's. When the path is relative the nested run does not even get that
    # far: it resolves against the inner cwd, and tq dies on the missing
    # directory instead of reporting the tests it just ran.
    env.pop("TQ_JSON", None)
    return env


def pytest_env(xml_path):
    """pytest takes its flags through the environment because prek offers no
    argument passthrough, and PYTEST_ADDOPTS survives `uv run` either way."""
    env = plain_env()
    flags = [
        f"--junit-xml={shlex.quote(xml_path)}",
        "-o junit_logging=out-err",
        "-o junit_log_passing_tests=false",
        "--tb=short",
        "-q",
    ]
    env["PYTEST_ADDOPTS"] = " ".join([env.get("PYTEST_ADDOPTS", ""), *flags]).strip()
    return env


def run_node(argv, workdir, tmp):
    ndjson = os.path.join(tmp, "events.ndjson")
    cmd = list(argv)
    at = cmd.index("--test") + 1
    cmd[at:at] = [
        f"--test-reporter={REPORTER}",
        f"--test-reporter-destination={ndjson}",
    ]
    proc, timed_out = run(cmd, plain_env())
    result = Result(
        runner="node",
        cmd=shlex.join(argv),
        cwd=workdir,
        exit=proc.returncode,
        timed_out=timed_out,
    )
    if os.path.exists(ndjson):
        node_adapter.parse(ndjson, result)
    return result, proc


def run_pytest(argv, workdir, tmp):
    xml = os.path.join(tmp, "junit.xml")
    proc, timed_out = run(argv, pytest_env(xml))
    result = Result(
        runner="pytest",
        cmd=shlex.join(argv),
        cwd=workdir,
        exit=proc.returncode,
        timed_out=timed_out,
    )
    parse_junit(xml, result, summary_text=proc.stdout)
    return result, proc


def run_prek(argv, workdir, tmp):
    xml = os.path.join(tmp, "junit.xml")
    proc, timed_out = run(argv, pytest_env(xml))
    result = Result(
        runner="prek",
        cmd=shlex.join(argv),
        cwd=workdir,
        exit=proc.returncode,
        timed_out=timed_out,
    )
    parse_junit(xml, result, summary_text=proc.stdout)
    return result, proc


def finish_lint(result, proc):
    """Counts restated as findings, plus whatever the tool said on stderr.

    That stderr matters: a linter reports "I examined nothing" there and still
    exits 0, which is indistinguishable from a clean run by exit code alone.
    """
    lint_adapter.as_diagnostics(result)
    note = (proc.stderr or "").strip()
    # Only when the run looks clean. A failing run already has main() print the
    # raw output, and saying the same thing twice buries the one line that counts.
    if note and result.exit == 0:
        result.notes.append(note)


def run_ruff(argv, workdir, tmp):
    cmd = drop_flag(argv, ("--output-format", "--output-file", "-o"))
    proc, timed_out = run(cmd + ["--output-format=json"], plain_env())
    result = Result(
        runner="ruff",
        kind="lint",
        cmd=shlex.join(argv),
        cwd=workdir,
        exit=proc.returncode,
        timed_out=timed_out,
    )
    lint_adapter.parse_ruff(proc.stdout, result)
    finish_lint(result, proc)
    return result, proc


def run_shellcheck(argv, workdir, tmp):
    cmd = drop_flag(argv, ("--format", "-f"))
    proc, timed_out = run(cmd + ["--format=json1"], plain_env())
    result = Result(
        runner="shellcheck",
        kind="lint",
        cmd=shlex.join(argv),
        cwd=workdir,
        exit=proc.returncode,
        timed_out=timed_out,
    )
    lint_adapter.parse_shellcheck(proc.stdout, result)
    finish_lint(result, proc)
    return result, proc


def splice_prek(text, digest_text):
    """Swap the pytest hook's indented output dump for the digest. Every other
    hook's status line and failure block passes through verbatim — losing one
    behind the splice would be the prek-shaped version of a false pass."""
    lines = text.splitlines()
    if not any(HOOK_ID.match(ln) for ln in lines):
        return text, False  # not a prek layout we recognise: never guess
    out, i, replaced = [], 0, False
    while i < len(lines):
        matched = HOOK_ID.match(lines[i])
        out.append(lines[i])
        i += 1
        if not matched or matched.group("id") != PYTEST_HOOK_ID:
            continue
        while i < len(lines) and lines[i].startswith("- "):
            out.append(lines[i])
            i += 1
        start = i
        while i < len(lines) and (not lines[i].strip() or lines[i].startswith("  ")):
            i += 1
        if i > start:
            out.append("")  # prek puts a blank line before a hook's output
            out.extend(f"  {ln}" if ln else "" for ln in digest_text.splitlines())
            replaced = True
    return "\n".join(out), replaced


def raw_tail(proc):
    """Last of whatever the runner actually said, for when nothing parsed."""
    text = ((proc.stderr or "") + (proc.stdout or "")).strip()
    return text[-RAW_TAIL:] if len(text) > RAW_TAIL else text


def json_target():
    override = os.environ.get("TQ_JSON")
    if override:
        return override
    handle, path = tempfile.mkstemp(prefix="tq-", suffix=".json")
    os.close(handle)
    return path


def run_ingested(argv, workdir, tmp, fmt):
    """Any command at all, as long as its stdout speaks a format tq reads.

    The escape hatch from tq's fixed list of runners: a linter tq has never
    heard of still gets digested, and one it cannot be taught still runs.
    """
    proc, timed_out = run(argv, plain_env())
    result = Result(
        runner=os.path.basename(argv[0]),
        kind="lint",
        cmd=shlex.join(argv),
        cwd=workdir,
        exit=proc.returncode,
        timed_out=timed_out,
    )
    INGESTORS[fmt](proc.stdout, result)
    finish_lint(result, proc)
    return result, proc


RUNNERS = {
    "node": run_node,
    "pytest": run_pytest,
    "prek": run_prek,
    "ruff": run_ruff,
    "shellcheck": run_shellcheck,
}

INGESTORS = {
    "rdjson": rdjson_adapter.parse,
    "ruff-json": lint_adapter.parse_ruff,
    "shellcheck-json1": lint_adapter.parse_shellcheck,
}

TQ_FLAGS = ("--scope", "--diff-base", "--ingest")


def split_flags(argv):
    """tq's own flags, then the command it wraps.

    Parsing stops at the first token tq does not own, and everything from there
    is the runner's, passed on untouched — the passthrough guarantee is what
    makes tq safe to put in front of an arbitrary command, so it cannot start
    interpreting flags that appear after the program name.
    """
    opts, i = {}, 0
    while i < len(argv):
        name, sep, value = argv[i].partition("=")
        if name not in TQ_FLAGS:
            break
        if sep:
            opts[name] = value
            i += 1
        elif i + 1 < len(argv):
            opts[name] = argv[i + 1]
            i += 2
        else:
            break  # a flag with no value is not tq's to guess at
    return opts, argv[i:]


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    opts, argv = split_flags(argv)
    mode = opts.get("--scope") or os.environ.get("TQ_SCOPE") or "all"
    base = opts.get("--diff-base") or os.environ.get("TQ_DIFF_BASE") or "HEAD"
    if mode not in scope.MODES:
        sys.stderr.write(f"tq: --scope must be one of {', '.join(scope.MODES)}\n")
        return 2
    if not argv:
        sys.stderr.write("tq: no command given\n")
        return 2
    fmt = opts.get("--ingest")
    if fmt is not None and fmt not in INGESTORS:
        sys.stderr.write(f"tq: --ingest must be one of {', '.join(INGESTORS)}\n")
        return 2
    kind = "ingest" if fmt else detect(argv)
    if kind is None:
        try:
            os.execvp(argv[0], argv)
        except OSError as exc:
            sys.stderr.write(f"tq: cannot run {argv[0]}: {exc}\n")
            return 127

    workdir = os.getcwd()
    with tempfile.TemporaryDirectory(prefix="tq-") as tmp:
        started = time.monotonic()
        if kind == "ingest":
            result, proc = run_ingested(argv, workdir, tmp, fmt)
        else:
            result, proc = RUNNERS[kind](argv, workdir, tmp)
        result.duration_ms = result.duration_ms or int(
            (time.monotonic() - started) * 1000
        )
        path = json_target()
        # Narrow the digest, then hand the json the full set back. A finding
        # outside the diff is still a true finding; it just is not what this
        # change is answerable for, and the record has to keep both facts.
        everything = list(result.failures)
        result.truncated["out_of_scope"] = scope.apply_scope(
            result, mode, workdir, base
        )
        text = digest(result, path)
        result.failures = everything
        result.write(path)

    if kind == "prek":
        spliced, replaced = splice_prek(proc.stdout, text)
        sys.stdout.write(spliced.rstrip("\n") + "\n")
        if not replaced:
            sys.stdout.write(f"\n{text}\n")
    else:
        sys.stdout.write(text + "\n")

    # A runner that died before reporting anything must never read as a pass.
    if result.exit != 0 and not result.failures:
        tail = raw_tail(proc)
        if tail:
            sys.stdout.write(f"\nno failures parsed — raw output follows:\n{tail}\n")
    if proc.stderr and kind == "prek":
        sys.stderr.write(proc.stderr)
    return result.exit


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

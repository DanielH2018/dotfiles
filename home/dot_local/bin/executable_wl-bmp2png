#!/usr/bin/env python3
"""Convert a BMP on stdin to a PNG on stdout (stdlib only, no Pillow).

WSLg mirrors the Windows clipboard image onto the Wayland clipboard only as
image/bmp, but Claude Code (and the Anthropic API) accept png/jpeg/gif/webp —
not bmp. The xclip shim pipes WSLg's bmp through this so a pasted screenshot
arrives as image/png. Handles the 24- and 32-bit BITMAPINFOHEADER bitmaps WSLg
emits; exits non-zero on anything it can't read so the shim falls back cleanly.
"""
import sys, struct, zlib

d = sys.stdin.buffer.read()
if d[:2] != b'BM':
    sys.exit('not a BMP')
pixoff = struct.unpack_from('<I', d, 10)[0]
w = struct.unpack_from('<i', d, 18)[0]
h = struct.unpack_from('<i', d, 22)[0]
bpp = struct.unpack_from('<H', d, 28)[0]
topdown = h < 0
h = abs(h)
if bpp not in (24, 32) or w <= 0 or h <= 0:
    sys.exit('unsupported BMP (bpp=%d w=%d h=%d)' % (bpp, w, h))

stride = ((bpp * w + 31) // 32) * 4  # rows are padded to a 4-byte boundary
raw = bytearray()
for r in range(h):
    sr = r if topdown else h - 1 - r      # BMP rows are bottom-up unless h<0
    off = pixoff + sr * stride
    raw.append(0)                          # PNG per-row filter: none
    if bpp == 32:
        row = bytearray(d[off:off + w * 4])       # BGRA
        row[0::4], row[2::4] = row[2::4], row[0::4]  # -> RGBA (swap B/R channels)
        raw += row
    else:
        bgr = d[off:off + w * 3]                   # 24-bit BGR
        rgba = bytearray(w * 4)
        rgba[0::4] = bgr[2::3]
        rgba[1::4] = bgr[1::3]
        rgba[2::4] = bgr[0::3]
        rgba[3::4] = b'\xff' * w
        raw += rgba


def chunk(typ, data):
    return (struct.pack('>I', len(data)) + typ + data
            + struct.pack('>I', zlib.crc32(typ + data) & 0xffffffff))


sys.stdout.buffer.write(
    b'\x89PNG\r\n\x1a\n'
    + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 6, 0, 0, 0))  # 8-bit RGBA
    + chunk(b'IDAT', zlib.compress(bytes(raw), 6))
    + chunk(b'IEND', b''))

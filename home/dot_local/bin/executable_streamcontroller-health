#!/usr/bin/env bash
# streamcontroller-health: restart StreamController when it is alive but has lost a device.
#
# "Device" here means any Elgato input this machine drives through StreamController --
# the Stream Deck original V2 and the Stream Deck Pedal. They fail and recover as a
# unit, because recovery restarts the app rather than re-grabbing one handle, so this
# script treats "any attached device is unheld" as the single fault condition.
#
# StreamController fails in two shapes, and systemd only sees one of them:
#
#   1. It aborts outright (libdbus `dbus_watch_handle()` assertion, SIGABRT). The
#      process exits, so Restart=on-failure in the unit's drop-in handles it. Nothing
#      here is involved.
#
#   2. It fails to grab a device (TransportError writing a feature report) and then
#      *keeps running* with no page loaded. Upstream logs "Reached end of main.py"
#      and leaves the process up. To systemd that is a perfectly healthy service; to
#      the user it is a dark Stream Deck. Only case 2 needs this script.
#
# So the health signal deliberately is not "is the process alive" -- that is exactly
# the state being detected. It is "does *StreamController* hold each device's USB node".
#
# The emphasis is load-bearing and was found the hard way: `fuser` on the node reports
# it busy whenever a Wine prefix is running, because winedevice.exe opens every USB
# device it can see. Asking "is anything holding it" would therefore report a healthy
# device for as long as a game was open -- precisely when nobody is looking at the log
# to notice otherwise.
#
# Everything here converges on one instance. Stacked instances are the documented way
# this gets permanently stuck: the one holding the handle is the broken one, and each
# relaunch adds another that cannot grab it.
#
# A third thing this script owns: case 1's SIGABRT leaves an ABRT report behind, and
# `abrt-applet` re-notifies about every *unresolved* report at the start of every
# session (`man abrt-applet`: "at start-up ... checks for new problems which occurred
# while the tool was not running"). Left alone, an abort from three logins ago is a
# fresh popup at today's login even though nothing new happened -- the crash itself
# already self-recovers via Restart=on-failure. So this also purges ABRT reports that
# match that exact, already-diagnosed signature. Anything else is left for daniel to
# actually look at.

set -uo pipefail

UNIT="app-com.core447.StreamController@autostart.service"
APP_ID="com.core447.StreamController"
COMM="StreamControlle" # /proc comm is truncated to 15 chars; this is the whole name
VENDOR="0fd9"
# Every product id StreamController drives here. Order is irrelevant -- the fault
# condition is "any one of these is attached and unheld", not a per-device state.
PRODUCTS=("006d" "0086") # Stream Deck original V2, Stream Deck Pedal

# The known-crash signature (see streamcontroller-libdbus-watch-abort): the flatpak's
# python3.13 process, launched as "StreamController". Only reports matching both get
# purged -- an unrelated python3.13 crash elsewhere must not be silently deleted.
ABRT_EXECUTABLE="/usr/bin/python3.13"
ABRT_CMDLINE="StreamController"

# Two strikes before acting. The timer runs every 2 minutes and a healthy start takes
# ~6s to write its key images, so a single strike can land inside a legitimate startup;
# two consecutive ones, four minutes apart, cannot.
STRIKES_BEFORE_ACTING=2

# A device that is broken in some way this script cannot fix must not get restarted
# forever. After this many restarts in an hour it gives up and says so.
MAX_RESTARTS_PER_HOUR=3

# Seams, so the tests can drive this against fixture trees instead of the real machine.
# Nothing but the test suite ever sets them.
SYSFS_USB="${SC_HEALTH_SYSFS:-/sys/bus/usb/devices}"
PROC="${SC_HEALTH_PROC:-/proc}"

STATE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STRIKE_FILE="$STATE_DIR/streamcontroller-health.strikes"
RESTART_FILE="$STATE_DIR/streamcontroller-health.restarts"

log() { printf '%s\n' "$*"; }

# Prints one sysfs path per attached device, zero or more lines. Unlike the single-device
# form it replaces, absence is an empty result rather than a non-zero exit -- callers
# distinguish "none attached" by line count, so a missing device is never an error here.
find_devices() {
	local id_product base product
	for id_product in "$SYSFS_USB"/*/idProduct; do
		base="${id_product%/idProduct}"
		[[ -r $id_product && -r $base/idVendor ]] || continue
		[[ $(<"$base/idVendor") == "$VENDOR" ]] || continue
		for product in "${PRODUCTS[@]}"; do
			if [[ $(<"$id_product") == "$product" ]]; then
				printf '%s\n' "$base"
				break
			fi
		done
	done
}

device_node() {
	# Re-derived each run: devnum changes on every re-enumeration.
	printf '/dev/bus/usb/%03d/%03d' "$(<"$1/busnum")" "$(<"$1/devnum")"
}

# `pgrep -c` prints its count *and* exits 1 when that count is zero, so a `|| printf '0'`
# fallback emitted "0\n0" -- every (( )) on the result was then a syntax error, which
# silently skipped the deliberate-quit guard in main() and the wait loop in recover().
app_processes() {
	local n
	n=$(pgrep -x -c "$COMM" 2>/dev/null) || n=0
	printf '%s' "${n:-0}"
}

node_held_by_app() {
	# Only StreamController's own file descriptors count -- see the note at the top
	# about winedevice.exe holding the same node.
	local node="$1" pid fd
	for pid in $(pgrep -x "$COMM" 2>/dev/null); do
		for fd in "$PROC/$pid"/fd/*; do
			[[ $(readlink "$fd" 2>/dev/null) == "$node" ]] && return 0
		done
	done
	return 1
}

read_strikes() { [[ -r $STRIKE_FILE ]] && cat "$STRIKE_FILE" 2>/dev/null || printf '0'; }
clear_strikes() { rm -f "$STRIKE_FILE"; }

# Purge ABRT reports matching the known StreamController crash signature, so they
# cannot accumulate into a login notification for a crash that already recovered on
# its own. No graphical session or deck check needed -- abrt-cli works before login.
cleanup_known_abrt_reports() {
	command -v abrt-cli >/dev/null 2>&1 || return 0

	local id info exec_re cmdline_re
	# Escape regex metachars in the executable path (the dots in "python3.13" would
	# otherwise match any char) and anchor each value on whitespace or line end, so
	# e.g. "StreamControllerFoo" cannot pass as a match.
	exec_re="^Executable[[:space:]]+${ABRT_EXECUTABLE//./\\.}([[:space:]]|\$)"
	cmdline_re="^Command line[[:space:]]+${ABRT_CMDLINE}([[:space:]]|\$)"

	while IFS= read -r id; do
		[[ -n $id ]] || continue
		info=$(abrt-cli info "$id" 2>/dev/null) || continue
		grep -qE "$exec_re" <<<"$info" || continue
		grep -qE "$cmdline_re" <<<"$info" || continue
		abrt-cli remove -f "$id" >/dev/null 2>&1
	done < <(abrt-cli list 2>/dev/null | awk '/^Id/ {print $2}')
}

# Restarts inside the last hour, one epoch timestamp per line.
recent_restarts() {
	local cutoff now
	now=$(date +%s)
	cutoff=$((now - 3600))
	[[ -r $RESTART_FILE ]] || return 0
	awk -v c="$cutoff" '$1 > c' "$RESTART_FILE" 2>/dev/null
}

record_restart() {
	local kept
	kept=$(recent_restarts)
	{
		[[ -n $kept ]] && printf '%s\n' "$kept"
		date +%s
	} >"$RESTART_FILE"
}

recover() {
	# Takes no device: recovery restarts StreamController wholesale and resets every
	# attached device, so which one was unheld does not change what happens here.
	local used
	used=$(recent_restarts | wc -l)
	if ((used >= MAX_RESTARTS_PER_HOUR)); then
		# Exits 0 deliberately: declining to retry is this script working as designed,
		# not a failure of it. A non-zero exit would park the oneshot in `failed` and
		# re-fail it every two minutes, which buries the one line worth reading.
		log "device down but already restarted ${used}x in the last hour; not retrying (needs a look)"
		return 0
	fi

	log "device not held by any process; recovering"

	# Kill first, and confirm. "Beta resume mode" means a surviving instance re-grabs
	# the deck the moment it reconnects, so resetting while one is still alive hands
	# the device straight back to the broken process.
	flatpak kill "$APP_ID" 2>/dev/null
	local waited=0
	while (($(app_processes) > 0)) && ((waited < 15)); do
		sleep 1
		((waited++))
	done
	if (($(app_processes) > 0)); then
		log "instances still alive after ${waited}s; aborting recovery rather than stacking another"
		return 1
	fi

	"$HOME/.local/bin/streamdeck-usb-reset" || log "usb reset reported a problem; starting anyway"

	# The unit may have exhausted its start limit on the way here; without this the
	# start below is refused and the deck stays dark.
	systemctl --user reset-failed "$UNIT" 2>/dev/null
	systemctl --user start "$UNIT" || {
		log "failed to start $UNIT"
		return 1
	}

	record_restart
	log "restarted $UNIT"
}

main() {
	# Unconditional and independent of everything below: abrt-cli works before login,
	# and the deck-recovery logic below returns early in several cases (no session, no
	# deck, deliberate quit) that must not also skip this.
	cleanup_known_abrt_reports

	# Everything this recovers is PartOf=graphical-session.target. With lingering enabled
	# the user manager -- and so this timer -- starts at boot, hours before anyone logs
	# in, and `systemctl start` on the app then launches GTK against no display: it
	# segfaults ~2s in, five times, every timer tick until the real login. The deck being
	# unheld before login is the expected state, not a fault.
	if ! systemctl --user is-active --quiet graphical-session.target; then
		clear_strikes
		log "no graphical session; nothing to recover"
		return 0
	fi

	local devices=()
	mapfile -t devices < <(find_devices)
	if ((${#devices[@]} == 0)); then
		# Everything unplugged. Not a fault, and the strike count must not survive it --
		# otherwise plugging back in gets one free restart it never earned.
		clear_strikes
		log "no Stream Deck device attached"
		return 0
	fi

	# One unheld device is enough to fault: recovery is global, so there is nothing to
	# gain by waiting for the rest to drop too.
	local device unheld=0
	for device in "${devices[@]}"; do
		node_held_by_app "$(device_node "$device")" || unheld=1
	done

	if ((unheld == 0)); then
		# Attached and all held. Same clear as the unplugged branch but a distinct
		# state: collapsing the two loses the free-restart guard above.
		clear_strikes
		return 0
	fi

	# At least one device is unheld. Whether that is a fault depends on why nothing is running.
	if (($(app_processes) == 0)); then
		if systemctl --user is-failed --quiet "$UNIT"; then
			log "no instance running and $UNIT is failed"
		else
			# Quitting the app sends SIGTERM, which the drop-in treats as success. A
			# deliberate quit must stay quit -- restarting it here would make the app
			# impossible to close.
			clear_strikes
			return 0
		fi
	fi

	local strikes
	strikes=$(($(read_strikes) + 1))
	if ((strikes < STRIKES_BEFORE_ACTING)); then
		printf '%s' "$strikes" >"$STRIKE_FILE"
		log "device not held (strike ${strikes}/${STRIKES_BEFORE_ACTING}); waiting for confirmation"
		return 0
	fi

	clear_strikes
	recover
}

main "$@"

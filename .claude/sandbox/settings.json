      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--input *)",
      "Bash(gh api graphql*)",
      "Bash(gh api */graphql*)",
      "Bash(gh alias set*)",
      "Bash(gh config set*)",
      "Bash(gh auth login*)",
      "Bash(gh auth logout*)",
      "Bash(gh auth refresh*)",
      "Bash(gh auth setup-git*)",
      "Bash(git push --force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *+*:*)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin master)",
      "Bash(git push origin master *)",
      "Bash(git remote set-url *)",
      "Bash(git remote add *)",
      "Bash(git remote remove *)",
      "Bash(git remote rename *)",
      "Bash(ssh *)",
      "Bash(ssh-add*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf /home/claudebot*)",
      "Bash(rm -rf /workspace*)",
      "Bash(rm -rf .)",
      "Bash(rm -r /*)",
      "Bash(rm --recursive *)",
      "Bash(npm publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm publish*)",
      "Bash(cargo publish*)",
      "Bash(twine upload*)",
      "Bash(python*setup.py*upload*)",
      "Bash(gradle*publish*)",
      "Bash(./gradlew*publish*)",
      "Bash(mvn deploy*)",
      "Bash(curl *api.github.com*)",
      "Bash(wget *api.github.com*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(bash <(curl *)",
      "Bash(bash <(wget *)",
      "Bash(sh <(curl *)",
      "Bash(sh <(wget *)",

      "mcp__claude_ai_Atlassian_-_Streamable__create*",
      "mcp__claude_ai_Atlassian_-_Streamable__edit*",
      "mcp__claude_ai_Atlassian_-_Streamable__update*",
      "mcp__claude_ai_Atlassian_-_Streamable__addComment*",
      "mcp__claude_ai_Atlassian_-_Streamable__addWorklog*",
      "mcp__claude_ai_Atlassian_-_Streamable__transitionJiraIssue",
      "mcp__claude_ai_Atlassian_-_Streamable__createIssueLink",

      "mcp__claude_ai_Slack__slack_send_*",
      "mcp__claude_ai_Slack__slack_schedule_*",
      "mcp__claude_ai_Slack__slack_create_*",
      "mcp__claude_ai_Slack__slack_update_*",

      "mcp__claude_ai_Notion__notion-create-*",
      "mcp__claude_ai_Notion__notion-update-*",
      "mcp__claude_ai_Notion__notion-duplicate-*",
      "mcp__claude_ai_Notion__notion-move-*",

      "mcp__claude_ai_Gmail__create_*",
      "mcp__claude_ai_Gmail__delete_*",
      "mcp__claude_ai_Gmail__label_*",
      "mcp__claude_ai_Gmail__unlabel_*",
      "mcp__claude_ai_Gmail__update_*",

      "mcp__claude_ai_Google_Calendar__create_*",
      "mcp__claude_ai_Google_Calendar__delete_*",
      "mcp__claude_ai_Google_Calendar__update_*",
      "mcp__claude_ai_Google_Calendar__respond_*",

      "mcp__claude_ai_Google_Drive__create_*",
      "mcp__claude_ai_Google_Drive__copy_*",

      "mcp__claude_ai_Pagerduty__create_*",
      "mcp__claude_ai_Pagerduty__update_*",
      "mcp__claude_ai_Pagerduty__manage_*",
      "mcp__claude_ai_Pagerduty__add_*",
      "mcp__claude_ai_Pagerduty__remove_*",

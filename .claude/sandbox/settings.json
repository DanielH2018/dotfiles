      "Bash(gh pr reopen*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr ready*)",
      "Bash(gh pr review*)",
      "Bash(gh pr lock*)",
      "Bash(gh pr unlock*)",
      "Bash(gh pr revert*)",
      "Bash(gh pr update-branch*)",
      "Bash(gh issue create*)",
      "Bash(gh issue close*)",
      "Bash(gh issue reopen*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue delete*)",

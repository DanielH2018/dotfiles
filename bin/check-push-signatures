#!/usr/bin/env bash
#
# check-push-signatures — reject a push that carries unsigned commits.
#
# `commit.gpgsign = true` is a default, not a guarantee: -c commit.gpgsign=false, an
# alternate HOME or GIT_CONFIG_GLOBAL, a clone on a machine whose gitconfig never got the
# signing block, and any rebase backend that drops signatures all produce unsigned commits
# with no complaint. Measured on this repo: 173 of 607 commits do not verify. Nothing
# rejected them at push time, so the invariant only held where it happened to hold.
#
# Reads git's pre-push protocol on stdin -- "<local ref> <local sha> <remote ref>
# <remote sha>" per ref -- and inspects only the commits this push would actually add.
#
# Verdicts follow git's %G? codes:
#   N (unsigned), B (bad signature), R (revoked key)  -> always rejected
#   U/X/Y/E (signed, but not verifiable against allowed_signers)  -> warn
#   G (good)                                                      -> pass
# U is a warning rather than an error on purpose: it means the signature is real but the
# signer is missing from ~/.config/git/allowed_signers, which is a local trust-list gap,
# not an unsigned commit. Set SIGN_GATE_STRICT=1 to demand G for everything -- do that
# once every signing key in use is listed there.
#
# Kept bash-3.2 clean (macOS default bash): no mapfile / associative arrays.

set -u

STRICT="${SIGN_GATE_STRICT:-}"

# --range <base> <head>: check an explicit range instead of git's pre-push protocol.
#
# For CI, which has a range to check but no push to read it from. Faking the protocol on
# stdin looked equivalent and was not: the hook path appends `--not --remotes` so a rebase
# replay on main is not re-judged, and on a runner `actions/checkout` has already created a
# remote-tracking ref for the very branch under test -- so every commit was excluded and the
# step checked ZERO while exiting 0 and printing nothing.
#
# That is the failure this repo keeps paying for, so this mode is loud by construction: it
# uses a plain two-dot range with no --remotes exclusion, and it REFUSES an empty one. A
# signature gate that checked nothing must never be indistinguishable from one that passed.
RANGE_MODE=0
RANGE_BASE=
RANGE_HEAD=
if [ "${1:-}" = "--range" ]; then
  RANGE_MODE=1
  RANGE_BASE="${2:-}"
  RANGE_HEAD="${3:-}"
  if [ -z "$RANGE_BASE" ] || [ -z "$RANGE_HEAD" ]; then
    printf 'check-push-signatures: --range needs <base> <head>\n' >&2
    exit 2
  fi
fi

# Nothing on stdin means this was run by hand rather than by git. Checking a range we
# were never given would either hang on the terminal or invent one, so do neither.
if [ "$RANGE_MODE" -eq 0 ] && [ -t 0 ]; then
  printf 'check-push-signatures: no pre-push input on stdin (run me from the hook)\n' >&2
  exit 0
fi

# N does not always mean unsigned, and nothing in the verdict says which it is.
#
# With gpg.ssh.allowedSignersFile UNSET, git will not even attempt to read an SSH signature:
# it prints "needs to be configured and exist for ssh signature verification" on stderr and
# reports %G? = N -- the same code a genuinely unsigned commit gets. So on a machine that
# has never configured one, every properly signed commit reads as unsigned and this gate
# rejects the whole push for a reason that is not true. Measured on this repo's first CI
# run: 10 of 10 signed commits reported "unsigned", against commits that read G locally.
#
# The trigger is the setting being ABSENT, not the file being missing. Measured on git
# 2.51: unset -> N, but pointed at /dev/null, at an empty file, or even at a path that does
# not exist -> U. So the check below tests only for a value; do not "improve" it into an
# existence test, which would refuse the working configurations above.
#
# Refuse to render a verdict rather than render a false one. Exit 3 is could-not-evaluate,
# the same code and the same reason as the transcript scanner's: a check that cannot ask
# the question must not answer it.
if [ -z "$(git config gpg.ssh.allowedSignersFile || true)" ]; then
  printf 'check-push-signatures: gpg.ssh.allowedSignersFile is unset.\n' >&2
  printf 'git reports EVERY ssh-signed commit as unsigned in that state, so this gate cannot\n' >&2
  printf 'tell a signed commit from an unsigned one and will not guess. Point it at a file --\n' >&2
  printf 'an empty one is enough to get "unverified" (a warning) instead of "unsigned".\n' >&2
  exit 3
fi

# An all-zero sha is git's "this ref does not exist": as the local sha it means the push
# deletes the ref (no commits to check), as the remote sha it means the branch is new.
is_zero() { case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac; }

bad=0
warned=0
checked=0

# One synthetic protocol line in range mode, so the loop below is shared rather than
# duplicated. remote_sha carries the base; the range is rebuilt from it just below.
if [ "$RANGE_MODE" -eq 1 ]; then
  INPUT=$(printf 'refs/heads/range %s refs/heads/range %s\n' "$RANGE_HEAD" "$RANGE_BASE")
else
  INPUT=$(cat)
fi

# git's pre-push protocol supplies four fields per line, positionally; only the two sha
# values are used here, but the refs have to be named to consume their columns.
# shellcheck disable=SC2034
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  is_zero "$local_sha" && continue                     # ref deletion

  if [ "$RANGE_MODE" -eq 1 ]; then
    # A plain two-dot range and nothing else. No --remotes: on a CI runner the branch under
    # test already HAS a remote-tracking ref, which would exclude every commit being checked.
    range="$local_sha --not $remote_sha"
  elif is_zero "${remote_sha:-}"; then
    # New branch: everything not already reachable from some other remote-tracking ref.
    # Without --not --remotes this walks back to the root commit and re-judges history
    # that was pushed long before this gate existed.
    range="$local_sha --not --remotes"
  else
    # $remote_sha is what the remote actually holds for this ref, straight from the
    # pre-push protocol, so it stays the primary exclusion. --remotes is added on top
    # for the rebase case: `gh pr merge --rebase`, which bin/land calls, replays commits
    # server-side and the replayed objects carry no signature, so main gains unsigned
    # commits on every landing. Rebasing a branch onto main then pulled those into
    # $remote_sha..$local_sha and the push was rejected for history the branch did not
    # write and could not fix. Anything already on a remote is out of scope either way.
    range="$local_sha --not $remote_sha --remotes"
  fi

  # shellcheck disable=SC2086  # $range is two or three deliberate rev-list tokens
  while IFS=$'\t' read -r sig sha subject; do
    [ -n "${sig:-}" ] || continue
    checked=$((checked + 1))
    case "$sig" in
      G) ;;
      N) printf '  unsigned   %s %s\n' "${sha:0:9}" "${subject:-}" >&2; bad=$((bad + 1)) ;;
      B) printf '  BAD sig    %s %s\n' "${sha:0:9}" "${subject:-}" >&2; bad=$((bad + 1)) ;;
      R) printf '  revoked    %s %s\n' "${sha:0:9}" "${subject:-}" >&2; bad=$((bad + 1)) ;;
      *) printf '  unverified %s %s (%s)\n' "${sha:0:9}" "${subject:-}" "$sig" >&2
         warned=$((warned + 1))
         [ -n "$STRICT" ] && bad=$((bad + 1)) ;;
    esac
  done < <(git log --format='%G?%x09%H%x09%s' $range 2>/dev/null)
done <<EOF
$INPUT
EOF

# Range mode says what it did, every time, and refuses to have done nothing. The hook path
# keeps its silence on success: it runs on every push and a line there would be noise.
if [ "$RANGE_MODE" -eq 1 ]; then
  if [ "$checked" -eq 0 ]; then
    printf 'check-push-signatures: checked 0 commits in %s..%s -- refusing to report a pass.\n' \
      "$RANGE_BASE" "$RANGE_HEAD" >&2
    printf 'An empty range means the caller computed it wrong, not that the commits are fine.\n' >&2
    exit 1
  fi
  printf 'check-push-signatures: checked %d commit(s) in %s..%s\n' \
    "$checked" "$RANGE_BASE" "$RANGE_HEAD"
fi

if [ "$bad" -ne 0 ]; then
  printf '\n%d of %d pushed commit(s) are not properly signed.\n' "$bad" "$checked" >&2
  printf 'Sign them (git rebase --exec "git commit --amend --no-edit -S" <base>) rather than bypassing.\n' >&2
  exit 1
fi

if [ "$warned" -ne 0 ]; then
  printf '%d signed commit(s) could not be verified -- add the signing key to ~/.config/git/allowed_signers.\n' "$warned" >&2
fi
exit 0

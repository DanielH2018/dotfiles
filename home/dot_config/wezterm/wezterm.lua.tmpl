-- WezTerm configuration — WINDOWS ONLY (chezmoi ignores this on non-Windows).
-- Mirrors the Ghostty config used on macOS/Linux (~/.config/ghostty/config) as closely
-- as WezTerm's Lua allows: same font, Catppuccin Mocha, padding, cursor, scrollback, and
-- the shift+enter -> newline binding for Claude Code. Keep the two in sync by hand.

local wezterm = require("wezterm")
local act = wezterm.action
local config = wezterm.config_builder()

-- ---------------------------------------------------------------------------
-- HELPERS
-- Resolve the Git Bash launcher ONCE. The local domain plus the agentview/homelab
-- tabs all spawn it; probing here keeps the path in a single place and survives a
-- machine where Git isn't under Program Files (winget-per-user / Scoop). Falls back
-- to the canonical path so a fresh box still gets a sensible default.
-- ---------------------------------------------------------------------------
local function first_existing(paths, fallback)
	for _, p in ipairs(paths) do
		if p and p ~= "" then
			local f = io.open(p, "r")
			if f then
				f:close()
				return p
			end
		end
	end
	return fallback
end
local git_bash = first_existing({
	"C:\\Program Files\\Git\\bin\\bash.exe",
	"C:\\Program Files (x86)\\Git\\bin\\bash.exe",
	(os.getenv("LOCALAPPDATA") or "") .. "\\Programs\\Git\\bin\\bash.exe",
	(os.getenv("USERPROFILE") or "") .. "\\scoop\\apps\\git\\current\\bin\\bash.exe",
}, "C:\\Program Files\\Git\\bin\\bash.exe")

-- ---------------------------------------------------------------------------
-- FONT  (shared values from .chezmoidata/terminal.toml — keeps Ghostty + WezTerm in sync).
-- Windows registers the Mono family as "IosevkaTerm NFM", so list the full name first and
-- the abbreviation as a fallback.
-- ---------------------------------------------------------------------------
config.font = wezterm.font_with_fallback({
	{ family = "{{ .terminal.font_family }}", weight = "{{ .terminal.font_weight }}" },
	{ family = "IosevkaTerm NFM", weight = "{{ .terminal.font_weight }}" },
})
config.font_size = {{ .terminal.font_size }}.0
config.harfbuzz_features = { {{ range $i, $f := .terminal.font_features }}{{ if $i }}, {{ end }}"{{ $f }}=1"{{ end }} }
-- Don't pop a toast when a glyph falls back to another font (Nerd Font symbols,
-- Claude's spinner braille, the agentview status icons). Fallback renders fine.
config.warn_about_missing_glyphs = false

-- ---------------------------------------------------------------------------
-- THEME  (Ghostty: theme = "Catppuccin Mocha") — built into WezTerm.
-- ---------------------------------------------------------------------------
config.color_scheme = "{{ .terminal.theme }}"

-- ---------------------------------------------------------------------------
-- CURSOR  (Ghostty: block, blink, cursor-color #fabd2f) — colors merge over the scheme.
-- ---------------------------------------------------------------------------
config.default_cursor_style = "BlinkingBlock"
config.cursor_blink_rate = 500
-- Hard on/off blink: the default EaseIn/EaseOut fade repaints the GPU every frame of the
-- transition (kept alive even under animation_fps=1). A block cursor gains nothing from a
-- fade, so make it a step so the GPU can idle between blinks.
config.cursor_blink_ease_in = "Constant"
config.cursor_blink_ease_out = "Constant"
config.colors = {
	cursor_bg = "{{ .terminal.cursor_color }}",
	cursor_border = "{{ .terminal.cursor_color }}",
	cursor_fg = "{{ .terminal.cursor_fg }}",
}

-- ---------------------------------------------------------------------------
-- WINDOW / BEHAVIOR  (Ghostty: 120x24, padding 20, scrollback 100000, no close confirm)
-- ---------------------------------------------------------------------------
config.initial_cols = {{ .terminal.cols }}
config.initial_rows = {{ .terminal.rows }}
config.window_padding = { left = {{ .terminal.padding }}, right = {{ .terminal.padding }}, top = {{ .terminal.padding }}, bottom = {{ .terminal.padding }} }
config.window_background_opacity = 1.0
config.window_close_confirmation = "NeverPrompt"
-- Drop the native Windows title bar and fold the min/max/close buttons into the fancy tab
-- bar. Do NOT pair this with hide_tab_bar_if_only_one_tab — the integrated buttons live in
-- the tab bar, so hiding it (with NeverPrompt + no title bar) would leave no pointer way to
-- close the window. The tab bar always shows; this box lives in tabs anyway.
config.window_decorations = "INTEGRATED_BUTTONS|RESIZE"
-- Render the fancy tab bar in Iosevka (shared data keys) instead of WezTerm's built-in UI
-- font, a couple points down so tab titles don't crowd the bar.
config.window_frame = {
	font = wezterm.font({ family = "{{ .terminal.font_family }}", weight = "{{ .terminal.font_weight }}" }),
	font_size = {{ .terminal.font_size }}.0 - 4.0,
}
-- Don't reflow the whole window when zooming the font (CTRL+= / CTRL+-); keep its size.
config.adjust_window_size_when_changing_font_size = false
config.scrollback_lines = {{ .terminal.scrollback }}
config.hide_mouse_cursor_when_typing = true
-- Bell OFF: the readline boundary bell (e.g. arrow past end-of-line) otherwise fires
-- Windows MessageBeep, which flashes the window when "visual notifications for sounds"
-- accessibility is on. Disable audible + zero-duration visual so nothing beeps or flashes.
config.audible_bell = "Disabled"
config.visual_bell = { fade_in_duration_ms = 0, fade_out_duration_ms = 0 }
-- Kitty graphics protocol is OFF by default in WezTerm; enable it for any
-- kitty-graphics tools. (The fastfetch banner itself uses the iterm2 protocol,
-- which WezTerm supports natively — see the fastfetch config.)
config.enable_kitty_graphics = true

-- ---------------------------------------------------------------------------
-- PERFORMANCE — pin the GPU front end so latency doesn't ride on WezTerm's runtime
-- auto-pick, prefer the discrete GPU, and drop the animation smoothing a block cursor
-- doesn't need. max_fps uncaps from the 60 default; WezTerm still clamps to the display.
-- ---------------------------------------------------------------------------
config.front_end = "WebGpu"
config.webgpu_power_preference = "HighPerformance"
config.animation_fps = 1
config.max_fps = 120

-- ---------------------------------------------------------------------------
-- DOMAINS / SHELL
--   Default domain is WSL (Ubuntu): new windows, tabs, and splits open straight
--   into the Linux login shell, starting in the Linux $HOME on fast ext4 — not a
--   translated /mnt/c path over the slow 9p bridge. This box runs dev + Claude Code
--   in UNIX, so Linux is the daily driver. Git Bash stays one keypress away on
--   CTRL+SHIFT+B (a local-domain tab), and the agentview / homelab tabs pin
--   DomainName="local" explicitly, so they're unaffected by the default flip.
-- ---------------------------------------------------------------------------
config.wsl_domains = {
	{
		name = "WSL:Ubuntu",
		distribution = "Ubuntu",
		-- Land in ~/dev on ext4 (a dedicated, trusted workspace), not $HOME or the Windows
		-- cwd under /mnt/c. Claude Code's trust prompt never persists for a $HOME workspace
		-- (claude-code#43958), so new shells/tabs/windows start in ~/dev to dodge it.
		default_cwd = "~/dev",
	},
}
config.default_domain = "WSL:Ubuntu"

-- Local-domain shell — Git Bash (login + interactive). Governs the local domain only:
-- the CTRL+SHIFT+B Git Bash tab and the agentview / homelab tabs (all DomainName="local").
-- The WSL default domain ignores this and runs its own login shell (bash + ble.sh).
config.default_prog = { git_bash, "-l", "-i" }

-- ---------------------------------------------------------------------------
-- KEYBINDINGS  — mirror ~/.config/ghostty/config. On macOS `cmd` is free of the
-- terminal's Ctrl codes; on Windows it isn't, so `cmd` -> CTRL+SHIFT, and a
-- Ghostty `cmd+shift` chord adds ALT (SHIFT is already spent standing in for
-- cmd). Copy / paste / reload keep the bare CTRL+SHIFT chord — that's the
-- Windows-terminal standard and matches the Ghostty letter anyway. Bracket keys
-- use `phys:` so holding Shift doesn't remap "[" to "{". Exceptions: split (cmd+d)
-- and close (cmd+w) map to BARE ctrl+d / ctrl+w so they match Ghostty's muscle
-- memory exactly — these override the shell's EOF / delete-word. Keep in sync with Ghostty.
-- ---------------------------------------------------------------------------
config.keys = {
	-- Claude Code multiline (ghostty: shift+enter=text:\n)
	{ key = "Enter", mods = "SHIFT", action = act.SendString("\n") },

	-- Config management (ghostty: cmd+shift+r)
	{ key = "R", mods = "CTRL|SHIFT", action = act.ReloadConfiguration },

	-- Clipboard (ghostty: cmd+shift+c / cmd+shift+v)
	{ key = "C", mods = "CTRL|SHIFT", action = act.CopyTo("Clipboard") },
	{ key = "V", mods = "CTRL|SHIFT", action = act.PasteFrom("Clipboard") },

	-- Tabs & windows (ghostty: cmd+t / cmd+w / cmd+shift+t / cmd+shift+w)
	-- new-tab (cmd+t) and close (cmd+w) map to BARE ctrl+t / ctrl+w to match Ghostty
	-- muscle memory. Those eat readline's transpose-chars / delete-previous-word —
	-- accepted tradeoff. Lowercase `key`: an uppercase letter implies Shift and would
	-- only fire on the ctrl+shift chord.
	{ key = "t", mods = "CTRL",       action = act.SpawnTab("CurrentPaneDomain") },
	-- Close the pane, always. The one exception: when fzf is the LIVE foreground process
	-- (the agentview picker), send ESC so fzf aborts cleanly. That branch is a nicety, not
	-- a requirement — the mux round-trip and lingering-ConPTY hangs that once made a
	-- force-close dangerous are gone (mux retired; agentview's reload job dies with its EXIT
	-- trap), so falling through to CloseCurrentPane is always safe. Detection is a live
	-- process check ONLY: the old code also honored a sticky `agentview` user var, but that
	-- var survives the picker's exit, so a pane where you once ran the picker kept reporting
	-- it forever and CTRL+W silently sent ESC (a no-op) instead of closing. pcall-guarded so
	-- a nil/throwing probe can never swallow the keypress — on any error we still close.
	{ key = "w", mods = "CTRL", action = wezterm.action_callback(function(window, pane)
		local ok, proc = pcall(function()
			return (pane:get_foreground_process_name() or ""):lower()
		end)
		if ok and proc:find("fzf") then
			window:perform_action(act.SendKey({ key = "Escape" }), pane)
		else
			window:perform_action(act.CloseCurrentPane({ confirm = false }), pane)
		end
	end) },
	-- New window (ghostty: cmd+shift+t). With OSC 7 now reporting the cwd, a plain
	-- SpawnWindow would inherit the active pane's dir — but a *window* should reset to the
	-- default (a new *tab* is what follows the cwd). Spawn through the mux with no cwd so it
	-- falls through to the WSL:Ubuntu domain's default_cwd ("~/dev").
	{ key = "T", mods = "CTRL|SHIFT", action = wezterm.action_callback(function()
		wezterm.mux.spawn_window({ domain = { DomainName = "WSL:Ubuntu" } })
	end) },
	{ key = "W", mods = "CTRL|SHIFT", action = act.QuitApplication },

	-- Splits (ghostty: cmd+d right / cmd+shift+d down). cmd+d maps to a BARE ctrl+d to
	-- match Ghostty. That eats the shell's EOF (exit) on ctrl+d — IGNOREEOF in
	-- ~/.config/shell/common.sh guards accidental exits in panes WezTerm doesn't intercept.
	-- Lowercase `key="d"` for the bare chord; `key="D"` (implies Shift) for the down-split.
	{ key = "d", mods = "CTRL",           action = act.SplitHorizontal({ domain = "CurrentPaneDomain" }) },
	{ key = "D", mods = "CTRL|SHIFT",     action = act.SplitVertical({ domain = "CurrentPaneDomain" }) },

	-- Navigate splits (ghostty: cmd+[ previous / cmd+] next)
	{ key = "phys:LeftBracket",  mods = "CTRL|SHIFT", action = act.ActivatePaneDirection("Prev") },
	{ key = "phys:RightBracket", mods = "CTRL|SHIFT", action = act.ActivatePaneDirection("Next") },

	-- Resize splits (ghostty: cmd+shift+[ left / cmd+shift+] right)
	{ key = "phys:LeftBracket",  mods = "CTRL|SHIFT|ALT", action = act.AdjustPaneSize({ "Left", 10 }) },
	{ key = "phys:RightBracket", mods = "CTRL|SHIFT|ALT", action = act.AdjustPaneSize({ "Right", 10 }) },

	-- --- WezTerm extras (no Ghostty equivalent) ---
	-- Agent View switcher (agentview): the UNIFIED picker, run WSL-side in a WSL:Ubuntu tab so
	-- ONE picker aggregates WSL + Windows + homelab sessions (Windows rows over /mnt/c, homelab
	-- over ssh). It MUST run inside a WezTerm pane so its Windows-pane focus (wezterm.exe cli
	-- activate-pane) can reach the GUI — a WSL-domain tab gives it $WEZTERM_PANE + the gui socket.
	-- `bash -lc` for a login PATH (~/.local/bin/agentview + jq/fzf); dismiss with ESC — it also
	-- closes itself after a jump.
	{ key = "S", mods = "CTRL|SHIFT", action = act.SpawnCommandInNewTab({
		domain = { DomainName = "WSL:Ubuntu" },
		args = { "bash", "-lc", "agentview" },
	}) },
	-- CTRL+Left: back to Agent View from inside a session pane (claude, sandbox docker,
	-- ssh attach). Fires only when the foreground process is NOT a shell — at a prompt
	-- the key passes through and stays word-left (zsh binds ^[[1;5D backward-word). WSL
	-- panes pass through too: WezTerm only sees wsl.exe there, and the tmux inside
	-- carries its own C-Left bind. pcall-guarded like CTRL+W; on any probe error the
	-- key passes through — never steal it on a bad read.
	{ key = "LeftArrow", mods = "CTRL", action = wezterm.action_callback(function(window, pane)
		local ok, proc = pcall(function()
			return (pane:get_foreground_process_name() or ""):lower()
		end)
		local base = ((ok and proc or ""):match("([^/\\]+)$") or ""):gsub("%.exe$", "")
		local shells = {
			zsh = true, bash = true, fish = true, sh = true, login = true, pwsh = true,
			powershell = true, cmd = true, ubuntu = true, wsl = true, wslhost = true,
		}
		if base == "" or shells[base] then
			window:perform_action(act.SendKey({ key = "LeftArrow", mods = "CTRL" }), pane)
		else
			window:perform_action(act.SpawnCommandInNewTab({
				domain = { DomainName = "WSL:Ubuntu" },   -- the unified WSL picker (see CTRL+SHIFT+S)
				args = { "bash", "-lc", "agentview" },
			}), pane)
		end
	end) },
	-- CTRL+SHIFT+N: start a NEW claude-sandbox session (pick repo + branch) without the
	-- picker. agentview --spawn runs its fzf pickers in this tab, then wezterm cli spawn
	-- opens the launched session in a fresh tab (the wezterm backend, no tmux here).
	{ key = "N", mods = "CTRL|SHIFT", action = act.SpawnCommandInNewTab({
		domain = { DomainName = "local" },
		args = { git_bash, "--noprofile", "--norc", "-c", "agentview --spawn" },
	}) },
	-- Homelab entry: a local tab that ssh's in and attaches (or creates) a `main`
	-- tmux session. tmux is the multiplexer now (not WezTerm-mux), so this is a plain
	-- local tab running ssh -t — no mux domain round-trip.
	{ key = "H", mods = "CTRL|SHIFT", action = act.SpawnCommandInNewTab({
		domain = { DomainName = "local" },
		args = { git_bash, "-l", "-c",
			"ssh -t daniel-server 'tmux new-session -A -s main'" },
	}) },
	-- Local Git Bash tab (pins the built-in local domain for a Windows shell).
	{ key = "B", mods = "CTRL|SHIFT", action = act.SpawnTab({ DomainName = "local" }) },
}

-- Jump straight to tab 1-9 (CTRL+<n>). No Ghostty equivalent — standard terminal
-- convention. ActivateTab is 0-indexed, so CTRL+1 -> tab 0.
for i = 1, 9 do
	table.insert(config.keys, { key = tostring(i), mods = "CTRL", action = act.ActivateTab(i - 1) })
end

-- ---------------------------------------------------------------------------
-- MOUSE  — Windows-terminal conventions on top of the CTRL+SHIFT+C/V keybinds.
-- No Ghostty equivalent (mouse config is terminal-specific). Left-drag release copies
-- the selection AND still opens a hyperlink on a plain click (OrOpenLink keeps the
-- default link-open behavior); right-click pastes.
-- ---------------------------------------------------------------------------
config.mouse_bindings = {
	{
		event = { Up = { streak = 1, button = "Left" } },
		mods = "NONE",
		action = act.CompleteSelectionOrOpenLinkAtMouseCursor("ClipboardAndPrimarySelection"),
	},
	{
		event = { Down = { streak = 1, button = "Right" } },
		mods = "NONE",
		action = act.PasteFrom("Clipboard"),
	},
}

-- ---------------------------------------------------------------------------
-- REMOTE ACCESS — the homelab is reached via ssh + tmux (CTRL+SHIFT+H), NOT a
-- WezTerm mux domain. tmux is the portable multiplexer across machines; retiring the
-- mux domain also removes the CTRL+W GUI-hang class (which was the mux round-trip over
-- WireGuard). The agentview picker (CTRL+SHIFT+S) aggregates WSL + Windows (PC) + homelab
-- sessions and attaches to remote ones by spawning an ssh+tmux tab. Default domain
-- stays local; nothing to configure.
-- ---------------------------------------------------------------------------
config.ssh_domains = {}

-- ---------------------------------------------------------------------------
-- RELOAD FEEDBACK — WezTerm reloads config silently (on CTRL+SHIFT+R and on save
-- via automatic_reload). With no confirmation the reload key feels like a no-op, so
-- surface a short toast on every reload. But `window-config-reloaded` ALSO fires once
-- at startup, which pops an unwanted toast on launch — suppress that first fire via
-- wezterm.GLOBAL (persists across reloads, resets only on a full GUI restart).
-- ---------------------------------------------------------------------------
wezterm.on("window-config-reloaded", function(window)
	if not wezterm.GLOBAL.startup_toast_shown then
		wezterm.GLOBAL.startup_toast_shown = true
		return
	end
	window:toast_notification("WezTerm", "Configuration reloaded ✳", nil, 1500)
end)

-- ---------------------------------------------------------------------------
-- TAB TITLES — index + a domain glyph (WSL vs local Windows) + the pane title, so the
-- WSL / git-bash / agentview / homelab-ssh tabs are distinguishable at a glance. Prefer an
-- explicitly-set tab_title first: agentview stamps pane titles over OSC, and this only
-- computes one when the process left the default. No Ghostty equivalent (WezTerm-only).
-- ---------------------------------------------------------------------------
wezterm.on("format-tab-title", function(tab)
	local title = tab.tab_title
	if title == nil or title == "" then
		title = tab.active_pane.title
	end
	local glyph = (tab.active_pane.domain_name or ""):find("WSL") and " " or " "
	return string.format(" %d %s%s ", tab.tab_index + 1, glyph, title)
end)

return config

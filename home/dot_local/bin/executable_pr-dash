#!/usr/bin/env bash
# Launch the PR dashboard on a loopback port and open it.
set -euo pipefail

SHARE_DIR="${HOME}/.local/share/pr-dash"
PORT="${PR_DASH_PORT:-8770}"
PR_DASH_SECRET="$(node -e 'process.stdout.write(require("node:crypto").randomBytes(24).toString("hex"))')"
export PR_DASH_SECRET PR_DASH_PORT="$PORT"

node "${SHARE_DIR}/src/main.ts" &
SERVER_PID=$!
trap 'kill "$SERVER_PID" 2>/dev/null || true' EXIT

sleep 0.4
URL="http://127.0.0.1:${PORT}/#${PR_DASH_SECRET}"
# `open`'s exit status must not reach `set -e`: under -e, a failing command that
# isn't part of a condition ends the script, which fires the EXIT trap and kills
# the server this script just started over a browser launch that never mattered
# to the server's own lifetime — e.g. no GUI session over SSH, or no default
# handler registered. Testing it in an `if` keeps the failure from tripping -e.
if ! open "$URL"; then
  echo "Could not open a browser automatically. Open this URL yourself:" >&2
  echo "$URL" >&2
fi
wait "$SERVER_PID"

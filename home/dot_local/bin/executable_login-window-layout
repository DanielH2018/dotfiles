#!/usr/bin/env bash
# Open the everyday app set at login, one per monitor.
#
# Which monitor each window lands on is not decided here -- that comes from the
# "login placement" rules in kwinrulesrc, which pin each window class to a
# coordinate inside the target output. KWin's own screen=N rule is inert on
# Wayland here: it matches the window and then never moves it. This script only
# decides *what* starts and in *what order*.
#
# Order matters for the bottom monitor: Spotify and Obsidian are placed on top of
# each other there, so Obsidian starts last to end up as the visible one.
#
# Every launch is guarded on whether the app is already running, so running this
# by hand mid-session tops up what is missing instead of opening duplicates.
set -uo pipefail

# Seconds to wait after Spotify before starting Obsidian. Spotify is Electron and
# maps its window well after the process starts; starting Obsidian too early
# leaves Spotify on top.
OBSIDIAN_DELAY="${OBSIDIAN_DELAY:-8}"

log() { printf '%s login-window-layout: %s\n' "$(date +%H:%M:%S)" "$*"; }

# start <name> <pgrep-pattern> <command...>
start() {
  local name="$1" pattern="$2"
  shift 2
  if pgrep -f "$pattern" >/dev/null 2>&1; then
    log "$name already running, skipping"
    return 0
  fi
  log "starting $name"
  "$@" >/dev/null 2>&1 &
}

# Discord self-updates into ~/.config/discord/app-<version>/, so match on that
# path shape rather than the /usr/bin launcher, which only execs into it and so
# never appears in the process table itself.
start Discord '/discord/app-[^/]*/Discord' discord
start Firefox '^/usr/lib64/firefox/firefox' firefox
start Ghostty '^/usr/bin/ghostty' ghostty --gtk-single-instance=true
start Spotify 'share/spotify/spotify' flatpak run com.spotify.Client

sleep "$OBSIDIAN_DELAY"
start Obsidian '/app/obsidian' flatpak run md.obsidian.Obsidian

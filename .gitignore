# Ignore everything in ~ by default — dotfiles repo only tracks explicit files
*

# Shell config
!.zshrc
!.zshenv
!.zprofile
!.bash_profile

# Package manifest
!Brewfile

# Git config
!.gitconfig
!.gitignore
!.gitignore_global

# .config — un-ignore directory, re-ignore contents, then selectively allow
!.config/
.config/*

!.config/starship.toml

!.config/ghostty/
.config/ghostty/*
!.config/ghostty/config
!.config/ghostty/shaders/
!.config/ghostty/shaders/**

!.config/fastfetch/
.config/fastfetch/*
!.config/fastfetch/config.jsonc
!.config/fastfetch/logos/
!.config/fastfetch/logos/**

# Claude Code — un-ignore directory, then re-ignore contents, then un-ignore tracked items
!.claude/
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/commands/
!.claude/commands/*
!.claude/hooks/
!.claude/hooks/*
!.claude/projects/
.claude/projects/*
!.claude/projects/-Users-daniel/
.claude/projects/-Users-daniel/*
!.claude/projects/-Users-daniel/memory/
!.claude/projects/-Users-daniel/memory/**

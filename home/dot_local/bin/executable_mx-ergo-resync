#!/usr/bin/env bash
# Re-assert the MX Ergo S's full intended state after something else changed it.
#
# Logi Options+ on another machine diverts the controls it manages -- the scroll
# wheel included -- and diversion is device runtime state, not per-host state.
# Come back to this machine and the wheel is still diverted, which kills
# scrolling outright: a diverted wheel sends LOWRES_WHEEL HID++ notifications
# that nothing here consumes.
#
# Solaar only re-applies its saved settings when a device reconnects. If the
# Bolt receiver never left its port there is no reconnect and nothing heals on
# its own, so this is a button rather than a daemon. Restarting Solaar fixes it
# too; this is the same repair without dropping every other device's session.
#
# Deliberately does NOT touch dpi. The hold-to-precision rules own that value at
# runtime, and asserting it here would fight them mid-press.

set -uo pipefail

SERIAL=${MX_ERGO_SERIAL:-BD092C51}

# Control -> intended action. Only the two this setup actually moves; the rest
# keep whatever they have. `solaar config reprogrammable-keys` is the call that
# can die with "TypeError: 'str' object does not support item assignment" and
# corrupt config.yaml on the way out, so it gets the smallest surface that still
# restores the setup. Middle Button's action is unused while it is diverted, but
# asserting it means the button degrades to a plain middle click if Solaar stops.
ACTIONS=(
    "Middle Button:Mouse Middle Button"
    "DPI Switch:Mouse Middle Button"      # the clicks the middle button gave up
)

# Only the middle button is diverted -- it is the precision hold. Everything
# else must be Regular or the device stops sending those events at all.
DIVERSIONS=(
    "Middle Button:Diverted"
    "Back Button:Regular"
    "Forward Button:Regular"
    "Left Tilt:Regular"
    "Right Tilt:Regular"
    "DPI Switch:Regular"
)

solaar_q() { timeout 25 solaar config "$SERIAL" "$@" 2>&1 | grep -v '^rules cannot'; }

state() {
    solaar_q lowres-scroll-mode | grep -E '^lowres-scroll-mode'
    solaar_q divert-keys        | grep -E '^divert-keys'
    solaar_q reprogrammable-keys| grep -E '^reprogrammable-keys'
}

# `solaar config` only reaches active devices; on a sleeping trackball every
# write below is a silent no-op, so fail loudly instead of reporting success.
before=$(state)
if [ -z "$before" ]; then
    echo "mx-ergo-resync: MX Ergo S ($SERIAL) not reachable -- move the trackball to wake it, then retry" >&2
    exit 1
fi

echo "before:"; echo "$before" | sed 's/^/  /'

# Scroll wheel back to plain HID reports. This is the one that kills scrolling.
solaar_q lowres-scroll-mode false >/dev/null

for pair in "${ACTIONS[@]}"; do
    solaar_q reprogrammable-keys "${pair%%:*}" "${pair#*:}" >/dev/null
done
for pair in "${DIVERSIONS[@]}"; do
    solaar_q divert-keys "${pair%%:*}" "${pair#*:}" >/dev/null
done

after=$(state)
echo "after:"; echo "$after" | sed 's/^/  /'

if [ "$before" = "$after" ]; then
    echo "(no drift -- already in the intended state)"
fi

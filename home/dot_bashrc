# ~/.bashrc — interactive Bash config. Primary use is Git Bash on Windows; the zsh config
# in ~/.zshrc covers macOS/Linux. Sourced from ~/.bash_profile for login shells (Git Bash
# doesn't read ~/.bashrc on its own).
#
# Config shared with zsh (env, PATH, aliases, functions, tool init) lives in
# ~/.config/shell/common.sh — the single source of truth. This file holds ONLY the
# bash-specific pieces: history, shell options, completion, readline, ble.sh, and the
# fastfetch login banner. Every integration is guarded, so it's a clean no-op when a tool
# is absent.
#
# shellcheck shell=bash
#
# No extension and no shebang (an rc file is sourced, never executed), so nothing typed
# this as shell and it sat outside both prek and lint-after-edit. The directive is what
# puts it under the gate.

# Interactive shells only.
case $- in
  *i*) ;;
  *) return ;;
esac

# Git Bash / Cygwin doesn't set $USER or $HOSTNAME (Windows uses $USERNAME), which trips
# ble.sh's environment sanity check ("insane environment: $USER is empty"). Set them before
# sourcing ble.sh below. No-op where they're already set (macOS/Linux).
# Assigned then exported on separate statements: `export USER="$(id -un)"` makes the
# export the command whose status the shell sees, hiding a failing id/hostname (SC2155).
if [ -z "${USER:-}" ]; then USER="$(id -un 2>/dev/null)"; export USER; fi
if [ -z "${HOSTNAME:-}" ]; then HOSTNAME="$(hostname 2>/dev/null)"; export HOSTNAME; fi

# --- ble.sh (Bash Line Editor): fish-style autosuggestions + syntax highlighting, the bash
#     analog of zsh-autosuggestions + zsh-syntax-highlighting. Source with --noattach here
#     and `ble-attach` at the very end so it wraps the whole interactive session. Installed
#     by run_onchange_after_install-blesh.sh.tmpl; a clean no-op when absent.
#     Skipped on Windows (msys/cygwin): ble.sh re-implements the whole line editor in bash,
#     and MSYS bash runs that per-keystroke work several times slower than Linux — felt as
#     typing lag in Git Bash tabs (a TUI in the same tab is crisp, so the cost is ble.sh,
#     not the terminal). Plain readline is the Windows tradeoff.
if [[ $OSTYPE != msys* && $OSTYPE != cygwin* && -f "$HOME/.local/share/blesh/ble.sh" ]]; then
  source "$HOME/.local/share/blesh/ble.sh" --noattach
fi

# --- History (bash equivalents of the zsh HIST_* options) ---
# Set explicitly (not inherited) so a bash started from zsh doesn't pick up zsh's
# HISTFILE — zsh's is a plain, non-exported var now, but this makes bash's own
# default self-contained regardless (A14-01).
HISTFILE="$HOME/.bash_history"
HISTSIZE=200000
HISTFILESIZE=200000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend
if [[ ${BLE_VERSION-} ]]; then
  # ble.sh manages the line editor + history; use its concurrent-shell sharing rather than
  # injecting `history -a` into PROMPT_COMMAND (which ble.sh parses into array elements — a
  # trailing empty element there collides with zoxide's hook and produces a `;;` syntax error).
  bleopt history_share=1 2>/dev/null
else
  # Flush each command to the history file so concurrent shells share it. The :+ form avoids
  # a trailing empty command when PROMPT_COMMAND is unset.
  PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
fi

# --- Shell options (bash analogs of the zsh setopt line: AUTO_CD, NO_CASE_GLOB, EXTENDED_GLOB) ---
shopt -s autocd nocaseglob globstar cdspell dirspell 2>/dev/null

# --- Shared config: env, PATH, aliases, functions, tool init (one source of truth with zsh) ---
[ -r "$HOME/.config/shell/common.sh" ] && . "$HOME/.config/shell/common.sh"

# --- fzf key bindings + completion (bash integration; the FZF_* env is set in common.sh) ---
# fzf >=0.48 ships its bash key-bindings + completion via `fzf --bash`.
command -v fzf >/dev/null 2>&1 && { eval "$(fzf --bash 2>/dev/null)" 2>/dev/null || true; }

# --- bash-completion (the bash counterpart to zsh's compinit) ---
if ! shopt -oq posix; then
  for _bc in /usr/share/bash-completion/bash_completion /etc/bash_completion; do
    # shellcheck source=/dev/null  # distro-provided, path varies by distro and isn't in this tree
    [ -r "$_bc" ] && { . "$_bc"; break; }
  done
  unset _bc
fi

# --- Readline: prefix history search on Up/Down + Ctrl+arrow word nav ---
bind '"\e[A": history-search-backward' 2>/dev/null
bind '"\e[B": history-search-forward' 2>/dev/null
bind '"\e[1;5C": forward-word' 2>/dev/null
bind '"\e[1;5D": backward-word' 2>/dev/null
# Keep bracketed paste (multiline safety) but drop the active-region highlight: its
# reverse-video (\e[7m) renders pasted text bg-on-bg (invisible) until the next keypress.
bind 'set enable-active-region off' 2>/dev/null
# No bell at the source: readline otherwise emits \a on boundaries (e.g. arrow past
# end-of-line), which WezTerm/Windows render as a full-window flash.
bind 'set bell-style none' 2>/dev/null

# The homelab's SOPS age key. Owned here rather than by the server repo's sops_setup role,
# which used to lineinfile it onto the end of this file — after ble-attach, and undone by
# every chezmoi apply (server#2319).
export SOPS_AGE_KEY_FILE=$HOME/.config/sops/age/keys.txt

# --- fastfetch banner on login shells only (per-terminal logo logic: _ff_banner in common.sh) ---
# MUST run BEFORE ble-attach (below): once ble.sh drives the terminal, its query handling
# collides with fastfetch's image-capability probe and the logo drops to ASCII. Running here
# (pre-attach) keeps the terminal I/O clean so the image renders. Don't move past ble-attach.
if shopt -q login_shell && command -v _ff_banner >/dev/null 2>&1; then
  _ff_banner
fi

# Machine-local bash config (per-machine; absent on portable machines).
[ -r "$HOME/.config/bash/local.bash" ] && . "$HOME/.config/bash/local.bash"

# --- ble.sh attach: MUST be the last line (mirrors sourcing zsh-syntax-highlighting last) ---
[[ ${BLE_VERSION-} ]] && ble-attach

# syntax=docker/dockerfile:1
FROM debian:stable-slim

# --- All system packages in a single layer ---
# Bootstrap curl → add gh/docker repos → install everything in one pass.
# Cache mounts reuse downloaded .deb files and package indexes across rebuilds,
# but only once two defaults are undone: debian:*-slim ships
# /etc/apt/apt.conf.d/docker-clean, whose DPkg::Post-Invoke deletes every .deb
# right after install, and the conventional `rm -rf /var/lib/apt/lists/*` empties
# the *cache mount* rather than the layer (a cache-mounted path never lands in
# the layer at all, so there is nothing there to shrink). With both removed the
# mounts hold ~200MB of debs + indexes and a rebuild of these layers is local.
# Inherited by every per-repo image, whose apt layers mount the same caches.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' \
       > /etc/apt/apt.conf.d/keep-cache \
    && mkdir -p /var/cache/apt/archives/partial /var/lib/apt/lists/partial \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && mkdir -p -m 755 /etc/apt/keyrings \
    # GitHub CLI repo
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
       -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] \
       https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
    # Docker CLI repo
    && curl -fsSL https://download.docker.com/linux/debian/gpg \
       -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] \
       https://download.docker.com/linux/debian \
       $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
       > /etc/apt/sources.list.d/docker.list \
    # Single install pass
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       git jq tini openssh-client make wl-clipboard \
       gh docker-ce-cli docker-compose-plugin

# Node.js (needed for Claude Code npm install)
ARG NODE_VERSION=22
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs

# chezmoi
# Dotfiles manager. The vault sandbox bind-mounts the chezmoi SOURCE read-write;
# this binary lets the agent preview/manage it (cat/diff/managed/source-path/
# execute-template). Pinned + checksum-verified (no curl|sh). apply/update/add
# target the CONTAINER home (not the host) and are denied in settings.base.json;
# run those on the host. Pinned to match the host version.
ARG CHEZMOI_VERSION=2.70.5
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    base="https://github.com/twpayne/chezmoi/releases/download/v${CHEZMOI_VERSION}"; \
    file="chezmoi_${CHEZMOI_VERSION}_linux_${arch}.tar.gz"; \
    cd /tmp; \
    curl -fsSL -O "${base}/${file}"; \
    curl -fsSL -O "${base}/chezmoi_${CHEZMOI_VERSION}_checksums.txt"; \
    grep " ${file}$" "chezmoi_${CHEZMOI_VERSION}_checksums.txt" | sha256sum -c -; \
    tar -xzf "${file}" chezmoi; \
    install -m 0755 chezmoi /usr/local/bin/chezmoi; \
    rm -f "${file}" "chezmoi_${CHEZMOI_VERSION}_checksums.txt" chezmoi; \
    chezmoi --version

# uv
# Resolves and runs the managed Python 3.14 that claude-guard's PreToolUse deny hook needs:
# hooks/executable_guard-pre-tool-use.sh finds its interpreter with
# `uv python find --no-project --managed-python --system 3.14`. Pinned + checksum-verified,
# the same shape as chezmoi above. executable_sandbox-image.sh installs uv per repo with
# `curl | sh`, which is not a shape to bake into the base image.
#
# `uname -m` here, not the chezmoi layer's `dpkg --print-architecture`: uv names its release
# assets aarch64/x86_64, where dpkg says arm64/amd64. Copying the line above 404s at build.
ARG UV_VERSION=0.12.13
RUN set -eux; \
    arch="$(uname -m)"; \
    base="https://github.com/astral-sh/uv/releases/download/${UV_VERSION}"; \
    file="uv-${arch}-unknown-linux-gnu.tar.gz"; \
    cd /tmp; \
    curl -fsSL -O "${base}/${file}"; \
    curl -fsSL -O "${base}/${file}.sha256"; \
    sha256sum -c "${file}.sha256"; \
    tar -xzf "${file}" --strip-components=1; \
    install -m 0755 uv /usr/local/bin/uv; \
    rm -f "${file}" "${file}.sha256" uv uvx; \
    uv --version

# Non-root user
RUN useradd --create-home --shell /bin/bash --uid 1000 claudebot
USER claudebot
WORKDIR /workspace

# Config mount point — settings, hooks, and CLAUDE.md are bind-mounted into
# .claude-defaults/ at runtime (not baked into the image) so config edits
# don't bust the Docker layer cache. Entrypoint syncs them into the
# persistent .claude/ volume on each launch.
#
# .cache must exist and belong to claudebot BEFORE the first build cache mount
# under it: a cache mount creates any missing parent as root:root, and the
# fastembed model download below then can't create ~/.cache/huggingface next to
# the mounted ~/.cache/pip. Fails as a bare "Permission denied (os error 13)"
# from deep inside huggingface_hub.
RUN mkdir -p /home/claudebot/.claude-defaults/hooks \
             /home/claudebot/.claude/hooks \
             /home/claudebot/.cache

# The managed interpreter the deny hook resolves, installed as claudebot rather than root.
# `uv python find --managed-python` only answers with an install in the RUNNING user's data
# dir (~/.local/share/uv/python), and the hook runs as claudebot. Installed as root it lands
# in /root, the lookup fails, and every Bash call in the container denies — the fail-closed
# contract working as designed, on a build mistake.
#
# Requested as `3.14`, matching the hook's own request, so the patch level floats to whatever
# is current at build time. The package is stdlib-only, so any 3.14.x serves; the in-container
# replay gate is what confirms the interpreter a given image resolved.
RUN uv python install 3.14

# --- vault-index semantic search tooling (shared layer) ---
# Used when a sandbox mounts a curated read-only vault subset: the host builds a
# DuckDB index over ONLY the allowlisted pages and mounts it read-only; the
# container queries it offline via this venv. bge-small + the DuckDB fts
# extension are prefetched here so query needs no network. The model layer is
# content-addressed and shared across all per-repo images (FROM claudebot:base),
# not duplicated on disk.
USER root
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv \
    && mkdir -p /opt/vault-index && chown claudebot:claudebot /opt/vault-index
COPY vault-search /usr/local/bin/vault-search
RUN chmod +x /usr/local/bin/vault-search
USER claudebot

# Snowflake CLI (`snow`) for the query-snowflake skill (privacy-com/claude-skills,
# analytics-tools plugin). Own venv, same pattern as vault-index below, so it
# doesn't fight the system Python.
ENV SNOWFLAKE_CLI_VENV=/opt/snowflake-cli/venv
USER root
RUN mkdir -p /opt/snowflake-cli && chown claudebot:claudebot /opt/snowflake-cli
USER claudebot
# pip's download cache lives in a build cache mount, not in the layer, so
# --no-cache-dir is unnecessary here: the wheels stay out of the image *and*
# survive for the next rebuild. uid/gid match claudebot so pip can write it.
RUN --mount=type=cache,target=/home/claudebot/.cache/pip,uid=1000,gid=1000,sharing=locked \
    python3 -m venv "$SNOWFLAKE_CLI_VENV" \
    && "$SNOWFLAKE_CLI_VENV/bin/pip" install snowflake-cli
USER root
RUN ln -s "$SNOWFLAKE_CLI_VENV/bin/snow" /usr/local/bin/snow
# Pre-create with correct ownership: bind-mounting config.toml into a
# directory that doesn't exist yet in the image makes Docker auto-create it
# as root, and claudebot then can't write its own logs/ subdir.
RUN mkdir -p /home/claudebot/.snowflake && chown claudebot:claudebot /home/claudebot/.snowflake
USER claudebot
ENV VAULT_INDEX_VENV=/opt/vault-index/venv
ENV VAULT_INDEX_MODEL_CACHE=/opt/vault-index/models
ARG VAULT_INDEX_MODEL="BAAI/bge-small-en-v1.5"
RUN --mount=type=cache,target=/home/claudebot/.cache/pip,uid=1000,gid=1000,sharing=locked \
    python3 -m venv "$VAULT_INDEX_VENV" \
    && "$VAULT_INDEX_VENV/bin/pip" install fastembed duckdb \
    && mkdir -p "$VAULT_INDEX_MODEL_CACHE" \
    && HF_HUB_OFFLINE=0 "$VAULT_INDEX_VENV/bin/python" -c "import os; from fastembed import TextEmbedding; TextEmbedding('$VAULT_INDEX_MODEL', cache_dir=os.environ['VAULT_INDEX_MODEL_CACHE'])" \
    && "$VAULT_INDEX_VENV/bin/python" -c "import duckdb; c=duckdb.connect(); c.execute('INSTALL fts'); c.close()"

# Seed .claude.json so first-run prompts are skipped
COPY --chown=claudebot:claudebot claude.json /home/claudebot/.claude.json

# Git config for signed commits + HTTPS credential routing.
# SSH URLs are rewritten to HTTPS; credentials are supplied by gh, which reads
# from ~/.config/gh/hosts.yml (mounted read-only at runtime).
RUN git config --global user.name "Daniel Hunter" \
    && git config --global user.email "danielh.2018@gmail.com" \
    && git config --global gpg.format ssh \
    && git config --global user.signingkey "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDA7LulgtoUwepzoMDD4UgAS1OD09qi4WvvJnDOUNkou" \
    && git config --global commit.gpgsign true \
    && git config --global gpg.ssh.allowedSignersFile /home/claudebot/.ssh/allowed_signers \
    && git config --global url."https://github.com/".insteadOf "git@github.com:" \
    && git config --global credential."https://github.com".helper '!/usr/bin/gh auth git-credential'

# Allowed signers (so git can verify its own commits)
RUN mkdir -p /home/claudebot/.ssh \
    && echo "danielh.2018@gmail.com ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDA7LulgtoUwepzoMDD4UgAS1OD09qi4WvvJnDOUNkou" \
    > /home/claudebot/.ssh/allowed_signers

# Audit mount point (created as root before final USER switch)
USER root
RUN mkdir -p /audit && chown claudebot:claudebot /audit

# Claude Code — deliberately the LAST expensive layer.
# It is the only thing in this image that changes on a normal week, and every
# layer below a changed one rebuilds: sited up by the toolchain (where it used
# to be) a new release re-ran both pip venvs and re-downloaded the embedding
# model. Down here a release costs one `npm install -g`.
#
# The launcher resolves @latest on the host and passes the concrete version, so
# the layer's cache key IS the release: an unchanged version is a cache hit and
# the daily check builds nothing. CLAUDE_CODE_REFRESH stays as the escape hatch
# --rebuild-base uses to force a reinstall of this layer alone.
#
# Sits just above the entrypoint COPY, not at the very bottom, so editing
# entrypoint.sh re-runs only that copy instead of reinstalling Claude Code.
# npm's cache is a build cache mount, so it speeds up rebuilds without landing
# in the image (which is what `npm cache clean --force` used to buy).
ARG CLAUDE_CODE_VERSION="latest"
ARG CLAUDE_CODE_REFRESH="0"
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    echo "claude-code refresh token: ${CLAUDE_CODE_REFRESH}" \
    && npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && claude --version

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Run as claudebot
USER claudebot
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["claude", "--dangerously-skip-permissions"]

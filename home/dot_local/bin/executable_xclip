#!/usr/bin/env bash
# Shim: forward xclip calls to WSLg's wl-copy/wl-paste, which bridge to the
# Windows clipboard. Installed because /etc/wsl.conf sets appendWindowsPath=false
# (so clip.exe isn't on PATH) and real xclip/xsel aren't installed.
#
# Two things beyond a plain forward, both for Claude Code's image paste:
#   - The TARGETS probe is answered with `wl-paste -l` (the type list). The old
#     shim ignored -t and dumped raw bytes, so Claude's `... | grep image/*`
#     matched nothing and it saw no image.
#   - WSLg mirrors the Windows clipboard image ONLY as image/bmp, but Claude and
#     the Anthropic API accept png/jpeg/gif/webp — not bmp. So a request for
#     image/png with only a bmp present is converted on the fly (wl-bmp2png), and
#     TARGETS advertises image/png when a bmp is available.
# Match a whole line in a newline-separated list, using only bash builtins so the
# shim needs nothing on PATH but wl-copy/wl-paste (+ wl-bmp2png for conversion).
has_type() { case $'\n'"$1"$'\n' in *$'\n'"$2"$'\n'*) return 0 ;; *) return 1 ;; esac; }

out=0
target=
prev=
for arg in "$@"; do
  case "$prev" in
    -t|-target) target="$arg" ;;
  esac
  case "$arg" in
    -o|-out) out=1 ;;
  esac
  prev="$arg"
done

if [ "$out" -eq 1 ]; then
  case "$target" in
    TARGETS)
      types="$(wl-paste -l 2>/dev/null)" || exit 1
      printf '%s\n' "$types"
      # Advertise image/png when only a bmp is on the clipboard — the image/png
      # read below synthesizes it, and callers that gate on a supported type
      # (Claude) then see one.
      if ! has_type "$types" image/png && has_type "$types" image/bmp; then
        echo image/png
      fi
      ;;
    image/png)
      types="$(wl-paste -l 2>/dev/null)"
      if has_type "$types" image/png; then
        exec wl-paste --no-newline --type image/png
      elif has_type "$types" image/bmp; then
        wl-paste --type image/bmp 2>/dev/null | wl-bmp2png
        exit "${PIPESTATUS[1]}"
      else
        exec wl-paste --no-newline --type image/png
      fi
      ;;
    ?*)
      exec wl-paste --no-newline --type "$target"
      ;;
    *)
      exec wl-paste --no-newline
      ;;
  esac
else
  case "$target" in
    ?*) exec wl-copy --type "$target" ;;
    *)  exec wl-copy ;;
  esac
fi

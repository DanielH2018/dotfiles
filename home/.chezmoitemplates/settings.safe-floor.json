{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~ *)",
      "Bash(rm -rf ~/ *)",
      "Bash(* | sh)",
      "Bash(* | sh *)",
      "Bash(* | sh;*)",
      "Bash(* | sh&*)",
      "Bash(* | sh|*)",
      "Bash(* | sh)*)",
      "Bash(* | sh\n*)",
      "Bash(* | bash)",
      "Bash(* | bash *)",
      "Bash(* | bash;*)",
      "Bash(* | bash&*)",
      "Bash(* | bash|*)",
      "Bash(* | bash)*)",
      "Bash(* | bash\n*)",
      "Bash(* | zsh)",
      "Bash(* | zsh *)",
      "Bash(* | zsh;*)",
      "Bash(* | zsh&*)",
      "Bash(* | zsh|*)",
      "Bash(* | zsh)*)",
      "Bash(* | zsh\n*)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/credentials)",
      "Read(**/.env)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Edit(**/.ssh/**)"
    ]
  }
}

#!/usr/bin/env node
'use strict';
// gen-launchd — render scheduled/*.plist.tmpl from scheduled/launchd.json.
//
// The output stays a chezmoi template outside home/, so nothing about activation changes:
// each file's header still carries the execute-template and launchctl commands that render
// and load it by hand. What changes is that the definition lives in one manifest with a
// schema (documented at the top of gen-launchd-lib.js), shared with work-laptop-config's
// launchd.json, instead of in hand-written XML.
//
// Every scheduled/*.plist.tmpl is generated. A template with no manifest entry is an error,
// whether it carries the generated header or was written by hand, since nothing would keep
// it current.
//
// Usage:
//   gen-launchd            rewrite every template the manifest names
//   gen-launchd --check    render to memory and exit non-zero when a committed template
//                          differs (tests/gen-launchd.test.js runs this against the real tree)

const fs = require('node:fs');
const path = require('node:path');
const lib = require('./gen-launchd-lib.js');
const { reportCheck } = require('./gen-lib.js');

const REPO_ROOT = path.resolve(__dirname, '..');
const MANIFEST = path.join(REPO_ROOT, 'scheduled', 'launchd.json');
const SCHEDULED = path.join(REPO_ROOT, 'scheduled');

function main() {
  const check = process.argv.includes('--check');
  const rendered = lib.renderManifest(JSON.parse(fs.readFileSync(MANIFEST, 'utf8')));
  let ok = true;

  for (const { plist, text } of rendered) {
    const abs = path.join(REPO_ROOT, plist);
    const committed = fs.existsSync(abs) ? fs.readFileSync(abs, 'utf8') : '';
    if (check) {
      ok = reportCheck({ tool: 'gen-launchd', rel: plist }, text, committed) && ok;
    } else if (text !== committed) {
      fs.writeFileSync(abs, text);
      process.stdout.write(`gen-launchd: wrote ${plist}.\n`);
    }
  }

  const listed = new Set(rendered.map((r) => r.plist));
  for (const name of fs.readdirSync(SCHEDULED)) {
    const rel = `scheduled/${name}`;
    if (!name.endsWith('.plist.tmpl') || listed.has(rel)) continue;
    process.stderr.write(`gen-launchd: ${rel} has no entry in scheduled/launchd.json; add it there and run bin/gen-launchd.\n`);
    ok = false;
  }
  if (!ok) process.exit(1);
}

try {
  main();
} catch (e) {
  process.stderr.write(`${e.message}\n`);
  process.exit(1);
}

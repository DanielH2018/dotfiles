#!/usr/bin/env bash
# Re-assert the MX Ergo S's full intended state after something else changed it.
#
# Logi Options+ on another machine diverts the controls it manages -- the scroll
# wheel included -- and diversion is device runtime state, not per-host state.
# Come back to this machine and the wheel is still diverted, which kills
# scrolling outright: a diverted wheel sends LOWRES_WHEEL HID++ notifications
# that nothing here consumes.
#
# This is a manual fallback, NOT the primary defence. mx-ergo-watch already
# asserts the same state on every KWin deviceAdded, and the Bolt dongle lives in
# the KVM, so every flip back re-enumerates it and fires that event -- 62 clean
# applies in the three days to 2026-08-06. Reach for this when the automatic
# path has visibly not taken, or when you want the state printed.
#
# Restarting Solaar repairs it too; this is the same repair without dropping
# every other device's session.
#
# Reports dpi but never writes it. The hold-to-precision rules own that value at
# runtime, and asserting it here would fight them mid-press.

set -uo pipefail

SERIAL=${MX_ERGO_SERIAL:-BD092C51}

# Control -> intended action. Only the two this setup actually moves; the rest
# keep whatever they have. `solaar config reprogrammable-keys` is the call that
# can die with "TypeError: 'str' object does not support item assignment" and
# corrupt config.yaml on the way out, so it gets the smallest surface that still
# restores the setup. Middle Button's action is unused while it is diverted, but
# asserting it means the button degrades to a plain middle click if Solaar stops.
ACTIONS=(
    "Middle Button:Mouse Middle Button"
    "DPI Switch:Mouse Middle Button"      # the clicks the middle button gave up
)

# Only the middle button is diverted -- it is the precision hold. Everything
# else must be Regular or the device stops sending those events at all.
DIVERSIONS=(
    "Middle Button:Diverted"
    "Back Button:Regular"
    "Forward Button:Regular"
    "Left Tilt:Regular"
    "Right Tilt:Regular"
    "DPI Switch:Regular"
)

solaar_q() { timeout 25 solaar config "$SERIAL" "$@" 2>&1 | grep -v '^rules cannot'; }

indent() { while IFS= read -r line; do printf '  %s\n' "$line"; done; }

state() {
    solaar_q lowres-scroll-mode  | grep -E '^lowres-scroll-mode'
    solaar_q divert-keys         | grep -E '^divert-keys'
    solaar_q reprogrammable-keys | grep -E '^reprogrammable-keys'
}

# `solaar config` pings the device and errors out with "no online device found"
# when it cannot reach it, so an empty read means unreachable rather than
# healthy. Writes against a sleeping trackball would silently no-op and the
# read-back would agree with them, so this has to fail rather than report a
# repair that never happened.
before=$(state)
if [ -z "$before" ]; then
    echo "mx-ergo-resync: MX Ergo S ($SERIAL) not reachable -- move the trackball to wake it, then retry" >&2
    exit 1
fi

# Informational only, and kept out of the drift comparison: the rules move dpi
# on every press and release, so it is legitimately different from one moment to
# the next. Worth showing because a value the rules never write (they use 100
# and 400) is a sign something outside this machine has been setting it.
dpi_before=$(solaar_q dpi | grep -E '^dpi')

echo "before:"; { echo "$before"; echo "$dpi_before"; } | indent

# Scroll wheel back to plain HID reports. This is the one that kills scrolling.
solaar_q lowres-scroll-mode false >/dev/null

for pair in "${ACTIONS[@]}"; do
    solaar_q reprogrammable-keys "${pair%%:*}" "${pair#*:}" >/dev/null
done
for pair in "${DIVERSIONS[@]}"; do
    solaar_q divert-keys "${pair%%:*}" "${pair#*:}" >/dev/null
done

after=$(state)
echo "after:"; { echo "$after"; solaar_q dpi | grep -E '^dpi'; } | indent

# Confirm the writes actually took. Individual `solaar config` calls can fail --
# the reprogrammable-keys TypeError above is the known one -- and none of them
# is fatal on its own, so without this the script would print a still-broken
# after-state and exit 0. As a keybinding nobody reads stdout, hence the notify.
failed=()
grep -q '^lowres-scroll-mode = False$' <<<"$after" || failed+=("scroll wheel still diverted")
for pair in "${DIVERSIONS[@]}"; do
    grep -q "${pair%%:*}:${pair#*:}" <<<"$(grep '^divert-keys' <<<"$after")" \
        || failed+=("divert-keys ${pair%%:*} != ${pair#*:}")
done
for pair in "${ACTIONS[@]}"; do
    grep -q "${pair%%:*}:${pair#*:}" <<<"$(grep '^reprogrammable-keys' <<<"$after")" \
        || failed+=("reprogrammable-keys ${pair%%:*} != ${pair#*:}")
done

if [ ${#failed[@]} -gt 0 ]; then
    printf 'mx-ergo-resync: FAILED to apply:\n' >&2
    printf '  - %s\n' "${failed[@]}" >&2
    command -v notify-send >/dev/null \
        && notify-send -u critical "MX Ergo resync failed" "${#failed[@]} setting(s) did not apply"
    exit 1
fi

if [ "$before" = "$after" ]; then
    echo "(no drift -- already in the intended state)"
fi

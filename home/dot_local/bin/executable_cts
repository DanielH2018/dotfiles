#!/usr/bin/env bash
# cts — run claude-sandbox in its OWN named tmux session (sibling to `ct`), so Agent
# View captures a real tmux: locator for the session and <enter> can jump to it. A bare
# `claude-sandbox .` from a WezTerm/WSL shell used to register backend:none because
# WEZTERM_PANE did not cross into WSL; it now registers wezterm:<id> (wezterm.lua forwards the
# variable via WSLENV), but a tmux: locator is still the more robust target — it survives the
# pane id going stale, which a wezterm: one does not.
# Usage: cts [dir] [claude-sandbox args…]
#   dir defaults to $PWD; the first arg is the dir only if it isn't a flag. Everything
#   else forwards verbatim to claude-sandbox (e.g. -b BRANCH). The session name is
#   deterministic per repo(+branch), so re-running attaches instead of duplicating and
#   each worktree stays independently jumpable.
set -u

case "${1:-}" in
  -h|--help)
    echo "usage: cts [dir] [claude-sandbox args…]        run claude-sandbox in a named tmux session (local)"
    echo "       cts --ssh[=HOST] [REPO] [-b BRANCH]      start a native claude tmux session on HOST over ssh"
    echo "                                                REPO resolves under \$CTS_REMOTE_ROOTS on the host;"
    echo "                                                -b BRANCH runs it in a per-branch git worktree."
    echo "                                                HOST defaults to daniel-server (\$CTS_REMOTE_HOST); also -H/--host HOST"
    exit 0 ;;
esac

# ---- completion data (hidden; the _cts zsh completion calls these over ssh) -------------
# `cts --complete-repos [HOST]` and `cts --complete-branches [HOST] REPO` print the remote
# repo/branch lists tab-completion offers, by querying `ctw --list-*` on the host with
# fail-fast ssh flags and caching the result under $XDG_CACHE_HOME/cts for CTS_CACHE_TTL
# seconds (default 45) so repeated TABs feel instant. BatchMode+ConnectTimeout mean an
# unreachable or auth-locked host fails fast and quietly rather than hanging the shell.
_cts_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null; }

# Quote a value for the REMOTE shell. ssh joins its command arguments into ONE string and
# the remote login shell re-splits it, so anything interpolated there is code, not data --
# and repo/branch values arrive from tab-completion of remote listings, i.e. from off this
# machine. Single-quoting is the whole job; not printf %q, which can emit bash-only $'…'
# for control characters while the remote shell may be sh or zsh.
#
# A leading ~/ is the one thing kept unquoted, as $HOME/ so the REMOTE expands it -- that
# is the documented way to name a path in the remote's home (see the --ssh notes below),
# and quoting it wholesale would silently start passing a literal tilde to ctw.
_cts_shq() {
  local v="${1:-}" pre=""
  # The literal string $HOME is the point below — it is emitted for the REMOTE shell
  # to expand, so it must not expand here, and the '~/' patterns are matching a tilde
  # rather than using one. SC2088 has to sit on the case statement: directives are not
  # valid in front of an individual case branch (SC1124).
  # shellcheck disable=SC2088
  case "$v" in
    '~')   printf '%s' '$HOME'; return 0 ;;
    '~/'*) pre='$HOME/'; v="${v#'~/'}" ;;
  esac
  printf "%s'%s'" "$pre" "${v//\'/\'\\\'\'}"
}
_cts_complete() {
  local kind="$1" host="${2:-}" repo="${3:-}"
  [ -n "$host" ] || host="${CTS_REMOTE_HOST:-daniel-server}"
  command -v ssh >/dev/null 2>&1 || return 0
  local ctw="${CTS_REMOTE_CTW:-\$HOME/.local/bin/ctw}"
  local ttl="${CTS_CACHE_TTL:-45}"
  local cdir="${XDG_CACHE_HOME:-$HOME/.cache}/cts"
  local key remote
  if [ "$kind" = branches ]; then
    [ -n "$repo" ] || return 0
    key="branches_${host}_${repo}"; remote="$ctw --list-branches $(_cts_shq "$repo")"
  else
    key="repos_${host}"; remote="$ctw --list-repos"
  fi
  key="$(printf '%s' "$key" | tr -c 'a-zA-Z0-9._-' '_')"
  local cache="$cdir/$key" now age
  if [ -f "$cache" ]; then
    now="$(date +%s)"; age=$(( now - $(_cts_mtime "$cache") ))
    if [ "$age" -ge 0 ] && [ "$age" -lt "$ttl" ]; then cat "$cache"; return 0; fi
  fi
  mkdir -p "$cdir"
  local out
  if out="$(ssh -o BatchMode=yes -o ConnectTimeout=2 "$host" "$remote" 2>/dev/null)"; then
    printf '%s\n' "$out" > "$cache"
    printf '%s\n' "$out"
  else
    [ -f "$cache" ] && cat "$cache"    # fall back to a stale cache on a failed query
  fi
}
case "${1:-}" in
  --complete-repos)    shift; _cts_complete repos "${1:-}"; exit 0 ;;
  --complete-branches) shift; _cts_complete branches "${1:-}" "${2:-}"; exit 0 ;;
esac

# ---- remote (SSH) mode -------------------------------------------------------
# `cts --ssh [dir]` starts a NATIVE `claude` session inside a named tmux session on a
# remote host by invoking the deployed `ct` launcher over `ssh -t`, attaching to it now.
# `ct` uses `tmux new-session -A`, so re-running resumes rather than duplicates; the
# remote's Agent View state hook registers a tmux locator for it, so the session also
# shows up in `agentview` and can be re-entered later. Host defaults to daniel-server —
# the single homelab the picker aggregates — overridable with --ssh=HOST, -H/--host HOST,
# or $CTS_REMOTE_HOST. Only tmux/claude + the ct launcher are needed on the remote (no
# Docker/claude-sandbox). Note: an unquoted leading ~ in remote-dir is expanded by YOUR
# shell — quote it ('~/repo') or pass a plain path to expand on the remote; a remote path
# with spaces isn't supported.
_remote=0
for _a in "$@"; do case "$_a" in --ssh|--ssh=*|-H|--host) _remote=1; break ;; esac; done
if [ "$_remote" -eq 1 ]; then
  host="${CTS_REMOTE_HOST:-daniel-server}"
  rdir=""; rbranch=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --ssh)       shift ;;
      --ssh=*)     host="${1#--ssh=}"; shift ;;
      -H|--host)   host="${2:?cts: --host requires a HOST value}"; shift 2 ;;
      -b|--branch) rbranch="${2:?cts: -b requires a BRANCH value}"; shift 2 ;;
      -*)          printf 'cts: unknown flag in --ssh mode: %s\n' "$1" >&2; exit 2 ;;
      *)           if [ -z "$rdir" ]; then rdir="$1"; shift
                   else printf 'cts: --ssh mode takes at most one repo (extra: %s)\n' "$1" >&2; exit 2; fi ;;
    esac
  done
  [ -n "$host" ] || { printf 'cts: no remote host (set --host or $CTS_REMOTE_HOST)\n' >&2; exit 1; }
  command -v ssh >/dev/null 2>&1 || { printf 'cts: ssh not found on PATH\n' >&2; exit 1; }
  [ -z "$rbranch" ] || [ -n "$rdir" ] || { printf 'cts: -b BRANCH requires a repo in --ssh mode\n' >&2; exit 2; }
  # ctw is deployed to ~/.local/bin/ctw; reference it explicitly since a non-login ssh
  # shell may not have ~/.local/bin on PATH. $HOME expands on the remote, not here. ctw
  # resolves REPO under $CTS_REMOTE_ROOTS and, with a branch, into a per-branch worktree.
  remote_ctw="${CTS_REMOTE_CTW:-\$HOME/.local/bin/ctw}"
  if [ -n "$rdir" ] && [ -n "$rbranch" ]; then exec ssh -t "$host" "$remote_ctw $(_cts_shq "$rdir") $(_cts_shq "$rbranch")"; fi
  if [ -n "$rdir" ]; then exec ssh -t "$host" "$remote_ctw $(_cts_shq "$rdir")"; fi
  exec ssh -t "$host" "$remote_ctw"
fi

command -v tmux >/dev/null 2>&1 || { printf 'cts: tmux not found on PATH\n' >&2; exit 1; }

# Resolve the launcher exactly as agentview does: prefer it on PATH, else its deployed path.
sandbox_bin="${CLAUDE_SANDBOX_BIN:-}"
if [ -z "$sandbox_bin" ]; then
  if command -v claude-sandbox >/dev/null 2>&1; then sandbox_bin="claude-sandbox"
  else sandbox_bin="$HOME/.claude/sandbox/claude-sandbox"; fi
fi

# First arg is the target dir only when it isn't a flag; the rest pass through.
dir="$PWD"
if [ "$#" -gt 0 ]; then
  case "$1" in
    -*) ;;
    *) dir="$1"; shift ;;
  esac
fi

# Absolute path -> a stable session name AND a clean repo arg for claude-sandbox.
absdir="$(cd "$dir" 2>/dev/null && pwd)" || { printf 'cts: no such directory: %s\n' "$dir" >&2; exit 1; }

# Session name mirrors ct's scheme (basename + 6-digit cksum of the abs path) with an
# `sb-` prefix so `tmux ls` distinguishes sandboxed sessions from host ones.
base="$(basename "$absdir" | tr -c 'a-zA-Z0-9._-' '-' | sed 's/^-*//;s/-*$//')"
[ -n "$base" ] || base="repo"
h="$(printf '%s' "$absdir" | cksum | cut -d' ' -f1)"
# `base` above has a fallback and this did not, so an unreachable cksum or cut produced an
# empty suffix and a malformed `sb-myrepo-` session name rather than an error — which is
# how it surfaced: a pre-push run where the suffix was simply missing. Never silently
# accept a nameless session; two repos would then collide on one name. A fallback hash is
# not the answer either, since it would give the same repo a different session name
# depending on which tools were reachable, and a stable name is the point.
[ -n "$h" ] || { printf 'cts: cannot derive a session name (cksum/cut not on PATH)\n' >&2; exit 1; }
name="sb-${base}-${h: -6}"

# Give each worktree its own session: pull -b/-w's VALUE out of the passthrough args
# (skip if the next token is another flag — -w's name is optional).
branch=""
args=("$@")
i=0
while [ "$i" -lt "${#args[@]}" ]; do
  case "${args[$i]}" in
    -b|--branch|-w|--worktree)
      j=$((i + 1))
      if [ "$j" -lt "${#args[@]}" ]; then
        case "${args[$j]}" in -*) ;; *) branch="${args[$j]}" ;; esac
      fi ;;
  esac
  i=$((i + 1))
done
if [ -n "$branch" ]; then
  slug="$(printf '%s' "$branch" | tr -c 'a-zA-Z0-9._-' '-' | sed 's/^-*//;s/-*$//')"
  [ -n "$slug" ] && name="${name}-${slug}"
fi

# printf %q shell-quotes every element so tmux's `sh -c` re-parses it intact — the same
# pattern agentview's --spawn uses for new-window.
cmd="$(printf '%q ' "$sandbox_bin" "$absdir" "$@")"

if [ -z "${TMUX:-}" ]; then
  # Plain shell: attach-or-create. -A reuses a live session (never double-launches).
  exec tmux new-session -A -s "$name" -c "$absdir" "$cmd"
fi

# Inside tmux we can't nest an attach: jump if it's already live, else create it
# detached and switch the current client onto it.
if tmux has-session -t "$name" 2>/dev/null; then
  exec tmux switch-client -t "$name"
fi
tmux new-session -d -s "$name" -c "$absdir" "$cmd"
exec tmux switch-client -t "$name"

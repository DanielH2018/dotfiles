[Unit]
Description=Scan recent Claude transcripts for credentials that reached them

[Service]
Type=oneshot
# A day's window with an hour of overlap. The SessionEnd hook already scans each transcript
# as its session ends; this exists for the sessions where that never ran — a kill -9, a
# crash, or a scan that outlived its parent — so the window has to cover more than the
# interval between runs.
# Both stores are the default now, so no flag is needed here. It was --loki on the unit
# for one day, which meant a hand-run scan covered transcripts alone and printed a clean
# verdict for a store it never opened.
# The systemd user manager PATH omits ~/.local/bin, where otelq lives, so the Loki half
# refused and the whole scan exited 3 on every timer run from 2026-09-01. A missing query
# tool reads as a clean store, which is the failure this refusal exists to prevent.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/claude-transcript-scan --since 25
# Findings are the point, so exit 1 is a real verdict and must show as a failed unit.
# Exit 3 (no gitleaks, no jq) is could-not-evaluate and must also show — a detector that
# reports clean when it did not run is worse than no detector.
SuccessExitStatus=0
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

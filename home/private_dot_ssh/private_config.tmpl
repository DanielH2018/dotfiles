# Managed by chezmoi — edit home/private_dot_ssh/private_config, not ~/.ssh/config.

Host daniel-server homelab
    HostName 10.0.0.161
    User ubuntu
    IdentityFile ~/.ssh/daniel-server
    # No LocalForward. This block used to forward 8182 so the loopback artifact server was
    # reachable from here, because link-artifact.sh emitted http://127.0.0.1:8182/... The
    # cluster now serves both hosts' trees at https://artifacts.daniel-hunter.com/a/<host>/,
    # and link-artifact.sh:112 takes that branch whenever CLAUDE_ARTIFACTS_BASE_URL is set —
    # which settings.base.json sets on daniel-server and daniel-box. So no emitted link points
    # at the loopback port any more, and forwarding it bought nothing but errors.
    #
    # Warp is what made those errors unavoidable. It re-invokes ssh with its OWN
    # `-o ControlMaster=yes -o ControlPath=~/.ssh/<random>`, and a command-line -o beats this
    # file, so a Warp pane never joins the master below. Every pane after the first therefore
    # re-bound the same loopback port and failed:
    #   bind [127.0.0.1]:8182: Address already in use
    #   channel_setup_fwd_listener_tcpip: cannot listen to port: 8182
    #   Could not request local forwarding.
    # Worse than noise: the tunnel belonged to whichever pane opened first, so closing that one
    # killed artifact links in every survivor with no error at all.
    #
    # serve-artifacts.sh still binds the port ON each host, so the loopback route survives as a
    # manual fallback for when the cluster is down: `ssh -L 8182:127.0.0.1:8182 daniel-server`.
{{- if ne .chezmoi.os "windows" }}
    # Multiplexing stays. It no longer exists to establish a forward once — it is here so
    # repeat sessions skip the handshake, and so a burst of them does not trip UFW's ssh rate
    # limit (six connections in 30s to either host gets REJECTed, which reads as the host being
    # down). Note sshd's MaxSessions caps channels PER CONNECTION, so multiplexing trades a
    # connection limit for a channel limit; the hardening role sets it to 10 (server repo,
    # roles/setup/initial_setup) and at the old value of 2 the third pane could not open.
    #
    # %C, not %r@%h:%p — unix socket paths cap at ~104 bytes and the literal form overflows
    # it on long hostnames, at which point ssh silently declines to multiplex
    # (agentview/common.sh:86 hit exactly this). ~/.ssh already exists at mode 0700, so the
    # flat name needs no mkdir, matching otel-sweep's `~/.ssh/otel-sweep-%C`.
    #
    # ServerAlive* is not redundant with ControlPersist: it detects a master whose peer went
    # away, so a suspended box leaves a socket that fails rather than one that hangs the next
    # session. 60/10 are daniel-pi's interactive values below — deliberately NOT agentview's
    # 5/2, which are tuned to fail a background picker fast and would drop a live shell on a
    # brief blip.
    #
    # Agent View and otel-sweep pass their own -o Control* with private sockets, by design
    # (docs/specs/2026-08-05-agentview-remote-freshness-design.md §3.1) — behaviour travels
    # with the tool. These lines are for interactive sessions only and do not reach them.
    # Gated off Windows: Win32-OpenSSH does not support control-socket multiplexing.
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
    ServerAliveInterval 60
    ServerAliveCountMax 10
{{- end }}

Host daniel-pi
    HostName 10.0.0.139
    User ubuntu
    IdentityFile ~/.ssh/daniel-pi
    ServerAliveInterval 60
    ServerAliveCountMax 10

Host daniel-box box
    HostName 10.0.0.215
    User ubuntu
    # The machines authenticate here differently: Windows has a per-host key, Fedora uses
    # the default key — that's what bring-up's ssh-copy-id installed. This used to list
    # both unconditionally and rely on ssh skipping a missing IdentityFile, but ssh warns
    # `no such identity: ~/.ssh/daniel-box` on every Fedora connection, so gate it instead.
    #
    # The `daniel-box` keypair on the shared NTFS drive is WINDOWS key material (comment
    # daniel@windows); don't copy it here. Per the fedora-homelab-keys convention,
    # generate separate Fedora material if this host should get a per-host key — and drop
    # the gate below if you do.
{{- if eq .chezmoi.os "windows" }}
    IdentityFile ~/.ssh/daniel-box
{{- end }}
    IdentityFile ~/.ssh/id_ed25519
    # No LocalForward, same reasoning as daniel-server above — the cluster serves this host's
    # artifacts at a real URL, so nothing emits a 127.0.0.1:8183 link any more. The manual
    # fallback is `ssh -L 8183:127.0.0.1:8183 daniel-box`.
{{- if ne .chezmoi.os "windows" }}
    # Multiplex, same arrangement as daniel-server above — see the rationale there for what
    # multiplexing is still for, %C, the ServerAlive* values, and the Windows gate.
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
    ServerAliveInterval 60
    ServerAliveCountMax 10
{{- end }}

#!/usr/bin/python3 -I
"""secretq — answer questions about secret files without printing a value.

A session often needs a fact about a file it must not read: that a key exists,
which keys a SOPS file holds, that every value is ciphertext, which server a
kubeconfig points at. claude-guard refuses `grep -c`, `grep -o '^[A-Z_]*'` and
`sha256sum` on those paths, because a reader that prints a narrowed slice of a
secret file is one flag away from printing all of it. secretq is the narrowed
reader, with the narrowing built in:

  secretq keys FILE           key names of a SOPS yaml, json or env file
  secretq has FILE KEY        exit 0 when KEY is set, 1 when not; prints nothing
  secretq encrypted FILE      exit 0 when every value is SOPS ciphertext, else
                              exit 1 and name the plaintext keys
  secretq sha256 FILE         sha256 of a file that carries SOPS metadata
  secretq kubeconfig [FILE]   current context, cluster names and servers,
                              context names; default ~/.kube/config
  secretq ssh-config [HOST]   Host, HostName, User, Port, Control*, Identity*
                              and ProxyJump lines of ~/.ssh/config

`keys`, `has`, `encrypted` and `sha256` take `--rev REV` before FILE to read
the file as git holds it at REV, with `git cat-file blob`, which runs no
textconv and so never decrypts.

What it never does: print a value, print a line of a file it did not
recognise, run sops, or follow an Include. Key names come only from a file
carrying SOPS metadata, because a plain file can hold a secret that parses as
a name (a base64 key with `==` padding reads as `NAME=`). On a plain file,
`has` answers with its exit status alone. Every error message is fixed text
plus the path the caller gave; no message quotes the file. A file must be a
regular file of at most 1 MiB.

Exit status: 0 yes or done, 1 no, 2 refused or unreadable.
"""

from __future__ import annotations

import fnmatch
import hashlib
import json
import os
import re
import stat
import subprocess
import sys

PROG = "secretq"
GIT = "/usr/bin/git"
MAX_BYTES = 1 << 20
_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_.-]{0,127}")
_ENV_LINE = re.compile(r"(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)")
_YAML_TOP = re.compile(r"([A-Za-z0-9_.-]+):(?:\s+(.*))?$")
_YAML_SCALAR = re.compile(r"\s+(?:-\s+)?(?:[A-Za-z0-9_.-]+:\s+)?(\S.*)$")
_REV = re.compile(r"[A-Za-z0-9_./~^@{}-]+")
_REL_PATH = re.compile(r"[A-Za-z0-9_./-]+")
_KUBE_FIELDS = ("server", "name", "cluster", "user", "namespace", "current-context")
_KUBE_LINE = re.compile(
    r"(\s*)(-\s+)?(" + "|".join(_KUBE_FIELDS) + r"):\s+([A-Za-z0-9_.:/@-]{1,200})\s*$"
)
_SSH_LINE = re.compile(r"\s*([A-Za-z]+)(?:\s*=\s*|\s+)(\S.*)$")
_SSH_SHOWN = {
    "host", "match", "hostname", "user", "port", "controlmaster", "controlpath",
    "controlpersist", "identityfile", "identitiesonly", "proxyjump",
}  # fmt: skip


class Refused(Exception):
    """A request secretq will not answer. The message is fixed text and the
    caller's own arguments, never file content."""


def is_enc(value: str) -> bool:
    return value.strip().strip("'\"").startswith("ENC[")


def read_file(path: str) -> bytes:
    """The bytes of regular file `path`, at most MAX_BYTES."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        raise Refused(f"cannot open {path}") from None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise Refused(f"{path} is not a regular file")
        data = os.read(fd, MAX_BYTES + 1)
    finally:
        os.close(fd)
    if len(data) > MAX_BYTES:
        raise Refused(f"{path} is larger than 1 MiB")
    return data


def read_rev(rev: str, path: str) -> bytes:
    """The blob git holds for `path` at `rev`, read without any filter."""
    if rev.startswith("-") or not _REV.fullmatch(rev):
        raise Refused("--rev takes a plain revision name")
    if path.startswith(("-", "/")) or ".." in path.split("/"):
        raise Refused("with --rev, FILE is a path relative to the repository root")
    if not _REL_PATH.fullmatch(path):
        raise Refused("with --rev, FILE takes letters, digits and _ . / - only")
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    env["GIT_CONFIG_NOSYSTEM"] = "1"
    proc = subprocess.run(
        [GIT, "-c", "core.fsmonitor=false", "cat-file", "blob", f"{rev}:{path}"],
        capture_output=True,
        env=env,
        check=False,
    )
    if proc.returncode != 0:
        raise Refused(f"git has no blob {path} at {rev}")
    if len(proc.stdout) > MAX_BYTES:
        raise Refused(f"{path} at {rev} is larger than 1 MiB")
    return proc.stdout


def text_of(data: bytes, path: str) -> str:
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        raise Refused(f"{path} is not UTF-8 text") from None


def sops_kind(text: str) -> str | None:
    """"json", "yaml" or "env" when `text` carries SOPS metadata, else None."""
    if text.lstrip().startswith("{"):
        try:
            doc = json.loads(text)
        except ValueError:
            return None
        sops = doc.get("sops") if isinstance(doc, dict) else None
        return "json" if isinstance(sops, dict) and "mac" in sops else None
    lines = text.splitlines()
    if any(re.match(r"sops_mac=ENC\[", line) for line in lines):
        return "env"
    if "sops:" in lines and any(re.match(r"\s+mac:\s+ENC\[", line) for line in lines):
        return "yaml"
    return None


def sops_values(text: str, kind: str) -> list[tuple[str, bool]]:
    """(top-level key, every value under it is ciphertext) for a SOPS file."""
    if kind == "json":
        doc = json.loads(text)

        def leaves_enc(node: object) -> bool:
            if isinstance(node, dict):
                return all(leaves_enc(v) for v in node.values())
            if isinstance(node, list):
                return all(leaves_enc(v) for v in node)
            return isinstance(node, str) and is_enc(node)

        return [(k, leaves_enc(v)) for k, v in doc.items() if k != "sops"]
    if kind == "env":
        out = []
        for line in text.splitlines():
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            m = _ENV_LINE.fullmatch(line)
            if not m:
                raise Refused("a line is not KEY=VALUE")
            if not m.group(1).startswith("sops_"):
                out.append((m.group(1), is_enc(m.group(2))))
        return out
    out: list[tuple[str, bool]] = []
    current: str | None = None
    for line in text.splitlines():
        if not line.strip() or line.lstrip().startswith("#ENC["):
            continue
        top = _YAML_TOP.match(line)
        if top:
            current = top.group(1)
            value = top.group(2) or ""
            if current != "sops":
                out.append((current, not value or is_enc(value)))
            continue
        if current == "sops" or current is None:
            continue
        # A plaintext scalar, or a plaintext comment, under a key marks that key.
        value = (m := _YAML_SCALAR.match(line)) and m.group(1)
        plain = bool(value) and not is_enc(value) and not value.endswith(":")
        if plain or line.lstrip().startswith("#"):
            out[-1] = (out[-1][0], False)
    return out


def load(args: list[str]) -> tuple[str, str]:
    """(path, text) for `[--rev REV] FILE`."""
    if args[:1] == ["--rev"]:
        if len(args) < 3:
            raise Refused("--rev takes REV and FILE")
        return args[2], text_of(read_rev(args[1], args[2]), args[2])
    if not args:
        raise Refused("missing FILE")
    return args[0], text_of(read_file(args[0]), args[0])


def cmd_keys(args: list[str]) -> int:
    path, text = load(args)
    kind = sops_kind(text)
    if kind is None:
        raise Refused(f"{path} carries no SOPS metadata, so keys lists nothing")
    for name, enc in sops_values(text, kind):
        if enc and _NAME.fullmatch(name):
            print(name)
    return 0


def cmd_has(args: list[str]) -> int:
    if len(args) < 2 or not _NAME.fullmatch(args[-1]):
        raise Refused("has takes [--rev REV] FILE KEY, KEY a plain name")
    key = args[-1]
    _, text = load(args[:-1])
    kind = sops_kind(text)
    if kind is not None:
        return 0 if any(name == key for name, _ in sops_values(text, kind)) else 1
    for line in text.splitlines():
        m = _ENV_LINE.fullmatch(line.strip()) or _YAML_TOP.match(line)
        if m and m.group(1) == key:
            return 0
    return 1


def cmd_encrypted(args: list[str]) -> int:
    path, text = load(args)
    kind = sops_kind(text)
    if kind is None:
        print(f"{path}: no SOPS metadata")
        return 1
    plain = [name for name, enc in sops_values(text, kind) if not enc]
    for name in plain:
        print(f"plaintext: {name}" if _NAME.fullmatch(name) else "plaintext: <unnamed>")
    if not plain:
        print(f"{path}: every value is SOPS ciphertext")
    return 1 if plain else 0


def cmd_sha256(args: list[str]) -> int:
    path, text = load(args)
    if sops_kind(text) is None:
        raise Refused(f"{path} carries no SOPS metadata, so it gets no hash")
    print(f"{hashlib.sha256(text.encode('utf-8')).hexdigest()}  {path}")
    return 0


def cmd_kubeconfig(args: list[str]) -> int:
    if len(args) > 1:
        raise Refused("kubeconfig takes at most one FILE")
    path = args[0] if args else os.path.expanduser("~/.kube/config")
    text = text_of(read_file(path), path)
    if not re.search(r"^kind:\s+Config\s*$", text, re.M):
        raise Refused(f"{path} is not a kubeconfig")
    for line in text.splitlines():
        m = _KUBE_LINE.fullmatch(line)
        if m:
            print(f"{m.group(1)}{m.group(2) or ''}{m.group(3)}: {m.group(4)}")
    return 0


def cmd_ssh_config(args: list[str]) -> int:
    if len(args) > 1 or (args and not re.fullmatch(r"[A-Za-z0-9_.@-]+", args[0])):
        raise Refused("ssh-config takes at most one plain HOST")
    host = args[0] if args else None
    path = os.path.expanduser("~/.ssh/config")
    text = text_of(read_file(path), path)
    shown: list[str] = []
    include = host is None
    for line in text.splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        m = _SSH_LINE.fullmatch(line)
        if not m:
            raise Refused(f"{path} has a line that is not `Keyword value`")
        keyword = m.group(1).lower()
        if keyword in ("host", "match"):
            patterns = m.group(2).split()
            matched = host is not None and any(
                fnmatch.fnmatch(host, p) for p in patterns if not p.startswith("!")
            )
            include = host is None or (keyword == "host" and matched)
        if include and keyword in _SSH_SHOWN:
            shown.append(line.rstrip())
    print("\n".join(shown))
    return 0


COMMANDS = {
    "keys": cmd_keys,
    "has": cmd_has,
    "encrypted": cmd_encrypted,
    "sha256": cmd_sha256,
    "kubeconfig": cmd_kubeconfig,
    "ssh-config": cmd_ssh_config,
}


def main(argv: list[str] | None = None) -> int:
    args = sys.argv[1:] if argv is None else argv
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if args else 2
    command = COMMANDS.get(args[0])
    if command is None:
        print(f"{PROG}: unknown subcommand; takes {', '.join(COMMANDS)}",
              file=sys.stderr)
        return 2
    try:
        return command(args[1:])
    except Refused as refusal:
        print(f"{PROG} {args[0]}: {refusal}", file=sys.stderr)
    except Exception:  # noqa: BLE001 - an exception's text can quote the file
        print(f"{PROG} {args[0]}: could not parse the file", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())

{{- if eq .chezmoi.hostname "daniel-box" }}
# agent-flow, the /flow subagent-tree mod, on trial on daniel-box only (dotfiles #794).
# Pinned twice: the URL names the commit whose full source was audited on 2026-10-10, and the
# checksum refuses any other bytes. To move the pin, audit the new commit's source, then change
# both values together. settings.base.json enables the plugin from this directory.
[".local/share/claude-agent-flow"]
    type = "archive"
    url = "https://github.com/Charlie0113-T/claude-agent-flow/archive/76ef8fb2db36136f08ecaf142f920bf4d3843537.tar.gz"
    checksum.sha256 = "8037ed876b676cf7703898d482b419c3b1ff30f8d01daf2686dd4f31ea1dc933"
    stripComponents = 1
    exact = true
    # The upstream test suite and its type stub run under `bun test` from a checkout, never from
    # $HOME, so they stay out of the deploy. With `exact`, apply also deletes copies already there.
    exclude = ["*/tests", "*/tests/**", "*/bun/bun-test.d.ts"]

# The Flux CLI, for the operator-only `flux diff kustomization` step before a role PR that moves
# a service to Flux (DanielH2018/server, docs/target-architecture/deploy/d5-bulk-move.md). The
# version follows `flux_version` in that repo's ansible/roles/k8s/flux/defaults/main.yml, so the
# CLI matches the controllers it diffs against. Renovate does not track this pin. To move it after
# the server bumps `flux_version`, change both versions in the URL, then take the new tarball's
# hash from that release's flux_<version>_checksums.txt and check it against the downloaded bytes.
# The admin kubeconfig is root-only, so the operator runs:
#   sudo /home/ubuntu/.local/bin/flux --kubeconfig /etc/rancher/k3s/k3s.yaml \
#     diff kustomization <tag> --path <render>/cluster/<tag> \
#     --kustomization-file <render>/flux/<tag>.yaml
[".local/bin/flux"]
    type = "archive-file"
    url = "https://github.com/fluxcd/flux2/releases/download/v2.9.6/flux_2.9.6_linux_amd64.tar.gz"
    checksum.sha256 = "b4d22673e9246cbd628881f1a9ef3b090085dced291e42d804555cee8e8d42c5"
    path = "flux"
    executable = true
{{- end }}

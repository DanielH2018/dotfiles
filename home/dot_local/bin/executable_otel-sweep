#!/usr/bin/env python3
"""otel-sweep — read the Claude Code telemetry stack on every machine, unprompted.

Exists for the same reason as `otelq`, one layer out. `otelq` already carries a
blanket allow because its host is a hardcoded constant; the moment the question
became "and what about daniel-box and daniel-server?", the only tools that could
answer were ssh and curl, both ask-listed for good reason. This closes that gap
without widening either.

The confinement is structural, not a check. There is no --host, --url, --query
or --output flag: the destinations are a fixed enum below, and the program that
runs on each machine is PROBE, one module-level constant delivered on stdin to
`python3 -`. No element of any command is ever built from an argument, so there
is no position where a caller-supplied string could become a command. subprocess
is always called with an argv list and never with a shell, so there is nothing
to escape from either. Output is JSON on stdout; nothing is written to disk.

PROBE reaches loopback first and a fixed table of cluster addresses second. That
second candidate is what makes the sweep survive a reschedule: the backends bind
their query ports to 127.0.0.1 on whichever node they land on, so a reboot can
move the whole query path to the other machine. Both candidates are constants
and both must pass an RFC1918 check, so neither position can be reached by a
caller-supplied string.

  otel-sweep                 # fast sweep of all three machines
  otel-sweep --deep          # adds sessions that are exporting nowhere
  otel-sweep --only box      # one machine
  otel-sweep --rows          # compact text instead of JSON

Read-only by construction: every request is a GET, and PROBE writes no files.
"""

from __future__ import annotations

import argparse
import json
import socket
import subprocess
import sys
import time

PROG = "otel-sweep"

# Not configurable, and deliberately so — see the module docstring. A --host
# flag would turn this into the arbitrary-ssh primitive the allow rule assumes
# it is not. "local" runs PROBE here; the others dial a fixed destination.
HOSTS = {
    "local": None,
    "box": "daniel-box",
    "server": "daniel-server",
}

# Machines allowed to hold a collector and no query backend, so that answering
# with no backends is reported as expected rather than as an outage. daniel-box
# and daniel-server are one k3s cluster: every node runs the otel-collector
# DaemonSet, while Loki, Prometheus and Tempo are single-replica Deployments that
# land on whichever node the scheduler picks. Nothing pins them — on 2026-08-23 a
# reboot moved all three from daniel-box to daniel-server.
#
# This only suppresses when a machine has NO backend ready. That was the normal
# case for a node holding no pods; since PROBE falls back to the ClusterIP it is
# not, because a node without the pods now reports them ready anyway. So the
# suppression is close to dead code, and the honest end state is probably to drop
# it and let a no-backends row speak for itself. Left in place for now because
# removing it changes what the daily watcher reports, which deserves its own
# change rather than riding along with this one.
#
# Events from either node land in the same Loki; split them by os_version, since
# nothing in the pipeline records a hostname. Read the live kernels from
# `kubectl get nodes -o wide` rather than trusting a value written down here.
COLLECTOR_ONLY = {"server"}

SSH_OPTS = [
    "-o", "BatchMode=yes",
    "-o", "ConnectTimeout=5",
    "-o", "StrictHostKeyChecking=accept-new",
    # ~/.ssh/config forwards ports to these hosts, and a second connection cannot
    # bind them again — three lines of "Address already in use" on every probe.
    # Harmless, but it turns a daily timer's journal into noise, and this tool
    # needs no forwarding of its own.
    "-o", "ClearAllForwardings=yes",
    # Both machines run UFW's `limit ssh`, so the 6th connection from one source
    # inside 30s is rejected — and probe() reports a rejected connection as the
    # machine being unreachable, which is this tool alarming about a firewall it
    # tripped itself. A blanket allow rule makes otel-sweep cheap to invoke, so
    # six runs in half a minute is an ordinary afternoon rather than an edge case.
    # Reusing one connection per host caps a burst at a single TCP connection,
    # twelve times under the budget instead of one run over it. The socket gets
    # its own name so a probe never adopts an interactive session's forwardings,
    # and %C hashes the destination to keep the path inside the AF_UNIX limit.
    "-o", "ControlMaster=auto",
    "-o", "ControlPath=~/.ssh/otel-sweep-%C",
    "-o", "ControlPersist=60",
]

DEFAULT_TIMEOUT = 120

# How many SILENT lines --rows prints before summarising the rest. The compact
# view is the only place a cap belongs: the JSON payload carries every session,
# and the summary line carries the count, so nothing here can hide a total.
ROW_SILENT_LIMIT = 10

# Long enough to outlast the transients that actually occur here — a WireGuard
# rekey, a firewall rate limiter's window — and short enough that a machine that
# is genuinely down still costs one extra connect timeout, not a stalled timer.
RETRY_PAUSE = 3

# The whole remote side, as a constant. Nothing is substituted into it; the mode
# arrives as argv so this string stays fixed at every call site.
PROBE = r'''
import calendar
import json
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

MODE = sys.argv[1] if len(sys.argv) > 1 else "fast"
BACKENDS = (
    ("loki", 3100, "/ready"),
    ("prometheus", 9090, "/-/ready"),
    ("tempo", 3200, "/ready"),
)
RFC1918 = re.compile(r"^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)[0-9.]+$")
out = {"backends": {}}


def get(url, timeout=15):
    with urllib.request.urlopen(url, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")


# The cluster address of each backend, used when the node-local hostPort has
# nothing behind it. These are k3s Deployments with no nodeSelector that publish
# their query ports on a hostPort bound to 127.0.0.1, so a reboot that
# reschedules a pod moves that port to the other node — on 2026-08-23 all three
# landed on daniel-server and every loopback probe from daniel-box read
# "unreachable" while the telemetry itself was healthy. A ClusterIP is routed on
# every node, so it answers wherever the pod is.
#
# Fixed constants, matching otelq's own list and the pinned clusterIP in
# ansible/roles/k8s/claude-otel/templates/. Nothing here is caller-supplied, and
# the RFC1918 check below still refuses anything that is not a private address.
CLUSTER_IP = {
    "loki": "10.43.99.158",
    "prometheus": "10.43.39.218",
    "tempo": "10.43.4.147",
}


def cluster_ip(name):
    """The in-cluster address for a backend, when it is a private one."""
    candidate = CLUSTER_IP.get(name)
    if candidate and RFC1918.match(candidate):
        return candidate
    return None


def resolve(name, port, ready):
    for host in ("127.0.0.1", cluster_ip(name)):
        if not host:
            continue
        base = "http://" + host + ":" + str(port)
        try:
            get(base + ready, timeout=5)
            return base
        except (urllib.error.URLError, OSError):
            continue
    return None


BASE = {}
for name, port, ready in BACKENDS:
    BASE[name] = resolve(name, port, ready)
    out["backends"][name] = "ready" if BASE[name] else "unreachable"


def loki(query, path="/loki/api/v1/query", strict=False, **extra):
    """Query Loki. `strict` re-raises instead of returning [].

    Every caller but one treats an empty result as "nothing happened", which is
    the right reading for a tally. It is the wrong reading for the silent-session
    scan, where empty means "no session ever exported" and would condemn every
    transcript on the disk. That caller passes strict=True.
    """
    if not BASE["loki"]:
        return []
    params = {"query": query}
    params.update(extra)
    url = BASE["loki"] + path + "?" + urllib.parse.urlencode(params)
    try:
        return json.loads(get(url)).get("data", {}).get("result", [])
    except (urllib.error.URLError, OSError, ValueError):
        if strict:
            raise
        return []


CC = '{service_name="claude-code"}'


def tally(query, label):
    """One-label aggregations; the label is named so a missing one is visible."""
    return {
        r.get("metric", {}).get(label, "?"): int(float(r["value"][1]))
        for r in loki(query)
    }


def count(inner, label, window="24h"):
    return tally(
        "sum by (" + label + ") (count_over_time(" + CC + inner + " [" + window + "]))",
        label,
    )


out["events_24h"] = count(" | event_name != ``", "event_name")
out["errors_24h"] = count(" | event_name=~`api_error|api_refusal`", "event_name")
out["hook_errors_24h"] = count(
    " | event_name=`hook_execution_complete` | num_non_blocking_error != `0`",
    "hook_event",
)
out["mcp_24h"] = count(" | event_name=`mcp_server_connection`", "status")
out["tool_failures_24h"] = count(
    " | event_name=`tool_result` | success=`false`", "tool_name"
)
out["sessions_24h"] = len(
    loki("sum by (session_id) (count_over_time(" + CC + " [24h]))")
)

# query_range without an explicit start silently returns empty — see the role's
# CLAUDE.md on daniel-box, where that cost an afternoon.
DAY_NS = str(int((time.time() - 86400) * 1e9))
out["compactions_24h"] = []
rows = loki(
    CC + " | event_name=`compaction`",
    "/loki/api/v1/query_range",
    start=DAY_NS,
    limit="20",
)
for r in rows:
    stream = r.get("stream", {})
    out["compactions_24h"].append({
        "at": stream.get("event_timestamp"),
        "trigger": stream.get("trigger"),
        "precompute_reuse": stream.get("precompute_reuse"),
        "pre_tokens": stream.get("pre_tokens"),
        "post_tokens": stream.get("post_tokens"),
    })

newest = loki(
    CC, "/loki/api/v1/query_range", start=DAY_NS, limit="1", direction="backward"
)
stamps = [v[0] for r in newest for v in r.get("values", [])]
out["newest_event_ns"] = max(stamps) if stamps else None

if MODE == "deep":
    import pathlib

    STAMP = re.compile(rb'"timestamp":"([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z)"')

    def last_activity(path, st, tail=65536):
        """When this session last wrote a line, from the transcript's own content.

        Not st_mtime. Transcripts get re-stamped by things that are not the
        session — a retention sweep touched four transcripts from 2026-08-18/19
        on 2026-08-23, and mtime alone presented all four as active sessions
        holding zero events, which is precisely the shape of the finding this
        check exists to raise. Four false alarms in one run is how a daily check
        gets muted.

        Reads the tail rather than the file: transcripts reach hundreds of MB and
        the last timestamp is always near the end. Falls back to st_mtime when no
        timestamp is found, which keeps a transcript in a format this does not
        recognise visible rather than silently dropping it from the scan.
        """
        try:
            with open(path, "rb") as fh:
                if st.st_size > tail:
                    fh.seek(-tail, 2)
                found = STAMP.findall(fh.read())
        except OSError:
            return st.st_mtime
        if not found:
            return st.st_mtime
        text = found[-1].decode("ascii", "replace")
        try:
            parsed = time.strptime(text[:19], "%Y-%m-%dT%H:%M:%S")
        except ValueError:
            return st.st_mtime
        # The stamps are UTC ("...Z"), so calendar.timegm, not time.mktime.
        return calendar.timegm(parsed)

    # A session whose transcript is being written while Loki has none of its
    # events is exporting nowhere. That is the failure this tool exists for.
    #
    # Loki is also the only evidence that any session exported at all, so when it
    # is unreachable the query returns nothing and EVERY recently-written
    # transcript looks silent. The unreachable backend is already a finding on its
    # own; letting it manufacture a second finding per transcript is how one
    # outage becomes a wall of alarms about sessions that are exporting fine.
    # Skip the check instead of reporting all of it.
    silent = []
    candidates = []
    checked = False
    if BASE["loki"]:
        cutoff = time.time() - 48 * 3600
        for path in (pathlib.Path.home() / ".claude" / "projects").glob("*/*.jsonl"):
            try:
                st = path.stat()
            except OSError:
                continue
            if last_activity(path, st) >= cutoff:
                candidates.append((path.stem, st))

        # Ask only about the sessions in hand. `sum by (session_id)` over every
        # session in 720h trips Loki's 500-series ceiling once the history is a
        # few weeks deep, and the HTTP 400 that comes back is indistinguishable
        # from an empty result — which marked every recent transcript silent,
        # live and exporting ones included (measured 2026-08-21). Filtering to
        # the candidate ids bounds the series count by the number of transcripts.
        # In batches: the ids ride in a URL query string, and a long enough one
        # is rejected by the same HTTP 400 this rewrite exists to avoid. 50 ids
        # is ~1.9kB of URL, comfortably inside any limit, and batching drops no
        # session the way a cap would.
        exported = set()
        checked = True
        for i in range(0, len(candidates), 50):
            ids = "|".join(sid for sid, _ in candidates[i:i + 50])
            try:
                rows = loki(
                    "sum by (session_id) (count_over_time("
                    + CC + " | session_id=~`" + ids + "` [720h]))",
                    strict=True,
                )
            except Exception:
                checked = False
                break
            for r in rows:
                sid = r.get("metric", {}).get("session_id")
                if sid:
                    exported.add(sid)

        if checked:
            for sid, st in candidates:
                if sid in exported:
                    continue
                silent.append({
                    "session": sid,
                    "mb": round(st.st_size / 1048576, 1),
                    "modified": time.strftime(
                        "%Y-%m-%dT%H:%M:%SZ", time.gmtime(st.st_mtime)
                    ),
                })
    # Uncapped on purpose. This list was sliced to the ten largest until
    # 2026-08-31, and otel-sweep-watch reports `silent=N` as len() of it — so a
    # night with 24 silent sessions alerted as 10 and read as the whole truth.
    # The renderers below may show fewer, but they say so; the payload may not
    # lie, because it is what every count downstream is computed from.
    out["silent_sessions"] = sorted(silent, key=lambda s: s["mb"], reverse=True)
    out["silent_checked"] = checked
    out["sessions_on_disk_48h"] = len(candidates)

print(json.dumps(out))
'''


def is_self(dest):
    """True when `dest` names the machine this is running on.

    Compared on the first label only, so `daniel-box` matches whether the host
    reports a bare name or an FQDN. `None` is the local entry and is never
    "self" in this sense — it has no ssh hop to skip.
    """
    if dest is None:
        return False
    return dest.split(".")[0] == socket.gethostname().split(".")[0]


def dest_for(name):
    """The ssh destination for a machine, or None to run PROBE here.

    `--only box` on daniel-box should read this machine rather than fail on a
    self-ssh, so a named host that resolves to us degrades to the local path.
    """
    dest = HOSTS[name]
    return None if is_self(dest) else dest


def probe(dest, mode, timeout):
    """Reach one machine, tolerating a single transient.

    A refused or unrouteable connection is not evidence a machine is down: the
    ssh path here crosses a WireGuard tunnel that rekeys and a UFW rate limiter
    that rejects bursts, and both recover within seconds. Reporting the first
    failure as "unreachable" is what turns those into a desktop notification
    about a machine that is fine. Only the ssh path can fail this way, so the
    local probe is not retried.
    """
    result = probe_once(dest, mode, timeout)
    if dest is None or "error" not in result:
        return result
    time.sleep(RETRY_PAUSE)
    return probe_once(dest, mode, timeout)


def probe_once(dest, mode, timeout):
    """Run PROBE on one machine. argv is constants; there is no shell."""
    if dest is None:
        argv = ["python3", "-", mode]
    else:
        argv = ["ssh", *SSH_OPTS, dest, "python3", "-", mode]
    try:
        done = subprocess.run(
            argv, input=PROBE, capture_output=True, text=True, timeout=timeout
        )
    except subprocess.TimeoutExpired:
        return {"error": f"timed out after {timeout}s"}
    except OSError as exc:
        return {"error": str(exc)}
    if done.returncode != 0:
        detail = (done.stderr or f"exit {done.returncode}").strip()
        return {"error": detail[:400]}
    try:
        return json.loads(done.stdout)
    except ValueError:
        return {"error": "unparseable probe output: " + done.stdout.strip()[:200]}


def render_rows(results):
    for name, data in results.items():
        if "error" in data:
            print(f"{name:<8} UNREACHABLE  {data['error']}")
            continue
        ready = [k for k, v in data.get("backends", {}).items() if v == "ready"]
        events = sum(data.get("events_24h", {}).values())
        if name in COLLECTOR_ONLY and not ready:
            print(
                f"{name:<8} collector-only — no query backend; "
                "counts live in box (split by os_version)"
            )
            continue
        silent = data.get("silent_sessions", [])
        # The count goes on the summary line, not just the SILENT lines below it.
        # Without it, a capped list of SILENT lines reads as the complete set, which
        # is exactly how 24 silent sessions were reported as 10 and believed.
        summary = (
            f"{name:<8} ready={','.join(ready) or 'none':<26} "
            f"events={events:<6} sessions={data.get('sessions_24h', 0)}"
        )
        if silent:
            summary += f" silent={len(silent)}"
        print(summary)
        for bad, n in sorted(data.get("errors_24h", {}).items()):
            print(f"         {bad}={n}")
        if data.get("silent_checked") is False:
            print("         silent-session check did not run (Loki query failed)")
        for entry in silent[:ROW_SILENT_LIMIT]:
            print(
                f"         SILENT {entry['session'][:8]} "
                f"({entry['mb']}MB, {entry['modified']})"
            )
        if len(silent) > ROW_SILENT_LIMIT:
            print(
                f"         ... and {len(silent) - ROW_SILENT_LIMIT} more "
                "(--deep without --rows lists them all)"
            )


def main():
    ap = argparse.ArgumentParser(
        prog=PROG,
        description="Read the Claude Code telemetry stack on every machine.",
    )
    ap.add_argument(
        "--deep", action="store_true", help="add silent-session detection"
    )
    ap.add_argument(
        "--only", choices=sorted(HOSTS), help="sweep a single machine"
    )
    ap.add_argument(
        "--rows", action="store_true", help="compact text instead of JSON"
    )
    ap.add_argument(
        "--timeout", type=int, default=DEFAULT_TIMEOUT,
        help="per-machine timeout in seconds",
    )
    ns = ap.parse_args()

    mode = "deep" if ns.deep else "fast"
    if ns.only:
        targets = [ns.only]
    else:
        # "local" already covers whichever machine this is, so sweeping its named
        # entry as well would ssh to ourselves and duplicate the row. Before this,
        # running on daniel-box reported `box UNREACHABLE` every time: the shared
        # ~/.ssh/config gives that host IdentityFiles belonging to another machine,
        # so the self-loop fails on a key that does not exist here. A tool alarming
        # about a machine it is running on is noise that trains the reader to skip
        # findings.
        targets = [name for name in sorted(HOSTS) if not is_self(HOSTS[name])]
    results = {name: probe(dest_for(name), mode, ns.timeout) for name in targets}

    # A collector-only machine answers no query, so its zeros are absence of
    # evidence. Say so in the JSON too, or a reader takes silent_sessions: []
    # for "clean" when it means "never looked".
    for name in targets:
        data = results[name]
        ready = [k for k, v in data.get("backends", {}).items() if v == "ready"]
        if name in COLLECTOR_ONLY and "error" not in data and not ready:
            data["queryable"] = False

    if ns.rows:
        render_rows(results)
    else:
        json.dump(results, sys.stdout, indent=2)
        sys.stdout.write("\n")
    return 0 if any("error" not in r for r in results.values()) else 1


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env bash
# Assert the full MX Ergo S button and wheel state that hold-to-precision needs.
#
# None of it can live on the device: the Ergo S reports neither onboard_profiles
# nor persistent-remappable-keys, so every setting is volatile and re-applied by
# software on each connect.
#
# Solaar restores its *saved* config when the trackball reconnects, so this
# script earns its keep in two cases: a machine that has never seen the device,
# and live drift. Drift is real -- Solaar's device-panel diversion toggles apply
# to the hardware immediately without being written to config.yaml, and a
# diverted wheel emits HID++ notifications that nothing consumes, so scrolling
# stops dead. The tilts do the same to horizontal scroll.
#
# Values must be given by NAME. Passing the integer that config.yaml stores is
# silently coerced -- `divert-keys 82 1` sets Regular, not Diverted, and the
# rules then never fire.
#
# Every call is idempotent, so re-running on each connect is safe. DPI is
# deliberately absent: this runs on every device-add event, and writing dpi
# would kick you out of precision mode mid-hold.

set -uo pipefail

SERIAL=${MX_ERGO_SERIAL:-BD092C51}

# Quiet on success. On failure, print what solaar said minus its unconditional
# Wayland banner, which would otherwise put nine lines in the journal every time
# any input device appears -- then stop, because if one call cannot reach the
# trackball the remaining eight cannot either.
cfg() {
    local out
    if ! out=$(solaar config "$SERIAL" "$@" 2>&1); then
        printf '%s\n' "$out" | grep -v '^rules cannot access modifier keys' >&2
        exit 1
    fi
}

# The wheel must stay undiverted or vertical scrolling dies.
cfg lowres-scroll-mode false

# Only the middle button is diverted; rules.yaml turns its press and release
# into the precision hold. Everything else has to keep sending its normal HID
# event -- the tilts in particular are horizontal scroll.
cfg divert-keys "Middle Button" Diverted
for k in "Back Button" "Forward Button" "Left Tilt" "Right Tilt" "DPI Switch"; do
    cfg divert-keys "$k" Regular
done

# Middle keeps its own action so it degrades to a plain middle click when Solaar
# is not running; the clicks it gives up reappear on the precision button.
cfg reprogrammable-keys "Middle Button" "Mouse Middle Button"
cfg reprogrammable-keys "DPI Switch"    "Mouse Middle Button"

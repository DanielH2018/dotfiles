{
  "entries": [
    {
      "id": "ssh-keys",
      "why": "private keys, known_hosts and the agent config",
      "case_arms": [
        "*/.ssh/*",
        "*/id_rsa*",
        "*/id_ed25519*",
        "*/id_ecdsa*",
        ".ssh/*",
        "id_rsa*",
        "id_ed25519*",
        "id_ecdsa*"
      ],
      "message": "Blocked: SSH keys are never safe to read or modify automatically.",
      "bash_re": [
        "\\.ssh/",
        "id_rsa",
        "id_ed25519",
        "id_ecdsa"
      ],
      "read_globs": [
        "**/id_rsa",
        "**/id_ed25519",
        "**/.ssh/**",
        "**/id_ecdsa"
      ],
      "edit_globs": [
        "**/id_rsa",
        "**/id_ed25519",
        "**/.ssh/**",
        "**/id_ecdsa"
      ]
    },
    {
      "id": "claude-oauth-credentials",
      "why": "the live Claude Code OAuth access and refresh token on Linux and WSL, a different file from ~/.claude.json",
      "case_arms": [
        ".credentials.json",
        "*/.claude/.credentials.json"
      ],
      "message": "Blocked: this is the Claude Code OAuth token store.",
      "bash_re": [
        "\\.claude/\\.credentials\\.json"
      ],
      "read_globs": [
        "~/.claude/.credentials.json"
      ],
      "edit_globs": [
        "~/.claude/.credentials.json"
      ]
    },
    {
      "id": "aws",
      "why": "AWS access keys and profile config",
      "case_arms": [
        ".aws/credentials",
        ".aws/config",
        "*/.aws/credentials",
        "*/.aws/config"
      ],
      "message": "Blocked: AWS credentials file.",
      "bash_re": [
        "\\.aws/credentials",
        "\\.aws/config"
      ],
      "read_globs": [
        "**/.aws/credentials",
        "**/.aws/config"
      ],
      "edit_globs": [
        "**/.aws/credentials",
        "**/.aws/config"
      ]
    },
    {
      "id": "token-rc-files",
      "why": "registry and machine tokens for curl, pip and npm",
      "case_arms": [
        ".netrc",
        ".pypirc",
        ".npmrc",
        "*/.netrc",
        "*/.pypirc",
        "*/.npmrc"
      ],
      "message": "Blocked: this file commonly contains auth tokens.",
      "bash_re": [
        "\\.netrc",
        "\\.pypirc",
        "\\.npmrc"
      ],
      "read_globs": [
        "~/.netrc",
        "~/.pypirc",
        "~/.npmrc",
        "**/.netrc",
        "**/.pypirc",
        "**/.npmrc"
      ],
      "edit_globs": [
        "~/.netrc",
        "~/.pypirc",
        "~/.npmrc",
        "**/.netrc",
        "**/.pypirc",
        "**/.npmrc"
      ]
    },
    {
      "id": "gnupg",
      "why": "the GnuPG keyring",
      "case_arms": [
        ".gnupg/*",
        "*/.gnupg/*"
      ],
      "message": "Blocked: GPG keyring.",
      "bash_re": [
        "\\.gnupg/"
      ],
      "read_globs": [
        "~/.gnupg/**"
      ],
      "edit_globs": [
        "~/.gnupg/**"
      ]
    },
    {
      "id": "key-files",
      "why": "private keys and certificates by suffix",
      "case_arms": [
        "*.pem",
        "*.key",
        "*.p12",
        "*.pfx"
      ],
      "message": "Blocked: looks like a private key or certificate.",
      "bash_re": [
        "(^|[A-Za-z0-9_~/-])\\.(pem|key|p12|pfx)\\b"
      ],
      "read_globs": [
        "**/*.pem",
        "**/*.key",
        "**/*.p12",
        "**/*.pfx"
      ],
      "edit_globs": [
        "**/*.pem",
        "**/*.key",
        "**/*.p12",
        "**/*.pfx"
      ]
    },
    {
      "id": "secrets-directory",
      "why": "anything under a directory named secrets",
      "case_arms": [
        "secrets/*",
        "*/secrets/*"
      ],
      "message": "Blocked: files under a secrets/ directory.",
      "bash_re": [
        "/secrets/"
      ],
      "read_globs": [
        "**/secrets/**"
      ],
      "edit_globs": [
        "**/secrets/**"
      ]
    },
    {
      "id": "claude-config",
      "why": "the account block and, on some platforms, the OAuth token",
      "case_arms": [
        ".claude.json",
        "*/.claude.json"
      ],
      "message": "Blocked: ~/.claude.json holds the Claude Code account OAuth token.",
      "bash_re": [
        "\\.claude\\.json"
      ],
      "read_globs": [
        "~/.claude.json"
      ],
      "edit_globs": [
        "~/.claude.json"
      ]
    },
    {
      "id": "git-credentials",
      "why": "plaintext git remote credentials",
      "case_arms": [
        ".git-credentials",
        "*/.git-credentials"
      ],
      "message": "Blocked: .git-credentials stores host credentials in plaintext.",
      "bash_re": [
        "\\.git-credentials"
      ],
      "read_globs": [
        "~/.git-credentials"
      ],
      "edit_globs": [
        "~/.git-credentials"
      ]
    },
    {
      "id": "cluster-and-registry",
      "why": "cluster certs and tokens, registry auth, the gh token",
      "case_arms": [
        "*/.kube/config",
        "*/.docker/config.json",
        "*/.config/gh/hosts.yml"
      ],
      "message": "Blocked: this file holds cluster or registry credentials.",
      "bash_re": [
        "\\.kube/config",
        "\\.docker/config\\.json",
        "\\.config/gh/hosts\\.yml"
      ],
      "read_globs": [
        "~/.kube/config",
        "~/.docker/config.json",
        "~/.config/gh/**"
      ],
      "edit_globs": [
        "~/.kube/config",
        "~/.docker/config.json",
        "~/.config/gh/**"
      ]
    },
    {
      "id": "password-database",
      "why": "local user and group password hashes",
      "case_arms": [
        "/etc/shadow",
        "/etc/gshadow"
      ],
      "message": "Blocked: system password database.",
      "bash_re": [
        "/etc/shadow",
        "/etc/gshadow"
      ],
      "read_globs": [
        "/etc/shadow",
        "/etc/gshadow"
      ],
      "edit_globs": [
        "/etc/shadow",
        "/etc/gshadow"
      ]
    },
    {
      "id": "process-environment",
      "why": "another process's exported environment",
      "case_arms": [
        "/proc/*/environ"
      ],
      "message": "Blocked: /proc/<pid>/environ exposes another process's exported secrets.",
      "bash_re": [
        "/proc/[^/[:space:]]+/environ"
      ],
      "read_globs": [
        "/proc/*/environ"
      ],
      "edit_globs": []
    },
    {
      "id": "secret-suffix",
      "why": "files named *.secret",
      "case_arms": [
        "*.secret"
      ],
      "message": "Blocked: a *.secret file holds a secret by name.",
      "bash_re": [
        "(^|[A-Za-z0-9_~/-])\\.secret\\b"
      ],
      "read_globs": [
        "**/*.secret"
      ],
      "edit_globs": [
        "**/*.secret"
      ]
    },
    {
      "id": "sops-age-keys",
      "why": "the SOPS age private keys, which decrypt every secret in a public repo; *.key misses them because the file is keys.txt",
      "case_arms": [
        ".config/sops/age/*",
        "*/.config/sops/age/*",
        "*.agekey"
      ],
      "message": "Blocked: a SOPS age private key decrypts every secret in the repo.",
      "bash_re": [
        "\\.config/sops/age/",
        "(^|[A-Za-z0-9_~/-])\\.agekey\\b"
      ],
      "read_globs": [
        "~/.config/sops/age/**",
        "**/*.agekey"
      ],
      "edit_globs": [
        "~/.config/sops/age/**",
        "**/*.agekey"
      ]
    },
    {
      "id": "gcloud",
      "why": "Google Cloud credentials and access tokens",
      "case_arms": [
        ".config/gcloud/*",
        "*/.config/gcloud/*"
      ],
      "message": "Blocked: Google Cloud credentials and access tokens.",
      "bash_re": [
        "\\.config/gcloud/"
      ],
      "read_globs": [
        "~/.config/gcloud/**"
      ],
      "edit_globs": [
        "~/.config/gcloud/**"
      ]
    },
    {
      "id": "dotenv",
      "why": "dotenv files; the committed templates hold placeholder keys and stay readable",
      "case_arms": [
        ".env",
        "*/.env",
        ".env.*",
        "*/.env.*"
      ],
      "message": "Blocked: .env files may contain secrets. Ask the user to share the specific value needed.",
      "read_exempts_env_templates": true,
      "bash_re": [
        "(?<!process)(?<!\\.\\.)\\.env(?!iron(?:ments?|b)?\\b)(?!\\.(?:example|sample|template)(?![A-Za-z0-9_./-]))"
      ],
      "read_globs": [
        "**/.env",
        "**/.env.",
        "**/.env.[ -@A-DF-RU-Z[-`a-df-ru-z{-~]*",
        "**/.env.[eE]",
        "**/.env.[eE][ -@A-WY-Z[-`a-wy-z{-~]*",
        "**/.env.[eE][xX]",
        "**/.env.[eE][xX][ -@B-Z[-`b-z{-~]*",
        "**/.env.[eE][xX][aA]",
        "**/.env.[eE][xX][aA][ -@A-LN-Z[-`a-ln-z{-~]*",
        "**/.env.[eE][xX][aA][mM]",
        "**/.env.[eE][xX][aA][mM][ -@A-OQ-Z[-`a-oq-z{-~]*",
        "**/.env.[eE][xX][aA][mM][pP]",
        "**/.env.[eE][xX][aA][mM][pP][ -@A-KM-Z[-`a-km-z{-~]*",
        "**/.env.[eE][xX][aA][mM][pP][lL]",
        "**/.env.[eE][xX][aA][mM][pP][lL][ -@A-DF-Z[-`a-df-z{-~]*",
        "**/.env.[eE][xX][aA][mM][pP][lL][eE]?*",
        "**/.env.[sS]",
        "**/.env.[sS][ -@B-Z[-`b-z{-~]*",
        "**/.env.[sS][aA]",
        "**/.env.[sS][aA][ -@A-LN-Z[-`a-ln-z{-~]*",
        "**/.env.[sS][aA][mM]",
        "**/.env.[sS][aA][mM][ -@A-OQ-Z[-`a-oq-z{-~]*",
        "**/.env.[sS][aA][mM][pP]",
        "**/.env.[sS][aA][mM][pP][ -@A-KM-Z[-`a-km-z{-~]*",
        "**/.env.[sS][aA][mM][pP][lL]",
        "**/.env.[sS][aA][mM][pP][lL][ -@A-DF-Z[-`a-df-z{-~]*",
        "**/.env.[sS][aA][mM][pP][lL][eE]?*",
        "**/.env.[tT]",
        "**/.env.[tT][ -@A-DF-Z[-`a-df-z{-~]*",
        "**/.env.[tT][eE]",
        "**/.env.[tT][eE][ -@A-LN-Z[-`a-ln-z{-~]*",
        "**/.env.[tT][eE][mM]",
        "**/.env.[tT][eE][mM][ -@A-OQ-Z[-`a-oq-z{-~]*",
        "**/.env.[tT][eE][mM][pP]",
        "**/.env.[tT][eE][mM][pP][ -@A-KM-Z[-`a-km-z{-~]*",
        "**/.env.[tT][eE][mM][pP][lL]",
        "**/.env.[tT][eE][mM][pP][lL][ -@B-Z[-`b-z{-~]*",
        "**/.env.[tT][eE][mM][pP][lL][aA]",
        "**/.env.[tT][eE][mM][pP][lL][aA][ -@A-SU-Z[-`a-su-z{-~]*",
        "**/.env.[tT][eE][mM][pP][lL][aA][tT]",
        "**/.env.[tT][eE][mM][pP][lL][aA][tT][ -@A-DF-Z[-`a-df-z{-~]*",
        "**/.env.[tT][eE][mM][pP][lL][aA][tT][eE]?*"
      ],
      "edit_globs": [
        "**/.env",
        "**/.env.*"
      ]
    }
  ],
  "cases": [
    {
      "input": "/home/daniel/.claude/.credentials.json",
      "entry": "claude-oauth-credentials"
    },
    {
      "input": ".credentials.json",
      "entry": "claude-oauth-credentials"
    },
    {
      "input": "~/.claude/.credentials.json",
      "entry": "claude-oauth-credentials"
    }
  ]
}

#!/usr/bin/env bash
# Enable the daily /changelog-watch timer on daniel-box only; disable it on every other Linux
# host. Each run is an unattended `claude --dangerously-skip-permissions -p "/changelog-watch"`
# session, and running it on both servers as well ran the same unattended session three times a
# day (2026-09-24, 25, 26) for no benefit. run_onchange re-runs (and reloads systemd) whenever
# the unit files or this gate change — their hashes are embedded so edits retrigger it, and the
# gate change itself retriggers it once on every host to clean up.
# Idempotent; a no-op where user systemd isn't running (macOS, a non-lingering headless box).
#   service: {{ include "dot_config/systemd/user/claude-changelog-watch.service" | sha256sum }}
#   timer:   {{ include "dot_config/systemd/user/claude-changelog-watch.timer" | sha256sum }}
set -eu
if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  systemctl --user daemon-reload || true
{{ if eq .chezmoi.hostname "daniel-box" -}}
  systemctl --user enable --now claude-changelog-watch.timer || true
{{ else -}}
  systemctl --user disable --now claude-changelog-watch.timer 2>/dev/null || true
{{ end -}}
fi

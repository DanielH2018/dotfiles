#!/usr/bin/env bash
# NO_VAULT, NO_CHEZMOI, NO_WORK_CONFIG, NO_REPOS, REPOS_LIVE, REPOS_ROOT and
# REPO_SNAPSHOT_ROOT are parsed here and read in sandbox-mounts.sh, a source path
# that resolves at runtime and so cannot be followed by the linter — the same
# reason .shellcheckrc disables SC1091. Without the directive below, all seven
# are reported as unused.
#
# (Kept off the start of a comment line on purpose: a line beginning "# shell"
# followed by "check" is parsed as a directive and errors with SC1073.)
#
# The directive below is FILE-WIDE, not scoped to those seven: SC2034 is off for
# the whole launcher, so a genuinely dead variable added later will not be caught
# here. The names above are documentation, not scope. Scoping this properly needs
# external-sources=true in .shellcheckrc plus source= directives, which changes
# analysis for every sourced fragment in the repo and wants its own change.
# shellcheck disable=SC2034
set -euo pipefail


# claude-sandbox: Launch Claude Code in a Docker-based Pattern C sandbox.
# Usage: claude-sandbox [--rebuild|--rebuild-base|--generate|--worktree NAME] <repo-path>

SANDBOX_DIR="$HOME/.claude/sandbox"
AUDIT_BASE="$SANDBOX_DIR/audit"
SESSIONS_BASE="$SANDBOX_DIR/sessions"
ARTIFACTS_BASE="$SANDBOX_DIR/artifacts"
STATE_DIR="$SANDBOX_DIR/state"
# $STATE_DIR is ONE directory shared by every instance — that is what makes a
# single OAuth login and one Snowflake token serve all of them. The cost is that
# everything else Claude writes under ~/.claude is pooled too, so a session in
# one repo reads another repo's prompt history, edit history and shell snapshots.
# $PRIVATE_BASE holds the per-instance replacements for exactly those three,
# layered over the shared state mount (the nested-mount trick used for plugins,
# commands and the :ro hooks). Credentials, auth markers, plugins and the
# Snowflake cache deliberately stay shared: splitting them would re-prompt for
# login in every repo.
PRIVATE_BASE="$SANDBOX_DIR/state-private"
# shellcheck disable=SC1091  # deployed next to this script, not resolvable from the chezmoi source tree
. "$SANDBOX_DIR/sandbox-lib.sh"        # resolve_repo_path()
# shellcheck disable=SC1091  # ditto
. "$SANDBOX_DIR/sandbox-worktree.sh"   # sanitize_repo_name(), repo_hash(), worktree enumeration
# shellcheck disable=SC1091  # ditto
. "$SANDBOX_DIR/sandbox-mounts.sh"     # add_*_mounts() — these READ AND WRITE the globals
                                       # below (DOCKER_ARGS, REPO_PATH, VAULT_*); see its header
# shellcheck disable=SC1091  # ditto
. "$SANDBOX_DIR/sandbox-image.sh"      # toolchain detection + generate_dockerfile(); reads
                                       # REPO_PATH/DOCKERFILE, sets NEEDS_DOCKER
# shellcheck disable=SC1091  # ditto
. "$SANDBOX_DIR/sandbox-proxy.sh"      # start_proxy()/start_filter()/stop_proxy(); read the
                                       # PROXY_*/FILTER_*/NETWORK_* names, and exit on failure
# shellcheck disable=SC1091  # ditto
. "$SANDBOX_DIR/sandbox-compact.sh"    # compact_session(); takes its inputs as arguments
# shellcheck disable=SC1091  # ditto
. "$SANDBOX_DIR/sandbox-worktree-ops.sh"  # setup_worktree(), cleanup/delete, and the
                                       # --complete-*/--rename CLI paths — these SET
                                       # WT_BRANCH, WT_PATH, WT_CREATED and WORK_PATH,
                                       # and exit on failure
# shellcheck disable=SC1091  # ditto
. "$SANDBOX_DIR/sandbox-worktree-gc.sh"  # --prune, --gc and the startup nudge; calls
                                       # delete_worktree, so it must follow the line
                                       # above
# shellcheck disable=SC1091  # ditto
. "$SANDBOX_DIR/sandbox-auth.sh"       # configure_gh_auth()/run_oauth_if_needed(); append
                                       # to DOCKER_ARGS and SET GH_HOSTS_TMPFILE, which
                                       # cleanup() deletes on exit; see its header
# shellcheck disable=SC1091  # ditto
. "$SANDBOX_DIR/sandbox-session.sh"    # resolve_session_context() SETS the per-instance
                                       # dirs, RESUME_SESSION, AUTH_MARKER and
                                       # TOOLCHAIN_LIST; cleanup() is the EXIT trap
# Machine/work-specific values (e.g. CLAUDE_VAULT_DIR) for an optional work overlay.
if [ -f "$HOME/.config/claude/local.env" ]; then
  # shellcheck disable=SC1091  # optional machine-local overlay; absent on most hosts
  . "$HOME/.config/claude/local.env"
fi
# 1Password SSH-agent socket for signed commits — the path differs by platform.
if [[ "${OSTYPE:-}" == darwin* ]]; then
  OP_SOCKET="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
else
  OP_SOCKET="$HOME/.1password/agent.sock"
fi
# TODO: pin to a specific digest once you've pulled a known-good version:
#   docker inspect lscr.io/linuxserver/socket-proxy:latest --format '{{index .RepoDigests 0}}'
# Then replace :latest with the sha256 digest to avoid supply-chain risk.
PROXY_IMAGE="lscr.io/linuxserver/socket-proxy:latest"

usage() {
  echo "Usage: claude-sandbox [OPTIONS] <repo-path>"
  echo ""
  echo "With no -w/-b, the repo's own checkout is mounted and the session isolates itself"
  echo "by creating worktrees under <repo>/.claude/worktrees. Your main checkout keeps the"
  echo "branch it has out. -w/-b instead set the worktree up on the host before launching."
  echo ""
  echo "Options:"
  echo "  --rebuild          Force rebuild the per-repo Docker image"
  echo "  --rebuild-base     Rebuild the claudebot:base image (run after editing Dockerfile.base);"
  echo "                     reinstalls the pinned Claude Code. The version is"
  echo "                     CLAUDE_CODE_VERSION in Dockerfile.base; edit it to move."
  echo "  --generate         Regenerate Dockerfile.claudebot only (don't build or run)"
  echo "  --worktree, -w [NAME]  Run in an isolated git worktree on branch claude/<NAME>."
  echo "                     Reuses existing worktree if branch already exists."
  echo "                     If NAME is omitted, generates a short random suffix."
  echo "                     Worktree is kept on exit if it has changes; removed if clean."
  echo "  --branch, -b BRANCH    Run in a worktree on BRANCH, keeping its name. Uses it"
  echo "                     if it exists (local or origin), else creates it from HEAD."
  echo "                     E.g. -b feature-xyz. Cannot combine with -w."
  echo "  --list             List all sandbox sessions (worktrees + main) for a repo."
  echo "                     Shows branch, path, running status, and resume command."
  echo "  --rename OLD NEW   Rename a worktree: branch, directory, and session data."
  echo "  --prune            Interactively select and delete worktrees (fzf picker), along"
  echo "                     with their saved conversations."
  echo "  --gc               Remove worktrees whose remote branches were deleted. Keeps the"
  echo "                     conversations — use --prune to delete those."
  echo "  --no-vault         Don't mount the curated read-only vault subset."
  echo "  --no-chezmoi       Don't mount the chezmoi dotfiles source (vault runs mount it RW)."
  echo "  --no-work-config   Don't mount the work-laptop-config source (vault runs mount it RW)."
  echo "  --no-repos         Don't mount sibling repos from ~/Repositories."
  echo "  --repos-live       Mount siblings' live working trees instead of clean main/master snapshots."
  echo "  --shell            Open an interactive bash shell instead of Claude. If a session for"
  echo "                     this repo/worktree is already running, exec into that live container;"
  echo "                     otherwise launch a standalone hardened shell. Unaudited (see warning)."
  echo "  --exec, -x PROMPT  Headless: run one non-interactive implementer (claude -p PROMPT) in"
  echo "                     the container. Readable progress -> stderr, final result -> stdout"
  echo "                     (between <<<EXEC_RESULT>>> markers), full stream-json -> /audit."
  echo "                     For orchestrator-dispatched work. Cannot combine with --shell."
  echo "  --fresh, --new     Start a new conversation even if this instance has a prior"
  echo "                     session. By default an existing session auto-resumes (--continue)."
  # An asked-for --help is a success; reaching here from a bad invocation is not.
  exit "${1:-1}"
}

# --- Parse args ---
REBUILD=false
REBUILD_BASE=false
GENERATE_ONLY=false
LIST_SESSIONS=false
COMPLETE_WORKTREES=false
PRUNE_WORKTREES=false
GC_WORKTREES=false
RENAME_WORKTREE=false
RENAME_OLD=""
RENAME_NEW=""
USE_WORKTREE=false
BRANCH_MODE=false
EXISTING_BRANCH=""
COMPLETE_BRANCHES=false
WT_NAME=""
REPO_PATH=""
NO_VAULT=false
NO_CHEZMOI=false
NO_WORK_CONFIG=false
NO_REPOS=false
REPOS_LIVE=false
FRESH_SESSION=false
SHELL_MODE=false
EXEC_MODE=false
EXEC_PROMPT=""
SETUP_WORKTREE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --rebuild) REBUILD=true; shift ;;
    --rebuild-base) REBUILD_BASE=true; shift ;;
    --generate) GENERATE_ONLY=true; shift ;;
    --list) LIST_SESSIONS=true; shift ;;
    --complete-worktrees) COMPLETE_WORKTREES=true; shift ;;
    --complete-branches) COMPLETE_BRANCHES=true; shift ;;
    --setup-worktree) SETUP_WORKTREE=true; shift ;;
    --prune) PRUNE_WORKTREES=true; shift ;;
    --gc) GC_WORKTREES=true; shift ;;
    --rename)
      RENAME_WORKTREE=true
      shift
      if [[ $# -lt 2 ]]; then
        echo "Error: --rename requires OLD and NEW names" >&2
        exit 1
      fi
      RENAME_OLD="$1"; shift
      RENAME_NEW="$1"; shift
      ;;
    --worktree|-w)
      USE_WORKTREE=true
      shift
      # Consume the next arg as worktree name if it doesn't look like a flag or path
      if [[ $# -gt 0 && "$1" != -* && "$1" != /* && "$1" != .* ]]; then
        WT_NAME="$1"
        shift
      fi
      ;;
    -b|--branch)
      BRANCH_MODE=true
      USE_WORKTREE=true
      shift
      if [[ $# -gt 0 && "$1" != -* ]]; then
        EXISTING_BRANCH="$1"; shift
      else
        echo "Error: -b/--branch requires an existing branch name" >&2; exit 1
      fi
      ;;
    --no-vault) NO_VAULT=true; shift ;;
    --no-chezmoi) NO_CHEZMOI=true; shift ;;
    --no-work-config) NO_WORK_CONFIG=true; shift ;;
    --no-repos) NO_REPOS=true; shift ;;
    --repos-live) REPOS_LIVE=true; shift ;;
    --shell) SHELL_MODE=true; shift ;;
    --exec|-x)
      EXEC_MODE=true
      shift
      if [[ $# -gt 0 && "$1" != -* ]]; then
        EXEC_PROMPT="$1"; shift
      else
        echo "Error: --exec/-x requires a prompt string" >&2; exit 1
      fi
      ;;
    --fresh|--new) FRESH_SESSION=true; shift ;;
    -h|--help) usage 0 ;;
    -*) echo "Unknown option: $1"; usage ;;
    *) REPO_PATH="$1"; shift ;;
  esac
done

if [[ "$EXEC_MODE" == true ]]; then
  [[ "$SHELL_MODE" == true ]] && { echo "Error: --exec cannot combine with --shell" >&2; exit 1; }
  [[ -z "$EXEC_PROMPT" ]] && { echo "Error: --exec requires a non-empty prompt" >&2; exit 1; }
  [[ -z "$REPO_PATH" ]] && { echo "Error: --exec requires a <repo-path>" >&2; exit 1; }
fi

# --- Docker prerequisites (needed by --rebuild-base and normal runs) ---
if [[ "$LIST_SESSIONS" == false && "$COMPLETE_WORKTREES" == false && "$COMPLETE_BRANCHES" == false && "$SETUP_WORKTREE" == false && "$PRUNE_WORKTREES" == false && "$GC_WORKTREES" == false && "$RENAME_WORKTREE" == false && (("$GENERATE_ONLY" == false && -n "$REPO_PATH") || "$REBUILD_BASE" == true) ]]; then
  if ! command -v docker &>/dev/null; then
    echo "Error: docker is not installed." >&2
    exit 1
  fi
  if ! docker info &>/dev/null 2>&1; then
    echo "Error: Docker daemon is not running." >&2
    exit 1
  fi
fi

# --- Base image build helper ---
# The Claude Code release the image installs is the CLAUDE_CODE_VERSION pin in
# Dockerfile.base, and this reads it from there. The launcher used to resolve the
# newest release from the npm registry instead, re-checked at most once per day,
# so the image was only ever as reproducible as the DATE it was last built on —
# and an offline run fell back to the newest release inside the build, which is
# not reproducible at all. Two developers on one commit got two Claude Codes.
#
# Read rather than duplicated: Dockerfile.base already has to carry the version
# as the ARG default, so a copy here would be a second place to bump.
CLAUDE_CODE_PINNED=""
CLAUDE_CODE_PIN_READ=false
resolve_claude_code_version() {
  if [[ "$CLAUDE_CODE_PIN_READ" == false ]]; then
    CLAUDE_CODE_PIN_READ=true
    CLAUDE_CODE_PINNED="$(sed -n 's/^ARG CLAUDE_CODE_VERSION=\([0-9][0-9.]*\)$/\1/p' \
      "$SANDBOX_DIR/Dockerfile.base" | head -1)"
  fi
  printf '%s' "$CLAUDE_CODE_PINNED"
}

# Builds claudebot:base. "force" (explicit --rebuild-base) additionally busts the
# Claude Code layer with a timestamp token, to reinstall the same version.
#
# An unreadable pin FAILS the build rather than falling back. The fallback was
# the newest release, which produced a working image carrying a version nothing
# recorded — the state this pin exists to remove, arrived at silently.
build_base() {
  local version refresh_args=()
  version="$(resolve_claude_code_version)"
  if [[ -z "$version" ]]; then
    echo "Error: no CLAUDE_CODE_VERSION pin in $SANDBOX_DIR/Dockerfile.base." >&2
    echo "       It must read 'ARG CLAUDE_CODE_VERSION=<x.y.z>'." >&2
    return 1
  fi
  if [[ "${1:-}" == "force" ]]; then
    refresh_args=(--build-arg "CLAUDE_CODE_REFRESH=$(date -u +%Y%m%d%H%M%S)")
  fi
  echo "Building claudebot:base (claude-code $version)..."
  docker build -t claudebot:base \
    --build-arg "CLAUDE_CODE_VERSION=$version" \
    ${refresh_args[@]+"${refresh_args[@]}"} \
    -f "$SANDBOX_DIR/Dockerfile.base" "$SANDBOX_DIR"
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$version" > "$STATE_DIR/.claude-code-version"
  return 0
}

# A per-repo image runs the Claude Code baked into the base it was built on, so it
# has to be rebuilt whenever the base moves — not only when the base moved in THIS
# run. refresh_claude_if_stale sets REBUILD for whichever repo happens to trigger
# the daily rebuild; every other repo launches later the same day, finds the stamp
# already fresh, and would otherwise keep running the old release out of its own
# cached layers indefinitely. The base id is stamped onto the per-repo image as a
# label at build time, so this needs no side state, and an image built before the
# label existed rebuilds once.
built_on_stale_base() {
  local tag="$1" current="$2" built_on
  [[ -n "$current" ]] || return 1
  docker image inspect "$tag" &>/dev/null || return 1
  built_on="$(docker image inspect --format '{{index .Config.Labels "claudebot.base-id"}}' "$tag" 2>/dev/null || true)"
  [[ "$built_on" != "$current" ]]
}

# Rebuild when the PIN has moved past what the existing base was built with.
# This used to re-check the npm registry daily for a newer release, so what the
# image ran was decided by the date rather than by the commit; the trigger is now
# a Dockerfile.base edit, which is reviewable and reverts like anything else.
refresh_claude_if_stale() {
  docker image inspect claudebot:base &>/dev/null || return 0
  local pinned installed
  pinned="$(resolve_claude_code_version)"
  installed="$(cat "$STATE_DIR/.claude-code-version" 2>/dev/null || true)"
  # No pin readable: leave the existing image alone and let build_base report it
  # if something else asks for a build. A launch is not the place to fail on it.
  [[ -n "$pinned" ]] || return 0
  if [[ "$pinned" == "$installed" ]]; then
    return 0
  fi
  echo "Rebuilding Claude Code → $pinned (the Dockerfile.base pin moved)..."
  # Per-repo images are FROM claudebot:base, so they only need rebuilding when
  # the base image ID actually moved. Rebuilding them after a no-op base build
  # was the bulk of what the daily refresh cost.
  local before after
  before="$(docker image inspect --format '{{.Id}}' claudebot:base 2>/dev/null || true)"
  build_base
  after="$(docker image inspect --format '{{.Id}}' claudebot:base 2>/dev/null || true)"
  if [[ "$before" != "$after" ]]; then
    REBUILD=true
  fi
  return 0
}

# --- Rebuild base image if requested ---
if [[ "$REBUILD_BASE" == true ]]; then
  build_base force
  [[ -z "$REPO_PATH" ]] && exit 0
  # Base changed — force per-repo rebuild too
  REBUILD=true
fi

[[ -z "$REPO_PATH" ]] && usage

# Resolve short repo names: "airflow" -> ~/Repositories/airflow
REPO_PATH="$(resolve_repo_path "$REPO_PATH")"

REPO_PATH="$(cd "$REPO_PATH" && pwd)"
# Sanitize repo name for use in Docker tags (must match [a-zA-Z0-9._-])
REPO_NAME="$(sanitize_repo_name "$REPO_PATH")"
if [[ -z "$REPO_NAME" ]]; then
  echo "Error: could not derive a valid repo name from path: $REPO_PATH" >&2
  exit 1
fi

# Validate repo is a git repository (.git can be a file in worktrees)
if [[ ! -d "$REPO_PATH/.git" && ! -f "$REPO_PATH/.git" ]]; then
  echo "Error: not a git repository: $REPO_PATH" >&2
  exit 1
fi

# Branch mode: derive a filesystem-safe worktree name from the branch name.
if [[ "$BRANCH_MODE" == true ]]; then
  if [[ -n "$WT_NAME" ]]; then
    echo "Error: -b/--branch cannot be combined with -w/--worktree" >&2
    exit 1
  fi
  WT_NAME="$(printf '%s' "$EXISTING_BRANCH" | tr -c 'a-zA-Z0-9_-' '-' | sed 's/--*/-/g; s/^-//; s/-$//')"
  if [[ -z "$WT_NAME" ]]; then
    echo "Error: could not derive a worktree name from branch: '$EXISTING_BRANCH'" >&2
    exit 1
  fi
fi

# Generate worktree name if needed
if [[ "$USE_WORKTREE" == true && -z "$WT_NAME" ]]; then
  WT_NAME="$(openssl rand -hex 3)"
fi

# Validate worktree name (alphanumeric, hyphens, underscores only)
if [[ -n "$WT_NAME" ]] && [[ ! "$WT_NAME" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo "Error: worktree name must be alphanumeric (hyphens/underscores allowed): '$WT_NAME'" >&2
  exit 1
fi

# Use a short hash of the full path to avoid collisions when two repos
# share the same basename (e.g., ~/work/api vs ~/personal/api).
REPO_HASH="$(repo_hash "$REPO_PATH")"

# INSTANCE_ID is deterministic per repo (or per worktree) — used for storage
# paths (sessions, audit) so Claude can resume previous conversations.
# RUN_ID adds a random suffix for Docker resources (container, proxy, network)
# that must be unique across parallel launches of the same repo.
if [[ "$USE_WORKTREE" == true ]]; then
  INSTANCE_ID="${REPO_NAME}-${REPO_HASH}-${WT_NAME}"
else
  INSTANCE_ID="${REPO_NAME}-${REPO_HASH}"
fi
RUN_ID="${INSTANCE_ID}-$(openssl rand -hex 3)"
IMAGE_TAG="claudebot:${REPO_NAME}-${REPO_HASH}"
DOCKERFILE="$SANDBOX_DIR/dockerfiles/Dockerfile.${REPO_NAME}-${REPO_HASH}"
PROXY_NAME="claudebot-proxy-$RUN_ID"
# Short, DNS-resolvable alias for the proxy. $PROXY_NAME can exceed the 63-char
# DNS label limit, which Docker's embedded resolver silently won't serve; the
# network is isolated per run, so a fixed alias is safe from collisions.
PROXY_ALIAS="claudebot-proxy"
# The body-inspecting filter sits in FRONT of the socket proxy: the sandbox talks to
# this, it talks to the socket proxy, and only the socket proxy touches the socket.
FILTER_NAME="claudebot-dockerfilter-$RUN_ID"
FILTER_ALIAS="claudebot-dockerfilter"
NETWORK_NAME="claudebot-net-$RUN_ID"
# The filter is only a chokepoint if the sandbox has no route around it. Two networks:
# the sandbox and the filter share NETWORK_NAME, the filter and the proxy share
# PROXY_NETWORK_NAME, and nothing is on both except the filter. The sandbox therefore
# has no interface with a route to the proxy at all, whatever the filter does or does
# not parse correctly.
PROXY_NETWORK_NAME="claudebot-net-$RUN_ID-proxy"
# Canonicalization the filter needs to read a create body the way dockerd will. Both
# files are bind-mounted individually, so canon.py has to be named explicitly.
CANON_LIB="${CANON_LIB:-$HOME/.local/share/canon/canon.py}"

# --- Shell mode: exec into a live session if one is running ---
# INSTANCE_ID is deterministic per repo/worktree, while the container name adds a
# random RUN_ID suffix. If a session for this instance is already up, drop a second
# interactive shell into that same container (shared mounts/network/state) rather
# than booting a new one. If none is running, fall through to the normal launch
# path below with the final command swapped to bash (a standalone hardened shell).
if [[ "$SHELL_MODE" == true ]]; then
  LIVE_CONTAINER="$(docker ps --filter "name=claudebot-${INSTANCE_ID}-" --format '{{.Names}}' 2>/dev/null \
    | grep -E "^claudebot-${INSTANCE_ID}-[0-9a-f]+$" | head -1 || true)"
  if [[ -n "$LIVE_CONTAINER" ]]; then
    echo "Attaching a shell to the running session: $LIVE_CONTAINER"
    echo "Warning: this shell is UNAUDITED — commands run here are not logged to /audit" >&2
    echo "         (only Claude's tool calls are). Same container, same mounts as the live session." >&2
    # Default user (claudebot) and no added caps — inherits the container's hardening.
    exec docker exec -it "$LIVE_CONTAINER" bash -l
  fi
  echo "No running session for ${INSTANCE_ID} — launching a standalone hardened shell."
fi

# WORK_PATH is what gets mounted into the container.
# Defaults to REPO_PATH; overridden to the worktree path below.
WORK_PATH="$REPO_PATH"
WT_BRANCH=""
WT_PATH=""
WT_CREATED=false
WT_BRANCH_CREATED=false

# --- Container engine quirks (rootless podman) ---
# `docker` here may be podman-docker: a shim that execs rootless podman. Two things
# that come free under rootful Docker have to be asked for there, and a bind mount
# is denied unless BOTH are present (each alone still fails — measured on F44 /
# podman 5.8.4):
#   * the container runs as container_t while the host dirs are user_home_t, so
#     SELinux denies every mount until its spec carries a relabel flag (`:z`);
#   * the container's uid 1000 maps to a subuid rather than to the invoking user,
#     so even a relabelled mount is not writable without --userns=keep-id.
# Missing either fails silently in the worst way: `claude auth login` inside the
# container cannot persist ~/.claude/.credentials.json, while the host-side
# `touch "$AUTH_MARKER"` succeeds — so the marker claims an OAuth session that
# does not exist and every later run skips login and starts unauthenticated.
# Set CLAUDE_SANDBOX_SELINUX=disable to drop the container's SELinux confinement
# instead of relabelling host paths (nothing under the mounts is relabelled, but
# the container loses that layer). Both helpers no-op under real Docker.
CLAUDEBOT_UID=1000   # Dockerfile.base: useradd --uid 1000 claudebot
CLAUDEBOT_GID=1000
ENGINE_ARGS=()
SANDBOX_MOUNT_RELABEL=""

detect_container_engine() {
  if ! command -v docker >/dev/null 2>&1; then
    echo docker
  elif docker --version 2>/dev/null | grep -qi podman; then
    echo podman
  else
    echo docker
  fi
}

# Appends the SELinux relabel flag to one -v spec (src:dst[:opts]). A no-op while
# $SANDBOX_MOUNT_RELABEL is empty, and idempotent — a spec that already carries a
# z/Z flag comes back untouched, so it is safe to run over the same array twice.
add_mount_relabel() {
  local spec="$1" opts
  if [[ -z "${SANDBOX_MOUNT_RELABEL:-}" ]]; then
    printf '%s\n' "$spec"
    return
  fi
  if [[ "$spec" == *:*:* ]]; then
    opts="${spec##*:}"
    case ",$opts," in
      *,z,*|*,Z,*) printf '%s\n' "$spec"; return ;;
    esac
    printf '%s,%s\n' "$spec" "$SANDBOX_MOUNT_RELABEL"
  else
    printf '%s:%s\n' "$spec" "$SANDBOX_MOUNT_RELABEL"
  fi
}

# Rewrites DOCKER_ARGS in place so every -v spec in it carries the relabel flag.
relabel_docker_args() {
  local i=0 next
  while [[ $i -lt ${#DOCKER_ARGS[@]} ]]; do
    if [[ "${DOCKER_ARGS[$i]}" == "-v" && $((i + 1)) -lt ${#DOCKER_ARGS[@]} ]]; then
      next=$((i + 1))
      DOCKER_ARGS[next]="$(add_mount_relabel "${DOCKER_ARGS[$next]}")"
      i=$((i + 2))
      continue
    fi
    i=$((i + 1))
  done
}

# --- Validate prerequisites ---
if [[ "$GENERATE_ONLY" == false ]]; then
  CONTAINER_ENGINE="$(detect_container_engine)"
  if [[ "$CONTAINER_ENGINE" == podman ]]; then
    ENGINE_ARGS=(--userns="keep-id:uid=$CLAUDEBOT_UID,gid=$CLAUDEBOT_GID")
    if [[ "${CLAUDE_SANDBOX_SELINUX:-}" == "disable" ]]; then
      ENGINE_ARGS+=(--security-opt label=disable)
    elif [[ -d /sys/fs/selinux ]]; then
      # selinuxfs is mounted iff SELinux is enabled, so this needs no
      # libselinux-utils and cannot mistake a missing `getenforce` for a
      # disabled SELinux — which would put the silent denial straight back.
      # Permissive would not need the flag, but relabelling there is harmless.
      SANDBOX_MOUNT_RELABEL="z"
    fi
  fi

  # Support ANTHROPIC_ADMIN_API_KEY as an alias to avoid collisions with host claude
  if [[ -n "${ANTHROPIC_ADMIN_API_KEY:-}" && -z "${ANTHROPIC_API_KEY:-}" ]]; then
    export ANTHROPIC_API_KEY="$ANTHROPIC_ADMIN_API_KEY"
  fi

  if [[ -z "${ANTHROPIC_API_KEY:-}" && ! -f "$STATE_DIR/.auth-configured" ]]; then
    echo "Note: No API key or OAuth session found — will prompt for OAuth login." >&2
  fi
fi

# --- Input validation ---
validate_version() {
  local label="$1" value="$2"
  if [[ ! "$value" =~ ^[0-9a-zA-Z._+\-]+$ ]]; then
    echo "Error: unsafe $label version string: '$value'" >&2
    exit 1
  fi
}

# --- List sessions ---
list_sessions() {
  local repo_name_safe rhash base_instance
  repo_name_safe="$(sanitize_repo_name "$REPO_PATH")"
  rhash="$(repo_hash "$REPO_PATH")"
  base_instance="${repo_name_safe}-${rhash}"

  echo "Sandbox sessions for $repo_name_safe ($REPO_PATH)"
  echo ""

  # Collect running container names for quick lookup
  local running_containers
  running_containers="$(docker ps --filter "name=claudebot-${base_instance}" --format '{{.Names}}' 2>/dev/null || true)"

  # Main repo session (no worktree). The run id is anchored to end of line, as at
  # the --shell probe above: unanchored, "<base>-[0-9a-f]" also matches a WORKTREE
  # instance whose name merely starts with a hex character, so a running `alpha`
  # would report the main repo as running too.
  local main_status="stopped"
  if echo "$running_containers" | grep -qE "^claudebot-${base_instance}-[0-9a-f]+$"; then
    main_status="running"
  fi
  printf "  %-12s %-30s %-10s %s\n" "NAME" "BRANCH" "STATUS" "RESUME"
  printf "  %-12s %-30s %-10s %s\n" "----" "------" "------" "------"

  # Get current branch of main repo
  local main_branch
  main_branch="$(git -C "$REPO_PATH" branch --show-current 2>/dev/null || echo "detached")"
  printf "  %-12s %-30s %-10s %s\n" "(main)" "$main_branch" "$main_status" "claude-sandbox $REPO_PATH"

  # Worktree sessions — scan tool-created worktrees (path: <repo>-wt-<name>),
  # regardless of branch name (claude/* or an existing branch via -b).
  local wt_name wt_branch wt_path wt_status wt_instance wt_resume
  while IFS=$'\t' read -r wt_name wt_branch wt_path; do
    wt_instance="${base_instance}-${wt_name}"
    wt_status="stopped"
    if echo "$running_containers" | grep -qE "^claudebot-${wt_instance}-[0-9a-f]+$"; then
      wt_status="running"
    fi
    if [[ "$wt_branch" == claude/* ]]; then
      wt_resume="claude-sandbox --worktree ${wt_branch#claude/} $REPO_PATH"
    else
      wt_resume="claude-sandbox --branch $wt_branch $REPO_PATH"
    fi
    printf "  %-12s %-30s %-10s %s\n" "$wt_name" "$wt_branch" "$wt_status" "$wt_resume"
  done < <(list_tool_worktrees "$REPO_PATH" "$repo_name_safe")

  # Sessions whose worktree is gone but whose data is still on disk
  local suffix
  while IFS= read -r suffix; do
    [[ -n "$suffix" ]] || continue
    printf "  %-12s %-30s %-10s %s\n" "$suffix" "claude/$suffix (orphaned)" "no worktree" "--worktree $suffix recreates it"
  done < <(list_orphan_sessions "$REPO_PATH" "$repo_name_safe" "$SESSIONS_BASE" "$base_instance")

  # Worktrees the agent made for itself, under <repo>/.claude/worktrees. These are
  # NOT sandbox instances: they live inside the (main) session's own workspace and
  # share its instance id, so they have no separate session data and --prune and
  # --rename do not act on them. Listed anyway because the launcher can now leave
  # them behind, and a worktree nothing reports is a worktree nobody cleans up.
  local in_repo_root="$REPO_PATH/.claude/worktrees" p wt_name wt_branch
  if [[ -d "$in_repo_root" ]]; then
    local header_printed=false
    for p in "$in_repo_root"/*; do
      # -e "$p/.git", not just -d "$p": an ordinary directory under here (a
      # leftover, a half-removed worktree) is not a worktree, but `git -C` inside
      # it walks UP to the parent repo and cheerfully reports the main checkout's
      # branch — listing a non-worktree beside a remove command that cannot work.
      [[ -d "$p" && -e "$p/.git" ]] || continue
      wt_name="$(basename "$p")"
      wt_branch="$(git -C "$p" branch --show-current 2>/dev/null || echo "detached")"
      if [[ "$header_printed" == false ]]; then
        echo ""
        echo "  In-repo worktrees (made by the agent; part of the (main) session):"
        header_printed=true
      fi
      printf "  %-12s %-30s %-10s %s\n" "$wt_name" "$wt_branch" "-" "git -C $REPO_PATH worktree remove $p"
    done
  fi

  echo ""
}

if [[ "$LIST_SESSIONS" == true ]]; then
  [[ -z "$REPO_PATH" ]] && usage

  # Resolve short repo names
  REPO_PATH="$(resolve_repo_path "$REPO_PATH")"
  REPO_PATH="$(cd "$REPO_PATH" && pwd)"

  list_sessions
  exit 0
fi

# --- Worktree name completion (called by zsh/bash completion) ---
if [[ "$COMPLETE_WORKTREES" == true ]]; then
  complete_worktree_names
  exit 0
fi


# --- Branch name completion (called by zsh/bash completion) ---
if [[ "$COMPLETE_BRANCHES" == true ]]; then
  complete_branch_names
  exit 0
fi

# --- Rename worktree ---
if [[ "$RENAME_WORKTREE" == true ]]; then
  rename_worktree
  exit 0
fi

# --- Feature detection flags ---
NEEDS_DOCKER=false


# --- Untrusted-repo preflight scan ---
# The repo is untrusted input. Before granting Docker access, scan repo-owned
# compose files and Dockerfile.project for directives that would let a spawned
# container punch through the sandbox (privileged, added caps/devices, relaxed
# security_opt, host net/pid/ipc, or a mounted docker socket). Warn and require
# confirmation. Deliberately noisy — a false positive costs one keypress; a
# miss costs the boundary. Silence with CLAUDE_SANDBOX_NO_OVERRIDE_SCAN=1.
scan_untrusted_compose() {
  [[ "${CLAUDE_SANDBOX_NO_OVERRIDE_SCAN:-}" == "1" ]] && return 0

  local scan_files=()
  while IFS= read -r _f; do
    [[ -n "$_f" ]] && scan_files+=("$_f")
  done < <(find "$REPO_PATH" -maxdepth 2 \
    \( -name 'docker-compose*.yml' -o -name 'docker-compose*.yaml' \
       -o -name 'compose*.yml' -o -name 'compose*.yaml' \
       -o -name 'Dockerfile.project' \) 2>/dev/null)

  [[ ${#scan_files[@]} -eq 0 ]] && return 0

  local pattern='privileged:[[:space:]]*true|cap_add:|devices:|security_opt:|network_mode:[[:space:]]*.?host|pid:[[:space:]]*.?host|ipc:[[:space:]]*.?host|docker\.sock'
  local findings="" _f _m
  for _f in "${scan_files[@]}"; do
    _m="$(grep -nEi "$pattern" "$_f" 2>/dev/null || true)"
    if [[ -n "$_m" ]]; then
      findings+=$'\n'"  ${_f#"$REPO_PATH"/}:"$'\n'"$(printf '%s\n' "$_m" | sed 's/^/    /')"
    fi
  done

  [[ -z "$findings" ]] && return 0

  {
    echo ""
    echo "⚠  Untrusted-repo scan flagged sandbox-boundary directives in this repo's"
    echo "   Docker config. If a container is started with these, it can weaken or"
    echo "   escape the sandbox:"
    echo "$findings"
    echo ""
    echo "   (Silence this check for trusted repos with CLAUDE_SANDBOX_NO_OVERRIDE_SCAN=1)"
  } >&2

  if [[ ! -t 0 ]]; then
    echo "   Non-interactive session — refusing Docker access. Re-run in a terminal" >&2
    echo "   to confirm, or set the silence flag if you trust this repo." >&2
    exit 1
  fi

  local reply
  read -r -p "   Grant Docker access anyway? [y/N] " reply
  if [[ ! "$reply" =~ ^[Yy]$ ]]; then
    echo "   Aborted — Docker access not granted." >&2
    exit 1
  fi
}

# --- Prune worktrees (early exit) ---
if [[ "$PRUNE_WORKTREES" == true ]]; then
  [[ -z "$REPO_PATH" ]] && usage

  REPO_PATH="$(resolve_repo_path "$REPO_PATH")"
  REPO_PATH="$(cd "$REPO_PATH" && pwd)"
  REPO_NAME="$(sanitize_repo_name "$REPO_PATH")"
  REPO_HASH="$(repo_hash "$REPO_PATH")"

  prune_worktrees
  exit 0
fi

# --- GC worktrees (early exit) ---
if [[ "$GC_WORKTREES" == true ]]; then
  [[ -z "$REPO_PATH" ]] && usage

  REPO_PATH="$(resolve_repo_path "$REPO_PATH")"
  REPO_PATH="$(cd "$REPO_PATH" && pwd)"
  REPO_NAME="$(sanitize_repo_name "$REPO_PATH")"
  REPO_HASH="$(repo_hash "$REPO_PATH")"

  gc_worktrees
  exit 0
fi

# --- Ensure a worktree exists and print its path, then exit (early exit) ---
# Reuses setup_worktree() so callers get the exact same
# path/branch and creation behaviour without duplicating it. Info -> stderr; the
# resolved worktree path is the only thing on stdout. No Docker, no cleanup trap.
if [[ "$SETUP_WORKTREE" == true ]]; then
  [[ "$USE_WORKTREE" == true || "$BRANCH_MODE" == true ]] \
    || { echo "Error: --setup-worktree requires -w NAME or -b BRANCH" >&2; exit 1; }
  setup_worktree >&2
  printf '%s\n' "$WORK_PATH"
  exit 0
fi

# --- GC nudge on normal launch ---
check_gc_nudge

# --- Run detection ---
detect_docker_need

# --- Set up worktree if requested ---
if [[ "$USE_WORKTREE" == true && "$GENERATE_ONLY" == false ]]; then
  setup_worktree
fi

# --- Generate Dockerfile if needed ---
mkdir -p "$SANDBOX_DIR/dockerfiles"
if [[ ! -f "$DOCKERFILE" || "$REBUILD" == true || "$GENERATE_ONLY" == true ]]; then
  generate_dockerfile
fi

[[ "$GENERATE_ONLY" == true ]] && exit 0

# Resolve the settings file to mount: sandbox base, with a safe subset of the host
# settings folded in (permissions.deny union + outputStyle/model/enabledPlugins),
# then the optional work overlay merged on top. Resolved HERE rather than at the
# top of the script because it writes a temp file that only the cleanup trap
# (installed further down, on the launch path) removes: every early exit above —
# --list, --prune, --gc, --rename, and the two completion modes zsh calls on each
# TAB — used to leak one $TMPDIR/sandbox-host-*.json per invocation.
SANDBOX_SETTINGS="$("$SANDBOX_DIR/resolve-sandbox-settings.sh" "$SANDBOX_DIR/settings.base.json" "$HOME/.config/claude/sandbox-settings.work.json" "$HOME/.claude/settings.json")"

# --- Ensure base image exists, else refresh Claude Code once per day ---
if ! docker image inspect claudebot:base &>/dev/null; then
  echo "Base image claudebot:base not found — building it now..."
  build_base
  # Base just built — force per-repo rebuild
  REBUILD=true
else
  refresh_claude_if_stale
fi

# --- Build image (skip if already exists and no rebuild requested) ---
BASE_IMAGE_ID="$(docker image inspect --format '{{.Id}}' claudebot:base 2>/dev/null || true)"
if [[ "$REBUILD" != true ]] && built_on_stale_base "$IMAGE_TAG" "$BASE_IMAGE_ID"; then
  echo ""
  echo "Base image moved since $IMAGE_TAG was built — rebuilding it."
  REBUILD=true
fi
if [[ "$REBUILD" == true ]] || ! docker image inspect "$IMAGE_TAG" &>/dev/null; then
  echo ""
  echo "Building $IMAGE_TAG..."
  docker build \
    -f "$DOCKERFILE" \
    -t "$IMAGE_TAG" \
    --label "claudebot.base-id=$BASE_IMAGE_ID" \
    "$SANDBOX_DIR"
else
  echo ""
  echo "Using cached $IMAGE_TAG (use --rebuild to force)"
fi

# --- Run container ---
resolve_session_context

# Build docker run args
# Headless --exec pipes container stdout to a filter, so no TTY (-t); -i keeps stdin open.
TTY_FLAGS=(-it)
[[ "$EXEC_MODE" == true ]] && TTY_FLAGS=(-i)
DOCKER_ARGS=(
  --rm "${TTY_FLAGS[@]}"
  ${ENGINE_ARGS[@]+"${ENGINE_ARGS[@]}"}
  --name "claudebot-$RUN_ID"
  --cap-drop all
  --security-opt no-new-privileges
  --group-add 0
  --memory 8g
  --cpus 4
  --pids-limit 512
  -v "$WORK_PATH:/workspace"
  -v "$AUDIT_DIR:/audit"
  -v "$ARTIFACTS_DIR:/artifacts"
  -e "CLAUDE_ARTIFACTS_HOST_DIR=$ARTIFACTS_DIR"
  # No ARTIFACT_DIR here. It pointed suggest-artifact.sh at the container's host-backed
  # bind-mount, and that hook is gone (2026-08-21) — nothing else ever read the variable.
  -v "$STATE_DIR:/home/claudebot/.claude"
  # Host source of the ~/.claude bind-mount, so link-artifact.sh can turn an artifact
  # written under ~/.claude/artifacts into a clickable host file:// link (not /home/...).
  -e "CLAUDE_STATE_HOST_DIR=$STATE_DIR"
  -v "$SESSIONS_DIR:/home/claudebot/.claude/projects"
  # Per-instance, layered over the shared $STATE_DIR mount above (see PRIVATE_BASE).
  # These three are the only parts of ~/.claude that carry CONTENT from one repo's
  # work: the prompt history, the pre-edit file snapshots, and the captured shell
  # environments. Pooling them let a session in one repo read another's.
  -v "$PRIVATE_DIR/history.jsonl:/home/claudebot/.claude/history.jsonl"
  -v "$PRIVATE_DIR/file-history:/home/claudebot/.claude/file-history"
  -v "$PRIVATE_DIR/shell-snapshots:/home/claudebot/.claude/shell-snapshots"
  -v "$HOME/.claude/plugins:/home/claudebot/.claude/plugins:ro"
  -v "$HOME/.claude/plugins:$HOME/.claude/plugins:ro"
  # User-level commands and agents (read-only). Nested mounts inside the
  # state volume, like plugins above. Makes personal slash commands (e.g.
  # /review-loop) and subagents (e.g. implementer) available in every repo.
  -v "$HOME/.claude/commands:/home/claudebot/.claude/commands:ro"
  -v "$HOME/.claude/agents:/home/claudebot/.claude/agents:ro"
  # Config files — bind-mounted (not baked into image) so edits don't
  # bust the Docker layer cache for toolchain installs.
  #
  # settings.json, every hook, and the statusline script are mounted READ-ONLY
  # AT THEIR LIVE PATHS, not staged in ~/.claude-defaults for entrypoint.sh to
  # copy. settings.base.json sets defaultMode:bypassPermissions and the image
  # launches with --dangerously-skip-permissions, so the deny-list plus these
  # hooks ARE the whole boundary — and ~/.claude is the read-write $STATE_DIR
  # bind mount. Copying them there left the agent able to overwrite its own
  # permission policy and stub out every guard hook (`echo 'exit 0' > …`), since
  # the settings hook entries name absolute paths that are re-read from disk on
  # each tool call. A :ro mount point can't be rewritten, chmod'd, or
  # deleted-and-recreated. Nested mounts inside the state volume, same as
  # plugins/commands/agents above; the auth container already does this for
  # settings.json.
  -v "$SANDBOX_SETTINGS:/home/claudebot/.claude/settings.json:ro"
  -v "$SANDBOX_DIR/audit.sh:/home/claudebot/.claude/hooks/audit.sh:ro"
  # Sandbox-only: scopes gh pr create/edit/comment/ready to $SANDBOX_BRANCH. Never
  # mounted on the host, so host gh pr behavior is unaffected.
  -v "$SANDBOX_DIR/gh-pr-guard.sh:/home/claudebot/.claude/hooks/gh-pr-guard.sh:ro"
  # These hooks have no sandbox-specific variant — mount the single canonical host
  # copy (one source of truth, no drift-prone parallel copy). link-artifact reads
  # CLAUDE_ARTIFACTS_HOST_DIR (set above) so the one file works host and container.
  # screen-injection, guard-pre-tool-use and protect-secrets add in-container
  # defense-in-depth (injection screening; deny secret reads/writes, disk wipes, fork
  # bombs, pipe-to-shell) beyond what the settings deny-list covers.
  #
  # guard-pre-tool-use.sh replaced block-dangerous-bash.sh here: the shim is a few lines of
  # bash over the claude-guard package, so the package directory is mounted beside it. The
  # shim reads SHARE="${CLAUDE_GUARD_HOME:-$HOME/.local/share/claude-guard}", so this target
  # path is what makes the default resolve inside the container. Both are deployed chezmoi
  # targets on the host, mounted the same way the hooks are, and :ro for the reason the
  # comment above gives — a guard the agent it fences can rewrite is no guard, and the
  # package is the half of this control that holds the rules.
  -v "$HOME/.claude/hooks/link-artifact.sh:/home/claudebot/.claude/hooks/link-artifact.sh:ro"
  -v "$HOME/.claude/hooks/screen-injection.sh:/home/claudebot/.claude/hooks/screen-injection.sh:ro"
  -v "$HOME/.claude/hooks/guard-pre-tool-use.sh:/home/claudebot/.claude/hooks/guard-pre-tool-use.sh:ro"
  -v "$HOME/.local/share/claude-guard:/home/claudebot/.local/share/claude-guard:ro"
  -v "$HOME/.claude/hooks/protect-secrets.sh:/home/claudebot/.claude/hooks/protect-secrets.sh:ro"
  # CLAUDE.md is the one managed file that stays staged-and-copied: entrypoint.sh
  # appends the dynamic environment context to it, so it has to be writable.
  # It is instructions, not policy or executable code.
  -v "$SANDBOX_DIR/sandbox-CLAUDE.md:/home/claudebot/.claude-defaults/CLAUDE.md:ro"
  # No sandbox-specific variant — mount the single canonical host copy (one source
  # of truth, no drift-prone parallel copy). The host script is a superset and
  # degrades gracefully in-container (bc/stat/date fallbacks all guarded).
  -v "$HOME/.claude/statusline-command.sh:/home/claudebot/.claude/statusline-command.sh:ro"
  -v "$SANDBOX_DIR/entrypoint.sh:/usr/local/bin/entrypoint.sh:ro"
  # Read-only git identity (see sandbox/gitconfig). Mounted :ro so a compromised
  # session can neither rewrite credential.helper/core.hooksPath/url.insteadOf
  # nor delete-and-recreate the file — a mount point survives what a chmod'd
  # file in the agent-writable $HOME would not.
  -v "$SANDBOX_DIR/gitconfig:/home/claudebot/.gitconfig:ro"
  -e SANDBOX_REPO_NAME="$REPO_NAME"
  -e SANDBOX_TOOLCHAINS="$TOOLCHAIN_LIST"
  # Turns guard-pre-tool-use.sh's unevaluable-rules path from `ask` into `deny` + exit 2.
  # Required here and not on the host: the container launches with
  # --dangerously-skip-permissions, under which an ask is skipped, so the shim's host
  # posture is a silent fail-open in a container missing uv, the managed 3.14 or the package.
  # Set as a docker env var rather than only in settings.base.json's `env` block, because
  # nothing measured shows a settings `env` value reaching a hook subprocess — and the whole
  # point of this switch is the case where the guard cannot run. settings.base.json carries
  # it too, as the second place, and tests/sandbox/sandbox-settings-base.test.js pins both.
  -e CLAUDE_GUARD_FAIL_CLOSED=1
)

add_host_integration_mounts
add_vault_mounts
add_chezmoi_mount
add_work_config_mount

# --- User skills — mounted read-only in EVERY session so general-purpose skills
# (prep, artifact-design, gh-stack, config-lint, …) work in any sandbox, not just
# vault ones. Skills that need the vault (vault-lookup/service-context) simply
# no-op where it isn't mounted.
if [[ -d "$HOME/.claude/skills" ]]; then
  DOCKER_ARGS+=(-v "$HOME/.claude/skills:/home/claudebot/.claude/skills:ro")
fi

# --- Sibling repos (read-only, on demand) ---
# Expose OTHER local repos under ~/Repositories so the agent can read cross-repo
# context (interfaces, call sites, shared contracts) without them being named in
# advance. Default: a clean snapshot of each repo's main/master (tracked files
# only), which strips dirty working trees, build artifacts, and unmerged
# feature-branch changes. Snapshots are cached by commit SHA, so only repos whose
# main advanced since the last launch are re-archived. Nothing is preloaded — the
# entrypoint adds a one-line CLAUDE.md pointer. --repos-live binds live working
# trees as-is; --no-repos disables. Bind mounts add nothing to the image.
REPOS_ROOT="$HOME/Repositories"
REPO_SNAPSHOT_ROOT="$SANDBOX_DIR/repo-snapshots"

add_sibling_repo_mounts

add_vault_self_hardening

# --- Warn if the workspace looks like the vault but its features are OFF ---
# The vault mount, chezmoi mount, and read-only overlays all key off
# CLAUDE_VAULT_DIR; if it is unset or doesn't match, they silently no-op.
if [[ -f "$REPO_PATH/index.md" && -f "$REPO_PATH/log.md" && -d "$REPO_PATH/raw" ]]; then
  vault_features_on=false
  if [[ -n "${CLAUDE_VAULT_DIR:-}" ]]; then
    case "$REPO_PATH/" in "$CLAUDE_VAULT_DIR"/*) vault_features_on=true ;; esac
  fi
  if [[ "$vault_features_on" == false ]]; then
    echo "  Note: workspace looks like the vault but CLAUDE_VAULT_DIR${CLAUDE_VAULT_DIR:+=$CLAUDE_VAULT_DIR} does not match it — vault-context, chezmoi, and read-only overlays are OFF this run." >&2
  fi
fi

# Forward API key only when OAuth is not configured (they conflict)
if [[ -n "${ANTHROPIC_API_KEY:-}" && ! -f "$AUTH_MARKER" ]]; then
  DOCKER_ARGS+=(-e ANTHROPIC_API_KEY)
fi

# .git holds two things the HOST's git executes: hooks/ and config (core.fsmonitor,
# aliases, core.hooksPath). Both are plain file writes needing no `git config` call,
# so a writable gitdir is host code execution the next time Daniel runs any git
# command in that repo. Re-mount just those two :ro — objects/, refs/, index and
# logs/ stay writable, so commits still work.
#
# GIT_RO_PREFIX is where the container sees the gitdir, which differs by path:
# a worktree run mounts the main repo's .git at its own HOST path (below), while
# a plain-repo run reaches it through the /workspace mount of the checkout. This
# guard used to be inside the worktree branch and so covered only the first —
# leaving the plain-repo path, which is the ordinary invocation, with a fully
# writable .git/hooks. Worktrees share $GIT_COMMON_DIR/hooks, so a worktree the
# agent creates for itself inherits the :ro mount rather than escaping it.
if [[ "$USE_WORKTREE" == true && -n "$WT_BRANCH" ]]; then
  DOCKER_ARGS+=(-e SANDBOX_BRANCH="$WT_BRANCH")
  # Worktree .git points into the main repo; mount it so in-container git
  # resolves the gitdir + shared object store (read-write enables commits).
  DOCKER_ARGS+=(-v "$REPO_PATH/.git:$REPO_PATH/.git")
  GIT_RO_PREFIX="$REPO_PATH/.git"
else
  GIT_RO_PREFIX="/workspace/.git"
fi
# Nested mounts, so Docker layers them over the writable gitdir.
# if/then, not &&: under set -e a false test at statement level exits the script.
if [[ -d "$REPO_PATH/.git/hooks" ]]; then
  DOCKER_ARGS+=(-v "$REPO_PATH/.git/hooks:$GIT_RO_PREFIX/hooks:ro")
fi
if [[ -f "$REPO_PATH/.git/config" ]]; then
  DOCKER_ARGS+=(-v "$REPO_PATH/.git/config:$GIT_RO_PREFIX/config:ro")
fi

configure_gh_auth
declare -f configure_snowflake_auth >/dev/null && configure_snowflake_auth

# Start Docker socket proxy if needed
if [[ "$NEEDS_DOCKER" == true ]]; then
  scan_untrusted_compose
  start_proxy
  DOCKER_ARGS+=(
    --network "$NETWORK_NAME"
    -e DOCKER_HOST="tcp://$FILTER_ALIAS:2375"
    -e HOST_REPO_PATH="$WORK_PATH"
  )
  echo "  Docker: via create-filter -> socket proxy (bodies inspected; exec/build/commit blocked)"
else
  echo "  Docker: not needed (no compose files detected)"
fi

echo ""

run_oauth_if_needed
declare -f run_snowflake_oauth_if_needed >/dev/null && run_snowflake_oauth_if_needed

# Remove stale container from a previous run (--rm only cleans up on normal exit)
if docker inspect "claudebot-$RUN_ID" &>/dev/null; then
  echo "Stopping existing sandbox for $RUN_ID..."
  docker rm -f "claudebot-$RUN_ID" >/dev/null
fi

# --- Cleanup on exit ---
trap cleanup EXIT

# Front-load the 1Password unlock/authorize prompt so the container (which can't
# pop a GUI prompt) starts with a signing-capable agent. No-op off-work: the
# helper ships only via work-laptop-config. Absolute path — leaner PATH here.
OP_ENSURE="$HOME/.local/bin/op-ssh-ensure"
if [[ -S "$OP_SOCKET" && -x "$OP_ENSURE" ]]; then
  echo "Ensuring 1Password signing key is available (approve any prompt)…"
  SSH_AUTH_SOCK="$OP_SOCKET" "$OP_ENSURE" --timeout 20 \
    || echo "  Warning: signing key not confirmed — commits inside the sandbox may fail to sign until you unlock 1Password." >&2
fi

# --continue resolves against the container's cwd (/workspace), so it reaches only a
# conversation held there. resolve_session_context sets RESUME_SESSION_ID when the
# transcript it found belongs to a worktree the agent made for itself, whose project
# slug is not "-workspace"; that one has to be resumed by id.
append_resume_args() {
  [[ "$RESUME_SESSION" == true ]] || return 0
  if [[ -n "${RESUME_SESSION_ID:-}" ]]; then
    CLAUDE_ARGS+=(--resume "$RESUME_SESSION_ID")
  else
    CLAUDE_ARGS+=(--continue)
  fi
}

if [[ "$SHELL_MODE" == true ]]; then
  # Standalone hardened shell: same container/mounts as a Claude session, but bash
  # instead of claude. entrypoint.sh's `exec "$@"` runs it after the usual setup.
  echo "Warning: this shell is UNAUDITED — commands run here are not logged to /audit" >&2
  echo "         (only Claude's tool calls are)." >&2
  CLAUDE_ARGS=(bash -l)
elif [[ "$EXEC_MODE" == true ]]; then
  # Headless implementer for orchestrator-dispatched work. The full stream-json trace is
  # tee'd to /audit; exec-stream.py renders readable progress to stderr and the clean final
  # result to stdout between <<<EXEC_RESULT>>> markers. entrypoint.sh's `exec "$@"` runs it.
  CLAUDE_ARGS=(claude -p "$EXEC_PROMPT" --dangerously-skip-permissions --output-format stream-json --verbose)
  append_resume_args
  EXEC_LOG="$AUDIT_DIR/exec-$RUN_ID.jsonl"
  echo "Dispatching headless implementer (trace: $EXEC_LOG)…" >&2
  relabel_docker_args
  if docker run "${DOCKER_ARGS[@]}" "$IMAGE_TAG" "${CLAUDE_ARGS[@]}" \
       | tee "$EXEC_LOG" \
       | python3 "$SANDBOX_DIR/exec-stream.py"; then
    EXEC_RC=0
  else
    EXEC_RC=$?
  fi
  echo "Full trace: $EXEC_LOG" >&2
  exit "$EXEC_RC"
else
  # Command mirrors the image default CMD (Dockerfile.base) so overriding it to
  # append --continue keeps the same base invocation. entrypoint.sh's `exec "$@"`
  # runs it as-is.
  CLAUDE_ARGS=(claude --dangerously-skip-permissions)
  append_resume_args
fi



relabel_docker_args
docker run "${DOCKER_ARGS[@]}" "$IMAGE_TAG" "${CLAUDE_ARGS[@]}"

      "mcp__claude_ai_Sentry__authenticate",
      "mcp__claude_ai_Sentry__complete_authentication",

      "mcp__claude_ai_Privacy_MCP__authenticate",
      "mcp__claude_ai_Privacy_MCP__complete_authentication",

      "mcp__grafana__create_*",
      "mcp__grafana__update_*",
      "mcp__grafana__alerting_manage_*",
      "mcp__grafana__add_*",
      "mcp__grafana__install_*"
    ]
  },
  "tui": "fullscreen",
  "editorMode": "normal",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/claudebot/.claude/hooks/audit.sh"
          }
        ]
      }
    ]
  },
  "cleanupPeriodDays": 7,
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "lpt-pr-curator@processing-llm": true,
    "lpt-dependabot-reviewer@processing-llm": true,
    "lpt-network-specs@processing-llm": true,
    "privacy-eng-tools@privacy-skills": true
  },
  "extraKnownMarketplaces": {
    "processing-llm": {
      "source": {
        "source": "github",
        "repo": "privacy-com/processing-llm"
      }
    },
    "privacy-skills": {
      "source": {
        "source": "github",
        "repo": "privacy-com/claude-skills"
      }
    }
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  }
}

      "Bash(python -c:*)",
      {{/* A hand-run playbook is a real deploy on the homelab server repo, bypassing that
           repo's scripts/deploy.sh and the lock it takes. These three prefix forms
           (bare, uv run, and uv run --frozen) used to be reached only by accident: the
           uv-python.sh hook prepended an inline `python3 -c '...'` stdio fixup ahead of
           every ansible-playbook invocation, and that prefix matched the
           `Bash(python3 -c:*)` ask rule above, so the whole compound command prompted
           regardless of what followed it. Moving that fixup out to the standalone
           stdio-blocking script above removes the accidental guard, so it is named
           explicitly here instead — the posture on a hand-run playbook must not change
           just because the prefix in front of it did. claude_guard's ansible_readonly_safe()
           narrows this back to unprompted for the genuinely read-only invocation shapes
           (--check, --list-tasks, --list-tags, --list-hosts, --syntax-check with no
           file-valued -e/--extra-vars); everything else still asks. */}}
      "Bash(ansible-playbook:*)",
      "Bash(uv run ansible-playbook:*)",
      "Bash(uv run --frozen ansible-playbook:*)",
      "Bash(npx -y:*)",
      "Bash(npx --yes:*)",
      "Bash(npx -c:*)",
      "Bash(npx --package:*)",
      "Bash(npx --package=*)",
      {{/* -p is the documented short form of --package and fetches an arbitrary package the
           same way; only the long form was listed, while Bash(npx:*) allows the rest. Same
           short-vs-long gap as the `gh auth status -t` / `--show-token` pair above. These
           are prefix rules, so they catch the flag in first position — `npx -y -p pkg` is
           still reached by the -y rule, but a flag order that leads with neither is not
           covered, which is a limit of prefix matching rather than of this entry. */}}
      "Bash(npx -p:*)",
      "Bash(npx -p=*)",
      {{/* The destructive four. These silently destroy work that is NOT in git — uncommitted
           edits, untracked files — which no reflog, no checkpoint and no classifier can bring
           back, so they stay the one Bash tier worth stopping on. Note the cover is PARTIAL:
           a compound like `rm -rf /tmp/x; (...)` was observed running unprompted while a bare
           `rm` prompted, so treat these as a speed bump, not a guarantee. Anything that must
           NEVER run belongs in deny, which is evaluated before both the ask tier and the
           classifier. */}}
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      {{/* Branch-level git is deliberately NOT here any more: checkout/switch/rebase/merge/
           cherry-pick/branch -D/worktree remove are all reflog-recoverable, they were ~27
           prompts a week, and every one of them was approved. Worktree lifecycle in particular
           has to be prompt-free — sessions create, enter and clean up their own worktrees, so a
           prompt there stalls an unattended run for no decision anyone was going to make. */}}
      {{/* stash pop/drop/clear survive the cull for a reason the classifier cannot know: the
           stash stack is SHARED across every worktree and parallel session on this machine, so
           a pop or drop can silently take another session's entry. `push` and `apply` are not
           destructive and are gone. */}}
      "Bash(git stash pop:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear)",
      {{/* `gh pr merge` left this list on 2026-10-11. An ask entry beats every allow entry, so
           it would have kept `gh pr merge --auto` prompting too. See the allow entry above. */}}
      "Bash(gh api *-X POST*)",
      "Bash(gh api *-X PUT*)",
      "Bash(gh api *-X PATCH*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *--method POST*)",
      "Bash(gh api *--method PUT*)",
      "Bash(gh api *--method PATCH*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--input *)",
      "Bash(gh api graphql*)",
      "Bash(gh api */graphql*)",
      {{/* Docker writes prompt. The package-manager and docker install/run rules that sat here
           were removed for firing zero times in a homelab week, and dependency installs still
           go through uv/prek. Docker came back with the work laptop: 30 days of transcripts on
           2026-10-22 held compose up/down/exec, run, rm and pull, and with docker unsandboxed
           (excludedCommands) the auto-mode classifier was the only thing in front of them.
           An ask rule still forces a prompt in auto mode (code.claude.com permission-modes:
           "explicit ask rules still force a prompt"), so this list is what moves them off the
           classifier. The prompt-free path is dockrun, allowed above, which applies a policy
           a prefix rule cannot.

           Rules match per segment of a compound command, and `*` spans spaces. Three shapes:
           the bare verb; any global flag before the verb (`docker -H x run`, `docker --context
           y ...`), which also makes `docker --version` prompt; and compose with flags before
           its verb, which is how most real compose calls are spelled (`docker compose -p x -f
           a.yml up -d`). The flag-first compose globs can also catch a read whose argument
           contains a verb word, such as `logs upstream`; dockq covers compose ps/logs without
           a prompt. Reads behind a write noun (`docker image ls`, `docker network ls`) prompt
           too. */}}
      "Bash(docker run:*)",
      "Bash(docker exec:*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)",
      "Bash(docker pull:*)",
      "Bash(docker push:*)",
      "Bash(docker build:*)",
      "Bash(docker buildx:*)",
      "Bash(docker builder:*)",
      "Bash(docker create:*)",
      "Bash(docker start:*)",
      "Bash(docker stop:*)",
      "Bash(docker restart:*)",
      "Bash(docker kill:*)",
      "Bash(docker pause:*)",
      "Bash(docker unpause:*)",
      "Bash(docker attach:*)",
      "Bash(docker cp:*)",
      "Bash(docker commit:*)",
      "Bash(docker update:*)",
      "Bash(docker rename:*)",
      "Bash(docker tag:*)",
      "Bash(docker load:*)",
      "Bash(docker import:*)",
      "Bash(docker save:*)",
      "Bash(docker login:*)",
      "Bash(docker logout:*)",
      "Bash(docker context:*)",
      "Bash(docker container:*)",
      "Bash(docker image:*)",
      "Bash(docker volume:*)",
      "Bash(docker network:*)",
      "Bash(docker system:*)",
      "Bash(docker plugin:*)",
      "Bash(docker swarm:*)",
      "Bash(docker service:*)",
      "Bash(docker stack:*)",
      "Bash(docker secret:*)",
      "Bash(docker node:*)",
      "Bash(docker trust:*)",
      "Bash(docker checkpoint:*)",
      "Bash(docker init:*)",
      "Bash(docker debug:*)",
      "Bash(docker manifest create:*)",
      "Bash(docker manifest push:*)",
      "Bash(docker manifest annotate:*)",
      "Bash(docker manifest rm:*)",
      "Bash(docker -*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose run:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose rm:*)",
      "Bash(docker compose pull:*)",
      "Bash(docker compose push:*)",
      "Bash(docker compose build:*)",
      "Bash(docker compose create:*)",
      "Bash(docker compose start:*)",
      "Bash(docker compose stop:*)",
      "Bash(docker compose restart:*)",
      "Bash(docker compose kill:*)",
      "Bash(docker compose pause:*)",
      "Bash(docker compose unpause:*)",
      "Bash(docker compose attach:*)",
      "Bash(docker compose cp:*)",
      "Bash(docker compose scale:*)",
      "Bash(docker compose watch:*)",
      "Bash(docker compose publish:*)",
      "Bash(docker compose commit:*)",
      "Bash(docker compose export:*)",
      "Bash(docker compose -* up*)",
      "Bash(docker compose -* down*)",
      "Bash(docker compose -* run*)",
      "Bash(docker compose -* exec*)",
      "Bash(docker compose -* rm*)",
      "Bash(docker compose -* pull*)",
      "Bash(docker compose -* push*)",
      "Bash(docker compose -* build*)",
      "Bash(docker compose -* create*)",
      "Bash(docker compose -* start*)",
      "Bash(docker compose -* stop*)",
      "Bash(docker compose -* restart*)",
      "Bash(docker compose -* kill*)",
      "Bash(docker compose -* pause*)",
      "Bash(docker compose -* unpause*)",
      "Bash(docker compose -* attach*)",
      "Bash(docker compose -* cp*)",
      "Bash(docker compose -* scale*)",
      "Bash(docker compose -* watch*)",
      "Bash(docker compose -* publish*)",
      "Bash(docker compose -* commit*)",
      "Bash(docker compose -* export*)",
      "Bash(docker-compose:*)",
      {{/* curl/ssh/scp/sftp/rsync/wget were the single biggest source of prompts (~80 a week,
           all approved) and they are gone from this tier on purpose. A prefix rule could never
           narrow them — `Bash(curl http://10.0.0.161/:*)` constrains nothing after the URL, so
           `curl http://10.0.0.161/x -o ~/.ssh/authorized_keys` would have matched it — which is
           exactly the discrimination the auto-mode classifier CAN make, reading the whole line
           against the trusted hosts and domains named in autoMode.environment.

           Consequence worth knowing: an ask rule is what routes a call through the
           PermissionRequest hooks, so claude_guard's curl_safe() / readonly_remote_safe()
           no longer fast-path these in auto mode — the classifier does. claude_guard's checks are retained because they still carry Manual mode,
           where no classifier runs (curl_safe/readonly_remote_safe ran as the standalone
           bash hooks allow-safe-curl.sh/allow-readonly-remote.sh until claude-guard slice 3
           deleted them and moved the same decision into guard-permission-request.sh). */}}
      {{/* the hooks are this config's own enforcement layer — never editable without a prompt (Edit rules also cover Write) */}}
      "Edit(~/.claude/hooks/**)",
      {{/* The deployed claude-guard package is the other half of that layer: deny.py holds the
           Bash deny rules and secret_paths.json the secret table they are built from. Without
           this, a plain Edit or Write there removed a Bash-side secret deny with no prompt,
           while the hook beside it asked. Sessions edit the chezmoi source, not this copy, and
           chezmoi apply does not go through the file tools, so neither prompts. */}}
      "Edit(~/.local/share/claude-guard/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)"
    ],
    "defaultMode": "auto"
  }

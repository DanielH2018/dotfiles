{{- $work := promptBoolOnce . "work" "Is this a work machine" false -}}
{{- $profile := promptStringOnce . "profile" "Machine profile (workstation/server/minimal)" "workstation" -}}
{{- if not (has $profile (list "workstation" "server" "minimal")) -}}
{{-   fail (printf "chezmoi: invalid profile %q (must be one of: workstation, server, minimal)" $profile) -}}
{{- end -}}
# Pin umask so target file modes are deterministic regardless of the login shell's
# umask (this server runs umask 0007, which would otherwise make chezmoi want 0660).
umask = 0o022

[data]
    work = {{ $work }}
    # workstation|server = full tooling; minimal = resource-constrained host (e.g. the Pi),
    # opts out of the heavy Linux CLI-tool install. Any value other than "minimal" gets tools.
    profile = {{ $profile | quote }}
# Run the /bin/sh modify_ script through bash on every OS. The source is named
# modify_settings.json.sh.tmpl so chezmoi strips the .sh extension (the target
# stays settings.json) and runs it via this interpreter. Windows has no shebang
# support; on macOS/Linux bash runs the /bin/sh script identically.
[interpreters.sh]
    command = "bash"
# Windows defaults to the Restricted execution policy, so chezmoi's default
# invocation (`powershell -NoLogo <script>`) fails the os-windows .chezmoiscripts
# with "running scripts is disabled on this system". Bypass it per-process rather
# than loosening the machine policy — same flags the repo's own .ps1 launchers use
# (run_onchange_install-nerd-font, the WSL interop-reaper installer). `powershell`,
# not `pwsh`: on a fresh box pwsh isn't installed until these scripts run.
[interpreters.ps1]
    command = "powershell"
    args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]

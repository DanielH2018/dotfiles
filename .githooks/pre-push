#!/usr/bin/env bash
#
# pre-push — fast, offline, deterministic gate for behavior-affecting config.
#
# Runs fast, offline checks: no network, no LLM, no token spend. The slow,
# non-deterministic LLM eval suite is deliberately NOT here — run it by hand
# when you actually change an agent definition:
#
#     node evals/run-evals.mjs --agent <name>      # scoped
#     node evals/run-evals.mjs                      # full k=5 soak
#
# Bypass once (rarely, e.g. WIP push): git push --no-verify
#
# Checks:
#   1. commit signatures    — every commit this push adds must carry a signature.
#                             commit.gpgsign is only a default; nothing enforced it, and
#                             173 of this repo's 607 commits do not verify as a result.
#   2. config-soak status   — every behavior-affecting config change must be
#                             reviewed and `config-soak land`ed before push.
#   3. instruction quality  — security dimension is a hard gate (>=70) on the
#                             agent / skill / CLAUDE instruction files; the
#                             composite floor is a soft ratchet (QUALITY_MIN_SCORE,
#                             default 45 — raise it as the files improve).
#   4. screen-injection     — red-team regression guard on the injection hook.
#   5. unit tests           — the deterministic `node --test` suite (hooks, config-soak,
#                             settings merge, dotsync, evals lib); offline, self-skips the
#                             chezmoi-template tests when chezmoi isn't installed.
#
# Both test steps print a tq digest rather than the runner's own log — see
# tq_node below. TQ_OFF=1 git push restores the raw output.
#
# Kept bash-3.2 clean (macOS default bash): no mapfile / associative arrays.

set -u

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

# Git exports GIT_DIR/GIT_PREFIX (and friends) into its hooks. Anything below that
# shells out to git in a temp directory — several tests build throwaway repos — would
# otherwise operate on THIS repo instead of their own fixture, so the suite fails under
# the hook while passing when run by hand. Drop them now that ROOT is resolved.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR \
      GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH \
      GIT_CONFIG_PARAMETERS GIT_REFLOG_ACTION

# Colors only when stdout is a terminal.
if [ -t 1 ]; then
  B=$'\033[1m'; G=$'\033[32m'; R=$'\033[31m'; Z=$'\033[0m'
else
  B=''; G=''; R=''; Z=''
fi

fail=0
run() { # run "<label>" <cmd...>
  label="$1"; shift
  printf '\n%s▶ %s%s\n' "$B" "$label" "$Z"
  if "$@"; then
    printf '%s✓ %s%s\n' "$G" "$label" "$Z"
  else
    rc=$?
    printf '%s✗ %s (exit %d)%s\n' "$R" "$label" "$rc" "$Z"
    fail=1
  fi
}

# node --test relays a line per test: ~65KB / 680 lines on a run where nothing
# is wrong, which is the bulk of everything this gate prints. tq collapses that
# to a one-line verdict, and on failure to the failures alone — file:line, the
# assertion, the failing test's output — plus a json path holding the untrimmed
# record. It re-exports the runner's exit code verbatim (bin/tq returns
# result.exit; no adapter assigns to it), so `run` above still branches on
# node's own verdict. tq decides what gets printed, never what passes.
#
# Resolved from the repo, not from PATH: a gate should exercise the tq being
# pushed, and this has to work in a clone where `chezmoi apply` has not run.
# Falls back to the raw runner when tq or python3 is absent, or on TQ_OFF=1 —
# tq buffers, so a long suite says nothing until it finishes.
TQ="$ROOT/home/dot_local/bin/executable_tq"
if [ -z "${TQ_OFF:-}" ] && [ -f "$TQ" ] && command -v python3 >/dev/null 2>&1; then
  TQ_HOME="$ROOT/home/dot_local/share/tq"
  export TQ_HOME
  # --absolute-git-dir, not $ROOT/.git: in a worktree that is a file, not a
  # directory. Absolute because TQ_JSON is a path some other process may resolve
  # from a cwd of its own; --git-path answers relatively in the main checkout.
  # Pinning TQ_JSON also stops tq's mkstemp default littering /tmp with a
  # never-read record on every green push.
  TQ_JSON_DIR="$(git rev-parse --absolute-git-dir)/tq"
  mkdir -p "$TQ_JSON_DIR" || TQ_JSON_DIR=""
  # shellcheck disable=SC2329  # invoked indirectly, as `run <label> tq_node ...`
  tq_node() { # tq_node <json-name> [node --test args...]
    name="$1"; shift
    TQ_JSON="${TQ_JSON_DIR:+$TQ_JSON_DIR/$name.json}" python3 "$TQ" node --test "$@"
  }
else
  # shellcheck disable=SC2329  # invoked indirectly, as `run <label> tq_node ...`
  tq_node() { shift; node --test "$@"; }
fi

# 1. Commit signatures. Reads git's pre-push protocol from stdin, so it has to come
#    before anything else that might consume it. Unsigned/bad/revoked fail; signed but
#    unverifiable (signer absent from allowed_signers) warns — SIGN_GATE_STRICT=1 to
#    demand a good signature outright.
run "commit signatures" bin/check-push-signatures

# 2. Deterministic review/soak ledger — no LLM, no judgement.
run "config-soak (review ledger)" node bin/config-soak status

# 3. Instruction-file quality. Security gate (>=70) is always enforced by
#    `verify`; the composite floor is a ratchet pinned to today's worst file, so
#    any regression below the current baseline blocks the push. rules/python.md
#    and rules/rust.md both score 52 and set the floor; 53 fails. Raise this as
#    those files improve — a floor below the true minimum is slack, not a gate.
QUALITY_MIN_SCORE="${QUALITY_MIN_SCORE:-52}"
QFILES=$(ls home/private_dot_claude/agents/*.md \
            home/private_dot_claude/skills/*/SKILL.md \
            home/private_dot_claude/rules/*.md \
            home/private_dot_claude/CLAUDE.md.tmpl 2>/dev/null)
if [ -n "$QFILES" ]; then
  # shellcheck disable=SC2086  # word-split intended; these paths have no spaces
  run "instruction quality (security>=70; composite>=${QUALITY_MIN_SCORE})" \
    python3 quality/instruction_quality.py verify $QFILES --min-score "$QUALITY_MIN_SCORE"
fi

# 4. Injection-hook red-team regression guard. Run through --test rather than as
#    a bare script so the digest covers it too; the file is a node:test suite
#    either way, and step 5's glob picks it up as well — it stays a named step so
#    a red-team regression is attributed instead of buried in the suite total.
run "screen-injection red-team" tq_node injection tests/screen-injection.test.js

# 5. Deterministic unit suite — hooks, config-soak, settings merge, dotsync, evals lib.
#    Fast + offline; the chezmoi-template tests self-skip when chezmoi isn't installed.
run "unit tests (node --test)" tq_node unit

if [ "$fail" -ne 0 ]; then
  printf '\n%spre-push blocked.%s Fix the above, or bypass once: git push --no-verify\n' "$R" "$Z" >&2
  exit 1
fi
printf '\n%spre-push checks passed.%s\n' "$G" "$Z"
exit 0

#!/usr/bin/env python3
"""dockq — read Docker state without a prompt, and never change it.

Exists for the same reason as `jsonq`, `otelq` and `ghread`. `docker` cannot
run in the sandbox (it cannot reach its socket or ~/.docker/config.json), so
every useful call runs unsandboxed, where an allow rule is the only gate. A
blanket `Bash(docker:*)` would grant `run`, `exec` and `rm`, and even the
read verbs leak: an unformatted `docker inspect` prints a container's
Config.Env, which is where compose stacks keep their secrets. claude-guard
denies that form (deny.py `docker_inspect`), and it denies it by pattern on the
command text, which a caller-supplied `--format` can step around with `index`
or `range`.

What makes a blanket `Bash(dockq:*)` allow rule defensible is construction:

  - The verbs are a closed set of reads. No `run`, `exec`, `rm`, `stop`,
    `pull`, `build` or `compose up/down` exists here to be reached.
  - `inspect` takes no template from the caller. It renders a fixed menu of
    fields, none of which is `.Config.Env` or an ancestor of it.
  - `logs` is bounded: `--tail` is required to be 1..5000, never `all`.
  - A container, service or image name must not start with `-` and sits after
    `--`, so no caller text can become a docker flag.

  dockq ps --all
  dockq logs claude-otel-loki-1 --tail 200 --since 30m
  dockq inspect claude-otel-loki-1 --field state --field ports
  dockq compose -p claude-otel logs loki --tail 100
  dockq manifest inspect grafana/loki:3.4.2

docker's exit status is dockq's exit status. A refusal dockq raises itself
exits 2.
"""

from __future__ import annotations

import argparse
import re
import shutil
import subprocess
import sys

PROG = "dockq"

# A container, service or project name, or an image reference with a tag or
# digest. The first character class is what keeps a value from reading as a flag.
_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
_IMAGE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/:@-]*$")
_SINCE = re.compile(r"^[0-9]+[smh]$")

MAX_TAIL = 5000

# The only templates `inspect` ever sends, as field -> Go template path. A path
# reveals the environment exactly when it is `.Config.Env` or an ancestor of it
# (`.`, `.Config`), because `json` serialises the whole subtree. None of these
# is, and tests/dockq.test.js asserts that for every entry, so adding `.Config`
# here fails the suite rather than shipping.
INSPECT_FIELDS = {
    "name": ".Name",
    "id": ".Id",
    "image": ".Config.Image",
    "created": ".Created",
    "state": ".State",
    "restart_count": ".RestartCount",
    "restart_policy": ".HostConfig.RestartPolicy",
    "mounts": ".Mounts",
    "networks": ".NetworkSettings.Networks",
    "ports": ".NetworkSettings.Ports",
    "platform": ".Platform",
}
DEFAULT_FIELDS = ("name", "image", "state", "restart_count", "ports")


class DockqError(Exception):
    """A refusal dockq raises itself, reported without a traceback."""


def _check(pattern: re.Pattern, value: str, what: str) -> str:
    if not pattern.match(value):
        raise DockqError(f"refusing {what} {value!r}")
    return value


def _tail(value: str) -> int:
    try:
        n = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(
            f"must be a number 1..{MAX_TAIL}, not {value!r}"
        ) from None
    if not 1 <= n <= MAX_TAIL:
        raise argparse.ArgumentTypeError(f"must be 1..{MAX_TAIL}")
    return n


def inspect_template(fields: list[str]) -> str:
    """One JSON object holding each requested field, in the order given."""
    parts = [f'"{name}":{{{{json {INSPECT_FIELDS[name]}}}}}' for name in fields]
    return "{" + ",".join(parts) + "}"


def _logs_flags(ns) -> list[str]:
    argv = [f"--tail={ns.tail}"]
    if ns.since:
        argv.append(f"--since={_check(_SINCE, ns.since, '--since')}")
    if ns.timestamps:
        argv.append("--timestamps")
    return argv


def build(ns) -> list[str]:
    fmt = ["--format={{json .}}"] if getattr(ns, "json", False) else []
    if ns.cmd == "ps":
        return ["ps"] + (["--all"] if ns.all else []) + fmt
    if ns.cmd == "images":
        return ["images"] + (["--all"] if ns.all else []) + fmt
    if ns.cmd == "info":
        return ["info"] + fmt
    if ns.cmd == "logs":
        return (
            ["logs"]
            + _logs_flags(ns)
            + ["--", _check(_NAME, ns.container, "container")]
        )
    if ns.cmd == "inspect":
        fields = ns.field or list(DEFAULT_FIELDS)
        return [
            "inspect",
            "--type=container",
            f"--format={inspect_template(fields)}",
            "--",
            _check(_NAME, ns.container, "container"),
        ]
    if ns.cmd == "manifest":
        return ["manifest", "inspect", "--", _check(_IMAGE, ns.image, "image")]
    # compose
    project = (
        [f"--project-name={_check(_NAME, ns.project, '--project-name')}"]
        if ns.project
        else []
    )
    if ns.verb == "ps":
        return (
            ["compose"]
            + project
            + ["ps"]
            + (["--all"] if ns.all else [])
            + (["--format=json"] if ns.json else [])
        )
    services = [_check(_NAME, s, "service") for s in ns.services]
    return (
        ["compose"]
        + project
        + ["logs", "--no-color"]
        + _logs_flags(ns)
        + ["--", *services]
    )


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROG, description="Read Docker state (closed set of read verbs)."
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    as_json = argparse.ArgumentParser(add_help=False)
    as_json.add_argument("--json", action="store_true", help="one JSON object per line")
    bounded = argparse.ArgumentParser(add_help=False)
    bounded.add_argument(
        "-n",
        "--tail",
        type=_tail,
        required=True,
        help=f"lines from the end, 1..{MAX_TAIL}",
    )
    bounded.add_argument("--since", help="only lines newer than this, e.g. 30m, 2h")
    bounded.add_argument("-t", "--timestamps", action="store_true")

    p = sub.add_parser("ps", parents=[as_json], help="containers")
    p.add_argument("-a", "--all", action="store_true")
    p = sub.add_parser("images", parents=[as_json], help="images")
    p.add_argument("-a", "--all", action="store_true")
    sub.add_parser("info", parents=[as_json], help="daemon info")
    p = sub.add_parser("logs", parents=[bounded], help="a container's last N log lines")
    p.add_argument("container")
    p = sub.add_parser("inspect", help="fixed container fields; never the environment")
    p.add_argument("container")
    p.add_argument(
        "--field",
        action="append",
        choices=sorted(INSPECT_FIELDS),
        help=f"repeatable (default: {', '.join(DEFAULT_FIELDS)})",
    )
    p = sub.add_parser("manifest", help="docker manifest inspect")
    p.add_argument("verb", choices=("inspect",))
    p.add_argument("image")

    compose = sub.add_parser("compose", help="compose ps and logs")
    compose.add_argument("-p", "--project-name", dest="project")
    verbs = compose.add_subparsers(dest="verb", required=True)
    p = verbs.add_parser("ps", parents=[as_json])
    p.add_argument("-a", "--all", action="store_true")
    p = verbs.add_parser("logs", parents=[bounded])
    p.add_argument("services", nargs="*")
    return parser


def main(argv: list[str] | None = None) -> int:
    ns = _parser().parse_args(argv)
    try:
        docker_args = build(ns)
        docker = shutil.which("docker")
        if docker is None:
            raise DockqError("docker is not on PATH")
    except DockqError as exc:
        print(f"{PROG}: {exc}", file=sys.stderr)
        return 2
    return subprocess.run(
        [docker, *docker_args], stdin=subprocess.DEVNULL, check=False
    ).returncode


if __name__ == "__main__":
    sys.exit(main())

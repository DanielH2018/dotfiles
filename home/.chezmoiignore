.config/linux-provisioning
# environment.d is a systemd user-manager mechanism; it does nothing on Windows or macOS, and
# the Steam UI scale it carries only makes sense next to the Linux XWayland-scale script.
.config/environment.d
# powerdevilrc is read by PowerDevil, which is part of KDE Plasma and ships nowhere but
# Linux. The modify_ script that maintains it asserts a single display-blank timeout and
# passes the rest of the file through, so on a headless Linux host it is inert rather than
# wrong -- which is why this is gated on the OS and not on the hostname.
.config/powerdevilrc
# wpe drives linux-wallpaperengine, a native reimplementation of Wallpaper Engine's renderer that
# exists only for Linux — Wallpaper Engine itself is a Windows app and does not work under Proton.
# The control script talks to a systemd user manager, kscreen-doctor and wlr-layer-shell, none of
# which exist on macOS or Windows, so these paths are dead weight there rather than degraded.
# The .desktop entry goes with them: XDG desktop entries are a freedesktop mechanism, and the one
# here launches the Linux-only picker.
.local/bin/wpe
.local/bin/wpe-pick
.config/systemd/user/wallpaperengine.service
.config/wallpaperengine
.local/share/applications/wpe-pick.desktop
{{ end }}

# tasklist.exe / taskkill.exe symlinks point into /mnt/c (taskkill is used by agentview to
# end Windows panes), so deploy them only on WSL (a linux kernel reporting "microsoft").
# Elsewhere they'd be dangling symlinks.
{{ if not (and (eq .chezmoi.os "linux") (includeTemplate "is-wsl" .)) }}
.local/bin/tasklist.exe
.local/bin/taskkill.exe
{{ end }}

# yazi: plugin & flavor code is vendored by `ya pkg install` from the tracked
# package.toml, so don't manage the fetched dirs — except the hand-written
# linemode-cycle plugin, which IS tracked here.
.config/yazi/plugins/*
!.config/yazi/plugins/linemode-cycle.yazi
.config/yazi/flavors

# nvim: lazy's lockfile is machine-local (stable branches, no pinning).
.config/nvim/lazy-lock.json

# Python bytecode. tq imports its library from .local/share/tq, so running it —
# or its tests — from the source tree writes __pycache__ next to the source.
# A global gitignore keeps that out of `git status`, so chezmoi is the only thing
# that sees it, and without this it deploys the .pyc files as managed dotfiles.
**/__pycache__

# Python test and environment scratch, for the same reason and with a worse blast
# radius: the vault-tooling projects are pytest projects living in the source
# tree, so `uv sync` or a bare `pytest` there drops a .venv or .pytest_cache next
# to managed files. The wired suites avoid both (`--no-project`,
# `-p no:cacheprovider`), but running them by hand should not be able to deploy a
# few thousand files into ~/.claude.
**/.venv
**/.pytest_cache

# The tools-inventory suite resolves the generator by a source-tree relative path
# (../../bin/executable_tools-inventory), so a deployed copy could not run even if it
# were there. It stays in the checkout rather than joining tests/chezmoi/managed-test-paths.txt,
# which is for tests that genuinely travel with ~/.claude.
.local/share/tools-inventory/tools-inventory.test.js

# claude artifacts: ~/.claude/artifacts is local scratch for plan/spec renders.
# Don't manage the dir by default — blocks `chezmoi add` on ad-hoc artifacts so
# scratch can't be swept upstream. Track only the specific plan files kept here.
.claude/artifacts/*
!.claude/artifacts/homelab-mcp-health-sweep_2026-07-23.html
!.claude/artifacts/homelab-mcp-health-sweep_2026-07-23.md

# Machine-local overrides must never enter this (public) repo. Blocks `chezmoi add`
# on any *.local.* file so a permission/secret override can't be swept upstream.
**/*.local.json
**/*.local.md
**/*.local.zsh
**/*.local.env
**/local.config

# Don't regenerate the terminal cheatsheet on every apply. The generator
# (~/.local/bin/terminal-cheatsheet) is still deployed — run it by hand when the
# WezTerm / Neovim / Yazi keybindings change.
.chezmoiscripts/post-install/terminal-cheatsheet.sh

# Same for the tools inventory. This one is cheap enough to run every time, but an
# unconditional after-script is listed by `chezmoi status` on every invocation whether or
# not anything changed, so a permanently non-empty status hides the drift worth seeing.
# The generator (~/.local/bin/tools-inventory) is still deployed — run it by hand after
# adding or retiring a command.
.chezmoiscripts/post-install/tools-inventory.sh

# The work overlay merged into settings.json by modify_settings.json.sh.tmpl. It
# doesn't match *.local.* above, so without this a `chezmoi add` would sweep a
# work-machine permission set into this public repo.
.config/claude/settings.work.json
**/*.work.json

# ~/.ssh/config holds client-side Host entries (IdentityFiles, the artifact-port
# forward) that only mean something from a workstation. The homelab hosts are what
# those entries connect TO, and none of them has the referenced keys.
{{ if has .chezmoi.hostname (list "daniel-server" "daniel-pi" "daniel-box") }}
.ssh/config
{{ end }}

# kwinrulesrc is KWin's window-rule store, and every rule in it is a `position` naming an
# absolute coordinate inside one of this box's four outputs (see the login-window-layout
# launcher, which relies on it). Those coordinates are meaningless anywhere else: a host with a
# different display arrangement would place windows off-screen, and one without Plasma has
# nothing to read the file at all. So this is gated on the hostname rather than on the OS —
# unlike powerdevilrc, which is inert rather than wrong on a headless Linux host.
#
# Maintained by modify_private_kwinrulesrc.sh, which asserts only those five rules and passes
# every other one — including whatever System Settings writes — straight through.
{{ if ne .chezmoi.hostname "fedora" }}
.config/kwinrulesrc
{{ end }}

# fix-games-mount repairs one specific volume on one specific machine: /mnt/games on this
# box's /dev/sda2, a Samsung 860 EVO whose SMART attribute names it gates on by hand, dirtied
# by a TU102 GPU fault it names as "the known trigger on this machine". None of that is a
# parameter — it is the script. Elsewhere it would either find no fstab entry and exit, or
# (worse, on another Linux host with a /mnt/games) reach for ntfsfix against a disk whose
# health it cannot actually judge. Same reasoning as kwinrulesrc above: meaningless off this
# host, so gated on the hostname rather than on the OS.
{{ if ne .chezmoi.hostname "fedora" }}
.local/bin/fix-games-mount
{{ end }}

# The clipboard bridge serves THIS desktop's Wayland clipboard to Claude Code running over
# SSH elsewhere (see .local/bin/clip-bridge). It is the desktop half of a pair: the remote
# half is the xclip shim, which deploys everywhere and stays inert without a bridge socket.
# Gated on the hostname rather than on the OS because the listener needs a live compositor
# to read from — on daniel-box or daniel-server there is no clipboard to serve, so the units
# would start, bind a port, and answer every request with nothing.
{{ if ne .chezmoi.hostname "daniel-desktop" }}
.local/bin/clip-bridge
.config/systemd/user/clip-bridge.socket
.config/systemd/user/clip-bridge@.service
.config/systemd/user/clip-bridge-tunnel@.service
{{ end }}

# The sudo shim (see the script for why it exists) belongs wherever SUDO_ASKPASS is configured
# and sudo refuses to use it without -A. That was the headless hosts, and it now includes this
# work laptop: measured 2026-08-04 (sudo 1.9.17p2) the same way daniel-box was, plain sudo
# refused with the helper exported and valid. Running `! sudo …` inside a Claude Code session is
# the whole reason the flag has to come from somewhere other than the person typing.
#
# Shadowing `sudo` in PATH is still not a default — hosts that never asked for it keep the real
# binary first. Where it does deploy, it engages only when there is no tty, so an interactive
# terminal gets a byte-identical invocation (asserted in tests/sudo-shim.test.js).
{{ if not (has .chezmoi.hostname (list "daniel-server" "daniel-pi" "daniel-box" "MacBook-Pro-2")) }}
.local/bin/sudo
{{ end }}

# The claude-otel compose stack goes only to machines that have to provide their own
# collector — which is fewer than the machines that report telemetry. Everywhere else the
# files are not merely useless, they are a loaded gun: every one of these hosts already has
# something listening on 4317, or depends on something that does, and `docker compose up`
# here would bind that port out from under it.
#
#   daniel-server, daniel-box   already run an observability stack whose collector holds
#                               127.0.0.1:4317 — verified on daniel-server, where it is the
#                               one port of this stack's seven already bound. Claude Code
#                               plugs into that collector instead; see claude-otel/README.md.
#   daniel-desktop              exports into daniel-wsl's collector over WSL2 localhost
#                               forwarding. A collector bound on the Windows side would
#                               shadow the very forward its telemetry travels through.
#   daniel-pi                   out of telemetry altogether (settings.base.json), so it has
#                               nothing to export and no reason to carry a stack.
#
# otelq is deliberately NOT ignored. On a server it queries localhost:3100/9090, which is
# not where that stack's Loki and Prometheus answer — but a query tool that returns nothing
# is a smaller problem than one that is missing when someone reaches for it, and the shape
# of the server stacks is changing anyway.
{{ if has .chezmoi.hostname (list "daniel-server" "daniel-box" "daniel-desktop" "daniel-pi") }}
claude-otel
{{ end }}

# Warp tab configs split into two kinds, and only one kind is personal. The general machinery
# — settings.toml, keybindings.yaml, the Catppuccin theme, `local · shell` (which is also
# `default_tab_config_path`, so it has to exist everywhere), `local · chezmoi`, `local · vault`,
# and the free-text `ssh · other host` escape hatch — describes how Warp behaves and deploys
# to every machine.
#
# These three name personal infrastructure by hostname or by repo, and a work machine can
# reach none of them: `daniel-box` and `daniel-server` are ssh aliases for the homelab, and
# `~/server` is DanielH2018/server, the ansible repo that provisions it. Left ungated they are
# not merely dead entries — they put personal hostnames in the `+` menu of a work terminal.
#
# Gated on .work rather than on the hostname, unlike kwinrulesrc and fix-games-mount above:
# those are wrong on one specific machine's absence of hardware, this is wrong on a class of
# machine. A second personal box should get these without being added to a list.
{{ if .work }}
.local/share/warp-terminal/tab_configs/daniel-box.toml
.local/share/warp-terminal/tab_configs/daniel-server.toml
.local/share/warp-terminal/tab_configs/local-server.toml
{{ end }}

# Warp reads one settings.toml and one keybindings.yaml, at a path that differs by OS
# (docs.warp.dev/terminal/settings/file-locations). macOS reads ~/.warp; Linux reads
# $XDG_CONFIG_HOME/warp-terminal. Both are tracked, both include the same shared body from
# .chezmoitemplates, and each machine deploys only the pair its Warp actually opens — a copy
# at the other path is not harmless, it is a second file that looks authoritative and that a
# recapture can be pasted into with no effect.
#
# Themes and tab configs stay at the XDG data path on every OS, and macOS reaches them through
# two symlinks under ~/.warp. Warp only reads those two directories, so a symlink is safe there
# — unlike the pair above, which Warp rewrites. It also keeps the .work gate above as the single
# copy of the personal-host list: a parallel file tree under ~/.warp would need that gate
# duplicated, and warp-tab-config-gate.test.js matches the XDG spelling only, so the duplicate
# would stay green while daniel-box.toml deployed to a work laptop.
#
# Every path in this file is read as an entry, comments included, so no comment here may spell
# a real target path. That is what warp-tab-config-gate.test.js caught on the first draft.
{{ if eq .chezmoi.os "darwin" }}
.config/warp-terminal
{{ else }}
.warp
{{ end }}

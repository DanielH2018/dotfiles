#!/usr/bin/env bash
set -euo pipefail

# claude-sandbox: Launch Claude Code in a Docker-based Pattern C sandbox.
# Usage: claude-sandbox [--rebuild|--rebuild-base|--generate|--worktree NAME] <repo-path>

SANDBOX_DIR="$HOME/.claude/sandbox"
AUDIT_BASE="$SANDBOX_DIR/audit"
SESSIONS_BASE="$SANDBOX_DIR/sessions"
STATE_DIR="$SANDBOX_DIR/state"
# Machine/work-specific values (e.g. CLAUDE_VAULT_DIR) for an optional work overlay.
if [ -f "$HOME/.config/claude/local.env" ]; then
  . "$HOME/.config/claude/local.env"
fi
# Resolve the settings file to mount: base, or base+work-overlay merged at launch.
SANDBOX_SETTINGS="$("$SANDBOX_DIR/resolve-sandbox-settings.sh" "$SANDBOX_DIR/settings.base.json" "$HOME/.config/claude/sandbox-settings.work.json")"
OP_SOCKET="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
# TODO: pin to a specific digest once you've pulled a known-good version:
#   docker inspect lscr.io/linuxserver/socket-proxy:latest --format '{{index .RepoDigests 0}}'
# Then replace :latest with the sha256 digest to avoid supply-chain risk.
PROXY_IMAGE="lscr.io/linuxserver/socket-proxy:latest"

usage() {
  echo "Usage: claude-sandbox [OPTIONS] <repo-path>"
  echo ""
  echo "Options:"
  echo "  --rebuild          Force rebuild the per-repo Docker image"
  echo "  --rebuild-base     Rebuild the claudebot:base image (run after editing Dockerfile.base)"
  echo "  --generate         Regenerate Dockerfile.claudebot only (don't build or run)"
  echo "  --worktree, -w [NAME]  Run in an isolated git worktree on branch claude/<NAME>."
  echo "                     Reuses existing worktree if branch already exists."
  echo "                     If NAME is omitted, generates a short random suffix."
  echo "                     Worktree is kept on exit if it has changes; removed if clean."
  echo "  --list             List all sandbox sessions (worktrees + main) for a repo."
  echo "                     Shows branch, path, running status, and resume command."
  echo "  --rename OLD NEW   Rename a worktree: branch, directory, and session data."
  echo "  --prune            Interactively select and delete worktrees (fzf picker)."
  echo "  --gc               Clean up worktrees whose remote branches were deleted."
  exit 1
}

# --- Parse args ---
REBUILD=false
REBUILD_BASE=false
GENERATE_ONLY=false
LIST_SESSIONS=false
COMPLETE_WORKTREES=false
PRUNE_WORKTREES=false
GC_WORKTREES=false
PREVIEW_MODE=false
PREVIEW_ARGS=()
RENAME_WORKTREE=false
RENAME_OLD=""
RENAME_NEW=""
USE_WORKTREE=false
WT_NAME=""
REPO_PATH=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --rebuild) REBUILD=true; shift ;;
    --rebuild-base) REBUILD_BASE=true; shift ;;
    --generate) GENERATE_ONLY=true; shift ;;
    --list) LIST_SESSIONS=true; shift ;;
    --complete-worktrees) COMPLETE_WORKTREES=true; shift ;;
    --prune) PRUNE_WORKTREES=true; shift ;;
    --gc) GC_WORKTREES=true; shift ;;
    --_preview) PREVIEW_MODE=true; shift; PREVIEW_ARGS=("$@"); break ;;
    --rename)
      RENAME_WORKTREE=true
      shift
      if [[ $# -lt 2 ]]; then
        echo "Error: --rename requires OLD and NEW names" >&2
        exit 1
      fi
      RENAME_OLD="$1"; shift
      RENAME_NEW="$1"; shift
      ;;
    --worktree|-w)
      USE_WORKTREE=true
      shift
      # Consume the next arg as worktree name if it doesn't look like a flag or path
      if [[ $# -gt 0 && "$1" != -* && "$1" != /* && "$1" != .* ]]; then
        WT_NAME="$1"
        shift
      fi
      ;;
    -h|--help) usage ;;
    -*) echo "Unknown option: $1"; usage ;;
    *) REPO_PATH="$1"; shift ;;
  esac
done

# --- Docker prerequisites (needed by --rebuild-base and normal runs) ---
if [[ "$LIST_SESSIONS" == false && "$COMPLETE_WORKTREES" == false && "$PRUNE_WORKTREES" == false && "$GC_WORKTREES" == false && "$PREVIEW_MODE" == false && "$RENAME_WORKTREE" == false && (("$GENERATE_ONLY" == false && -n "$REPO_PATH") || "$REBUILD_BASE" == true) ]]; then
  if ! command -v docker &>/dev/null; then
    echo "Error: docker is not installed." >&2
    exit 1
  fi
  if ! docker info &>/dev/null 2>&1; then
    echo "Error: Docker daemon is not running." >&2
    exit 1
  fi
fi

# --- Rebuild base image if requested ---
if [[ "$REBUILD_BASE" == true ]]; then
  echo "Building claudebot:base..."
  docker build -t claudebot:base -f "$SANDBOX_DIR/Dockerfile.base" "$SANDBOX_DIR"
  [[ -z "$REPO_PATH" ]] && exit 0
  # Base changed — force per-repo rebuild too
  REBUILD=true
fi

[[ -z "$REPO_PATH" ]] && usage

# Resolve short repo names: "airflow" -> ~/Repositories/airflow
if [[ "$REPO_PATH" != /* && "$REPO_PATH" != .* && -d "$HOME/Repositories/$REPO_PATH" ]]; then
  REPO_PATH="$HOME/Repositories/$REPO_PATH"
fi

REPO_PATH="$(cd "$REPO_PATH" && pwd)"
# Sanitize repo name for use in Docker tags (must match [a-zA-Z0-9._-])
REPO_NAME="$(basename "$REPO_PATH" | tr -c 'a-zA-Z0-9._-' '-' | sed 's/^-//;s/-$//')"
if [[ -z "$REPO_NAME" ]]; then
  echo "Error: could not derive a valid repo name from path: $REPO_PATH" >&2
  exit 1
fi

# Validate repo is a git repository (.git can be a file in worktrees)
if [[ ! -d "$REPO_PATH/.git" && ! -f "$REPO_PATH/.git" ]]; then
  echo "Error: not a git repository: $REPO_PATH" >&2
  exit 1
fi

# Generate worktree name if needed
if [[ "$USE_WORKTREE" == true && -z "$WT_NAME" ]]; then
  WT_NAME="$(openssl rand -hex 3)"
fi

# Validate worktree name (alphanumeric, hyphens, underscores only)
if [[ -n "$WT_NAME" ]] && [[ ! "$WT_NAME" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo "Error: worktree name must be alphanumeric (hyphens/underscores allowed): '$WT_NAME'" >&2
  exit 1
fi

# Use a short hash of the full path to avoid collisions when two repos
# share the same basename (e.g., ~/work/api vs ~/personal/api).
REPO_HASH="$(printf '%s' "$REPO_PATH" | md5 | head -c 8)"

# INSTANCE_ID is deterministic per repo (or per worktree) — used for storage
# paths (sessions, audit) so Claude can resume previous conversations.
# RUN_ID adds a random suffix for Docker resources (container, proxy, network)
# that must be unique across parallel launches of the same repo.
if [[ "$USE_WORKTREE" == true ]]; then
  INSTANCE_ID="${REPO_NAME}-${REPO_HASH}-${WT_NAME}"
else
  INSTANCE_ID="${REPO_NAME}-${REPO_HASH}"
fi
RUN_ID="${INSTANCE_ID}-$(openssl rand -hex 3)"
IMAGE_TAG="claudebot:${REPO_NAME}-${REPO_HASH}"
DOCKERFILE="$SANDBOX_DIR/dockerfiles/Dockerfile.${REPO_NAME}-${REPO_HASH}"
PROXY_NAME="claudebot-proxy-$RUN_ID"
NETWORK_NAME="claudebot-net-$RUN_ID"

# WORK_PATH is what gets mounted into the container.
# Defaults to REPO_PATH; overridden to the worktree path below.
WORK_PATH="$REPO_PATH"
WT_BRANCH=""
WT_PATH=""
WT_CREATED=false

# --- Validate prerequisites ---
if [[ "$GENERATE_ONLY" == false ]]; then
  # Support ANTHROPIC_ADMIN_API_KEY as an alias to avoid collisions with host claude
  if [[ -n "${ANTHROPIC_ADMIN_API_KEY:-}" && -z "${ANTHROPIC_API_KEY:-}" ]]; then
    export ANTHROPIC_API_KEY="$ANTHROPIC_ADMIN_API_KEY"
  fi

  if [[ -z "${ANTHROPIC_API_KEY:-}" && ! -f "$STATE_DIR/.auth-configured" ]]; then
    echo "Note: No API key or OAuth session found — will prompt for OAuth login." >&2
  fi
fi

# --- Input validation ---
validate_version() {
  local label="$1" value="$2"
  if [[ ! "$value" =~ ^[0-9a-zA-Z._+\-]+$ ]]; then
    echo "Error: unsafe $label version string: '$value'" >&2
    exit 1
  fi
}

# --- List sessions ---
list_sessions() {
  local repo_hash repo_name_safe
  repo_name_safe="$(basename "$REPO_PATH" | tr -c 'a-zA-Z0-9._-' '-' | sed 's/^-//;s/-$//')"
  repo_hash="$(printf '%s' "$REPO_PATH" | md5 | head -c 8)"
  local base_instance="${repo_name_safe}-${repo_hash}"

  echo "Sandbox sessions for $repo_name_safe ($REPO_PATH)"
  echo ""

  # Collect running container names for quick lookup
  local running_containers
  running_containers="$(docker ps --filter "name=claudebot-${base_instance}" --format '{{.Names}}' 2>/dev/null || true)"

  # Main repo session (no worktree)
  local main_status="stopped"
  if echo "$running_containers" | grep -q "claudebot-${base_instance}-[0-9a-f]"; then
    main_status="running"
  fi
  local main_sessions="$SESSIONS_BASE/$base_instance"
  local main_has_data="no sessions"
  if [[ -d "$main_sessions" ]] && [[ -n "$(ls -A "$main_sessions" 2>/dev/null)" ]]; then
    main_has_data="has sessions"
  fi

  printf "  %-12s %-30s %-10s %s\n" "NAME" "BRANCH" "STATUS" "RESUME"
  printf "  %-12s %-30s %-10s %s\n" "----" "------" "------" "------"

  # Get current branch of main repo
  local main_branch
  main_branch="$(git -C "$REPO_PATH" branch --show-current 2>/dev/null || echo "detached")"
  printf "  %-12s %-30s %-10s %s\n" "(main)" "$main_branch" "$main_status" "claude-sandbox $REPO_PATH"

  # Worktree sessions — scan git worktrees for claude/* branches
  local wt_path wt_branch wt_name wt_status wt_instance
  while IFS= read -r line; do
    if [[ "$line" == "worktree "* ]]; then
      wt_path="${line#worktree }"
    elif [[ "$line" == "branch "* ]]; then
      wt_branch="${line#branch refs/heads/}"
      if [[ "$wt_branch" == claude/* ]]; then
        wt_name="${wt_branch#claude/}"
        wt_instance="${base_instance}-${wt_name}"
        wt_status="stopped"
        if echo "$running_containers" | grep -q "claudebot-${wt_instance}-[0-9a-f]"; then
          wt_status="running"
        fi
        printf "  %-12s %-30s %-10s %s\n" "$wt_name" "$wt_branch" "$wt_status" "claude-sandbox --worktree $wt_name $REPO_PATH"
      fi
      wt_path=""
      wt_branch=""
    fi
  done < <(git -C "$REPO_PATH" worktree list --porcelain 2>/dev/null)

  # Check for orphaned sessions (session dir exists but worktree is gone)
  local session_dir
  for session_dir in "$SESSIONS_BASE/${base_instance}-"*; do
    [[ -d "$session_dir" ]] || continue
    local session_name
    session_name="$(basename "$session_dir")"
    # Skip the base instance (already shown as main)
    [[ "$session_name" == "$base_instance" ]] && continue
    # Extract the worktree name suffix
    local suffix="${session_name#${base_instance}-}"
    # Skip if we already listed this worktree above
    if git -C "$REPO_PATH" worktree list --porcelain 2>/dev/null | grep -q "branch refs/heads/claude/$suffix"; then
      continue
    fi
    printf "  %-12s %-30s %-10s %s\n" "$suffix" "claude/$suffix (orphaned)" "no worktree" "--worktree $suffix recreates it"
  done

  echo ""
}

if [[ "$LIST_SESSIONS" == true ]]; then
  [[ -z "$REPO_PATH" ]] && usage

  # Resolve short repo names
  if [[ "$REPO_PATH" != /* && "$REPO_PATH" != .* && -d "$HOME/Repositories/$REPO_PATH" ]]; then
    REPO_PATH="$HOME/Repositories/$REPO_PATH"
  fi
  REPO_PATH="$(cd "$REPO_PATH" && pwd)"

  list_sessions
  exit 0
fi

# --- Worktree name completion (called by zsh/bash completion) ---
if [[ "$COMPLETE_WORKTREES" == true ]]; then
  [[ -z "$REPO_PATH" ]] && exit 0

  # Resolve short repo names
  if [[ "$REPO_PATH" != /* && "$REPO_PATH" != .* && -d "$HOME/Repositories/$REPO_PATH" ]]; then
    REPO_PATH="$HOME/Repositories/$REPO_PATH"
  fi
  REPO_PATH="$(cd "$REPO_PATH" 2>/dev/null && pwd)" || exit 0

  repo_hash="$(printf '%s' "$REPO_PATH" | md5 | head -c 8)"
  repo_name_safe="$(basename "$REPO_PATH" | tr -c 'a-zA-Z0-9._-' '-' | sed 's/^-//;s/-$//')"
  base_instance="${repo_name_safe}-${repo_hash}"

  # Worktree names from git (claude/* branches)
  while IFS= read -r line; do
    if [[ "$line" == "branch refs/heads/claude/"* ]]; then
      echo "${line#branch refs/heads/claude/}"
    fi
  done < <(git -C "$REPO_PATH" worktree list --porcelain 2>/dev/null)

  # Orphaned session names (worktree gone but session data remains)
  for session_dir in "$SESSIONS_BASE/${base_instance}-"*; do
    [[ -d "$session_dir" ]] || continue
    suffix="$(basename "$session_dir")"
    suffix="${suffix#${base_instance}-}"
    # Skip if already listed from git worktrees
    git -C "$REPO_PATH" worktree list --porcelain 2>/dev/null \
      | grep -q "branch refs/heads/claude/$suffix" && continue
    echo "$suffix"
  done

  exit 0
fi


# --- Rename worktree ---
if [[ "$RENAME_WORKTREE" == true ]]; then
  [[ -z "$REPO_PATH" ]] && usage

  # Resolve short repo names
  if [[ "$REPO_PATH" != /* && "$REPO_PATH" != .* && -d "$HOME/Repositories/$REPO_PATH" ]]; then
    REPO_PATH="$HOME/Repositories/$REPO_PATH"
  fi
  REPO_PATH="$(cd "$REPO_PATH" && pwd)"

  # Validate new name
  if [[ ! "$RENAME_NEW" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "Error: new name must be alphanumeric (hyphens/underscores allowed): '$RENAME_NEW'" >&2
    exit 1
  fi

  REPO_NAME="$(basename "$REPO_PATH" | tr -c 'a-zA-Z0-9._-' '-' | sed 's/^-//;s/-$//')"
  REPO_HASH="$(printf '%s' "$REPO_PATH" | md5 | head -c 8)"

  OLD_BRANCH="claude/$RENAME_OLD"
  NEW_BRANCH="claude/$RENAME_NEW"
  OLD_WT_PATH="$REPO_PATH/../$REPO_NAME-wt-$RENAME_OLD"
  NEW_WT_PATH="$REPO_PATH/../$REPO_NAME-wt-$RENAME_NEW"
  OLD_INSTANCE="${REPO_NAME}-${REPO_HASH}-${RENAME_OLD}"
  NEW_INSTANCE="${REPO_NAME}-${REPO_HASH}-${RENAME_NEW}"

  # Determine if the worktree/branch actually exist (vs orphaned session data)
  OLD_WT_PATH_ABS="$(cd "$OLD_WT_PATH" 2>/dev/null && pwd)" || true
  HAS_WORKTREE=false
  HAS_BRANCH=false
  [[ -n "$OLD_WT_PATH_ABS" ]] && HAS_WORKTREE=true
  git -C "$REPO_PATH" show-ref --verify --quiet "refs/heads/$OLD_BRANCH" 2>/dev/null && HAS_BRANCH=true

  # Must have at least a worktree, branch, or session data
  if [[ "$HAS_WORKTREE" == false && "$HAS_BRANCH" == false \
        && ! -d "$SESSIONS_BASE/$OLD_INSTANCE" && ! -d "$AUDIT_BASE/$OLD_INSTANCE" ]]; then
    echo "Error: nothing found for '$RENAME_OLD' (no worktree, branch, or session data)" >&2
    exit 1
  fi

  # Check new name isn't already taken
  if git -C "$REPO_PATH" show-ref --verify --quiet "refs/heads/$NEW_BRANCH" 2>/dev/null; then
    echo "Error: branch '$NEW_BRANCH' already exists" >&2
    exit 1
  fi
  if [[ -d "$NEW_WT_PATH" ]]; then
    echo "Error: worktree path already exists: $NEW_WT_PATH" >&2
    exit 1
  fi

  # Check no running container for this worktree
  if docker ps --filter "name=claudebot-${OLD_INSTANCE}-" --format '{{.Names}}' 2>/dev/null | grep -q .; then
    echo "Error: a sandbox session is running for '$RENAME_OLD' — stop it first" >&2
    exit 1
  fi

  echo "Renaming worktree: $RENAME_OLD -> $RENAME_NEW"

  # 1. Rename branch (skip if none)
  if [[ "$HAS_BRANCH" == true ]]; then
    echo "  Branch: $OLD_BRANCH -> $NEW_BRANCH"
    git -C "$REPO_PATH" branch -m "$OLD_BRANCH" "$NEW_BRANCH"
  fi

  # 2. Move worktree directory (skip if none)
  if [[ "$HAS_WORKTREE" == true ]]; then
    echo "  Path: $OLD_WT_PATH_ABS -> $NEW_WT_PATH"
    git -C "$REPO_PATH" worktree move "$OLD_WT_PATH_ABS" "$NEW_WT_PATH"
  fi

  # 3. Move session data
  if [[ -d "$SESSIONS_BASE/$OLD_INSTANCE" ]]; then
    echo "  Sessions: $OLD_INSTANCE -> $NEW_INSTANCE"
    mv "$SESSIONS_BASE/$OLD_INSTANCE" "$SESSIONS_BASE/$NEW_INSTANCE"
  fi

  # 4. Move audit data
  if [[ -d "$AUDIT_BASE/$OLD_INSTANCE" ]]; then
    echo "  Audit: $OLD_INSTANCE -> $NEW_INSTANCE"
    mv "$AUDIT_BASE/$OLD_INSTANCE" "$AUDIT_BASE/$NEW_INSTANCE"
  fi

  echo ""
  echo "Done. Resume with:"
  echo "  claude-sandbox -w $RENAME_NEW $REPO_PATH"
  exit 0
fi

# --- Feature detection flags ---
NEEDS_DOCKER=false

detect_docker_need() {
  # Check for docker-compose files (depth 2 catches monorepo layouts)
  local compose_files
  compose_files=$(find "$REPO_PATH" -maxdepth 2 \( -name "docker-compose*.yml" -o -name "docker-compose*.yaml" -o -name "compose*.yml" -o -name "compose*.yaml" \) 2>/dev/null | head -1)
  if [[ -n "$compose_files" ]]; then
    NEEDS_DOCKER=true
  fi
  # Also check Makefile for docker compose references
  if [[ -f "$REPO_PATH/Makefile" ]] && grep -q 'docker compose\|docker-compose' "$REPO_PATH/Makefile" 2>/dev/null; then
    NEEDS_DOCKER=true
  fi
}

detect_uv_need() {
  # Check for uv.lock, or uv references in CLAUDE.md / Makefile / pyproject.toml
  if [[ -f "$REPO_PATH/uv.lock" ]]; then
    return 0
  fi
  if [[ -f "$REPO_PATH/CLAUDE.md" ]] && grep -q '\buv \|uv run\|uv sync\|uv pip\|uv add' "$REPO_PATH/CLAUDE.md" 2>/dev/null; then
    return 0
  fi
  if [[ -f "$REPO_PATH/Makefile" ]] && grep -q '\buv \|uv run\|uv sync\|uv pip' "$REPO_PATH/Makefile" 2>/dev/null; then
    return 0
  fi
  return 1
}

# --- Detect toolchains and generate Dockerfile ---
generate_dockerfile() {
  local layers=""

  # Java / Kotlin via sdkman
  if [[ -f "$REPO_PATH/.sdkmanrc" ]]; then
    local java_version
    java_version=$(grep -E '^java=' "$REPO_PATH/.sdkmanrc" | cut -d= -f2 | tr -d '[:space:]')
    [[ -n "$java_version" ]] && validate_version "java" "$java_version"
    if [[ -n "$java_version" ]]; then
      layers+="
# --- Java via sdkman (.sdkmanrc) ---
USER root
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \\
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \\
    apt-get update && apt-get install -y --no-install-recommends zip unzip findutils
USER claudebot
ENV SDKMAN_DIR=/home/claudebot/.sdkman
RUN curl -s \"https://get.sdkman.io\" | bash
RUN bash -c \"source \$SDKMAN_DIR/bin/sdkman-init.sh && sdk install java $java_version && sdk flush tmp\"
ENV JAVA_HOME=/home/claudebot/.sdkman/candidates/java/current
ENV PATH=\"\$JAVA_HOME/bin:\$PATH\"
"
    fi
  fi

  # Node via fnm
  local node_version=""
  if [[ -f "$REPO_PATH/.nvmrc" ]]; then
    node_version=$(cat "$REPO_PATH/.nvmrc" | tr -d '[:space:]' | sed 's/^v//')
  elif [[ -f "$REPO_PATH/.node-version" ]]; then
    node_version=$(cat "$REPO_PATH/.node-version" | tr -d '[:space:]' | sed 's/^v//')
  elif [[ -f "$REPO_PATH/package.json" ]]; then
    # No version file — base image already has Node 22 (current LTS).
    # Skip fnm to avoid a ~200MB duplicate install. If the repo needs
    # a specific version, add an .nvmrc or .node-version file.
    :
  fi
  if [[ -n "$node_version" ]]; then
    validate_version "node" "$node_version"
    layers+="
# --- Node via fnm ---
ENV FNM_DIR=/home/claudebot/.fnm
RUN curl -fsSL https://fnm.vercel.app/install | bash -s -- --install-dir \"\$FNM_DIR\" --skip-shell
ENV PATH=\"/home/claudebot/.fnm:\$PATH\"
RUN eval \"\$(fnm env)\" && fnm install $node_version && fnm default $node_version
ENV PATH=\"/home/claudebot/.fnm/aliases/default/bin:\$PATH\"
"
  fi

  # Rust via rustup
  if [[ -f "$REPO_PATH/Cargo.toml" ]]; then
    layers+="
# --- Rust via rustup ---
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH=\"/home/claudebot/.cargo/bin:\$PATH\"
"
  fi

  # Go
  if [[ -f "$REPO_PATH/go.mod" ]]; then
    local go_version
    go_version=$(grep -E '^go ' "$REPO_PATH/go.mod" | awk '{print $2}' | head -1)
    [[ -z "$go_version" ]] && go_version="1.22.4"
    # Go downloads require three-part versions (1.22.0, not 1.22)
    if [[ "$go_version" =~ ^[0-9]+\.[0-9]+$ ]]; then
      go_version="${go_version}.0"
    fi
    validate_version "go" "$go_version"
    layers+="
# --- Go ---
USER root
RUN ARCH=\$(dpkg --print-architecture) && \\
    curl -fsSL \"https://go.dev/dl/go${go_version}.linux-\${ARCH}.tar.gz\" | tar -C /usr/local -xz
USER claudebot
ENV PATH=\"/usr/local/go/bin:/home/claudebot/go/bin:\$PATH\"
"
  fi

  # Python
  if [[ -f "$REPO_PATH/pyproject.toml" || -f "$REPO_PATH/requirements.txt" ]]; then
    local python_build_deps="python3 python3-pip python3-venv python-is-python3"
    # C extension build deps — always included since most non-trivial
    # dependency trees include at least one compiled extension
    local extra_deps="gcc python3-dev libpq-dev libffi-dev"

    local uv_layer=""
    if detect_uv_need; then
      uv_layer="
# uv package manager
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH=\"/home/claudebot/.local/bin:\$PATH\"
"
    fi

    layers+="
# --- Python ---
USER root
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \\
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \\
    apt-get update && apt-get install -y --no-install-recommends $python_build_deps $extra_deps
USER claudebot
$uv_layer"
  fi

  # Write Dockerfile
  cat > "$DOCKERFILE" <<DOCKEREOF
# syntax=docker/dockerfile:1
FROM claudebot:base
$layers
WORKDIR /workspace
DOCKEREOF

  echo "Generated $DOCKERFILE"
  if [[ -n "$layers" ]]; then
    echo "Detected toolchains:"
    grep '# ---' "$DOCKERFILE" | sed 's/# --- //;s/ ---.*//' | sed 's/^/  - /'
    if grep -q 'uv/install' "$DOCKERFILE"; then
      echo "  - uv (Python package manager)"
    fi
  else
    echo "  No toolchains detected (lightweight image)"
  fi
}

# --- Docker socket proxy management ---
start_proxy() {
  # Clean up any stale proxy/network from a previous run
  docker rm -f "$PROXY_NAME" 2>/dev/null || true
  docker network rm "$NETWORK_NAME" 2>/dev/null || true

  # Create isolated network for proxy <-> sandbox communication
  docker network create "$NETWORK_NAME" >/dev/null

  # Proxy scope: containers/networks/volumes/images are enabled for compose
  # workflows. POST is required for container create/start. exec/build/commit
  # are blocked to prevent sandbox escape.
  echo "Starting Docker socket proxy ($PROXY_NAME)..."
  docker run -d --rm \
    --name "$PROXY_NAME" \
    --network "$NETWORK_NAME" \
    --cap-drop all \
    -v /var/run/docker.sock:/var/run/docker.sock:ro \
    -e LOG_LEVEL=info \
    -e CONTAINERS=1 \
    -e NETWORKS=1 \
    -e VOLUMES=1 \
    -e IMAGES=1 \
    -e POST=1 \
    -e ALLOW_START=1 \
    -e ALLOW_STOP=1 \
    -e ALLOW_RESTARTS=1 \
    -e EVENTS=1 \
    -e VERSION=1 \
    -e PING=1 \
    -e EXEC=0 \
    -e AUTH=0 \
    -e SECRETS=0 \
    -e SWARM=0 \
    -e BUILD=0 \
    -e COMMIT=0 \
    -e CONFIGS=0 \
    -e DISTRIBUTION=0 \
    -e NODES=0 \
    -e PLUGINS=0 \
    -e SYSTEM=0 \
    -e SERVICES=0 \
    -e TASKS=0 \
    "$PROXY_IMAGE" >/dev/null

  # Wait for proxy container to be running
  local retries=0
  while [[ "$(docker inspect -f '{{.State.Running}}' "$PROXY_NAME" 2>/dev/null)" != "true" ]]; do
    retries=$((retries + 1))
    if [[ $retries -ge 15 ]]; then
      echo "Error: socket proxy failed to start after 15 attempts" >&2
      exit 1
    fi
    sleep 0.2
  done

  echo "  Allowed: containers, networks, volumes, images (read), start/stop/restart"
  echo "  Blocked: exec, build, commit, system, secrets, auth, swarm, plugins"
}

stop_proxy() {
  docker rm -f "$PROXY_NAME" 2>/dev/null || true
  docker network rm "$NETWORK_NAME" 2>/dev/null || true
}

# --- Git worktree management ---
setup_worktree() {
  WT_BRANCH="claude/$WT_NAME"
  WT_PATH="$REPO_PATH/../$REPO_NAME-wt-$WT_NAME"

  # Check if this worktree already exists
  if git -C "$REPO_PATH" worktree list --porcelain | grep -q "^worktree $(cd "$WT_PATH" 2>/dev/null && pwd)$" 2>/dev/null; then
    echo "Reusing existing worktree: $WT_PATH (branch: $WT_BRANCH)"
    WORK_PATH="$(cd "$WT_PATH" && pwd)"
    return
  fi

  # Check if branch exists (local or remote)
  if git -C "$REPO_PATH" show-ref --verify --quiet "refs/heads/$WT_BRANCH" 2>/dev/null; then
    # Branch exists locally — create worktree from it
    echo "Creating worktree from existing branch: $WT_BRANCH"
    git -C "$REPO_PATH" worktree add "$WT_PATH" "$WT_BRANCH"
  else
    # New branch — fork from current HEAD
    echo "Creating worktree with new branch: $WT_BRANCH"
    git -C "$REPO_PATH" worktree add -b "$WT_BRANCH" "$WT_PATH"
  fi

  WT_CREATED=true
  WORK_PATH="$(cd "$WT_PATH" && pwd)"
  echo "  Worktree: $WORK_PATH"
  echo "  Branch:   $WT_BRANCH"
}

cleanup_worktree() {
  # Only consider cleanup for worktrees we created this session
  if [[ "$WT_CREATED" != true ]]; then
    return
  fi
  if [[ -z "$WT_PATH" || ! -d "$WT_PATH" ]]; then
    return
  fi

  local has_changes=false

  # Check for uncommitted changes (staged, unstaged, or untracked)
  if [[ -n "$(git -C "$WT_PATH" status --porcelain 2>/dev/null)" ]]; then
    has_changes=true
  fi

  # Check for unpushed commits vs the parent branch
  local commit_count
  commit_count=$(git -C "$WT_PATH" rev-list --count HEAD --not --remotes 2>/dev/null || echo "0")
  if [[ "$commit_count" -gt 0 ]]; then
    has_changes=true
  fi

  if [[ "$has_changes" == true ]]; then
    echo ""
    echo "Worktree kept (has changes):"
    echo "  Path:   $WT_PATH"
    echo "  Branch: $WT_BRANCH"
    echo ""
    echo "To push and create a PR:"
    echo "  cd $WT_PATH"
    echo "  git push -u origin $WT_BRANCH"
    echo "  gh pr create --draft"
    echo ""
    echo "To remove when done:"
    echo "  git -C $REPO_PATH worktree remove $WT_PATH"
    echo "  git -C $REPO_PATH branch -d $WT_BRANCH"
  else
    echo "Worktree clean — removing: $WT_PATH"
    git -C "$REPO_PATH" worktree remove "$WT_PATH" 2>/dev/null || true
    git -C "$REPO_PATH" branch -d "$WT_BRANCH" 2>/dev/null || true
  fi
}

# --- Session compaction ---
compact_session() {
  # Usage: compact_session <instance-id> <repo-name> <worktree-name>
  local instance_id="$1"
  local repo_name="$2"
  local wt_name="$3"
  local session_dir="$SESSIONS_BASE/$instance_id"
  local vault_dir
  if [ -n "${CLAUDE_VAULT_DIR:-}" ]; then
    vault_dir="$CLAUDE_VAULT_DIR/Work/Sessions/$repo_name"
  else
    vault_dir="$HOME/.claude/sandbox-sessions/$repo_name"
  fi
  local today
  today="$(date -u +%Y-%m-%d)"

  if [[ ! -d "$session_dir" ]]; then
    echo "  No session data for $instance_id — skipping compaction."
    return 0
  fi

  echo "  Compacting session $instance_id..."

  # Stage 1: Mechanical extraction
  local extract_json
  extract_json="$(mktemp "${TMPDIR:-/tmp}/compact-XXXXXX.json")"
  if ! python3 "$SANDBOX_DIR/compact-session.py" extract "$session_dir" \
      --repo-path="$REPO_PATH" --branch="claude/$wt_name" > "$extract_json" 2>/dev/null; then
    echo "  Warning: extraction failed for $instance_id — skipping compaction."
    rm -f "$extract_json"
    return 0
  fi

  # Check if extraction returned an error
  if python3 -c "import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if 'error' not in d else 1)" "$extract_json" 2>/dev/null; then
    : # no error
  else
    echo "  Warning: no session data found for $instance_id — skipping compaction."
    rm -f "$extract_json"
    return 0
  fi

  # Stage 2: API summarization (conditional)
  local user_count
  user_count="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('user_count',0))" "$extract_json")"

  local api_key="${ANTHROPIC_API_KEY:-${ANTHROPIC_ADMIN_API_KEY:-}}"
  local final_json="$extract_json"

  if [[ "$user_count" -gt 50 && -n "$api_key" ]]; then
    echo "  Large session ($user_count messages) — generating API summary..."
    local summarized_json
    summarized_json="$(mktemp "${TMPDIR:-/tmp}/compact-summary-XXXXXX.json")"
    if python3 "$SANDBOX_DIR/compact-session.py" summarize "$extract_json" \
        --api-key="$api_key" > "$summarized_json" 2>/dev/null; then
      final_json="$summarized_json"
    else
      echo "  Warning: API summarization failed — using mechanical summary."
    fi
  elif [[ "$user_count" -gt 50 && -z "$api_key" ]]; then
    echo "  No API key — using mechanical summary."
  fi

  # Generate vault markdown
  mkdir -p "$vault_dir"
  local vault_file="$vault_dir/${wt_name}_${today}.md"

  # Handle duplicate filenames
  if [[ -f "$vault_file" ]]; then
    local counter=2
    while [[ -f "${vault_dir}/${wt_name}_${today}_${counter}.md" ]]; do
      counter=$((counter + 1))
    done
    vault_file="${vault_dir}/${wt_name}_${today}_${counter}.md"
  fi

  python3 - "$final_json" "$repo_name" "$wt_name" "$vault_file" <<'PYEOF'
import json, sys, re
from datetime import datetime

json_file, repo_name, wt_name, vault_file = sys.argv[1:5]

with open(json_file) as f:
    data = json.load(f)

titles = data.get("titles", [])
user_count = data.get("user_count", 0)
assistant_count = data.get("assistant_count", 0)
pr_links = data.get("pr_links", [])
first_ts = data.get("first_timestamp", "")
last_ts = data.get("last_timestamp", "")
commits = data.get("commits")
files_changed = data.get("files_changed")
api_summary = data.get("api_summary")
user_messages = data.get("user_messages", [])

def ts_to_date(ts):
    try:
        dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
        return dt.strftime("%Y-%m-%d")
    except (ValueError, AttributeError):
        return "unknown"

first_date = ts_to_date(first_ts)
last_date = ts_to_date(last_ts)

if api_summary:
    summary_paragraph = api_summary
    key_decisions = ""
    problems = ""
    parts = re.split(r'\n(?=\d\.\s|#{1,3}\s|Key [Dd]ecisions|Problems [Ee]ncountered)', api_summary)
    if len(parts) >= 1:
        summary_paragraph = parts[0].strip()
    for part in parts[1:]:
        if re.match(r'(?:#{1,3}\s*)?Key [Dd]ecisions', part, re.IGNORECASE):
            key_decisions = re.sub(r'^(?:#{1,3}\s*)?Key [Dd]ecisions[:\s]*\n?', '', part, flags=re.IGNORECASE).strip()
        elif re.match(r'(?:#{1,3}\s*)?Problems', part, re.IGNORECASE):
            problems = re.sub(r'^(?:#{1,3}\s*)?Problems [Ee]ncountered[:\s]*\n?', '', part, flags=re.IGNORECASE).strip()
else:
    parts = []
    if titles:
        parts.append("Session topics: " + ", ".join(titles) + ".")
    if commits:
        commit_lines = commits.strip().split("\n")
        parts.append(f"{len(commit_lines)} commit(s) on branch claude/{wt_name}.")
    summary_paragraph = " ".join(parts) if parts else "No summary available."
    key_decisions = ""
    problems = ""

one_line = titles[0] if titles else f"Claude session on {repo_name}/claude/{wt_name}"
pr_formatted = ", ".join(f"[PR]({url})" for url in pr_links) if pr_links else "none"

lines = []
lines.append("---")
lines.append(f'title: "{repo_name} / {wt_name}"')
lines.append(f"summary: {one_line}")
lines.append(f"tags: [sessions, {repo_name}, archived]")
lines.append(f"created: {first_date}")
lines.append(f"updated: {last_date}")
lines.append("---")
lines.append("")
lines.append(f"- **Repo:** {repo_name}")
lines.append(f"- **Branch:** claude/{wt_name}")
lines.append(f"- **Dates:** {first_date} to {last_date}")
lines.append(f"- **Messages:** {user_count} user / {assistant_count} assistant")
lines.append(f"- **PRs:** {pr_formatted}")
lines.append("")
lines.append("### Summary")
lines.append(summary_paragraph)

if key_decisions:
    lines.append("")
    lines.append("### Key Decisions")
    lines.append(key_decisions)

if problems:
    lines.append("")
    lines.append("### Problems Encountered")
    lines.append(problems)

lines.append("")
lines.append("### Files Changed")
lines.append(files_changed if files_changed else "Branch no longer available.")

lines.append("")
lines.append("### Commits")
lines.append(commits if commits else "Branch no longer available.")
lines.append("")

with open(vault_file, "w") as f:
    f.write("\n".join(lines))

print(vault_file)
PYEOF

  # Update sessions index
  local index_file="$vault_dir/_Index.md"
  if [[ ! -f "$index_file" ]]; then
    cat > "$index_file" <<IDXEOF
---
title: "Sessions — $repo_name"
summary: Index of archived Claude Code sessions for $repo_name
tags: [sessions, $repo_name, index]
created: $today
updated: $today
---

| Date | Worktree | Summary | Link |
|------|----------|---------|------|
IDXEOF
  fi

  # Get one-line summary for index
  local one_line
  one_line="$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); t=d.get('titles',[]); print(t[0] if t else 'Session on claude/$wt_name')" "$final_json")"

  local file_basename
  file_basename="$(basename "$vault_file" .md)"

  # Append row to index (insert after the header row)
  sed -i '' "/^|------|/a\\
| $today | $wt_name | $one_line | [[$file_basename]] |
" "$index_file"

  # Update the updated date in index frontmatter
  sed -i '' "s/^updated: .*/updated: $today/" "$index_file"

  echo "  Archived to $(basename "$vault_file")"

  # Clean up temp files
  rm -f "$extract_json"
  [[ "$final_json" != "$extract_json" ]] && rm -f "$final_json"
}

# --- Delete a single worktree and its data ---
delete_worktree() {
  # Usage: delete_worktree <wt-name> <instance-id>
  local wt_name="$1"
  local instance_id="$2"
  local wt_path="$REPO_PATH/../$REPO_NAME-wt-$wt_name"
  local wt_branch="claude/$wt_name"

  # Compact session before deletion
  compact_session "$instance_id" "$REPO_NAME" "$wt_name"

  # Remove worktree if it exists
  if [[ -d "$wt_path" ]] || git -C "$REPO_PATH" worktree list --porcelain 2>/dev/null | grep -q "^worktree .*$wt_name"; then
    echo "  Removing worktree: $wt_path"
    git -C "$REPO_PATH" worktree remove "$wt_path" 2>/dev/null || true
  fi

  # Delete local branch
  if git -C "$REPO_PATH" show-ref --verify --quiet "refs/heads/$wt_branch" 2>/dev/null; then
    echo "  Deleting branch: $wt_branch"
    git -C "$REPO_PATH" branch -D "$wt_branch" 2>/dev/null || true
  fi

  # Remove session and audit data
  if [[ -d "$SESSIONS_BASE/$instance_id" ]]; then
    rm -rf "$SESSIONS_BASE/$instance_id"
    echo "  Removed session data: $instance_id"
  fi
  if [[ -d "$AUDIT_BASE/$instance_id" ]]; then
    rm -rf "$AUDIT_BASE/$instance_id"
    echo "  Removed audit data: $instance_id"
  fi
}

# --- fzf preview for worktree details ---
fzf_preview_worktree() {
  local wt_name="$1"
  local repo_path="$2"
  local repo_name="$3"
  local repo_hash="$4"
  local instance_id="${repo_name}-${repo_hash}-${wt_name}"
  local wt_branch="claude/$wt_name"
  local wt_path="$repo_path/../$repo_name-wt-$wt_name"

  echo "=== $wt_name ==="
  echo ""
  echo "Branch:   $wt_branch"

  if [[ -d "$wt_path" ]]; then
    wt_path="$(cd "$wt_path" && pwd)"
    echo "Path:     $wt_path"

    local last_commit
    last_commit="$(git -C "$wt_path" log -1 --format='%h %ar — %s' 2>/dev/null || echo "no commits")"
    echo "Last:     $last_commit"

    local staged unstaged untracked
    staged="$(git -C "$wt_path" diff --cached --numstat 2>/dev/null | wc -l | tr -d ' ')"
    unstaged="$(git -C "$wt_path" diff --numstat 2>/dev/null | wc -l | tr -d ' ')"
    untracked="$(git -C "$wt_path" ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d ' ')"
    echo "Changes:  $staged staged, $unstaged unstaged, $untracked untracked"

    local unpushed
    unpushed="$(git -C "$wt_path" rev-list --count HEAD --not --remotes 2>/dev/null || echo "?")"
    echo "Unpushed: $unpushed commit(s)"
  else
    echo "Path:     (no worktree — orphaned session)"
  fi

  local session_dir="$HOME/.claude/sandbox/sessions/$instance_id"
  if [[ -d "$session_dir" ]]; then
    local session_size
    session_size="$(du -sh "$session_dir" 2>/dev/null | cut -f1)"
    echo "Session:  $session_size"
  else
    echo "Session:  no data"
  fi

  if command -v gh &>/dev/null; then
    local pr_status
    pr_status="$(gh pr list --repo "$(git -C "$repo_path" remote get-url origin 2>/dev/null)" --head "$wt_branch" --state all --json state,number,title --jq '.[0] | "\(.state) — #\(.number) \(.title)"' 2>/dev/null || true)"
    if [[ -n "$pr_status" ]]; then
      echo "PR:       $pr_status"
    else
      echo "PR:       none found"
    fi
  fi
}

# --- Interactive worktree pruning ---
prune_worktrees() {
  local repo_hash repo_name_safe base_instance
  repo_name_safe="$REPO_NAME"
  repo_hash="$REPO_HASH"
  base_instance="${repo_name_safe}-${repo_hash}"

  local -a entries=()
  local -a entry_names=()

  while IFS= read -r line; do
    if [[ "$line" == "branch refs/heads/claude/"* ]]; then
      local name="${line#branch refs/heads/claude/}"
      local wt_path="$REPO_PATH/../$REPO_NAME-wt-$name"
      local status="clean"
      if [[ -d "$wt_path" ]]; then
        if [[ -n "$(git -C "$wt_path" status --porcelain 2>/dev/null)" ]]; then
          status="has changes"
        fi
        local unpushed
        unpushed="$(git -C "$wt_path" rev-list --count HEAD --not --remotes 2>/dev/null || echo "0")"
        if [[ "$unpushed" -gt 0 ]]; then
          status="has unpushed commits"
        fi
        local last_date
        last_date="$(git -C "$wt_path" log -1 --format='%as' 2>/dev/null || echo "unknown")"
        entries+=("$(printf '%-16s %-28s %-12s %s' "$name" "claude/$name" "$last_date" "$status")")
      else
        entries+=("$(printf '%-16s %-28s %-12s %s' "$name" "claude/$name" "n/a" "no worktree dir")")
      fi
      entry_names+=("$name")
    fi
  done < <(git -C "$REPO_PATH" worktree list --porcelain 2>/dev/null)

  for session_dir in "$SESSIONS_BASE/${base_instance}-"*; do
    [[ -d "$session_dir" ]] || continue
    local session_name
    session_name="$(basename "$session_dir")"
    [[ "$session_name" == "$base_instance" ]] && continue
    local suffix="${session_name#${base_instance}-}"
    local already_listed=false
    for en in "${entry_names[@]}"; do
      [[ "$en" == "$suffix" ]] && { already_listed=true; break; }
    done
    [[ "$already_listed" == true ]] && continue
    entries+=("$(printf '%-16s %-28s %-12s %s' "$suffix" "claude/$suffix" "n/a" "orphaned")")
    entry_names+=("$suffix")
  done

  if [[ ${#entries[@]} -eq 0 ]]; then
    echo "No worktrees found for $REPO_NAME."
    exit 0
  fi

  local -a selected_names=()

  if command -v fzf &>/dev/null; then
    export REPO_PATH REPO_NAME REPO_HASH SESSIONS_BASE SANDBOX_DIR
    export -f fzf_preview_worktree 2>/dev/null || true

    local header
    header="$(printf '%-16s %-28s %-12s %s' "NAME" "BRANCH" "LAST COMMIT" "STATUS")"

    local selected
    selected="$(printf '%s\n' "${entries[@]}" | \
      fzf --multi \
          --header="$header" \
          --preview="bash -c 'source $SANDBOX_DIR/claude-sandbox --_preview {1} \"$REPO_PATH\" \"$REPO_NAME\" \"$REPO_HASH\"'" \
          --preview-window=right:50%:wrap \
          --prompt="Select worktrees to delete (TAB to multi-select): " || true)"

    if [[ -z "$selected" ]]; then
      echo "No worktrees selected."
      exit 0
    fi

    while IFS= read -r line; do
      local name
      name="$(echo "$line" | awk '{print $1}')"
      selected_names+=("$name")
    done <<< "$selected"
  else
    echo "Worktrees for $REPO_NAME:"
    echo ""
    printf '  %-4s %-16s %-28s %-12s %s\n' "#" "NAME" "BRANCH" "LAST COMMIT" "STATUS"
    printf '  %-4s %-16s %-28s %-12s %s\n' "---" "----" "------" "-----------" "------"
    local idx=1
    for entry in "${entries[@]}"; do
      printf '  %-4s %s\n' "$idx)" "$entry"
      idx=$((idx + 1))
    done
    echo ""
    echo -n "Enter numbers to delete (comma-separated, e.g. 1,3,5): "
    read -r selection
    [[ -z "$selection" ]] && { echo "No selection."; exit 0; }
    IFS=',' read -ra indices <<< "$selection"
    for i in "${indices[@]}"; do
      i="$(echo "$i" | tr -d ' ')"
      if [[ "$i" =~ ^[0-9]+$ ]] && [[ "$i" -ge 1 ]] && [[ "$i" -le ${#entry_names[@]} ]]; then
        selected_names+=("${entry_names[$((i-1))]}")
      fi
    done
  fi

  if [[ ${#selected_names[@]} -eq 0 ]]; then
    echo "No valid worktrees selected."
    exit 0
  fi

  echo ""
  echo "Will delete ${#selected_names[@]} worktree(s):"
  for name in "${selected_names[@]}"; do
    echo "  - $name (claude/$name)"
  done
  echo ""
  echo -n "Proceed? (y/n): "
  read -r confirm
  if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
    echo "Cancelled."
    exit 0
  fi

  echo ""
  for name in "${selected_names[@]}"; do
    local instance="${base_instance}-${name}"
    echo "Deleting $name..."
    delete_worktree "$name" "$instance"
    echo ""
  done

  echo "Done. ${#selected_names[@]} worktree(s) cleaned up."
}

# --- GC: clean up worktrees with deleted remote branches ---
gc_worktrees() {
  local repo_hash repo_name_safe base_instance
  repo_name_safe="$REPO_NAME"
  repo_hash="$REPO_HASH"
  base_instance="${repo_name_safe}-${repo_hash}"

  echo "Fetching remote state..."
  git -C "$REPO_PATH" fetch --prune 2>/dev/null || true

  local -a gone_names=()
  while IFS= read -r line; do
    local branch_name track
    branch_name="$(echo "$line" | awk '{print $1}')"
    track="$(echo "$line" | awk '{print $2}')"
    if [[ "$branch_name" == claude/* && "$track" == "[gone]" ]]; then
      gone_names+=("${branch_name#claude/}")
    fi
  done < <(git -C "$REPO_PATH" for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads/claude/ 2>/dev/null)

  if [[ ${#gone_names[@]} -eq 0 ]]; then
    echo "No worktrees with deleted remote branches found."
    date -u +%Y-%m-%dT%H:%M:%SZ > "$STATE_DIR/.last-gc"
    exit 0
  fi

  echo ""
  printf '  %-16s %-28s %-12s %s\n' "WORKTREE" "BRANCH" "PR STATUS" "ACTION"
  printf '  %-16s %-28s %-12s %s\n' "--------" "------" "---------" "------"

  for name in "${gone_names[@]}"; do
    local pr_status="unknown"
    if command -v gh &>/dev/null; then
      local pr_state
      pr_state="$(gh pr list --repo "$(git -C "$REPO_PATH" remote get-url origin 2>/dev/null)" --head "claude/$name" --state all --json state --jq '.[0].state' 2>/dev/null || true)"
      if [[ -n "$pr_state" ]]; then
        pr_status="$(echo "$pr_state" | tr '[:upper:]' '[:lower:]')"
      else
        pr_status="none found"
      fi
    fi
    printf '  %-16s %-28s %-12s %s\n' "$name" "claude/$name" "$pr_status" "compact + delete"
  done

  echo ""
  echo -n "Clean up ${#gone_names[@]} worktree(s) with deleted remote branches? (y/n): "
  read -r confirm
  if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
    echo "Cancelled."
    exit 0
  fi

  echo ""
  for name in "${gone_names[@]}"; do
    local instance="${base_instance}-${name}"
    echo "Cleaning up $name..."
    delete_worktree "$name" "$instance"
    echo ""
  done

  date -u +%Y-%m-%dT%H:%M:%SZ > "$STATE_DIR/.last-gc"

  echo "Done. ${#gone_names[@]} worktree(s) cleaned up."
}

# --- Startup GC nudge (passive, non-blocking) ---
check_gc_nudge() {
  local last_gc_file="$STATE_DIR/.last-gc"
  local needs_check=false

  if [[ ! -f "$last_gc_file" ]]; then
    needs_check=true
  elif [[ "$(find "$last_gc_file" -mtime +7 -print -quit 2>/dev/null)" ]]; then
    needs_check=true
  fi

  [[ "$needs_check" == false ]] && return

  local gone_count=0
  while IFS= read -r line; do
    local branch_name track
    branch_name="$(echo "$line" | awk '{print $1}')"
    track="$(echo "$line" | awk '{print $2}')"
    if [[ "$branch_name" == claude/* && "$track" == "[gone]" ]]; then
      gone_count=$((gone_count + 1))
    fi
  done < <(git -C "$REPO_PATH" for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads/claude/ 2>/dev/null)

  if [[ "$gone_count" -gt 0 ]]; then
    echo "Note: $gone_count worktree(s) have deleted remote branches -- run 'claude-sandbox --gc $REPO_PATH' to clean up."
  fi
}

# --- Preview mode (called by fzf) ---
if [[ "$PREVIEW_MODE" == true ]]; then
  fzf_preview_worktree "${PREVIEW_ARGS[@]}"
  exit 0
fi

# --- Prune worktrees (early exit) ---
if [[ "$PRUNE_WORKTREES" == true ]]; then
  [[ -z "$REPO_PATH" ]] && usage

  if [[ "$REPO_PATH" != /* && "$REPO_PATH" != .* && -d "$HOME/Repositories/$REPO_PATH" ]]; then
    REPO_PATH="$HOME/Repositories/$REPO_PATH"
  fi
  REPO_PATH="$(cd "$REPO_PATH" && pwd)"
  REPO_NAME="$(basename "$REPO_PATH" | tr -c 'a-zA-Z0-9._-' '-' | sed 's/^-//;s/-$//')"
  REPO_HASH="$(printf '%s' "$REPO_PATH" | md5 | head -c 8)"

  prune_worktrees
  exit 0
fi

# --- GC worktrees (early exit) ---
if [[ "$GC_WORKTREES" == true ]]; then
  [[ -z "$REPO_PATH" ]] && usage

  if [[ "$REPO_PATH" != /* && "$REPO_PATH" != .* && -d "$HOME/Repositories/$REPO_PATH" ]]; then
    REPO_PATH="$HOME/Repositories/$REPO_PATH"
  fi
  REPO_PATH="$(cd "$REPO_PATH" && pwd)"
  REPO_NAME="$(basename "$REPO_PATH" | tr -c 'a-zA-Z0-9._-' '-' | sed 's/^-//;s/-$//')"
  REPO_HASH="$(printf '%s' "$REPO_PATH" | md5 | head -c 8)"

  gc_worktrees
  exit 0
fi

# --- GC nudge on normal launch ---
check_gc_nudge

# --- Run detection ---
detect_docker_need

# --- Set up worktree if requested ---
if [[ "$USE_WORKTREE" == true && "$GENERATE_ONLY" == false ]]; then
  setup_worktree
fi

# --- Generate Dockerfile if needed ---
mkdir -p "$SANDBOX_DIR/dockerfiles"
if [[ ! -f "$DOCKERFILE" || "$REBUILD" == true || "$GENERATE_ONLY" == true ]]; then
  generate_dockerfile
fi

[[ "$GENERATE_ONLY" == true ]] && exit 0

# --- Ensure base image exists ---
if ! docker image inspect claudebot:base &>/dev/null; then
  echo "Base image claudebot:base not found — building it now..."
  docker build -t claudebot:base -f "$SANDBOX_DIR/Dockerfile.base" "$SANDBOX_DIR"
  # Base just built — force per-repo rebuild
  REBUILD=true
fi

# --- Build image (skip if already exists and no rebuild requested) ---
if [[ "$REBUILD" == true ]] || ! docker image inspect "$IMAGE_TAG" &>/dev/null; then
  echo ""
  echo "Building $IMAGE_TAG..."
  docker build \
    -f "$DOCKERFILE" \
    -t "$IMAGE_TAG" \
    "$SANDBOX_DIR"
else
  echo ""
  echo "Using cached $IMAGE_TAG (use --rebuild to force)"
fi

# --- Run container ---
AUDIT_DIR="$AUDIT_BASE/$INSTANCE_ID"
SESSIONS_DIR="$SESSIONS_BASE/$INSTANCE_ID"
mkdir -p "$AUDIT_DIR" "$SESSIONS_DIR" "$STATE_DIR"

AUTH_MARKER="$STATE_DIR/.auth-configured"

echo ""
echo "Starting Claude Code in Pattern C sandbox for $INSTANCE_ID..."
echo "  Workspace: $WORK_PATH -> /workspace"
if [[ "$USE_WORKTREE" == true ]]; then
  echo "  Branch: $WT_BRANCH"
fi
echo "  Audit: $AUDIT_DIR -> /audit"
echo "  State: $STATE_DIR -> /home/claudebot/.claude (persistent)"
echo "  Sessions: $SESSIONS_DIR -> /home/claudebot/.claude/projects"
echo "  Plugins: ~/.claude/plugins -> /home/claudebot/.claude/plugins (read-only)"
if [[ -f "$AUTH_MARKER" ]]; then
  echo "  Cloud MCPs: authenticated (read-only, write ops denied)"
else
  echo "  Cloud MCPs: not yet authenticated (login will be prompted)"
fi

# Detect installed toolchains from the generated Dockerfile
TOOLCHAIN_LIST=""
if [[ -f "$DOCKERFILE" ]]; then
  TOOLCHAIN_LIST=$(grep '# ---' "$DOCKERFILE" 2>/dev/null | sed 's/# --- //;s/ ---.*//' | paste -sd ', ' - || true)
  if grep -q 'uv/install' "$DOCKERFILE" 2>/dev/null; then
    TOOLCHAIN_LIST="${TOOLCHAIN_LIST:+$TOOLCHAIN_LIST, }uv"
  fi
fi

# Build docker run args
DOCKER_ARGS=(
  --rm -it
  --name "claudebot-$RUN_ID"
  --cap-drop all
  --security-opt no-new-privileges
  --group-add 0
  --memory 8g
  --cpus 4
  --pids-limit 512
  -v "$WORK_PATH:/workspace"
  -v "$AUDIT_DIR:/audit"
  -v "$STATE_DIR:/home/claudebot/.claude"
  -v "$SESSIONS_DIR:/home/claudebot/.claude/projects"
  -v "$OP_SOCKET:/run/1password/agent.sock"
  -v "$HOME/.claude/plugins:/home/claudebot/.claude/plugins:ro"
  -v "$HOME/.claude/plugins:$HOME/.claude/plugins:ro"
  # Config files — bind-mounted (not baked into image) so edits don't
  # bust the Docker layer cache for toolchain installs.
  -v "$SANDBOX_SETTINGS:/home/claudebot/.claude-defaults/settings.json:ro"
  -v "$SANDBOX_DIR/audit.sh:/home/claudebot/.claude-defaults/hooks/audit.sh:ro"
  -v "$SANDBOX_DIR/sandbox-CLAUDE.md:/home/claudebot/.claude-defaults/CLAUDE.md:ro"
  -v "$SANDBOX_DIR/statusline-command.sh:/home/claudebot/.claude-defaults/statusline-command.sh:ro"
  -v "$SANDBOX_DIR/entrypoint.sh:/usr/local/bin/entrypoint.sh:ro"
  -e SSH_AUTH_SOCK=/run/1password/agent.sock
  -e SANDBOX_REPO_NAME="$REPO_NAME"
  -e SANDBOX_TOOLCHAINS="$TOOLCHAIN_LIST"
)

# Forward API key only when OAuth is not configured (they conflict)
if [[ -n "${ANTHROPIC_API_KEY:-}" && ! -f "$AUTH_MARKER" ]]; then
  DOCKER_ARGS+=(-e ANTHROPIC_API_KEY)
fi

# Forward worktree branch if applicable
if [[ "$USE_WORKTREE" == true && -n "$WT_BRANCH" ]]; then
  DOCKER_ARGS+=(-e SANDBOX_BRANCH="$WT_BRANCH")
fi

# GitHub CLI authentication (read-only access)
# Token is delivered via gh config file mounted read-only, NOT as an
# environment variable. This prevents Python/Node subprocesses from
# reading it via os.environ and bypassing the gh deny rules.
GH_AUTH_METHOD=""
GH_HOSTS_TMPFILE=""
GH_TOKEN=""

if [[ -n "${GITHUB_TOKEN:-}" ]]; then
  GH_TOKEN="$GITHUB_TOKEN"
  GH_AUTH_METHOD="GITHUB_TOKEN"
elif command -v gh &>/dev/null; then
  GH_TOKEN="$(gh auth token 2>/dev/null || true)"
  [[ -n "$GH_TOKEN" ]] && GH_AUTH_METHOD="host-keyring"
fi

if [[ -n "$GH_TOKEN" ]]; then
  GH_HOSTS_TMPFILE="$(mktemp "${TMPDIR:-/tmp}/gh-hosts-XXXXXX")"
  chmod 600 "$GH_HOSTS_TMPFILE"
  cat > "$GH_HOSTS_TMPFILE" <<GHEOF
github.com:
    oauth_token: ${GH_TOKEN}
    git_protocol: https
GHEOF
  unset GH_TOKEN
  DOCKER_ARGS+=(
    -v "$GH_HOSTS_TMPFILE:/home/claudebot/.gh-staging/hosts.yml:ro"
  )
  echo "  GitHub: authenticated via $GH_AUTH_METHOD (token in gh config, not env — write ops blocked)"
else
  unset GH_TOKEN
  echo "  GitHub: no auth found — run 'gh auth login' on the host or set GITHUB_TOKEN"
fi

# Start Docker socket proxy if needed
if [[ "$NEEDS_DOCKER" == true ]]; then
  start_proxy
  DOCKER_ARGS+=(
    --network "$NETWORK_NAME"
    -e DOCKER_HOST="tcp://$PROXY_NAME:2375"
    -e HOST_REPO_PATH="$WORK_PATH"
  )
  echo "  Docker: via socket proxy (exec/build/commit/system blocked)"
else
  echo "  Docker: not needed (no compose files detected)"
fi

echo ""

# --- OAuth authentication for cloud MCPs ---
# Run as a separate short-lived container so it gets its own proper TTY.
# The auth state persists in STATE_DIR (mounted at ~/.claude/).
# Re-authenticate if the marker is missing or older than 30 days
AUTH_NEEDED=false
if [[ ! -f "$AUTH_MARKER" ]]; then
  AUTH_NEEDED=true
elif find "$AUTH_MARKER" -mtime +30 -print -quit 2>/dev/null | grep -q .; then
  AUTH_NEEDED=true
  echo "OAuth session is >30 days old — re-authenticating."
fi

if [[ "$AUTH_NEEDED" == true ]]; then
  echo "================================================"
  echo "  Cloud MCP authentication (one-time setup)"
  echo "================================================"
  echo ""
  echo "Cloud MCPs (Jira, Slack, Notion, Gmail, etc.) require"
  echo "an OAuth login with your Anthropic account."
  echo ""
  if docker run --rm -it \
    --init \
    --entrypoint "" \
    --cap-drop all \
    --security-opt no-new-privileges \
    -v "$STATE_DIR:/home/claudebot/.claude" \
    -v "$SANDBOX_SETTINGS:/home/claudebot/.claude/settings.json:ro" \
    "$IMAGE_TAG" claude auth login; then
    touch "$AUTH_MARKER"
    echo ""
    echo "Authentication saved. Future launches will skip this step."
    echo "To re-authenticate: rm $AUTH_MARKER"
  else
    echo ""
    echo "Authentication skipped. Cloud MCPs won't be available this session."
  fi
  echo ""
fi

# Remove stale container from a previous run (--rm only cleans up on normal exit)
if docker inspect "claudebot-$RUN_ID" &>/dev/null; then
  echo "Stopping existing sandbox for $RUN_ID..."
  docker rm -f "claudebot-$RUN_ID" >/dev/null
fi

# --- Cleanup on exit ---
cleanup() {
  # Remove temporary gh config file (contains token)
  if [[ -n "${GH_HOSTS_TMPFILE:-}" && -f "$GH_HOSTS_TMPFILE" ]]; then
    rm -f "$GH_HOSTS_TMPFILE"
  fi
  if [[ "$NEEDS_DOCKER" == true ]]; then
    stop_proxy
  fi
  if [[ "$USE_WORKTREE" == true ]]; then
    cleanup_worktree
  fi
}
trap cleanup EXIT

docker run "${DOCKER_ARGS[@]}" "$IMAGE_TAG"

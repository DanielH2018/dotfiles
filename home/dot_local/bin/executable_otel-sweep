#!/usr/bin/env python3
"""otel-sweep — read the Claude Code telemetry stack on every machine, unprompted.

Exists for the same reason as `otelq`, one layer out. `otelq` already carries a
blanket allow because its host is a hardcoded constant; the moment the question
became "and what about daniel-box and daniel-server?", the only tools that could
answer were ssh and curl, both ask-listed for good reason. This closes that gap
without widening either.

The confinement is structural, not a check. There is no --host, --url, --query
or --output flag: the destinations are a fixed enum below, and the program that
runs on each machine is PROBE, one module-level constant delivered on stdin to
`python3 -`. No element of any command is ever built from an argument, so there
is no position where a caller-supplied string could become a command. subprocess
is always called with an argv list and never with a shell, so there is nothing
to escape from either. Output is JSON on stdout; nothing is written to disk.

PROBE reaches loopback first and a fixed table of cluster addresses second. That
second candidate is what makes the sweep survive a reschedule: the backends bind
their query ports to 127.0.0.1 on whichever node they land on, so a reboot can
move the whole query path to the other machine. Both candidates are constants
and both must pass an RFC1918 check, so neither position can be reached by a
caller-supplied string.

  otel-sweep                 # fast sweep of all three machines
  otel-sweep --deep          # adds sessions that are exporting nowhere
  otel-sweep --only box      # one machine
  otel-sweep --rows          # compact text instead of JSON
  otel-sweep watch           # the daily check: deep sweep, log, notify on findings

Read-only by construction: every request is a GET, and PROBE writes no files.

`watch` is the one subcommand with side effects, and they are fixed: it writes
syslog through `logger`, raises a desktop notification through `notify-send`, and
keeps two small state files under $XDG_STATE_HOME/otel-sweep-watch. Both programs
are literals in this file, and the sweep it summarises runs in this process, so
nothing in the environment or argv names a program to run. The only caller-shaped
input is `watch --stdin`, which reads sweep JSON instead of sweeping; that JSON is
data summarised into one argv element of `logger` and `notify-send`, never a
position of a command.
"""

from __future__ import annotations

import argparse
import contextlib
import json
import os
import shutil
import socket
import subprocess
import sys
import time

PROG = "otel-sweep"

# Not configurable, and deliberately so — see the module docstring. A --host
# flag would turn this into the arbitrary-ssh primitive the allow rule assumes
# it is not. "local" runs PROBE here; the others dial a fixed destination.
HOSTS = {
    "local": None,
    "box": "daniel-box",
    "server": "daniel-server",
}

# Machines allowed to hold a collector and no query backend, so that answering
# with no backends is reported as expected rather than as an outage. daniel-box
# and daniel-server are one k3s cluster: every node runs the otel-collector
# DaemonSet, while Loki, Prometheus and Tempo are single-replica Deployments that
# land on whichever node the scheduler picks. Nothing pins them — on 2026-08-23 a
# reboot moved all three from daniel-box to daniel-server.
#
# This only suppresses when a machine has NO backend ready. That was the normal
# case for a node holding no pods; since PROBE falls back to the ClusterIP it is
# not, because a node without the pods now reports them ready anyway. So the
# suppression is close to dead code, and the honest end state is probably to drop
# it and let a no-backends row speak for itself. Left in place for now because
# removing it changes what the daily watcher reports, which deserves its own
# change rather than riding along with this one.
#
# Events from either node land in the same Loki; split them by os_version, since
# nothing in the pipeline records a hostname. Read the live kernels from
# `kubectl get nodes -o wide` rather than trusting a value written down here.
COLLECTOR_ONLY = {"server"}

SSH_OPTS = [
    "-o", "BatchMode=yes",
    "-o", "ConnectTimeout=5",
    "-o", "StrictHostKeyChecking=accept-new",
    # ~/.ssh/config forwards ports to these hosts, and a second connection cannot
    # bind them again — three lines of "Address already in use" on every probe.
    # Harmless, but it turns a daily timer's journal into noise, and this tool
    # needs no forwarding of its own.
    "-o", "ClearAllForwardings=yes",
    # Both machines run UFW's `limit ssh`, so the 6th connection from one source
    # inside 30s is rejected — and probe() reports a rejected connection as the
    # machine being unreachable, which is this tool alarming about a firewall it
    # tripped itself. A blanket allow rule makes otel-sweep cheap to invoke, so
    # six runs in half a minute is an ordinary afternoon rather than an edge case.
    # Reusing one connection per host caps a burst at a single TCP connection,
    # twelve times under the budget instead of one run over it. The socket gets
    # its own name so a probe never adopts an interactive session's forwardings,
    # and %C hashes the destination to keep the path inside the AF_UNIX limit.
    "-o", "ControlMaster=auto",
    "-o", "ControlPath=~/.ssh/otel-sweep-%C",
    "-o", "ControlPersist=60",
]

DEFAULT_TIMEOUT = 120

# How many SILENT lines --rows prints before summarising the rest. The compact
# view is the only place a cap belongs: the JSON payload carries every session,
# and the summary line carries the count, so nothing here can hide a total.
ROW_SILENT_LIMIT = 10

# Long enough to outlast the transients that actually occur here — a WireGuard
# rekey, a firewall rate limiter's window — and short enough that a machine that
# is genuinely down still costs one extra connect timeout, not a stalled timer.
RETRY_PAUSE = 3

# The whole remote side, as a constant. Nothing is substituted into it; the mode
# arrives as argv so this string stays fixed at every call site.
PROBE = r'''
import calendar
import json
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

MODE = sys.argv[1] if len(sys.argv) > 1 else "fast"
BACKENDS = (
    ("loki", 3100, "/ready"),
    ("prometheus", 9090, "/-/ready"),
    ("tempo", 3200, "/ready"),
)
RFC1918 = re.compile(r"^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)[0-9.]+$")
out = {"backends": {}}


def get(url, timeout=15):
    with urllib.request.urlopen(url, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")


# The cluster address of each backend, used when the node-local hostPort has
# nothing behind it. These are k3s Deployments with no nodeSelector that publish
# their query ports on a hostPort bound to 127.0.0.1, so a reboot that
# reschedules a pod moves that port to the other node — on 2026-08-23 all three
# landed on daniel-server and every loopback probe from daniel-box read
# "unreachable" while the telemetry itself was healthy. A ClusterIP is routed on
# every node, so it answers wherever the pod is.
#
# Fixed constants, matching otelq's own list and the pinned clusterIP in
# ansible/roles/k8s/claude-otel/templates/. Nothing here is caller-supplied, and
# the RFC1918 check below still refuses anything that is not a private address.
CLUSTER_IP = {
    "loki": "10.43.99.158",
    "prometheus": "10.43.39.218",
    "tempo": "10.43.4.147",
}


def cluster_ip(name):
    """The in-cluster address for a backend, when it is a private one."""
    candidate = CLUSTER_IP.get(name)
    if candidate and RFC1918.match(candidate):
        return candidate
    return None


def resolve(name, port, ready):
    for host in ("127.0.0.1", cluster_ip(name)):
        if not host:
            continue
        base = "http://" + host + ":" + str(port)
        try:
            get(base + ready, timeout=5)
            return base
        except (urllib.error.URLError, OSError):
            continue
    return None


BASE = {}
for name, port, ready in BACKENDS:
    BASE[name] = resolve(name, port, ready)
    out["backends"][name] = "ready" if BASE[name] else "unreachable"

# Which STORE this machine read, as opposed to which address it read it through.
# Every tally below is a property of the store, not of the machine asking, so two
# machines on one store return the same numbers and a per-host label on them is a
# fiction — on 2026-09-02 the watch reported "local: 9 api_error events" and
# "server: 9 api_error events" for the same 9 events, reading as 18.
#
# The discriminator is reachability of the cluster Loki, NOT which candidate
# resolve() picked: daniel-box answers on loopback because the pod happens to be
# there, daniel-server answers only on the ClusterIP, and both are one Loki. A
# ClusterIP is routed on cluster nodes alone, so a machine that reaches it is on
# the cluster store and a machine that cannot is on its own.
#
# Deliberately not a process fingerprint. Loki is a single-replica Deployment on
# an RWO volume, so process_start_time_seconds moves on every reschedule while
# the store stays put — an identity that changes when the data does not would
# split the group at the next pod restart.
_cluster_loki = cluster_ip("loki")
if _cluster_loki:
    try:
        get("http://" + _cluster_loki + ":3100/ready", timeout=5)
        out["store"] = "cluster"
    except (urllib.error.URLError, OSError):
        out["store"] = "local"


def loki(query, path="/loki/api/v1/query", strict=False, **extra):
    """Query Loki. `strict` re-raises instead of returning [].

    Every caller but one treats an empty result as "nothing happened", which is
    the right reading for a tally. It is the wrong reading for the silent-session
    scan, where empty means "no session ever exported" and would condemn every
    transcript on the disk. That caller passes strict=True.
    """
    if not BASE["loki"]:
        return []
    params = {"query": query}
    params.update(extra)
    url = BASE["loki"] + path + "?" + urllib.parse.urlencode(params)
    try:
        return json.loads(get(url)).get("data", {}).get("result", [])
    except (urllib.error.URLError, OSError, ValueError):
        if strict:
            raise
        return []


CC = '{service_name="claude-code"}'


def tally(query, label):
    """One-label aggregations; the label is named so a missing one is visible."""
    return {
        r.get("metric", {}).get(label, "?"): int(float(r["value"][1]))
        for r in loki(query)
    }


def count(inner, label, window="24h"):
    return tally(
        "sum by (" + label + ") (count_over_time(" + CC + inner + " [" + window + "]))",
        label,
    )


out["events_24h"] = count(" | event_name != ``", "event_name")
# DECIDED: a pattern, not a list of names. The list read `api_error|api_refusal`
# and missed `internal_error` entirely — 7 events over 30d that no output ever
# showed. That is the second time an explicit enumeration here under-reported,
# and the failure modes are not symmetric: a pattern that matches something
# benign produces a finding a human reads once and narrows, while a list that
# misses a name produces silence indistinguishable from health. Same reasoning
# the transcript-scan ruleset gives for falling back to the full set when its
# config is missing. Measured 2026-08-31: over 30d the only names matching are
# api_error (9), internal_error (7) and api_refusal (2).
out["errors_24h"] = count(" | event_name=~`.*(error|refusal).*`", "event_name")
# The same events again, split by their message rather than their name, so a
# consumer can tell an incident from ordinary volume. `api_error` alone cannot:
# on 2026-09-02 it carried 11 rate-limit rejections, which are what a busy day
# looks like, and 2 dead-OAuth-token failures on a nightly timer, which is an
# outage nobody would otherwise see. Aggregating by name reports 13 of one thing.
#
# Cardinality is bounded by the distinct message texts a provider emits, not by
# the event count — 13 events over 24h produced 2 keys here. A store that ever
# returns hundreds should get a `topk` rather than an unbounded `sum by`.
out["error_messages_24h"] = count(" | event_name=~`.*(error|refusal).*`", "error")
out["hook_errors_24h"] = count(
    " | event_name=`hook_execution_complete` | num_non_blocking_error != `0`",
    "hook_event",
)
out["mcp_24h"] = count(" | event_name=`mcp_server_connection`", "status")
out["tool_failures_24h"] = count(
    " | event_name=`tool_result` | success=`false`", "tool_name"
)
out["sessions_24h"] = len(
    loki("sum by (session_id) (count_over_time(" + CC + " [24h]))")
)

# query_range without an explicit start silently returns empty — see the role's
# CLAUDE.md on daniel-box, where that cost an afternoon.
DAY_NS = str(int((time.time() - 86400) * 1e9))
out["compactions_24h"] = []
rows = loki(
    CC + " | event_name=`compaction`",
    "/loki/api/v1/query_range",
    start=DAY_NS,
    limit="20",
)
for r in rows:
    stream = r.get("stream", {})
    out["compactions_24h"].append({
        "at": stream.get("event_timestamp"),
        "trigger": stream.get("trigger"),
        "precompute_reuse": stream.get("precompute_reuse"),
        "pre_tokens": stream.get("pre_tokens"),
        "post_tokens": stream.get("post_tokens"),
    })

newest = loki(
    CC, "/loki/api/v1/query_range", start=DAY_NS, limit="1", direction="backward"
)
stamps = [v[0] for r in newest for v in r.get("values", [])]
out["newest_event_ns"] = max(stamps) if stamps else None

if MODE == "deep":
    import pathlib

    STAMP = re.compile(rb'"timestamp":"([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z)"')

    def last_activity(path, st, tail=65536):
        """When this session last wrote a line, from the transcript's own content.

        Not st_mtime. Transcripts get re-stamped by things that are not the
        session — a retention sweep touched four transcripts from 2026-08-18/19
        on 2026-08-23, and mtime alone presented all four as active sessions
        holding zero events, which is precisely the shape of the finding this
        check exists to raise. Four false alarms in one run is how a daily check
        gets muted.

        Reads the tail rather than the file: transcripts reach hundreds of MB and
        the last timestamp is always near the end. Falls back to st_mtime when no
        timestamp is found, which keeps a transcript in a format this does not
        recognise visible rather than silently dropping it from the scan.
        """
        try:
            with open(path, "rb") as fh:
                if st.st_size > tail:
                    fh.seek(-tail, 2)
                found = STAMP.findall(fh.read())
        except OSError:
            return st.st_mtime
        if not found:
            return st.st_mtime
        text = found[-1].decode("ascii", "replace")
        try:
            parsed = time.strptime(text[:19], "%Y-%m-%dT%H:%M:%S")
        except ValueError:
            return st.st_mtime
        # The stamps are UTC ("...Z"), so calendar.timegm, not time.mktime.
        return calendar.timegm(parsed)

    def is_hermetic_eval(path, head=65536):
        """True when this transcript is a hermetic agent-eval run.

        evals/lib/claude-cli.mjs runs `claude -p --agent <name> --setting-sources
        project`, which skips the user settings that carry the OTEL env, so these
        sessions never export by design. On 2026-10-03 one eval fan-out wrote 203
        of them and they buried the real silent sessions for two days (dotfiles
        #784). The signature is both halves: an `agent-setting` record (only
        `--agent` writes one, and no other headless launcher passes it) and an
        `sdk-cli` entrypoint on the first user record. `entrypoint` alone is too
        broad — every fan-out agent and cron run is sdk-cli and does export.
        """
        agent = False
        try:
            with open(path, "rb") as fh:
                lines = fh.read(head).splitlines()
        except OSError:
            return False
        for line in lines:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if rec.get("type") == "agent-setting":
                agent = True
            elif rec.get("type") == "user":
                return agent and rec.get("entrypoint") == "sdk-cli"
        return False

    # A session whose transcript is being written while Loki has none of its
    # events is exporting nowhere. That is the failure this tool exists for.
    #
    # Loki is also the only evidence that any session exported at all, so when it
    # is unreachable the query returns nothing and EVERY recently-written
    # transcript looks silent. The unreachable backend is already a finding on its
    # own; letting it manufacture a second finding per transcript is how one
    # outage becomes a wall of alarms about sessions that are exporting fine.
    # Skip the check instead of reporting all of it.
    silent = []
    candidates = []
    evals = 0
    checked = False
    if BASE["loki"]:
        cutoff = time.time() - 48 * 3600
        for path in (pathlib.Path.home() / ".claude" / "projects").glob("*/*.jsonl"):
            try:
                st = path.stat()
            except OSError:
                continue
            if last_activity(path, st) < cutoff:
                continue
            # Counted, not dropped: a skipped transcript stays visible as a number.
            if is_hermetic_eval(path):
                evals += 1
                continue
            candidates.append((path.stem, st))

        # Ask only about the sessions in hand. `sum by (session_id)` over every
        # session in 720h trips Loki's 500-series ceiling once the history is a
        # few weeks deep, and the HTTP 400 that comes back is indistinguishable
        # from an empty result — which marked every recent transcript silent,
        # live and exporting ones included (measured 2026-08-21). Filtering to
        # the candidate ids bounds the series count by the number of transcripts.
        # In batches: the ids ride in a URL query string, and a long enough one
        # is rejected by the same HTTP 400 this rewrite exists to avoid. 50 ids
        # is ~1.9kB of URL, comfortably inside any limit, and batching drops no
        # session the way a cap would.
        exported = set()
        checked = True
        for i in range(0, len(candidates), 50):
            ids = "|".join(sid for sid, _ in candidates[i:i + 50])
            try:
                rows = loki(
                    "sum by (session_id) (count_over_time("
                    + CC + " | session_id=~`" + ids + "` [720h]))",
                    strict=True,
                )
            except Exception:
                checked = False
                break
            for r in rows:
                sid = r.get("metric", {}).get("session_id")
                if sid:
                    exported.add(sid)

        if checked:
            for sid, st in candidates:
                if sid in exported:
                    continue
                silent.append({
                    "session": sid,
                    "mb": round(st.st_size / 1048576, 1),
                    "modified": time.strftime(
                        "%Y-%m-%dT%H:%M:%SZ", time.gmtime(st.st_mtime)
                    ),
                })
    # Uncapped on purpose. This list was sliced to the ten largest until
    # 2026-08-31, and otel-sweep-watch reports `silent=N` as len() of it — so a
    # night with 24 silent sessions alerted as 10 and read as the whole truth.
    # The renderers below may show fewer, but they say so; the payload may not
    # lie, because it is what every count downstream is computed from.
    out["silent_sessions"] = sorted(silent, key=lambda s: s["mb"], reverse=True)
    out["silent_checked"] = checked
    out["sessions_on_disk_48h"] = len(candidates)
    out["eval_sessions_skipped_48h"] = evals

print(json.dumps(out))
'''


def is_self(dest):
    """True when `dest` names the machine this is running on.

    Compared on the first label only, so `daniel-box` matches whether the host
    reports a bare name or an FQDN. `None` is the local entry and is never
    "self" in this sense — it has no ssh hop to skip.
    """
    if dest is None:
        return False
    return dest.split(".")[0] == socket.gethostname().split(".")[0]


def dest_for(name):
    """The ssh destination for a machine, or None to run PROBE here.

    `--only box` on daniel-box should read this machine rather than fail on a
    self-ssh, so a named host that resolves to us degrades to the local path.
    """
    dest = HOSTS[name]
    return None if is_self(dest) else dest


def probe(dest, mode, timeout):
    """Reach one machine, tolerating a single transient.

    A refused or unrouteable connection is not evidence a machine is down: the
    ssh path here crosses a WireGuard tunnel that rekeys and a UFW rate limiter
    that rejects bursts, and both recover within seconds. Reporting the first
    failure as "unreachable" is what turns those into a desktop notification
    about a machine that is fine. Only the ssh path can fail this way, so the
    local probe is not retried.
    """
    result = probe_once(dest, mode, timeout)
    if dest is None or "error" not in result:
        return result
    time.sleep(RETRY_PAUSE)
    return probe_once(dest, mode, timeout)


def probe_once(dest, mode, timeout):
    """Run PROBE on one machine. argv is constants; there is no shell."""
    if dest is None:
        argv = ["python3", "-", mode]
    else:
        argv = ["ssh", *SSH_OPTS, dest, "python3", "-", mode]
    try:
        done = subprocess.run(
            argv, input=PROBE, capture_output=True, text=True, timeout=timeout
        )
    except subprocess.TimeoutExpired:
        return {"error": f"timed out after {timeout}s"}
    except OSError as exc:
        return {"error": str(exc)}
    if done.returncode != 0:
        detail = (done.stderr or f"exit {done.returncode}").strip()
        return {"error": detail[:400]}
    try:
        return json.loads(done.stdout)
    except ValueError:
        return {"error": "unparseable probe output: " + done.stdout.strip()[:200]}


def render_rows(results):
    for name, data in results.items():
        if "error" in data:
            print(f"{name:<8} UNREACHABLE  {data['error']}")
            continue
        ready = [k for k, v in data.get("backends", {}).items() if v == "ready"]
        events = sum(data.get("events_24h", {}).values())
        if name in COLLECTOR_ONLY and not ready:
            print(
                f"{name:<8} collector-only — no query backend; "
                "counts live in box (split by os_version)"
            )
            continue
        silent = data.get("silent_sessions", [])
        # The count goes on the summary line, not just the SILENT lines below it.
        # Without it, a capped list of SILENT lines reads as the complete set, which
        # is exactly how 24 silent sessions were reported as 10 and believed.
        summary = (
            f"{name:<8} ready={','.join(ready) or 'none':<26} "
            f"events={events:<6} sessions={data.get('sessions_24h', 0)}"
        )
        # Conditioned on the scan having run, not on it having found something.
        # A clean run must say silent=0, so that a missing count reads as "the
        # scan did not run" rather than "the scan was happy" — the same reason
        # otel-sweep-watch prints its own count unconditionally.
        if data.get("silent_checked"):
            summary += f" silent={len(silent)}"
            if data.get("eval_sessions_skipped_48h"):
                summary += f" evals-skipped={data['eval_sessions_skipped_48h']}"
        print(summary)
        for bad, n in sorted(data.get("errors_24h", {}).items()):
            print(f"         {bad}={n}")
        if data.get("silent_checked") is False:
            print("         silent-session check did not run (Loki query failed)")
        for entry in silent[:ROW_SILENT_LIMIT]:
            print(
                f"         SILENT {entry['session'][:8]} "
                f"({entry['mb']}MB, {entry['modified']})"
            )
        if len(silent) > ROW_SILENT_LIMIT:
            print(
                f"         ... and {len(silent) - ROW_SILENT_LIMIT} more "
                "(--deep without --rows lists them all)"
            )


# --- watch: the daily check that every machine is actually exporting telemetry ---
#
# The failure this exists for is silent by construction: a session started before its
# collector was up exports nothing for its entire life, while pods stay green and the
# counters keep climbing. Two of them went unnoticed for three days each. A journal line
# nobody reads would be exactly as invisible, so findings raise a desktop notification —
# the one place this deviates from the other health timers here.
#
# What counts as a finding is deliberately narrow, because a check that cries wolf daily
# gets muted and then detects nothing:
#   - a machine that cannot be reached at all
#   - Loki unreachable on a machine that answered (nothing is recorded without it)
#   - a session whose transcript is growing while Loki holds none of its events
#   - an error whose MESSAGE is not a known-benign one; a rate-limit rejection is
#     what a busy day looks like, so counting it as a fault made the verdict red
#     on ordinary use, and a check that is red every day is one nobody reads
# Counts are attributed to the STORE that holds them rather than to the machine
# that queried it, because nothing in the pipeline records a hostname and two
# cluster nodes read one Loki — reporting per host turned 9 errors into 18.
# Prometheus or Tempo being unreachable is NOT a finding: daniel-server legitimately
# runs no Tempo, so flagging it would fire every single day forever. Loki gets the same
# treatment on a machine otel-sweep marks `queryable: false` — daniel-server has been a
# collector-only k3s worker since 2026-08-13, holding the otel-collector DaemonSet and
# no query backend at all, so "Loki unreachable" there is the expected answer and its
# zeros mean "not queryable from here", never "nothing is being recorded". Its events
# are in box's totals.
#
# Exits non-zero on findings so `systemctl --user --failed` is a second, passive signal.

WATCH_PROG = "otel-sweep-watch"

SILENT_FINDING_LIMIT = 5

# DECIDED: benign errors are named LITERALLY here, where otel-sweep's errors_24h
# takes a broad pattern over an enumeration. Both follow the same asymmetry, and
# it points opposite ways on the two sides. There, a pattern that misses an error
# NAME produces silence indistinguishable from health, so breadth is the safe
# error. Here, an entry that is too broad silences a real fault, while one that
# is too narrow costs a finding somebody reads once and widens — so this list
# takes the narrowest thing that works. Prefix match on a measured sentence, not
# a `rate.?limit` regex, which would also swallow a quota exhaustion worth waking
# for. Measured 2026-09-02: 13 api_errors, 11 this rejection and 2 a dead OAuth
# token on a nightly timer that had been failing since 2026-08-20.
BENIGN_ERROR_PREFIXES = ("This request would exceed your account's rate limit",)

# Seconds a finding set stays quiet after it raised a notification. OTEL_SWEEP_WATCH_
# REPEAT_AFTER overrides it because a test has to be able to close the window; nothing
# in the environment can name a program to run.
DEFAULT_REPEAT_AFTER = 21600


def is_benign(message):
    return message.startswith(BENIGN_ERROR_PREFIXES)


def summarise(data):
    """The sweep's JSON as (report lines, findings)."""
    findings, lines = [], []

    # Every tally the sweep collects is a property of the STORE, not of the machine
    # that asked for it — nothing in the pipeline records a hostname. Two machines on
    # one Loki therefore return one set of numbers twice, and labelling each copy
    # with a host invents a second incident: on 2026-09-02 this reported "local: 9
    # api_error events" and "server: 9 api_error events" for the same 9 events.
    # Group by the store, and report each number once, against the store holding it.
    #
    # A machine whose sweep does not say which store it read groups alone, so an
    # older otel-sweep degrades to the previous per-host output and two stores can
    # never be merged by accident.
    groups = {}
    for host in sorted(data):
        d = data[host]
        if "error" in d:
            findings.append(f"{host}: unreachable ({d['error'][:80]})")
            lines.append(f"{host}: UNREACHABLE")
            continue
        if d.get("queryable") is False:
            lines.append(f"{host}: collector-only - counts live in box")
            continue
        if d.get("backends", {}).get("loki") != "ready":
            findings.append(f"{host}: Loki unreachable - nothing is being recorded")
        if d.get("silent_checked") is False:
            findings.append(
                f"{host}: silent-session check did not run - Loki query failed"
            )
        # Host-derived, and the only findings that are: a silent session is read from
        # THIS machine's transcripts against the store, so it stays per-host however
        # the stores group.
        silent = d.get("silent_sessions", [])
        # One line per session up to the cap, then a count. A fan-out of short-lived
        # sessions that all missed the exporter is one incident, and 23 near-identical
        # findings train the reader to skip the block. The `silent=` line below still
        # carries the honest total, because it is a len() over the uncapped payload.
        for s in silent[:SILENT_FINDING_LIMIT]:
            findings.append(
                f"{host}: session {s['session'][:8]} exporting nowhere ({s['mb']}MB)"
            )
        if len(silent) > SILENT_FINDING_LIMIT:
            findings.append(
                f"{host}: and {len(silent) - SILENT_FINDING_LIMIT} "
                "more sessions exporting nowhere"
            )
        groups.setdefault(d.get("store") or ("host:" + host), []).append(host)

    def merged(hosts, field):
        """The largest count each key reached across a store's machines.

        Equal by construction — they queried one store — but the queries run seconds
        apart, so a key can land on one side of the window and not the other. Taking
        the max means that skew can never make a group under-report.
        """
        out = {}
        for h in hosts:
            for key, n in (data[h].get(field) or {}).items():
                out[key] = max(out.get(key, 0), int(n))
        return out

    for store in sorted(groups):
        hosts = groups[store]
        events = max(sum((data[h].get("events_24h") or {}).values()) for h in hosts)
        sessions = max(data[h].get("sessions_24h", 0) for h in hosts)

        if len(hosts) == 1:
            label = hosts[0]
            silent_n = len(data[hosts[0]].get("silent_sessions", []))
            lines.append(
                f"{label}: events={events} sessions={sessions} silent={silent_n}"
            )
        else:
            # The shared totals once, then the one number that really is per-machine.
            label = f"{store} store ({', '.join(hosts)})"
            lines.append(f"{label}: events={events} sessions={sessions}")
            for h in hosts:
                silent_n = len(data[h].get("silent_sessions", []))
                lines.append(f"  {h}: silent={silent_n}")

        messages = merged(hosts, "error_messages_24h")
        if messages:
            benign = sum(n for msg, n in messages.items() if is_benign(msg))
            for msg, n in sorted(messages.items()):
                if not is_benign(msg):
                    findings.append(f"{label}: {n} x {msg[:90]}")
            # Benign volume stays in the beat and out of the verdict. Dropping it from
            # both would trade a noisy detector for a blind one — a rate-limit count
            # that tripled is worth finding afterwards, even though it wakes nobody.
            if benign:
                lines.append(
                    f"{label}: {benign} rate-limited request(s) in 24h, not a fault"
                )
        else:
            # No message breakdown means no class judgement is possible, so every
            # error counts. This is what the check did before the sweep reported
            # messages, and it is the right reading of a sweep that still does not.
            for name, n in sorted(merged(hosts, "errors_24h").items()):
                findings.append(f"{label}: {n} {name} events in 24h")
    return lines, findings


def render_report(lines, findings):
    """The report text, without trailing newlines."""
    text = "\n".join(lines) + "\n"
    if findings:
        text += "FINDINGS:\n" + "".join(f"  {f}\n" for f in findings)
    return text.rstrip("\n")


def _crc_table():
    table = []
    for i in range(256):
        crc = i << 24
        for _ in range(8):
            crc = (crc << 1) ^ 0x04C11DB7 if crc & 0x80000000 else crc << 1
            crc &= 0xFFFFFFFF
        table.append(crc)
    return table


_CRC_TABLE = _crc_table()


def cksum(data):
    """POSIX `cksum`'s CRC of `data`, reproduced exactly.

    last-notified stores this fingerprint, written by the shell version through
    `cksum`. Any other hash would make every existing state file mismatch once,
    and the first run after the change would re-notify for a finding set that
    had already been announced.
    """
    crc = 0
    for byte in data:
        crc = ((crc << 8) & 0xFFFFFFFF) ^ _CRC_TABLE[((crc >> 24) ^ byte) & 0xFF]
    length = len(data)
    while length:
        crc = ((crc << 8) & 0xFFFFFFFF) ^ _CRC_TABLE[((crc >> 24) ^ length) & 0xFF]
        length >>= 8
    return ~crc & 0xFFFFFFFF


def _field(content, number):
    """`cut -d' ' -f<number>` over every line of `content`, joined and trimmed.

    A line with no space is printed whole by cut, whichever field was asked for,
    and a shell `$(...)` drops the trailing newlines. Both are kept so that a
    state file written by the shell version reads back the same way.
    """
    out = []
    for line in content.split("\n"):
        parts = line.split(" ")
        if len(parts) == 1:
            out.append(line)
        else:
            out.append(parts[number - 1] if number <= len(parts) else "")
    return "\n".join(out).rstrip("\n")


def _squash(text, limit):
    """`tr '\\n' ';' | cut -c1-<limit>`."""
    return text.replace("\n", ";")[:limit]


def _run_fixed(argv, discard_stderr=False):
    """Run a fixed program for its side effect; failing to run it is not a failure here.

    Every position of argv is a literal in this file except the message, which is
    sweep data and one element of the list — there is no shell for it to escape into.
    """
    sys.stdout.flush()
    with contextlib.suppress(OSError):
        subprocess.run(
            argv, stderr=subprocess.DEVNULL if discard_stderr else None, check=False
        )


def watch(from_stdin):
    """Summarise a deep sweep, record it, and raise the alarm if it found anything.

    The sweep runs in this process: there is no program for a caller to name, so the
    confinement in the module docstring holds. `--stdin` exists as the test seam and
    reads the same JSON document the sweep would have produced.
    """
    if from_stdin:
        raw = sys.stdin.buffer.read().rstrip(b"\n")
        if not raw:
            print(f"{WATCH_PROG}: sweep produced no output", file=sys.stderr)
            return 2
        try:
            data = json.loads(raw.decode("utf-8"))
        except ValueError:
            data = None
    else:
        # deep is the point: silent-session detection is the only check here that the
        # fast pass cannot make. It costs a per-session Loki query on each machine,
        # affordable once a day.
        data = sweep("deep")
    try:
        if data is None:
            raise ValueError("unparseable sweep output")
        report = render_report(*summarise(data))
    except Exception:  # noqa: BLE001 - any shape the summary cannot read is unparseable
        report = None

    print(report or "")
    if report is None:
        print(f"{WATCH_PROG}: could not parse sweep output", file=sys.stderr)
        return 2

    state_home = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.environ.get("HOME") or os.path.expanduser("~"), ".local", "state"
    )
    state_dir = os.path.join(state_home, WATCH_PROG)

    report_lines = report.split("\n")
    marker = next((i for i, ln in enumerate(report_lines) if "FINDINGS:" in ln), None)
    if marker is None:
        # A clean run says so, so that "no line today" reads as "the check did not run"
        # rather than "the check was happy" — but only to someone reading back. Nothing
        # watches for the absence of an up beat: `probe.py alerts` reads status=down
        # lines, and no Kuma push monitor exists for this check. The up line is a
        # durable record for a post-hoc grep, not an alert. It uses the same shape as
        # the other host health checks so that adding such a monitor later needs no
        # change here.
        if shutil.which("logger"):
            _run_fixed(
                ["logger", "-t", WATCH_PROG, "status=up " + _squash(report, 300)]
            )
        # Clear the statusline banner (see below): a clean run must make it go away, or
        # the last finding's banner would outlive the finding it named.
        with contextlib.suppress(OSError):
            os.remove(os.path.join(state_dir, "findings-pending"))
        return 0

    text = "\n".join(report_lines[marker + 1 :]).rstrip("\n")

    # An unchanged finding set tells you nothing the last banner already did, and this
    # check kept no memory, so anything that persisted raised a fresh notification on
    # every single run. Re-notify when the findings change, or when the window lapses
    # — a problem that is still there should resurface rather than go quiet for good.
    last_notified = os.path.join(state_dir, "last-notified")
    try:
        repeat_after = int(
            os.environ.get("OTEL_SWEEP_WATCH_REPEAT_AFTER") or DEFAULT_REPEAT_AFTER
        )
    except ValueError:
        repeat_after = None
    fingerprint = str(cksum(text.encode("utf-8")))
    now = int(time.time())
    notify = True
    if os.access(last_notified, os.R_OK):
        try:
            with open(last_notified, encoding="utf-8", errors="replace") as fh:
                content = fh.read()
        except OSError:
            content = ""
        since_text = _field(content, 2)
        since = int(since_text) if since_text.isascii() and since_text.isdigit() else 0
        if (
            _field(content, 1) == fingerprint
            and repeat_after is not None
            and now - since < repeat_after
        ):
            notify = False

    # syslog first, and unconditionally — this is the only channel that works on the
    # machine where it matters most. On daniel-box there is no desktop bus for
    # notify-send, the user journal held no record of this unit at all, and
    # `SuccessExitStatus=1` kept it out of `systemctl --user --failed`. So on
    # 2026-08-23 this check correctly found a dead query path and told nobody. Syslog
    # reaches Loki, which is where the other host health checks report and where
    # `probe.py alerts` already looks; `status=` is their convention.
    #
    # Outside the notify gate deliberately. That gate exists to stop a repeat
    # *notification* becoming noise, and a log line is not noise. A record written only
    # on runs that happened to change the fingerprint is a record with holes in it.
    if shutil.which("logger"):
        _run_fixed(["logger", "-t", WATCH_PROG, "status=down " + _squash(text, 400)])

    if notify:
        # Best effort: a headless box has no bus, and the syslog line above is the
        # durable record.
        if shutil.which("notify-send"):
            body = "\n".join(text.split("\n")[:5]).rstrip("\n")
            _run_fixed(
                [
                    "notify-send",
                    "--urgency=normal",
                    "--icon=dialog-warning",
                    "Claude telemetry",
                    body,
                ],
                discard_stderr=True,
            )
        try:
            os.makedirs(state_dir, exist_ok=True)
            with open(last_notified, "w", encoding="utf-8") as fh:
                fh.write(f"{fingerprint} {now}\n")
        except OSError:
            pass

    # A channel that works on daniel-box, where there is no desktop bus for
    # notify-send: a statusline banner, the same way claude-transcript-scan's leak
    # marker works (private_dot_claude/executable_statusline-command.sh, "Segment:
    # transcript credential leaks"). Written unconditionally, unlike the
    # notify-send/last-notified pair above — the banner is not a notification that
    # repeats, it is a standing "still true" fact, so it is rewritten every down run
    # regardless of the repeat-window, and cleared only by the clean-run branch above.
    try:
        os.makedirs(state_dir, exist_ok=True)
        with open(
            os.path.join(state_dir, "findings-pending"), "w", encoding="utf-8"
        ) as fh:
            fh.write(text + "\n")
    except OSError:
        pass

    # The unit still exits non-zero on findings, on purpose: `systemctl --user --failed`
    # is a second, passive signal that works whether or not anyone is looking at a
    # statusline right now, and removing it once traded away the ONLY signal that fired
    # on 2026-08-23 (see the SuccessExitStatus note in the unit file). The banner adds
    # a channel; it does not replace this one.
    return 1


def sweep(mode, only=None, timeout=DEFAULT_TIMEOUT):
    """Probe the machines and return {name: result}, `queryable` marked."""
    if only:
        targets = [only]
    else:
        # "local" already covers whichever machine this is, so sweeping its named
        # entry as well would ssh to ourselves and duplicate the row. Before this,
        # running on daniel-box reported `box UNREACHABLE` every time: the shared
        # ~/.ssh/config gives that host IdentityFiles belonging to another machine,
        # so the self-loop fails on a key that does not exist here. A tool alarming
        # about a machine it is running on is noise that trains the reader to skip
        # findings.
        targets = [name for name in sorted(HOSTS) if not is_self(HOSTS[name])]
    results = {name: probe(dest_for(name), mode, timeout) for name in targets}

    # A collector-only machine answers no query, so its zeros are absence of
    # evidence. Say so in the JSON too, or a reader takes silent_sessions: []
    # for "clean" when it means "never looked".
    for name in targets:
        data = results[name]
        ready = [k for k, v in data.get("backends", {}).items() if v == "ready"]
        if name in COLLECTOR_ONLY and "error" not in data and not ready:
            data["queryable"] = False
    return results


def main():
    argv = sys.argv[1:]
    if argv[:1] == ["watch"]:
        wp = argparse.ArgumentParser(
            prog=f"{PROG} watch",
            description="Summarise a deep sweep, log it, and notify on findings.",
        )
        wp.add_argument(
            "--stdin",
            action="store_true",
            help="read the sweep JSON from stdin instead of sweeping (test seam)",
        )
        return watch(wp.parse_args(argv[1:]).stdin)

    ap = argparse.ArgumentParser(
        prog=PROG,
        description="Read the Claude Code telemetry stack on every machine.",
        epilog="Subcommand: `otel-sweep watch` is the daily check (see `watch -h`).",
    )
    ap.add_argument(
        "--deep", action="store_true", help="add silent-session detection"
    )
    ap.add_argument(
        "--only", choices=sorted(HOSTS), help="sweep a single machine"
    )
    ap.add_argument(
        "--rows", action="store_true", help="compact text instead of JSON"
    )
    ap.add_argument(
        "--timeout", type=int, default=DEFAULT_TIMEOUT,
        help="per-machine timeout in seconds",
    )
    ns = ap.parse_args(argv)

    results = sweep("deep" if ns.deep else "fast", ns.only, ns.timeout)

    if ns.rows:
        render_rows(results)
    else:
        json.dump(results, sys.stdout, indent=2)
        sys.stdout.write("\n")
    return 0 if any("error" not in r for r in results.values()) else 1


if __name__ == "__main__":
    sys.exit(main())

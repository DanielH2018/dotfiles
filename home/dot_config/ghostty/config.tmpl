{{- /*
Ghostty runs on macOS and Linux, and the two platforms disagree about the modifier a terminal
owns. On macOS cmd is the app modifier and cmd+c/cmd+v are the system clipboard.

On Linux ctrl belongs to the shell and to full-screen apps, and it is not merely "conventionally"
taken — every chord these binds need is already load-bearing there:

  ctrl+c  SIGINT              ctrl+d  EOF / exit
  ctrl+w  zsh kill-word,      ctrl+[  *is* Escape — rebinding it breaks vim outright
          vim window prefix   ctrl+t  fzf's file widget (see dot_zshrc.tmpl)

super (the Meta/Win key) is the one modifier the terminal never claims, so it stands in for cmd
and every Mac chord keeps its shape rather than being reshuffled onto ctrl+shift.

  $mod   single-modifier actions      cmd        -> super
  $mod2  the "shifted" variant        cmd+shift  -> super+shift
  $clip  clipboard + reload           cmd+shift  -> ctrl+shift    (the Linux convention and
                                                                   Ghostty's own default there,
                                                                   so it deliberately does NOT
                                                                   follow $mod2)

super moves the collision from the shell to the desktop, which is the better trade because the
desktop's bindings are configurable and the shell's are muscle memory. KWin claims a global
shortcut before Ghostty ever sees the key, so the four it owns here — Meta+T (Edit Tiles),
Meta+W (Overview), Meta+D (Peek at Desktop), Meta+V (Klipper) — are moved to Meta+Ctrl+* by
.chezmoiscripts/os-linux/run_onchange_kde-free-ghostty-chords.sh.tmpl. Meta+Shift+{T,W,D,[,]}
and Meta+{C,[,]} are unclaimed, so $mod2 and the clipboard binds need no such treatment.

On darwin all three vars keep their original values and every addition below is non-darwin
gated, so the rendered macOS config stays byte-identical to what it was before Linux was added.
*/ -}}
{{- $mod := "cmd" -}}
{{- $mod2 := "cmd+shift" -}}
{{- $clip := "cmd+shift" -}}
{{- if ne .chezmoi.os "darwin" -}}
{{-   $mod = "super" -}}
{{-   $mod2 = "super+shift" -}}
{{-   $clip = "ctrl+shift" -}}
{{- end -}}
# =============================================================================
# GHOSTTY CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# FONT CONFIGURATION
# -----------------------------------------------------------------------------
font-family = "{{ .terminal.font_family }} {{ .terminal.font_weight }}"
font-size = {{ .terminal.font_size }}
font-thicken = true
font-thicken-strength = 50
font-feature = {{ range $i, $f := .terminal.font_features }}{{ if $i }},{{ end }}+{{ $f }}{{ end }}

# -----------------------------------------------------------------------------
# WINDOW APPEARANCE & BEHAVIOR
# -----------------------------------------------------------------------------
# Window properties
window-width = {{ .terminal.cols }}
window-height = {{ .terminal.rows }}
window-vsync = true
window-step-resize = true
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
window-inherit-font-size = true
window-decoration = true
#window-theme = auto
window-new-tab-position = end
link-previews = true
{{ if eq .chezmoi.os "darwin" }}# display-p3 is a macOS-only colorspace; Ghostty warns about it on Linux.
window-colorspace = display-p3
{{ end }}
theme = "{{ .terminal.theme }}"

# Window padding
window-padding-x = {{ .terminal.padding }}
window-padding-y = {{ .terminal.padding }}
window-padding-balance = true
window-padding-color = extend

# Background effects
background-opacity = 1.0
background-blur = false
background-image-opacity = 0.2
background-image-position = center-center
background-image-fit = stretch

# Split window styling
unfocused-split-opacity = 0.6

# Cell adjustments
adjust-cell-height = 1
adjust-cell-width = 0

{{ if eq .chezmoi.os "darwin" -}}
# -----------------------------------------------------------------------------
# MACOS SPECIFIC SETTINGS
# -----------------------------------------------------------------------------
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = visible
macos-option-as-alt = true
macos-secure-input-indication = true
macos-icon = holographic
macos-icon-frame = chrome
macos-icon-ghost-color = crimson
{{ end }}


# -----------------------------------------------------------------------------
# CURSOR CONFIGURATION
# -----------------------------------------------------------------------------
cursor-color = {{ .terminal.cursor_color }}
cursor-style = block
cursor-style-blink = true
cursor-click-to-move = true

# -----------------------------------------------------------------------------
# SELECTION STYLING
# -----------------------------------------------------------------------------
#selection-background = #1e1e2e
#selection-foreground = #f8f8f2

# -----------------------------------------------------------------------------
# MOUSE BEHAVIOR
# -----------------------------------------------------------------------------
mouse-hide-while-typing = true
# Selections must reach the system CLIPBOARD, not just PRIMARY. The default (`true`) writes
# PRIMARY only, so Ctrl+V kept pasting whatever was in the clipboard from before — measured
# with the selection sitting in PRIMARY at 40 bytes while CLIPBOARD still held a stale newline.
#
# ctrl+shift+c is not a workaround for it: `copy_to_clipboard` acts on the selection that
# exists when the key is pressed, and a full-screen TUI that repaints (Claude Code) clears the
# selection first. `copy-on-select` captures at selection time, before anything can repaint.
#
# The cost is that any mouse selection now overwrites the clipboard, which is why `true` is the
# default. Deliberate: a selection here is nearly always intended as a copy.
copy-on-select = clipboard


# -----------------------------------------------------------------------------
# SHELL INTEGRATION
# -----------------------------------------------------------------------------
shell-integration = zsh
#shell-integration-features = true

# No `command =` line: a Ghostty surface opens a plain login shell.
#
# Every surface used to start its own tmux session, because agentview's picker was a tmux
# window and the C-Left bind that reached it needed a tmux layer in every pane. Both are
# retired, so the layer had nothing left to carry. Sessions that want tmux still get it —
# the `claude()` function in dot_config/shell/common.sh wraps a bare `claude` outside Warp,
# which is what makes a session survive a closed window.

# Set TERM for better Vim compatibility
term = xterm-ghostty


# -----------------------------------------------------------------------------
# NOTIFICATIONS
# -----------------------------------------------------------------------------
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 10s

# -----------------------------------------------------------------------------
# TERMINAL BEHAVIOR
# -----------------------------------------------------------------------------
scrollback-limit = {{ .terminal.scrollback }}
confirm-close-surface = false
quit-after-last-window-closed = false
clipboard-trim-trailing-spaces = true
bell-features = system,attention,title

# -----------------------------------------------------------------------------
# CUSTOM EFFECTS
# -----------------------------------------------------------------------------
#custom-shader-animation = true
#custom-shader = ~/.config/ghostty/shaders/cursor_smear_rainbow.glsl
# -----------------------------------------------------------------------------
# KEY BINDINGS
# -----------------------------------------------------------------------------
# Configuration management
keybind = {{ $clip }}+r=reload_config

# Clipboard operations
keybind = {{ $clip }}+c=copy_to_clipboard
keybind = {{ $clip }}+v=paste_from_clipboard

# Tab management
keybind = {{ $mod }}+t=new_tab

# Window management
keybind = {{ $mod }}+w=close_surface
keybind = {{ $mod2 }}+t=new_window
keybind = {{ $mod2 }}+w=close_all_windows

# Split management
keybind = {{ $mod }}+d=new_split:right
keybind = {{ $mod2 }}+d=new_split:down
keybind = {{ $mod }}+[=goto_split:previous
keybind = {{ $mod }}+]=goto_split:next
keybind = {{ $mod2 }}+[=resize_split:left,10
keybind = {{ $mod2 }}+]=resize_split:right,10

# Terminal operations
keybind = shift+enter=text:\n
#keybind = global:{{ $mod2 }}+period=toggle_quick_terminal
{{ if ne .chezmoi.os "darwin" }}
# Linux extras
# super+c/v mirror macOS's cmd+c/cmd+v, which Ghostty binds natively on darwin but not here.
# The $clip (ctrl+shift) pair above is left in place, so both reflexes work.
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# ctrl+t is the one ctrl chord worth spending: its only occupant is fzf's file widget, which
# dot_zshrc.tmpl moves to alt+t. The other ctrl chords these binds would want (d, w, [) are
# terminal control codes with no escape hatch, so they stay on super alone.
keybind = ctrl+t=new_tab

# Tab switching by number, in the shape cmd+1..9 has on macOS: 1-8 jump to that tab, 9 jumps
# to the last one. The digits are the second ctrl chord worth spending. ctrl+1 and ctrl+9 emit
# nothing at all, and the control codes the rest legacy-encode each keep a dedicated key that
# still reaches the shell: ctrl+3 ESC (esc), ctrl+4 ^\ (ctrl+backslash), ctrl+5 ^], ctrl+7 ^_,
# ctrl+8 ^? (backspace). The one real casualty is vim's Ctrl-^ alternate-file when typed as
# ctrl+6 — reach it as ctrl+shift+6 instead.
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=last_tab

# ...and Ghostty's own alt+1..9 tab chords are given up in exchange, because they are not free
# to leave registered. A keybind Ghostty matches is consumed before the running program sees
# the key — only `performable:` binds fall through, and the tab defaults are not performable —
# so alt+<digit> can never reach a full-screen TUI. Claude Code's session switcher
# (`claude agents`, "alt+1-N to open") is the case that surfaced it: the tab changed instead.
# Both spellings are registered by default and both have to go; alt+9 is last_tab, not
# goto_tab:9. ctrl+1..9 above already covers tab switching, so nothing is lost.
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind
keybind = alt+digit_1=unbind
keybind = alt+digit_2=unbind
keybind = alt+digit_3=unbind
keybind = alt+digit_4=unbind
keybind = alt+digit_5=unbind
keybind = alt+digit_6=unbind
keybind = alt+digit_7=unbind
keybind = alt+digit_8=unbind
keybind = alt+digit_9=unbind
{{ end }}


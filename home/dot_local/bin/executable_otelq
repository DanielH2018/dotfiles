#!/usr/bin/env python3
"""otelq — query the local Loki/Prometheus telemetry stack without a prompt.

Exists for the same reason as `jsonq`: the useful operation was reachable only
through a tool that is ask-listed for good reason. `curl:*` prompts because curl
takes an arbitrary URL and can write the response to disk — an exfiltration and
a download primitive in one. Neither is available here. The host is not an
argument: every request goes to 127.0.0.1 on the two ports below, the method is
always GET, and the response only ever reaches stdout. What the caller controls
is a LogQL/PromQL string, and neither language can execute a process, read a
file, or reach the network. That is what makes a blanket `Bash(otelq:*)` allow
rule defensible where `Bash(curl:*)` is not.

  otelq logs 'sum by (event_name) (count_over_time({service_name="claude-code"}[19h]))'
  otelq logs '{service_name="claude-code"} | event_name=`api_error`' --stream --limit 5
  otelq metric 'sum by (model) (increase(claude_code_cost_usage_USD_total[19h]))'
  otelq labels --name service_name
  otelq ready

Output is JSON on stdout so it composes with jsonq. `--rows` renders the common
"value<TAB>labels" shape instead, which is what most ad-hoc queries wanted.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

PROG = "otelq"

# Not configurable, and deliberately so — see the module docstring. A --host flag
# would turn this into the arbitrary-fetch primitive the allow rule assumes it
# is not.
LOKI = "http://127.0.0.1:3100"
PROM = "http://127.0.0.1:9090"
TEMPO = "http://127.0.0.1:3200"

DEFAULT_TIMEOUT = 30
MAX_OUTPUT_BYTES = 10 * 1024 * 1024

_DURATION = re.compile(r"^(\d+)([smhdw])$")
_UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800}

# `savings` fetches raw event lines and aggregates in Python rather than in
# LogQL. That is not a style preference. Grouping in LogQL forces `bash_command`
# as the key, which holds only the first token of the command — `cd` alone
# accounts for ~40% of Bash calls, so a per-command ranking built on it
# attributes work to a directory change instead of to whatever did the work.
# The full text is in `tool_parameters`, a JSON string *inside* the line, and
# extracting it there needs a double parse whose every line then carries
# `__error__="JSONParserErr"` — which Loki refuses to aggregate over unless the
# aggregation drops the label. Reading the lines and counting here avoids all
# three problems and is testable without a backend.
SAVINGS_LIMIT = 5000

# Tokens that never name the program that did the work. Segment-skips consume
# the rest of the segment (`cd /some/path`); token-skips consume only
# themselves, so `sudo dnf` still reports `dnf`.
_SEGMENT_SKIP = frozenset({
    "cd", "export", "set", "unset", "local", "readonly", "shift", "return",
    "source", ".", "eval", ":",
})
_TOKEN_SKIP = frozenset({
    "sudo", "command", "env", "time", "exec", "nohup", "builtin", "then",
    "do", "else", "elif", "fi", "done", "if", "while", "for", "until", "!",
    "{", "}", "(", ")",
})
_ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
_SPLIT_SEGMENTS = re.compile(r"\|\||&&|[;|\n&]")


def program_of(command):
    """Name the program a shell command actually runs.

    The first token is usually not it: `cd x && grep y` is a grep, and
    `PATH=... node t.js` is a node. Walks segments left to right, skipping
    directory changes, variable assignments and shell keywords, and returns the
    first real program by basename so `/home/x/.local/bin/otelq` and `otelq`
    are one entry rather than two.
    """
    if not command:
        return "?"
    for segment in _SPLIT_SEGMENTS.split(command):
        for token in segment.split():
            if _ASSIGNMENT.match(token):
                continue
            bare = token.strip("\"'`(){}")
            if not bare or bare.startswith("-"):
                # A flag belongs to a token we already skipped — `command -v x`
                # is an x, not a `-v`.
                continue
            if bare in _SEGMENT_SKIP:
                break
            if bare in _TOKEN_SKIP:
                continue
            return bare.rsplit("/", 1)[-1]
    return "?"


class OtelqError(Exception):
    """A refusal we raise ourselves — reported without a traceback."""


def parse_duration(text):
    """'19h' -> 68400. Rejects anything else, so it can't smuggle a URL fragment."""
    m = _DURATION.match(text)
    if not m:
        raise OtelqError(f"bad duration {text!r}: use forms like 90s, 30m, 19h, 7d")
    return int(m.group(1)) * _UNITS[m.group(2)]


def _get(base, path, params, timeout):
    """GET only. urlencode keeps the query in the query string, so a crafted
    query cannot climb out of `path` into another endpoint."""
    url = f"{base}{path}?{urllib.parse.urlencode(params)}"
    req = urllib.request.Request(url, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:  # noqa: S310
            body = resp.read(MAX_OUTPUT_BYTES + 1)
    except urllib.error.HTTPError as exc:
        detail = exc.read(2048).decode("utf-8", "replace").strip()
        raise OtelqError(f"{base}{path}: HTTP {exc.code} {detail}") from None
    except urllib.error.URLError as exc:
        raise OtelqError(
            f"{base} unreachable ({exc.reason}) — is the stack up? `docker ps`"
        ) from None
    except TimeoutError:
        raise OtelqError(f"{base}{path}: timed out after {timeout}s") from None

    if len(body) > MAX_OUTPUT_BYTES:
        raise OtelqError(
            "response exceeds the 10 MB cap; narrow the query or the range"
        )
    try:
        return json.loads(body)
    except json.JSONDecodeError as exc:
        raise OtelqError(f"{base}{path}: response was not JSON ({exc.msg})") from None


def _window(since, now):
    return now - parse_duration(since), now


def cmd_logs(ns, now):
    """Loki. Instant by default because that is what an aggregation wants;
    --stream switches to query_range, which is what returns raw log lines."""
    if ns.stream:
        start, end = _window(ns.since, now)
        params = {
            "query": ns.query,
            "start": str(int(start)),
            "end": str(int(end)),
            "limit": str(ns.limit),
            "direction": ns.direction,
        }
        return _get(LOKI, "/loki/api/v1/query_range", params, ns.timeout)
    return _get(LOKI, "/loki/api/v1/query",
                {"query": ns.query, "time": str(int(now))}, ns.timeout)


def cmd_metric(ns, now):
    if ns.stream:
        start, end = _window(ns.since, now)
        params = {
            "query": ns.query,
            "start": str(int(start)),
            "end": str(int(end)),
            "step": ns.step,
        }
        return _get(PROM, "/api/v1/query_range", params, ns.timeout)
    return _get(PROM, "/api/v1/query",
                {"query": ns.query, "time": str(int(now))}, ns.timeout)


def cmd_labels(ns, now):
    start, end = _window(ns.since, now)
    params = {"start": str(int(start) * 10**9), "end": str(int(end) * 10**9)}
    if ns.name:
        label = urllib.parse.quote(ns.name, safe="")
        return _get(LOKI, f"/loki/api/v1/label/{label}/values", params, ns.timeout)
    return _get(LOKI, "/loki/api/v1/labels", params, ns.timeout)


def cmd_ready(ns, now):
    """Readiness of every backend the stack publishes. Loki answers text, not
    JSON, so it is probed separately — a 503 here usually means the 15s
    ingester grace, not a fault. Tempo is included even though no subcommand
    queries it yet: leaving it out reported the stack healthy while traces
    were down, which is the one signal Grafana can reach and this tool
    cannot."""
    out = {}
    for name, base, path in (("loki", LOKI, "/ready"),
                             ("prometheus", PROM, "/-/ready"),
                             ("tempo", TEMPO, "/ready")):
        url = f"{base}{path}"
        try:
            with urllib.request.urlopen(url, timeout=ns.timeout) as resp:  # noqa: S310
                out[name] = {"code": resp.status,
                             "body": resp.read(200).decode("utf-8", "replace").strip()}
        except urllib.error.HTTPError as exc:
            out[name] = {"code": exc.code,
                         "body": exc.read(200).decode("utf-8", "replace").strip()}
        except (urllib.error.URLError, TimeoutError) as exc:
            out[name] = {"code": None, "body": f"unreachable: {exc}"}
    return out


def _savings_fetch(selector, since, now, timeout, limit=SAVINGS_LIMIT):
    """Raw event lines over a window, as the label maps Loki returns.

    `| json` lifts every event field into the stream labels, so one event is one
    stream and the caller gets a dict per event without parsing the body again.
    """
    start, end = _window(since, now)
    payload = _get(LOKI, "/loki/api/v1/query_range", {
        "query": selector,
        "start": str(int(start)),
        "end": str(int(end)),
        "limit": str(limit),
        "direction": "backward",
    }, timeout)
    events = []
    for series in (payload.get("data") or {}).get("result") or []:
        labels = series.get("stream") or {}
        events.extend(labels for _ in series.get("values") or [])
    return events


def _command_of(event):
    """The full shell command behind a Bash event, or '' for other tools.

    `tool_parameters` is a JSON *string* inside the line, which is why nothing
    upstream can group on its contents.
    """
    raw = event.get("tool_parameters")
    if not raw:
        return ""
    try:
        params = json.loads(raw)
    except (json.JSONDecodeError, TypeError, ValueError):
        return ""
    return params.get("full_command") or "" if isinstance(params, dict) else ""


def _tally(counter, key):
    counter[key] = counter.get(key, 0) + 1


def _ranked(counter, key_name):
    return [{key_name: k, "count": n}
            for k, n in sorted(counter.items(), key=lambda kv: (-kv[1], kv[0]))]


def _label_of(event):
    """What to rank an event under: the program for Bash, else the tool name."""
    tool = event.get("tool_name") or "?"
    if tool != "Bash":
        return tool
    return program_of(_command_of(event))


def report_prompts(events, window):
    """M1 — the interruption ledger.

    Every row is a permission prompt that actually fired and stopped the human.
    Ranking by program is what turns it into an allowlist rule; the example is
    there so the rule can be written without going back to the transcript.
    """
    by_program, by_tool, hooks = {}, {}, {}
    examples = {}
    prompts = 0
    for event in events:
        source = event.get("source") or ""
        if source == "hook":
            _tally(hooks, event.get("decision") or "?")
            continue
        if not source.startswith("user_"):
            continue
        prompts += 1
        label = _label_of(event)
        _tally(by_program, label)
        _tally(by_tool, event.get("tool_name") or "?")
        if label not in examples:
            command = _command_of(event) or event.get("tool_name") or ""
            examples[label] = command[:120]
    ranked = _ranked(by_program, "program")
    for row in ranked:
        row["example"] = examples.get(row["program"], "")
    return {
        "report": "prompts",
        "measures": "prompts that fired — savings still on the table",
        "window": window,
        "scope": "127.0.0.1 (this machine only)",
        "prompts_fired": prompts,
        "by_program": ranked,
        "by_tool": _ranked(by_tool, "tool"),
        "hook_decisions": _ranked(hooks, "decision"),
    }


def cmd_savings(ns, now):
    # Filter in the selector, not in Python. Fetching every decision and
    # discarding the auto-approved ones blows the entry limit long before the
    # window ends — 7d is ~15k decisions but only ~600 prompts — and silently
    # reports a fraction of the real count as if it were the whole.
    events = _savings_fetch(
        '{service_name="claude-code"} | json | event_name="tool_decision" '
        '| source=~"user_.*|hook"',
        ns.since, now, ns.timeout)
    payload = report_prompts(events, ns.since)
    payload["truncated"] = len(events) >= SAVINGS_LIMIT
    return payload


def _rows(payload):
    """Render the vector/matrix shape every ad-hoc query ended up reformatting by
    hand: value, then the label set, one series per line, biggest first."""
    result = (payload.get("data") or {}).get("result") or []
    lines = []
    for series in result:
        labels = series.get("metric") or series.get("stream") or {}
        label_text = " ".join(f"{k}={v}" for k, v in sorted(labels.items()))
        if "value" in series:
            lines.append((series["value"][1], label_text))
        elif "values" in series:
            for _ts, val in series["values"]:
                lines.append((val, label_text))
    def sort_key(row):
        try:
            return (0, -float(row[0]))
        except (TypeError, ValueError):
            return (1, 0.0)
    lines.sort(key=sort_key)
    return "\n".join(f"{v}\t{lab}" for v, lab in lines)


def _savings_rows(payload):
    """The digest as value<TAB>label, matching what --rows means everywhere else."""
    lines = [f"{payload['prompts_fired']}\tprompts fired over {payload['window']} "
             f"({payload['scope']})"]
    if payload.get("truncated"):
        lines.append(f"!\ttruncated at {SAVINGS_LIMIT} events — narrow --since")
    for row in payload["by_program"]:
        lines.append(f"{row['count']}\t{row['program']}\t{row['example']}")
    for row in payload["hook_decisions"]:
        lines.append(f"{row['count']}\thook:{row['decision']}\t(no human involved)")
    return "\n".join(lines)


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Query the local Loki/Prometheus stack (127.0.0.1 only, GET only).",
    )
    parser.add_argument(
        "--timeout", type=int, default=DEFAULT_TIMEOUT,
        help=f"per-request timeout in seconds (default: {DEFAULT_TIMEOUT})")
    parser.add_argument("--rows", action="store_true",
                        help="render value<TAB>labels instead of raw JSON")
    parser.add_argument("--indent", type=int, default=None,
                        help="pretty-print JSON with N spaces")

    # The same three flags again, on every subcommand. Declaring them only at the
    # top level forces `otelq --rows logs '<query>'`, but every natural
    # invocation puts the flag last. SUPPRESS is what makes both positions work:
    # without it the subparser's own default would clobber a value already set
    # before the subcommand.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--rows", action="store_true", default=argparse.SUPPRESS,
                        help="render value<TAB>labels instead of raw JSON")
    common.add_argument("--indent", type=int, default=argparse.SUPPRESS,
                        help="pretty-print JSON with N spaces")
    common.add_argument("--timeout", type=int, default=argparse.SUPPRESS,
                        help="per-request timeout in seconds")

    sub = parser.add_subparsers(dest="cmd", required=True)

    for name, helptext in (("logs", "LogQL against Loki"),
                           ("metric", "PromQL against Prometheus")):
        p = sub.add_parser(name, help=helptext, parents=[common])
        p.add_argument("query", help="LogQL/PromQL query string")
        p.add_argument("--stream", action="store_true",
                       help="range query over --since instead of an instant query")
        p.add_argument("--since", default="1h",
                       help="range window, e.g. 30m/19h/7d (default: 1h)")
        p.add_argument("--limit", type=int, default=100,
                       help="max entries (logs --stream)")
        p.add_argument("--direction", choices=("backward", "forward"),
                       default="backward")
        p.add_argument("--step", default="60",
                       help="range step in seconds (metric --stream)")

    p = sub.add_parser("labels", help="Loki label names, or values for one label",
                       parents=[common])
    p.add_argument("--name", help="label name; omit to list all label names")
    p.add_argument("--since", default="24h", help="lookback window (default: 24h)")

    sub.add_parser("ready", help="readiness of both backends", parents=[common])

    p = sub.add_parser(
        "savings", help="what the tooling rules are costing, from tool-call events",
        parents=[common])
    p.add_argument("--since", default="7d", help="window (default: 7d)")

    ns = parser.parse_args(argv)
    handlers = {"logs": cmd_logs, "metric": cmd_metric, "labels": cmd_labels,
                "ready": cmd_ready, "savings": cmd_savings}

    try:
        payload = handlers[ns.cmd](ns, time.time())
        render = _savings_rows if ns.cmd == "savings" else _rows
        print(render(payload) if ns.rows else json.dumps(payload, indent=ns.indent,
                                                         ensure_ascii=False))
    except OtelqError as exc:
        print(f"{PROG}: {exc}", file=sys.stderr)
        return 2
    except BrokenPipeError:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())

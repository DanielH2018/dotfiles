[Unit]
Description=Update user-scope Flatpak apps and runtimes
# A run without a network fails on every remote and reports it, which is noise rather than
# information. Persistent=true on the timer means a skipped run is picked up later anyway.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The update, the prune, and the Mullvad detour live in the script rather than here, so that
# running it by hand is the same operation the timer performs.
ExecStart=%h/.local/bin/flatpak-update
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(* | sh*)",
      "Bash(* | bash*)",
      "Bash(* | zsh*)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/credentials)",
      "Read(**/.env)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Edit(**/.ssh/**)"
    ]
  }
}

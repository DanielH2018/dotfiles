{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "chafa",
    "source": "~/.config/fastfetch/logos/*.png",
    "preserveAspectRatio": true,
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "modules": [
    "title",
    "separator",
    "host",
    "os",
    "uptime",
    "terminal",
    "terminalfont",
    "memory",
    "localip",
    "battery",
    "break",
    "colors"
  ]
}
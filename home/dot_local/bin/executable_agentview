#!/usr/bin/env bash
# Agent View — grouped, switchable list of Claude Code sessions across machines and
# backends (host + claude-sandbox). Terminal-agnostic: focus is delegated to whichever
# backend a session captured at start (tmux / wezterm / none).
# Modes:
#   agentview             full-color fzf picker; on <enter> it jumps to the session.
#                         CTRL+SHIFT+S (WezTerm) / prefix+g (tmux) spawns this. Picker keys:
#                         ALT+1..9 jump to the Nth session · CTRL+R rename · CTRL+P pin to
#                         top · CTRL+N new claude-sandbox · CTRL+X remove · CTRL+F refresh ·
#                         CTRL+O session details · ? shortcut cheatsheet.
#   agentview --spawn     interactive: pick a repo + branch, launch claude-sandbox in a
#                         new pane of the active backend (tmux new-window / wezterm spawn)
#   agentview --resolve KEY  print the CLIENT-side pane id to jump to (or nothing)
#   agentview --jump KEY  activate the session's pane (locator-direct, or legacy cwd)
#   agentview --jump-nth N  jump to the Nth session in render order (ALT+N target)
#   agentview --card KEY  render the fzf preview card
#   agentview --keys      render the keyboard-shortcut cheatsheet (shown on `?`)
#   agentview --remove KEY  REALLY remove the session (CTRL+X, confirmed): stop its process
#                         (pid-reuse-guarded) + `claude rm` its record/worktree + drop the
#                         registry row. Remote rows act on their host over ssh, then filter
#                         the cache. So a live session can't reappear.
#   agentview --pin KEY   toggle this row's pin (CTRL+P); pins live in ~/.claude/agent-view-pins
#   agentview --rename KEY  send Claude's own /rename into the session's pane (CTRL+R); needs
#                         a tmux/wezterm pane + an idle session (remote tmux driven over ssh)
#   agentview --body      emit just the grouped fzf list (used for the live reload)
# KEY fields are US-separated (0x1f): host|cwd|state|ts|title|pane|kind|locator.
# A session's `locator` (captured at start) is the concrete focus target, so a jump is
# one direct backend command with no discovery step. Rows lacking a locator (legacy /
# pre-rename) fall back to cwd-correlation against `wezterm cli --prefer-mux list`.
set -u
mode="${1:-fzf}"
statedir="$HOME/.claude/agent-view"
# Homelab snapshot cache: the picker renders from THIS file instantly (no network on
# open); a background job refreshes it over ssh and live-reloads fzf. Kept OUT of the
# state dir and without a .json suffix so the local glob never mistakes it for a local
# session file. Defined here (above do_remove) so Ctrl+X on a remote row can filter it.
remote_cache="$HOME/.agentview-remote-cache"
# Pin sidecar: newline-delimited row identities the user pinned with CTRL+P. Kept OUT of
# the per-session state files so it survives the hook's full-record rewrites AND can pin
# remote rows (which have no local file). The render reads it into a PINNED group up top.
pinfile="$HOME/.claude/agent-view-pins"
now=$(date +%s 2>/dev/null || echo 0)
selfhost=$(hostname 2>/dev/null)
US=$'\037'

compute_pin_id() {  # sets _pid = stable pin identity for $1=host $2=cwd $3=kind $4=locator.
  # A real (non-"none") locator uniquely names the pane; else fall back to host+cwd+kind
  # (US-joined). No subshell — this runs per row in the hot render path.
  if [ -n "$4" ] && [ "${4%%:*}" != "none" ]; then _pid="$4"
  else _pid="$1$US$2$US$3"; fi
}

# Shared jq fragments (were copy-pasted three times). `norm` makes Windows and Unix
# cwds comparable; JQ_NONSHELL keeps only panes whose title isn't a bare shell/mux
# name (i.e. the pane Claude retitled with its task). MSYS_NO_PATHCONV guards the
# `--arg cwd` from Git-Bash rewriting a leading-slash POSIX cwd on Windows.
JQ_NORM='def norm: sub("^file://";"") | gsub("\\\\";"/") | sub("^/(?<d>[A-Za-z]:)"; .d) | sub("/$";"") | ascii_downcase;'
JQ_NONSHELL='(.title|ascii_downcase|test("^(-?(zsh|bash|fish|sh|pwsh|powershell|login)(\\.exe)?|wezterm\\.exe|cmd\\.exe|ubuntu)$"))|not'

# ---- backend focus (the ONLY terminal-specific code) --------------------------
av_activate_locator() {  # $1 = "backend:rest"; returns 0 if it handled focus, else 1
  local loc="$1" backend rest sock tp pane_id _r session
  backend="${loc%%:*}"; rest="${loc#*:}"
  case "$backend" in
    wezterm)
      [ -z "$rest" ] && return 1
      command -v wezterm >/dev/null 2>&1 || return 1
      # Immediate activate + a detached, SIGHUP-immune re-activate 0.25s later so
      # closing the picker pane can't steal focus back over the jump.
      wezterm cli --prefer-mux activate-pane --pane-id "$rest" 2>/dev/null
      nohup bash -c "sleep 0.25; wezterm cli --prefer-mux activate-pane --pane-id '$rest'" \
        >/dev/null 2>&1 </dev/null &
      return 0 ;;
    tmux)
      command -v tmux >/dev/null 2>&1 || return 1
      # rest = <socket>:<session>:<pane_id>; socket + sanitized session carry no ':'.
      pane_id="${rest##*:}"; _r="${rest%:*}"
      session="${_r##*:}"                      # the attach target when we're not a client
      sock="${_r%:*}"                          # drops the trailing :<session>
      tp="$pane_id"
      [ -z "$tp" ] && return 1
      # Focus the target pane server-side, then bring a client onto it.
      tmux -S "$sock" select-window -t "$tp" 2>/dev/null
      tmux -S "$sock" select-pane -t "$tp" 2>/dev/null
      if [ -n "${TMUX:-}" ]; then
        # Already a tmux client (e.g. the prefix+g popup): move it to the pane. tmux
        # can't raise the OS window hosting the client (documented limitation).
        tmux -S "$sock" switch-client -t "$tp" 2>/dev/null
      else
        # Bare shell: switch-client has no client to move ("no current client"), so
        # attach THIS terminal to the session — the select-pane above lands us on it.
        [ -n "$session" ] || return 1
        tmux -S "$sock" attach-session -t "$session"
      fi
      return 0 ;;
    *) return 1 ;;   # none / unknown -> caller falls back to cwd-correlation
  esac
}

resolve_key() {  # $1 = KEY -> echoes the CLIENT-side pane id to jump to (or nothing)
  # Legacy cwd-correlation for rows with no locator: the stored pane id is only valid
  # in the mux where it was recorded, so it can't be trusted across the local vs.
  # homelab windows. Needs `wezterm cli list`.
  local key="$1" scwd list target
  scwd=$(printf '%s' "$key" | cut -d"$US" -f2)
  [ -z "$scwd" ] && return
  command -v wezterm >/dev/null 2>&1 || return
  # Reuse the render's mux snapshot when we're jumping in-process; only the
  # standalone --resolve/--jump invocations need their own `list` call.
  list="${PANELIST:-}"
  [ -z "$list" ] && list=$(wezterm cli --prefer-mux list --format json 2>/dev/null)
  [ -z "$list" ] && return
  # Prefer a cwd match whose pane is non-shell (Claude's pane); fall back to any
  # cwd match if every candidate at that cwd is a plain shell.
  target=$(printf '%s' "$list" | MSYS_NO_PATHCONV=1 jq -r --arg cwd "$scwd" "
    $JQ_NORM
    (\$cwd|norm) as \$w | [ .[] | (.cwd|norm) as \$c
      | select(\$c==\$w or (\$w|startswith(\$c)) or (\$c|startswith(\$w)))
      | select($JQ_NONSHELL)
      | .pane_id ] | first // empty" 2>/dev/null)
  [ -z "$target" ] && target=$(printf '%s' "$list" | MSYS_NO_PATHCONV=1 jq -r --arg cwd "$scwd" "
    $JQ_NORM
    (\$cwd|norm) as \$w | [ .[] | (.cwd|norm) as \$c
      | select(\$c==\$w or (\$w|startswith(\$c)) or (\$c|startswith(\$w))) | .pane_id ] | first // empty" 2>/dev/null)
  [ -n "$target" ] && printf '%s' "$target"
}

PANELIST=""
# Pure-bash cwd normalizer mirroring the jq `norm` above (strip file://, \->/,
# drop the leading slash before a drive letter, trim trailing /, downcase). Lets
# title lookups run without a jq process per row.
norm_bash() {  # sets _norm (no $() subshell per call — forks are slow on Windows)
  local s="${1#file://}"; s="${s//\\//}"
  case "$s" in /[A-Za-z]:*) s="${s#/}";; esac
  s="${s%/}"; _norm="${s,,}"
}
# Build the cwd->title map ONCE from the mux snapshot (one jq call for the whole
# render) instead of one jq per row. Non-shell panes only, as normalized-cwd<TAB>title.
TCWDS=(); TTITLES=()
load_titles() {
  local c t
  while IFS=$'\t' read -r c t; do
    [ -z "$c" ] && continue; TCWDS+=("$c"); TTITLES+=("$t")
  done < <(printf '%s' "$PANELIST" | MSYS_NO_PATHCONV=1 jq -r "
      $JQ_NORM
      .[] | select($JQ_NONSHELL) | [(.cwd|norm), .title] | @tsv" 2>/dev/null)
}
title_for_cwd() {  # $1 = cwd -> sets _title to the Claude pane title at that cwd (or "")
  # Same cwd-match + non-shell filter as resolve_key, resolved against the prebuilt
  # map — no jq and no subshell per call.
  _title=""; norm_bash "$1"; local w="$_norm"; [ -z "$w" ] && return
  local i c
  for i in "${!TCWDS[@]}"; do
    c="${TCWDS[$i]}"
    if [ "$c" = "$w" ] || [[ "$w" == "$c"* ]] || [[ "$c" == "$w"* ]]; then
      _title="${TTITLES[$i]}"; return
    fi
  done
}

remote_alias() {  # $1 = row host -> ssh alias. Single known remote today; extensible.
  case "$1" in
    daniel-server) printf 'daniel-server' ;;
    *)             printf 'daniel-server' ;;   # only one remote; map new hosts here
  esac
}

remote_attach() {  # $1=host $2=locator -> open a fresh view ssh-attached at the pane
  local host="$1" loc="$2" backend rest session pane sshalias rcmd
  backend="${loc%%:*}"; rest="${loc#*:}"
  [ "$backend" = "tmux" ] || return 1        # only tmux remotes attach; others list-only
  # rest = <socket>:<session>:<pane>
  pane="${rest##*:}"; rest="${rest%:*}"; session="${rest##*:}"
  [ -n "$session" ] && [ -n "$pane" ] || return 1
  sshalias=$(remote_alias "$host")
  # Remote command: select the pane server-side, then attach the client. Two separate
  # tmux calls joined by a shell ';' (not tmux's '\;') so it survives the quoting layers
  # below. Errors (host down, session gone) surface IN the new view, never a silent no-op.
  rcmd="tmux select-pane -t '$pane' 2>/dev/null; tmux attach -t '$session'"
  if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
    # Portable: open a new window in the LOCAL tmux running the ssh-attach. Works under
    # any outer terminal (Ghostty, WezTerm-hosting-WSL, bare ssh) — no wezterm needed.
    tmux new-window -n "$session" "ssh -t $sshalias \"$rcmd\""
    return 0
  fi
  if [ -n "${WEZTERM_PANE:-}" ] && command -v wezterm >/dev/null 2>&1; then
    # Native WezTerm: spawn a fresh GUI tab. `wezterm cli spawn` derives its target from
    # $WEZTERM_PANE, which is unset when WSL doesn't inherit WezTerm's env — gate on it, or
    # spawn fails and (with output swallowed) this branch silently no-ops.
    wezterm cli spawn -- ssh -t "$sshalias" "$rcmd" >/dev/null 2>&1
    return 0
  fi
  # Bare shell (no local tmux, no usable wezterm — e.g. a plain WSL shell): attach in THIS
  # terminal. exec replaces the picker with the ssh-attach, mirroring the local bare-shell
  # path. Errors (host down, session gone) surface here instead of a silent no-op.
  command -v ssh >/dev/null 2>&1 || return 1
  exec ssh -t "$sshalias" "$rcmd"
}

do_jump() {  # $1 = KEY -> focus the session. Remote rows attach in a fresh local tab;
  # local rows activate in-process (locator-direct, else legacy cwd-correlation).
  local key="$1" host locator t
  host=$(printf '%s' "$key" | cut -d"$US" -f1)
  locator=$(printf '%s' "$key" | cut -d"$US" -f8)
  if [ -n "$host" ] && [ "$host" != "$selfhost" ]; then
    remote_attach "$host" "$locator"; return $?     # remote: never touch a local pane
  fi
  if [ -n "$locator" ] && [ "${locator%%:*}" != "none" ]; then
    av_activate_locator "$locator" && return 0
  fi
  t=$(resolve_key "$key"); [ -z "$t" ] && return 1
  command -v wezterm >/dev/null 2>&1 || return 1
  wezterm cli --prefer-mux activate-pane --pane-id "$t" 2>/dev/null
  nohup bash -c "sleep 0.25; wezterm cli --prefer-mux activate-pane --pane-id '$t'" \
    >/dev/null 2>&1 </dev/null &
  return 0
}

av_purge_local() {  # $1=sid -> REALLY stop + delete a local session. Find Claude's live
  # process via ~/.claude/sessions/<pid>.json whose sessionId == sid (authoritative, and
  # pid-reuse-safe by construction — only the pid Claude currently maps to this session is
  # signalled), kill it, then `claude rm` removes Claude's record + any worktree. AV_KILLCMD
  # is a test seam (defaults to the real kill).
  local sid="$1" pf pid
  [ -n "$sid" ] || return 0
  shopt -s nullglob
  for pf in "$HOME/.claude/sessions"/*.json; do
    [ "$(jq -r '.sessionId // ""' "$pf" 2>/dev/null)" = "$sid" ] || continue
    pid=$(jq -r '.pid // ""' "$pf" 2>/dev/null)
    [ -n "$pid" ] && "${AV_KILLCMD:-kill}" "$pid" 2>/dev/null
  done
  shopt -u nullglob
  command -v claude >/dev/null 2>&1 && claude rm "$sid" </dev/null >/dev/null 2>&1
  return 0
}

av_purge_remote() {  # $1=alias $2=sid -> the same stop+delete on the remote over ssh, incl.
  # dropping the remote's own registry file. sid is a uuid (literal under %q); $HOME and the
  # sessionId lookup evaluate on the remote.
  local alias="$1" sid="$2" script
  [ -n "$sid" ] || return 0
  printf -v script 's=%q; for pf in "$HOME/.claude/sessions/"*.json; do [ -f "$pf" ] || continue; if [ "$(jq -r ".sessionId // \"\"" "$pf" 2>/dev/null)" = "$s" ]; then p="$(jq -r ".pid // \"\"" "$pf" 2>/dev/null)"; [ -n "$p" ] && kill "$p" 2>/dev/null; fi; done; command -v claude >/dev/null 2>&1 && claude rm "$s" </dev/null >/dev/null 2>&1; rm -f "$HOME/.claude/agent-view/$s.json" 2>/dev/null' "$sid"
  ssh -o ConnectTimeout=4 -o BatchMode=yes "$alias" "$script" </dev/null >/dev/null 2>&1
}

do_remove() {  # $1 = KEY -> REALLY remove the session (CTRL+X, confirmed): stop its process
  # (pid-reuse-guarded) + `claude rm` its record/worktree + drop the registry row, so a live
  # session can't reappear. Local rows act locally; remote rows act on their host over ssh,
  # then the row is filtered from the ssh cache. An empty KEY (header/spacer) is a no-op.
  local key="$1" host cwd kind locator f m sid ans name tmp="$remote_cache.tmp.$$"
  host=$(printf '%s' "$key" | cut -d"$US" -f1)
  cwd=$(printf '%s' "$key" | cut -d"$US" -f2)
  kind=$(printf '%s' "$key" | cut -d"$US" -f7)
  locator=$(printf '%s' "$key" | cut -d"$US" -f8)
  [ -n "$cwd" ] || [ -n "$locator" ] || return 0
  name=$(basename "${cwd//\\//}" 2>/dev/null)
  printf '\n  Remove "%s" — stop its process and delete the session (worktree too)? [y/N] ' "$name" >&2
  IFS= read -r ans || return 0
  case "$ans" in y|Y|yes|YES|Yes) ;; *) return 0 ;; esac
  if [ -n "$host" ] && [ "$host" != "$selfhost" ]; then
    [ -s "$remote_cache" ] || return 0
    # Pull the row's sid so we can stop it on the remote, then filter it from the cache.
    sid=$(MSYS_NO_PATHCONV=1 jq -r --arg loc "$locator" --arg cwd "$cwd" --arg host "$host" --arg kind "$kind" '
      select( ($loc != "" and (.locator//"")==$loc) or ($loc=="" and (.cwd//"")==$cwd and (.host//"")==$host and (.kind//"host")==$kind) )
      | (.session // .key // "")' < "$remote_cache" 2>/dev/null | head -1)
    [ -n "$sid" ] && av_purge_remote "$(remote_alias "$host")" "$sid"
    MSYS_NO_PATHCONV=1 jq -c --arg loc "$locator" --arg cwd "$cwd" --arg host "$host" --arg kind "$kind" '
      ((.locator // "")) as $l | ((.cwd // "")) as $c | ((.host // "")) as $h | ((.kind // "host")) as $k |
      select( (($loc != "" and $l == $loc) or ($loc == "" and $c == $cwd and $h == $host and $k == $kind)) | not )
    ' < "$remote_cache" > "$tmp" 2>/dev/null && mv -f "$tmp" "$remote_cache" 2>/dev/null || rm -f "$tmp" 2>/dev/null
    return 0
  fi
  shopt -s nullglob
  for f in "$statedir"/*.json; do
    m=$(jq -r --arg loc "$locator" --arg cwd "$cwd" --arg host "$host" --arg kind "$kind" '
      ((.locator // "")) as $l | ((.cwd // "")) as $c | ((.host // "")) as $h | ((.kind // "host")) as $k |
      if   ($loc != "" and $l == $loc)                                 then "M"
      elif ($loc == "" and $c == $cwd and $h == $host and $k == $kind) then "M"
      else "N" end' "$f" 2>/dev/null)
    if [ "$m" = "M" ]; then
      sid=$(jq -r '.session // .key // ""' "$f" 2>/dev/null)
      av_purge_local "$sid"
      rm -f "$f" 2>/dev/null
    fi
  done
  shopt -u nullglob
  return 0
}

do_pin() {  # $1 = KEY -> toggle this row's pin in the sidecar (CTRL+P). Works for local AND
  # remote rows — the pin is keyed by identity, not by a local file. A header/spacer row
  # (empty KEY) is a no-op.
  local key="$1" host cwd kind locator tmp="$pinfile.tmp.$$" _pid
  host=$(printf '%s' "$key" | cut -d"$US" -f1)
  cwd=$(printf '%s' "$key" | cut -d"$US" -f2)
  kind=$(printf '%s' "$key" | cut -d"$US" -f7)
  locator=$(printf '%s' "$key" | cut -d"$US" -f8)
  [ -n "$cwd" ] || [ -n "$locator" ] || return 0
  compute_pin_id "$host" "$cwd" "$kind" "$locator"
  if [ -f "$pinfile" ] && grep -qxF -- "$_pid" "$pinfile" 2>/dev/null; then
    # grep -v exits 1 (not an error) when it filters out the ONLY line — accept 0 and 1 so
    # unpinning the last pin still writes the now-empty file; only a real error (>=2) aborts.
    local rc
    grep -vxF -- "$_pid" "$pinfile" > "$tmp" 2>/dev/null; rc=$?
    if [ "$rc" -le 1 ]; then mv -f "$tmp" "$pinfile" 2>/dev/null || rm -f "$tmp" 2>/dev/null
    else rm -f "$tmp" 2>/dev/null; fi
  else
    printf '%s\n' "$_pid" >> "$pinfile" 2>/dev/null
  fi
  return 0
}

av_send_rename() {  # $1=host $2=locator $3=name -> type "/rename <name>" + Enter into the
  # session's pane so Claude runs its OWN /rename. tmux locally or over ssh; wezterm locally.
  local host="$1" loc="$2" name="$3" backend rest sock pane cmd sshalias
  backend="${loc%%:*}"; rest="${loc#*:}"
  case "$backend" in
    tmux)
      # rest = <socket>:<session>:<pane>; socket + sanitized session carry no ':'.
      pane="${rest##*:}"; rest="${rest%:*}"; sock="${rest%:*}"
      [ -n "$pane" ] && [ -n "$sock" ] || return 1
      if [ -n "$host" ] && [ "$host" != "$selfhost" ]; then
        sshalias=$(remote_alias "$host")
        printf -v cmd 'tmux -S %q send-keys -t %q -l %q; tmux -S %q send-keys -t %q Enter' \
          "$sock" "$pane" "/rename $name" "$sock" "$pane"
        ssh -o ConnectTimeout=4 -o BatchMode=yes "$sshalias" "$cmd" </dev/null >/dev/null 2>&1
      else
        tmux -S "$sock" send-keys -t "$pane" -l "/rename $name" 2>/dev/null
        tmux -S "$sock" send-keys -t "$pane" Enter 2>/dev/null
      fi ;;
    wezterm)
      pane="$rest"; [ -n "$pane" ] || return 1
      command -v wezterm >/dev/null 2>&1 || return 1
      wezterm cli send-text --no-paste --pane-id "$pane" "/rename $name"$'\r' >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
  return 0
}

do_rename() {  # $1 = KEY -> run Claude's own /rename in the session's pane (CTRL+R). Types
  # "/rename <name>" + Enter into the tmux/wezterm pane so Claude executes the real command
  # (writing its own custom-title). Needs an addressable pane (not none:) and an idle session
  # — never inject into a working one, where the keys would land mid-task. Remote tmux over ssh.
  local key="$1" host state locator backend name
  host=$(printf '%s' "$key" | cut -d"$US" -f1)
  state=$(printf '%s' "$key" | cut -d"$US" -f3)
  locator=$(printf '%s' "$key" | cut -d"$US" -f8)
  [ -n "$locator" ] || return 0
  backend="${locator%%:*}"
  if [ -z "$backend" ] || [ "$backend" = "none" ]; then
    printf '\n  agentview: this session has no tmux/wezterm pane, so Claude'\''s /rename can'\''t\n  be sent to it — rename it from inside the session instead.\n' >&2; sleep 1.5; return 0
  fi
  if [ "$state" = "working" ]; then
    printf '\n  agentview: session is working — rename it when idle so the keys land at the\n  input prompt, not mid-task.\n' >&2; sleep 1.5; return 0
  fi
  printf '\n  send /rename to this session in Claude:\n' >&2
  IFS= read -r -e -p '  new name> ' name || return 0
  name="${name//$'\n'/ }"; name="${name//$'\r'/ }"
  [ -n "$name" ] || return 0
  av_send_rename "$host" "$locator" "$name"
  return 0
}

if [ "$mode" = "--resolve" ]; then resolve_key "${2:-}"; exit 0; fi
if [ "$mode" = "--jump" ]; then do_jump "${2:-}"; exit 0; fi
if [ "$mode" = "--remove" ]; then do_remove "${2:-}"; exit 0; fi
if [ "$mode" = "--pin" ]; then do_pin "${2:-}"; exit 0; fi
if [ "$mode" = "--rename" ]; then do_rename "${2:-}"; exit 0; fi

if [ "$mode" = "--card" ]; then
  # Render the fzf preview card from the row KEY (US-delimited host|cwd|state|ts|title|
  # pane|kind|locator) — fzf passes it as {1}, single-quoted/escaped, so it's safe as
  # one argument. Self-contained (own colors, inline age) so it runs BEFORE any
  # state-load/SSH — fzf calls this on every keystroke, so it must be instant.
  [ -z "${2:-}" ] && exit 0
  IFS=$'\037' read -r k_host k_cwd k_state k_ts k_title k_pane k_kind k_loc <<< "${2:-}"
  e=$'\033'; z="$e[0m"
  dim="$e[38;2;127;132;156m"; lab="$e[38;2;147;153;178m"; val="$e[38;2;205;214;244m"
  case "$k_state" in
    needs-input) sc="$e[38;2;249;226;175m"; sn="needs input";;
    working)     sc="$e[38;2;166;227;161m"; sn="working";;
    completed)   sc="$e[38;2;108;112;134m"; sn="completed";;
    *)           sc="$e[38;2;108;112;134m"; sn="idle";;
  esac
  [ "$k_kind" = "sandbox" ] && klabel="sandbox" || klabel="claude"
  if [ "$k_host" = "$selfhost" ]; then mn="PC · $k_host"
  else case "$k_host" in daniel-server) mn="homelab · $k_host";; *) mn="$k_host";; esac; fi
  age=""
  case "$k_ts" in ''|*[!0-9]*) :;; *)
    if [ "$k_ts" -gt 0 ]; then d=$(( now - k_ts )); [ "$d" -lt 0 ] && d=0
      if   [ "$d" -lt 60 ];    then age="${d}s ago"
      elif [ "$d" -lt 3600 ];  then age="$((d/60))m ago"
      elif [ "$d" -lt 86400 ]; then age="$((d/3600))h ago"
      else age="$((d/86400))d ago"; fi
    fi;;
  esac
  name=$(basename "${k_cwd//\\//}" 2>/dev/null)
  printf '\n  %s✳%s  %s%s · %s%s%s\n\n' "$sc" "$z" "$dim" "$klabel" "$val" "$name" "$z"
  printf '  %s%-9s%s%s%s ●%s\n' "$lab" "State" "$sc" "$sn" "$sc" "$z"
  [ "$k_kind" = "sandbox" ] && printf '  %s%-9s%s%s%s\n' "$lab" "Kind" "$val" "sandbox" "$z"
  printf '  %s%-9s%s%s%s\n'     "$lab" "Machine" "$val" "$mn" "$z"
  printf '  %s%-9s%s%s%s\n'     "$lab" "Folder" "$val" "$name" "$z"
  printf '  %s%-9s%s%s%s\n'     "$lab" "Path" "$dim" "$k_cwd" "$z"
  [ -n "$k_title" ] && printf '  %s%-9s%s%s%s\n' "$lab" "Task" "$val" "$k_title" "$z"
  [ -n "$age" ]     && printf '  %s%-9s%s%s%s\n' "$lab" "Updated" "$dim" "$age" "$z"
  exit 0
fi

if [ "$mode" = "--keys" ]; then
  # The shortcut cheatsheet shown in the preview pane when the user presses `?`. Self-
  # contained (own colors, no state load) so it renders instantly like --card.
  e=$'\033'; z="$e[0m"
  ttl="$e[1m$e[38;2;180;190;254m"; sec="$e[38;2;203;166;247m"; k="$e[38;2;166;227;161m"; dsc="$e[38;2;205;214;244m"
  printf '\n  %s✳ agent view · shortcuts%s\n' "$ttl" "$z"
  printf '\n  %sNavigate%s\n' "$sec" "$z"
  printf '    %s↑ ↓%s      %smove%s\n'                 "$k" "$z" "$dsc" "$z"
  printf '    %s⌥1 … ⌥9%s  %sjump to that session%s\n' "$k" "$z" "$dsc" "$z"
  printf '    %s↵%s        %sswitch to selected%s\n'   "$k" "$z" "$dsc" "$z"
  printf '\n  %sManage%s\n' "$sec" "$z"
  printf '    %s⌃r%s       %srename label%s\n'         "$k" "$z" "$dsc" "$z"
  printf '    %s⌃p%s       %spin / unpin to top%s\n'   "$k" "$z" "$dsc" "$z"
  printf '    %s⌃x%s       %sremove from list%s\n'     "$k" "$z" "$dsc" "$z"
  printf '    %s⌃n%s       %snew sandbox session%s\n'  "$k" "$z" "$dsc" "$z"
  printf '\n  %sView%s\n' "$sec" "$z"
  printf '    %s⌃o%s       %ssession details%s\n'      "$k" "$z" "$dsc" "$z"
  printf '    %s⌃f%s       %srefresh now%s\n'          "$k" "$z" "$dsc" "$z"
  printf '    %s?%s        %sthis help%s\n'            "$k" "$z" "$dsc" "$z"
  printf '    %sesc%s      %sclose%s\n'                "$k" "$z" "$dsc" "$z"
  exit 0
fi

# Required tools: jq + fzf always. wezterm is OPTIONAL — only the wezterm backend and
# the legacy cwd-correlation need it; under tmux (Ghostty/Linux) it's absent and rows
# focus via their tmux locator instead. Fail loudly on a truly missing core tool.
for t in jq fzf; do
  command -v "$t" >/dev/null 2>&1 || { printf 'agentview: %s not found on PATH\n' "$t" >&2; exit 1; }
done
HAVE_WEZTERM=0; command -v wezterm >/dev/null 2>&1 && HAVE_WEZTERM=1

# ---- new-session spawn (bonus): start a claude-sandbox session from the picker ----
# Repos live under ~/Repositories (claude-sandbox's own convention); the launcher is on
# PATH or at its deployed path. Both overridable (tests / non-standard layouts).
repos_root="${SANDBOX_REPOS_ROOT:-$HOME/Repositories}"
sandbox_bin="${CLAUDE_SANDBOX_BIN:-}"
if [ -z "$sandbox_bin" ]; then
  if command -v claude-sandbox >/dev/null 2>&1; then sandbox_bin="claude-sandbox"
  else sandbox_bin="$HOME/.claude/sandbox/claude-sandbox"; fi
fi

spawn_pick_repo() {  # echo the chosen repo path (empty if cancelled)
  local names sel d
  names=$(for d in "$repos_root"/*/; do
    [ -d "$d/.git" ] || continue                # .git dir = a real checkout; a .git FILE is a
                                                # linked worktree (claude-sandbox's own -b sessions
                                                # land in repos_root) -> skip, not a spawn target
    printf '%s\n' "$(basename "${d%/}")"
  done | sort)
  [ -n "$names" ] || { printf 'agentview: no git repos under %s\n' "$repos_root" >&2; return 1; }
  sel=$(printf '%s\n' "$names" | fzf --prompt 'repo> ' --height='~70%' --layout=reverse \
    --border=rounded --info=hidden --header 'new claude-sandbox session · pick a repo · esc cancels')
  [ -n "$sel" ] && printf '%s' "$repos_root/$sel"
}

spawn_pick_branch() {  # $1 = repo path -> echo branch (empty = main repo, no worktree)
  local repo="$1" out
  # --print-query so the user can TYPE a new branch (claude-sandbox -b creates it) or pick
  # an existing one; the typed query is the last line. Empty selection = the main checkout.
  out=$("$sandbox_bin" "$repo" --complete-branches 2>/dev/null | fzf --prompt 'branch> ' \
    --height='~70%' --layout=reverse --border=rounded --info=hidden --print-query \
    --header 'pick or type a branch (-b) · empty = main repo · esc cancels' | tail -1)
  printf '%s' "$out"
}

spawn_build_cmd() {  # $1=repo $2=branch -> a shell-quoted claude-sandbox command
  if [ -n "$2" ]; then printf '%q %q -b %q' "$sandbox_bin" "$1" "$2"
  else printf '%q %q' "$sandbox_bin" "$1"; fi
}

spawn_in_backend() {  # $1=command string $2=window title -> open it in a new pane
  local cmd="$1" title="$2"
  if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
    tmux new-window -n "$title" "$cmd"; return 0
  fi
  if [ -n "${WEZTERM_PANE:-}" ] && command -v wezterm >/dev/null 2>&1; then
    wezterm cli spawn -- bash -lc "$cmd" >/dev/null 2>&1; return 0
  fi
  printf 'agentview: no tmux/wezterm backend to spawn into — run manually:\n  %s\n' "$cmd" >&2
  return 1
}

do_spawn() {  # interactive: pick repo + branch, spawn claude-sandbox in the active backend
  local repo branch cmd
  repo=$(spawn_pick_repo) || return 1
  [ -n "$repo" ] || return 0                       # cancelled at the repo pick
  branch=$(spawn_pick_branch "$repo")
  cmd=$(spawn_build_cmd "$repo" "$branch")
  spawn_in_backend "$cmd" "$(basename "$repo")"
}

if [ "$mode" = "--spawn" ]; then do_spawn; exit $?; fi

# Opt-in phase profiling: `AGENTVIEW_PROFILE=1 agentview` appends per-phase timestamps
# to ~/.agentview-profile.log so a slow open can be traced to the responsible phase.
prof() { [ -n "${AGENTVIEW_PROFILE:-}" ] && printf '%s\t%s\n' "${EPOCHREALTIME:-0}" "$1" >> "$HOME/.agentview-profile.log"; return 0; }
# ---- shared row/prune jq fragments + homelab cache ----
# Row = state<TAB>host<TAB>cwd<TAB>pane<TAB>ts<TAB>kind<TAB>locator<TAB>title. `PRUNE`
# (7d) drops the file; between 1 and 7 days a session is hidden but its file is kept.
JQ_ROW='[(.state // "idle"), (.host // "?"), (.cwd // ""), (.pane // ""), $ts, (.kind // "host"), (.locator // ""), (.title // "")] | @tsv'
JQ_TS='((.ts // 0)|tonumber? // 0) as $ts | ($now - $ts) as $age'
PRUNE=$(( 7 * 86400 ))
# remote_cache (homelab ssh snapshot) is defined near the top so do_remove can reach it.
rows=""

gather_local_rows() {  # append local session rows to global `rows`, prune >7d + dead-pid leaks
  local local_files jqout jqlines i l _lr _lpid
  # ONE jq over the whole state dir (process spawns dominate on Windows at ~55ms each,
  # so a per-file loop was pure overhead). Command substitution — NOT `< <(...)` — so
  # jq FULLY exits, releasing its read handles, before we prune: on Windows an open
  # handle blocks the rm. jq emits exactly one tagged line per file IN ARGUMENT ORDER
  # (P=prune>7d / H=hide 1–7d / L<TAB>pid<TAB>row=local host, prune if the pid is dead /
  # R<TAB>row) so lines align 1:1 with local_files and we
  # prune via the bash glob path (rm-able on MSYS; jq's own input_filename comes back
  # in a drive form rm rejects). On a count mismatch (a corrupt file made jq drop a
  # record) we skip ALL pruning that run rather than risk rm-ing the wrong file.
  shopt -s nullglob; local_files=( "$statedir"/*.json ); shopt -u nullglob
  [ "${#local_files[@]}" -gt 0 ] || return
  jqout=$(jq -r --argjson now "$now" --argjson prune "$PRUNE" --arg self "$selfhost" "
      $JQ_TS | (.pid // \"\" | tostring) as \$pid |
      if   \$ts > 0 and \$age > \$prune then \"P\"
      elif \$ts > 0 and \$age > 86400  then \"H\"
      elif (.kind // \"host\") == \"host\" and (.host // \"\") == \$self and \$pid != \"\"
           then \"L\t\" + \$pid + \"\t\" + ($JQ_ROW)
      else \"R\t\" + ($JQ_ROW) end" "${local_files[@]}" 2>/dev/null)
  jqlines=(); [ -n "$jqout" ] && mapfile -t jqlines <<< "$jqout"
  if [ "${#jqlines[@]}" -eq "${#local_files[@]}" ]; then
    for i in "${!local_files[@]}"; do
      case "${jqlines[$i]}" in
        P)  rm -f "${local_files[$i]}" 2>/dev/null ;;
        L*) _lr="${jqlines[$i]#L$'\t'}"; _lpid="${_lr%%$'\t'*}"       # L<TAB>pid<TAB>row
            if kill -0 "$_lpid" 2>/dev/null; then rows+="${_lr#*$'\t'}"$'\n'
            else rm -f "${local_files[$i]}" 2>/dev/null; fi ;;        # process gone -> leaked, prune
        R*) rows+="${jqlines[$i]#R$'\t'}"$'\n' ;;
      esac
    done
  else
    for l in "${jqlines[@]}"; do
      case "$l" in
        L*) _lr="${l#L$'\t'}"; rows+="${_lr#*$'\t'}"$'\n' ;;          # count mismatch: render, never rm
        R*) rows+="${l#R$'\t'}"$'\n' ;;
      esac
    done
  fi
}

gather_remote_rows() {  # append cached homelab rows to `rows` (display-filtered, never pruned)
  local rrows
  [ -s "$remote_cache" ] || return
  # Read via stdin, not a path arg, so native jq.exe isn't handed an MSYS path it
  # can't open. Default mode applies the filter to each object in the concatenated
  # per-session stream (the cache is a `cat` of every remote *.json).
  rrows=$(MSYS_NO_PATHCONV=1 jq -r --argjson now "$now" "
    $JQ_TS | if \$ts > 0 and \$age > 86400 then empty else $JQ_ROW end" < "$remote_cache" 2>/dev/null)
  [ -n "$rrows" ] && rows+="$rrows"$'\n'
}

refresh_remote() {  # pull homelab state over ssh, atomically replace the cache
  local out rc tmp="$remote_cache.tmp.$$"
  # One-shot ssh (NO ControlMaster) bounded by ConnectTimeout. `|| true` so a
  # live-but-empty homelab returns rc 0 — we KEEP the old snapshot only when ssh itself
  # can't connect (rc 255), not when there simply are no remote sessions.
  out=$(ssh -o ConnectTimeout=3 -o BatchMode=yes daniel-server \
        'cat ~/.claude/agent-view/*.json 2>/dev/null || true' \
        < /dev/null 2>/dev/null); rc=$?
  [ "$rc" -eq 255 ] && return
  printf '%s' "$out" > "$tmp" 2>/dev/null && mv -f "$tmp" "$remote_cache" 2>/dev/null || rm -f "$tmp" 2>/dev/null
}

# ---- palette (Catppuccin Mocha, truecolor) ----
E=$'\033'; Z="$E[0m"
C_NEED="$E[38;2;249;226;175m"          # yellow  — needs input
C_WORK="$E[38;2;166;227;161m"          # green   — working
C_DONE="$E[38;2;108;112;134m"          # overlay0 — completed / idle
C_DIM="$E[38;2;127;132;156m"           # overlay1 — "claude ·"
C_BOLD="$E[1m"                         # bold prefix — group headers + names render bold+state
C_PIN="$E[38;2;203;166;247m"           # mauve — PINNED group accent (★)
GBAR=$'▎'                         # ▎ left accent rule — state-colored, runs down each group
BADGEBG="$E[48;2;69;71;90m"            # surface1 — machine chip background
BADGEFG="$E[38;2;69;71;90m"            # surface1 as FG — colors the pill's rounded end-caps
PILL_L=$''; PILL_R=$''     # powerline half-circles — round the source badge into a box
# Single-source the state→accent map and the empty-state row so the two render paths
# (render_body + interactive picker) can't drift — they had: one used an extra leading
# tab, mis-offsetting the "no sessions" row against fzf's --with-nth=2.. delimiter.
state_color() {  # set $_scol to a state group's accent (a function call, no per-row fork)
  case "$1" in needs-input) _scol="$C_NEED";; working) _scol="$C_WORK";; *) _scol="$C_DONE";; esac
}
row_pinned() {  # sets $_pinned=1/0 for $1=host $2=cwd $3=kind $4=locator (reads PINNED_SET
  # via dynamic scope from build_pretty). No fork — runs per row on the render path.
  local _pid
  compute_pin_id "$1" "$2" "$3" "$4"
  [ -n "${PINNED_SET[$_pid]:-}" ] && _pinned=1 || _pinned=0
}
NO_SESSIONS_ROW=$'\t   '"${C_DONE}   no active Claude sessions — nothing running${Z}"
LABEL=$' ✳ claude sessions '      # ✳ Claude mark in the border title
PROMPT=$'  '                     # Nerd Font magnifier + gap (IosevkaTerm NFM)
declare -A GN=( [pinned]="PINNED" [needs-input]="NEEDS INPUT" [working]="WORKING" [completed]="COMPLETED" [idle]="IDLE" )

fmt_age() {  # $1 = epoch -> sets _age: compact "12m"/"3h"/"2d"; empty for unknown/zero ts
  local t=${1:-0} d; _age=""
  case "$t" in ''|*[!0-9]*) return;; esac
  [ "$t" -le 0 ] && return
  d=$(( now - t )); [ "$d" -lt 0 ] && d=0
  if   [ "$d" -lt 60 ];    then _age="${d}s"
  elif [ "$d" -lt 3600 ];  then _age="$((d/60))m"
  elif [ "$d" -lt 86400 ]; then _age="$((d/3600))h"
  else _age="$((d/86400))d"; fi
}

badge_name() {  # $1 = host -> sets _bn: friendly machine tag
  if [ "$1" = "$selfhost" ]; then _bn="PC"
  else case "$1" in daniel-server) _bn="homelab";; *) _bn="${1#daniel-}";; esac; fi
}

build_pretty() {  # prints "KEY<TAB>COLORED-DISPLAY" per row, grouped; KEY carries the card fields
  local W=72 BADGEW=7 grp st host cwd pane ts kind locator title_reg name title bn scol stext cnt key L _rest
  local bcell left_p left_c pad sp maxs bpad bfg first=1 fwd clabel
  local PINCNT=0 idx=0 g1 gutc _pinned _hp
  # Pinned rows collect into a PINNED group at the very top. Load the sidecar once into a
  # set, then in the tally below count pinned rows separately so a state group's header
  # count reflects only what still renders under it.
  local -A PINNED_SET=()
  if [ -f "$pinfile" ]; then
    while IFS= read -r _hp; do [ -n "$_hp" ] && PINNED_SET["$_hp"]=1; done < "$pinfile"
  fi
  # Sort every row by ts (desc) ONCE and tally per-state counts in pure bash, so the
  # group loop needs no per-group awk/sort — each of those was a process spawn, and
  # spawns dominate render time on Windows.
  local -a sorted; local -A GCNT=()
  mapfile -t sorted < <(printf '%s' "$rows" | sort -t$'\t' -k5,5nr)
  for L in "${sorted[@]}"; do
    st="${L%%$'\t'*}"; [ -z "$st" ] && continue
    _rest="${L#*$'\t'}"; host="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
    cwd="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
    _rest="${_rest#*$'\t'}"                       # skip pane
    _rest="${_rest#*$'\t'}"                       # skip ts
    kind="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
    locator="${_rest%%$'\t'*}"
    row_pinned "$host" "$cwd" "$kind" "$locator"
    if [ "$_pinned" = 1 ]; then PINCNT=$(( PINCNT + 1 )); else GCNT[$st]=$(( ${GCNT[$st]:-0} + 1 )); fi
  done
  for grp in pinned needs-input working completed idle; do
    if [ "$grp" = pinned ]; then cnt=$PINCNT; else cnt=${GCNT[$grp]:-0}; fi
    [ "$cnt" -eq 0 ] && continue
    [ "$first" -eq 0 ] && printf '\t\n'   # blank spacer between groups (empty KEY = no-op on select)
    first=0
    if [ "$grp" = pinned ]; then
      printf '\t%s%s%s %s★%s %s%s%s%s %s%s%s\n' "$C_PIN" "$GBAR" "$Z" "$C_PIN" "$Z" "$C_BOLD" "$C_PIN" "${GN[$grp]}" "$Z" "$C_DIM" "$cnt" "$Z"
    else
      state_color "$grp"; scol="$_scol"
      printf '\t%s%s%s %s●%s %s%s%s%s %s%s%s\n' "$scol" "$GBAR" "$Z" "$scol" "$Z" "$C_BOLD" "$scol" "${GN[$grp]}" "$Z" "$C_DIM" "$cnt" "$Z"
    fi
    for L in "${sorted[@]}"; do
      # Split on tab WITHOUT read's IFS-whitespace collapsing: sandbox rows have an
      # empty pane, and `IFS=$'\t' read` folds that empty field, shifting locator/title
      # out of place so do_jump reads the wrong KEY field. Parameter expansion keeps
      # empties. (@tsv already escaped any literal tabs in the values.)
      st="${L%%$'\t'*}"; _rest="${L#*$'\t'}"
      host="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
      cwd="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
      pane="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
      ts="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
      kind="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
      locator="${_rest%%$'\t'*}"; title_reg="${_rest#*$'\t'}"
      # Membership: the PINNED group takes every pinned row (in ts order); each state
      # group takes its own state MINUS anything already shown as pinned.
      row_pinned "$host" "$cwd" "$kind" "$locator"
      if [ "$grp" = pinned ]; then
        [ "$_pinned" = 1 ] || continue
      else
        { [ "$st" = "$grp" ] && [ "$_pinned" = 0 ]; } || continue
      fi
      fwd="${cwd//\\//}"; name="${fwd%/}"; name="${name##*/}"; [ -z "$name" ] && name="$cwd"
      # Prefer a registry-supplied title (sandbox rows carry repo·branch); else the
      # mux-correlated pane title (host rows on wezterm). Tabs would split the columns.
      if [ -n "$title_reg" ]; then title="$title_reg"; else title_for_cwd "$cwd"; title="$_title"; fi
      title="${title//$'\t'/ }"
      [ "$kind" = "sandbox" ] && clabel="sandbox" || clabel="claude"
      badge_name "$host"; bn="$_bn"
      case "$bn" in
        PC)      bfg="$E[38;2;137;180;250m";;   # blue  — desktop
        homelab) bfg="$E[38;2;203;166;247m";;   # mauve — server
        *)       bfg="$E[38;2;205;214;244m";;   # text  — cloud
      esac
      # badge cell = the rounded pill (caps hugging <name>, no inner padding) + trailing pad,
      # so the "claude ·" column lines up whatever the machine name's length.
      bpad=$(( BADGEW - ${#bn} )); [ "$bpad" -lt 0 ] && bpad=0
      printf -v bcell '%*s' "$((BADGEW + 2))" ''
      state_color "$st"; scol="$_scol"     # colour the bar/name by the row's real state, even under PINNED
      # Number gutter sits just after the accent bar — where the header's ● bullet is — so
      # the ▎ rule stays column-aligned down the group while ALT+1..9 jumps to the Nth row.
      # --jump-nth counts the same non-empty-KEY rows in this order.
      idx=$(( idx + 1 ))
      if [ "$idx" -le 9 ]; then g1="$idx"; gutc="${C_DIM}${idx}${Z}"; else g1=" "; gutc=" "; fi
      left_p="  ${g1} ${bcell}  ${clabel} · ${name}"
      # Machine source as a rounded pill: fill-colored caps hug the machine-colored name with
      # no inner padding (tight); trailing bpad right-pads to the shared column.
      printf -v left_c '%s%s%s %s %s%s%s%s%s%s%s%s%s%*s  %s%s · %s%s%s%s%s' \
        "$scol" "$GBAR" "$Z" "$gutc" "$BADGEFG" "$PILL_L" "$BADGEBG" "$bfg" "$bn" "$Z" "$BADGEFG" "$PILL_R" "$Z" "$bpad" '' \
        "$C_DIM" "$clabel" "$Z" "$C_BOLD" "$scol" "$name" "$Z"
      case "$st" in
        # Right column = the session's task title (its "name"). When none was captured, fall
        # back to the age — never the state word, which just echoes the group header.
        needs-input|working) if [ -n "$title" ]; then stext="$title"; else fmt_age "$ts"; stext="$_age"; fi;;
        completed)   fmt_age "$ts"; [ -n "$_age" ] && stext="✓ idle $_age" || stext="✓ completed";;
        *)           fmt_age "$ts"; [ -n "$_age" ] && stext="· idle $_age" || stext="· idle";;
      esac
      maxs=$(( W - ${#left_p} - 2 )); [ "$maxs" -lt 8 ] && maxs=8
      [ "${#stext}" -gt "$maxs" ] && stext="${stext:0:maxs-1}…"
      pad=$(( W - ${#left_p} - ${#stext} )); [ "$pad" -lt 1 ] && pad=1
      printf -v sp '%*s' "$pad" ''
      # KEY *is* the card blob (host|cwd|state|ts|title|pane|kind|locator, US-delimited):
      # the jump path reads field 2 (cwd, legacy) + field 8 (locator, direct) and the
      # preview reads the whole thing via {1} — so no per-row fork is needed.
      printf -v key '%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s' \
        "$host" "$US" "$cwd" "$US" "$st" "$US" "$ts" "$US" "$title" "$US" "${pane:-none}" "$US" "$kind" "$US" "$locator"
      printf '%s\t%s%s%s%s%s\n' "$key" "$left_c" "$sp" "$scol" "$stext" "$Z"
    done
  done
}

render_body() {  # sets global `body` from local + cached-remote rows (the fzf list)
  rows=""
  gather_local_rows
  gather_remote_rows
  if [ "$HAVE_WEZTERM" = 1 ]; then
    PANELIST=$(wezterm cli --prefer-mux list --format json 2>/dev/null)
    load_titles
  fi
  body=$(build_pretty)
  [ -z "$body" ] && body="$NO_SESSIONS_ROW"
}

# --body: emit JUST the fzf list — used for the initial render AND the live reload the
# background ssh pushes in. No pane stamp / no profiling: it runs as fzf's own child.
if [ "$mode" = "--body" ]; then render_body; printf '%s\n' "$body"; exit 0; fi

# --jump-nth N: focus the Nth session in the rendered order (pinned first, then by state,
# ts desc) — the target of ALT+1..9. fzf fires this via `become`, so we inherit its pipes;
# reconnect the real terminal (guarded — absent under the tests) so a tmux/ssh attach gets
# a tty. Counts the same non-empty-KEY rows the number gutter labels, so ALT+K == gutter K.
if [ "$mode" = "--jump-nth" ]; then
  if { : < /dev/tty; } 2>/dev/null; then exec < /dev/tty > /dev/tty 2>/dev/tty; fi
  render_body
  key=$(printf '%s\n' "$body" | awk -F'\t' -v n="${2:-0}" '$1=="" {next} { c++; if (c==n) { print $1; exit } }')
  [ -n "$key" ] && do_jump "$key"
  exit $?
fi

# ---- interactive picker ----
prof start
# (No pane stamp: WezTerm's CTRL+W dismisses the picker by detecting fzf as the live
# foreground process, not a user var. The old OSC 1337 SetUserVar was sticky — it
# survived fzf's exit and left CTRL+W a no-op in any pane that had ever run the picker.)

rows=""
gather_local_rows;  prof gather_local
gather_remote_rows                       # cached homelab snapshot — instant, no network
if [ "$HAVE_WEZTERM" = 1 ]; then
  PANELIST=$(wezterm cli --prefer-mux list --format json 2>/dev/null); prof wezterm_list
  load_titles;      prof load_titles
fi

# header line (right-aligned totals). Counted in pure bash — the old grep|awk|sort|grep
# chain was 4 process spawns, and spawns dominate render time on Windows.
total=0; declare -A _mh=()
while IFS=$'\t' read -r _st _host _rest; do
  [ -z "$_st" ] && continue
  total=$(( total + 1 )); [ -n "$_host" ] && _mh["$_host"]=1
done <<< "$rows"
machines=${#_mh[@]}
[ "$total" = 1 ]    && ts_s="" || ts_s="s"
[ "$machines" = 1 ] && ms_s="" || ms_s="s"
htext="${total} session${ts_s} · ${machines} machine${ms_s}"
printf -v hdrline '%*s' 72 "$htext"

body=$(build_pretty); prof build_pretty
[ -z "$body" ] && body="$NO_SESSIONS_ROW"

# Self-reference used by every fzf bind (reload/preview/rename/pin/jump). Defaults to the
# deployed path; AGENTVIEW_SELF overrides it so an un-deployed copy (e.g. a worktree under
# review) can drive its own picker end-to-end without clobbering the installed binary.
SELF="${AGENTVIEW_SELF:-$HOME/.local/bin/agentview}"
# Live reload: open instantly on the cached snapshot above, then in the BACKGROUND
# refresh the homelab cache over ssh and POST a `reload` into this fzf via its
# --listen server, so fresh remote rows swap in without ever blocking the open. The
# ssh is ConnectTimeout-bounded and the EXIT trap kills this job before the script
# returns — nothing lingers to keep the picker's ConPTY alive (which is what hung
# CTRL+W). If curl/ssh are missing or the pull fails, the picker just keeps showing
# the cached snapshot — no error path. CTRL+F forces a manual refresh.
portfile="$HOME/.agentview-fzfport.$$"
rm -f "$portfile" 2>/dev/null
(
  refresh_remote
  for _ in $(seq 1 40); do [ -s "$portfile" ] && break; sleep 0.05; done   # await fzf's port (start-bind)
  p=$(cat "$portfile" 2>/dev/null)
  [ -n "$p" ] && curl -s -XPOST "127.0.0.1:$p" \
      --data "reload('$SELF' --body)+refresh-preview" >/dev/null 2>&1
) >/dev/null 2>&1 &   # detach stdio so the job never holds the picker's pipes open
poster_pid=$!
trap 'kill "$poster_pid" 2>/dev/null; rm -f "$portfile" 2>/dev/null' EXIT

sel=$(printf '%s\n' "$body" | fzf \
  --ansi --no-sort --cycle --layout=reverse --delimiter='\t' --with-nth=2.. \
  --height='~90%' --min-height=12 --margin=1,2% --padding=1 \
  --border=rounded --border-label="$LABEL" --border-label-pos=3 \
  --prompt="$PROMPT" --ghost='filter sessions…' --pointer='▌' \
  --info=hidden --no-scrollbar --highlight-line \
  --header="$hdrline" --header-first \
  --footer='  ↵ switch · alt-# jump · ⌃r rename · ⌃p pin · ⌃n new · ⌃x remove · ⌃f refresh · ? keys · esc' \
  --preview="'$SELF' --card {1}" \
  --preview-window='right,46%,border-left,hidden,wrap' \
  --preview-label=' session ' \
  --listen=0 \
  --bind='start:execute-silent(echo $FZF_PORT > '"$portfile"')' \
  --bind='ctrl-r:execute('"'$SELF'"' --rename {1})+reload('"'$SELF'"' --body)+refresh-preview' \
  --bind='ctrl-p:execute-silent('"'$SELF'"' --pin {1})+reload('"'$SELF'"' --body)+refresh-preview' \
  --bind='ctrl-f:reload('"'$SELF'"' --body)+refresh-preview' \
  --bind='ctrl-n:execute('"'$SELF'"' --spawn)+reload('"'$SELF'"' --body)+refresh-preview' \
  --bind='ctrl-x:execute('"'$SELF'"' --remove {1})+reload('"'$SELF'"' --body)+refresh-preview' \
  --bind='alt-1:become('"'$SELF'"' --jump-nth 1)' \
  --bind='alt-2:become('"'$SELF'"' --jump-nth 2)' \
  --bind='alt-3:become('"'$SELF'"' --jump-nth 3)' \
  --bind='alt-4:become('"'$SELF'"' --jump-nth 4)' \
  --bind='alt-5:become('"'$SELF'"' --jump-nth 5)' \
  --bind='alt-6:become('"'$SELF'"' --jump-nth 6)' \
  --bind='alt-7:become('"'$SELF'"' --jump-nth 7)' \
  --bind='alt-8:become('"'$SELF'"' --jump-nth 8)' \
  --bind='alt-9:become('"'$SELF'"' --jump-nth 9)' \
  --bind='ctrl-o:toggle-preview' \
  --bind='?:show-preview+preview('"'$SELF'"' --keys)' \
  --color='bg+:#313244,bg:-1,fg:#cdd6f4,fg+:#ffffff,gutter:-1,hl:#f38ba8,hl+:#f38ba8,header:#9399b2,footer:#6c7086,info:#cba6f7,pointer:#b4befe,prompt:#cba6f7,border:#45475a,label:#bac2de,ghost:#585b70,preview-border:#45475a,preview-label:#bac2de') || exit 0

[ -z "$sel" ] && exit 0
key=$(printf '%s' "$sel" | cut -f1)
[ -z "$key" ] && exit 0
do_jump "$key"

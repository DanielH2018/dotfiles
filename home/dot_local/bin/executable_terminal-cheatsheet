#!/usr/bin/env node
'use strict';
// terminal-cheatsheet — regenerate a single-page HTML cheatsheet of this machine's
// terminal + Neovim + Yazi + Claude Code keybinds and key settings, parsed from the
// DEPLOYED config files (so it reflects what's actually running, template-rendered).
//
// Cross-platform by design. It parses whichever configs are PRESENT, so the same
// generator works everywhere:
//   Windows -> WezTerm + Neovim + Yazi     macOS -> Ghostty + Neovim + Yazi
//   Linux   -> Neovim + Yazi (+ Ghostty if installed there)
// Claude Code keybinds (~/.claude/keybindings.json) are added on any box that has the
// file. Under WSL the WezTerm config lives on the Windows side, so the generator also
// probes /mnt/c/Users/*/.config/wezterm/wezterm.lua — the Linux sheet then still shows
// the WezTerm binds you type in the host terminal. Any config that's absent is skipped.
// Config roots honor $XDG_CONFIG_HOME and $YAZI_CONFIG_HOME, else ~/.config.
//
// Nothing runs it on `chezmoi apply`. Run it by hand when the WezTerm / Ghostty / Neovim /
// Yazi / Claude keybindings change:  terminal-cheatsheet [output.html]
//
// Dependency-free (regex parsing). Parsers are format-driven, not entry-driven, so
// new keybinds/settings flow through automatically on the next run.
//
// This file is the CLI and nothing else. The work lives in
// ~/.local/share/terminal-cheatsheet, resolved relative to this script so the same path
// holds in the chezmoi source tree (home/dot_local/{bin,share}) and on a deployed machine:
//
//   core.js      the config roots and the primitives the rest share
//   parsers/     one module per config format — wezterm, ghostty, nvim, yazi, claude
//   render.js    cards to HTML, with the stylesheet and filter script under assets/

const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');

const HOME = os.homedir();
const OUT = process.argv[2] || process.env.TERMINAL_CHEATSHEET_OUT ||
  path.join(HOME, '.local', 'share', 'terminal-cheatsheet.html');

const { build } = require(path.join(__dirname, '..', 'share', 'terminal-cheatsheet', 'render.js'));

// Wrap a path in an OSC 8 terminal hyperlink so it's clickable in WezTerm / Ghostty /
// iTerm2 / Kitty. Under WSL the click is handled by the Windows-side terminal, so a
// Linux path must be rewritten to a \\wsl.localhost\<distro>\… UNC URI to resolve.
const fileUri = (p) => {
  const abs = path.resolve(p).replace(/\\/g, '/');
  const distro = process.env.WSL_DISTRO_NAME;
  if (distro && abs.startsWith('/')) return encodeURI('file://wsl.localhost/' + distro + abs);
  return encodeURI('file://' + (abs.startsWith('/') ? abs : '/' + abs)); // Windows C:/… -> /C:/…
};
// chezmoi runs run_ scripts without a TTY (isTTY is false) but still forwards their
// stdout to the terminal, so emit the link under `chezmoi apply` (CHEZMOI=1) too.
// A manual run redirected to a file (no TTY, no CHEZMOI) stays plain text.
const termLink = (p, text = p) =>
  (process.stdout.isTTY || process.env.CHEZMOI)
    ? `\x1b]8;;${fileUri(p)}\x1b\\${text}\x1b]8;;\x1b\\` : text;

fs.mkdirSync(path.dirname(OUT), { recursive: true });
fs.writeFileSync(OUT, build());
console.log('terminal-cheatsheet: wrote ' + termLink(OUT, path.basename(OUT)));

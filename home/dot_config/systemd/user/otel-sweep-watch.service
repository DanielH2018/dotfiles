[Unit]
Description=Check that every machine is still exporting Claude Code telemetry
Documentation=file:%h/.local/bin/otel-sweep-watch
# Ordering only. The sweep reaches daniel-box and daniel-server over ssh, which needs no
# graphical session — but notify-send does, and a finding raised before the desktop exists
# would be dropped silently.
After=graphical-session.target

[Service]
Type=oneshot
# systemd's user manager does not source a login shell, so ~/.local/bin — where otel-sweep
# and its runner live — is absent from the default PATH. ssh, python3 and notify-send come
# from /usr/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/otel-sweep-watch
# Exit 1 means "findings", and the unit is deliberately left to fail on it so it appears in
# `systemctl --user --failed`. There was a `SuccessExitStatus=1` here, which did the exact
# opposite of what its own comment claimed: it told systemd exit 1 was success, so a run with
# findings went `inactive (dead)` and showed up in no failed list. Combined with a headless
# box, where notify-send has no bus, that made a real finding on 2026-08-23 invisible in every
# channel at once. Do not re-add it without replacing the signal it removes.
# Three machines, a per-session Loki query each on the deep pass. Nowhere near this in
# practice; it exists so an unreachable host cannot leave the unit hanging until tomorrow.
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle
# stdout is the record; journald already rotates it, so the runner keeps no log of its own.
StandardOutput=journal
StandardError=journal

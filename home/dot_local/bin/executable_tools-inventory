#!/usr/bin/env node
'use strict';
// tools-inventory — regenerate the HTML inventory of every command this dotfiles repo
// installs. Sibling in spirit to terminal-cheatsheet, with one deliberate difference:
// the cheatsheet parses the DEPLOYED configs, this reads the chezmoi SOURCE tree.
//
// It has to. The roster must include tools this machine does not get — rendered from a
// Fedora box, a deployed-tree scan would silently omit every Windows script and report an
// inventory that looks complete and is not.
//
// Three sources of truth, kept apart on purpose:
//
//   prose      tools.json, in this script's library dir. What a tool is for, why it
//              exists, its flags, and which platforms it actually works on. None of that
//              is derivable, so it is curated and reviewed like any other content.
//   structure  the source tree. Which scripts exist, how long they are, what interpreter
//              they use, whether their tests are present.
//   this host  `chezmoi ignored` + a filesystem check. NOT a second parser for
//              .chezmoiignore — that file is a template with hostname lists and an
//              includeTemplate call, and a reimplementation of it would drift silently
//              and produce a confidently wrong platform column, which is the exact
//              failure this page exists to prevent. chezmoi evaluates its own templates;
//              we ask it.
//
// A script in the source tree with no tools.json entry is still rendered, from its own
// header comment, and reported in a drift banner at the top of the page as well as on
// stderr. A warning during `chezmoi apply` scrolls past; a banner does not.
//
// The output carries no timestamp, so an unchanged inventory renders byte-identical and
// the write is skipped. That is what keeps it cheap enough to run on every apply.
//
// This file is the CLI and nothing else. The work lives in ~/.local/share/tools-inventory,
// resolved relative to this script so the same path holds in the chezmoi source tree
// (home/dot_local/{bin,share}) and on a deployed machine:
//
//   core.js      pure decisions — header extraction, drift diffing, the per-host gate
//   sources.js   the source-tree scan and the three questions only chezmoi can answer
//   render.js    model to HTML, with the stylesheet and browser code under assets/
//   build.js     joins the three sources of truth into the model render.js consumes
//
//   tools-inventory [out.html]   render (default ~/.claude/artifacts/chezmoi-tools.html)
//   tools-inventory --check      report drift, write nothing, exit 1 if any
//
// Env: TOOLS_INVENTORY_OUT, TOOLS_INVENTORY_SOURCE (chezmoi source dir),
//      TOOLS_INVENTORY_DATA (tools.json), TOOLS_INVENTORY_IGNORED (newline-separated
//      ignore list, for tests — bypasses running chezmoi).

const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');

const LIB = path.join(__dirname, '..', 'share', 'tools-inventory');

const core = require(path.join(LIB, 'core.js'));
const sources = require(path.join(LIB, 'sources.js'));
const render = require(path.join(LIB, 'render.js'));
const { build } = require(path.join(LIB, 'build.js'));

const HOME = os.homedir();

function main(argv) {
  const args = argv.slice(2);
  const check = args.includes('--check');
  if (args.includes('-h') || args.includes('--help')) {
    process.stdout.write('usage: tools-inventory [out.html] | --check\n');
    return 0;
  }
  const sourceDir = sources.resolveSourceDir();
  const dataPath =
    process.env.TOOLS_INVENTORY_DATA || path.join(HOME, '.local', 'share', 'tools-inventory', 'tools.json');
  const out =
    args.find((a) => !a.startsWith('-')) ||
    process.env.TOOLS_INVENTORY_OUT ||
    path.join(HOME, '.claude', 'artifacts', 'chezmoi-tools.html');

  let html;
  try {
    html = build({ sourceDir, dataPath });
  } catch (e) {
    process.stderr.write(`tools-inventory: ${e.message}\n`);
    return 1;
  }

  // Drift goes to stderr as well as into the page — a run under `chezmoi apply` is where
  // a newly added tool is most likely to be noticed.
  const data = JSON.parse(fs.readFileSync(dataPath, 'utf8'));
  const found = sources.scanSources(sourceDir);
  const drift = core.driftOf(found, data.tools, (data.excluded || {}).paths, (rel) =>
    fs.existsSync(path.join(sourceDir, rel))
  );
  if (!sources.chezmoiIgnored(sourceDir)) {
    process.stderr.write('tools-inventory: `chezmoi ignored` unavailable — page rendered without the per-host column\n');
  }
  for (const p of drift.uncurated) process.stderr.write(`tools-inventory: no tools.json entry for ${p}\n`);
  for (const m of drift.missing) process.stderr.write(`tools-inventory: curated entry has no file: ${m}\n`);

  if (check) return drift.uncurated.length || drift.missing.length ? 1 : 0;

  // No timestamp in the output, so an unchanged inventory is byte-identical and the write
  // is skipped. Running this on every apply costs a few reads and nothing else.
  let prev = null;
  try { prev = fs.readFileSync(out, 'utf8'); } catch { /* first run */ }
  if (prev === html) return 0;

  fs.mkdirSync(path.dirname(out), { recursive: true });
  fs.writeFileSync(out, html);
  process.stderr.write(`tools-inventory: wrote ${out.replace(HOME, '~')}\n`);
  return 0;
}

// The suite reaches the pure core through this file, so the surface it imports stays here
// even though every implementation now lives in the library dir.
module.exports = {
  esc: core.esc,
  langOf: core.langOf,
  countLines: core.countLines,
  headerComment: core.headerComment,
  coveredPaths: core.coveredPaths,
  codeFiles: core.codeFiles,
  driftOf: core.driftOf,
  hostState: core.hostState,
  humanCount: core.humanCount,
  listSources: sources.listSources,
  renderPage: render.renderPage,
  build,
};

if (require.main === module) process.exit(main(process.argv));

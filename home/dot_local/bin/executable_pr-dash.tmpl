#!/usr/bin/env bash
# Launch the PR dashboard on a loopback port and open it.
set -euo pipefail

SHARE_DIR="${HOME}/.local/share/pr-dash"
PORT="${PR_DASH_PORT:-8770}"
export PR_DASH_PORT="$PORT"
# This path is about to hand the URL to a browser, so overlapping the first GitHub fetch
# with the server's startup still pays for itself here. The launchd agent does not set this
# — see the spec's "The pre-load becomes opt-in".
export PR_DASH_PRELOAD=1
# The GitHub owners whose repositories the dashboard shows by default, from the same source
# the launchd plist reads: `prDashWorkOrgs` in the machine-local ~/.config/chezmoi/chezmoi.toml,
# under [data]. chezmoi renders it here at apply time, as it renders the plist at activation;
# a machine that sets no such key gets an empty string, which parseWorkOrgs reads as no work
# organizations at all — every repository then counts as work and the Personal chip stays
# hidden. Single-quoted on its own line, so the unrendered template is itself valid shell
# and the raw file can be shellchecked. An explicit PR_DASH_WORK_ORGS in the environment
# wins, as PR_DASH_PORT does above; `-` rather than `:-`, so an exported empty string is an
# override too (it shows every PR). This only matters on a cold start: when the launchd
# agent already holds the port, `serving` below opens the browser on it and the agent's own
# environment applies.
WORK_ORGS_DEFAULT='{{ if hasKey . "prDashWorkOrgs" }}{{ .prDashWorkOrgs }}{{ end }}'
export PR_DASH_WORK_ORGS="${PR_DASH_WORK_ORGS-$WORK_ORGS_DEFAULT}"

URL="http://127.0.0.1:${PORT}/"
API_URL="http://127.0.0.1:${PORT}/api/prs"

# Whether pr-dash itself is what holds the port — not merely that something answers there.
# `curl -f` against `/` accepted any 2xx from any server, so another development server on
# 8770 made this script announce "pr-dash is already serving ..." and open the browser on an
# unrelated application.
#
# The property relied on is the shape of every /api/prs response pr-dash can produce. A
# success carries `partialErrors`, which cannot go missing: PrsResponseBody in src/server.ts
# is derived from loadPrs's own return type through `Required`, so tsc refuses a response
# literal that omits it. The only other status this route answers with is the 500 from
# createServer's catch-all, whose body is `{"error": ...}` — which is why the check accepts
# it: a failed token resolution still proves pr-dash is the thing on the port, and the probe
# must not depend on GitHub, on `op`, or on a warm cache. `curl -f` is deliberately absent,
# since it would discard that 500 body.
#
# No /healthz route: a new endpoint is a new surface on a server whose entire request
# boundary is checkHost.
serving() {
  local response status body newline=$'\n'
  response="$(curl -s -m 5 -w '\n%{http_code}' "$API_URL")" || return 1
  status="${response##*"$newline"}"
  body="${response%"$newline"*}"
  case "$status" in
    200) [[ "$body" == *'"partialErrors"'* ]] ;;
    500) [[ "$body" == *'"error"'* ]] ;;
    *) return 1 ;;
  esac
}

# The launchd agent holds this port permanently, so finding it already occupied is the
# normal case now, not an error: open the URL against whatever is already serving it
# instead of trying (and failing) to start a second server. This must run before the trap
# below: under `set -euo pipefail`, an EXIT trap that references SERVER_PID would error on
# this early exit, since SERVER_PID is never assigned on this path.
if serving; then
  echo "pr-dash is already serving ${URL} (launchd agent or another run); opening it."
  if ! open "$URL"; then
    echo "Could not open a browser automatically. Open this URL yourself:" >&2
    echo "$URL" >&2
  fi
  exit 0
fi

node "${SHARE_DIR}/src/main.ts" &
SERVER_PID=$!
trap 'kill "$SERVER_PID" 2>/dev/null || true' EXIT

# Wait until the server actually answers before handing the URL to the browser. A fixed
# sleep opened a dead port: process start plus the payload-store read can take a moment, so
# the browser showed ERR_CONNECTION_REFUSED and the user had to reload by hand.
#
# `/` is the probe: it answers as soon as the server is listening, with no dependency on
# GitHub or the cache.
#
# `SECONDS` and the loop counter carry the deadline rather than `timeout(1)`, which is GNU
# coreutils and is not on a script's PATH on this machine.
READY_DEADLINE=$((SECONDS + 60))
until curl -fs -o /dev/null "$URL"; do
  # A server that has already exited will never answer, so stop waiting for it. It has
  # printed its own reason — no token, a bad port, a port already in use — and burying
  # that under a 60-second wait is what made the old failure hard to read.
  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    SERVER_STATUS=0
    wait "$SERVER_PID" || SERVER_STATUS=$?
    echo "pr-dash exited before it began listening; see the error above." >&2
    exit "$((SERVER_STATUS == 0 ? 1 : SERVER_STATUS))"
  fi
  if ((SECONDS >= READY_DEADLINE)); then
    echo "pr-dash did not start listening on 127.0.0.1:${PORT} within 60s; giving up." >&2
    exit 1
  fi
  sleep 0.1
done

# `open`'s exit status must not reach `set -e`: under -e, a failing command that
# isn't part of a condition ends the script, which fires the EXIT trap and kills
# the server this script just started over a browser launch that never mattered
# to the server's own lifetime — e.g. no GUI session over SSH, or no default
# handler registered. Testing it in an `if` keeps the failure from tripping -e.
if ! open "$URL"; then
  echo "Could not open a browser automatically. Open this URL yourself:" >&2
  echo "$URL" >&2
fi
wait "$SERVER_PID"

# =============================================================================
# INTERACTIVE SHELL CHECK (exit early for non-interactive)
# =============================================================================
[[ -o interactive ]] || return

# Config shared with bash (env, PATH, aliases, functions, tool init) lives in
# ~/.config/shell/common.sh — the single source of truth, sourced below. This file holds
# only the zsh-specific pieces: history/options, the completion system, keybindings,
# the fastfetch wrapper, and the autosuggestions/syntax-highlighting plugins.

# =============================================================================
# BREW PREFIX (Homebrew init itself lives in .zprofile)
# =============================================================================
BREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
export HOMEBREW_NO_ENV_HINTS=1

# =============================================================================
# ENVIRONMENT VARIABLES
# =============================================================================
# Prefer en_US.UTF-8 but fall back to C.UTF-8 on a minimal host that hasn't generated it
# (a bare Pi/Debian), so locale-aware tools don't spam "Cannot set LC_ALL".
if locale -a 2>/dev/null | command grep -qiE '^en_US\.utf-?8$'; then
  export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
else
  export LANG=C.UTF-8 LC_ALL=C.UTF-8
fi
{{- if eq .chezmoi.os "darwin" }}

# Compilation flags
export ARCHFLAGS="-arch $(uname -m)"
{{- end }}

# =============================================================================
# HISTORY CONFIGURATION
# =============================================================================
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=200000
export SAVEHIST=200000
# SHARE_HISTORY implies INC_APPEND, so we don't set both.
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_FIND_NO_DUPS \
       HIST_REDUCE_BLANKS HIST_SAVE_NO_DUPS HIST_IGNORE_SPACE HIST_VERIFY \
       EXTENDED_HISTORY HIST_EXPIRE_DUPS_FIRST

# =============================================================================
# ZSH OPTIONS
# =============================================================================
setopt AUTO_CD EXTENDED_GLOB NO_CASE_GLOB AUTO_MENU

# =============================================================================
# PATH CONFIGURATION (brew/python/coreutils are macOS-only; generic paths in common.sh)
# =============================================================================
{{- if eq .chezmoi.os "darwin" }}

# Ensure Homebrew bin precedes /usr/bin in non-login shells (.zprofile handles login shells).
# The check avoids adding a duplicate entry when .zprofile already ran.
[[ ":$PATH:" != *":$BREW_PREFIX/bin:"* ]] && \
  export PATH="$BREW_PREFIX/bin:$BREW_PREFIX/sbin:$PATH"

export PATH="/opt/homebrew/opt/python@3.14/libexec/bin:$PATH"
if [[ -d "$BREW_PREFIX/opt/coreutils/libexec/gnubin" ]]; then
  export PATH="$BREW_PREFIX/opt/coreutils/libexec/gnubin:$PATH"
fi
{{- end }}

# =============================================================================
# COMPLETION SYSTEM
# =============================================================================
# fpath must be set BEFORE compinit. ~/.claude/sandbox holds our sandbox-tool completions
# (_cts, _claude-sandbox) and is needed on every platform; Homebrew's site-functions is macOS-only.
fpath=("$HOME/.claude/sandbox" $fpath)
{{- if eq .chezmoi.os "darwin" }}
fpath=("$BREW_PREFIX/share/zsh/site-functions" $fpath)
# Docker Desktop's CLI completions; folded in here (not appended near EOF) so the
# single compinit call below sees the full fpath and never needs to run twice (A14-09).
fpath=("$HOME/.docker/completions" $fpath)
{{- end }}

autoload -Uz compinit
ZCOMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-$ZSH_VERSION"
mkdir -p "${ZCOMPDUMP:h}"

# Run security checks once per day, otherwise skip for performance
if [[ -n "$ZCOMPDUMP"(#qN.mh+24) ]]; then
  compinit -d "$ZCOMPDUMP"
  # Re-arm the 24h freshness guard above; without this the full branch fires on
  # every start instead of once a day (A14-07).
  touch "$ZCOMPDUMP"
else
  compinit -C -d "$ZCOMPDUMP"
fi

zmodload zsh/complist
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' 'r:|[._-]=**'
zstyle ':completion:*' menu select
zstyle ':completion:*:cd:*' tag-order 'directories'
zstyle ':completion:*' completer _extensions _complete _approximate
zstyle ':completion:*' list-dirs-first yes
zstyle ':completion:*' special-dirs true
zstyle ':completion:*' file-sort name
zstyle ':completion:*' squeeze-slashes true

# Enable completion caching for better performance
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompcache"

# =============================================================================
# SHARED CONFIG (env, PATH, aliases, functions, tool init — one source of truth with bash)
# =============================================================================
# Sourced after PATH + completion setup so tool detection sees Homebrew, and starship's/
# zoxide's hooks register alongside compinit. Sets EDITOR, CLAUDE_CODE_MAX_OUTPUT_TOKENS,
# the eza/qol aliases, the y/ff/mkcd/zz/curlie functions, fnm, and the FZF_* env.
[[ -r "$HOME/.config/shell/common.sh" ]] && source "$HOME/.config/shell/common.sh"

# =============================================================================
# FZF KEY BINDINGS + COMPLETION (zsh integration; the FZF_* env is set in common.sh)
# =============================================================================
if command -v fzf >/dev/null 2>&1; then
  # fzf >= 0.48 emits keybindings + completion directly. Preferred: our Linux fzf lives in
  # ~/.local/bin with no apt package, so /usr/share/doc/fzf integration files won't exist.
  if fzf --zsh >/dev/null 2>&1; then
    source <(fzf --zsh)
  else
    [[ -r "$BREW_PREFIX/opt/fzf/shell/key-bindings.zsh" ]] && source "$BREW_PREFIX/opt/fzf/shell/key-bindings.zsh"
    [[ -r "$BREW_PREFIX/opt/fzf/shell/completion.zsh" ]] && source "$BREW_PREFIX/opt/fzf/shell/completion.zsh"
    # Linux (Debian/Ubuntu fzf package) ships shell integration here:
    [[ -r /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
    [[ -r /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh
    [[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh
  fi
fi

# =============================================================================
# QUALITY OF LIFE (zsh-specific config aliases; generic ones live in common.sh)
# =============================================================================
alias zshconfig="$EDITOR ~/.zshrc"
{{- if eq .chezmoi.os "darwin" }}
alias configterminal="$EDITOR ~/.zshrc ~/.config/ghostty/config ~/.config/starship.toml"
{{- else }}
alias configterminal="$EDITOR ~/.zshrc ~/.config/starship.toml"
{{- end }}

# =============================================================================
# KEYBINDINGS (history search & word nav)
# =============================================================================
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word

# =============================================================================
# FASTFETCH (banner on login; per-terminal logo logic is _ff_banner in common.sh)
# =============================================================================
# Login shells only, to avoid slowing every new tab. $+commands tests zsh's
# external-command table, so the banner runs only when the binary is installed.
if [[ -o login ]] && (( $+commands[fastfetch] )); then
  _ff_banner
fi

# =============================================================================
# PLUGINS (autosuggestions, then syntax-highlighting LAST)
# =============================================================================
# Source from Homebrew (macOS) or the system package dir (Linux), whichever exists.
for _zp in \
  "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
  /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh; do
  [[ -r "$_zp" ]] && { source "$_zp"; break; }
done

# zsh-syntax-highlighting MUST be sourced after all ZLE widgets are defined.
for _zp in \
  "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
  /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
  [[ -r "$_zp" ]] && { source "$_zp"; break; }
done
unset _zp

# Catppuccin Mocha for the command line itself, matching the terminal. The plugin's stock
# styles are the basic 8 ANSI colours, so a mistyped command flashed a raw red next to an
# otherwise all-Mocha prompt. Only the styles that actually fire while typing are set; the
# rest fall back to the plugin's defaults.
if (( ${+ZSH_HIGHLIGHT_STYLES} )); then
  ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#f38ba8,bold'          # red — no such command
  ZSH_HIGHLIGHT_STYLES[command]='fg=#a6e3a1'                     # green
  ZSH_HIGHLIGHT_STYLES[builtin]='fg=#a6e3a1'
  ZSH_HIGHLIGHT_STYLES[function]='fg=#a6e3a1'
  ZSH_HIGHLIGHT_STYLES[alias]='fg=#a6e3a1'
  ZSH_HIGHLIGHT_STYLES[precommand]='fg=#a6e3a1,italic'
  ZSH_HIGHLIGHT_STYLES[path]='fg=#cdd6f4,underline'              # text
  ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#f9e2af'      # yellow
  ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#f9e2af'
  ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg=#f9e2af'
  ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg=#fab387'        # peach
  ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg=#fab387'
  ZSH_HIGHLIGHT_STYLES[comment]='fg=#6c7086'                     # overlay0
  ZSH_HIGHLIGHT_STYLES[redirection]='fg=#cba6f7'                 # mauve
  ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=#cba6f7'
fi
# The autosuggestion ghost text: overlay0, so it reads as a hint and not as typed input.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6c7086'

# Machine-local shell config (provided per-machine; absent on portable machines)
[[ -r "$HOME/.config/zsh/local.zsh" ]] && source "$HOME/.config/zsh/local.zsh"

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

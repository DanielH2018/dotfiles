#!/usr/bin/env bash
# Enable the daily transcript credential sweep. run_onchange re-runs (and reloads systemd)
# whenever the unit files below change — their hashes are embedded so edits retrigger it.
# Idempotent; a no-op where user systemd isn't running (e.g. a non-lingering headless box).
#
# Without this the timer deploys and never starts, which is the worst of both: the file is
# on disk, `chezmoi diff` is clean, and nothing ever sweeps.
#   service: {{ include "dot_config/systemd/user/claude-transcript-scan.service" | sha256sum }}
#   timer:   {{ include "dot_config/systemd/user/claude-transcript-scan.timer" | sha256sum }}
set -eu
if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  systemctl --user daemon-reload || true
  systemctl --user enable --now claude-transcript-scan.timer || true
fi

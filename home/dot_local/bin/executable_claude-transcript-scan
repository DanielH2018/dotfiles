#!/usr/bin/env bash
# claude-transcript-scan: find credentials that have already landed in a session transcript.
#
# The preventive half of this problem is block-dangerous-bash.sh, which denies a command
# before it runs. It cannot close the whole gap, and the reason is structural rather than a
# missing rule: no hook can rewrite a tool result. Verified 2026-08-29 against Claude Code
# 2.1.251 — the PreToolUse output fields are permissionDecision, permissionDecisionReason,
# updatedInput, additionalContext and systemMessage, and none of them replaces output.
# Claude Code's own redactor (sk-ant-*, Bearer, JWT, gh*_/gl*-/xox*-) is called from the
# logger and from redactForDisplay, so it covers the journal and the terminal, not the
# transcript the model reads back.
#
# So a `grep` that happens to print a line CARRYING a key is undecidable at the gate: the
# command names no secret path and no decrypt verb. Detection is the only layer left, and it
# is a bounded problem where prevention is an asymptotic one. This is that layer.
#
# What it does NOT do: un-leak anything. A secret in a transcript stays there. The output of
# this script is a rotation trigger — the value is already spent, and the only question left
# is how long it stays valid.
#
#   claude-transcript-scan                    # transcripts touched in the last 24h
#   claude-transcript-scan --since 72         # ...or a different window, in hours
#   claude-transcript-scan --session PATH     # one transcript (what the SessionEnd hook runs)
#   claude-transcript-scan --all              # every transcript on the machine
#   claude-transcript-scan --accept-baseline  # record today's findings as known; report only new ones
#   claude-transcript-scan --paranoid         # gitleaks' FULL ruleset, for a deliberate audit
#   claude-transcript-scan --no-loki          # transcripts only; skip the Loki store
#
# BOTH stores are scanned by default. Claude Code sends the full command text to Loki as
# tool_input/tool_parameters and the prompt as `prompt`, and Loki keeps them for 744h, so
# a credential typed inline on a command line has two lifetimes. Every verdict names the
# stores it covered, because "clean across 37 source(s)" cannot be told apart from a scan
# that skipped one. A leak present in both reports twice, under `loki` and under the
# transcript's name, and each needs accepting separately -- two copies, two lifetimes.
#
# --no-loki is for a machine with no otelq or no reachable Loki. Without it a missing
# otelq is exit 3, could-not-evaluate, the same as a missing gitleaks: skipping a store
# silently is the failure this tool exists to prevent.
#   claude-transcript-scan --clear-pending    # dismiss the SessionStart banner WITHOUT baselining anything
#
# Exit 0 clean or nothing new, 1 NEW findings, 2 usage error, 3 could-not-evaluate. 3 is
# deliberately not 0: a missing gitleaks means the question was never asked, and a detector
# that reports clean when it did not run is worse than no detector.
#
# WHY A BASELINE. The first real sweep, 2026-08-29, returned 52 findings across 82
# transcripts: 45 of them gitleaks' `generic-api-key`, which fires on a k8s `secretKeyRef:`
# field name and on a SOPS key listing as readily as on a credential. A daily unit that goes
# red every day on noise gets muted inside a week, and then it caps nothing — the same
# failure mode as a monitor nobody trusts. So known findings are accepted once, by hand,
# after triage, and only what is NEW alerts.
#
# The risk runs the other way too, which is why accepting is never automatic and never part
# of the timer: a blanket --accept-baseline over an untriaged sweep is exactly how a real
# leak gets buried. Triage first, accept second.
#
# WHY A NARROWED RULESET. The baseline clears the historical backlog; it does not stop the
# drip. Live sessions kept producing fresh `generic-api-key` matches — 4 in the two minutes
# after the first baseline was accepted — because that rule matches on entropy alone and a
# transcript is full of long high-entropy identifiers that are not credentials. So the daily
# run uses ~/.config/gitleaks/transcript-scan.toml, which disables that one rule and keeps
# every named, structured rule. The reasoning and the measurements are in that file.
#
# --paranoid restores the full set. The cost of narrowing is real and is named there: it is
# the rule that flagged the Sonarr and Radarr admin passwords, so a deliberate audit should
# use --paranoid rather than trusting the daily run to have looked everywhere.

set -uo pipefail

PROJECTS=${CLAUDE_TRANSCRIPT_ROOT:-$HOME/.claude/projects}
LOG=${CLAUDE_TRANSCRIPT_LEAK_LOG:-$HOME/.claude/logs/transcript-leaks.jsonl}
BASELINE=${CLAUDE_TRANSCRIPT_LEAK_BASELINE:-$HOME/.claude/logs/transcript-leaks-baseline.txt}
GL_CONFIG=${CLAUDE_TRANSCRIPT_GITLEAKS_CONFIG:-$HOME/.config/gitleaks/transcript-scan.toml}
# A finding outlives the process that found it, and neither unattended caller keeps the
# verdict: session-end.sh backgrounds this with its output discarded, and the timer's
# journal line is read by nobody. A desktop notification does not close that gap either —
# notify-send needs a running daemon and osascript needs a Mac, and a headless host has
# neither. So the durable alert is a FILE, which session-context.sh reads into the next
# session's context on every platform. Cleared by --accept-baseline or --clear-pending.
PENDING=${CLAUDE_TRANSCRIPT_LEAK_PENDING:-$HOME/.claude/logs/transcript-leaks-pending}
SINCE_H=24
MODE=window
ONE=
ACCEPT=0
PARANOID=0
CLEAR=0
# Loki is scanned by DEFAULT. It was opt-in for one day and that was a mistake: --loki
# lived only in the systemd unit, so a hand-run scan quietly covered one store of two and
# printed a clean verdict for a store it never opened. "The obvious invocation does less
# than the timer" is the same could-not-run-reads-as-clean failure this tool exists to
# prevent. --no-loki is the explicit way out, for a machine with no otelq or no Loki.
LOKI=1

while [ $# -gt 0 ]; do
  case $1 in
    --since) SINCE_H=${2:-}; shift 2 || true ;;
    --session) MODE=one; ONE=${2:-}; shift 2 || true ;;
    --all) MODE=all; shift ;;
    --accept-baseline) ACCEPT=1; shift ;;
    --paranoid) PARANOID=1; shift ;;
    --loki) LOKI=1; shift ;;          # kept: still accepted, now the default
    --no-loki) LOKI=0; shift ;;
    --clear-pending) CLEAR=1; shift ;;
    -h|--help) sed -n '2,53p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "claude-transcript-scan: unknown argument: $1" >&2; exit 2 ;;
  esac
done

# The way out that does not also accept anything. Triaging a finding — rotating the
# credential and confirming it — settles it without adding a fingerprint to the baseline,
# and with no way to say so the banner would either persist forever or push you toward a
# blanket accept, which is the one thing this whole tool warns against.
if [ "$CLEAR" = 1 ]; then
  rm -f "$PENDING"
  echo "claude-transcript-scan: cleared the pending-findings marker. The log at $LOG is untouched."
  exit 0
fi
case $SINCE_H in ''|*[!0-9]*) echo "claude-transcript-scan: --since wants whole hours" >&2; exit 2 ;; esac

# The daily run uses a narrowed ruleset; --paranoid uses gitleaks' full default set. The
# reason is in the config file itself — `generic-api-key` matches on entropy alone, and a
# transcript is full of long high-entropy identifiers that are not credentials.
#
# A MISSING config falls back to the full set rather than refusing. That direction is
# deliberate and is the opposite of the missing-gitleaks case below: no gitleaks means the
# question was never asked, while no config means it was asked too broadly. Over-reporting
# is recoverable by reading the findings; under-reporting is not.
GL_RULES=
if [ "$PARANOID" = 0 ]; then
  if [ -f "$GL_CONFIG" ]; then
    GL_RULES="--config $GL_CONFIG"
  else
    echo "claude-transcript-scan: no ruleset at $GL_CONFIG — falling back to gitleaks' full set, expect noise" >&2
  fi
fi

# Exit 3 is could-not-evaluate, and it is the one verdict with no other durable trace: a
# finding lands in $LOG, but a scan that never ran leaves nothing behind at all. Record it
# in the same marker, as a zero-count row, so the SessionStart banner reports "the detector
# could not run" rather than the silence that is indistinguishable from "clean".
mark_unavailable() {
  mkdir -p "$(dirname "$PENDING")" 2>/dev/null
  printf '%s\t0\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >> "$PENDING"
}

# gitleaks is not installed system-wide here; prek fetches it into its own cache for the
# repo hook. Take it from PATH first so a real install wins, then the cache, and refuse
# rather than skip if neither exists.
GITLEAKS=${GITLEAKS_BIN:-}
[ -z "$GITLEAKS" ] && GITLEAKS=$(command -v gitleaks 2>/dev/null)
if [ -z "$GITLEAKS" ]; then
  for c in "$HOME"/.cache/prek/hooks/golang-*/bin/gitleaks; do
    [ -x "$c" ] && GITLEAKS=$c && break
  done
fi
if [ -z "$GITLEAKS" ] || [ ! -x "$GITLEAKS" ]; then
  echo "claude-transcript-scan: no gitleaks binary (PATH, \$GITLEAKS_BIN, or the prek cache) — did not scan" >&2
  mark_unavailable "no gitleaks binary"
  exit 3
fi
command -v jq >/dev/null 2>&1 || {
  echo "claude-transcript-scan: jq unavailable — did not scan" >&2
  mark_unavailable "jq unavailable"
  exit 3
}
# A systemd user unit starts with a minimal PATH and otelq lives in ~/.local/bin, so this
# is a live failure mode rather than a theoretical one. Same rule as gitleaks: refuse
# loudly, because a missing query tool would otherwise read as a clean Loki store.
if [ "$LOKI" = 1 ]; then
  command -v otelq >/dev/null 2>&1 || {
    echo "claude-transcript-scan: otelq unavailable — did not scan Loki. Pass --no-loki to scan transcripts only." >&2
    mark_unavailable "otelq unavailable"
    exit 3
  }
fi

case $MODE in
  one)
    [ -f "$ONE" ] || { echo "claude-transcript-scan: no such transcript: $ONE" >&2; exit 2; }
    FILES=$(printf '%s\n' "$ONE") ;;
  all)
    FILES=$(find "$PROJECTS" -name '*.jsonl' -type f 2>/dev/null) ;;
  *)
    # -mmin rather than -mtime: the window is given in hours and -mtime rounds to days,
    # which would silently widen a 1h sweep to 24.
    FILES=$(find "$PROJECTS" -name '*.jsonl' -type f -mmin "-$((SINCE_H * 60))" 2>/dev/null) ;;
esac

# An empty transcript list is only a reason to stop when transcripts are the whole job.
# With --loki there is a second store to scan, and exiting here would have made the Loki
# arm silently conditional on a transcript having been written in the same window.
if [ -z "$FILES" ] && [ "$LOKI" = 0 ]; then
  echo "claude-transcript-scan: no transcripts in scope"
  exit 0
fi

mkdir -p "$(dirname "$LOG")"
FOUND=0
KNOWN=0
SCANNED=0
FAILED=0
# Named in every verdict. "clean across 37 source(s)" cannot be told apart from a scan
# that skipped a whole store; "clean across 37 source(s) (transcripts)" can.
STORES="transcripts"

# The extracted text goes to a temp file rather than straight down a pipe, because the
# fingerprint below has to read the matched line back. Mode 0600, removed on exit: it holds
# nothing the transcript does not already hold in the same home directory, but it holds it
# under a predictable-ish name, so it does not outlive the run.
WORK=$(mktemp) || { echo "claude-transcript-scan: mktemp failed — did not scan" >&2; exit 3; }
chmod 600 "$WORK"
SEEN=$(mktemp) || { echo "claude-transcript-scan: mktemp failed — did not scan" >&2; exit 3; }
chmod 600 "$SEEN"
trap 'rm -f "$WORK" "$SEEN"' EXIT INT TERM

# Both stores scan the same way once their text is in $WORK, so the gitleaks call, the
# fingerprint and the report live here rather than being written twice. $1 is what the log
# records as the source, $2 the token that goes in the fingerprint, $3 the ruleset flags.
scan_work() {
  _src=$1 _tok=$2 _rules=$3
  # The human column wants something short; $_src is a full path or a slice range. Basename
  # for a transcript, the range itself for Loki -- both already identify the finding, and
  # the JSONL record keeps the unabridged source either way.
  _tok_label=${_src##*/}
  # --redact keeps the finding from repeating the secret into the journal and the log file.
  # A detector that prints what it found is a second copy of the leak.
  # shellcheck disable=SC2086  # _rules is a flag pair or empty; word-splitting is the point
  report=$("$GITLEAKS" stdin --redact --no-banner $_rules --report-format json --report-path - < "$WORK" 2>/dev/null)
  rc=$?
  if [ $rc -ne 0 ] && [ $rc -ne 1 ]; then
    echo "claude-transcript-scan: scan failed (rc=$rc): $_src" >&2
    FAILED=$((FAILED + 1))
    return 1
  fi
  SCANNED=$((SCANNED + 1))
  n=$(printf '%s' "$report" | jq 'length' 2>/dev/null || echo 0)
  [ "${n:-0}" -gt 0 ] || return 0

  while IFS=$'\t' read -r rule line; do
    [ -n "$rule" ] || continue
    # Fingerprint on CONTENT, not on position. gitleaks' own Fingerprint is `:<rule>:<line>`
    # and the line is an offset into a derived projection of the source, so compacting a
    # transcript or changing that projection renumbers every finding and a position-keyed
    # baseline silently stops matching. Hashing the matched line survives both. The hash
    # never leaves this machine and cannot be reversed into the value.
    h=$(sed -n "${line}p" "$WORK" | sha256sum | cut -c1-16)
    fp="${rule}:${_tok}:${h}"
    # Seen already in THIS run: the overlap above hands the same finding back twice, and
    # counting it twice would make the total meaningless. Distinct from the baseline check
    # below, which is about findings accepted in an EARLIER run.
    if grep -qxF "$fp" "$SEEN" 2>/dev/null; then
      continue
    fi
    printf '%s\n' "$fp" >> "$SEEN"
    if [ -f "$BASELINE" ] && grep -qxF "$fp" "$BASELINE" 2>/dev/null; then
      KNOWN=$((KNOWN + 1))
      [ "$ACCEPT" = 1 ] || continue
    fi
    if [ "$ACCEPT" = 1 ]; then
      printf '%s\n' "$fp" >> "$BASELINE.new"
      continue
    fi
    FOUND=$((FOUND + 1))
    # Rule id, line, source and fingerprint only. Enough to find it and to name what to
    # rotate, and to accept it later; never enough to re-leak it.
    # Two audiences, two formats. The JSONL record is what --accept-baseline and any
    # later triage read, so it keeps every field; stdout gets a line a person can scan.
    # `tee` used to serve both, which is why a run printed raw JSON at a human.
    jq -cn --arg f "$_src" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg r "$rule" --argjson l "$line" --arg p "$fp" \
      '{ts:$t, transcript:$f, rule:$r, line:$l, fingerprint:$p, secret:"[redacted]"}' \
      >> "$LOG"
    printf '  %-18s %-34s line %s\n' "$rule" "$_tok_label" "$line"
  done <<EOF
$(printf '%s' "$report" | jq -r '.[] | "\(.RuleID)\t\(.StartLine)"')
EOF
  return 0
}

_n_files=$(printf '%s\n' "$FILES" | grep -c . || true)
if [ "$LOKI" = 1 ]; then
  echo "claude-transcript-scan: scanning ${_n_files} transcript(s) and ${SINCE_H} hourly Loki slice(s)"
else
  echo "claude-transcript-scan: scanning ${_n_files} transcript(s); Loki skipped (--no-loki)"
fi

# Section headers print unconditionally, before their arm runs. A header with nothing under
# it is the useful case: it says the store was searched and was clean, which an absent
# header cannot. The whole reason this output was reshaped is that a clean verdict and a
# skipped store looked the same.
printf '\ntranscripts\n'
_found_before_transcripts=$FOUND

while IFS= read -r f; do
  [ -n "$f" ] || continue
  # `[.. | strings]` takes every string leaf of every record, which is what makes this
  # independent of the transcript schema: a value moving from .message.content to some new
  # field stays covered without a change here.
  jq -r '[.. | strings] | join("\n")' "$f" > "$WORK" 2>/dev/null || { FAILED=$((FAILED + 1)); continue; }
  [ -f "$f" ] || continue
  scan_work "$f" "$(basename "$f")" "$GL_RULES" || true
done <<EOF
$FILES
EOF

# ---- the Loki store -------------------------------------------------------------------
# Claude Code attaches the full command text to every tool_result as tool_input and
# tool_parameters, and the prompt to every user_prompt, so a credential typed inline on a
# command line lands in Loki as well as in the transcript. Loki keeps it for 744h. Nothing
# scanned there before 2026-08-31.
#
# TWO deliberate differences from the transcript arm, and they depend on each other:
#
#  * The extraction is NARROW -- three named fields, not `[.. | strings]`. A Loki payload is
#    mostly trace_id/span_id/session_id/user_id: high-entropy hex, which is exactly what
#    generic-api-key matches on.
#  * The ruleset is therefore the FULL default set, never $GL_RULES. generic-api-key is
#    disabled for the daily transcript run because it produced 45 false positives there,
#    and it is the only rule that catches an unstructured `NAME=<32 hex>` -- the shape of
#    every *arr API key. Scanning Loki with the narrowed ruleset would find the same
#    nothing the transcript run finds, which is the entire reason this arm exists.
#
# Measured 2026-08-31 on this host: the full ruleset over one hour of narrowed Loki text
# (378KB) returned 0 findings, and over the events holding a real leaked *arr key it
# returned 12. Narrow the extraction and the expensive rule becomes affordable.
FOUND_TRANSCRIPTS=$((FOUND - _found_before_transcripts))
[ "$FOUND_TRANSCRIPTS" -gt 0 ] || echo "  none"

if [ "$LOKI" = 1 ]; then
  printf '\nloki\n'
  _found_before_loki=$FOUND
  # Loki refuses limit > max_entries_limit_per_query (5000) outright, so a window holding
  # more entries than that must be walked in slices. ~620 entries/hour here, so an hourly
  # slice sits an order of magnitude under the cap -- and a slice that DOES reach it is
  # counted as a failure rather than silently under-scanned, because under-reporting is the
  # one failure this tool cannot recover from.
  # --since is the window WIDTH and --until moves its END, so an hourly slice is
  # `--since <width>`. It read `--since ${h}h` until 2026-08-31 and every slice was
  # therefore a full h-hour window ending ${h-1}h ago -- slice 30 re-scanned the whole
  # 30 hours after it. Two abutting slices returned an identical 4858 entries, which is
  # what exposed it, and a 30h scan reported 30x the events Loki actually held.
  #
  # 70m for a 60m step, so consecutive slices OVERLAP by ten minutes. Each query computes
  # `now` when it runs, so a sequence of them drifts forward and exactly-abutting windows
  # leave a sliver uncovered between each pair: measured 4087 of an authoritative 4130
  # events over 30h before the overlap. Duplicates are free here because the fingerprint
  # is a content hash and $SEEN drops a repeat within the run; a gap is not recoverable.
  LOKI_LIMIT=5000
  h=$SINCE_H
  while [ "$h" -gt 0 ]; do
    until_h=$((h - 1))
    slice=$(otelq logs \
      '{service_name="claude-code"} | event_name=~`tool_result|user_prompt` | keep tool_input, tool_parameters, prompt' \
      --stream --since 70m --until "${until_h}h" --limit "$LOKI_LIMIT" --timeout 60 2>/dev/null)
    if [ -z "$slice" ]; then
      echo "claude-transcript-scan: Loki slice ${h}h..${until_h}h did not return — treat as not scanned" >&2
      FAILED=$((FAILED + 1))
      h=$until_h
      continue
    fi
    entries=$(printf '%s' "$slice" | jq '[.data.result[]] | length' 2>/dev/null || echo 0)
    if [ "${entries:-0}" -ge "$LOKI_LIMIT" ]; then
      echo "claude-transcript-scan: Loki slice ${h}h..${until_h}h hit the ${LOKI_LIMIT}-entry cap — scanned PARTIALLY" >&2
      mark_unavailable "Loki slice ${h}h..${until_h}h truncated at $LOKI_LIMIT entries"
      FAILED=$((FAILED + 1))
    fi
    printf '%s' "$slice" \
      | jq -r '[.data.result[].stream | .tool_input, .tool_parameters, .prompt]
               | map(select(. != null)) | join("\n")' > "$WORK" 2>/dev/null || {
      FAILED=$((FAILED + 1)); h=$until_h; continue; }
    # The fingerprint token is a constant, never the slice bounds: a re-scan with different
    # boundaries must produce the same fingerprint or the baseline stops matching. A leak
    # present in both stores therefore reports twice, under `loki` and under the transcript
    # name, and needs acknowledging twice -- which is correct, since they are two copies
    # with two lifetimes.
    scan_work "${h}h..${until_h}h ago" "loki" "" || true
    h=$until_h
  done
  STORES="transcripts+loki"
  FOUND_LOKI=$((FOUND - _found_before_loki))
  [ "$FOUND_LOKI" -gt 0 ] || echo "  none"
fi

if [ "$FAILED" -gt 0 ] && [ "$SCANNED" -eq 0 ]; then
  echo "claude-transcript-scan: every source failed to scan — treat as not run" >&2
  mark_unavailable "every source failed to scan"
  exit 3
fi

if [ "$ACCEPT" = 1 ]; then
  sort -u "$BASELINE.new" 2>/dev/null > "$BASELINE" && rm -f "$BASELINE.new"
  # Everything outstanding is now baselined, so the marker has nothing left to report.
  rm -f "$PENDING"
  echo "claude-transcript-scan: accepted $(wc -l < "$BASELINE" | tr -d ' ') finding(s) as baseline in $BASELINE"
  echo "Only findings NOT in that file are reported from now on. Triage before accepting — accepting is how a real leak gets buried."
  exit 0
fi

if [ "$FOUND" -gt 0 ]; then
  # Per-store counts, because "18 findings" does not tell you which store to go and read,
  # and the two have different remedies: a transcript is a local file, a Loki record is
  # queryable by anything on the LAN for 744h.
  _split="${FOUND_TRANSCRIPTS:-0} in transcripts"
  [ "$LOKI" = 1 ] && _split="$_split, ${FOUND_LOKI:-0} in loki"
  printf '\n%d new finding(s) — %s. %d baselined, %d source(s) scanned.\n' \
    "$FOUND" "$_split" "$KNOWN" "$SCANNED"
  echo "  Full records: $LOG"
  echo "  Rotate the named credential: uv run python scripts/secrets_mgmt/secret_rotation.py rotate <name>" >&2

  # The durable half. Written before either banner is attempted, so a machine with no
  # notification path at all still records the finding rather than losing it.
  printf '%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$FOUND" "$LOG" >> "$PENDING"

  # The immediate half, best-effort. Same platform order as hooks/notify.sh: osascript is
  # the Mac's only working path, notify-send the Linux desktop's, and a headless host
  # matches neither and is covered by the file above.
  if command -v osascript >/dev/null 2>&1; then
    osascript -e 'on run argv
      display notification (item 2 of argv) with title (item 1 of argv)
    end run' -- "Credential in a Claude transcript" "$FOUND new finding(s). See $LOG." >/dev/null 2>&1
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -u critical "Credential in a Claude transcript" "$FOUND new finding(s). See $LOG." 2>/dev/null
  fi
  exit 1
fi

# "nothing new" and "nothing found" are deliberately different sentences. Collapsing them
# hides whether the baseline is doing any work, and a baseline nobody can see is one nobody
# trusts — which is how it ends up suppressing something that mattered.
if [ "$KNOWN" -gt 0 ]; then
  printf '\nno new findings — %d source(s) scanned in %s, %d already baselined.\n' \
    "$SCANNED" "$STORES" "$KNOWN"
  exit 0
fi

printf '\nclean — %d source(s) scanned in %s.\n' "$SCANNED" "$STORES"
exit 0

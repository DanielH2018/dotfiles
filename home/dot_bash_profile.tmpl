export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# FNM (Fast Node Manager) — node version manager, used on all machines
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd --shell bash)"
fi

# chezmoi creates dirs under the process umask, so pin 0022 in a subshell for
# deterministic dir modes on hosts with a 0007 login umask (see dot_zshrc.tmpl).
chezmoi() { ( umask 0022; command chezmoi "$@" ); }

# ~/.local/bin (tmux 3.7b, agentview, cts…) and go/bin must resolve for NON-interactive
# login shells too (`ssh host cmd`, bash -lc): .bashrc returns before its PATH setup
# when non-interactive. Idempotent, so no duplicate when common.sh also runs.
for _d in "$HOME/.local/bin" "$HOME/go/bin"; do
  [ -d "$_d" ] && case ":$PATH:" in *":$_d:"*) ;; *) PATH="$_d:$PATH" ;; esac
done
unset _d
export PATH

# Interactive setup (prompt, aliases, tool integrations) lives in ~/.bashrc; Git Bash
# login shells don't read it automatically, so source it here.
[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"

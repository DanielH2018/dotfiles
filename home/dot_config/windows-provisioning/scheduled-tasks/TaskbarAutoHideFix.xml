<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>daniel-desktop\daniel</Author>
    <Description>Persistent watcher: every ~2.5s, closes the "only one auto-hide toolbar per side" popup and re-asserts taskbar auto-hide. Works around the Win11/ExplorerPatcher multi-monitor auto-hide app-bar collision that recurs on logon, unlock, resume, and display/power transitions. Companion TaskbarAutoHideFix-Poll is a 3-min backup. Runs C:\Users\daniel\bin\TaskbarAutoHideFix.exe watch (source alongside).</Description>
    <URI>\TaskbarAutoHideFix</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-21-1385177617-3284078628-2827250211-1003</UserId>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <RestartOnFailure>
      <Count>3</Count>
      <Interval>PT1M</Interval>
    </RestartOnFailure>
    <StartWhenAvailable>true</StartWhenAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <LogonTrigger>
      <Delay>PT10S</Delay>
      <UserId>DANIEL-DESKTOP\daniel</UserId>
    </LogonTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Users\daniel\bin\TaskbarAutoHideFix.exe</Command>
      <Arguments>watch</Arguments>
    </Exec>
  </Actions>
</Task>

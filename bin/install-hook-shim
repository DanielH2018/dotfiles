#!/usr/bin/env bash
#
# install-hook-shim — (re)install the pre-push shim and point core.hooksPath at it.
#
# The shim scrubs git's hook environment before handing off to the branch's own
# gate. Git exports GIT_DIR and friends into every hook it runs and they survive
# into grandchildren: the gate runs `node --test`, several of those tests build
# throwaway repos in a temp directory, and with GIT_DIR inherited their `git init`
# is a no-op while their `git add` + `git commit` land on THIS repo's branch.
#
# The shim has to live in .git/ rather than be checked in, because core.hooksPath
# is shared by every worktree no matter which commit that worktree holds — a
# worktree sitting on a branch from before the fix would otherwise run the leaky
# gate. But nothing in git restores a .git/ file, so on its own that arrangement
# is one `git config core.hooksPath .githooks` away from silently coming undone.
# This installer is what makes it survive that, a fresh clone, or a manual delete.
#
#   install-hook-shim           repair if needed, report what changed
#   install-hook-shim --quiet   repair if needed, print only when it repairs
#   install-hook-shim --check   never write; exit 1 if a repair is needed
#
# Kept bash-3.2 clean, like the gate it installs.
set -u

mode=loud
case "${1:-}" in
  '')      ;;
  --quiet) mode=quiet ;;
  --check) mode=check ;;
  *) printf 'usage: install-hook-shim [--quiet|--check]\n' >&2; exit 2 ;;
esac

# Not a repo, or git is unavailable: nothing to install, and this runs from a
# SessionStart hook that must never fail a session.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -n "$ROOT" ] || exit 0

# --git-common-dir, not --git-dir: from a linked worktree the latter is that
# worktree's private dir, and the shim must be shared by all of them.
COMMON=$(cd "$ROOT" && git rev-parse --git-common-dir 2>/dev/null) || exit 0
case "$COMMON" in /*) ;; *) COMMON=$ROOT/$COMMON ;; esac
COMMON=$(cd "$COMMON" 2>/dev/null && pwd -P) || exit 0

HOOKS_DIR=$COMMON/hooks-safe
SHIM=$HOOKS_DIR/pre-push

WANT=$(cat <<'SHIM'
#!/usr/bin/env bash
#
# pre-push shim — scrub git's hook environment, then run the branch's own gate.
#
# GENERATED by bin/install-hook-shim; a SessionStart hook rewrites this whenever
# it drifts. Edit the installer, not this file.
#
# Git exports GIT_DIR, GIT_INDEX_FILE, GIT_PREFIX and friends into every hook it
# runs, and they survive into grandchild processes. The gate runs `node --test`,
# and several of those tests build throwaway repos in a temp directory: with
# GIT_DIR inherited their `git init` is a no-op and their `git add` + `git commit`
# land on THIS repo's branch instead of on their own fixture. That is what
# rewrote feat/wezterm-ssh-splits and feat/terminal-ui-testing to two-file
# commits authored by `t <t@t.co>`.
#
# .githooks/pre-push carries the same unset, but core.hooksPath is shared by
# every worktree while the fix lives only on branches that have it merged in — so
# a worktree sitting on an older branch would still run the leaky gate. This shim
# lives in .git/, which is never checked out, so it covers every worktree no
# matter which commit that worktree has checked out.
set -u

# Resolve the worktree before dropping the variables that identify it.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT=$PWD

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR \
      GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH \
      GIT_CONFIG_PARAMETERS GIT_REFLOG_ACTION

HOOK="$ROOT/.githooks/pre-push"
[ -x "$HOOK" ] || exit 0

# exec keeps stdin intact — pre-push reads its ref updates from there.
exec "$HOOK" "$@"
SHIM
)

drift=''
add_drift() { drift="${drift:+$drift, }$1"; }

if [ ! -f "$SHIM" ]; then
  add_drift "shim missing"
elif [ "$(cat "$SHIM")" != "$WANT" ]; then
  add_drift "shim body stale"
elif [ ! -x "$SHIM" ]; then
  add_drift "shim not executable"
fi

# --get, not --get-all: a repo with several would be broken in its own right, and
# git itself reads the last one.
have=$(cd "$ROOT" && git config --get core.hooksPath 2>/dev/null) || have=''
[ "$have" = "$HOOKS_DIR" ] || add_drift "core.hooksPath=${have:-unset}"

if [ -z "$drift" ]; then
  [ "$mode" = loud ] && printf 'pre-push shim already installed (%s)\n' "$SHIM"
  exit 0
fi

if [ "$mode" = check ]; then
  printf 'pre-push shim needs repair: %s\n' "$drift" >&2
  exit 1
fi

mkdir -p "$HOOKS_DIR" || exit 1

# Write a sibling and rename, rather than truncating $SHIM in place. Another
# worktree may be running this exact file as its pre-push hook right now, and
# bash reads a script incrementally as it executes — rewriting it underneath a
# live push feeds that shell a torn file. rename(2) swaps the directory entry
# instead, so a push already in flight keeps reading the inode it opened.
TMP=$SHIM.$$.tmp
printf '%s\n' "$WANT" >"$TMP" || { rm -f "$TMP"; exit 1; }
chmod +x "$TMP" || { rm -f "$TMP"; exit 1; }
mv -f "$TMP" "$SHIM" || { rm -f "$TMP"; exit 1; }

(cd "$ROOT" && git config core.hooksPath "$HOOKS_DIR") || exit 1

printf 'pre-push shim repaired: %s\n' "$drift"
exit 0

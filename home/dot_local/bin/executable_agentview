#!/usr/bin/env bash
# Agent View — grouped, switchable list of Claude Code sessions across machines and
# backends (host + claude-sandbox). Terminal-agnostic: focus is delegated to whichever
# backend a session captured at start (tmux / wezterm / none).
# Modes:
#   agentview             full-color fzf picker; on <enter> it jumps to the session.
#                         CTRL+SHIFT+S (WezTerm) / prefix+g (tmux) spawns this. Picker keys:
#                         ALT+1..9 jump to the Nth session · CTRL+R rename · CTRL+P pin to
#                         top · CTRL+N new session · CTRL+X remove · CTRL+F refresh ·
#                         CTRL+O session details · ? shortcut cheatsheet.
#   agentview --spawn     interactive: pick a repo + branch, launch claude-sandbox in a
#                         new pane of the active backend (tmux new-window / wezterm spawn),
#                         or in place when neither backend is usable (bare WSL shell).
#                         Picking the "no repo" entry launches a plain HOST claude at $HOME
#                         instead (no sandbox, no branch pick).
#   agentview --resolve KEY  print the CLIENT-side pane id to jump to (or nothing)
#   agentview --jump KEY  activate the session's pane (locator-direct, or legacy cwd). Where the
#                         picker owns its terminal (no $TMUX — i.e. the dedicated "Agent View"
#                         WezTerm tab) the session opens IN that tab; a Windows row whose pane
#                         is gone is reopened in a fresh Windows tab instead.
#   agentview --jump-nth N  jump to the Nth session in render order (ALT+N target)
#   agentview --card KEY  render the fzf preview card
#   agentview --keys      render the keyboard-shortcut cheatsheet (shown on `?`)
#   agentview --remove KEY  REALLY remove the session (CTRL+X, confirmed): stop its process
#                         (pid-reuse-guarded) + `claude rm` its record/worktree + drop the
#                         registry row. Remote rows act on their host over ssh, then filter
#                         the cache. So a live session can't reappear.
#   agentview --pin KEY   toggle this row's pin (CTRL+P); pins live in ~/.claude/agent-view-pins
#   agentview --rename KEY  send Claude's own /rename into the session's pane (CTRL+R); needs
#                         a tmux/wezterm pane + an idle session (remote tmux driven over ssh)
#   agentview --skip DIR KEY [HOPS]  emit the fzf actions that carry the cursor off a group
#                         header/spacer (armed on up/down — see the dispatch below)
#   agentview --body      emit just the grouped fzf list (used for the live reload)
#   agentview --refresh-remote PF  reconcile Windows rows against the daemon roster (reap the
#                         ones it no longer runs, synthesize the live ones no hook registered)
#                         + pull the homelab cache over ssh, then reload the live picker via the
#                         fzf --listen port stored in portfile PF (used by the startup background
#                         job and CTRL+F). Detached: this is where the slow off-render work goes.
# KEY fields are US-separated (0x1f): host|cwd|state|ts|title|pane|kind|locator.
# A session's `locator` (captured at start) is the concrete focus target, so a jump is
# one direct backend command with no discovery step. Rows lacking a locator (legacy /
# pre-rename) fall back to cwd-correlation against `wezterm cli --prefer-mux list`.
# kind is host|sandbox|bg. Local host rows are cross-checked against Claude's own
# per-process registry (~/.claude/sessions/<pid>.json): its live status overrides a
# stale hook state, hookless busy/waiting sessions are synthesized, and daemon
# background jobs get kind=bg with locator bg:<jobId> — no pane exists, so <enter>
# runs `claude attach <jobId>` in a new backend pane (roster fallback without one).
set -u
mode="${1:-fzf}"

# --skip DIR KEY [HOPS]: the picker's up/down keys arm this as an fzf `transform`. Group
# headers and the blank spacers between groups are list rows carrying an EMPTY key, so the
# cursor must never come to rest on one — when it lands there, keep going the same
# direction. Each hop re-arms the transform (a group boundary is two rows: spacer + header,
# and a header can sit at either end of the list), with HOPS as the backstop so a list of
# nothing but keyless rows — the "no active sessions" placeholder — can't spin forever.
# Dispatched above every other setup line: this runs on each arrow keypress.
if [ "$mode" = "--skip" ]; then
  [ -n "${3:-}" ] && exit 0                  # a real session row — stay on it
  hops="${4:-4}"; case "$hops" in ''|*[!0-9]*) hops=0;; esac
  [ "$hops" -gt 0 ] || exit 0
  dir="${2:-down}"
  printf "%s+transform('%s' --skip %s {1} %s)" \
    "$dir" "${AGENTVIEW_SELF:-$HOME/.local/bin/agentview}" "$dir" "$(( hops - 1 ))"
  exit 0
fi

statedir="$HOME/.claude/agent-view"
# Homelab snapshot cache: the picker renders from THIS file instantly (no network on
# open); a background job refreshes it over ssh and live-reloads fzf. Kept OUT of the
# state dir and without a .json suffix so the local glob never mistakes it for a local
# session file. Defined here (above do_remove) so Ctrl+X on a remote row can filter it.
remote_cache="$HOME/.agentview-remote-cache"
# Claude's own per-process registry (see the load_session_map block below for what the render
# does with it). Defined here — like remote_cache — because do_remove needs it: the render
# rewrites a daemon session's locator to bg:<jobId>, and only this registry maps that job back
# to the session id the on-disk row is keyed by.
sessionsdir="$HOME/.claude/sessions"
# Pin sidecar: newline-delimited row identities the user pinned with CTRL+P. Kept OUT of
# the per-session state files so it survives the hook's full-record rewrites AND can pin
# remote rows (which have no local file). The render reads it into a PINNED group up top.
pinfile="$HOME/.claude/agent-view-pins"
# The CTRL+N / CTRL+X choosers. Inside tmux each one runs in its own display-popup so it
# FLOATS over the session list: those binds use execute-silent, so fzf never repaints and the
# list stays painted underneath. The picker is ITSELF a display-popup (see .tmux.conf) and
# tmux nests them without complaint.
#
# We drive tmux directly rather than using fzf's own --popup. That flag looks equivalent and
# is not: when its popup closes it takes the PARENT picker down with it (the outer fzf exits
# 130), so CTRL+X read as "the picker just vanished". Driving tmux ourselves leaves the parent
# untouched. The cost is that the popup owns its own pty, so the pick comes back through a
# temp file instead of stdout.
#
# With no tmux there is no popup substrate at all, so fall back to a small inline box on the
# screen execute() already cleared. Defined here — like remote_cache — because the Ctrl+X
# confirm runs from the --remove dispatch, well above where the spawn pickers are defined.

# The terminal runs Catppuccin Mocha (chezmoi `.chezmoidata/terminal.toml`), so every box this
# script paints uses it too. ONE definition, because six choosers each carrying their own copy
# is how the spawn pickers ended up in raw terminal defaults while the picker beside them was
# fully themed. av_pick passes this FIRST and fzf merges successive --color flags key-by-key,
# so a caller appends only what it wants to differ (the Ctrl+X confirm reddens `pointer`).
# bg:-1/gutter:-1 keep the terminal's own background, which is what makes a popup read as
# floating rather than as a pasted-on panel.
AV_COLOR='bg+:#313244,bg:-1,fg:#cdd6f4,fg+:#ffffff,gutter:-1,hl:#f38ba8,hl+:#f38ba8'
AV_COLOR="$AV_COLOR,header:#9399b2,footer:#6c7086,info:#cba6f7,pointer:#b4befe,prompt:#cba6f7"
AV_COLOR="$AV_COLOR,border:#45475a,label:#bac2de,ghost:#585b70,preview-border:#45475a,preview-label:#bac2de"

av_pick() {  # $1=width $2=height, rest = fzf args; stdin = the list, stdout = the pick
  local w="$1" h="$2" lst sel cmd rc
  shift 2
  set -- --color="$AV_COLOR" "$@"
  [ -n "${TMUX:-}" ] || { fzf --height="~$h" --margin='0,20%' "$@"; return $?; }
  lst=$(mktemp "${TMPDIR:-/tmp}/av-list.XXXXXX") || return 1
  sel=$(mktemp "${TMPDIR:-/tmp}/av-pick.XXXXXX") || { rm -f "$lst"; return 1; }
  cat > "$lst"
  # %q every word: the popup body is re-parsed by tmux's shell, and headers carry spaces/·.
  cmd="$(printf '%q ' fzf "$@") < $(printf '%q' "$lst") > $(printf '%q' "$sel")"
  # -B: no tmux border. fzf draws its own (rounded, with a label), and stacking the two
  # produced a double frame with a dead ring between them.
  tmux display-popup -E -B -w "$w" -h "$h" "$cmd" >/dev/null 2>&1; rc=$?
  cat "$sel" 2>/dev/null
  rm -f "$lst" "$sel" 2>/dev/null
  return "$rc"
}
now=$(date +%s 2>/dev/null || echo 0)
selfhost=$(hostname 2>/dev/null)
US=$'\037'

# ── Source registry ───────────────────────────────────────────────────────────
# Every host that can contribute rows maps to a friendly label + a "locality".
# LOCAL hosts live on THIS physical machine (no ssh): the WSL side (self) and the
# Windows side seen over /mnt/c. REMOTE hosts (homelab) are reached by ssh. Adding a
# source later = one entry in these tables + a discover/focus branch. `winhost` is
# the Windows hostname its own hook records; `windir` is that side's registry over
# the WSL mount; `WEZTERM_WIN` is the Windows wezterm binary (WSL's PATH excludes it,
# appendWindowsPath=false) used to focus/rename/spawn Windows panes.
winhost="daniel-desktop"
declare -A HOST_LABEL=( ["$selfhost"]="WSL" ["$winhost"]="PC" [daniel-server]="Homelab" )
declare -A HOST_LOCAL=( ["$selfhost"]=1 ["$winhost"]=1 )
declare -A HOST_SSH=( [daniel-server]="daniel-server" )
windir="${AGENT_VIEW_WINDIR:-/mnt/c/Users/${USER}/.claude/agent-view}"
WEZTERM_WIN="${AGENT_VIEW_WEZTERM_WIN:-/mnt/c/Program Files/WezTerm/wezterm.exe}"
# Dir a picker-spawned Windows claude lands in. MUST be a folder whose Claude trust
# dialog is already accepted — Claude runs no hooks in an untrusted folder, so a session
# started somewhere untrusted (e.g. a fresh ~/dev) never fires agent-view-state.sh and
# never appears here. The Vault is trusted, so its sessions register. Kept `~`-relative so
# it expands on the Windows side (git_bash $HOME), not in WSL.
win_spawn_dir="${AGENT_VIEW_WIN_SPAWN_DIR:-~/My_Vault}"
# Windows git bash, as a NATIVE Windows path — passed to wezterm.exe (a Windows process) as
# the spawn program. A bare `bash` there resolves into WSL, so name the exe explicitly.
WIN_GITBASH="${AGENT_VIEW_WIN_GITBASH:-C:\\Program Files\\Git\\bin\\bash.exe}"
# Windows claude, as a WSL path — we run it from HERE (not through git bash) purely to ask
# `agents --json` which sessions the Windows daemon still holds. See win_agent_live.
WIN_CLAUDE="${AGENT_VIEW_WIN_CLAUDE:-/mnt/c/Users/${USER}/.local/bin/claude.exe}"

host_label()      { _hl="${HOST_LABEL[$1]:-}"; [ -z "$_hl" ] && _hl="${1#daniel-}"; }
is_local_host()   { [ -n "${HOST_LOCAL[$1]:-}" ]; }
# The Windows side is a distinct source only when agentview runs elsewhere (WSL). If
# agentview IS running on the Windows host (selfhost == winhost), there's no cross-boundary
# source — self rows use the normal local path — so this stays false.
is_windows_host() { [ "$winhost" != "$selfhost" ] && [ "$1" = "$winhost" ]; }

# Every `wezterm cli` call that has to reach the GUI goes through here. Two things it settles:
#   * WHICH BINARY. From WSL the Linux /usr/bin/wezterm cannot reach the Windows GUI at all —
#     different OS, different socket — so it must be $WEZTERM_WIN, the same reason
#     av_activate_windows uses it. Routing this on is_windows_host would be wrong: that asks
#     where the SESSION runs, but the question here is which cli can reach the GUI, and from WSL
#     that is always wezterm.exe no matter which OS the pane's shell lives in. Pane ids are
#     GUI-global, so the Windows binary can address a WSL pane perfectly well.
#   * --no-auto-start. Without it, a cli that finds no server does not fail — it quietly STARTS
#     one (wezterm-mux-server), which comes up owning a default pane numbered from 0 and then
#     answers every query with that phantom instead of the real GUI. That is both a stray daemon
#     and an id space that collides with the real $WEZTERM_PANE ids wezterm-pane-ssh resolves.
# Sets _wezbin to that binary, so the detached re-activate below — which runs in a FRESH bash
# that has never seen these functions — can name it directly instead of calling back in.
av_wezterm_bin() {
  if [ -n "${WSL_DISTRO_NAME:-}" ]; then
    [ -x "$WEZTERM_WIN" ] || return 1
    _wezbin="$WEZTERM_WIN"
  else
    _wezbin=$(command -v wezterm 2>/dev/null) || return 1
    [ -n "$_wezbin" ] || return 1
  fi
}
av_wezterm() { av_wezterm_bin || return 1; "$_wezbin" cli --no-auto-start "$@"; }

compute_pin_id() {  # sets _pid = stable pin identity for $1=host $2=cwd $3=kind $4=locator.
  # A real (non-"none") locator uniquely names the pane; else fall back to host+cwd+kind
  # (US-joined). No subshell — this runs per row in the hot render path.
  if [ -n "$4" ] && [ "${4%%:*}" != "none" ]; then _pid="$4"
  else _pid="$1$US$2$US$3"; fi
}

# Shared jq fragments (were copy-pasted three times). `norm` makes Windows and Unix
# cwds comparable; JQ_NONSHELL keeps only panes whose title isn't a bare shell/mux
# name (i.e. the pane Claude retitled with its task). MSYS_NO_PATHCONV guards the
# `--arg cwd` from Git-Bash rewriting a leading-slash POSIX cwd on Windows.
# `wezterm cli list` reports cwd as a file:// URL carrying the HOST as the authority
# ("file://daniel-desktop/c/Users/daniel"), so norm drops the whole authority — not just
# the scheme — and folds that mount-style "/c/" drive back to "c:/", or a Windows pane's
# cwd never compares equal to the "C:\..." cwd its row records. Runs of separators collapse
# because a row KEY reaches us through @tsv, which escapes every backslash as two: the rendered
# key reads "C:\\Users\\daniel", which would otherwise norm to "c://users//daniel" and match
# nothing.
JQ_NORM='def norm: sub("^file://[^/]*";"") | gsub("\\\\";"/") | gsub("//+";"/") | sub("^/(?<d>[A-Za-z]:)"; .d) | sub("^/(?<d>[A-Za-z])/"; .d + ":/") | sub("/$";"") | ascii_downcase;'
JQ_NONSHELL='(.title|ascii_downcase|test("^(-?(zsh|bash|fish|sh|pwsh|powershell|login)(\\.exe)?|wezterm\\.exe|cmd\\.exe|ubuntu)$"))|not'

# ---- library modules ----
# Every fzf bind re-execs this script, and --card runs on EVERY preview row change,
# so loading is lazy: each mode sources only the modules it can actually reach.
# --card/--keys stay dependency-free, keeping the preview off any file-read path.
# AGENTVIEW_LIB overrides the location (tests, and the pre-push gate, run an
# unpushed copy) — the same seam AGENTVIEW_SELF already provides for the script.
_av_self=$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null) || _av_self="${BASH_SOURCE[0]}"
AV_LIB="${AGENTVIEW_LIB:-${_av_self%/*}/../share/agentview}"
case "$mode" in
  --card|--keys)           _avmods="" ;;
  --spawn)                 _avmods="spawn" ;;
  --resolve|--jump)        _avmods="common focus" ;;
  --remove|--pin|--rename) _avmods="common focus actions" ;;
  --refresh-remote|--body) _avmods="common rows" ;;
  *)                       _avmods="common focus rows" ;;
esac
# Sourced at TOP LEVEL, never from inside a helper function: the modules carry
# `declare -A` globals (SMAP, GN), and declare inside a function makes them local,
# so they would vanish the moment the loader returned.
for _m in $_avmods; do
  # shellcheck disable=SC1090
  . "$AV_LIB/$_m.sh" || { printf 'agentview: cannot load %s/%s.sh\n' "$AV_LIB" "$_m" >&2; exit 1; }
done

if [ "$mode" = "--resolve" ]; then resolve_key "${2:-}"; exit 0; fi
if [ "$mode" = "--jump" ]; then jump_or_report "${2:-}"; exit $?; fi
if [ "$mode" = "--remove" ]; then do_remove "${2:-}"; exit 0; fi
if [ "$mode" = "--pin" ]; then do_pin "${2:-}"; exit 0; fi
if [ "$mode" = "--rename" ]; then do_rename "${2:-}"; exit 0; fi

if [ "$mode" = "--card" ]; then
  # Render the fzf preview card from the row KEY (US-delimited host|cwd|state|ts|title|
  # pane|kind|locator) — fzf passes it as {1}, single-quoted/escaped, so it's safe as
  # one argument. Self-contained (own colors, inline age) so it runs BEFORE any
  # state-load/SSH — fzf calls this on every keystroke, so it must be instant.
  [ -z "${2:-}" ] && exit 0
  IFS=$'\037' read -r k_host k_cwd k_state k_ts k_title k_pane k_kind k_loc <<< "${2:-}"
  e=$'\033'; z="$e[0m"
  dim="$e[38;2;127;132;156m"; lab="$e[38;2;147;153;178m"; val="$e[38;2;205;214;244m"
  case "$k_state" in
    needs-input) sc="$e[38;2;249;226;175m"; sn="needs input";;
    working)     sc="$e[38;2;166;227;161m"; sn="working";;
    review)      sc="$e[38;2;250;179;135m"; sn="review";;
    completed)   sc="$e[38;2;108;112;134m"; sn="completed";;
    *)           sc="$e[38;2;108;112;134m"; sn="idle";;
  esac
  case "$k_kind" in sandbox) klabel="sandbox";; bg) klabel="background";; *) klabel="claude";; esac
  host_label "$k_host"
  if [ -n "${HOST_LABEL[$k_host]:-}" ]; then mn="$_hl · $k_host"; else mn="$k_host"; fi
  age=""
  case "$k_ts" in ''|*[!0-9]*) :;; *)
    if [ "$k_ts" -gt 0 ]; then d=$(( now - k_ts )); [ "$d" -lt 0 ] && d=0
      if   [ "$d" -lt 60 ];    then age="${d}s ago"
      elif [ "$d" -lt 3600 ];  then age="$((d/60))m ago"
      elif [ "$d" -lt 86400 ]; then age="$((d/3600))h ago"
      else age="$((d/86400))d ago"; fi
    fi;;
  esac
  name=$(basename "${k_cwd//\\//}" 2>/dev/null)
  printf '\n  %s✳%s  %s%s · %s%s%s\n\n' "$sc" "$z" "$dim" "$klabel" "$val" "$name" "$z"
  printf '  %s%-9s%s%s%s ●%s\n' "$lab" "State" "$sc" "$sn" "$sc" "$z"
  case "$k_kind" in sandbox|bg) printf '  %s%-9s%s%s%s\n' "$lab" "Kind" "$val" "$klabel" "$z";; esac
  printf '  %s%-9s%s%s%s\n'     "$lab" "Machine" "$val" "$mn" "$z"
  printf '  %s%-9s%s%s%s\n'     "$lab" "Folder" "$val" "$name" "$z"
  printf '  %s%-9s%s%s%s\n'     "$lab" "Path" "$dim" "$k_cwd" "$z"
  [ -n "$k_title" ] && printf '  %s%-9s%s%s%s\n' "$lab" "Task" "$val" "$k_title" "$z"
  [ -n "$age" ]     && printf '  %s%-9s%s%s%s\n' "$lab" "Updated" "$dim" "$age" "$z"
  exit 0
fi

if [ "$mode" = "--keys" ]; then
  # The shortcut cheatsheet shown in the preview pane when the user presses `?`. Self-
  # contained (own colors, no state load) so it renders instantly like --card.
  e=$'\033'; z="$e[0m"
  ttl="$e[1m$e[38;2;180;190;254m"; sec="$e[38;2;203;166;247m"; k="$e[38;2;166;227;161m"; dsc="$e[38;2;205;214;244m"
  printf '\n  %s✳ agent view · shortcuts%s\n' "$ttl" "$z"
  printf '\n  %sNavigate%s\n' "$sec" "$z"
  printf '    %s↑ ↓%s      %smove%s\n'                 "$k" "$z" "$dsc" "$z"
  printf '    %s⌥1 … ⌥9%s  %sjump to that session%s\n' "$k" "$z" "$dsc" "$z"
  printf '    %s↵%s        %sswitch to selected%s\n'   "$k" "$z" "$dsc" "$z"
  printf '\n  %sManage%s\n' "$sec" "$z"
  printf '    %s⌃r%s       %srename label%s\n'         "$k" "$z" "$dsc" "$z"
  printf '    %s⌃p%s       %spin / unpin to top%s\n'   "$k" "$z" "$dsc" "$z"
  printf '    %s⌃x%s       %sremove from list%s\n'     "$k" "$z" "$dsc" "$z"
  printf '    %s⌃n%s       %snew session (sandbox or host)%s\n'  "$k" "$z" "$dsc" "$z"
  printf '\n  %sView%s\n' "$sec" "$z"
  printf '    %s⌃o%s       %ssession details%s\n'      "$k" "$z" "$dsc" "$z"
  printf '    %s⌃f%s       %srefresh now%s\n'          "$k" "$z" "$dsc" "$z"
  printf '    %s?%s        %sthis help%s\n'            "$k" "$z" "$dsc" "$z"
  printf '    %sesc%s      %sclose%s\n'                "$k" "$z" "$dsc" "$z"
  exit 0
fi

# Required tools: jq + fzf always. wezterm is OPTIONAL — only the wezterm backend and
# the legacy cwd-correlation need it; under tmux (Ghostty/Linux) it's absent and rows
# focus via their tmux locator instead. Fail loudly on a truly missing core tool.
for t in jq fzf; do
  command -v "$t" >/dev/null 2>&1 || { printf 'agentview: %s not found on PATH\n' "$t" >&2; exit 1; }
done
HAVE_WEZTERM=0; command -v wezterm >/dev/null 2>&1 && HAVE_WEZTERM=1

if [ "$mode" = "--spawn" ]; then do_spawn "${2:-}"; exit $?; fi

# Opt-in phase profiling: `AGENTVIEW_PROFILE=1 agentview` appends per-phase timestamps
# to ~/.agentview-profile.log so a slow open can be traced to the responsible phase.
prof() { [ -n "${AGENTVIEW_PROFILE:-}" ] && printf '%s\t%s\n' "${EPOCHREALTIME:-0}" "$1" >> "$HOME/.agentview-profile.log"; return 0; }

# ---- palette (Catppuccin Mocha, truecolor) ----
E=$'\033'; Z="$E[0m"
C_NEED="$E[38;2;249;226;175m"          # yellow  — needs input
C_WORK="$E[38;2;166;227;161m"          # green   — working
C_REVIEW="$E[38;2;250;179;135m"        # peach   — review (stopped, but dirty/unpushed)
C_DONE="$E[38;2;108;112;134m"          # overlay0 — completed / idle
C_DIM="$E[38;2;127;132;156m"           # overlay1 — "claude ·"
C_BOLD="$E[1m"                         # bold prefix — group headers + names render bold+state
C_PIN="$E[38;2;203;166;247m"           # mauve — PINNED group accent (★)
GBAR=$'▎'                         # ▎ left accent rule — state-colored, runs down each group
BADGEBG="$E[48;2;69;71;90m"            # surface1 — machine chip background
BADGEFG="$E[38;2;69;71;90m"            # surface1 as FG — colors the pill's rounded end-caps
PILL_L=$''; PILL_R=$''     # powerline half-circles — round the source badge into a box
# Single-source the state→accent map and the empty-state row so the two render paths
# (render_body + interactive picker) can't drift — they had: one used an extra leading
# tab, mis-offsetting the "no sessions" row against fzf's --with-nth=2.. delimiter.
state_color() {  # set $_scol to a state group's accent (a function call, no per-row fork)
  case "$1" in needs-input) _scol="$C_NEED";; working) _scol="$C_WORK";; review) _scol="$C_REVIEW";; *) _scol="$C_DONE";; esac
}
row_pinned() {  # sets $_pinned=1/0 for $1=host $2=cwd $3=kind $4=locator (reads PINNED_SET
  # via dynamic scope from build_pretty). No fork — runs per row on the render path.
  local _pid
  compute_pin_id "$1" "$2" "$3" "$4"
  [ -n "${PINNED_SET[$_pid]:-}" ] && _pinned=1 || _pinned=0
}
NO_SESSIONS_ROW=$'\t   '"${C_DONE}   no active Claude sessions — nothing running${Z}"
LABEL=$' ✳ claude sessions '      # ✳ Claude mark in the border title
PROMPT=$'  '                     # Nerd Font magnifier + gap (IosevkaTerm NFM)
declare -A GN=( [pinned]="PINNED" [needs-input]="NEEDS INPUT" [working]="WORKING" [review]="REVIEW" [completed]="COMPLETED" [idle]="IDLE" )

row_width() {  # sets _rw: usable row columns for the render + header alignment.
  # Inside a reload/execute child fzf exports FZF_COLUMNS (its own area, margin/padding
  # already excluded) — keep 2 for the pointer gutter. At the initial render (no fzf yet)
  # start from the terminal and discount fzf's chrome (2×2% margin + padding + border).
  # Floor of 40 keeps the pad/truncate math sane on tiny panes. Was a hardcoded 72, which
  # overran narrow panes (clipped names) and wasted wide ones.
  if [ -n "${FZF_COLUMNS:-}" ]; then _rw=$(( FZF_COLUMNS - 2 ))
  else
    _rw="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
    _rw=$(( _rw - _rw * 4 / 100 - 6 ))
  fi
  [ "$_rw" -lt 40 ] && _rw=40
}

fmt_age() {  # $1 = epoch -> sets _age: compact "12m"/"3h"/"2d"; empty for unknown/zero ts
  local t=${1:-0} d; _age=""
  case "$t" in ''|*[!0-9]*) return;; esac
  [ "$t" -le 0 ] && return
  d=$(( now - t )); [ "$d" -lt 0 ] && d=0
  if   [ "$d" -lt 60 ];    then _age="${d}s"
  elif [ "$d" -lt 3600 ];  then _age="$((d/60))m"
  elif [ "$d" -lt 86400 ]; then _age="$((d/3600))h"
  else _age="$((d/86400))d"; fi
}

badge_name() {  # $1 = host -> sets _bn: friendly machine tag (from HOST_LABEL)
  host_label "$1"; _bn="$_hl"
}

gc_pins() {  # drop pins whose session no longer exists anywhere (a local file OR the remote
  # cache) — orphans left when a session ends, is pruned (7-day / dead-pid), or is CTRL+X'd,
  # plus the "a new session in the same cwd inherits a stale locator-less pin" mispin. Runs each
  # render AFTER the prune, reconciling the sidecar against current state. No-op (one stat) when
  # nothing is pinned. jq over valid session JSON doesn't error, so a wrongly-emptied set is only
  # reachable when there genuinely are no sessions — in which case every pin IS an orphan.
  [ -s "$pinfile" ] || return
  local live tmp="$pinfile.tmp.$$" lf
  shopt -s nullglob; lf=( "$statedir"/*.json ); shopt -u nullglob
  live=""
  [ "${#lf[@]}" -gt 0 ] && live=$(jq -r "$JQ_PINID" "${lf[@]}" 2>/dev/null)
  [ -s "$remote_cache" ] && live="$live"$'\n'"$(MSYS_NO_PATHCONV=1 jq -r "$JQ_PINID" < "$remote_cache" 2>/dev/null)"
  if [ -n "$live" ]; then printf '%s\n' "$live" | grep -Fxf - "$pinfile" > "$tmp" 2>/dev/null
  else : > "$tmp"; fi
  mv -f "$tmp" "$pinfile" 2>/dev/null || rm -f "$tmp" 2>/dev/null
}

loc_rank() {  # sets _lr = jump quality of locator $1: real pane 2 > bg attach 1 > none 0
  case "$1" in
    tmux:?*|wezterm:?*) _lr=2 ;;
    bg:?*)              _lr=1 ;;
    *)                  _lr=0 ;;   # none: / empty / bg: with no job
  esac
}

collapse_bg_forks() {  # merge a bg daemon row with its interactive origin into one row.
  # Backgrounding a session spawns a bg job that inherits the task title but gets a fresh
  # session id with NO lineage link (session files carry no parent field), so the origin and
  # the fork render as two same-named rows. Correlate on host+cwd+title, using REAL titles
  # only — an auto name ("<leaf>-<2 hex>") is not a shared task identity, so those never
  # merge. Collapse only a group holding BOTH a bg and a non-bg member (two plain interactive
  # sessions that merely share a title stay separate); keep the base = freshest member but
  # adopt the best jump target across the pair (a live pane beats bg-attach beats none:) and
  # set kind to route <enter> accordingly. Rewrites global `rows`. Row = state<TAB>host<TAB>
  # cwd<TAB>pane<TAB>ts<TAB>kind<TAB>locator<TAB>title.
  local -A GROUP=()
  local pass="" L rest cwd title fwd leaf host
  while IFS= read -r L; do
    [ -z "$L" ] && continue
    rest="${L#*$'\t'}"                       # drop state
    host="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
    cwd="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
    rest="${rest#*$'\t'}"; rest="${rest#*$'\t'}"; rest="${rest#*$'\t'}"; rest="${rest#*$'\t'}"  # pane ts kind locator
    title="$rest"
    fwd="${cwd//\\//}"; fwd="${fwd%/}"; leaf="${fwd##*/}"
    # Not mergeable (no shared task identity): empty title, or Claude's auto "<leaf>-<2 hex>".
    if [ -z "$title" ] || [[ "$title" == "$leaf"-[0-9a-f][0-9a-f] ]]; then
      pass+="$L"$'\n'; continue
    fi
    GROUP["$host$US$cwd$US$title"]+="$L"$'\n'
  done <<< "$rows"
  local k members m mrest nbg nother base base_ts bestloc bestrank _lr
  local b_st b_host b_cwd b_pane b_ts b_kind b_loc b_title m_ts m_kind m_loc
  for k in "${!GROUP[@]}"; do
    members="${GROUP[$k]}"
    nbg=0; nother=0; base=""; base_ts=-1; bestloc=""; bestrank=-1
    while IFS= read -r m; do
      [ -z "$m" ] && continue
      mrest="${m#*$'\t'}"; mrest="${mrest#*$'\t'}"; mrest="${mrest#*$'\t'}"  # -> after host,cwd
      mrest="${mrest#*$'\t'}"                                                # -> after pane
      m_ts="${mrest%%$'\t'*}"; mrest="${mrest#*$'\t'}"
      m_kind="${mrest%%$'\t'*}"; mrest="${mrest#*$'\t'}"
      m_loc="${mrest%%$'\t'*}"
      [ "$m_kind" = "bg" ] && nbg=$((nbg+1)) || nother=$((nother+1))
      case "$m_ts" in ''|*[!0-9]*) m_ts=0;; esac
      [ "$m_ts" -gt "$base_ts" ] && { base_ts="$m_ts"; base="$m"; }
      loc_rank "$m_loc"; [ "$_lr" -gt "$bestrank" ] && { bestrank="$_lr"; bestloc="$m_loc"; }
    done <<< "$members"
    if [ "$nbg" -gt 0 ] && [ "$nother" -gt 0 ]; then
      b_st="${base%%$'\t'*}"; mrest="${base#*$'\t'}"
      b_host="${mrest%%$'\t'*}"; mrest="${mrest#*$'\t'}"
      b_cwd="${mrest%%$'\t'*}"; mrest="${mrest#*$'\t'}"
      b_pane="${mrest%%$'\t'*}"; mrest="${mrest#*$'\t'}"
      b_ts="${mrest%%$'\t'*}"; mrest="${mrest#*$'\t'}"
      b_kind="${mrest%%$'\t'*}"; mrest="${mrest#*$'\t'}"
      b_loc="${mrest%%$'\t'*}"; b_title="${mrest#*$'\t'}"
      case "$bestloc" in bg:*) b_kind="bg";; tmux:*|wezterm:*) b_kind="host";; esac
      pass+="$b_st"$'\t'"$b_host"$'\t'"$b_cwd"$'\t'"$b_pane"$'\t'"$b_ts"$'\t'"$b_kind"$'\t'"$bestloc"$'\t'"$b_title"$'\n'
    else
      pass+="$members"
    fi
  done
  rows="$pass"
}

build_pretty() {  # prints "KEY<TAB>COLORED-DISPLAY" per row, grouped; KEY carries the card fields
  local W BADGEW=7 grp st host cwd pane ts kind locator title_reg gitmark name title bn scol stext cnt key L _rest
  local bcell left_p left_c pad sp maxs bpad bfg first=1 fwd clabel
  local PINCNT=0 idx=0 g1 gutc _pinned _hp _leaf _par
  row_width; W=$_rw
  # Pinned rows collect into a PINNED group at the very top. Load the sidecar once into a
  # set, then in the tally below count pinned rows separately so a state group's header
  # count reflects only what still renders under it.
  local -A PINNED_SET=()
  gc_pins                                     # reconcile the sidecar against live sessions first
  if [ -f "$pinfile" ]; then
    while IFS= read -r _hp; do [ -n "$_hp" ] && PINNED_SET["$_hp"]=1; done < "$pinfile"
  fi
  # Sort every row by ts (desc) ONCE and tally per-state counts in pure bash, so the
  # group loop needs no per-group awk/sort — each of those was a process spawn, and
  # spawns dominate render time on Windows.
  local -a sorted; local -A GCNT=() NAMECNT=()
  mapfile -t sorted < <(printf '%s' "$rows" | sort -t$'\t' -k5,5nr)
  for L in "${sorted[@]}"; do
    st="${L%%$'\t'*}"; [ -z "$st" ] && continue
    _rest="${L#*$'\t'}"; host="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
    cwd="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
    _rest="${_rest#*$'\t'}"                       # skip pane
    _rest="${_rest#*$'\t'}"                       # skip ts
    kind="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
    locator="${_rest%%$'\t'*}"
    # Tally leaf names so the render can tell twins apart (same-named checkout on
    # another host / a worktree elsewhere) by prefixing the parent dir.
    fwd="${cwd//\\//}"; fwd="${fwd%/}"; _leaf="${fwd##*/}"; [ -z "$_leaf" ] && _leaf="$cwd"
    [ -n "$_leaf" ] && NAMECNT[$_leaf]=$(( ${NAMECNT[$_leaf]:-0} + 1 ))
    row_pinned "$host" "$cwd" "$kind" "$locator"
    if [ "$_pinned" = 1 ]; then PINCNT=$(( PINCNT + 1 )); else GCNT[$st]=$(( ${GCNT[$st]:-0} + 1 )); fi
  done
  for grp in pinned needs-input working review completed idle; do
    if [ "$grp" = pinned ]; then cnt=$PINCNT; else cnt=${GCNT[$grp]:-0}; fi
    [ "$cnt" -eq 0 ] && continue
    [ "$first" -eq 0 ] && printf '\t\n'   # blank spacer between groups (empty KEY = no-op on select)
    first=0
    if [ "$grp" = pinned ]; then
      printf '\t%s%s%s %s★%s %s%s%s%s %s%s%s\n' "$C_PIN" "$GBAR" "$Z" "$C_PIN" "$Z" "$C_BOLD" "$C_PIN" "${GN[$grp]}" "$Z" "$C_DIM" "$cnt" "$Z"
    else
      state_color "$grp"; scol="$_scol"
      printf '\t%s%s%s %s●%s %s%s%s%s %s%s%s\n' "$scol" "$GBAR" "$Z" "$scol" "$Z" "$C_BOLD" "$scol" "${GN[$grp]}" "$Z" "$C_DIM" "$cnt" "$Z"
    fi
    for L in "${sorted[@]}"; do
      # Split on tab WITHOUT read's IFS-whitespace collapsing: sandbox rows have an
      # empty pane, and `IFS=$'\t' read` folds that empty field, shifting locator/title
      # out of place so do_jump reads the wrong KEY field. Parameter expansion keeps
      # empties. (@tsv already escaped any literal tabs in the values.)
      st="${L%%$'\t'*}"; _rest="${L#*$'\t'}"
      host="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
      cwd="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
      pane="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
      ts="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
      kind="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
      locator="${_rest%%$'\t'*}"; _rest="${_rest#*$'\t'}"
      # Split title from the trailing git marker WITHOUT collapsing empties. A pre-git
      # 8-field row (no trailing tab) leaves _rest == title_reg -> no marker.
      title_reg="${_rest%%$'\t'*}"
      if [ "$_rest" = "$title_reg" ]; then gitmark=""; else gitmark="${_rest#*$'\t'}"; fi
      # Membership: the PINNED group takes every pinned row (in ts order); each state
      # group takes its own state MINUS anything already shown as pinned.
      row_pinned "$host" "$cwd" "$kind" "$locator"
      if [ "$grp" = pinned ]; then
        [ "$_pinned" = 1 ] || continue
      else
        { [ "$st" = "$grp" ] && [ "$_pinned" = 0 ]; } || continue
      fi
      fwd="${cwd//\\//}"; fwd="${fwd%/}"; name="${fwd##*/}"; [ -z "$name" ] && name="$cwd"
      # Two rows sharing a leaf name render identically — prefix the parent dir so
      # they stay tellable apart (full path remains in the CTRL+O card).
      if [ -n "$name" ] && [ "${NAMECNT[$name]:-0}" -gt 1 ]; then
        _par="${fwd%/*}"; _par="${_par##*/}"
        [ -n "$_par" ] && [ "$_par" != "$name" ] && name="$_par/$name"
      fi
      # Prefer a registry-supplied title (sandbox rows carry repo·branch); else the
      # mux-correlated pane title (host rows on wezterm). Tabs would split the columns.
      if [ -n "$title_reg" ]; then title="$title_reg"; else title_for_cwd "$cwd"; title="$_title"; fi
      title="${title//$'\t'/ }"
      [ "$kind" = "sandbox" ] && clabel="sandbox" || clabel="claude"
      badge_name "$host"; bn="$_bn"
      case "$bn" in
        PC)      bfg="$E[38;2;137;180;250m";;   # blue  — desktop
        Homelab) bfg="$E[38;2;203;166;247m";;   # mauve — server
        *)       bfg="$E[38;2;205;214;244m";;   # text  — cloud
      esac
      # badge cell = the rounded pill (caps hugging <name>, no inner padding) + trailing pad,
      # so the "claude ·" column lines up whatever the machine name's length.
      bpad=$(( BADGEW - ${#bn} )); [ "$bpad" -lt 0 ] && bpad=0
      printf -v bcell '%*s' "$((BADGEW + 2))" ''
      state_color "$st"; scol="$_scol"     # colour the bar/name by the row's real state, even under PINNED
      # Number gutter sits just after the accent bar — where the header's ● bullet is — so
      # the ▎ rule stays column-aligned down the group while ALT+1..9 jumps to the Nth row.
      # --jump-nth counts the same non-empty-KEY rows in this order.
      idx=$(( idx + 1 ))
      if [ "$idx" -le 9 ]; then g1="$idx"; gutc="${C_DIM}${idx}${Z}"; else g1=" "; gutc=" "; fi
      left_p="  ${g1} ${bcell}  ${clabel} · ${name}"
      # Machine source as a rounded pill: fill-colored caps hug the machine-colored name with
      # no inner padding (tight); trailing bpad right-pads to the shared column.
      printf -v left_c '%s%s%s %s %s%s%s%s%s%s%s%s%s%*s  %s%s · %s%s%s%s%s' \
        "$scol" "$GBAR" "$Z" "$gutc" "$BADGEFG" "$PILL_L" "$BADGEBG" "$bfg" "$bn" "$Z" "$BADGEFG" "$PILL_R" "$Z" "$bpad" '' \
        "$C_DIM" "$clabel" "$Z" "$C_BOLD" "$scol" "$name" "$Z"
      case "$st" in
        # Right column = the session's task title (its "name"). When none was captured, fall
        # back to the age — never the state word, which just echoes the group header.
        needs-input|working) if [ -n "$title" ]; then stext="$title"; else fmt_age "$ts"; stext="$_age"; fi;;
        review)      fmt_age "$ts"; stext="${gitmark:-⚠ review}"; [ -n "$_age" ] && stext="$stext $_age";;
        completed)   fmt_age "$ts"; [ -n "$_age" ] && stext="✓ idle $_age" || stext="✓ completed";;
        *)           fmt_age "$ts"; [ -n "$_age" ] && stext="· idle $_age" || stext="· idle";;
      esac
      maxs=$(( W - ${#left_p} - 2 )); [ "$maxs" -lt 8 ] && maxs=8
      # Idle/completed rows keep their title too: the idle marker appends only while
      # both fit — when width runs out the name wins and the marker drops.
      case "$st" in needs-input|working) ;; *)
        if [ -n "$title" ]; then
          [ $(( ${#title} + 2 + ${#stext} )) -le "$maxs" ] && stext="$title  $stext" || stext="$title"
        fi;;
      esac
      [ "${#stext}" -gt "$maxs" ] && stext="${stext:0:maxs-1}…"
      pad=$(( W - ${#left_p} - ${#stext} )); [ "$pad" -lt 1 ] && pad=1
      printf -v sp '%*s' "$pad" ''
      # KEY *is* the card blob (host|cwd|state|ts|title|pane|kind|locator, US-delimited):
      # the jump path reads field 2 (cwd, legacy) + field 8 (locator, direct) and the
      # preview reads the whole thing via {1} — so no per-row fork is needed.
      printf -v key '%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s' \
        "$host" "$US" "$cwd" "$US" "$st" "$US" "$ts" "$US" "$title" "$US" "${pane:-none}" "$US" "$kind" "$US" "$locator"
      printf '%s\t%s%s%s%s%s\n' "$key" "$left_c" "$sp" "$scol" "$stext" "$Z"
    done
  done
}

render_body() {  # sets global `body` from local + cached-remote rows (the fzf list)
  rows=""
  gather_local_rows
  gather_windows_rows                        # same-machine Windows sessions, via /mnt/c
  gather_remote_rows
  collapse_bg_forks                          # one row per task: fold a bg fork into its origin
  if [ "$HAVE_WEZTERM" = 1 ]; then
    PANELIST=$(wezterm cli --no-auto-start --prefer-mux list --format json 2>/dev/null)
    load_titles
  fi
  body=$(build_pretty)
  [ -z "$body" ] && body="$NO_SESSIONS_ROW"
}

# --body: emit JUST the fzf list — used for the initial render AND the live reload the
# background ssh pushes in. No pane stamp / no profiling: it runs as fzf's own child.
if [ "$mode" = "--body" ]; then render_body; printf '%s\n' "$body"; exit 0; fi

# --refresh-remote PORTFILE: pull the homelab snapshot over ssh, then POST a reload into
# the live fzf (PORTFILE holds its --listen port, written by the start bind). Runs
# detached — once at picker startup and again on every CTRL+F — so remote rows refresh
# without ever blocking the UI. Missing curl/port degrades to just updating the cache.
if [ "$mode" = "--refresh-remote" ]; then
  reap_windows_rows   # drop Windows rows the daemon no longer runs, then add the live sessions
  sync_windows_rows   # no hook ever registered, so the POST below reloads a list that is both
  refresh_remote      # free of phantoms and complete (see reap_windows_rows for why it is here)
  _pf="${2:-}"
  if [ -n "$_pf" ] && command -v curl >/dev/null 2>&1; then
    for _ in $(seq 1 40); do [ -s "$_pf" ] && break; sleep 0.05; done   # await fzf's port (start-bind)
    p=$(cat "$_pf" 2>/dev/null)
    self="${AGENTVIEW_SELF:-$HOME/.local/bin/agentview}"
    [ -n "$p" ] && curl -s -XPOST "127.0.0.1:$p" \
        --data "reload('$self' --body)+refresh-preview" >/dev/null 2>&1
  fi
  exit 0
fi

# --jump-nth N: focus the Nth session in the rendered order (pinned first, then by state,
# ts desc) — the target of ALT+1..9. fzf fires this via `become`, so we inherit its pipes;
# reconnect the real terminal (guarded — absent under the tests) so a tmux/ssh attach gets
# a tty. Counts the same non-empty-KEY rows the number gutter labels, so ALT+K == gutter K.
if [ "$mode" = "--jump-nth" ]; then
  if { : < /dev/tty; } 2>/dev/null; then exec < /dev/tty > /dev/tty 2>/dev/tty; fi
  render_body
  key=$(printf '%s\n' "$body" | awk -F'\t' -v n="${2:-0}" '$1=="" {next} { c++; if (c==n) { print $1; exit } }')
  [ -n "$key" ] && jump_or_report "$key"
  exit $?
fi

# ---- interactive picker ----
prof start
# (No pane stamp: WezTerm's CTRL+W dismisses the picker by detecting fzf as the live
# foreground process, not a user var. The old OSC 1337 SetUserVar was sticky — it
# survived fzf's exit and left CTRL+W a no-op in any pane that had ever run the picker.)

rows=""
gather_local_rows;  prof gather_local
gather_windows_rows;  prof gather_windows # same-machine Windows sessions, via /mnt/c
gather_remote_rows                       # cached homelab snapshot — instant, no network
collapse_bg_forks                        # one row per task: fold a bg fork into its origin
if [ "$HAVE_WEZTERM" = 1 ]; then
  PANELIST=$(wezterm cli --no-auto-start --prefer-mux list --format json 2>/dev/null); prof wezterm_list
  load_titles;      prof load_titles
fi

# header line (right-aligned totals). Counted in pure bash — the old grep|awk|sort|grep
# chain was 4 process spawns, and spawns dominate render time on Windows.
total=0; declare -A _mh=()
while IFS=$'\t' read -r _st _host _rest; do
  [ -z "$_st" ] && continue
  total=$(( total + 1 )); [ -n "$_host" ] && _mh["$_host"]=1
done <<< "$rows"
machines=${#_mh[@]}
[ "$total" = 1 ]    && ts_s="" || ts_s="s"
[ "$machines" = 1 ] && ms_s="" || ms_s="s"
htext="${total} session${ts_s} · ${machines} machine${ms_s}"
row_width
printf -v hdrline '%*s' "$_rw" "$htext"

body=$(build_pretty); prof build_pretty
[ -z "$body" ] && body="$NO_SESSIONS_ROW"

# Self-reference used by every fzf bind (reload/preview/rename/pin/jump). Defaults to the
# deployed path; AGENTVIEW_SELF overrides it so an un-deployed copy (e.g. a worktree under
# review) can drive its own picker end-to-end without clobbering the installed binary.
SELF="${AGENTVIEW_SELF:-$HOME/.local/bin/agentview}"
# Live reload: open instantly on the cached snapshot above, then in the BACKGROUND
# refresh the homelab cache over ssh and POST a `reload` into this fzf via its
# --listen server, so fresh remote rows swap in without ever blocking the open. The
# ssh is ConnectTimeout-bounded and the EXIT trap kills this job before the script
# returns — nothing lingers to keep the picker's ConPTY alive (which is what hung
# CTRL+W). If curl/ssh are missing or the pull fails, the picker just keeps showing
# the cached snapshot — no error path. CTRL+F forces a manual refresh.
portfile="$HOME/.agentview-fzfport.$$"
rm -f "$portfile" 2>/dev/null
"$SELF" --refresh-remote "$portfile" \
  >/dev/null 2>&1 &   # detach stdio so the job never holds the picker's pipes open
poster_pid=$!
trap 'kill "$poster_pid" 2>/dev/null; rm -f "$portfile" 2>/dev/null' EXIT

# How CTRL+N / CTRL+X hand off to their chooser. execute() ALWAYS clears fzf's window first
# — even `execute(echo hi)` wipes the list — so under it the chooser can only ever replace
# the picker. execute-silent() never repaints, leaving the list painted; inside tmux that is
# what lets av_pick's display-popup float a chooser ON TOP of it. The catch is that execute-silent
# gives the child /dev/null for stdin, so it is only viable where the chooser has its own pty
# (the tmux popup). With no tmux an interactive fzf under it just hangs, and we must keep
# execute(). $TMUX can't change while the picker is up, so this resolves once, here.
if [ -n "${TMUX:-}" ]; then AV_EXEC='execute-silent'; else AV_EXEC='execute'; fi

# Height must stay FIXED (no ~ adaptive): fzf sizes an adaptive window once at start
# and never re-fits it, so rows the reloads above push in would overflow into scrolling
# while the terminal below the box sat empty.
sel=$(printf '%s\n' "$body" | fzf \
  --ansi --no-sort --cycle --layout=reverse --delimiter='\t' --with-nth=2.. \
  --height='90%' --min-height=12 --margin=1,2% --padding=1 \
  --border=rounded --border-label="$LABEL" --border-label-pos=3 \
  --prompt="$PROMPT" --ghost='filter sessions…' --pointer='▌' \
  --info=hidden --no-scrollbar --highlight-line \
  --header="$hdrline" --header-first \
  --footer='  ↵ switch · alt-# jump · ⌃r rename · ⌃p pin · ⌃n new · ⌃x remove · ⌃f refresh · ? keys · esc' \
  --preview="'$SELF' --card {1}" \
  --preview-window='right,46%,border-left,hidden,wrap' \
  --preview-label=' session ' \
  --listen=0 \
  --bind='start:execute-silent(echo $FZF_PORT > '"$portfile"')' \
  --bind='up:up+transform('"'$SELF'"' --skip up {1})' \
  --bind='down:down+transform('"'$SELF'"' --skip down {1})' \
  --bind='ctrl-k:up+transform('"'$SELF'"' --skip up {1})' \
  --bind='ctrl-j:down+transform('"'$SELF'"' --skip down {1})' \
  --bind='page-up:page-up+transform('"'$SELF'"' --skip up {1})' \
  --bind='page-down:page-down+transform('"'$SELF'"' --skip down {1})' \
  --bind='load:transform('"'$SELF'"' --skip down {1})' \
  --bind='ctrl-r:execute('"'$SELF'"' --rename {1})+reload('"'$SELF'"' --body)+refresh-preview' \
  --bind='ctrl-p:execute-silent('"'$SELF'"' --pin {1})+reload('"'$SELF'"' --body)+refresh-preview' \
  --bind='ctrl-f:reload('"'$SELF'"' --body)+refresh-preview+execute-silent(nohup '"'$SELF'"' --refresh-remote '"$portfile"' >/dev/null 2>&1 &)' \
  --bind='ctrl-n:'"$AV_EXEC"'('"'$SELF'"' --spawn '"$portfile"')+reload('"'$SELF'"' --body)+refresh-preview' \
  --bind='ctrl-x:'"$AV_EXEC"'('"'$SELF'"' --remove {1})+reload('"'$SELF'"' --body)+refresh-preview' \
  --bind='alt-1:become('"'$SELF'"' --jump-nth 1)' \
  --bind='alt-2:become('"'$SELF'"' --jump-nth 2)' \
  --bind='alt-3:become('"'$SELF'"' --jump-nth 3)' \
  --bind='alt-4:become('"'$SELF'"' --jump-nth 4)' \
  --bind='alt-5:become('"'$SELF'"' --jump-nth 5)' \
  --bind='alt-6:become('"'$SELF'"' --jump-nth 6)' \
  --bind='alt-7:become('"'$SELF'"' --jump-nth 7)' \
  --bind='alt-8:become('"'$SELF'"' --jump-nth 8)' \
  --bind='alt-9:become('"'$SELF'"' --jump-nth 9)' \
  --bind='ctrl-o:toggle-preview' \
  --bind='?:show-preview+preview('"'$SELF'"' --keys)' \
  --color="$AV_COLOR") || exit 0

[ -z "$sel" ] && exit 0
key=$(printf '%s' "$sel" | cut -f1)
[ -z "$key" ] && exit 0
# A failed jump must say so — a bare exit 1 here read as "enter does nothing".
jump_or_report "$key" || exit 1

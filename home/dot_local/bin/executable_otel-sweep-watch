#!/usr/bin/env bash
# otel-sweep-watch — daily check that every machine is actually exporting telemetry.
#
# The failure this exists for is silent by construction: a session started before its
# collector was up exports nothing for its entire life, while pods stay green and the
# counters keep climbing. Two of them went unnoticed for three days each. A journal line
# nobody reads would be exactly as invisible, so findings raise a desktop notification —
# the one place this deviates from the other health timers here.
#
# What counts as a finding is deliberately narrow, because a check that cries wolf daily
# gets muted and then detects nothing:
#   - a machine that cannot be reached at all
#   - Loki unreachable on a machine that answered (nothing is recorded without it)
#   - a session whose transcript is growing while Loki holds none of its events
#   - an error whose MESSAGE is not a known-benign one; a rate-limit rejection is
#     what a busy day looks like, so counting it as a fault made the verdict red
#     on ordinary use, and a check that is red every day is one nobody reads
# Counts are attributed to the STORE that holds them rather than to the machine
# that queried it, because nothing in the pipeline records a hostname and two
# cluster nodes read one Loki — reporting per host turned 9 errors into 18.
# Prometheus or Tempo being unreachable is NOT a finding: daniel-server legitimately runs
# no Tempo, so flagging it would fire every single day forever. Loki gets the same
# treatment on a machine otel-sweep marks `queryable: false` — daniel-server has been a
# collector-only k3s worker since 2026-08-13, holding the otel-collector DaemonSet and no
# query backend at all, so "Loki unreachable" there is the expected answer and its zeros
# mean "not queryable from here", never "nothing is being recorded". Its events are in
# box's totals.
#
# Exits non-zero on findings so `systemctl --user --failed` is a second, passive signal.
set -uo pipefail

SWEEP=${OTEL_SWEEP:-otel-sweep}

if ! command -v "$SWEEP" >/dev/null 2>&1; then
  printf 'otel-sweep-watch: %s not on PATH\n' "$SWEEP" >&2
  exit 2
fi

# --deep is the point: silent-session detection is the only check here that the fast pass
# cannot make. It costs a per-session Loki query on each machine, affordable once a day.
raw=$("$SWEEP" --deep 2>/dev/null)
if [ -z "$raw" ]; then
  printf 'otel-sweep-watch: sweep produced no output\n' >&2
  exit 2
fi

# Quoted heredoc so bash expands nothing and the program can use either quote style —
# escaped quotes inside f-string expressions only parse on Python 3.12+.
read -r -d '' SUMMARISE <<'PY'
import json, sys

SILENT_FINDING_LIMIT = 5

# DECIDED: benign errors are named LITERALLY here, where otel-sweep's errors_24h
# takes a broad pattern over an enumeration. Both follow the same asymmetry, and
# it points opposite ways on the two sides. There, a pattern that misses an error
# NAME produces silence indistinguishable from health, so breadth is the safe
# error. Here, an entry that is too broad silences a real fault, while one that
# is too narrow costs a finding somebody reads once and widens — so this list
# takes the narrowest thing that works. Prefix match on a measured sentence, not
# a `rate.?limit` regex, which would also swallow a quota exhaustion worth waking
# for. Measured 2026-09-02: 13 api_errors, 11 this rejection and 2 a dead OAuth
# token on a nightly timer that had been failing since 2026-08-20.
BENIGN_ERROR_PREFIXES = (
    "This request would exceed your account's rate limit",
)


def is_benign(message):
    return message.startswith(BENIGN_ERROR_PREFIXES)


data = json.load(sys.stdin)
findings, lines = [], []

# Every tally the sweep collects is a property of the STORE, not of the machine
# that asked for it — nothing in the pipeline records a hostname. Two machines on
# one Loki therefore return one set of numbers twice, and labelling each copy
# with a host invents a second incident: on 2026-09-02 this reported "local: 9
# api_error events" and "server: 9 api_error events" for the same 9 events.
# Group by the store, and report each number once, against the store holding it.
#
# A machine whose sweep does not say which store it read groups alone, so an
# older otel-sweep degrades to the previous per-host output and two stores can
# never be merged by accident.
groups = {}
for host in sorted(data):
    d = data[host]
    if "error" in d:
        findings.append("%s: unreachable (%s)" % (host, d["error"][:80]))
        lines.append("%s: UNREACHABLE" % host)
        continue
    if d.get("queryable") is False:
        lines.append("%s: collector-only - counts live in box" % host)
        continue
    if d.get("backends", {}).get("loki") != "ready":
        findings.append("%s: Loki unreachable - nothing is being recorded" % host)
    if d.get("silent_checked") is False:
        findings.append("%s: silent-session check did not run - Loki query failed" % host)
    # Host-derived, and the only findings that are: a silent session is read from
    # THIS machine's transcripts against the store, so it stays per-host however
    # the stores group.
    silent = d.get("silent_sessions", [])
    # One line per session up to the cap, then a count. A fan-out of short-lived
    # sessions that all missed the exporter is one incident, and 23 near-identical
    # findings train the reader to skip the block. The `silent=` line below still
    # carries the honest total, because it is a len() over the uncapped payload.
    for s in silent[:SILENT_FINDING_LIMIT]:
        findings.append("%s: session %s exporting nowhere (%sMB)"
                        % (host, s["session"][:8], s["mb"]))
    if len(silent) > SILENT_FINDING_LIMIT:
        findings.append("%s: and %d more sessions exporting nowhere"
                        % (host, len(silent) - SILENT_FINDING_LIMIT))
    groups.setdefault(d.get("store") or ("host:" + host), []).append(host)


def merged(hosts, field):
    """The largest count each key reached across a store's machines.

    Equal by construction — they queried one store — but the queries run seconds
    apart, so a key can land on one side of the window and not the other. Taking
    the max means that skew can never make a group under-report.
    """
    out = {}
    for h in hosts:
        for key, n in (data[h].get(field) or {}).items():
            out[key] = max(out.get(key, 0), int(n))
    return out


for store in sorted(groups):
    hosts = groups[store]
    events = max(sum((data[h].get("events_24h") or {}).values()) for h in hosts)
    sessions = max(data[h].get("sessions_24h", 0) for h in hosts)

    if len(hosts) == 1:
        label = hosts[0]
        lines.append("%s: events=%d sessions=%d silent=%d"
                     % (label, events, sessions,
                        len(data[hosts[0]].get("silent_sessions", []))))
    else:
        # The shared totals once, then the one number that really is per-machine.
        label = "%s store (%s)" % (store, ", ".join(hosts))
        lines.append("%s: events=%d sessions=%d" % (label, events, sessions))
        for h in hosts:
            lines.append("  %s: silent=%d" % (h, len(data[h].get("silent_sessions", []))))

    messages = merged(hosts, "error_messages_24h")
    if messages:
        benign = sum(n for msg, n in messages.items() if is_benign(msg))
        for msg, n in sorted(messages.items()):
            if not is_benign(msg):
                findings.append("%s: %d x %s" % (label, n, msg[:90]))
        # Benign volume stays in the beat and out of the verdict. Dropping it from
        # both would trade a noisy detector for a blind one — a rate-limit count
        # that tripled is worth finding afterwards, even though it wakes nobody.
        if benign:
            lines.append("%s: %d rate-limited request(s) in 24h, not a fault"
                         % (label, benign))
    else:
        # No message breakdown means no class judgement is possible, so every
        # error counts. This is what the check did before the sweep reported
        # messages, and it is the right reading of a sweep that still does not.
        for name, n in sorted(merged(hosts, "errors_24h").items()):
            findings.append("%s: %d %s events in 24h" % (label, n, name))

print("\n".join(lines))
if findings:
    print("FINDINGS:")
    for f in findings:
        print("  " + f)
PY

report=$(printf '%s' "$raw" | python3 -c "$SUMMARISE")
status=$?

printf '%s\n' "$report"
if [ "$status" -ne 0 ]; then
  printf 'otel-sweep-watch: could not parse sweep output\n' >&2
  exit 2
fi

case $report in
  *FINDINGS:*) ;;
  *)
    # A clean run says so, so that "no line today" reads as "the check did not run"
    # rather than "the check was happy" — but only to someone reading back. Nothing
    # watches for the absence of an up beat: `probe.py alerts` reads status=down
    # lines, and no Kuma push monitor exists for this check. The up line is a
    # durable record for a post-hoc grep, not an alert. It uses the same shape as
    # the other host health checks so that adding such a monitor later needs no
    # change here.
    if command -v logger >/dev/null 2>&1; then
      logger -t otel-sweep-watch \
        "status=up $(printf '%s' "$report" | tr '\n' ';' | cut -c1-300)"
    fi
    exit 0
    ;;
esac

findings=$(printf '%s' "$report" | sed -n '/FINDINGS:/,$p' | tail -n +2)

# An unchanged finding set tells you nothing the last banner already did, and this
# script kept no memory, so anything that persisted raised a fresh notification on
# every single run. Re-notify when the findings change, or when the window lapses
# — a problem that is still there should resurface rather than go quiet for good.
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/otel-sweep-watch
repeat_after=${OTEL_SWEEP_WATCH_REPEAT_AFTER:-21600}
fingerprint=$(printf '%s' "$findings" | cksum | cut -d' ' -f1)
now=$(date +%s)
notify=yes
if [ -r "$state_dir/last-notified" ]; then
  previous=$(cut -d' ' -f1 "$state_dir/last-notified")
  since=$(cut -d' ' -f2 "$state_dir/last-notified")
  case $since in
    '' | *[!0-9]*) since=0 ;;
  esac
  if [ "$previous" = "$fingerprint" ] && [ "$((now - since))" -lt "$repeat_after" ]; then
    notify=no
  fi
fi

# syslog first, and unconditionally — this is the only channel that works on the machine
# where it matters most. On daniel-box there is no desktop bus for notify-send, the user
# journal held no record of this unit at all, and `SuccessExitStatus=1` kept it out of
# `systemctl --user --failed`. So on 2026-08-23 this check correctly found a dead query path
# and told nobody. Syslog reaches Loki, which is where the other host health checks report
# and where `probe.py alerts` already looks; `status=` is their convention.
#
# Outside the notify gate deliberately. That gate exists to stop a repeat *notification*
# becoming noise, and a log line is not noise. A record written only on runs that happened
# to change the fingerprint is a record with holes in it.
if command -v logger >/dev/null 2>&1; then
  logger -t otel-sweep-watch \
    "status=down $(printf '%s' "$findings" | tr '\n' ';' | cut -c1-400)"
fi

if [ "$notify" = yes ]; then
  # Best effort: a headless box has no bus, and the syslog line above is the durable record.
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --urgency=normal --icon=dialog-warning \
      "Claude telemetry" "$(printf '%s' "$findings" | head -5)" 2>/dev/null || true
  fi
  mkdir -p "$state_dir" 2>/dev/null || true
  printf '%s %s\n' "$fingerprint" "$now" >"$state_dir/last-notified" 2>/dev/null || true
fi

exit 1

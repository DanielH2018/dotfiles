#!/usr/bin/env python3
"""jsonq — query JSON with constrained Python expressions.

Exists so JSON can be reshaped without a permission prompt. `python3 -c` is
ask-listed (it is arbitrary code execution) and jq's language runs out of road
quickly, so the middle ground is Python *syntax* over already-parsed JSON,
validated against a fail-closed AST allowlist before anything runs. The result
cannot import, open a file it was not handed, spawn a process, or reach the
network — which is what makes a blanket `Bash(jsonq:*)` allow rule defensible.

    jsonq 'sorted(d["permissions"])' settings.json
    jsonq '[r for r in d["rules"] if r["on"]]' a.json
    jsonq 'set(d1) - set(d2)' a.json b.json
    jsonq --script 'out = [x["id"] for x in d if x["ok"]]' a.json

Invoke it by name, never as `python3 jsonq` — block-dangerous-bash.sh treats a
line containing an interpreter keyword followed by a `.key`/`.env`/`.pem`
substring as a secrets read and hard-blocks it, and JSON field names trip that.
"""

from __future__ import annotations

import argparse
import ast
import builtins
import collections
import collections.abc
import json
import os
import re
import signal
import sys

# Pre-bound pure-stdlib modules. None can reach the filesystem, the network, or a
# subprocess, so exposing them adds nothing for the AST walk to defend against.
# `import` inside an expression is never allowed; these are the whole surface.
import datetime
import functools
import itertools
import math
import statistics

PROG = "jsonq"
MAX_OUTPUT_BYTES = 10 * 1024 * 1024
DEFAULT_TIMEOUT = 5

# Mirror of SECRET_PATHS in ~/.claude/hooks/block-dangerous-bash.sh. jsonq opens
# files directly, so without this it would be a way around that hook's guard —
# ~/.claude.json, ~/.docker/config.json and ~/.kube/config are all JSON *and*
# secret. tests/jsonq.test.js asserts the two stay in sync; the only permitted
# difference is POSIX [:space:] rewritten as \s for Python's re.
SECRET_PATHS = (
    r"(\.env|\.ssh/|id_rsa|id_ed25519|id_ecdsa|\.aws/credentials|\.aws/config"
    r"|\.gnupg/|\.netrc|\.pypirc|\.npmrc|/secrets/|\.git-credentials"
    r"|\.kube/config|\.docker/config\.json|\.config/gh/hosts\.yml|\.claude\.json"
    r"|/etc/shadow|/etc/gshadow|/proc/[^/\s]+/environ|\.pem|\.key|\.p12|\.pfx)"
)


class JsonqError(Exception):
    """A refusal we raise ourselves — always reported without a traceback."""


def _nodes(*names):
    """Resolve AST class names, skipping any this Python doesn't define.

    Node types come and go across versions (ast.Index died in 3.9), so building
    the allowlist by name keeps a missing type from being an import-time crash.
    Skipping an absent name cannot widen the allowlist: absent means unusable.
    """
    return {getattr(ast, n) for n in names if getattr(ast, n, None) is not None}


_EXPR_NODES = _nodes(
    "Expression", "Expr", "Constant", "Name", "Load", "Store",
    "Tuple", "List", "Dict", "Set",
    "ListComp", "SetComp", "DictComp", "GeneratorExp", "comprehension",
    "BinOp", "UnaryOp", "BoolOp", "Compare", "IfExp",
    "Subscript", "Slice", "Index", "Call", "Attribute",
    "JoinedStr", "FormattedValue", "Starred",
    "Lambda", "arguments", "arg", "keyword", "NamedExpr",
    # operators
    "Add", "Sub", "Mult", "Div", "FloorDiv", "Mod", "Pow",
    "LShift", "RShift", "BitOr", "BitXor", "BitAnd", "MatMult",
    "And", "Or", "Not", "UAdd", "USub", "Invert",
    "Eq", "NotEq", "Lt", "LtE", "Gt", "GtE", "Is", "IsNot", "In", "NotIn",
)

# --script only. Everything absent here — def, class, import, with, try, raise,
# global, del, yield, await — is rejected by virtue of not being listed.
_STMT_NODES = _nodes(
    "Module", "Assign", "AugAssign", "AnnAssign",
    "For", "If", "While", "Break", "Continue", "Pass",
)

# `format` resolves attributes at *runtime* ("{0.__class__}".format(x)), so it
# walks straight past an AST-only check — the one escape the node allowlist and
# the underscore rule cannot see. f-strings are fine: JoinedStr puts the access
# back in the tree where _validate finds it. `mro` is cheap insurance.
_BANNED_ATTRS = {"format", "format_map", "mro"}

_BUILTIN_NAMES = (
    "abs", "all", "any", "bool", "dict", "divmod", "enumerate", "filter",
    "float", "frozenset", "int", "isinstance", "len", "list", "map", "max",
    "min", "pow", "range", "repr", "reversed", "round", "set", "slice",
    "sorted", "str", "sum", "tuple", "zip",
)
SAFE_BUILTINS = {n: getattr(builtins, n) for n in _BUILTIN_NAMES}

SAFE_MODULES = {
    "json": json,
    "re": re,
    "math": math,
    "datetime": datetime,
    "collections": collections,
    "itertools": itertools,
    "functools": functools,
    "statistics": statistics,
}


def _bindings(tree):
    """Names the source itself introduces — assignment targets, loop and
    comprehension variables, lambda parameters. Collected up front so a later
    read of one isn't mistaken for a reach at an undeclared global."""
    bound = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Name) and isinstance(node.ctx, ast.Store):
            bound.add(node.id)
        elif isinstance(node, ast.arg):
            bound.add(node.arg)
    return bound


def _validate(tree, allowed_nodes, allowed_names):
    """Fail closed: anything not explicitly permitted is an error."""
    for node in ast.walk(tree):
        if type(node) not in allowed_nodes:
            raise JsonqError(f"{type(node).__name__} is not allowed")

        if isinstance(node, ast.Name):
            # The underscore ban is what closes the classic sandbox escape,
            # ().__class__.__bases__[0].__subclasses__(), and any route back to
            # __builtins__ or __globals__.
            if node.id.startswith("_"):
                raise JsonqError(f"name {node.id!r} is not allowed (leading underscore)")
            if isinstance(node.ctx, ast.Load) and node.id not in allowed_names:
                raise JsonqError(f"name {node.id!r} is not allowed")
        elif isinstance(node, ast.Attribute):
            if node.attr.startswith("_"):
                raise JsonqError(f"attribute {node.attr!r} is not allowed (leading underscore)")
            if node.attr in _BANNED_ATTRS:
                raise JsonqError(f"attribute {node.attr!r} is not allowed")
        elif isinstance(node, ast.arg):
            if node.arg.startswith("_"):
                raise JsonqError(f"parameter {node.arg!r} is not allowed (leading underscore)")


def _check_readable(path):
    """Refuse secret paths. Both the given path and its realpath are tested, so
    a symlink pointing at ~/.ssh/id_rsa can't launder the name."""
    expanded = os.path.expanduser(path)
    for candidate in (expanded, os.path.realpath(expanded)):
        if re.search(SECRET_PATHS, candidate):
            raise JsonqError(f"refusing to read {path}: matches a secret-path pattern")
    return expanded


def _load(path):
    if path == "-":
        return json.load(sys.stdin)
    target = _check_readable(path)
    try:
        with open(target, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except FileNotFoundError:
        raise JsonqError(f"no such file: {path}")
    except json.JSONDecodeError as exc:
        raise JsonqError(f"{path}: invalid JSON ({exc})")


def _default(obj):
    """Coerce the few non-JSON types a valid expression can plausibly return."""
    if isinstance(obj, (set, frozenset)):
        try:
            return sorted(obj)
        except TypeError:  # mixed types have no total order
            return sorted(obj, key=repr)
    if isinstance(obj, (datetime.datetime, datetime.date, datetime.time)):
        return obj.isoformat()
    if isinstance(obj, (bytes, bytearray)):
        return obj.decode("utf-8", "replace")
    if isinstance(obj, range) or isinstance(obj, collections.abc.Iterator):
        return list(obj)
    raise TypeError(f"result of type {type(obj).__name__} is not JSON-serialisable")


def _render(result, raw, indent):
    if raw:
        if isinstance(result, str):
            return result
        if isinstance(result, (list, tuple)) or isinstance(result, collections.abc.Iterator):
            return "\n".join(
                x if isinstance(x, str) else json.dumps(x, default=_default, ensure_ascii=False)
                for x in result
            )
    separators = None if indent else (",", ":")
    return json.dumps(result, default=_default, indent=indent,
                      separators=separators, ensure_ascii=False)


def _install_timeout(seconds):
    """Wall-clock cap. Mostly there for `while` in --script mode, but a big
    enough comprehension can hang the tool just as well."""
    if not hasattr(signal, "SIGALRM") or seconds <= 0:
        return

    def _fire(_signum, _frame):
        raise JsonqError(f"expression exceeded the {seconds}s timeout")

    signal.signal(signal.SIGALRM, _fire)
    signal.alarm(seconds)


def run(source, files, mode, raw=False, indent=None, timeout=DEFAULT_TIMEOUT):
    """Validate, evaluate, render. Split out from main() so tests can call it."""
    docs = [_load(f) for f in files] if files else [json.load(sys.stdin)]

    env = dict(SAFE_MODULES)
    env.update(SAFE_BUILTINS)
    env["d"] = docs[0]
    env["ds"] = docs
    for i, doc in enumerate(docs, 1):
        env[f"d{i}"] = doc

    try:
        tree = ast.parse(source, mode=mode)
    except SyntaxError as exc:
        raise JsonqError(f"syntax error: {exc.msg}")

    allowed_nodes = _EXPR_NODES | (_STMT_NODES if mode == "exec" else set())
    _validate(tree, allowed_nodes, set(env) | _bindings(tree))

    scope = {"__builtins__": {}}
    scope.update(env)

    _install_timeout(timeout)
    try:
        if mode == "eval":
            result = eval(compile(tree, "<jsonq>", "eval"), scope)  # noqa: S307
        else:
            exec(compile(tree, "<jsonq>", "exec"), scope)  # noqa: S102
            if "out" not in scope:
                raise JsonqError("--script must assign its result to `out`")
            result = scope["out"]
    finally:
        if hasattr(signal, "SIGALRM"):
            signal.alarm(0)

    text = _render(result, raw, indent)
    if len(text.encode("utf-8")) > MAX_OUTPUT_BYTES:
        raise JsonqError("output exceeds the 10 MB cap; narrow the expression")
    return text


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Query JSON with a constrained Python expression.",
        epilog="Bound names: d (first document), d1..dN (per input), ds (all).",
    )
    parser.add_argument("-r", "--raw", action="store_true",
                        help="print string results unquoted, one per line for a list")
    parser.add_argument("--indent", type=int, default=None,
                        help="pretty-print with N spaces (default: compact)")
    parser.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT,
                        help=f"wall-clock cap in seconds (default: {DEFAULT_TIMEOUT})")
    parser.add_argument("-s", "--script", metavar="SRC",
                        help="multi-statement mode; assign the result to `out`")
    parser.add_argument("args", nargs="*", metavar="EXPR [FILE...]",
                        help="expression, then input files (stdin if none)")
    ns = parser.parse_args(argv)

    if ns.script is not None:
        source, files, mode = ns.script, list(ns.args), "exec"
    else:
        if not ns.args:
            parser.error("an expression is required")
        source, files, mode = ns.args[0], list(ns.args[1:]), "eval"

    try:
        print(run(source, files, mode, ns.raw, ns.indent, ns.timeout))
    except JsonqError as exc:
        print(f"{PROG}: {exc}", file=sys.stderr)
        return 2
    except BrokenPipeError:
        return 0
    except Exception as exc:  # the expression itself blew up (KeyError, TypeError, ...)
        print(f"{PROG}: {type(exc).__name__}: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

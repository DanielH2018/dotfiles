#!/usr/bin/env python3
"""jsonq — query JSON with a closed subset of Python syntax.

Exists so JSON can be reshaped without a permission prompt. `python3 -c` is
ask-listed (it is arbitrary code execution) and jq's language runs out of road
quickly, so the middle ground is Python *syntax* over already-parsed JSON.

What makes a blanket `Bash(jsonq:*)` rule defensible is not a check, it is an
absence: **no file in this tool contains `eval`, `exec` or `compile`.**
`ast.parse` builds a syntax tree, which executes nothing; the tree is then
walked by `_Interp` in share/jsonq/interp.py. The dispatch tables in that same
module *are* the grammar — a node type with no entry cannot run, because there
is nothing that would run it.

That is a deliberate reversal of the previous design, which enumerated
forbidden AST nodes and then handed the original source to CPython's `eval`.
`eval` accepts a strictly larger language than any enumeration written against
it: `statistics.sys.modules["os"]` is an ordinary non-underscore attribute
chain, and `"{0.__class__}".format(x)` resolves attributes at runtime where no
AST check can see them. Every escape lived in the gap between the checker and
the second, more permissive evaluator. Removing the second evaluator removes
the gap. Adding rules to the checker never did — that was tried twice.

Two consequences, both load-bearing:

* **There is no attribute access.** `ast.Attribute` has no handler, so `x.y` is
  refused in every position — no method calls, no module namespaces, no
  `__class__`. The reachable object graph is exactly: JSON values, the fixed
  function table, and lambdas defined by the query. There is no route from a
  value to any other object, so there is nothing left to enumerate.
* **Methods are spelled as functions.** `d.keys()` is `keys(d)`,
  `s.startswith(p)` is `startswith(s, p)`, `re.findall(p, s)` is
  `re_findall(p, s)`. `jsonq --functions` prints the whole table.

    jsonq 'sorted(d["permissions"])' settings.json
    jsonq '[r for r in d["rules"] if r["on"]]' a.json
    jsonq 'set(d1) - set(d2)' a.json b.json
    jsonq --script 'out = [x["id"] for x in d if x["ok"]]' a.json
    jsonq --jsonl 'len([x for x in d if x["type"] == "user"])' session.jsonl

The tool is this file plus the nine modules in ../share/jsonq, and the property
above is asserted over all ten by tests/jsonq.test.js. HOW those modules are
loaded is itself part of the boundary, so read _load below before changing it.

Invoke it by name, never through an interpreter — block-dangerous-bash.sh reads
a line naming an interpreter next to a secret-looking suffix as a secrets read
and hard-blocks it, and JSON field names trip that.
"""

from __future__ import annotations

import importlib
import os
import sys
import types

# Load order. Each module imports only from those above it; the graph is a DAG
# whose leaves are limits, errors and lambdas. The list is exhaustive —
# tests/jsonq.test.js asserts the share directory holds exactly these modules,
# so a file appearing there without appearing here is a finding.
MODULES = (
    "limits",
    "errors",
    "lambdas",
    "guards",
    "functions",
    "interp",
    "validate",
    "documents",
    "cli",
)

PACKAGE = "_jsonq"


def _load():
    """Import the modules without putting their directory on `sys.path`.

    This is part of the boundary, not plumbing. The obvious spelling —
    `sys.path.insert(0, share)` — would make every subsequent `import json`
    resolve out of that directory first, so an unmanaged `json.py` dropped
    beside these modules would shadow the standard library and run under a rule
    that never prompts. `sys.path.append` only changes which collision wins.

    Binding the directory to a package `__path__` instead scopes it to
    `_jsonq.*` and nothing else: a file no module imports by name is never
    loaded, so an unexpected one is inert rather than a shadow. `sys.path` is
    left untouched, which is what the test of that name checks.

    Bytecode writing is off so the deploy directory does not acquire a
    `__pycache__` that a later run would read back.
    """
    sys.dont_write_bytecode = True
    here = os.path.dirname(os.path.realpath(__file__))
    share = os.path.join(os.path.dirname(here), "share", "jsonq")

    package = types.ModuleType(PACKAGE)
    package.__path__ = [share]
    sys.modules[PACKAGE] = package

    for name in MODULES:
        importlib.import_module(f"{PACKAGE}.{name}")
    return sys.modules[f"{PACKAGE}.cli"]


if __name__ == "__main__":
    sys.exit(_load().main())

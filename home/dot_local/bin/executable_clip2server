#!/usr/bin/env bash
# Put the Wayland clipboard's image onto daniel-box and hand its *remote* path to the Claude
# session running there. Claude Code resolves an image path typed into its prompt, so the path
# becomes a real image attachment — which a terminal paste of the image bytes cannot do, the
# server being headless and a terminal carrying no image types.
set -euo pipefail

HOST=daniel-box
DIR=/home/ubuntu/clip
KEEP_DAYS=7

# Its own control socket, not the one ~/.ssh/config sets up for interactive use. The server caps
# concurrent sessions per connection at 2 (measured: sessions 1-2 open, 3+ get "Session open
# refused by peer"), and two interactive shells already sit at that cap — so sharing their master
# means every run is refused the mux and dials a fresh TCP connection instead. That walks straight
# into `ufw limit ssh`, which REJECTs the sixth in 30s: a burst of pastes starts failing silently,
# which is the exact failure the shared master was supposed to prevent.
#
# On a socket of its own the baseline is zero sessions and a run needs one, so every paste after
# the first rides a connection that already exists. ClearAllForwardings drops the config's
# LocalForward 8183, which a second connection cannot bind anyway.
SSH_OPTS=(
  -o ControlPath="$HOME/.ssh/cm-clip2server"
  -o ControlMaster=auto
  -o ControlPersist=10m
  -o ClearAllForwardings=yes
)

fail() {
  notify-send --urgency=critical "clip2server" "$1"
  exit 1
}

# Two different things reach the clipboard from a screenshot and only one of them is image bytes.
# Spectacle's default post-capture action saves the file and copies its *location*, so what lands
# is a text/uri-list; copying out of an image editor lands image/png. Handle both — rejecting the
# uri-list is rejecting the exact flow this script exists for.
#
# Captured before matching rather than piped straight into `grep -q`: grep exits at its first
# match, wl-paste takes the SIGPIPE, and under `pipefail` the pipeline reports 141 — so the
# "nothing to send" branch would fire intermittently with an image sitting on the clipboard.
types=$(wl-paste --list-types 2>/dev/null || true)
ext=png
src_file=

if grep -qx 'image/png' <<<"$types"; then
  :
elif grep -qx 'text/uri-list' <<<"$types"; then
  # Trimmed with parameter expansion rather than `| head -1`, for the SIGPIPE reason above: head
  # closes the pipe after the first line and wl-paste dies on 141, which `pipefail` then makes
  # fatal. A uri-list is CRLF-delimited and may carry several entries; take the first.
  uri=$(wl-paste --type text/uri-list 2>/dev/null || true)
  uri=${uri%%$'\n'*}
  uri=${uri%$'\r'}
  [ "${uri#file://}" != "$uri" ] || fail "Clipboard URI is not a local file"
  # Percent-decoding, which a screenshot path needs the moment a folder has a space in it. Every
  # `%` in a well-formed file URI introduces two hex digits, so rewriting it as `\x` hands printf
  # an escape it already knows — including a literal percent, which arrives as %25 and decodes
  # back to itself.
  src_file=${uri#file://}
  printf -v src_file '%b' "${src_file//%/\\x}"
  [ -r "$src_file" ] || fail "Not readable: $src_file"
  mime=$(file --brief --mime-type "$src_file")
  case "$mime" in
    image/*) ext=${mime#image/} ;;
    *) fail "Clipboard file is not an image ($mime)" ;;
  esac
else
  fail "No image on the clipboard"
fi

name="clip-$(date +%Y%m%d-%H%M%S).${ext}"

# The whole remote side is one ssh command — upload, retention sweep, and the hand-off into the
# Claude prompt. Splitting it would double the connections per press, and the server runs
# `ufw limit ssh`, which REJECTs the sixth in 30s; a burst of pastes is exactly the case that
# limit punishes.
#
# The image has to become a *file* on the far side no matter what. A terminal cannot carry image
# bytes (OSC 52 is base64 text, and the wrong direction anyway) and the server is headless, so
# there is no clipboard over there for Claude to read from. What the hand-off buys is that the
# path never passes through the operator's hands: send-keys types it into the prompt, and Claude
# resolves it into a real image attachment.
#
# Built with semicolons rather than newlines so `printf %q` emits a plain single-quoted string
# rather than bash's $'…' form, which the remote login shell is not guaranteed to parse.
# `;` and not `&&` between the sweep and the write: find exits non-zero over a single unreadable
# entry, and chaining would then drop the image this run is sending.
remote='mkdir -p "$D"; find "$D" -name "clip-*" -mtime +"$K" -delete; cat > "$T"; '
# tmux does the filtering with -f, which keeps awk (and its quoting) out of a nested shell string.
# Sorted by window_activity (an epoch) so the most recently used Claude pane wins. Not
# pane_activity, which reads empty on tmux 3.7b and would leave the ordering arbitrary — the bug
# only shows up once there are two Claude sessions, which is exactly when it matters.
remote+='pane=$(tmux list-panes -a -f "#{==:#{pane_current_command},claude}" '
remote+='-F "#{window_activity} #{session_name}:#{window_index}.#{pane_index}" 2>/dev/null '
remote+='| sort -rn | head -1 | cut -d" " -f2); '
# Trailing space so the next thing typed doesn't run into the path. No Enter — the turn is the
# operator's to send, and this way several images can be queued into one prompt.
remote+='[ -n "$pane" ] || exit 0; tmux send-keys -t "$pane" -l "$T "; printf %s "$pane"'

# SC2029: the client-side expansion is the point — $DIR, $KEEP_DAYS and $name are decided here and
# the remote shell only ever sees their values, quoted by printf %q.
# shellcheck disable=SC2029
pane=$(
  { if [ -n "$src_file" ]; then cat -- "$src_file"; else wl-paste --type image/png; fi; } |
    ssh "${SSH_OPTS[@]}" "$HOST" "D=$(printf '%q' "$DIR") T=$(printf '%q' "$DIR/$name") K=$KEEP_DAYS \
      sh -c $(printf '%q' "$remote")"
) || fail "Transfer to $HOST failed"

if [ -n "$pane" ]; then
  notify-send "clip2server" "Image sent to $pane"
  exit 0
fi

# No Claude pane over there, so fall back to the two-step flow: leave the remote path on the local
# clipboard for the operator to paste by hand.
#
# Handing off to a transient unit rather than calling wl-copy directly, because a Wayland
# selection is served by a live process rather than stored anywhere. Launched from the keyboard
# shortcut this script *is* a systemd unit (app-clip2server@….service), and systemd kills whatever
# is left in the unit's cgroup once the main process exits — so wl-copy's forked daemon dies with
# it, ownership reverts to the previous owner, and the paste silently yields whatever was on the
# clipboard before. setsid does not help: the kill is by cgroup, not by session.
#
# --foreground keeps the copy the unit's main process, so systemd doesn't reap it as a leftover;
# wl-copy then exits on its own when the next client takes the selection, and --collect reaps the
# unit. Falls back to a plain wl-copy where systemd-run isn't available, which is correct for the
# terminal case — nothing is tearing a cgroup down there.
if command -v systemd-run >/dev/null 2>&1; then
  systemd-run --user --quiet --collect \
    --setenv=WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
    wl-copy --foreground "$DIR/$name"
else
  wl-copy "$DIR/$name"
fi

notify-send "clip2server" "$DIR/$name — path copied (no Claude pane found)"

{{- if eq .chezmoi.os "windows" -}}
# Managed by chezmoi (run_onchange). Clears stale copies of files that home/.chezmoiignore now
# excludes on Windows but did not exclude before: the darwin-only mac-askpass and the
# hooks/test_*.py suites, which deploy to ~/.claude/hooks where none of them can run — each
# finds its subject by the source tree's executable_-prefixed name, which chezmoi strips
# before deploying. `.chezmoiremove` cannot do this: a target BOTH
# ignored and listed there is a silent no-op, verified against a scratch --destination before
# this script was written. See the matching os-linux and os-darwin scripts for the other two
# platforms' share of the same cleanup.
#
# Idempotent: every removal is skip-if-absent, and prints only what it actually took.
$targets = @(
    '.local\bin\mac-askpass'
)
foreach ($rel in $targets) {
    $path = Join-Path $HOME $rel
    if (Test-Path -LiteralPath $path) {
        Remove-Item -LiteralPath $path -Force
        Write-Host "cleanup-host-gated-files: removed $rel"
    }
}
# The hooks suites match the home/.chezmoiignore pattern itself, so a suite retired before this
# script existed is caught too. A reparse point (symlink) is skipped because chezmoi never
# deploys one here, so it belongs to the work overlay.
$hooks = Join-Path $HOME '.claude\hooks'
if (Test-Path -LiteralPath $hooks) {
    Get-ChildItem -LiteralPath $hooks -File |
        Where-Object { ($_.Name -like 'test_*.py' -or $_.Name -eq '_testkit.py') -and
                       -not ($_.Attributes -band [IO.FileAttributes]::ReparsePoint) } |
        ForEach-Object {
            Remove-Item -LiteralPath $_.FullName -Force
            Write-Host "cleanup-host-gated-files: removed .claude\hooks\$($_.Name)"
        }
}
{{- end -}}

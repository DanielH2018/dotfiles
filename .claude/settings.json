  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-context.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/audit-bash.sh"
          },
          {
            "type": "command",
            "if": "Bash(rm *)",
            "command": "~/.claude/hooks/block-dangerous-bash.sh"
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "~/.claude/hooks/block-dangerous-bash.sh"
          },
          {
            "type": "command",
            "if": "Bash(curl *)",
            "command": "~/.claude/hooks/block-dangerous-bash.sh"
          },
          {
            "type": "command",
            "if": "Bash(wget *)",
            "command": "~/.claude/hooks/block-dangerous-bash.sh"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-secrets.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-format.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/lint-after-edit.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-before-stop.sh"
          },
          {
            "type": "command",
            "command": "rm -f /tmp/.claude-gcp-active"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.prompt // \"\"' | grep -q 'git-commit-and-push' && touch /tmp/.claude-gcp-active; exit 0"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git add *)",
            "command": "[ -f /tmp/.claude-gcp-active ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"permissionDecision\":\"allow\"}}' || true"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "[ -f /tmp/.claude-gcp-active ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"permissionDecision\":\"allow\"}}' || true"
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "[ -f /tmp/.claude-gcp-active ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"permissionDecision\":\"allow\"}}' || true"
          }
        ]
      }
    ]
  }
}
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
{{- if eq .chezmoi.os "windows" }}
    "type": "iterm",
    "source": "~/.config/fastfetch/logos-trimmed/Shape 1-white.png",
    "width": 24,
    "height": 12,
    "preserveAspectRatio": true,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 1
    }
{{- else }}
    "type": "kitty",
    "source": "~/.config/fastfetch/logos/*.png",
    "preserveAspectRatio": true,
    "padding": {
      "top": 1,
      "left": 2
    }
{{- end }}
  },
  "modules": [
    "title",
    "separator",
    "host",
    "os",
    "kernel",
    "uptime",
    "cpu",
    "terminal",
    "memory",
    "localip",
    "battery",
    "break",
    "colors"
  ]
}
#!/usr/bin/env python3
"""gh-rerun-failed — re-run the failed jobs of one CI run in a repo the operator owns.

`gh run rerun --failed` is the usual answer to an infrastructure failure in CI, and
raw `gh run rerun` also takes `--job`, `--debug` and any repo, so it gets no allow
rule. This wrapper exposes the one narrow form, built from constants and validated
values the way ghread is:

  - It sends exactly `gh run rerun --failed --repo=OWNER/REPO -- RUN_ID`. The run id
    must be a number, and the repo travels inside its `--repo=` element, so no caller
    text becomes a flag. `--job` and `--debug` are never sent.
  - The repo must belong to the account gh is logged in as. gh names both: `api user`
    gives the login, and `repo view` resolves the `-R` repo, which it takes as a
    positional rather than a flag, or the cwd's repository. The
    resolved name, not the caller's spelling, goes to the rerun.
  - The run must have finished with a failure, and its attempt count must be under
    MAX_ATTEMPTS. A failure that survives that many attempts is not an infrastructure
    failure, and a loop that keeps re-running it costs Actions minutes for nothing.
  - gh is found in fixed system directories, never through the caller's $PATH, and
    its environment drops GH_HOST, GH_CONFIG_DIR, the enterprise tokens and every
    DYLD_/LD_ variable, with HOME pinned. These three lines match ghread's.

  gh-rerun-failed 4567
  gh-rerun-failed 4567 -R owner/repo

gh's exit status is the exit status. A refusal raised here exits 2.
"""

from __future__ import annotations

import argparse
import json
import os
import pwd
import re
import subprocess
import sys

PROG = "gh-rerun-failed"

GH_DIRS = ("/opt/homebrew/bin", "/usr/local/bin", "/usr/bin")
_DROP_ENV = (
    "GH_HOST",
    "GH_CONFIG_DIR",
    "GH_ENTERPRISE_TOKEN",
    "GITHUB_ENTERPRISE_TOKEN",
    "DYLD_",
    "LD_",
)
_NUMBER = re.compile(r"^[0-9]+$")
_REPO = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9_.-]+$")
# The conclusions `gh run rerun --failed` has jobs to re-run for.
FAILED = frozenset({"failure", "timed_out", "cancelled", "startup_failure"})
MAX_ATTEMPTS = 3


class RerunError(Exception):
    """A refusal raised here, reported without a traceback."""


class GhFailed(Exception):
    """A preflight gh call exited non-zero; its stderr has already reached ours."""

    def __init__(self, code: int):
        super().__init__(code)
        self.code = code


def find_gh() -> str:
    for d in GH_DIRS:
        path = os.path.join(d, "gh")
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    raise RerunError(f"gh is not in {', '.join(GH_DIRS)}")


def gh_env() -> dict:
    env = {k: v for k, v in os.environ.items() if not k.startswith(_DROP_ENV)}
    env["HOME"] = pwd.getpwuid(os.getuid()).pw_dir
    env["PATH"] = ":".join(GH_DIRS + ("/bin", "/usr/sbin", "/sbin"))
    env.update(GH_PAGER="cat", GH_PROMPT_DISABLED="1", GH_NO_UPDATE_NOTIFIER="1")
    return env


def _read(gh: str, env: dict, args: list[str]) -> str:
    proc = subprocess.run(
        [gh, *args],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        env=env,
        text=True,
        check=False,
    )
    if proc.returncode != 0:
        raise GhFailed(proc.returncode)
    return proc.stdout.strip()


def preflight(gh: str, env: dict, run_id: str, repo: str | None) -> str:
    """Resolve the repo and check the run may be re-run.

    Returns:
      The resolved OWNER/REPO the rerun goes to.

    Raises:
      RerunError: the repo is not the login's, or the run is not a finished failure
        under MAX_ATTEMPTS.
      GhFailed: one of the reads failed.
    """
    login = _read(gh, env, ["api", "--jq=.login", "--", "user"])
    # `repo view` takes the repo as a positional and has no --repo flag; the `--`
    # keeps a validated name a positional anyway.
    view = ["repo", "view", "--json=nameWithOwner", "--jq=.nameWithOwner"]
    resolved = _read(gh, env, view + (["--", repo] if repo else []))
    if not _REPO.match(resolved):
        raise RerunError(f"gh resolved an unexpected repository {resolved!r}")
    owner = resolved.split("/", 1)[0]
    if not login or owner.lower() != login.lower():
        raise RerunError(
            f"refusing {resolved}: it belongs to {owner}, not to the gh login {login!r}"
        )
    raw = _read(
        gh,
        env,
        ["run", "view", f"--repo={resolved}", "--json=status,conclusion,attempt"]
        + ["--", run_id],
    )
    try:
        run = json.loads(raw)
    except ValueError:
        raise RerunError(
            f"gh run view printed something other than JSON: {raw!r}"
        ) from None
    if not isinstance(run, dict):
        raise RerunError(f"gh run view printed something other than an object: {raw!r}")
    if run.get("status") != "completed" or run.get("conclusion") not in FAILED:
        raise RerunError(
            f"refusing run {run_id}: status {run.get('status')!r}, conclusion"
            f" {run.get('conclusion')!r}; only a finished failure has jobs to re-run"
        )
    attempt = run.get("attempt")
    if not isinstance(attempt, int) or attempt >= MAX_ATTEMPTS:
        raise RerunError(
            f"refusing run {run_id}: attempt {attempt!r} has reached {MAX_ATTEMPTS};"
            " a failure that persists this long is not an infrastructure flake"
        )
    return resolved


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Re-run the failed jobs of one finished run in a repo you own.",
        allow_abbrev=False,
    )
    parser.add_argument("run_id", help="the workflow run's database id")
    parser.add_argument(
        "-R", "--repo", help="OWNER/REPO (default: the cwd's repository)"
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    ns = _parser().parse_args(sys.argv[1:] if argv is None else argv)
    try:
        if not _NUMBER.match(ns.run_id):
            raise RerunError(f"refusing run id {ns.run_id!r}")
        if ns.repo is not None and not _REPO.match(ns.repo):
            raise RerunError(f"refusing --repo {ns.repo!r}")
        gh = find_gh()
        env = gh_env()
        repo = preflight(gh, env, ns.run_id, ns.repo)
    except RerunError as exc:
        print(f"{PROG}: {exc}", file=sys.stderr)
        return 2
    except GhFailed as exc:
        return exc.code
    return subprocess.run(
        [gh, "run", "rerun", "--failed", f"--repo={repo}", "--", ns.run_id],
        stdin=subprocess.DEVNULL,
        env=env,
        check=False,
    ).returncode


if __name__ == "__main__":
    sys.exit(main())

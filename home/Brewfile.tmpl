tap "pulumi/tap", trusted: true
# Brew-only formulae (not in the shared core toolchain).
brew "bash"
brew "chezmoi"
brew "gh"
# Both fill gaps the Linux hosts do not have, which is why they are here rather than in
# tools.toml: gawk and flock are base-system on Linux and simply absent on macOS. Without them
# 24 tests in the pre-push suite self-skip on this machine — 9 on gawk, 15 on flock — and a
# skipped test is indistinguishable from a passing one in the totals. util-linux is keg-only, so
# .zshrc appends its bin to PATH; see the comment there for why appended and not prepended.
# It does NOT ship script(1) on macOS, so the pty tests that want the util-linux one stay
# skipped regardless.
brew "gawk"
brew "util-linux"
# DECIDED: install coreutils, so macOS gets GNU spellings. The alternative was a BSD fallback
# inside run_bounded, and this is the smaller of the two fixes the hole admits.
# Not cosmetic: run-bounded.sh bounds every hook child on `timeout`(1), which is coreutils and
# which a stock Mac lacks, so run_bounded emitted "timeout: command not found" and
# lint-after-edit.sh reported THAT as the lint verdict — a PostToolUse hook blocking real edits.
# tests/hooks/lint-after-edit.test.js:28 describes the hole and names the two ways to close it:
# put a timeout(1) on the hook's PATH (this) or give run_bounded a fallback, which is a change
# to the M10 bounded-execution contract and larger than the bug.
# .zshrc already PREPENDS coreutils/libexec/gnubin where it exists — that prepend was written
# for this formula and had been dead code, guarded on a `-d` that never matched. Installing the
# formula is what makes it live. Scripts keep their own BSD fallbacks regardless: gnubin reaches
# an interactive PATH, and a hook launched from elsewhere may not see it.
brew "coreutils"
brew "mas"
brew "pipx"
brew "pre-commit"
brew "tmux"
# uv is the macOS half of run_onchange_after_install-python-tools.sh.tmpl, which installs the
# binary itself only on Linux (no apt package) and then `uv tool install`s ruff + prek on
# both. Windows gets uv from winget. Not in tools.toml: no apt field means no shared row.
brew "uv"
brew "wget"
brew "pulumi/tap/pulumi"

# Core CLI toolchain — generated from .chezmoidata/tools.toml (the shared source of truth
# with the winget + Linux installers). Only tools with a brew formula appear here.
{{- range .tools }}{{ if .brew }}
brew "{{ .brew }}"
{{- end }}{{- end }}

{{ if and (eq .chezmoi.os "linux") (ne .profile "minimal") -}}
#!/bin/sh
# Installs the shell-experience CLI tools on a Linux workstation/server (Debian/Ubuntu or
# Fedora, amd64 or arm64), mirroring the macOS Brewfile for Linux. The distro package manager
# for repo packages + release binaries for the gaps. Gated to non-minimal profiles so a
# resource-constrained host (profile=minimal, e.g. the Pi) opts out of the heavy install.
# run_once_after_: runs AFTER file targets, so a sudo-less run that can't reach the package
# manager fails loudly (exit 1 → chezmoi does NOT record success → retries next apply) WITHOUT
# blocking dotfile deployment. Bump the marker to force a refresh.
# tools-bump: v12
set -u

BIN_DIR="$HOME/.local/bin"
VER_DIR="$BIN_DIR/.versions"   # release tag last installed per tool, so a re-apply upgrades a
                               # stale binary in place instead of skipping it (install-once).
mkdir -p "$BIN_DIR" "$VER_DIR"

# 0. Package-manager abstraction. Everything below speaks pkg_* instead of apt/dnf directly, so
#    the two distro families share one code path and one set of markers. An unrecognised distro
#    (Arch, Alpine, ...) sets PM="" — it warns once, skips the package phases, and still installs
#    every release binary, rather than failing the apply forever over packages it has no way to
#    install.
if command -v apt-get >/dev/null 2>&1 && command -v dpkg >/dev/null 2>&1; then
  PM=apt
elif command -v dnf >/dev/null 2>&1 && command -v rpm >/dev/null 2>&1; then
  PM=dnf
else
  PM=""
  echo "install-cli-tools: no supported package manager (want apt or dnf); installing release binaries only" >&2
fi

pkg_installed() { # $1=package -> 0 if present. Unknown PM: claim satisfied (nothing to check).
  case "$PM" in
    apt) dpkg -s "$1" >/dev/null 2>&1 ;;
    dnf) rpm -q "$1" >/dev/null 2>&1 ;;
    *)   return 0 ;;
  esac
}

pkg_install() { # $@=packages. dnf refreshes its own metadata, so it needs no `update` step.
  case "$PM" in
    apt) sudo apt-get update -qq && sudo apt-get install -y "$@" ;;
    dnf) sudo dnf install -y "$@" ;;
    *)   return 1 ;;
  esac
}

# 1. unzip up front — a release install below (yazi) extracts a .zip, and a bare distro (fresh
#    WSL Ubuntu) ships without unzip. Install it before any other package so it's guaranteed
#    present when the yazi step runs; nvim and the rest use tar and don't need it.
if ! command -v unzip >/dev/null 2>&1 && [ -n "$PM" ]; then
  if sudo -v; then
    pkg_install unzip
  else
    echo "install-cli-tools: sudo unavailable; deferring unzip (yazi extraction will be skipped)" >&2
  fi
fi

# 2. Distro packages (only if any are missing; needs sudo, which prompts in an interactive
#    terminal). The list comes from .chezmoidata/tools.toml — the shared source of truth with the
#    winget + Brewfile installers. Both package lists are rendered so the script stays portable at
#    runtime and PM picks one. Release-binary tools (eza/fastfetch/curlie/sd/fzf/zoxide/ripgrep)
#    have no apt/dnf field and stay in the bespoke section below.
PKGS_APT="{{ range .tools }}{{ if .apt }}{{ .apt }} {{ end }}{{ end }}"
PKGS_DNF="{{ range .tools }}{{ if .dnf }}{{ .dnf }} {{ end }}{{ end }}"
case "$PM" in
  apt) PKGS="$PKGS_APT" ;;
  dnf) PKGS="$PKGS_DNF" ;;
  *)   PKGS="" ;;
esac

missing=""
for p in $PKGS; do
  pkg_installed "$p" || missing="$missing $p"
done
if [ -n "$missing" ]; then
  if sudo -v; then
    # shellcheck disable=SC2086  # $missing is a space-separated package list; splitting intended
    pkg_install $missing
  else
    echo "install-cli-tools: sudo unavailable; deferring packages:$missing" >&2
  fi
fi

# 2b. GitHub CLI.
#     Debian/Ubuntu: from gh's own apt repo. Ubuntu's package is frozen at 2.45, which throws on a
#     deprecated Projects-classic GraphQL query (breaks `gh pr edit`/`gh pr merge`); cli.github.com
#     tracks current releases. Adds the repo + keyring once, then `apt upgrade` keeps gh current.
#     Fedora: the distro package already tracks current gh (2.94 on F44), so a plain install is
#     enough and there is no third-party repo to add.
GH_LIST="/etc/apt/sources.list.d/github-cli.list"
GH_KEYRING="/etc/apt/keyrings/githubcli-archive-keyring.gpg"
gh_ready() {
  case "$PM" in
    apt) [ -f "$GH_LIST" ] ;;
    dnf) rpm -q gh >/dev/null 2>&1 ;;
    *)   return 0 ;;
  esac
}
if ! gh_ready; then
  if sudo -v; then
    if [ "$PM" = apt ]; then
      sudo mkdir -p -m 755 /etc/apt/keyrings
      tmpk="$(mktemp)"
      if curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o "$tmpk"; then
        sudo install -m 0644 "$tmpk" "$GH_KEYRING"
        echo "deb [arch=$(dpkg --print-architecture) signed-by=$GH_KEYRING] https://cli.github.com/packages stable main" \
          | sudo tee "$GH_LIST" >/dev/null
        sudo apt-get update -qq && sudo apt-get install -y gh && echo "install-cli-tools: GitHub CLI repo added + gh updated"
      else
        echo "install-cli-tools: failed to fetch GitHub CLI keyring" >&2
      fi
      rm -f "$tmpk"
    else
      pkg_install gh && echo "install-cli-tools: gh installed"
    fi
  else
    echo "install-cli-tools: sudo unavailable; deferring GitHub CLI setup" >&2
  fi
fi

# 2c. WezTerm — the mux-server + `wezterm cli` back this machine's leg of the cross-machine
#     Claude Code session switcher (agentview) on Daniel's PC. Only the headless mux-server/CLI
#     are used (no DISPLAY). Neither distro packages it:
#       Debian/Ubuntu — upstream's fury.io apt repo.
#       Fedora        — upstream's own COPR (wezfurlong/wezterm-nightly), the install route
#                       wezterm documents for Fedora. It is the only maintained RPM source: the
#                       GitHub release RPMs are pinned to long-dead Fedora releases and the last
#                       tagged stable is from 2024. The COPR carries an fc44 chroot.
#     Repo added once, then the normal upgrade path keeps it current.
WEZ_LIST="/etc/apt/sources.list.d/wezterm.list"
WEZ_KEYRING="/usr/share/keyrings/wezterm-fury.gpg"
wez_ready() {
  case "$PM" in
    apt) [ -f "$WEZ_LIST" ] ;;
    dnf) rpm -q wezterm >/dev/null 2>&1 ;;
    *)   return 0 ;;
  esac
}
if ! wez_ready; then
  if sudo -v; then
    if [ "$PM" = apt ]; then
      tmpk="$(mktemp)"
      if curl -fsSL https://apt.fury.io/wez/gpg.key -o "$tmpk"; then
        sudo gpg --yes --dearmor -o "$WEZ_KEYRING" "$tmpk"
        sudo chmod 644 "$WEZ_KEYRING"
        echo 'deb [signed-by=/usr/share/keyrings/wezterm-fury.gpg] https://apt.fury.io/wez/ * *' \
          | sudo tee "$WEZ_LIST" >/dev/null
        sudo apt-get update -qq && sudo apt-get install -y wezterm && echo "install-cli-tools: WezTerm repo added + installed"
      else
        echo "install-cli-tools: failed to fetch WezTerm gpg key" >&2
      fi
      rm -f "$tmpk"
    elif sudo dnf -y copr enable wezfurlong/wezterm-nightly; then
      pkg_install wezterm && echo "install-cli-tools: WezTerm COPR enabled + installed"
    else
      echo "install-cli-tools: failed to enable the WezTerm COPR" >&2
    fi
  else
    echo "install-cli-tools: sudo unavailable; deferring WezTerm setup" >&2
  fi
fi

# 3. Real-name symlinks for Debian's renamed binaries (so the shell uses bat/fd). luac is what
#    tests/wezterm-config.test.js shells out to (luac -p); Debian's lua5.4 package ships it as
#    luac5.4, so without this alias that test silently skips there. Fedora installs all four
#    under their real names already, so every pair below no-ops on it.
for pair in "bat:batcat" "fd:fdfind" "lua:lua5.4" "luac:luac5.4"; do
  name="${pair%%:*}"; real="${pair##*:}"
  rp="$(command -v "$real" 2>/dev/null || true)"
  [ -n "$rp" ] && ln -sf "$rp" "$BIN_DIR/$name"
done

# 4. Release binaries for the package gaps (no sudo). Arch-aware: amd64 + arm64.
latest_tag() { # $1=owner/repo -> latest tag via the releases/latest redirect (no API/ratelimit)
  curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/$1/releases/latest" \
    | sed 's#.*/tag/##; s#[[:space:]]*$##'
}
recorded_tag() { cat "$VER_DIR/$1" 2>/dev/null; } # tag last installed for $1 ("" if never)
# Version-aware release install. $1=binname  $2=owner/repo  $3=asset-URL template, where {tag} is
# the full tag (e.g. v1.1.0) and {ver} is the tag without a leading v. Resolves the latest tag and
# only downloads when the binary is missing or the recorded tag differs — so `chezmoi apply`
# upgrades a stale tool in place instead of skipping anything already on PATH. We record the tag we
# installed rather than parsing `--version`, which is unreliable per-tool (eza prints multiple
# lines, curlie reports curl's version).
install_release() {
  bin="$1"; repo="$2"; tmpl="$3"
  tag="$(latest_tag "$repo")"
  if [ -z "$tag" ]; then echo "install-cli-tools: could not resolve latest tag for $repo" >&2; return 0; fi
  [ -x "$BIN_DIR/$bin" ] && [ "$(recorded_tag "$bin")" = "$tag" ] && return 0
  ver="${tag#v}"
  url="$(printf '%s' "$tmpl" | sed "s#{tag}#$tag#g; s#{ver}#$ver#g")"
  old="$(recorded_tag "$bin")"
  tmp="$(mktemp -d)"
  if curl -fsSL "$url" -o "$tmp/a.tgz" 2>/dev/null && tar xzf "$tmp/a.tgz" -C "$tmp" 2>/dev/null; then
    found="$(find "$tmp" -type f -name "$bin" 2>/dev/null | head -1)"
    if [ -n "$found" ]; then
      if install -m 0755 "$found" "$BIN_DIR/$bin"; then
        printf '%s' "$tag" > "$VER_DIR/$bin"
        echo "install-cli-tools: installed $bin ${old:+$old -> }$tag"
      fi
    else
      echo "install-cli-tools: $bin not found in archive ($url)" >&2
    fi
  else
    echo "install-cli-tools: failed to fetch $bin ($url)" >&2
  fi
  rm -rf "$tmp"
}

# Per-tool arch naming differs: Rust target triple (eza/sd) vs fastfetch's -aarch64 vs
# goreleaser's arm64 (curlie). Downloading the wrong arch would tar-extract cleanly but
# Exec-format-error at first use, so skip release binaries outright on an arch we lack names for.
case "$(uname -m)" in
  x86_64|amd64)  rust_arch=x86_64;  ff_arch=amd64;   go_arch=amd64;  nvim_arch=x86_64; rg_target=x86_64-unknown-linux-musl ;;
  aarch64|arm64) rust_arch=aarch64; ff_arch=aarch64; go_arch=arm64;  nvim_arch=arm64;  rg_target=aarch64-unknown-linux-gnu ;;
  *) rust_arch=""; rg_target=""; echo "install-cli-tools: unknown arch $(uname -m); skipping eza/fastfetch/curlie/sd/fzf/zoxide/ripgrep/gron/nvim/yazi" >&2 ;;
esac
if [ -n "$rust_arch" ]; then
  install_release eza       eza-community/eza       "https://github.com/eza-community/eza/releases/latest/download/eza_${rust_arch}-unknown-linux-gnu.tar.gz"
  install_release fastfetch fastfetch-cli/fastfetch "https://github.com/fastfetch-cli/fastfetch/releases/latest/download/fastfetch-linux-${ff_arch}.tar.gz"
  install_release curlie    rs/curlie               "https://github.com/rs/curlie/releases/download/{tag}/curlie_{ver}_linux_${go_arch}.tar.gz"
  install_release sd        chmln/sd                "https://github.com/chmln/sd/releases/download/{tag}/sd-{tag}-${rust_arch}-unknown-linux-gnu.tar.gz"
  install_release starship  starship/starship       "https://github.com/starship/starship/releases/download/{tag}/starship-${rust_arch}-unknown-linux-gnu.tar.gz"
  # fzf/zoxide/ripgrep back the shell init (fzf keybindings, zoxide `cd`, rg as FZF_DEFAULT_COMMAND)
  # but have no apt/dnf field here, so install the current release binaries rather than relying on
  # the stale copies baked into the base image. ripgrep ships only musl on x86_64 and gnu on aarch64.
  install_release fzf       junegunn/fzf            "https://github.com/junegunn/fzf/releases/download/{tag}/fzf-{ver}-linux_${go_arch}.tar.gz"
  install_release zoxide    ajeetdsouza/zoxide      "https://github.com/ajeetdsouza/zoxide/releases/download/{tag}/zoxide-{ver}-${rust_arch}-unknown-linux-musl.tar.gz"
  install_release rg        BurntSushi/ripgrep      "https://github.com/BurntSushi/ripgrep/releases/download/{tag}/ripgrep-{ver}-${rg_target}.tar.gz"
  # gron is the one tools.toml entry whose distro coverage is uneven: apt has it, Fedora packages
  # none. Guarded on the binary rather than on PM, so it stays a no-op wherever the package phase
  # already supplied gron and the fallback isn't pinned to one distro's absence.
  command -v gron >/dev/null 2>&1 \
    || install_release gron tomnomnom/gron          "https://github.com/tomnomnom/gron/releases/download/{tag}/gron-linux-${go_arch}-{ver}.tgz"
fi

# 5. Neovim + Yazi. OS-UNIQUE tools handled elsewhere (winget on Windows, Brewfile on macOS) —
#    this is their Linux path. Neither fits the lone-binary install_release helper: nvim ships a
#    runtime tree, yazi ships a second binary (`ya`). No sudo; both use the version-less
#    latest/download asset form. Re-fetch when missing or the recorded tag is stale (same
#    version-aware policy as install_release).
if [ -n "$rust_arch" ]; then
  # Neovim: official static release. The tarball is bin/ + its runtime under one prefix; merge it
  # into ~/.local so bin/nvim resolves ../share/nvim/runtime. nvim config self-bootstraps lazy.nvim.
  nvim_tag="$(latest_tag neovim/neovim)"
  if [ -n "$nvim_tag" ] && { [ ! -x "$BIN_DIR/nvim" ] || [ "$(recorded_tag nvim)" != "$nvim_tag" ]; }; then
    tmp="$(mktemp -d)"
    if curl -fsSL "https://github.com/neovim/neovim/releases/latest/download/nvim-linux-${nvim_arch}.tar.gz" -o "$tmp/nvim.tgz" 2>/dev/null \
       && tar xzf "$tmp/nvim.tgz" -C "$tmp" 2>/dev/null; then
      src="$(find "$tmp" -maxdepth 1 -type d -name 'nvim-linux-*' | head -1)"
      if [ -n "$src" ]; then
        old="$(recorded_tag nvim)"
        if mkdir -p "$HOME/.local" && cp -a "$src/." "$HOME/.local/"; then
          printf '%s' "$nvim_tag" > "$VER_DIR/nvim"
          echo "install-cli-tools: installed nvim ${old:+$old -> }$nvim_tag"
        fi
      else
        echo "install-cli-tools: nvim payload not found in archive" >&2
      fi
    else
      echo "install-cli-tools: failed to fetch nvim" >&2
    fi
    rm -rf "$tmp"
  fi
  # Yazi: release zip carrying both `yazi` and its `ya` plugin manager (ya pkg install is driven
  # by run_onchange_after_ya-pkg-install). Extract both to bin.
  yazi_tag="$(latest_tag sxyazi/yazi)"
  if [ -n "$yazi_tag" ] && { [ ! -x "$BIN_DIR/yazi" ] || [ "$(recorded_tag yazi)" != "$yazi_tag" ]; }; then
    tmp="$(mktemp -d)"
    if curl -fsSL "https://github.com/sxyazi/yazi/releases/latest/download/yazi-${rust_arch}-unknown-linux-gnu.zip" -o "$tmp/yazi.zip" 2>/dev/null \
       && unzip -q "$tmp/yazi.zip" -d "$tmp" 2>/dev/null; then
      d="$(find "$tmp" -maxdepth 1 -type d -name 'yazi-*' | head -1)"
      for b in yazi ya; do [ -f "$d/$b" ] && install -m 0755 "$d/$b" "$BIN_DIR/$b"; done
      if [ -x "$BIN_DIR/yazi" ]; then
        old="$(recorded_tag yazi)"
        printf '%s' "$yazi_tag" > "$VER_DIR/yazi"
        echo "install-cli-tools: installed yazi ${old:+$old -> }$yazi_tag"
      fi
    else
      echo "install-cli-tools: failed to fetch yazi" >&2
    fi
    rm -rf "$tmp"
  fi
fi

# Fail loudly (and retry next apply) if any distro package is still missing — e.g. a sudo-less
# run. As a run_once_after_ script this does NOT block dotfile deployment. PM="" reports every
# check satisfied, so an unsupported distro converges on the release binaries instead of
# retrying a package install it can never perform.
still=""
for p in $PKGS; do
  pkg_installed "$p" || still="$still $p"
done
if [ -n "$still" ] || ! gh_ready || ! wez_ready; then
  [ -n "$still" ] && echo "install-cli-tools: packages still missing:$still" >&2
  gh_ready  || echo "install-cli-tools: GitHub CLI not configured yet" >&2
  wez_ready || echo "install-cli-tools: WezTerm not configured yet" >&2
  echo "install-cli-tools: re-run 'chezmoi apply' in a terminal where sudo can prompt." >&2
  exit 1
fi
{{ end -}}

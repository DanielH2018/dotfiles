#!/usr/bin/env python3
"""skill-usage — fire counts for every installed skill, agent and plugin.

Nothing recorded which of the 23 skills and 5 agents under
home/private_dot_claude/{skills,agents} ever actually fire, so a scaffolding-delete-
pass had no evidence to weigh a removal against. executable_skill-usage-log.py (a
PostToolUse hook on Skill|Agent|Task) writes one JSONL line per invocation to
~/.claude/logs/skill-usage.jsonl; this reads that log back into a table.

Enumeration mirrors vault-tooling/config-map/config_map/scan.py's scan_skills /
scan_agents / scan_plugins, so the two report the same installed set: skills are
directories under skills/ with a SKILL.md, agents are *.md files under agents/, and
plugins are the keys of ~/.claude/plugins/installed_plugins.json that
~/.claude/settings.json's enabledPlugins marks `true` (disabled/unlisted plugins are
not installed in any sense a fire count needs). A plugin fires as a Skill or Agent
call whose name is "pluginname:thing", so a plugin's count is
every log entry whose name starts with "pluginname:", not an exact match.

Sorted by 30-day count descending, so a zero-fire entry -- the thing this exists to
surface -- sinks to the bottom rather than needing to be spotted in the middle of an
alphabetical list.

This was a bash script making 15 jq passes until 2026-10-22. It reads the same files,
honours the same environment seams and prints the same table; where it reproduces a jq
semantic the old output depended on, the comment names it.

Env overrides (all seams for the test suite; defaults are the real thing):
  SKILL_USAGE_ROOT           repo root to walk for skills/agents (default: git toplevel)
  SKILL_USAGE_LOG            the JSONL log to read
                              (default: ~/.claude/logs/skill-usage.jsonl)
  SKILL_USAGE_CLAUDE_DIR     where plugins/ and settings.json live (default: ~/.claude)
  SKILL_USAGE_WINDOW_DAYS    the fire-count window (default: 30)
  SKILL_USAGE_NOW_EPOCH      "now", as unix seconds (default: the clock) -- fixes the
                              window's cutoff for a deterministic test
"""

from __future__ import annotations

import calendar
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

# A project skill inside a worktree logs as ".claude/worktrees/<name>:<skill>" (the
# directory-scoped identifier the Skill tool assigns there), which split one skill count
# across every worktree it ran in. Strip that prefix so every worktree fire folds into
# the one enumerated skill/agent/plugin it actually was.
WORKTREE_PREFIX = re.compile(r"^\.claude/worktrees/[^:]+:")


def fail(msg: str) -> int:
    print(f"skill-usage: {msg}", file=sys.stderr)
    return 1


def repo_root() -> str | None:
    root = os.environ.get("SKILL_USAGE_ROOT", "")
    if root:
        return root
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError:
        return None
    if out.returncode != 0:
        return None
    return out.stdout.rstrip("\n")


def enumerate_items(root: str) -> list[dict]:
    """Skills, then agents, each in glob order: the order equal rows tie-break in."""
    items = []
    skills = Path(root, "home", "private_dot_claude", "skills")
    agents = Path(root, "home", "private_dot_claude", "agents")
    if skills.is_dir():
        # bash's `*/`: no hidden entries, and directories or links to them only.
        for d in sorted(p for p in skills.iterdir() if not p.name.startswith(".")):
            if d.is_dir() and (d / "SKILL.md").is_file():
                items.append({"kind": "skill", "name": d.name})
    if agents.is_dir():
        for f in sorted(p for p in agents.iterdir() if not p.name.startswith(".")):
            if f.name.endswith(".md") and f.is_file():
                items.append({"kind": "agent", "name": f.name[: -len(".md")]})
    return items


def read_json_object(path: Path) -> dict:
    try:
        value = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    return value if isinstance(value, dict) else {}


def enabled_plugins(claude_dir: str) -> list[str]:
    """Enumerate enabled plugins, the way /config-map's scan_plugins does."""
    installed = read_json_object(Path(claude_dir, "plugins", "installed_plugins.json"))
    settings = read_json_object(Path(claude_dir, "settings.json"))
    plugins = installed.get("plugins") or {}
    enabled = settings.get("enabledPlugins") or {}
    if not isinstance(plugins, dict) or not isinstance(enabled, dict):
        return []
    return sorted({key.split("@")[0] for key in plugins if enabled.get(key) is True})


def decode_line(line: str) -> list | None:
    """Every JSON value on one log line, or None when the line counts as unparseable.

    The validity test is `jq -e '.'`, as it was in bash: jq accepts several whitespace-
    separated values on a line and takes its exit status from the last one, so a line
    ending in `null` or `false` fails as well.
    """
    decoder = json.JSONDecoder()
    values, pos = [], 0
    try:
        while True:
            while pos < len(line) and line[pos] in " \t\n\r":
                pos += 1
            if pos == len(line):
                break
            value, pos = decoder.raw_decode(line, pos)
            values.append(value)
    except ValueError:
        return None
    if not values or values[-1] is None or values[-1] is False:
        return None
    return values


def read_log(path: str) -> tuple[list, int, int]:
    """Return (values, raw_lines, valid_lines) for the log at path.

    A single corrupt/partial line (a write that lands mid-append, a killed process) must
    not take the whole file down to "[]" -- that reads as a legitimate zero-fire table,
    which for a scaffolding-delete-pass consumer means "delete everything installed".
    Each line is validated on its own, so one bad line is skipped and counted, not
    fatal.
    """
    values, raw, valid = [], 0, 0
    try:
        text = Path(path).read_text(errors="surrogateescape")
    except OSError:
        return values, raw, valid
    for line in text.split("\n"):
        if not line:
            continue
        raw += 1
        decoded = decode_line(line)
        if decoded is not None:
            valid += 1
            values.extend(decoded)
    return values, raw, valid


def epoch_of(ts) -> int | None:
    """jq's `fromdateiso8601`: exactly %Y-%m-%dT%H:%M:%SZ in UTC, else None."""
    if not isinstance(ts, str):
        return None
    try:
        return calendar.timegm(time.strptime(ts, "%Y-%m-%dT%H:%M:%SZ"))
    except ValueError:
        return None


def entries_from(log: list) -> list[dict]:
    entries = []
    for e in log:
        # In bash, one non-object value or non-string name made the whole jq aggregate
        # fail and print a table with no rows and no totals. Skipping that one value
        # keeps every other count.
        if not isinstance(e, dict) or e.get("kind") not in ("skill", "agent"):
            continue
        if not isinstance(e.get("name"), str):
            continue
        epoch = epoch_of(e.get("ts"))
        if epoch is None:
            continue
        name = WORKTREE_PREFIX.sub("", e["name"], count=1)
        entries.append({**e, "name": name, "epoch": epoch})
    return entries


def make_row(kind: str, name: str, matched: list[dict], cutoff) -> dict:
    last = "never"
    if matched:
        best = matched[0]
        for m in matched[1:]:
            # >=, because jq's max_by keeps the LAST of equal maxima.
            if m["epoch"] >= best["epoch"]:
                best = m
        last = best["ts"][0:10]
    return {
        "kind": kind,
        "name": name,
        "count": sum(1 for m in matched if m["epoch"] >= cutoff),
        "last": last,
    }


def aggregate(items, plugins, entries, now, window_days) -> dict:
    """One row per enumerated skill/agent/plugin, plus a match census."""
    cutoff = now - window_days * 86400

    def is_item(e, it):
        return e["kind"] == it["kind"] and e["name"] == it["name"]

    def is_plugin(e, p):
        return e["name"].startswith(p + ":")

    rows = [
        make_row(it["kind"], it["name"], [e for e in entries if is_item(e, it)], cutoff)
        for it in items
    ]
    rows += [
        make_row("plugin", p, [e for e in entries if is_plugin(e, p)], cutoff)
        for p in plugins
    ]

    # `unmatched` is the red-proof half of this: a log entry whose name doesn't hit any
    # enumerated skill/agent (exact match) or plugin (prefix match) would otherwise just
    # vanish from the table, which is indistinguishable from every count being correctly
    # zero. Surfacing it turns a naming mismatch into a visible line instead of a silent
    # all-zero table.
    #
    # KNOWN BUG, carried over from bash on purpose so this port changes no output: the
    # jq census tested plugins with `any($e.name | startswith(. + ":"))`, where the pipe
    # rebinds `.` to the name itself, so no entry ever matched a plugin. A plugin's
    # fires are therefore counted in its row AND listed as unmatched. The fix, for a
    # change of its own, is to also skip `any(is_plugin(e, p) for p in plugins)`.
    groups: dict[str, list[dict]] = {}
    for e in entries:
        if any(is_item(e, it) for it in items):
            continue
        # jq grouped on kind + NUL + name, which fixes the order the lines print in.
        groups.setdefault(e["kind"] + "\0" + e["name"], []).append(e)
    unmatched = [
        {"kind": g[0]["kind"], "name": g[0]["name"], "count": len(g)}
        for _, g in sorted(groups.items())
    ]

    return {
        # sorted() is stable like jq's sort_by, so equal rows keep enumeration order.
        "rows": sorted(rows, key=lambda r: (-r["count"], r["name"])),
        "total_entries": len(entries),
        "unmatched": unmatched,
    }


def tsv(fields: list[str]) -> str:
    """jq's @tsv: tab-joined, with backslash, tab, newline and CR escaped."""
    esc = {"\\": "\\\\", "\t": "\\t", "\n": "\\n", "\r": "\\r"}
    return "\t".join("".join(esc.get(c, c) for c in f) for f in fields)


def print_table(window_label: str, rows: list[dict]) -> None:
    table = f"KIND\tNAME\t{window_label}D\tLAST FIRED\n"
    for r in rows:
        table += tsv([r["kind"], r["name"], str(r["count"]), r["last"]]) + "\n"
    # column itself, not a reimplementation: BSD and util-linux column pad differently,
    # and the table has always looked like whichever one the host has.
    column = shutil.which("column")
    if column is None:
        sys.stdout.write(table)
        return
    sys.stdout.flush()
    subprocess.run([column, "-t", "-s", "\t"], input=table, text=True, check=False)


def env_number(name: str, default: str):
    raw = os.environ.get(name) or default
    try:
        value = json.loads(raw)
    except ValueError:
        value = None
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return raw, None
    return raw, value


def main() -> int:
    root = repo_root()
    if root is None:
        return fail("not a git repository and SKILL_USAGE_ROOT not set")
    home = Path.home()
    default_log = home / ".claude/logs/skill-usage.jsonl"
    log_file = os.environ.get("SKILL_USAGE_LOG") or str(default_log)
    claude_dir = os.environ.get("SKILL_USAGE_CLAUDE_DIR") or str(home / ".claude")
    window_label, window_days = env_number("SKILL_USAGE_WINDOW_DAYS", "30")
    _, now = env_number("SKILL_USAGE_NOW_EPOCH", str(int(time.time())))
    if window_days is None or now is None:
        return fail("SKILL_USAGE_WINDOW_DAYS and SKILL_USAGE_NOW_EPOCH must be numbers")

    log, raw_lines, valid_lines = read_log(log_file)
    items = enumerate_items(root)
    plugins = enabled_plugins(claude_dir)
    result = aggregate(items, plugins, entries_from(log), now, window_days)

    print_table(window_label, result["rows"])

    total = result["total_entries"]
    unmatched = result["unmatched"]
    matched = total - sum(u["count"] for u in unmatched)
    print(
        f"\n{matched} of {total} log entries (all-time) "
        "matched an installed skill/agent/plugin."
    )
    if unmatched:
        print("Unmatched -- fired but not currently installed under this name:")
        for u in unmatched:
            print(f"  {u['kind']}\t{u['name']}\t{u['count']}")
    if valid_lines < raw_lines:
        print(
            f"Warning: {raw_lines - valid_lines} of {raw_lines} log line(s) "
            "failed to parse as JSON and were skipped."
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())

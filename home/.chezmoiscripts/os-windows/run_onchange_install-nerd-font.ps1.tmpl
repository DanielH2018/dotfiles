{{- if eq .chezmoi.os "windows" -}}
# Managed by chezmoi (run_onchange). Installs IosevkaTerm Nerd Font SYSTEM-WIDE so the
# starship Nerd Font glyphs render in VS Code's integrated terminal and SURVIVE reboots
# (per-user / no-admin installs don't reliably auto-load on login). Elevates once (UAC)
# only when the font is missing. Also points VS Code's terminal at it.
# Re-runs only when this file changes.
# bump-to-reinstall: iosevkaterm-mono v2-systemwide

$ErrorActionPreference = 'Stop'

# Windows nerd-fonts register the Mono family as the abbreviated "IosevkaTerm NFM"
# (not the full "Nerd Font Mono"); keep the full name as a cross-OS fallback.
$vscodeFamily = 'IosevkaTerm NFM, IosevkaTerm Nerd Font Mono'
$sysDir = Join-Path $env:WINDIR 'Fonts'

# --- 1. Install the font system-wide (idempotent; one UAC only when missing) ----
if (-not (Get-ChildItem -Path $sysDir -Filter 'IosevkaTerm*NerdFontMono*.ttf' -ErrorAction SilentlyContinue)) {
    # Self-contained elevated installer. Single-quoted here-string => no escaping needed.
    $elevContent = @'
$ErrorActionPreference = 'Stop'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$sysDir = Join-Path $env:WINDIR 'Fonts'
$reg    = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts'
$work   = Join-Path $env:TEMP ('iosevka-elev-' + [guid]::NewGuid().ToString('N'))
New-Item -ItemType Directory -Force -Path $work | Out-Null
try {
    Invoke-WebRequest -Uri 'https://github.com/ryanoasis/nerd-fonts/releases/latest/download/IosevkaTerm.zip' -OutFile (Join-Path $work 'f.zip') -UseBasicParsing
    Expand-Archive -Path (Join-Path $work 'f.zip') -DestinationPath $work -Force
    $ttfs = Get-ChildItem -Path $work -Recurse -Filter '*Mono*.ttf'
    if (-not $ttfs) { throw 'No Mono .ttf files in the IosevkaTerm archive' }
    foreach ($ttf in $ttfs) {
        Copy-Item -Path $ttf.FullName -Destination (Join-Path $sysDir $ttf.Name) -Force
        New-ItemProperty -Path $reg -Name ($ttf.BaseName + ' (TrueType)') -Value $ttf.Name -PropertyType String -Force | Out-Null
    }
} finally { Remove-Item -Recurse -Force $work -ErrorAction SilentlyContinue }
'@
    $elev = Join-Path $env:TEMP ('install-iosevka-' + [guid]::NewGuid().ToString('N') + '.ps1')
    Set-Content -Path $elev -Value $elevContent -Encoding ASCII
    try {
        Write-Host "Installing IosevkaTerm Nerd Font system-wide (approve the UAC prompt)..."
        Start-Process powershell -Verb RunAs -Wait -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-File',$elev
        Write-Host "Installed system-wide. Restart VS Code to pick it up."
    } finally { Remove-Item -Force $elev -ErrorAction SilentlyContinue }
} else {
    Write-Host "IosevkaTerm Nerd Font already installed system-wide."
}

# --- 2. Point VS Code's integrated terminal at it (per-user; no admin) ----------
# Remote-SSH renders the terminal locally, so this must live in the Windows-local settings.
$settings = Join-Path $env:APPDATA 'Code\User\settings.json'
$raw = if (Test-Path $settings) { Get-Content -Raw -Path $settings } else { '' }
if (-not [string]::IsNullOrWhiteSpace($raw)) {
    try {
        $json = $raw | ConvertFrom-Json -ErrorAction Stop
    } catch {
        Write-Warning "VS Code settings.json isn't plain JSON (comments?). Add this line yourself: `"terminal.integrated.fontFamily`": `"$vscodeFamily`""
        $json = $null
    }
    if ($null -ne $json -and $json.'terminal.integrated.fontFamily' -ne $vscodeFamily) {
        $json | Add-Member -NotePropertyName 'terminal.integrated.fontFamily' -NotePropertyValue $vscodeFamily -Force
        ($json | ConvertTo-Json -Depth 100) | Set-Content -Path $settings -Encoding UTF8
        Write-Host "Set VS Code terminal font to $vscodeFamily."
    }
} else {
    New-Item -ItemType Directory -Force -Path (Split-Path $settings) | Out-Null
    "{`n  `"terminal.integrated.fontFamily`": `"$vscodeFamily`"`n}" | Set-Content -Path $settings -Encoding UTF8
    Write-Host "Created VS Code settings.json with terminal font $vscodeFamily."
}
{{- end -}}

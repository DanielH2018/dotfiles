-- WezTerm configuration — WINDOWS ONLY (chezmoi ignores this on non-Windows).
-- Mirrors the Ghostty config used on macOS/Linux (~/.config/ghostty/config) as closely
-- as WezTerm's Lua allows: same font, Catppuccin Mocha, padding, cursor, scrollback, and
-- the shift+enter -> newline binding for Claude Code. Keep the two in sync by hand.

local wezterm = require("wezterm")
local act = wezterm.action
local config = wezterm.config_builder()

-- ---------------------------------------------------------------------------
-- FONT  (shared values from .chezmoidata/terminal.toml — keeps Ghostty + WezTerm in sync).
-- Windows registers the Mono family as "IosevkaTerm NFM", so list the full name first and
-- the abbreviation as a fallback.
-- ---------------------------------------------------------------------------
config.font = wezterm.font_with_fallback({
	{ family = "{{ .terminal.font_family }}", weight = "{{ .terminal.font_weight }}" },
	{ family = "IosevkaTerm NFM", weight = "{{ .terminal.font_weight }}" },
})
config.font_size = {{ .terminal.font_size }}.0
config.harfbuzz_features = { {{ range $i, $f := .terminal.font_features }}{{ if $i }}, {{ end }}"{{ $f }}=1"{{ end }} }
-- Don't pop a toast when a glyph falls back to another font (Nerd Font symbols,
-- Claude's spinner braille, the wezview status icons). Fallback renders fine.
config.warn_about_missing_glyphs = false

-- ---------------------------------------------------------------------------
-- THEME  (Ghostty: theme = "Catppuccin Mocha") — built into WezTerm.
-- ---------------------------------------------------------------------------
config.color_scheme = "{{ .terminal.theme }}"

-- ---------------------------------------------------------------------------
-- CURSOR  (Ghostty: block, blink, cursor-color #fabd2f) — colors merge over the scheme.
-- ---------------------------------------------------------------------------
config.default_cursor_style = "BlinkingBlock"
config.cursor_blink_rate = 500
config.colors = {
	cursor_bg = "{{ .terminal.cursor_color }}",
	cursor_border = "{{ .terminal.cursor_color }}",
	cursor_fg = "{{ .terminal.cursor_fg }}",
}

-- ---------------------------------------------------------------------------
-- WINDOW / BEHAVIOR  (Ghostty: 120x24, padding 20, scrollback 100000, no close confirm)
-- ---------------------------------------------------------------------------
config.initial_cols = {{ .terminal.cols }}
config.initial_rows = {{ .terminal.rows }}
config.window_padding = { left = {{ .terminal.padding }}, right = {{ .terminal.padding }}, top = {{ .terminal.padding }}, bottom = {{ .terminal.padding }} }
config.window_background_opacity = 1.0
config.window_close_confirmation = "NeverPrompt"
config.scrollback_lines = {{ .terminal.scrollback }}
config.hide_mouse_cursor_when_typing = true
-- Bell OFF: the readline boundary bell (e.g. arrow past end-of-line) otherwise fires
-- Windows MessageBeep, which flashes the window when "visual notifications for sounds"
-- accessibility is on. Disable audible + zero-duration visual so nothing beeps or flashes.
config.audible_bell = "Disabled"
config.visual_bell = { fade_in_duration_ms = 0, fade_out_duration_ms = 0 }
-- Kitty graphics protocol is OFF by default in WezTerm; enable it for any
-- kitty-graphics tools. (The fastfetch banner itself uses the iterm2 protocol,
-- which WezTerm supports natively — see the fastfetch config.)
config.enable_kitty_graphics = true

-- ---------------------------------------------------------------------------
-- SHELL  — launch Git Bash (login + interactive), matching the Git-Bash-centric setup.
-- ---------------------------------------------------------------------------
config.default_prog = { "C:\\Program Files\\Git\\bin\\bash.exe", "-l", "-i" }

-- ---------------------------------------------------------------------------
-- KEYBINDINGS  — mirror ~/.config/ghostty/config. On macOS `cmd` is free of the
-- terminal's Ctrl codes; on Windows it isn't, so `cmd` -> CTRL+SHIFT, and a
-- Ghostty `cmd+shift` chord adds ALT (SHIFT is already spent standing in for
-- cmd). Copy / paste / reload keep the bare CTRL+SHIFT chord — that's the
-- Windows-terminal standard and matches the Ghostty letter anyway. Bracket keys
-- use `phys:` so holding Shift doesn't remap "[" to "{". Exceptions: split (cmd+d)
-- and close (cmd+w) map to BARE ctrl+d / ctrl+w so they match Ghostty's muscle
-- memory exactly — these override the shell's EOF / delete-word. Keep in sync with Ghostty.
-- ---------------------------------------------------------------------------
config.keys = {
	-- Claude Code multiline (ghostty: shift+enter=text:\n)
	{ key = "Enter", mods = "SHIFT", action = act.SendString("\n") },

	-- Config management (ghostty: cmd+shift+r)
	{ key = "R", mods = "CTRL|SHIFT", action = act.ReloadConfiguration },

	-- Clipboard (ghostty: cmd+shift+c / cmd+shift+v)
	{ key = "C", mods = "CTRL|SHIFT", action = act.CopyTo("Clipboard") },
	{ key = "V", mods = "CTRL|SHIFT", action = act.PasteFrom("Clipboard") },

	-- Tabs & windows (ghostty: cmd+t / cmd+w / cmd+shift+t / cmd+shift+w)
	-- new-tab (cmd+t) and close (cmd+w) map to BARE ctrl+t / ctrl+w to match Ghostty
	-- muscle memory. Those eat readline's transpose-chars / delete-previous-word —
	-- accepted tradeoff. Lowercase `key`: an uppercase letter implies Shift and would
	-- only fire on the ctrl+shift chord.
	{ key = "t", mods = "CTRL",       action = act.SpawnTab("CurrentPaneDomain") },
	-- Smart close: in an fzf pane (the wezview picker) send ESC so fzf aborts and the
	-- tab tears down via a normal process exit — a CloseCurrentPane force-close hangs
	-- while the homelab mux is connected (it round-trips to the remote mux). Everywhere
	-- else, close the pane as usual.
	{ key = "w", mods = "CTRL", action = wezterm.action_callback(function(window, pane)
		local proc = pane:get_foreground_process_name() or ""
		-- wezview stamps its pane with a `wezview` user var (OSC 1337); prefer that
		-- since Windows doesn't reliably report the fzf process name. Fall back to it.
		local is_picker = pane:get_user_vars()["wezview"] ~= nil or proc:lower():find("fzf")
		if is_picker then
			window:perform_action(act.SendKey({ key = "Escape" }), pane)
		else
			window:perform_action(act.CloseCurrentPane({ confirm = false }), pane)
		end
	end) },
	{ key = "T", mods = "CTRL|SHIFT", action = act.SpawnWindow },
	{ key = "W", mods = "CTRL|SHIFT", action = act.QuitApplication },

	-- Splits (ghostty: cmd+d right / cmd+shift+d down). cmd+d maps to a BARE ctrl+d to
	-- match Ghostty. That eats the shell's EOF (exit) on ctrl+d — IGNOREEOF in
	-- ~/.config/shell/common.sh guards accidental exits in panes WezTerm doesn't intercept.
	-- Lowercase `key="d"` for the bare chord; `key="D"` (implies Shift) for the down-split.
	{ key = "d", mods = "CTRL",           action = act.SplitHorizontal({ domain = "CurrentPaneDomain" }) },
	{ key = "D", mods = "CTRL|SHIFT",     action = act.SplitVertical({ domain = "CurrentPaneDomain" }) },

	-- Navigate splits (ghostty: cmd+[ previous / cmd+] next)
	{ key = "phys:LeftBracket",  mods = "CTRL|SHIFT", action = act.ActivatePaneDirection("Prev") },
	{ key = "phys:RightBracket", mods = "CTRL|SHIFT", action = act.ActivatePaneDirection("Next") },

	-- Resize splits (ghostty: cmd+shift+[ left / cmd+shift+] right)
	{ key = "phys:LeftBracket",  mods = "CTRL|SHIFT|ALT", action = act.AdjustPaneSize({ "Left", 10 }) },
	{ key = "phys:RightBracket", mods = "CTRL|SHIFT|ALT", action = act.AdjustPaneSize({ "Right", 10 }) },

	-- --- WezTerm extras (no Ghostty equivalent) ---
	-- Agent View switcher (wezview): full-color fzf picker in a local tab. Dismiss with
	-- ESC (clean exit) — it also closes itself after a jump. NOTE: CTRL+W force-close
	-- hangs while the homelab mux is connected (a WezTerm mux limitation, not wezview).
	-- `--noprofile --norc`: skip the login-shell profile (~400ms of ble.sh/tool
	-- inits wezview doesn't need). bash.exe auto-adds /usr/bin + /mingw64/bin, and
	-- jq/wezterm/fzf/wezview all live on the Windows PATH — so bare bash still finds
	-- every tool. Halves the picker's bring-up time.
	{ key = "S", mods = "CTRL|SHIFT", action = act.SpawnCommandInNewTab({
		domain = { DomainName = "local" },
		args = { "C:\\Program Files\\Git\\bin\\bash.exe", "--noprofile", "--norc", "-c", "wezview" },
	}) },
	-- Spawn a tab on the homelab (daniel-server) via the persistent mux domain
	{ key = "H", mods = "CTRL|SHIFT", action = act.SpawnTab({ DomainName = "daniel-server" }) },
	-- Local Git Bash tab (pins the built-in local domain for a Windows shell).
	{ key = "B", mods = "CTRL|SHIFT", action = act.SpawnTab({ DomainName = "local" }) },
}

-- Jump straight to tab 1-9 (CTRL+<n>). No Ghostty equivalent — standard terminal
-- convention. ActivateTab is 0-indexed, so CTRL+1 -> tab 0.
for i = 1, 9 do
	table.insert(config.keys, { key = tostring(i), mods = "CTRL", action = act.ActivateTab(i - 1) })
end

-- ---------------------------------------------------------------------------
-- SERVER NODES — remote homelab machines to expose as persistent WezTerm mux
-- domains, in preference order. WezTerm connects to the first reachable one as
-- the default domain (see DEFAULT DOMAIN below). Add a node by appending here —
-- its mux domain, reachability probe, and default selection are all derived from
-- this table. remote_address = a Host alias in ~/.ssh/config (WezTerm inherits
-- HostName/User/IdentityFile from it, key: ~/.ssh/daniel-server); username = the
-- remote login user.
-- ---------------------------------------------------------------------------
local server_nodes = {
	{ name = "daniel-server", remote_address = "daniel-server", username = "ubuntu" },
	-- { name = "node2", remote_address = "node2", username = "ubuntu" },
}

-- ---------------------------------------------------------------------------
-- MULTIPLEXING — each node becomes a persistent WezTerm mux domain.
-- multiplexing="WezTerm" runs a wezterm-mux-server on the node, so remote tabs
-- survive the GUI client quitting and are restored on reconnect. Requires
-- wezterm installed on the node. CTRL+SHIFT+H spawns a daniel-server tab.
-- ---------------------------------------------------------------------------
config.ssh_domains = {}
for _, node in ipairs(server_nodes) do
	table.insert(config.ssh_domains, {
		name = node.name,
		remote_address = node.remote_address,
		username = node.username,
		multiplexing = "WezTerm",
	})
end

-- ---------------------------------------------------------------------------
-- DEFAULT DOMAIN — deliberately LEFT LOCAL. Making a remote WezTerm mux domain the
-- default made WezTerm's pane close (CTRL+W / CloseCurrentPane) hang the entire GUI
-- until force-quit: closing a pane in a mux-backed window round-trips to the mux
-- server synchronously, and over the WireGuard link that blocks the GUI thread. It
-- hit EVERY local tab in the homelab-default window, not just the wezview picker.
-- So we boot into a local shell and reach the homelab on demand via CTRL+SHIFT+H
-- (it opens as its own mux window). The CTRL+SHIFT+S picker still aggregates PC +
-- homelab sessions, so nothing is lost but the auto-connect. The ssh_domains above
-- stay defined so CTRL+SHIFT+H / the picker's remote jump keep working.
-- ---------------------------------------------------------------------------

-- ---------------------------------------------------------------------------
-- RELOAD FEEDBACK — WezTerm reloads config silently (on CTRL+SHIFT+R and on save
-- via automatic_reload). With no confirmation the reload key feels like a no-op,
-- so surface a short toast on every reload. Fires for auto-reloads too.
-- ---------------------------------------------------------------------------
wezterm.on("window-config-reloaded", function(window)
	window:toast_notification("WezTerm", "Configuration reloaded ✳", nil, 1500)
end)

return config

[user]
	name = DanielH2018
	email = danielh.2018@gmail.com
{{- if eq .chezmoi.os "darwin" }}
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDA7LulgtoUwepzoMDD4UgAS1OD09qi4WvvJnDOUNkou
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
[commit]
	gpgsign = true
[core]
	excludesfile = ~/.gitignore_global
	autocrlf = input
{{- else }}
{{- if eq .chezmoi.os "windows" }}
[credential]
	helper = manager
{{- else if contains "microsoft" (lower .chezmoi.kernel.osrelease) }}
# GitHub goes through gh, NOT the Windows Git Credential Manager: launching a .exe from WSL
# takes the VM-mode interop path, which leaks a permanently spinning CPU thread per call once
# the owning wsl.exe has exited (microsoft/WSL#41173, unfixed through WSL 2.9.4), and every
# HTTPS push and fetch would pay it. gh is a native Linux binary and already authenticated.
# This section must precede the generic [credential] below -- git tries helpers in config
# order, so a generic-first layout would hand github.com back to the .exe. Gated on gh being
# present: file targets apply before install-cli-tools provides it, so a fresh machine falls
# back to the manager for one apply, then self-heals on the next.
[credential "https://github.com"]
	helper = {{ if lookPath "gh" }}!gh auth git-credential{{ else }}/mnt/c/Program\\ Files/Git/mingw64/bin/git-credential-manager.exe{{ end }}
[credential]
	# Non-GitHub hosts keep the manager -- gh only answers for hosts it is logged in to, and
	# dropping this would leave them with no helper at all.
	helper = /mnt/c/Program\\ Files/Git/mingw64/bin/git-credential-manager.exe
{{- else }}
[credential]
	helper = store
{{- end }}
[core]
	autocrlf = {{ if eq .chezmoi.os "windows" }}true{{ else }}input{{ end }}
	excludesfile = ~/.gitignore_global
	pager = less
{{- if stat (printf "%s/.ssh/id_ed25519" .chezmoi.homeDir) }}
[user]
	signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
[commit]
	gpgsign = true
{{- end }}
{{- end }}
[pull]
	rebase = true
[push]
	autoSetupRemote = true
{{- if ne .chezmoi.os "darwin" }}
	default = simple
	followTags = true
{{- end }}
[fetch]
	prune = true
{{- if ne .chezmoi.os "darwin" }}
	pruneTags = true
	all = true
{{- end }}
[branch]
	sort = -committerdate
[rerere]
	enabled = true
{{- if ne .chezmoi.os "darwin" }}
	autoupdate = true
{{- end }}
[diff]
	colorMoved = {{ if eq .chezmoi.os "darwin" }}zebra{{ else }}plain{{ end }}
{{- if ne .chezmoi.os "darwin" }}
	algorithm = histogram
	mnemonicPrefix = true
	renames = true
	submodule = log
{{- if lookPath "sops" }}
[diff "sops"]
	# Renders SOPS-encrypted files (e.g. the homelab's ansible/vars/secrets.yml,
	# tagged `diff=sops` in its .gitattributes) as their decrypted plaintext in
	# `git diff`. Needs a local age key; safe no-op on files git can't decrypt. Gated on
	# `sops` being installed so a machine without it doesn't error on every diff=sops diff.
	textconv = sops decrypt
{{- end }}
{{- end }}
[merge]
	conflictstyle = {{ if eq .chezmoi.os "darwin" }}zdiff3{{ else }}diff3{{ end }}
[init]
	defaultBranch = main
{{- if ne .chezmoi.os "darwin" }}
[commit]
	verbose = true
[tag]
	sort = version:refname
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[column]
	ui = auto
[status]
	submoduleSummary = true
[submodule]
	recurse = true
[log]
	decorate = true
	abbrevCommit = true
[help]
	autocorrect = prompt
[alias]
	lg = log --oneline --graph --decorate --all
	lga = log --oneline --graph --decorate --all --date=relative
	lgb = log --oneline --graph --decorate --all --date=relative --branches
	lgc = log --oneline --graph --decorate --all --date=relative --branches --tags
[color]
	ui = auto
{{- end }}
[include]
	path = ~/.config/git/local.config

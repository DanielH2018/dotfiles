{{- if eq .chezmoi.os "windows" -}}
# Managed by chezmoi (run_onchange). Installs the curated GUI/app list from
# .chezmoidata/packages.toml via winget so a fresh PC matches Computer Specs.md.
# Idempotent: skips anything winget already reports installed. Re-runs only when this
# file OR the rendered package list below changes (add a line to packages.toml → reinstall
# on next apply).
#
# The dev CLI toolchain is installed separately by run_onchange_install-cli-tools.ps1.tmpl.
# Games themselves are not managed here (winget installs launchers only). Apps winget can't
# provide are in the manual checklist (WINDOWS-SETUP.md).
# bump-to-reinstall: apps v1

{{ includeTemplate "winget-install.ps1" . }}
# Package ids rendered from .chezmoidata/packages.toml. Newlines separate array elements
# in a PowerShell @(...) literal, so no commas are needed. Entries without a `winget` field are
# Linux-only (OpenRGB, Solaar, Piper, Ghostty) and skipped here.
# `get` (not .winget) because Linux-only entries omit the field entirely, and a bare .winget on a
# map without that key is a template error rather than an empty string.
$packages = @(
{{- range concat .apps.base .apps.coding .apps.gaming }}{{ with get . "winget" }}
    '{{ . }}'
{{- end }}{{ end }}
)

foreach ($id in $packages) { Install-WingetPackage $id }

Write-Host "App install pass done. See WINDOWS-SETUP.md for the manual checklist (drivers, Office, game libraries, sign-ins)."
{{- end -}}

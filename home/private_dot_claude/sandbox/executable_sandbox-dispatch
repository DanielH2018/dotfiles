#!/usr/bin/env bash
# sandbox-dispatch: the ONLY sandbox entrypoint a read-only orchestrator may call.
#
# It locks the invocation shape so the orchestrator cannot weaken the sandbox — no
# --shell, --no-repos, extra bind mounts, or arbitrary flags can be injected. Every
# input is a single fixed positional arg, so even a prompt containing flag-like text
# reaches claude-sandbox only as the --exec payload, never as its own flag.
#
# Usage:
#   sandbox-dispatch <repo-path> <worktree-name> <prompt>   # worktree mode (branch claude/<name>)
#   sandbox-dispatch -b <branch> <repo-path> <prompt>       # existing-branch mode
set -euo pipefail

die() { echo "sandbox-dispatch: $*" >&2; exit 2; }

MODE=worktree
BRANCH=""
if [[ "${1:-}" == "-b" || "${1:-}" == "--branch" ]]; then
  MODE=branch
  shift
  [[ $# -eq 3 ]] || die "usage: sandbox-dispatch -b <branch> <repo-path> <prompt>"
  BRANCH="$1"; REPO="$2"; PROMPT="$3"
  [[ "$BRANCH" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] || die "branch must match [A-Za-z0-9][A-Za-z0-9._/-]* (no leading '-')"
else
  [[ $# -eq 3 ]] || die "usage: sandbox-dispatch <repo-path> <worktree-name> <prompt>"
  REPO="$1"; WT="$2"; PROMPT="$3"
  [[ "$WT" =~ ^[A-Za-z0-9_][A-Za-z0-9_-]*$ ]] || die "worktree name must match [A-Za-z0-9_][A-Za-z0-9_-]* (no leading '-')"
fi

[[ -n "$REPO" && "$REPO" != -* ]]     || die "invalid repo-path"
[[ -n "$PROMPT" && "$PROMPT" != -* ]] || die "prompt must be non-empty and not start with '-'"
[[ -d "$REPO/.git" || -f "$REPO/.git" ]] || die "not a git repository: $REPO"

if [[ "$MODE" == branch ]]; then
  exec claude-sandbox --branch "$BRANCH" --exec "$PROMPT" "$REPO"
else
  exec claude-sandbox --worktree "$WT" --exec "$PROMPT" "$REPO"
fi

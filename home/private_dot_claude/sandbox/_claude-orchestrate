#compdef claude-orchestrate

# Zsh completion for claude-orchestrate — mirrors the relevant subset of _claude-sandbox
# (worktree, branch, fresh, repo path). Worktree/branch names are delegated to
# claude-sandbox's --complete-* endpoints so the two stay in sync.
# Source: ~/.claude/sandbox/_claude-orchestrate
# Setup: ensure ~/.claude/sandbox is in fpath (before compinit)

_claude-orchestrate_repo_path() {
  local repo_path=""
  local -a words_copy=("${words[@]}")
  for ((i = 2; i <= ${#words_copy}; i++)); do
    local w="${words_copy[$i]}"
    [[ "$w" == -* ]] && continue
    [[ "$w" == "$words[$CURRENT]" ]] && continue
    local prev="${words_copy[$((i-1))]}"
    [[ "$prev" == "-w" || "$prev" == "--worktree" || "$prev" == "-b" || "$prev" == "--branch" ]] && continue
    repo_path="$w"
  done
  [[ -z "$repo_path" ]] && repo_path="."
  echo "$repo_path"
}

_claude-orchestrate() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-w --worktree -b --branch)'{-w,--worktree}'[Implementers work in worktree claude/NAME]:worktree name:->worktree' \
    '(-b --branch -w --worktree)'{-b,--branch}'[Implementers work on an existing branch]:branch:->branch' \
    '(--fresh --new)'{--fresh,--new}'[Start a new orchestrator session (default: resume)]' \
    '(-h --help)'{-h,--help}'[Show usage]' \
    '*:repo path:->repo' \
    && return

  case "$state" in
    worktree)
      local -a wt
      wt=(${(f)"$(claude-sandbox --complete-worktrees "$(_claude-orchestrate_repo_path)" 2>/dev/null)"})
      if [[ ${#wt} -gt 0 ]]; then
        _describe 'worktree name' wt
      else
        _message 'worktree name (new or existing)'
      fi
      ;;
    branch)
      local -a br
      br=(${(f)"$(claude-sandbox --complete-branches "$(_claude-orchestrate_repo_path)" 2>/dev/null)"})
      if [[ ${#br} -gt 0 ]]; then
        _describe 'branch' br
      else
        _message 'existing branch name'
      fi
      ;;
    repo)
      local -a repos
      if [[ -d "$HOME/Repositories" ]]; then
        repos=(${(f)"$(ls -1 "$HOME/Repositories" 2>/dev/null)"})
      fi
      if [[ ${#repos} -gt 0 ]]; then
        _alternative \
          "repos:repository:compadd -a repos" \
          "files:path:_files -/"
      else
        _files -/
      fi
      ;;
  esac
}

_claude-orchestrate "$@"

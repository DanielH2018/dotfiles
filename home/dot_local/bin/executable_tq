def splice_prek(text, digest_text):
    """Swap the pytest hook's indented output dump for the digest. Every other
    hook's status line and failure block passes through verbatim — losing one
    behind the splice would be the prek-shaped version of a false pass."""
    lines = text.splitlines()
    if not any(HOOK_ID.match(ln) for ln in lines):
        return text, False  # not a prek layout we recognise: never guess
    out, i, replaced = [], 0, False
    while i < len(lines):
        matched = HOOK_ID.match(lines[i])
        out.append(lines[i])
        i += 1
        if not matched or matched.group("id") != PYTEST_HOOK_ID:
            continue
        while i < len(lines) and lines[i].startswith("- "):
            out.append(lines[i])
            i += 1
        start = i
        while i < len(lines) and (not lines[i].strip() or lines[i].startswith("  ")):
            i += 1
        if i > start:
            out.append("")  # prek puts a blank line before a hook's output
            out.extend(f"  {ln}" if ln else "" for ln in digest_text.splitlines())
            replaced = True
    return "\n".join(out), replaced


def raw_tail(proc):
    """Last of whatever the runner actually said, for when nothing parsed."""
    text = ((proc.stderr or "") + (proc.stdout or "")).strip()
    return text[-RAW_TAIL:] if len(text) > RAW_TAIL else text


def tee_raw(proc, json_path):
    """The runner's own bytes, kept beside the json when the run went wrong.

    The json is what an adapter made of the output, and an adapter can be wrong
    in ways no digest can show: a miscounted total looks exactly like a correct
    one. On a run that failed, the unparsed original is the only thing that can
    settle which of the two happened, and it goes when tq exits.
    """
    text = (proc.stdout or "") + (proc.stderr or "")
    if not text.strip():
        return ""
    path = f"{json_path}.raw"
    try:
        with open(path, "w", encoding="utf-8", errors="replace") as handle:
            handle.write(text)
    except OSError:
        return ""  # the digest is still worth printing without it
    return path


def json_target():
    override = os.environ.get("TQ_JSON")
    if override:
        return override
    handle, path = tempfile.mkstemp(prefix="tq-", suffix=".json")
    os.close(handle)
    return path


def run_ingested(argv, workdir, tmp, fmt):
    """Any command at all, as long as its stdout speaks a format tq reads.

    The escape hatch from tq's fixed list of runners: a linter tq has never
    heard of still gets digested, and one it cannot be taught still runs.
    """
    proc, timed_out = run(argv, plain_env())
    result = Result(
        runner=os.path.basename(argv[0]),
        kind="lint",
        cmd=shlex.join(argv),
        cwd=workdir,
        exit=proc.returncode,
        timed_out=timed_out,
    )
    INGESTORS[fmt](proc.stdout, result)
    finish_lint(result, proc)
    return result, proc


# Flags that choose how git renders a diff or a log. Dropped rather than merged
# with tq's own: git resolves a repeated format flag by position for some of
# these and by precedence for others, so a digest that let both stand would
# change shape when the user reordered their command.
DIFF_FORMATS = (
    "--stat",
    "--numstat",
    "--shortstat",
    "--dirstat",
    "--compact-summary",
    "--name-only",
    "--name-status",
    "--summary",
    "--raw",
    "--color",
    "-p",
    "--patch",
    "-u",
)
LOG_FORMATS = DIFF_FORMATS + (
    "--oneline",
    "--graph",
    "--pretty",
    "--format",
    "--abbrev-commit",
)
# Sentinel-led so the numstat rows that follow a commit can be told from it.
COMMIT_FORMAT = "--pretty=format:%x1e%H%x1f%an%x1f%aI%x1f%s"
# git log flags that ask for per-file detail. tq adds --numstat only when one of
# them was given: a 500-commit log is fast until it has to diff every commit.
LOG_WANTS_FILES = (
    "--stat",
    "--numstat",
    "--name-only",
    "--name-status",
    "-p",
    "--patch",
)
BARE_COUNT = re.compile(r"^-(\d+)$")


def drop_switches(argv, flags):
    """argv without the valueless format flags tq is about to replace.

    Everything from `--` onward is kept whatever it spells: past that separator
    a token is a path, and a file genuinely named --stat is still a file.
    """
    out = []
    for i, tok in enumerate(argv):
        if tok == "--":
            out.extend(argv[i:])
            break
        if tok in flags or any(tok.startswith(f"{flag}=") for flag in flags):
            continue
        out.append(tok)
    return out


def inject(argv, flags, after=1):
    """argv with the flags tq needs spliced in ahead of the operands.

    Appending them is what reads naturally and is wrong everywhere it matters.
    Past a `--` every token is a path, so `git log -- src` would grow a pathspec
    spelled --pretty=format:… , match nothing and report no commits; git rejects
    options after operands even with no separator in sight; and a `--print0`
    trailing `fd pat dir` is a second directory to search.
    """
    return list(argv[:after]) + list(flags) + list(argv[after:])


def git_inject(argv, flags):
    """inject(), landing past git's own options and the subcommand."""
    i = detect_mod.git_subcommand_index(argv)
    return inject(argv, flags, after=i + 1 if i >= 0 else 1)


def count_limit(argv, names, bare=False):
    """The cap a command put on its own output, as (number, how it was spelled).

    Only the flags that stop the search early. -maxdepth and a pathspec narrow
    what is being asked about, which is the question rather than a limit on the
    answer; -n stops a complete answer part-way through.
    """
    for i, tok in enumerate(argv):
        if bare and BARE_COUNT.match(tok):
            return int(BARE_COUNT.match(tok).group(1)), tok
        for name in names:
            if tok == name and i + 1 < len(argv) and argv[i + 1].isdigit():
                return int(argv[i + 1]), f"{name} {argv[i + 1]}"
            value = tok[len(name) + 1 :] if tok.startswith(f"{name}=") else ""
            if value.isdigit():
                return int(value), tok
            short = tok[len(name) :] if len(name) == 2 and tok.startswith(name) else ""
            if short.isdigit():
                return int(short), tok
    return None, ""


def note_limit(result, limit, spelling):
    """Record the cap only when the command actually ran into it. `git log -n 50`
    that found 12 commits was not limited by anything — there were 12."""
    if limit is not None and len(result.items) >= limit:
        result.limited = spelling


def survey(runner, kind, argv, workdir, proc, timed_out):
    return Result(
        runner=runner,
        kind=kind,
        cmd=shlex.join(argv),
        cwd=workdir,
        exit=proc.returncode,
        timed_out=timed_out,
    )


def finish_survey(result, proc):
    """Whatever the command said on stderr, when it is not already the answer.

    find writes one "Permission denied" per unreadable directory and keeps
    going, which is exactly the case where the count is short and nothing in
    stdout says so.
    """
    note = (proc.stderr or "").strip()
    if note:
        result.notes.append(note)


def run_find(argv, workdir, tmp):
    cmd = list(argv)
    if not any(tok in detect_mod.FIND_OPERATORS for tok in argv):
        # Only where appending cannot change which paths come back. With an -o
        # in the expression `-print0` binds to the last branch alone, so the
        # command is left as it stands and the output split on newlines.
        cmd = ["-print0" if tok == "-print" else tok for tok in cmd]
        if "-print0" not in cmd:
            cmd.append("-print0")
    proc, timed_out = run(cmd, plain_env())
    result = survey("find", "paths", argv, workdir, proc, timed_out)
    survey_adapter.parse_paths(proc.stdout, result)
    finish_survey(result, proc)
    return result, proc


def run_fd(argv, workdir, tmp):
    cmd = list(argv)
    if not any(tok in ("-0", "--print0") for tok in cmd):
        cmd = inject(cmd, ["--print0"])
    proc, timed_out = run(cmd, plain_env())
    result = survey("fd", "paths", argv, workdir, proc, timed_out)
    survey_adapter.parse_paths(proc.stdout, result)
    limit, spelling = count_limit(argv, ("--max-results",))
    note_limit(result, limit, spelling)
    finish_survey(result, proc)
    return result, proc


def run_ls(argv, workdir, tmp):
    proc, timed_out = run(inject(argv, ["-1"]), plain_env())
    result = survey("ls", "paths", argv, workdir, proc, timed_out)
    survey_adapter.parse_ls_r(proc.stdout, result)
    finish_survey(result, proc)
    return result, proc


def run_rg_files(argv, workdir, tmp):
    proc, timed_out = run(inject(argv, ["--null"]), plain_env())
    result = survey("rg", "paths", argv, workdir, proc, timed_out)
    survey_adapter.parse_paths(proc.stdout, result)
    finish_survey(result, proc)
    return result, proc


def run_rg(argv, workdir, tmp):
    proc, timed_out = run(inject(argv, ["--json"]), plain_env())
    result = survey("rg", "matches", argv, workdir, proc, timed_out)
    survey_adapter.parse_rg_json(proc.stdout, result)
    limit, spelling = count_limit(argv, ("--max-count", "-m"))
    note_limit(result, limit, spelling)
    finish_survey(result, proc)
    return result, proc


def run_grep(argv, workdir, tmp):
    proc, timed_out = run(inject(argv, ["--null", "-H", "-n"]), plain_env())
    result = survey("grep", "matches", argv, workdir, proc, timed_out)
    survey_adapter.parse_grep(proc.stdout, result)
    limit, spelling = count_limit(argv, ("--max-count", "-m"))
    note_limit(result, limit, spelling)
    finish_survey(result, proc)
    return result, proc


def git_env():
    env = plain_env()
    # A pager attached to a captured pipe is not a risk git takes, but a
    # configured one that ignores isatty is, and it would hang the run.
    env["GIT_PAGER"] = "cat"
    return env


def run_git_diff(argv, workdir, tmp):
    cmd = git_inject(
        drop_switches(argv, DIFF_FORMATS), ["--numstat", "-z", "--no-color"]
    )
    proc, timed_out = run(cmd, git_env())
    result = survey("git diff", "diff", argv, workdir, proc, timed_out)
    survey_adapter.parse_numstat(proc.stdout, result)
    finish_survey(result, proc)
    return result, proc


def run_git_ls_files(argv, workdir, tmp):
    proc, timed_out = run(git_inject(argv, ["-z"]), git_env())
    result = survey("git ls-files", "paths", argv, workdir, proc, timed_out)
    survey_adapter.parse_paths(proc.stdout, result)
    finish_survey(result, proc)
    return result, proc


def run_git_log(argv, workdir, tmp):
    flags = [COMMIT_FORMAT, "--no-color"]
    if any(tok in argv for tok in LOG_WANTS_FILES):
        flags.append("--numstat")
    cmd = git_inject(drop_switches(argv, LOG_FORMATS), flags)
    proc, timed_out = run(cmd, git_env())
    result = survey("git log", "commits", argv, workdir, proc, timed_out)
    survey_adapter.parse_commits(proc.stdout, result)
    limit, spelling = count_limit(argv, ("--max-count", "-n"), bare=True)
    note_limit(result, limit, spelling)
    finish_survey(result, proc)
    return result, proc


RUNNERS = {
    "node": run_node,
    "pytest": run_pytest,
    "prek": run_prek,
    "ruff": run_ruff,
    "mypy": run_mypy,
    "eslint": run_eslint,
    "tsc": run_tsc,
    "shellcheck": run_shellcheck,
    "go-vet": run_go_vet,
    "go-test": run_go_test,
    "cargo-clippy": run_cargo_clippy,
    "cargo-test": run_cargo_test,
    "find": run_find,
    "fd": run_fd,
    "ls": run_ls,
    "rg": run_rg,
    "rg-files": run_rg_files,
    "grep": run_grep,
    "git-diff": run_git_diff,
    "git-log": run_git_log,
    "git-ls-files": run_git_ls_files,
}

INGESTORS = {
    "rdjson": rdjson_adapter.parse,
    "ruff-json": lint_adapter.parse_ruff,
    "sarif": sarif_adapter.parse,
    "shellcheck-json1": lint_adapter.parse_shellcheck,
}

TQ_FLAGS = ("--scope", "--diff-base", "--ingest", "--flaky-result")
# Flags that take no value. Kept apart because treating one as if it did would
# swallow the program name — `tq --retry node --test` would run `--test`.
TQ_SWITCHES = ("--retry",)

# Runners that can name their own failures exactly, which is the only basis on
# which tq is willing to rerun a subset.
RETRYABLE = ("node", "pytest")
# Past this many failures a rerun is not testing for flakiness, it is paying
# for a second full run to confirm the code is broken.
RETRY_MAX_FAILURES = int(os.environ.get("TQ_RETRY_MAX_FAILURES") or 10)


def failure_key(fail):
    return (fail.file, fail.name)


def attempt(kind, argv, workdir, tmp, state, last_failed=False):
    if kind == "node":
        return run_node(argv, workdir, tmp, rerun_state=state)
    if kind == "pytest":
        return run_pytest(argv, workdir, tmp, last_failed=last_failed)
    return RUNNERS[kind](argv, workdir, tmp)


def run_with_retry(kind, argv, workdir, tmp, retry):
    """Run, and when asked, give the failures one more chance at the runner.

    A test that fails and then passes without the code changing is telling you
    about itself, not about the change — and an agent that cannot tell the two
    apart spends an edit cycle "fixing" nondeterminism.
    """
    state = os.path.join(tmp, "rerun.json") if retry and kind == "node" else None
    result, proc = attempt(kind, argv, workdir, tmp, state)
    if not retry or kind not in RETRYABLE:
        return result, proc
    if not result.failures or result.timed_out:
        return result, proc
    if len(result.failures) > RETRY_MAX_FAILURES:
        result.notes.append(
            f"{len(result.failures)} failures is too many to be flakiness — not retried"
        )
        return result, proc

    again, _ = attempt(kind, argv, workdir, tmp, state, last_failed=True)
    if again.timed_out:
        result.notes.append("the retry timed out; first-attempt failures stand")
        return result, proc
    still_failing = {failure_key(f) for f in again.failures}
    for fail in result.failures:
        fail.flaky = failure_key(fail) not in still_failing
    result.attempts = 2
    return result, proc


def split_flags(argv):
    """tq's own flags, then the command it wraps.

    Parsing stops at the first token tq does not own, and everything from there
    is the runner's, passed on untouched — the passthrough guarantee is what
    makes tq safe to put in front of an arbitrary command, so it cannot start
    interpreting flags that appear after the program name.
    """
    opts, i = {}, 0
    while i < len(argv):
        name, sep, value = argv[i].partition("=")
        if name in TQ_SWITCHES:
            opts[name] = value or "1"
            i += 1
            continue
        if name not in TQ_FLAGS:
            break
        if sep:
            opts[name] = value
            i += 1
        elif i + 1 < len(argv):
            opts[name] = argv[i + 1]
            i += 2
        else:
            break  # a flag with no value is not tq's to guess at
    return opts, argv[i:]


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    opts, argv = split_flags(argv)
    mode = opts.get("--scope") or os.environ.get("TQ_SCOPE") or "all"
    base = opts.get("--diff-base") or os.environ.get("TQ_DIFF_BASE") or "HEAD"
    if mode not in scope.MODES:
        sys.stderr.write(f"tq: --scope must be one of {', '.join(scope.MODES)}\n")
        return 2
    if not argv:
        sys.stderr.write("tq: no command given\n")
        return 2
    retry = "--retry" in opts or bool(os.environ.get("TQ_RETRY"))
    # Defaulting a flake to FAIL is the same rule as NO TESTS RAN: a run that
    # did not hold cannot be reported as one that did, and a test that needed
    # two goes did not hold.
    flaky_pass = opts.get("--flaky-result") == "pass"
    fmt = opts.get("--ingest")
    if fmt is not None and fmt not in INGESTORS:
        sys.stderr.write(f"tq: --ingest must be one of {', '.join(INGESTORS)}\n")
        return 2
    kind = "ingest" if fmt else detect(argv)
    if kind is None:
        try:
            os.execvp(argv[0], argv)
        except OSError as exc:
            sys.stderr.write(f"tq: cannot run {argv[0]}: {exc}\n")
            return 127

    workdir = os.getcwd()
    with tempfile.TemporaryDirectory(prefix="tq-") as tmp:
        started = time.monotonic()
        if kind == "ingest":
            result, proc = run_ingested(argv, workdir, tmp, fmt)
        else:
            result, proc = run_with_retry(kind, argv, workdir, tmp, retry)
        if flaky_pass and result.failures and all(f.flaky for f in result.failures):
            # Moved wholesale rather than just zeroing the exit: a FAIL verdict
            # beside a zero exit is a worse report than either alone.
            flaky = len(result.failures)
            result.totals["fail"] -= flaky
            result.totals["pass"] += flaky
            result.exit = 0
        result.duration_ms = result.duration_ms or int(
            (time.monotonic() - started) * 1000
        )
        path = json_target()
        # Narrow the digest, then hand the json the full set back. A finding
        # outside the diff is still a true finding; it just is not what this
        # change is answerable for, and the record has to keep both facts.
        everything = list(result.failures)
        result.truncated["out_of_scope"] = scope.apply_scope(
            result, mode, workdir, base
        )
        text = digest(result, path)
        result.failures = everything
        result.write(path)

    # Surveys are exempt for the same reason they are exempt below: a grep that
    # matched nothing exits 1 and is not a run that went wrong.
    raw_path = ""
    if result.kind not in SURVEY_KINDS and (result.exit != 0 or result.failures):
        raw_path = tee_raw(proc, path)

    if kind == "prek":
        spliced, replaced = splice_prek(proc.stdout, text)
        sys.stdout.write(spliced.rstrip("\n") + "\n")
        if not replaced:
            sys.stdout.write(f"\n{text}\n")
    else:
        sys.stdout.write(text + "\n")
    if raw_path:
        sys.stdout.write(f"raw: {raw_path}\n")

    # A runner that died before reporting anything must never read as a pass.
    # A survey is exempt: it has no failures to be missing, a non-zero exit is
    # how grep reports "nothing matched", and the headline has already said what
    # the status means. Dumping the raw output here would undo the digest in the
    # one case — a sweep that found nothing — where it is cheapest to be right.
    if result.exit != 0 and not result.failures and result.kind not in SURVEY_KINDS:
        tail = raw_tail(proc)
        if tail:
            sys.stdout.write(f"\nno failures parsed — raw output follows:\n{tail}\n")
    if proc.stderr and kind == "prek":
        sys.stderr.write(proc.stderr)
    return result.exit


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

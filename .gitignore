# Ignore everything in ~ by default — dotfiles repo only tracks explicit files
*

# Shell config
!.zshrc
!.zshenv
!.zprofile
!.bash_profile

# tmux
!.tmux.conf

# Package manifest
!Brewfile


# Git config
!.gitconfig
!.gitignore
!.gitignore_global

# .config — un-ignore directory, re-ignore contents, then selectively allow
!.config/
.config/*

!.config/starship.toml

!.config/ghostty/
.config/ghostty/*
!.config/ghostty/config
!.config/ghostty/shaders/
!.config/ghostty/shaders/**

!.config/fastfetch/
.config/fastfetch/*
!.config/fastfetch/config.jsonc
!.config/fastfetch/logos/
!.config/fastfetch/logos/**

!.config/gh/
.config/gh/*
!.config/gh/config.yml

# Claude Code — un-ignore directory, then re-ignore contents, then un-ignore tracked items
!.claude/
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/keybindings.json
!.claude/statusline-command.sh
!.claude/commands/
!.claude/commands/*
!.claude/hooks/
!.claude/hooks/*
!.claude/rules/
!.claude/rules/*
!.claude/sandbox/
.claude/sandbox/*
!.claude/sandbox/Dockerfile.base
!.claude/sandbox/audit.sh
!.claude/sandbox/claude-sandbox
!.claude/sandbox/claude.json
!.claude/sandbox/compact-session.py
!.claude/sandbox/entrypoint.sh
!.claude/sandbox/settings.json
!.claude/sandbox/_claude-sandbox
!.claude/sandbox/.dockerignore
!.claude/sandbox/sandbox-CLAUDE.md
!.claude/sandbox/statusline-command.sh
!.claude/projects/
.claude/projects/*
!.claude/projects/-Users-daniel/
.claude/projects/-Users-daniel/*
!.claude/projects/-Users-daniel/memory/
!.claude/projects/-Users-daniel/memory/**

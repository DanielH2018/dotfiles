# Repo housekeeping (chezmoi state lives in ~/.config/chezmoi, not here)
.DS_Store
.claude/
*.swp
*.swo
.superpowers/

# This repo's own build artifacts. They were ignored only by ~/.gitignore_global, which is
# home/dot_gitignore_global — a file THIS repo deploys. That made the repo's cleanliness
# depend on having already applied it: on a fresh clone, before the first `chezmoi apply`,
# all of these show as untracked and a `git add -A` commits a virtualenv. Listed here so the
# repo is self-sufficient; the global copy stays, since it is right for every other repo too.
.venv/
.ruff_cache/
.pytest_cache/
__pycache__/
*.pyc

# Second layer: even if a *.local.* file lands in the source tree, never commit it.
**/*.local.json
**/*.local.md
**/*.local.zsh
**/*.local.env
**/local.config

# retention-sweep's lock file, if it ever lands directly in the source tree (a
# misconfigured RETENTION_LOCK or a relative path bug — 4e14f09 committed one at
# home/private_dot_claude/sweep.lock by accident). The script's real lock lives at
# $XDG_RUNTIME_DIR/retention-sweep.lock, never under home/. Matching deploy-time
# exclusion is in home/.chezmoiignore.
**/sweep.lock

# pr-dash's dependency tree (npm install, not chezmoi-managed content).
node_modules/

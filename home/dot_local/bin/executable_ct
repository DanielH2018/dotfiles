#!/usr/bin/env bash
# ct — launch Claude Code in its OWN named tmux session (one session per Claude), so
# the Agent View picker can attach to it from another machine via `tmux attach -t <name>`.
# Usage: ct [dir]   (dir defaults to $PWD; session name = sanitized basename)
# `new-session -A` attaches to an existing session of that name instead of duplicating,
# matching the "auto-resume per target" model.
set -u
dir="${1:-$PWD}"
case "$dir" in
  -h|--help) echo "usage: ct [dir]  (launch claude in a named tmux session)"; exit 0 ;;
esac
command -v tmux >/dev/null 2>&1 || { printf 'ct: tmux not found on PATH\n' >&2; exit 1; }
base="$(basename "$dir")"
base="$(printf '%s' "$base" | tr -c 'a-zA-Z0-9._-' '-' | sed 's/^-*//;s/-*$//')"
[ -n "$base" ] || base="claude"
# Disambiguate same-basename repos (e.g. ~/work/api vs ~/personal/api) with a short
# hash of the path — mirrors claude-sandbox's INSTANCE_ID. Deterministic, so re-running
# ct in the same dir resumes (new-session -A) the same session. cksum is POSIX (Linux +
# macOS); take the last 6 digits of its CRC.
h="$(printf '%s' "$dir" | cksum | cut -d' ' -f1)"
name="${base}-${h: -6}"

# Resolve the claude binary to an absolute path: tmux runs the pane command against the
# tmux server's PATH, which under a non-login ssh shell can lack ~/.local/bin (where the
# Claude installer symlinks the binary), so a bare `claude` would fail to launch. Prefer
# an explicit override, then PATH, then the installer's ~/.local/bin/claude.
claude_bin="${CT_CLAUDE_BIN:-}"
if [ -z "$claude_bin" ]; then
  claude_bin="$(command -v claude 2>/dev/null || true)"
  [ -n "$claude_bin" ] || { [ -x "$HOME/.local/bin/claude" ] && claude_bin="$HOME/.local/bin/claude"; }
  [ -n "$claude_bin" ] || claude_bin="claude"
fi
exec tmux new-session -A -s "$name" -c "$dir" "$claude_bin"

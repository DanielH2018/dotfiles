#!/usr/bin/env bash
# Periodic sweep: reap the redundant interactive ORIGIN left running behind every
# backgrounded Claude session. Runs on a systemd-user timer, INDEPENDENT of the Claude
# daemon's hook config (which the SessionStart hook depends on and which goes stale until
# the daemon restarts). For each live session, read its own worker cmdline by pid and,
# only on the exact backgrounding signature, SIGTERM its origin via the shared lib.
#
# This is the daemon-independent supplement to the reap-backgrounded-origin.sh hook; both
# share reap-origin-lib.sh so detection + guards are identical.
#
# Since Claude Code 2.1 a backgrounded session is dispatched onto a pre-warmed spare, whose
# argv keeps no --resume link to the origin, so the cmdline scan alone silently stops
# reaping. The roster pass below covers that dispatch; the cmdline pass still covers forks
# that carry the flags directly.
#
# Test seams: CLAUDE_SESSIONS_DIR, AGENT_VIEW_DIR, REAP_KILLCMD, REAP_LOG, REAP_LIB,
# REAP_PROC_DIR, REAP_ROSTER.
set -u

# shellcheck source=/dev/null
. "${REAP_LIB:-$HOME/.claude/hooks/reap-origin-lib.sh}"

proc_dir="${REAP_PROC_DIR:-/proc}"

# One jq builds the whole sid->pid table (see _reap_session_index in the lib) and every
# origin resolve reads it, instead of a jq fork per session file per lookup.
_reap_session_index
while IFS="$(printf '\t')" read -r sid pid _procstart; do
  [ -n "$sid" ] && [ -n "$pid" ] || continue
  case "$pid" in ''|*[!0-9]*) continue;; esac
  [ -r "$proc_dir/$pid/cmdline" ] || continue          # worker gone
  cmdline=" $(tr '\0' ' ' < "$proc_dir/$pid/cmdline" 2>/dev/null) "
  # delegate: no-ops unless this worker carries the backgrounding signature
  reap_origin_from_cmdline "$cmdline" "$sid"
done <<< "$_REAP_INDEX"

# Spare-dispatched backgroundings: the origin link lives only in the daemon roster.
# "nothing to reap" is the normal case and returns 1 — never let it fail the timer unit.
reap_origin_from_roster || true
exit 0

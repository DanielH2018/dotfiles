# First-run defaults for `wpe`. This is a create_ file: chezmoi writes it once on a machine that
# doesn't have it and never touches it again, because `wpe set` / `wpe screen` / `wpe layer` rewrite
# it in place. Managing it normally would mean every `chezmoi apply` reverted the chosen wallpaper.
#
# WALLPAPER is a workshop id under ~/.local/share/wallpaperengine/wallpapers — run `wpe list`.
#
# OUTPUT is `all`, a single Wayland output name, or a comma-separated list — run `wpe outputs`.
# `all` is the default because it is resolved at run time, not frozen here: it draws the same
# wallpaper on every connected display and simply covers fewer of them after a KVM flip. A pinned
# name would instead make the unit exit 1 the moment that display is absent.
WALLPAPER=1569613506
OUTPUT=all
FPS=30
SCALING=fill
LAYER=bottom
EXTRA="--disable-mouse --disable-parallax --silent"

#!/usr/bin/env node
// Deep-merge JSON fragments left→right. Objects merge by key; arrays concat + de-dupe
// by JSON value; scalars: the later (overlay) value wins; a missing file is treated as {}.
const fs = require('node:fs');

const isObj = (v) => v !== null && typeof v === 'object' && !Array.isArray(v);

const dedupe = (arr) => {
  const seen = new Set();
  const out = [];
  for (const item of arr) {
    const k = JSON.stringify(item);
    if (!seen.has(k)) { seen.add(k); out.push(item); }
  }
  return out;
};

const shape = (v) =>
  Array.isArray(v) ? 'array' : isObj(v) ? 'object' : v === null ? 'null' : 'scalar';

// Overlaying a structured value with a different shape is a malformed overlay, not an
// intentional override: taking the overlay there is how {"permissions": null} or
// {"permissions": "deny"} silently produces a settings.json with no permission model
// at all, at exit 0. null means "unset", so the other side wins; a genuine shape
// conflict is refused rather than resolved by guesswork.
// JSON.parse makes `__proto__` an own property, but `out[k] = …` goes through [[Set]] and
// hits Object.prototype's setter instead of defining a key. A fragment carrying
// {"__proto__": {"permissions": …}} therefore set the accumulator's prototype, a later
// fragment saw those keys through the chain, and the values merged into the real output —
// producing permission rules present in no visible key of any input. This script writes
// ~/.claude/settings.json, so that is a silent write to the enforced permission model.
const FORBIDDEN_KEYS = new Set(['__proto__', 'constructor', 'prototype']);

const merge = (a, b, path = []) => {
  if (Array.isArray(a) && Array.isArray(b)) return dedupe([...a, ...b]);
  if (isObj(a) && isObj(b)) {
    const out = { ...a };
    for (const k of Object.keys(b)) {
      if (FORBIDDEN_KEYS.has(k)) {
        const where = path.length ? path.join('.') : '<root>';
        process.stderr.write(
          `claude-settings-merge: refusing prototype key "${k}" at ${where}\n`,
        );
        process.exit(1);
      }
      // hasOwnProperty, not `in`: `in` walks the prototype chain, so a fragment key
      // named toString or valueOf would be merged against a function off Object.prototype.
      out[k] = Object.prototype.hasOwnProperty.call(a, k) ? merge(a[k], b[k], [...path, k]) : b[k];
    }
    return out;
  }
  if (b === null) return a;
  if (a === null) return b;
  if (shape(a) !== shape(b)) {
    const where = path.length ? path.join('.') : '<root>';
    process.stderr.write(
      `claude-settings-merge: type conflict at ${where}: cannot overlay ${shape(b)} onto ${shape(a)}\n`,
    );
    process.exit(1);
  }
  return b;
};

// --- removal directive ------------------------------------------------------------------
//
// Array merging above is concat + de-dupe only, so an overlay can ADD a permission rule but
// has no way to take one away — the only way to withdraw a rule was hand-editing the base
// template (A1-30). `$remove` closes that gap for the one place it actually matters:
// permissions.{allow,deny,ask}. It deliberately does NOT extend to other array-valued keys
// (availableModels, fallbackModel, ...) — those have no current widening problem, and adding
// untested removal surface there buys nothing (spec §9a open question 4).
//
// Shape: { "$remove": { "permissions": { "deny": ["Bash(foo:*)"] } } } — a top-level
// directive object mirroring the permissions shape, not a sigil prefix inside the array
// itself (e.g. "-Bash(foo:*)"). A permission rule is an arbitrary string an overlay author
// writes freely, so a sigil convention can collide with a real rule that happens to start
// with the sigil, with no way to disambiguate "remove this" from "the rule literally is
// this". A separate object cannot collide with anything, because it is never merged into
// permissions itself — it is stripped out before permissions is written anywhere.
//
// $remove flows through the ordinary merge() above like any other key: a later fragment's
// $remove.permissions.deny concatenates with an earlier one's via the same array-merge path,
// so a later fragment can remove what an earlier fragment added, and listing the same
// removal twice is harmless (de-duped the same way rules are). Removal is applied exactly
// once, after every fragment has merged, and BEFORE assertHasFloor/assertNoWidening run — so
// a $remove that deletes a floor rule or a base deny is caught by those same assertions
// running on the post-removal output, not silently written to disk. $remove is a directive,
// never a key in the generated settings.json — it is stripped from the accumulator here.
const REMOVE_KEY = '$remove';
const REMOVABLE_KINDS = ['allow', 'deny', 'ask'];

// Anything under $remove outside permissions.{allow,deny,ask} is refused, not silently
// ignored: swallowing an unsupported removal path (e.g. $remove.hooks, or
// $remove.permissions.additionalDirectories) would let an overlay author believe a removal
// happened when nothing did — the same "refuse rather than guess" reasoning as the
// flag-shaped-argument and prototype-key guards above, chosen over silent-ignore because a
// removal directive that silently does nothing is a security-relevant no-op, not a
// convenience default.
const applyRemovals = (acc) => {
  if (!Object.prototype.hasOwnProperty.call(acc, REMOVE_KEY)) return acc;
  const directive = acc[REMOVE_KEY];
  const out = { ...acc };
  delete out[REMOVE_KEY];

  if (!isObj(directive)) {
    process.stderr.write(`claude-settings-merge: ${REMOVE_KEY} must be an object, got ${shape(directive)}\n`);
    process.exit(1);
  }
  const badTop = Object.keys(directive).filter((k) => k !== 'permissions');
  if (badTop.length) {
    process.stderr.write(
      `claude-settings-merge: ${REMOVE_KEY} only supports permissions.{allow,deny,ask}, ` +
        `got unsupported key(s): ${badTop.join(', ')}\n`,
    );
    process.exit(1);
  }
  if (!Object.prototype.hasOwnProperty.call(directive, 'permissions')) return out;

  const permRemovals = directive.permissions;
  if (!isObj(permRemovals)) {
    process.stderr.write(
      `claude-settings-merge: ${REMOVE_KEY}.permissions must be an object, got ${shape(permRemovals)}\n`,
    );
    process.exit(1);
  }
  const badKinds = Object.keys(permRemovals).filter((k) => !REMOVABLE_KINDS.includes(k));
  if (badKinds.length) {
    process.stderr.write(
      `claude-settings-merge: ${REMOVE_KEY}.permissions only supports ${REMOVABLE_KINDS.join('/')}, ` +
        `got unsupported key(s): ${badKinds.join(', ')}\n`,
    );
    process.exit(1);
  }

  const permissions = isObj(out.permissions) ? { ...out.permissions } : null;
  for (const kind of REMOVABLE_KINDS) {
    if (!Object.prototype.hasOwnProperty.call(permRemovals, kind)) continue;
    const toRemove = permRemovals[kind];
    if (!Array.isArray(toRemove)) {
      process.stderr.write(
        `claude-settings-merge: ${REMOVE_KEY}.permissions.${kind} must be an array, got ${shape(toRemove)}\n`,
      );
      process.exit(1);
    }
    // A missing target array, or an entry that was never there: silent no-op, not an error.
    // A removal is a statement of intent ("this should not be granted/denied/asked"), and
    // that intent is already satisfied if the rule was never present.
    if (!permissions || !Array.isArray(permissions[kind])) continue;
    const drop = new Set(toRemove.map((v) => JSON.stringify(v)));
    permissions[kind] = permissions[kind].filter((v) => !drop.has(JSON.stringify(v)));
  }
  if (permissions) out.permissions = permissions;
  return out;
};

// --- assertions -----------------------------------------------------------------------
//
// These run on the merged JSON in memory, before the single stdout write that becomes
// ~/.claude/settings.json, so a failure never reaches disk in the first place.
//
// The safe-failure mode is free and comes from chezmoi's own modify_ contract: it only
// overwrites the target after the script's stdout is captured successfully, so a failing
// generator means "today's apply doesn't update settings.json and yesterday's file — which
// passed these same checks when it was written — keeps running". Don't special-case around
// that. The one case it does NOT cover is the first-ever apply on a new machine, where
// there is no yesterday; see SAFE_FLOOR below.

// Rules whose ABSENCE means something is badly broken. Deliberately not a copy of the deny
// list: assertHasFloor only has to catch a corrupt or truncated BASE, because assertNoWidening
// already catches any deny the overlay removes, generically and without naming rules. A floor
// the size of the whole policy would have to be kept in sync with it, and every legitimate
// rule edit would become a generator failure until both moved together. So the terraform
// family, `git config` and `find *-exec*` are excluded on purpose — they are live policy.
// Signed off 2026-07-30; spec §9a.
const FLOOR_DENY = [
  'Bash(sudo:*)', 'Bash(su:*)', 'Bash(mkfs:*)', 'Bash(dd:*)',
  'Bash(rm -rf /*)', 'Bash(rm -rf ~*)',
  'Bash(* | sh*)', 'Bash(* | bash*)', 'Bash(* | zsh*)',
  'Read(**/.ssh/**)', 'Read(**/.aws/credentials)', 'Read(**/.env)',
  'Read(**/id_rsa)', 'Read(**/id_ed25519)', 'Edit(**/.ssh/**)',
];

// Assertion 2 — a permission model is present and carries the floor. Runs before schema
// validation because it is cheaper and catches the worst case first.
const assertHasFloor = (merged) => {
  const p = merged.permissions;
  if (!isObj(p)) return 'permissions is missing or not an object';
  if (!Array.isArray(p.deny) || p.deny.length === 0) return 'permissions.deny is missing or empty';
  const have = new Set(p.deny);
  const missing = FLOOR_DENY.filter((r) => !have.has(r));
  if (missing.length) return `permissions.deny is missing floor rules: ${missing.join(', ')}`;
  return null;
};

// Assertion 4 — the overlay may ADD denies, never cause one to disappear. This is the
// generic half: it names no rules, so it protects every deny the base declares, including
// ones added long after this code was written.
const assertNoWidening = (baseDeny, merged) => {
  if (!Array.isArray(baseDeny)) return null;
  const have = new Set(isObj(merged.permissions) && Array.isArray(merged.permissions.deny)
    ? merged.permissions.deny : []);
  const dropped = baseDeny.filter((r) => !have.has(r));
  if (dropped.length) return `the overlay removed base deny rules: ${dropped.join(', ')}`;
  return null;
};

// Assertion 1 (spec §2) — targeted shape validation of the merged output. This is
// deliberately NOT a schema (ajv + a vendored schemastore doc, as the spec originally
// sketched): this script runs during `chezmoi apply`, before any `npm install` could ever
// have happened, and the repo has zero dependencies today (no package.json, no
// node_modules — every require() here is a builtin). A vendored validator library would
// have to be present on a machine's very first apply, which is exactly the bootstrap
// guarantee §8 exists to protect; adding one here would create the failure it prevents.
// So the checks below are hand-written against `shape()`/`isObj()` instead.
//
// Deliberately NOT a closed schema: unknown top-level keys are always allowed. Claude Code
// itself adds new settings.json keys over time, and this generator must not start refusing
// every apply the moment upstream ships one this file doesn't know about yet. Only the
// keys named below get their shape checked; everything else passes through untouched, same
// as the merge itself.
const isStringArray = (v) => Array.isArray(v) && v.every((x) => typeof x === 'string');

const assertShapes = (merged) => {
  const p = merged.permissions;
  // assertHasFloor already refused a missing/non-object permissions, but this runs after
  // that check in the caller only when the floor check passed — still guard defensively so
  // this function stands alone.
  if (Object.prototype.hasOwnProperty.call(merged, 'permissions') && !isObj(p)) {
    return 'permissions must be an object';
  }
  if (isObj(p)) {
    for (const kind of ['allow', 'deny', 'ask']) {
      if (Object.prototype.hasOwnProperty.call(p, kind) && !isStringArray(p[kind])) {
        return `permissions.${kind} must be an array of strings`;
      }
    }
  }
  if (Object.prototype.hasOwnProperty.call(merged, 'hooks') && !isObj(merged.hooks)) {
    return 'hooks must be an object';
  }
  if (Object.prototype.hasOwnProperty.call(merged, 'env')) {
    const env = merged.env;
    if (!isObj(env)) return 'env must be an object';
    for (const k of Object.keys(env)) {
      if (typeof env[k] !== 'string') return `env.${k} must be a string`;
    }
  }
  if (Object.prototype.hasOwnProperty.call(merged, 'model') && typeof merged.model !== 'string') {
    return 'model must be a string';
  }
  // fallbackModel is an ARRAY of model names, not a string. Verified against Claude Code
  // 2.1.220: with a string, `claude doctor` reports
  //   settings.json > fallbackModel: Expected array, but received string
  // and the harness then discards the ENTIRE settings.json — statusLine, hooks, permissions
  // and enabledPlugins all silently stop applying, not just this key. This check previously
  // asserted the opposite and was the thing enforcing the broken shape.
  if (Object.prototype.hasOwnProperty.call(merged, 'fallbackModel')
      && !isStringArray(merged.fallbackModel)) {
    return 'fallbackModel must be an array of strings';
  }
  if (Object.prototype.hasOwnProperty.call(merged, 'availableModels') && !isStringArray(merged.availableModels)) {
    return 'availableModels must be an array of strings';
  }
  return null;
};

// Keys the *running harness* writes back into the deployed settings.json at session time
// (`/effort` writes effortLevel). The templates don't set them, so a plain re-derive drops
// them on every `chezmoi apply` — the pin silently vanishes mid-session. This list is a
// fixed literal, never inferred from the prior file: carrying forward whatever happens to
// be in the deployed copy would make an uncommitted local edit into policy, which is the
// exact property "the file is fully derived" exists to guarantee.
const RUNTIME_OWNED_KEYS = ['effortLevel'];

// Data carry-forward only, and only for the keys above. Never permission rules, never hooks,
// never code — so this does not reopen "settings.json is fully derived" as a general property.
const carryForward = (acc, priorFile) => {
  if (!priorFile || !fs.existsSync(priorFile)) return acc;
  let prior;
  try {
    prior = JSON.parse(fs.readFileSync(priorFile, 'utf8'));
  } catch (e) {
    // A missing or corrupt prior file loses a UX pin, not a guardrail. Warn and generate
    // anyway: aborting here would block every other dotfile in the same apply.
    process.stderr.write(
      `claude-settings-merge: cannot read runtime keys from ${priorFile}: ${e.message}\n`,
    );
    return acc;
  }
  if (!isObj(prior)) return acc;
  for (const k of RUNTIME_OWNED_KEYS) {
    if (!Object.prototype.hasOwnProperty.call(prior, k)) continue;
    if (Object.prototype.hasOwnProperty.call(acc, k)) {
      // An explicit pin in the template is a deliberate override and wins. Say so when it
      // actually changes the live value, so a silently-reverted /effort is visible.
      if (JSON.stringify(acc[k]) !== JSON.stringify(prior[k])) {
        process.stderr.write(
          `claude-settings-merge: template pins ${k}=${JSON.stringify(acc[k])}, ` +
            `replacing deployed ${JSON.stringify(prior[k])}\n`,
        );
      }
      continue;
    }
    acc[k] = prior[k];
  }
  return acc;
};

// The prior file arrives by environment, not as an argument, and that is deliberate.
// modify_settings.json.sh.tmpl invokes this script by absolute path under
// `.chezmoi.sourceDir`, which is the primary checkout — so a worktree, an interrupted
// apply, or a mid-apply checkout can pair a new template with an older copy of this
// script. An unrecognised *flag* would fall through to the positional file list and the
// whole deployed settings.json would be merged back in as a fragment, promoting every
// stale or hand-edited permission rule in it to policy. An unrecognised *env var* is
// inert. Skew therefore costs a dropped effort pin, never a widened permission model.
const priorFile = process.env.CLAUDE_SETTINGS_PRIOR || null;

const files = process.argv.slice(2);
// Nothing here takes flags. Refuse anything flag-shaped rather than treating it as a
// filename that silently does not exist — same reasoning as above, other direction.
const flagLike = files.filter((f) => f.startsWith('--'));
if (flagLike.length) {
  process.stderr.write(`claude-settings-merge: unknown option ${flagLike[0]}\n`);
  process.exit(2);
}
if (files.length === 0) {
  process.stderr.write('usage: claude-settings-merge FILE [FILE...]\n');
  process.exit(2);
}
let acc = {};
let baseDeny = null;   // the FIRST fragment is the base; the rest are overlays
for (const f of files) {
  if (!fs.existsSync(f)) continue;
  let data;
  try {
    data = JSON.parse(fs.readFileSync(f, 'utf8'));
  } catch (e) {
    process.stderr.write(`claude-settings-merge: cannot parse ${f}: ${e.message}\n`);
    process.exit(1);
  }
  if (baseDeny === null && isObj(data) && isObj(data.permissions) && Array.isArray(data.permissions.deny)) {
    baseDeny = data.permissions.deny.slice();
  }
  acc = merge(acc, data);
}
// Applied once, after every fragment has merged, so a later fragment's $remove can take away
// what an earlier fragment added — and so assertHasFloor/assertNoWidening below run on the
// post-removal output, never the pre-removal one.
acc = applyRemovals(acc);
acc = carryForward(acc, priorFile);

// Default ON: any consumer that does nothing gets the floor enforced. The single exemption
// is the sandbox resolver, which merges fragments that legitimately carry no host floor (the
// sandbox has its own permission model and runs --dangerously-skip-permissions), and which
// swallows stderr and falls back silently — so an unconditional check degraded it to the
// un-merged base with no visible error. It says so explicitly rather than this file guessing.
const exempt = process.env.CLAUDE_SETTINGS_SKIP_FLOOR === '1';
if (exempt) {
  process.stderr.write('claude-settings-merge: floor assertions skipped (CLAUDE_SETTINGS_SKIP_FLOOR=1)\n');
}
const failure = exempt ? null : (assertHasFloor(acc) || assertNoWidening(baseDeny, acc) || assertShapes(acc));
if (failure) {
  process.stderr.write(`claude-settings-merge: refusing to write settings.json — ${failure}\n`);

  // First-ever apply on a new machine: there is no previously deployed file to fall back
  // on, so exiting here would leave the box with NO settings.json and therefore no
  // guardrails at all — strictly worse than the degraded-but-safe file below. priorFile is
  // set by modify_settings only when the target already existed, so its absence is exactly
  // the bootstrap case.
  const floorFile = process.env.CLAUDE_SETTINGS_SAFE_FLOOR;
  const bootstrapping = !priorFile || !fs.existsSync(priorFile);
  if (bootstrapping && floorFile && fs.existsSync(floorFile)) {
    try {
      const floor = JSON.parse(fs.readFileSync(floorFile, 'utf8'));
      const stillBad = assertHasFloor(floor) || assertShapes(floor);
      if (stillBad) throw new Error(`safe-floor itself fails the check: ${stillBad}`);
      process.stderr.write(
        'claude-settings-merge: no previously deployed settings.json to fall back on; '
        + 'writing the deny-only safe floor instead. Fix the error above and re-apply.\n',
      );
      process.stdout.write(JSON.stringify(floor, null, 2) + '\n');
      process.exit(0);
    } catch (e) {
      process.stderr.write(`claude-settings-merge: safe floor unusable: ${e.message}\n`);
    }
  }
  process.exit(1);
}

process.stdout.write(JSON.stringify(acc, null, 2) + '\n');

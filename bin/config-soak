#!/usr/bin/env node
'use strict';
// config-soak — advisory soak report for behavior-affecting config.
//
// Treats ~/.claude config (settings templates, hooks, agents, skills, rules, CLAUDE.md) as
// something to watch after it ships: each file is `soaking` for a window after it lands on
// main, then `stable`. A file whose working-tree content differs from origin/main is
// `unlanded`. Deterministic and mechanical: no LLM, no judgement, no state of its own.
//
// Usage:
//   config-soak status [--json]          report each tracked file's state; always exits 0
//   config-soak outcomes [--since PATH]  query Loki for evidence that each landed
//                                        hook/settings file actually fired
//   config-soak list                     print the tracked path set and exit
//   config-soak --help
//
// A file's landed date is the committer date of the last origin/main commit that touched
// it, read from git on every run. This replaced the committed config-soak.json ledger and
// its `land` verb in #694; docs/specs/2026-07-08-config-soak-gate-design.md has the history.
// Nothing here gates a push. Run `git fetch` first if origin/main may be stale.

const fs = require('node:fs');
const path = require('node:path');
const { execFileSync } = require('node:child_process');
const lib = require('./config-soak-lib.js');

const REPO_ROOT = path.resolve(__dirname, '..');
const MAIN_REF = 'origin/main';
const HOOKS_CONFIG_SOURCE = path.join(REPO_ROOT, 'home/.chezmoitemplates/settings.base.json');

// Loki, this machine only. No other host, no other port — the query text is
// caller-controlled (a LogQL string), but the destination never is, the same
// defensibility argument home/dot_local/bin/executable_otelq makes for why a
// fixed-destination query tool is a smaller grant than curl. Deliberately
// bare 127.0.0.1 rather than otelq's ClusterIP fallback: a workstation
// running claude-otel's docker-compose stack answers here directly (see
// home/claude-otel/README.md); a k3s host whose Loki lives behind a
// ClusterIP (daniel-box, daniel-server — see the otel-review skill) does
// not, and `outcomes` reports that honestly as source:"none" rather than
// reaching past localhost to find it.
const LOKI_BASE = 'http://127.0.0.1:3100';
const LOKI_TIMEOUT_MS = 5000;

async function queryLoki(logql, atSeconds) {
  const url = `${LOKI_BASE}/loki/api/v1/query?query=${encodeURIComponent(logql)}&time=${Math.floor(atSeconds)}`;
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), LOKI_TIMEOUT_MS);
  try {
    const res = await fetch(url, { signal: controller.signal });
    if (!res.ok) throw new Error(`Loki HTTP ${res.status}`);
    return await res.json();
  } finally {
    clearTimeout(timer);
  }
}

// Behavior-affecting config surface. `file` = a single path; `dir` = recurse.
// settings.json is generated from all three templates below, so all three are policy.
// Listed individually rather than tracking .chezmoitemplates as a dir: the rest of that
// directory is installer scripts and OS probes, which are not this surface.
// tests/settings/settings-templates-tracked.test.js fails if a fourth appears without a line here.
const TRACKED = [
  { type: 'file', path: 'home/.chezmoitemplates/settings.base.json' },
  { type: 'file', path: 'home/.chezmoitemplates/settings.permissions.json' },
  { type: 'file', path: 'home/.chezmoitemplates/settings.safe-floor.json' },
  { type: 'file', path: 'home/private_dot_claude/CLAUDE.md.tmpl' },
  { type: 'dir', path: 'home/private_dot_claude/hooks' },
  { type: 'dir', path: 'home/private_dot_claude/agents' },
  { type: 'dir', path: 'home/private_dot_claude/skills' },
  { type: 'dir', path: 'home/private_dot_claude/rules' },
  { type: 'dir', path: 'home/private_dot_claude/output-styles' },
];
const PATHSPEC = TRACKED.map((s) => s.path);

function git(args) {
  try {
    return execFileSync('git', args, {
      cwd: REPO_ROOT, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 64 * 1024 * 1024,
    });
  } catch (e) {
    process.stderr.write(`config-soak: git ${args[0]} failed in ${REPO_ROOT}: ${e.message}\n`);
    process.exit(2);
  }
}

// The tracked surface is what git tracks under each spec, not what is on disk there. A bare
// readdir walk once picked up the python suites' `hooks/__pycache__/*.pyc` (#547).
function gitTrackedPaths() {
  const paths = git(['ls-files', '-z', '--', ...PATHSPEC]).split('\0').filter(Boolean);
  if (!paths.length) {
    process.stderr.write(`config-soak: git ls-files returned no tracked config under ${REPO_ROOT}\n`);
    process.exit(2);
  }
  return paths.sort();
}

// { path: committer date of the newest MAIN_REF commit touching it }, in one log walk.
function landedDates() {
  git(['rev-parse', '--verify', '--quiet', `${MAIN_REF}^{commit}`]);
  return lib.parseLandedLog(git(['log', '--format=%x00%cI', '--name-only', MAIN_REF, '--', ...PATHSPEC]));
}

// Paths whose working-tree content differs from MAIN_REF: committed on this branch, staged,
// or unstaged alike.
function pendingPaths() {
  return git(['diff', '--name-only', '-z', MAIN_REF, '--', ...PATHSPEC]).split('\0').filter(Boolean);
}

function report(nowIso) {
  return lib.classify({ paths: gitTrackedPaths(), landed: landedDates(), pending: pendingPaths(), now: nowIso });
}

function pluralLine(label, items, render) {
  if (!items.length) return '';
  return `\n${label} (${items.length}):\n` + items.map((i) => '  ' + render(i)).join('\n') + '\n';
}

function cmdStatus(argv) {
  const r = report(new Date().toISOString());
  if (argv.includes('--json')) {
    process.stdout.write(JSON.stringify(r, null, 2) + '\n');
    return 0;
  }
  const d1 = (n) => n.toFixed(1);
  let out = `config soak status  (window: ${r.windowDays}d, landed = last ${MAIN_REF} commit)\n`;
  out += pluralLine(`UNLANDED — differs from ${MAIN_REF}`, r.unlanded, (i) => i.path);
  out += pluralLine('SOAKING — landed inside the window', r.soaking,
    (i) => `${i.path}  (${d1(i.daysRemaining)}d remaining)`);
  out += pluralLine('STABLE — landed before the window', r.stable, (i) => `${i.path}  (${d1(i.ageDays)}d)`);
  process.stdout.write(out);
  return 0;
}

function cmdList() {
  process.stdout.write(gitTrackedPaths().join('\n') + '\n');
  return 0;
}

function describeOutcome(o) {
  if (o.source === 'none') return `unattributed — ${o.note}`;
  return `fired=${o.fired} denied=${o.denied} errors=${o.errors}`;
}

// `config-soak outcomes [--since PATH]` — for every landed hook or settings file (soaking or
// stable), ask Loki whether it fired since it landed, and print the answer. Read-only against
// Loki (GET only, one fixed host — see queryLoki above); a query failure downgrades that path
// to source:"none" rather than aborting the run. A stable path that Loki answered for with
// zero hits is "landed, never fired", the scaffolding-delete-pass skill's raw material.
//
// `--since PATH` resumes a partial run: paths are processed in sorted order, and this skips
// every path before PATH (each costs a live Loki round trip).
async function cmdOutcomes(argv) {
  const sinceIdx = argv.indexOf('--since');
  const sinceArg = sinceIdx !== -1 ? argv[sinceIdx + 1] : null;
  const now = new Date();
  const nowIso = now.toISOString();
  const r = report(nowIso);
  const stable = new Set(r.stable.map((x) => x.path));
  const entries = [...r.soaking, ...r.stable]
    .filter((x) => !sinceArg || x.path >= sinceArg)
    .sort((a, b) => (a.path < b.path ? -1 : a.path > b.path ? 1 : 0));

  let hooksConfig = null;
  try {
    hooksConfig = lib.parseHooksConfig(fs.readFileSync(HOOKS_CONFIG_SOURCE, 'utf8'));
  } catch (_e) {
    hooksConfig = null; // every hooks/ path below reports its own unattributed note
  }

  const lines = [];
  const neverFired = [];
  for (const entry of entries) {
    const attribution = lib.attributeEntry(entry.path, hooksConfig);
    if (!attribution.inScope) continue; // not a hook or settings file
    let outcome;
    if (!attribution.attributable) {
      outcome = lib.unattributedOutcome({ checkedAt: nowIso, note: attribution.note });
    } else {
      const sinceSeconds = (now.getTime() - Date.parse(entry.landed)) / 1000;
      const queries = lib.buildOutcomeQueries(attribution.slices, sinceSeconds);
      const atSeconds = now.getTime() / 1000;
      try {
        const [fired, denied, errors] = await Promise.all([
          queryLoki(queries.fired, atSeconds).then(lib.parseLokiScalar),
          queryLoki(queries.denied, atSeconds).then(lib.parseLokiScalar),
          queryLoki(queries.errors, atSeconds).then(lib.parseLokiScalar),
        ]);
        outcome = lib.makeOutcome({ fired, denied, errors, checkedAt: nowIso });
      } catch (e) {
        outcome = lib.unattributedOutcome({ checkedAt: nowIso, note: `Loki did not answer at ${LOKI_BASE}: ${e.message}` });
      }
    }
    lines.push(`  ${entry.path}  ${describeOutcome(outcome)}`);
    if (stable.has(entry.path) && outcome.source === 'loki' && outcome.fired === 0) neverFired.push(entry.path);
  }

  let out = `config-soak outcomes  (${lines.length} hook/settings path${lines.length === 1 ? '' : 's'} checked)\n`;
  out += lines.join('\n') + (lines.length ? '\n' : '');
  out += pluralLine('NEVER FIRED — stable, zero Loki hits since landing (a scaffolding-delete-pass candidate)',
    neverFired, (p) => p);
  process.stdout.write(out);
  return 0;
}

const HELP = `config-soak — advisory soak report for behavior-affecting config

  config-soak status [--json]          each tracked file as unlanded, soaking or stable;
                                        landed = last ${MAIN_REF} commit to touch it.
                                        Always exits 0.
  config-soak outcomes [--since PATH]  query Loki for every landed hook/settings file and
                                        print whether it actually fired since landing.
                                        Read-only, localhost only. --since PATH resumes.
  config-soak list                     print the tracked config paths
  config-soak --help
`;

async function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  switch (cmd) {
    case undefined:
    case 'status': return cmdStatus(rest);
    case 'outcomes': return cmdOutcomes(rest);
    case 'list': return cmdList();
    case '-h':
    case '--help': process.stdout.write(HELP); return 0;
    default:
      process.stderr.write(`config-soak: unknown command '${cmd}'\n\n${HELP}`);
      return 2;
  }
}

main().then((code) => process.exit(code));

{{- if eq .chezmoi.os "windows" -}}
# Managed by chezmoi (run_onchange). Installs the modern CLI toolchain via winget so
# Git Bash gets the same experience as the macOS/Linux zsh setup (see dot_bashrc):
# starship prompt, zoxide, fzf, eza, fd, ripgrep, bat, fastfetch, uv. Also installs fnm —
# the Windows counterpart to run_once_before_install-fnm.sh.tmpl, which skips Windows.
# Idempotent: skips anything already on PATH or already reported installed by winget.
# Re-runs only when this file changes.
# bump-to-reinstall: cli-tools v1

$ErrorActionPreference = 'Stop'
# PS 7.3+ makes native non-zero exits throw under Stop; disable so a single winget
# failure (or "already installed") doesn't abort the loop. Harmless no-op on 5.1.
$PSNativeCommandUseErrorActionPreference = $false

if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Warning "winget not found — install 'App Installer' from the Microsoft Store, then re-run 'chezmoi apply'."
    return
}

# id = exact winget package id; cmd = the binary it puts on PATH (used to skip).
$packages = @(
    @{ id = 'Starship.Starship';       cmd = 'starship'  },
    @{ id = 'ajeetdsouza.zoxide';      cmd = 'zoxide'    },
    @{ id = 'junegunn.fzf';            cmd = 'fzf'       },
    @{ id = 'eza-community.eza';       cmd = 'eza'       },
    @{ id = 'sharkdp.fd';              cmd = 'fd'        },
    @{ id = 'BurntSushi.ripgrep.MSVC'; cmd = 'rg'        },
    @{ id = 'sharkdp.bat';             cmd = 'bat'       },
    @{ id = 'Fastfetch-cli.Fastfetch'; cmd = 'fastfetch' },
    @{ id = 'Schniz.fnm';              cmd = 'fnm'       },
    @{ id = 'astral-sh.uv';            cmd = 'uv'        },
    # Editor + file manager (configured under ~/.config/{nvim,yazi}). zig is the C
    # compiler nvim-treesitter needs to build parsers on Windows (no cc/clang here).
    @{ id = 'Neovim.Neovim';           cmd = 'nvim'      },
    @{ id = 'sxyazi.yazi';             cmd = 'ya'        },
    @{ id = 'zig.zig';                 cmd = 'zig'       }
)

foreach ($p in $packages) {
    if (Get-Command $p.cmd -ErrorAction SilentlyContinue) {
        Write-Host "[skip] $($p.cmd) already on PATH."
        continue
    }
    # `winget list` exits 0 when the package is present, non-zero otherwise.
    winget list --exact --id $p.id --accept-source-agreements 2>$null | Out-Null
    if ($LASTEXITCODE -eq 0) {
        Write-Host "[skip] $($p.id) already installed (open a new shell to pick up PATH)."
        continue
    }
    Write-Host "[install] $($p.id) ..."
    winget install --exact --id $p.id --source winget `
        --accept-package-agreements --accept-source-agreements --disable-interactivity
    if ($LASTEXITCODE -ne 0) {
        Write-Warning "winget install $($p.id) exited $LASTEXITCODE (continuing)."
    }
}

# fnm installs only the version manager, not a Node runtime. dotsync and
# claude-settings-merge are both '#!/usr/bin/env node' scripts, so install a default LTS
# Node here (mirrors step 2 of run_once_before_install-fnm.sh.tmpl). Idempotent: fnm skips
# an already-installed version.
$fnm = Get-Command fnm -ErrorAction SilentlyContinue
if ($fnm) {
    Write-Host "[install] default LTS node via fnm ..."
    & $fnm.Source install --lts
    & $fnm.Source default lts-latest
} else {
    Write-Warning "fnm not on PATH yet — open a new shell and re-run 'chezmoi apply' to install a default Node."
}

# uv manages its own CPython, so provision a default interpreter here (mirrors the fnm
# node step above). The vault-tooling under ~/.claude/vault-tooling (config-map,
# vault-index) targets Python >=3.11; 3.12 has the widest wheel coverage for
# vault-index's fastembed/duckdb deps (the system 'python' may be newer). Idempotent:
# uv skips an already-installed version. The "minor version link" warning on Windows
# without Developer Mode is benign — `uv run --python 3.12` still resolves the interpreter.
$uv = Get-Command uv -ErrorAction SilentlyContinue
if ($uv) {
    Write-Host "[install] managed CPython 3.12 via uv ..."
    & $uv.Source python install 3.12
} else {
    Write-Warning "uv not on PATH yet — open a new shell and re-run 'chezmoi apply' to provision a managed Python."
}

Write-Host "CLI tools done. Open a new Git Bash shell so the updated PATH and ~/.bashrc take effect."
{{- end -}}

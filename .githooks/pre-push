#!/usr/bin/env bash
#
# pre-push — the fast local half of the gate: commit signatures and the lint hooks.
#
# The full suite (eval freshness, instruction quality, the injection red-team, the unit
# tests) is bin/gate, and the required CI `gate` job runs it on every PR and on every push
# to main. main's ruleset refuses to move onto a commit that job has not passed, and bin/land
# waits for it, so nothing reaches main unchecked. Run bin/gate by hand before pushing when
# you want the answer sooner than CI gives it.
#
# The suite lived here until #694. bin/land pushes three times per landing, each push re-ran
# the whole suite, and CI then ran it again on the same head. Measured 2026-09-28: 37.4s
# per push with the suite, about 3s without.
#
# Bypass once (rarely, e.g. WIP push): git push --no-verify
#
# Checks:
#   1. commit signatures — every commit this push adds must carry a signature.
#                          commit.gpgsign is only a default; nothing enforced it, and
#                          173 of this repo's 607 commits do not verify as a result. The
#                          ruleset enforces signatures server-side on refs/heads/main only,
#                          so this is the check for every other branch.
#   2. lint              — every hook in .pre-commit-config.yaml, through prek.
#
# Kept bash-3.2 clean (macOS default bash): no mapfile / associative arrays.

set -u

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

# Git exports GIT_DIR/GIT_PREFIX (and friends) into its hooks. prek shells out to git and
# would otherwise act on the hook's view of the repo rather than the checkout's.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR \
      GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH \
      GIT_CONFIG_PARAMETERS GIT_REFLOG_ACTION

# Colors only when stdout is a terminal.
if [ -t 1 ]; then
  B=$'\033[1m'; G=$'\033[32m'; R=$'\033[31m'; Z=$'\033[0m'
else
  B=''; G=''; R=''; Z=''
fi

fail=0
skipped=""

run() { # run "<label>" <cmd...>
  label="$1"; shift
  printf '\n%s▶ %s%s\n' "$B" "$label" "$Z"
  if "$@"; then
    printf '%s✓ %s%s\n' "$G" "$label" "$Z"
  else
    rc=$?
    printf '%s✗ %s (exit %d)%s\n' "$R" "$label" "$rc" "$Z"
    fail=1
  fi
}

# 1. Commit signatures. Reads git's pre-push protocol from stdin, so it has to come
#    before anything else that might consume it. Unsigned/bad/revoked fail; signed but
#    unverifiable (signer absent from allowed_signers) warns — SIGN_GATE_STRICT=1 to
#    demand a good signature outright.
run "commit signatures" bin/check-push-signatures

# 2. Lint. Skips rather than fails when prek is absent: a missing local tool should not
#    block a push on a machine that never installed it, and CI's bin/gate run has it.
if command -v prek >/dev/null 2>&1; then
  run "lint (ruff + shellcheck)" prek run --all-files
else
  skipped="lint"
  printf '%s-%s lint (ruff + shellcheck) - prek not installed, skipped\n' "$B" "$Z"
fi

if [ "$fail" -ne 0 ]; then
  printf '\n%spre-push blocked.%s Fix the above, or bypass once: git push --no-verify\n' "$R" "$Z" >&2
  exit 1
fi

if [ -z "$skipped" ]; then
  printf '\n%spre-push checks passed.%s CI runs the full suite (bin/gate).\n' "$G" "$Z"
else
  printf '\n%spre-push checks passed, 1 step skipped (%s).%s CI runs the full suite (bin/gate).\n' \
    "$G" "$skipped" "$Z"
fi
exit 0

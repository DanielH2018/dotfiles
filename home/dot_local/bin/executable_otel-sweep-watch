#!/usr/bin/env bash
# otel-sweep-watch — the daily telemetry check; the logic lives in `otel-sweep watch`.
#
# This file stays only because otel-sweep-watch.service runs
# `ExecStart=%h/.local/bin/otel-sweep-watch`. It resolves otel-sweep next to itself
# rather than through PATH or an environment variable, so nothing a caller sets can
# choose the program that runs, and it forwards no arguments.
set -eu

here=$(cd "$(dirname "$0")" && pwd)

if [ ! -x "$here/otel-sweep" ]; then
  printf 'otel-sweep-watch: otel-sweep not on PATH\n' >&2
  exit 2
fi

exec "$here/otel-sweep" watch

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "env": {
    "EDITOR": "vim",
    "PAGER": "less -R",
{{ if has .chezmoi.hostname (list "daniel-box" "daniel-server" "daniel-pi") }}
    {{/* sudo run from a `!` command has no terminal to prompt on, so without an askpass
         helper it just refuses. ~/.zshenv sets this too, but that only reaches shells that
         read it: the Bash tool spawns its own shell per command and sudo saw nothing there
         (measured on daniel-box — sudo's "a terminal is required ... or configure an
         askpass helper"). This block does reach it, which is why the setting lives here
         rather than only in the shell. Headless hosts only — a desktop keeps ksshaskpass,
         which ~/.zshenv prefers when there is a graphical session to draw on. */}}
    "SUDO_ASKPASS": "{{ .chezmoi.homeDir }}/.local/bin/tmux-askpass",
{{ end }}
    {{/* M02 shadow census. The three Bash guards each carry their own idea of where one
         command ends and the next begins, and cmdparse.sh is the one segmentation meant to
         replace all three. This flag makes them compute what that shared segmentation WOULD
         decide, append one JSONL line per call to ~/.claude/logs/cmdparse-shadow.jsonl, and
         then return the OLD decision unchanged — a test asserts decision-identity with the
         flag on vs off, so turning this on cannot change what is approved or denied.

         It is on to collect the evidence the cutover needs: the guards run on every Bash
         call, so the log is a census of live traffic rather than a synthetic sample. The
         ship gate for slice 2 is zero `old != allow -> new == allow` rows among those with
         shadow_only == 0. Rows with shadow_only == 1 are the newline-only compounds, which
         stay deferred by decision (spec §8a) rather than by accident.

         Turn OFF by deleting this key. CMDPARSE=off is the harder kill switch: it disables
         the shared parser everywhere, not just the census. Read the log before removing
         either — an empty log means the flag never reached the hooks, not that the parse
         agrees. */}}
    "CMDPARSE_SHADOW": "1",
    {{/* Compact at 85% rather than the previous 60%. At 60% we discarded 40% of the
         window unconditionally, and long sessions were compacting 3-6 times each —
         every compaction also truncates history before the remember pipeline can
         save it, so the aggressive setting was degrading tomorrow's memory too.
         85 keeps a safety margin without paying full-window cache-read latency. */}}
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "85",
    {{/* Without this, auto-compaction does not run at all on claude-opus-5. The client
         resolves a compaction window via PY(); when every source misses it returns
         source:"auto", and the auto-compact check bails on exactly that case
         (`if (Gbe() && !s8e(t,r)) return !1`) rather than falling back to a default.
         claude-opus-5 was absent from the 2.1.218 model tables, so it hit that path and
         the client silently stopped managing context — no compaction and no blocking.
         2.1.220 lists it (window:1e6, native_1m), but pinning the window here keeps the
         threshold at 60% rather than the client's ~85% default, and keeps the guard
         satisfied on any client whose table lags a model release.
         Setting this env var takes PY's first branch, yielding source:"env", which
         satisfies the guard. The same fix covers the other native-1M models
         (opus-4-7/4-8, fable-5, mythos-5), which fall into the same hole.

         Value derivation — the goal is compaction at 60% of the real 1M window:
           budget E    = window - min(max_output, 20000) = 726000 - 20000 = 706000
           compact at  = min(floor(E * 85/100), E - 13000)
                       = min(600100, 693000) = 600100  ->  60.0% of 1M
         Tuning the window rather than the percentage keeps 200k models unchanged:
         PY clamps to min(Xv, configured), so they stay at 200000 and compact at
         153000 as before. That same clamp is why this only bites on a client that
         resolves 1e6 for the session model — see "model" below. */}}
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "726000",
    "CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE": "true",
    "CLAUDE_CODE_ALT_SCREEN_FULL_REPAINT": "1",
    "CTS_REMOTE_ROOTS": "~/server"{{ if ne .chezmoi.hostname "daniel-pi" }},
    {{/* Telemetry is on everywhere except daniel-pi, and the exclusion is deliberately
         written as one rather than as a list of the machines that have it: a new host
         should start reporting the day it is onboarded, not the day someone remembers
         to add it here. The old inclusion list is why daniel-server had no telemetry —
         nothing was broken, it had simply never been added.

         Every host exports to localhost:4317 and every host keeps its own data. What
         differs is who is listening there, and that is a property of the machine rather
         than of this file:

           workstations (fedora, daniel-wsl)  their own claude-otel stack, from
                                              home/claude-otel — see its README
           daniel-desktop                     daniel-wsl's, over WSL2 localhost forwarding
           servers (daniel-server, ...)       the collector their existing observability
                                              stack already runs. They must NOT bring up
                                              claude-otel: its collector wants the same
                                              4317 and would collide. .chezmoiignore
                                              keeps the compose files off them for that
                                              reason.

         daniel-pi is out because the stack is five containers with 90d/31d/30d retention,
         which is not what that machine is for. Being absent from the gate is silent by
         design — no telemetry and no error.

         A server's collector still has to route what it now receives; that is its own
         config, not this repo's. Until something listens on 4317 the exporter just
         retries in the background, which is harmless. */}}
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000",
    "OTEL_LOGS_EXPORT_INTERVAL": "5000",
    {{/* Claude Code exports metrics as DELTA by default, but the collector's prometheus
         exporter republishes whatever it receives as a cumulative counter — so
         claude_code_token_usage_tokens_total sawtooths instead of accumulating
         (measured 13 resets in 51 points over 4h). Every non-increase() PromQL total is
         wrong as a result: Prometheus reported $216/7d against $712 summed from Loki's
         api_request cost_usd over just 24h, a ~5x undercount. Cumulative is the
         source-side fix documented at code.claude.com/docs/en/monitoring-usage. */}}
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "cumulative",
    {{/* session_id MUST stay on. Without it every concurrent Claude Code process
         collapses into one Prometheus series, and the collector's prometheus exporter
         is last-writer-wins per label set — so cumulative counters (tokens, cost,
         sessions, active_time) stop accumulating. Measured with it off: 7549 api_request
         events reported only 1.86M tokens (246 tokens/request, ~10x low), while
         increase()[7d] over-corrected for the false counter resets by ~274x. */}}
    "OTEL_METRICS_INCLUDE_SESSION_ID": "true",
    {{/* Traces are a separate signal from metrics/logs and are gated twice: the beta
         flag turns span emission on at all, the exporter routes it. Without both, the
         only view of a turn is its aggregate cost — spans are what attribute wall-clock
         to permission waits (tool.blocked_on_user) vs tool execution vs model latency.
         Collector fans these to Tempo; see home/claude-otel/tempo-config.yaml. */}}
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "1",
    "OTEL_TRACES_EXPORTER": "otlp",
    {{/* app_entrypoint as a metric label: splits cost and tokens by how the session was
         started (interactive REPL vs SDK vs background job vs hook), which is the axis
         that says whether spend is me typing or automation running. Cheap — it is a
         small closed set, unlike session_id. The sibling OTEL_METRICS_INCLUDE_VERSION is
         deliberately left off: the collector's resource_to_telemetry_conversion already
         puts service_version on every series, so it would only duplicate a label. */}}
    "OTEL_METRICS_INCLUDE_ENTRYPOINT": "true",
    {{/* Content logging, on deliberately. Default-off redacts prompts and responses to
         "<REDACTED>" and drops tool arguments and output, which leaves the logs able to
         say a turn was expensive but never what it was doing. Safe here and only here:
         the whole stack binds to 127.0.0.1, stores on local disk, and reports to nobody.
         Do not copy this block to a shared or hosted collector.
         TOOL_CONTENT rides on spans, so it needs the tracing block above to be on.
         Loki's max_structured_metadata_size is raised to match — see loki-config.yaml.
         OTEL_LOG_RAW_API_BODIES stays off: it stores the entire request JSON on every
         call, which re-serialises the full system prompt and conversation history each
         turn, for content already captured by the four vars below. */}}
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_LOG_ASSISTANT_RESPONSES": "1",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_LOG_TOOL_CONTENT": "1"{{ end }}{{ if eq .chezmoi.hostname "daniel-server" }},
    {{/* serve-artifacts.sh binds this port and link-artifact.sh writes it into the
         emitted URL, so both ends move together. It has to differ from the 8181
         default because daniel-server is reached over plain ssh from a workstation
         that runs its OWN artifact server on 8181 (the SessionStart hook is gated on
         linux, and WSL is linux). With both on 8181 the client-side `ssh -L` can't
         bind, fails with "Address already in use", and the browser silently reaches
         the local server instead — a directory listing that renders but 404s every
         file written here. ~/.ssh/config forwards 8182 to match.

         The invariant this creates: EVERY ssh-reached host gets its own port, and none
         of them may be 8181, the client's own. Next free one goes to the next host —
         daniel-pi has no server today, so 8184 when it needs one. */}}
    "CLAUDE_ARTIFACTS_PORT": "8182"{{ else if eq .chezmoi.hostname "daniel-box" }},
    {{/* Same arrangement as daniel-server, one port over: ~/.ssh/config forwards 8183
         to match, and 8182 is already the daniel-server forward — two hosts on one port
         means whichever session connects second silently reads the first one's
         artifacts. */}}
    "CLAUDE_ARTIFACTS_PORT": "8183"{{ end }}
  },
  "attribution": {
    "commit": "🤖 Generated with [Claude Code](https://claude.com/claude-code)\n\nCo-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "🤖 Generated with [Claude Code](https://claude.com/claude-code)"
  },
  "includeGitInstructions": false,
  {{/* The permission model lives in its own template — 550 of this file's lines were
       this one key. See settings.permissions.json's header for the four gates that have
       to keep seeing that file.

       `trim` because includeTemplate splices the fragment's leading and trailing newlines
       verbatim, which puts the opening brace on its own line and strands the comma below
       the closing one. This comment ends on the same line as the key for the same reason:
       closing it at end-of-line instead leaves its newline behind as a blank line in the
       render. Both are checked — settings-base-shape.test.js asserts this file still
       renders byte-for-byte as it did before the split, so a formatting slip fails
       rather than ships. Do not close this comment on its own line. */}}"permissions": {{ includeTemplate "settings.permissions.json" . | trim }},
  {{/* Plain claude-opus-5, NOT the opus[1m] alias. 2.1.220 added claude-opus-5 to the
       model table with context:{window:1e6,native_1m:true}, so the full 1M resolves
       natively and CLAUDE_CODE_AUTO_COMPACT_WINDOW above is no longer clamped — the
       [1m] suffix became redundant. It is also actively harmful here: the account's
       entitlement rejects that alias (reason denied_by_entitlement, distinct from
       opus_1m_unavailable), so every session opened with a
         ⚠ Model "opus[1m]" is restricted by your organization's settings.
       warning before silently falling back to claude-opus-5 anyway. Naming the model
       we actually get drops the warning and keeps the 1M window. Do not reintroduce
       the suffix on a pre-2.1.220 client without re-checking the model table — there
       claude-opus-5 was absent and fell through to the 200000 default. */}}
  "model": "claude-opus-5",
  {{/* effortLevel is deliberately absent: an absent key (equivalently `/effort auto` or
       CLAUDE_CODE_EFFORT_LEVEL=auto) leaves effort UNPINNED, so the model sizes its own
       reasoning per turn. A pin here overrides that for every turn, cheap ones included.
       Per-turn escalation stays available without touching settings: `ultrathink` in a
       prompt pins higher effort for that turn only and reverts after it; `ultracode`
       additionally turns on the workflow/orchestration posture. Task-shaped routing lives
       in agent frontmatter (model + effort) under private_dot_claude/agents/, not here.
       Note this file is fully derived — modify_settings.json.sh.tmpl ignores stdin — so a
       runtime `/effort X` persists into ~/.claude/settings.json only until the next
       `chezmoi apply`. Reintroduce the key only to pin every turn on purpose. */}}
  {{/* An ARRAY of model names, not a string. A1-36 called this backwards and the string it
       introduced broke far more than the fallback: Claude Code 2.1.220 validates this key as
       an array, and on a type mismatch it discards the WHOLE settings.json, so statusLine,
       hooks, permissions and enabledPlugins all stopped applying until this was reverted.
       Confirmed by `claude doctor` ("Expected array, but received string") and by a scratch
       CLAUDE_CONFIG_DIR in which a SessionStart hook fired with the array and not with the
       string. Keep every entry present in availableModels. */}}
  "fallbackModel": ["claude-sonnet-5"],
  {{/* availableModels governs the main session AND subagents/skills/judge, so this list
       is the UNION of every model the setup actually requests: claude-opus-5 (main,
       native 1M), "opus" alias (eval judge +
       planner/migration-reviewer/root-cause/deep-review agents), "sonnet"
       (implementer/ops-investigator/network-navigator agents), claude-sonnet-5
       (fallbackModel), "haiku" (Claude Code's internal/auxiliary calls, e.g. the eval
       judge's helper call, and the chore agent), and "fable"/claude-fable-5
       (Fable 5, opted in for manual `/model fable` selection).
       Aliases and full IDs are both listed on purpose. enforceAvailableModels snaps the
       Default to the first entry if it would resolve outside the list — a deterministic
       guard against a silent model downgrade (cf. the fable->sonnet incident, which is
       why fable is listed last, never first). opus[1m] is deliberately absent: the
       entitlement rejects it, so listing it only offers a choice that fails.
       SOAK on host: watch a full eval run + a
       subagent invocation before trusting it. */}}
  "availableModels": [
    "claude-opus-5",
    "opus",
    "sonnet",
    "claude-sonnet-5",
    "haiku",
    "fable",
    "claude-fable-5"
  ],
  "enforceAvailableModels": true,
  "autoMode": {
    "classifyAllShell": true
  },
  "hooks": {{/* Git Bash runs these on Windows too; notify.sh just no-ops there */}}{
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/allow-compound-bash.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/allow-readonly-remote.sh",
            "timeout": 10
          },
          {{/* Picks up where allow-readonly-remote.sh stops: the homelab calls are wrapped in
               a local filter (`| tail -12`, `2>&1`) or carry connection flags, and that hook
               refuses any metacharacter or option. Defers to the server repo's tested pipeline
               parser rather than re-deriving it in shell. Absent repo => the command fails =>
               no output => the prompt stands, so it can only ever remove a prompt. */}}
          {
            "type": "command",
            "command": "~/server/.claude/hooks/auto-approve-remote-ssh.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-context.sh",
            "timeout": 5
          }
        ]
      },
      {{/* reap the redundant interactive origin left running when a session is backgrounded; /proc-based, so non-Windows only. No-ops unless the daemon's ancestor cmdline carries the fork signature */}}{{ if ne .chezmoi.os "windows" }}{
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/reap-backgrounded-origin.sh",
            "timeout": 5
          }
        ]
      },{{ end }}
      {{/* dev-container network glue (Linux/macOS); skip on Windows */}}{{ if ne .chezmoi.os "windows" }}{
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "docker network connect workspace_default $(hostname) 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },{{ end }}
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/watch-paths.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-update.sh",
            "timeout": 5
          }
        ]
      }{{ if or (eq .chezmoi.os "windows") (eq .chezmoi.os "linux") }},
      {{/* agentview: register the row at session start. Every other agent-view-state event fires only after activity, so a session started or resumed and then left idle had no row at all and the picker could not see it. "resume" matters most: that is the path that was silently invisible. */}}
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-view-state.sh start",
            "timeout": 5
          }
        ]
      }{{ end }}{{ if eq .chezmoi.os "linux" }},
      {{/* Linux only: serve ~/.claude/artifacts on localhost:8181 so artifact links are click-to-render from a VS Code Remote-SSH TUI (file:// can't cross the remote boundary) */}}
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/serve-artifacts.sh",
            "timeout": 5
          }
        ]
      }{{ end }}
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-context.sh",
            "timeout": 5
          }
        ]
      }{{ if or (eq .chezmoi.os "windows") (eq .chezmoi.os "linux") }},
      {{/* agentview: mark this session "working" when a prompt is submitted */}}
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-view-state.sh working",
            "timeout": 5
          }
        ]
      }{{ end }}
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-dangerous-bash.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/chezmoi-apply-guard.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "{{ if eq .chezmoi.os "windows" }}py -3 ~/.claude/hooks/tq-wrap-tests.py{{ else }}~/.claude/hooks/tq-wrap-tests.py{{ end }}",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-format.sh",
            "timeout": 30,
            "statusMessage": "Formatting..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/lint-after-edit.sh",
            "timeout": 300,
            "statusMessage": "Running lint checks..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/chezmoi-guard.sh",
            "timeout": 15,
            "statusMessage": "Syncing chezmoi source..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/link-artifact.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/screen-injection.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/suggest-artifact.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/reprime-nudge.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {{/* audible cue only when a session genuinely needs you; task_complete
           (fires on every turn end, incl. unfocused background sessions) is
           intentionally excluded so working sessions stay silent */}}
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh",
            "timeout": 5
          }
        ]
      }{{ if or (eq .chezmoi.os "windows") (eq .chezmoi.os "linux") }},
      {{/* agentview: needs-input on permission/idle prompts */}}
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-view-state.sh needs-input",
            "timeout": 5
          }
        ]
      },
      {{/* agentview: completed on task-complete notification */}}
      {
        "matcher": "task_complete",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-view-state.sh completed",
            "timeout": 5
          }
        ]
      }{{ end }}
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-compact.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-before-stop.sh",
            "timeout": 10
          }
        ]
      }{{ if or (eq .chezmoi.os "windows") (eq .chezmoi.os "linux") }},
      {{/* agentview: mark completed when the turn stops */}}
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-view-state.sh completed",
            "timeout": 5
          }
        ]
      }{{ end }}
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-failure.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-end.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }{{ if or (eq .chezmoi.os "windows") (eq .chezmoi.os "linux") }},
      {{/* agentview: remove this session's state file on end */}}
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-view-state.sh end",
            "timeout": 5
          }
        ]
      }{{ end }}
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/instructions-loaded.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/subagent-stop.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  {{/* baseRef=head branches a new worktree from whatever the primary checkout
       happens to be sitting on. With several sessions in this repo at once that
       is not reliably main: a session that created a branch in the primary
       checkout instead of a worktree leaves it parked there, and every worktree
       opened afterwards silently inherits that branch's commits. Found exactly
       that state — the primary on `context-review-safe-items` — which is how an
       unrelated session's work ends up in a fresh branch's diff. `fresh` branches
       from origin/main regardless of local state, so a worktree's base is a fact
       about the remote rather than about whoever touched the checkout last. */}}
  {{/* A background job has nobody watching the checkout it runs in, so it is the
       one most likely to leave the primary parked on a branch, or to race another
       session over the shared index. `worktree` blocks Edit/Write in the main
       checkout until the job calls EnterWorktree, which puts its changes on their
       own branch and leaves the primary where it was. This is also the shipped
       default; pinning it keeps a repo-level opt-out from passing unnoticed and
       survives a change to that default. */}}
  "worktree": {
    "baseRef": "fresh",
    "bgIsolation": "worktree"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "footerLinksRegexes": [],
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "remember@claude-plugins-official": true,
{{- if ne .chezmoi.os "windows" }}
    "feature-dev@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
{{- end }}
    "ralph-loop@claude-plugins-official": true,
    {{/* Back after a brief removal, and it is a different plugin now. It used to install a
         PreToolUse hook that logged every permission decision so its audit had something to
         read; that hook is gone, because Claude Code's own OTEL tool_decision events say the
         same thing and say who decided — config rule, hook, or user. What installs here is
         the reader and its skill, nothing that writes. Needs telemetry reaching a Loki that
         holds claude-code events; hosts without one get a skill that reports it cannot
         connect, not a broken session. */}}
    "claude-permission-audit@daniel-tools": true
  },
  "extraKnownMarketplaces": {
    "daniel-tools": {
      "source": {
        "source": "github",
        "repo": "DanielH2018/claude-permission-audit"
      },
      "autoUpdate": true
    }
  },
  "sandbox": {{/* macOS-only: the block below is macOS-tuned (1Password agent socket, /System, allowUnixSockets) and Linux lacks bwrap/socat, so an enabled sandbox there just runs unsandboxed and warns about glob Read/Edit rules it can't enforce */}}{{ if eq .chezmoi.os "darwin" }}{
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "registry.npmjs.org",
        "repo1.maven.org",
        "plugins.gradle.org",
        "services.gradle.org",
        "downloads.gradle.org",
        "central.sonatype.com",
        "dl.google.com",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "static.crates.io",
        "ssh.shipyard.rs",
        "jpos.org",
        "clojars.org",
        "ghcr.io"
      ],
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.local/share/chezmoi",
        "~/.claude",
        "~/.gradle",
        "~/.m2",
        "~/.npm",
        "~/.cache",
        "~/.sdkman",
        "~/.local/share/fnm",
        "~/Library/Caches/pyapp/locks",
        "/tmp",
        "~/work-laptop-config"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gcloud",
        "~/.config/gh",
        "~/.netrc",
        "~/.pypirc",
        "~/.npmrc",
        "/etc",
        "/System"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gcloud",
        "~/.config/gh",
        "~/.netrc",
        "~/.pypirc",
        "~/.npmrc"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "enableWeakerNetworkIsolation": false,
    "excludedCommands": [
      "docker",
      "docker-compose"
    ]
  }{{ else }}{ "enabled": false }{{ end }},
  "alwaysThinkingEnabled": true,
{{- if eq .chezmoi.os "linux" }}
  "preferredNotifChannel": "terminal_bell",
{{- end }}
  "advisorModel": "opus",
  {{/* Off on measured cost, not on principle. Over 16h of OTEL telemetry
       (2026-08-01/02) away_summary was 28 firings, $23.96, and 40% of every
       cache-write token spent — for 2.3k output tokens, 0.4% of the total. Each
       firing writes a fresh ~84k-token cache entry it then never reads, so it
       costs ~$0.86 a time and amortises across nothing. Both it and
       prompt_suggestion reconciled to $0.00 against list price at the 1h
       cache TTL, which is how that rate was confirmed rather than assumed.
       The tradeoff is real — this is the summary of what happened while you
       were away, and background jobs are the case it exists for. Flip back to
       true to buy it again; the price is the number above. */}}
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "autoConnectIde": true,
  "autoInstallIdeExtension": true,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "remoteControlAtStartup": true
}

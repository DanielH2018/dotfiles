#!/bin/sh
# chezmoi modify_ script (templated): regenerate ~/.claude/settings.json as
#   merge(general base, work overlay-if-present).
# stdin (current target content) is read for ONE purpose: the runtime-owned key allowlist in
# claude-settings-merge (currently just effortLevel, written into the deployed file by
# `/effort`). Everything else about the file is still fully derived from the templates — the
# carry-forward is data only, never permission rules, hooks or code.
set -eu

BASE="$(mktemp "${TMPDIR:-/tmp}/chezmoi-settings-base.XXXXXX")"
PRIOR="$(mktemp "${TMPDIR:-/tmp}/chezmoi-settings-prior.XXXXXX")"
FLOOR="$(mktemp "${TMPDIR:-/tmp}/chezmoi-settings-floor.XXXXXX")"
trap 'rm -f "$BASE" "$PRIOR" "$FLOOR"' EXIT

# A1-29: the enforced permission model is generated from the working tree, so an uncommitted
# edit to the base template or the merge script silently BECOMES policy — live, and invisible
# to review or to git. Refuse rather than deploy something nobody can see the provenance of.
#
# Scoped to the files that actually decide the output; an unrelated dirty file in the repo
# is not this script's business. Set CLAUDE_SETTINGS_ALLOW_DIRTY=1 to iterate locally.
#
# The settings templates are matched by WILDCARD, not by name. They used to be enumerated,
# and the enumeration named only settings.base.json — settings.safe-floor.json is spliced in
# below and was never covered, so an uncommitted edit to the bootstrap floor was exactly the
# unreviewable policy this refuses to deploy. Splitting the permission model out into
# settings.permissions.json would have added a second such hole. A pattern cannot go stale
# the way a list does, so keep it a pattern; tests/settings/settings-templates-tracked.test.js fails
# if it is narrowed back.
#
# A plain quoted pathspec is already a wildmatch, so no :(glob) magic is wanted here — and
# it would be the wrong tool if reached for. Adding :(glob) makes `*` stop at a `/`, which
# is NARROWER than the default: bare `home/*settings.base.json` matches
# home/.chezmoitemplates/settings.base.json AND the sandbox's own copy under
# private_dot_claude/, while the :(glob) form matches neither. The pattern below is anchored
# on a literal .chezmoitemplates/ prefix, so the loose `*` costs nothing: the only paths it
# can reach are inside that directory, and over-matching there would mean refusing on an
# extra file rather than deploying an unreviewed one.
#
# NOTE ON BLAST RADIUS: chezmoi stops the whole run on first error, so this failing blocks
# every other dotfile in that apply, not just settings.json. `chezmoi apply --keep-going` is
# the escape hatch when you want the rest deployed despite a known settings issue.
if [ "${CLAUDE_SETTINGS_ALLOW_DIRTY:-0}" != 1 ]; then
  SRC="{{ .chezmoi.sourceDir }}"
  DIRTY="$(git -C "$SRC" status --porcelain -- \
    ".chezmoitemplates/settings.*.json" \
    "dot_local/bin/executable_claude-settings-merge" 2>/dev/null || true)"
  if [ -n "$DIRTY" ]; then
    echo "modify_settings: refusing to generate settings.json from an uncommitted tree." >&2
    echo "$DIRTY" >&2
    echo "Commit the change, or set CLAUDE_SETTINGS_ALLOW_DIRTY=1 to iterate locally." >&2
    exit 1
  fi
fi

# Drain stdin unconditionally: leaving it unread can SIGPIPE the writer. Empty means the
# target does not exist yet (first apply), so there is nothing to carry forward.
cat > "$PRIOR"
cat > "$BASE" <<'CHEZMOI_BASE_EOF'
{{ includeTemplate "settings.base.json" . }}
CHEZMOI_BASE_EOF

# The bootstrap fallback, for a first-ever apply where a failed assertion would otherwise
# leave the machine with no settings.json at all. A committed template rather than a string
# inside the generator, so it is visible in a diff and validated like anything else.
cat > "$FLOOR" <<'CHEZMOI_FLOOR_EOF'
{{ includeTemplate "settings.safe-floor.json" . }}
CHEZMOI_FLOOR_EOF

OVERLAY="$HOME/.config/claude/settings.work.json"   # absent on non-work machines

NODE="$(command -v node 2>/dev/null || true)"
if [ -z "$NODE" ]; then
  # fnm's default alias resolves a node without an interactive `fnm env`, so this works
  # during a headless `chezmoi apply`. fnm_multishells/* only exists inside an
  # fnm-activated shell and is kept as a last-resort fallback. fnm's Windows layout puts
  # node.exe directly under aliases/default/ (no bin/ subdir, .exe suffix) instead of the
  # Unix aliases/default/bin/node, so both shapes are checked. The aliases/default entry
  # is itself a junction fnm creates, and on at least one machine that junction came out
  # unreadable (dir/Get-Content both fail on it even though the target is fine and other,
  # unrelated junctions on the same box work) -- cause unconfirmed, but the node-versions/*
  # glob below reaches the same install by walking past the alias entirely, so a broken
  # junction there doesn't strand this script.
  for c in \
    "${FNM_DIR:-$HOME/.local/share/fnm}/aliases/default/bin/node" \
    "$HOME/.fnm/aliases/default/bin/node" \
    "${FNM_DIR:-$HOME/AppData/Roaming/fnm}/aliases/default/node.exe" \
    /opt/homebrew/bin/node /usr/local/bin/node \
    "$HOME"/.local/state/fnm_multishells/*/bin/node \
    "${FNM_DIR:-$HOME/AppData/Roaming/fnm}"/node-versions/*/installation/node.exe; do
    [ -x "$c" ] && NODE="$c" && break
  done
fi
if [ -z "$NODE" ] && command -v fnm >/dev/null 2>&1; then
  # Every guess above assumes the alias junction or version directory is visible from this
  # shell; on at least one Windows machine that visibility was inconsistent from one
  # invocation to the next (dir, Get-Content, and even this script's own -x tests
  # disagreed), while `fnm` itself -- which resolves the install through its own internal
  # bookkeeping rather than a filesystem link -- stayed reliable throughout. Ask it
  # directly as a last resort: find the version fnm reports as default, then have fnm
  # exec node in place just long enough to report its own real path.
  FNM_DEFAULT_VERSION="$(fnm list 2>/dev/null | awk '/default/{print $2; exit}')"
  if [ -n "$FNM_DEFAULT_VERSION" ]; then
    NODE="$(fnm exec --using="$FNM_DEFAULT_VERSION" -- node -e 'process.stdout.write(process.execPath)' 2>/dev/null || true)"
  fi
fi
[ -n "$NODE" ] || { echo "modify_settings: node not found on PATH or common locations; cannot generate ~/.claude/settings.json" >&2; exit 1; }
MERGE="{{ .chezmoi.sourceDir }}/dot_local/bin/executable_claude-settings-merge"
# By environment, never as an argument: an older copy of the merge script ignores an unknown
# env var, but would take an unknown flag's operand as another settings fragment and merge the
# whole deployed file back in. Skew must cost a dropped effort pin, not a widened permission set.
export CLAUDE_SETTINGS_SAFE_FLOOR="$FLOOR"
if [ -s "$PRIOR" ]; then
  CLAUDE_SETTINGS_PRIOR="$PRIOR" "$NODE" "$MERGE" "$BASE" "$OVERLAY"
else
  "$NODE" "$MERGE" "$BASE" "$OVERLAY"
fi

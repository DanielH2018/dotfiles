{{ if and (eq .chezmoi.os "linux") (ne .profile "minimal") -}}
#!/bin/sh
# Installs the shell-experience CLI tools on a Linux workstation/server (Debian/Ubuntu or
# Fedora, amd64 or arm64), mirroring the macOS Brewfile for Linux. The distro package manager
# for repo packages + release binaries for the gaps. Gated to non-minimal profiles so a
# resource-constrained host (profile=minimal, e.g. the Pi) opts out of the heavy install.
# run_after_: runs on every apply, AFTER file targets, so a sudo-less run that can't reach the
# package manager fails loudly (exit 1) WITHOUT blocking dotfile deployment.
#
# It used to be run_once_after_ with a hand-bumped `tools-bump` marker, which meant the release
# binaries below — eza, fzf, zoxide, ripgrep, bat, fd, nvim, yazi, and the rest — installed once
# and then stayed at whatever version was current that day. install_release has always been
# version-aware (it resolves the latest tag and reinstalls when the recorded one differs), so
# nothing was missing except a reason to run it again; bumping the marker refreshed every tool
# at once, which is why it rarely got bumped.
#
# Running on every apply would mean a GitHub round trip per tool per apply, so the gate below
# throttles the whole script to once a week — a converged apply inside that window is one stat()
# and an exit, with no sudo probe and no network. It runs anyway, regardless of the window, when
# tools.toml itself changes, so adding a tool still takes effect on the next apply.
#   CLI_TOOLS_FORCE=1 chezmoi apply        check now, ignoring the window
#   CLI_TOOLS_MAX_AGE_DAYS=1 chezmoi apply check daily instead of weekly
#   touch ~/.local/bin/.versions/.no-auto-update   stop checking (CLI_TOOLS_FORCE still wins)
set -u
TAG=install-cli-tools

# The package-manager abstraction (PM/pkg_installed/pkg_install), the sudo guard, the arch
# naming, and the GitHub-release installers live in the shared module below — the same one the
# app installer uses, so both speak one vocabulary and a fix lands in both. Everything from here
# on is CLI-toolchain-specific.
{{ includeTemplate "linux-install.sh" . }}

# 0. The throttle. Everything below this point costs a sudo probe and a dozen GitHub round
#    trips, so a converged apply must not reach it. The stamp holds the tools.toml hash it was
#    written for, which is what makes "a new tool was added" override the age window: a changed
#    list cannot match the recorded one, so the run happens regardless of when the last one did.
#    VER_DIR is created by linux-install.sh above, so the stamp always has somewhere to live.
STAMP="$VER_DIR/.last-check"
SKIP_MARK="$VER_DIR/.no-auto-update"
TOOLS_KEY='{{ include ".chezmoidata/tools.toml" | sha256sum }}'
: "${CLI_TOOLS_MAX_AGE_DAYS:=7}"
: "${CLI_TOOLS_FORCE:=0}"

if [ "$CLI_TOOLS_FORCE" != 1 ]; then
  if [ -e "$SKIP_MARK" ]; then exit 0; fi
  # -mtime on a path that does not exist prints nothing (and an error we discard), so a machine
  # that has never run this reads as stale rather than fresh.
  if [ "$(cat "$STAMP" 2>/dev/null)" = "$TOOLS_KEY" ] \
     && [ -n "$(find "$STAMP" -mtime "-$CLI_TOOLS_MAX_AGE_DAYS" 2>/dev/null)" ]; then
    exit 0
  fi
fi

# 1. unzip up front — a release install below (yazi) extracts a .zip, and a bare distro (fresh
#    WSL Ubuntu) ships without unzip. Install it before any other package so it's guaranteed
#    present when the yazi step runs; nvim and the rest use tar and don't need it.
if ! command -v unzip >/dev/null 2>&1 && [ -n "$PM" ]; then
  if have_sudo; then
    pkg_install unzip
  else
    echo "install-cli-tools: sudo unavailable; deferring unzip (yazi extraction will be skipped)" >&2
  fi
fi

# 2. Distro packages (only if any are missing; needs sudo, which prompts in an interactive
#    terminal). The list comes from .chezmoidata/tools.toml — the shared source of truth with the
#    winget + Brewfile installers. Both package lists are rendered so the script stays portable at
#    runtime and PM picks one. Release-binary tools (eza/fastfetch/curlie/sd/fzf/zoxide/ripgrep)
#    have no apt/dnf field and stay in the bespoke section below.
PKGS_APT="{{ range .tools }}{{ if .apt }}{{ .apt }} {{ end }}{{ end }}"
PKGS_DNF="{{ range .tools }}{{ if .dnf }}{{ .dnf }} {{ end }}{{ end }}"
case "$PM" in
  apt) PKGS="$PKGS_APT" ;;
  dnf) PKGS="$PKGS_DNF" ;;
  *)   PKGS="" ;;
esac

missing=""
for p in $PKGS; do
  pkg_installed "$p" || missing="$missing $p"
done
if [ -n "$missing" ]; then
  if have_sudo; then
    # shellcheck disable=SC2086  # $missing is a space-separated package list; splitting intended
    pkg_install $missing
  else
    echo "install-cli-tools: sudo unavailable; deferring packages:$missing" >&2
  fi
fi

# 2b. GitHub CLI.
#     Debian/Ubuntu: from gh's own apt repo. Ubuntu's package is frozen at 2.45, which throws on a
#     deprecated Projects-classic GraphQL query (breaks `gh pr edit`/`gh pr merge`); cli.github.com
#     tracks current releases. Adds the repo + keyring once, then `apt upgrade` keeps gh current.
#     Fedora: the distro package already tracks current gh (2.94 on F44), so a plain install is
#     enough and there is no third-party repo to add.
GH_LIST="/etc/apt/sources.list.d/github-cli.list"
# deb822 equivalent. A host provisioned by Ansible's github_cli role registers the repo as
# github-cli.sources and REMOVES the legacy one-line .list (apt reports a repo configured
# twice if both exist). Checking only .list made this script report "GitHub CLI not
# configured yet" on such a host forever — and since it is a run_once_after script that
# exits 1 when any check fails, every later `chezmoi apply` retried and failed too.
GH_SOURCES="/etc/apt/sources.list.d/github-cli.sources"
gh_ready() {
  case "$PM" in
    apt) [ -f "$GH_LIST" ] || [ -f "$GH_SOURCES" ] ;;
    dnf) rpm -q gh >/dev/null 2>&1 ;;
    *)   return 0 ;;
  esac
}
if ! gh_ready; then
  if have_sudo; then
    if [ "$PM" = apt ]; then
      apt_repo_add github-cli https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        "deb [arch=$(dpkg --print-architecture) signed-by=__KEYRING__] https://cli.github.com/packages stable main" \
        && pkg_install gh && echo "install-cli-tools: GitHub CLI repo added + gh updated"
    else
      pkg_install gh && echo "install-cli-tools: gh installed"
    fi
  else
    echo "install-cli-tools: sudo unavailable; deferring GitHub CLI setup" >&2
  fi
fi

# 2c. WezTerm — the mux-server + `wezterm cli` back this machine's leg of the cross-machine
#     Claude Code session switcher (agentview) on Daniel's PC. Only the headless mux-server/CLI
#     are used (no DISPLAY). Neither distro packages it:
#       Debian/Ubuntu — upstream's fury.io apt repo.
#       Fedora        — upstream's own COPR (wezfurlong/wezterm-nightly), the install route
#                       wezterm documents for Fedora. It is the only maintained RPM source: the
#                       GitHub release RPMs are pinned to long-dead Fedora releases and the last
#                       tagged stable is from 2024. The COPR carries an fc44 chroot.
#     Repo added once, then the normal upgrade path keeps it current.
WEZ_LIST="/etc/apt/sources.list.d/wezterm.list"
wez_ready() {
  case "$PM" in
    apt) [ -f "$WEZ_LIST" ] ;;
    dnf) rpm -q wezterm >/dev/null 2>&1 ;;
    *)   return 0 ;;
  esac
}
if ! wez_ready; then
  if have_sudo; then
    if [ "$PM" = apt ]; then
      apt_repo_add wezterm https://apt.fury.io/wez/gpg.key \
        "deb [signed-by=__KEYRING__] https://apt.fury.io/wez/ * *" \
        && pkg_install wezterm && echo "install-cli-tools: WezTerm repo added + installed"
    elif copr_enable wezfurlong/wezterm-nightly; then
      pkg_install wezterm && echo "install-cli-tools: WezTerm COPR enabled + installed"
    else
      echo "install-cli-tools: failed to enable the WezTerm COPR" >&2
    fi
  else
    echo "install-cli-tools: sudo unavailable; deferring WezTerm setup" >&2
  fi
fi

{{ if includeTemplate "is-desktop-linux" . -}}
# 2d. Docker CLI shim for Podman. Fedora ships podman but no `docker`, so anything that shells
#     out to `docker` (most container tutorials, plenty of build scripts) fails on a stock
#     workstation. podman-docker supplies /usr/bin/docker -> podman. Podman itself arrives as a
#     package dependency where it is absent.
#     Desktop-gated, and the gate is load-bearing rather than stylistic: wsl/install-docker-engine
#     installs real docker-ce, which owns the same /usr/bin/docker path — Debian's podman-docker
#     declares Conflicts: docker-ce, and dnf would refuse the file conflict outright. Servers are
#     excluded on the same reasoning: they manage their own container runtime, not from here.
#     The `command -v docker` test is the second line of that defence. It covers the case the
#     template gate cannot see — a workstation where Docker was installed by hand — and doubles as
#     the skip-if-present check on re-runs, since the shim's whole purpose is to put `docker` on
#     PATH.
if ! command -v docker >/dev/null 2>&1 && [ -n "$PM" ]; then
  if have_sudo; then
    pkg_install podman-docker && echo "install-cli-tools: podman-docker installed (docker -> podman shim)"
  else
    echo "install-cli-tools: sudo unavailable; deferring the podman-docker shim" >&2
  fi
fi

#     Finishing the shim off, keyed on the package rather than on the install above. That branch
#     stops once `docker` is on PATH, so a machine that installed the shim on an earlier run would
#     never reach either step below if they lived inside it.
if [ -n "$PM" ] && pkg_installed podman-docker; then
  # The shim prints "Emulate Docker CLI using podman" to stderr on every invocation until this
  # file exists. The package does not ship it — the message itself asks you to create it.
  if [ ! -e /etc/containers/nodocker ] && have_sudo; then
    sudo install -d -m 755 /etc/containers &&
      sudo install -m 644 /dev/null /etc/containers/nodocker &&
      echo "install-cli-tools: created /etc/containers/nodocker (silences the shim banner)"
  fi

  # podman.socket is what makes DOCKER_HOST mean anything. The package's /etc/profile.d snippet
  # exports DOCKER_HOST unconditionally and its tmpfiles.d config symlinks docker.sock next to
  # podman.sock, so leaving the socket disabled points every Docker-API client (as opposed to the
  # CLI, which needs none of this) at a path nothing listens on — a worse failure than an unset
  # DOCKER_HOST, because it looks configured. Socket-activated and rootless: podman starts on
  # connect rather than running a daemon. Back out with `systemctl --user disable --now
  # podman.socket`. The show-environment probe is the same one the reap-timer script uses to tell
  # a real user session from a headless non-lingering one, where enabling would just error.
  if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
    systemctl --user enable --now podman.socket || true
  fi
fi
{{ end }}
# 3. Real-name symlinks for Debian's renamed binaries (so the shell uses bat/fd). luac is what
#    tests/terminal/wezterm-config.test.js shells out to (luac -p); Debian's lua5.4 package ships it as
#    luac5.4, so without this alias that test silently skips there. Fedora installs all four
#    under their real names already, so every pair below no-ops on it.
for pair in "bat:batcat" "fd:fdfind" "lua:lua5.4" "luac:luac5.4"; do
  name="${pair%%:*}"; real="${pair##*:}"
  rp="$(command -v "$real" 2>/dev/null || true)"
  [ -n "$rp" ] && ln -sf "$rp" "$BIN_DIR/$name"
done

# 4. Release binaries for the package gaps (no sudo). install_release, latest_tag, recorded_tag
#    and the arch names all come from the shared module; an arch it has no names for leaves
#    rust_arch empty, which skips every download below rather than fetching a binary that would
#    tar-extract cleanly and then Exec-format-error at first use.
[ -n "$rust_arch" ] || echo "$TAG: unknown arch $(uname -m); skipping eza/fastfetch/curlie/sd/fzf/zoxide/ripgrep/gron/nvim/yazi" >&2
if [ -n "$rust_arch" ]; then
  install_release eza       eza-community/eza       "https://github.com/eza-community/eza/releases/latest/download/eza_${rust_arch}-unknown-linux-gnu.tar.gz"
  install_release fastfetch fastfetch-cli/fastfetch "https://github.com/fastfetch-cli/fastfetch/releases/latest/download/fastfetch-linux-${ff_arch}.tar.gz"
  install_release curlie    rs/curlie               "https://github.com/rs/curlie/releases/download/{tag}/curlie_{ver}_linux_${go_arch}.tar.gz"
  install_release sd        chmln/sd                "https://github.com/chmln/sd/releases/download/{tag}/sd-{tag}-${rust_arch}-unknown-linux-gnu.tar.gz"
  install_release starship  starship/starship       "https://github.com/starship/starship/releases/download/{tag}/starship-${rust_arch}-unknown-linux-gnu.tar.gz"
  # fzf/zoxide/ripgrep back the shell init (fzf keybindings, zoxide `cd`, rg as FZF_DEFAULT_COMMAND)
  # but have no apt/dnf field here, so install the current release binaries rather than relying on
  # the stale copies baked into the base image. ripgrep ships only musl on x86_64 and gnu on aarch64.
  install_release fzf       junegunn/fzf            "https://github.com/junegunn/fzf/releases/download/{tag}/fzf-{ver}-linux_${go_arch}.tar.gz"
  install_release zoxide    ajeetdsouza/zoxide      "https://github.com/ajeetdsouza/zoxide/releases/download/{tag}/zoxide-{ver}-${rust_arch}-unknown-linux-musl.tar.gz"
  install_release rg        BurntSushi/ripgrep      "https://github.com/BurntSushi/ripgrep/releases/download/{tag}/ripgrep-{ver}-${rg_target}.tar.gz"
  # gron is the one tools.toml entry whose distro coverage is uneven: apt has it, Fedora packages
  # none. Guarded on the binary rather than on PM, so it stays a no-op wherever the package phase
  # already supplied gron and the fallback isn't pinned to one distro's absence.
  command -v gron >/dev/null 2>&1 \
    || install_release gron tomnomnom/gron          "https://github.com/tomnomnom/gron/releases/download/{tag}/gron-linux-${go_arch}-{ver}.tgz"
fi

# 5. Neovim + Yazi. OS-UNIQUE tools handled elsewhere (winget on Windows, Brewfile on macOS) —
#    this is their Linux path. Neither fits the lone-binary install_release helper: nvim ships a
#    runtime tree, yazi ships a second binary (`ya`). No sudo. install_release_zip/
#    install_prefix_tarball take an already-resolved tag (see the module), so latest_tag runs here.
if [ -n "$rust_arch" ]; then
  # Neovim: official static release. The tarball is bin/ + its runtime under one prefix; merge it
  # into ~/.local so bin/nvim resolves ../share/nvim/runtime. nvim config self-bootstraps lazy.nvim.
  nvim_tag="$(latest_tag neovim/neovim)"
  if [ -n "$nvim_tag" ]; then
    install_prefix_tarball nvim "$nvim_tag" \
      "https://github.com/neovim/neovim/releases/download/{tag}/nvim-linux-${nvim_arch}.tar.gz" \
      "$HOME/.local" bin/nvim
  else
    echo "install-cli-tools: could not resolve latest tag for neovim/neovim" >&2
  fi
  # Yazi: release zip carrying both `yazi` and its `ya` plugin manager (ya pkg install is driven
  # by run_onchange_after_ya-pkg-install). yazi is listed first so it gates the recorded tag.
  yazi_tag="$(latest_tag sxyazi/yazi)"
  if [ -n "$yazi_tag" ]; then
    install_release_zip yazi "$yazi_tag" \
      "https://github.com/sxyazi/yazi/releases/download/{tag}/yazi-${rust_arch}-unknown-linux-gnu.zip" \
      yazi ya
  else
    echo "install-cli-tools: could not resolve latest tag for sxyazi/yazi" >&2
  fi
fi

# Fail loudly (and retry next apply) if any distro package is still missing — e.g. a sudo-less
# run. This runs after the file targets, so it does NOT block dotfile deployment. PM="" reports
# every check satisfied, so an unsupported distro converges on the release binaries instead of
# retrying a package install it can never perform.
still=""
for p in $PKGS; do
  pkg_installed "$p" || still="$still $p"
done
if [ -n "$still" ] || ! gh_ready || ! wez_ready; then
  [ -n "$still" ] && echo "install-cli-tools: packages still missing:$still" >&2
  gh_ready  || echo "install-cli-tools: GitHub CLI not configured yet" >&2
  wez_ready || echo "install-cli-tools: WezTerm not configured yet" >&2
  echo "install-cli-tools: re-run 'chezmoi apply' in a terminal where sudo can prompt." >&2
  exit 1
fi

# Only a fully converged run resets the age window. Stamping an incomplete one would turn "this
# machine still needs sudo" into a week of silence, which is exactly the failure the old
# run_once_ marker had: a script that has decided it is done when it is not.
printf '%s' "$TOOLS_KEY" > "$STAMP"
{{ end -}}

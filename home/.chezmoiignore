.config/wezterm
.config/fastfetch/logos-trimmed
.config/windows-provisioning
.wslconfig
bin
Scripts
.local/bin/jq
{{ end }}

# tasklist.exe / taskkill.exe symlinks are used only by wsl-clip-bridge (--status/--stop/
# --doctor) and point into /mnt/c, so deploy them only on WSL (a linux kernel reporting
# "microsoft"). Elsewhere they'd be dangling symlinks.
{{ if not (and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease))) }}
.local/bin/tasklist.exe
.local/bin/taskkill.exe
{{ end }}

# yazi: plugin & flavor code is vendored by `ya pkg install` from the tracked
# package.toml, so don't manage the fetched dirs — except the hand-written
# linemode-cycle plugin, which IS tracked here.
.config/yazi/plugins/*
!.config/yazi/plugins/linemode-cycle.yazi
.config/yazi/flavors

# nvim: lazy's lockfile is machine-local (stable branches, no pinning).
.config/nvim/lazy-lock.json

# claude artifacts: ~/.claude/artifacts is local scratch for plan/spec renders.
# Don't manage the dir by default — blocks `chezmoi add` on ad-hoc artifacts so
# scratch can't be swept upstream. Track only the specific plan files kept here.
.claude/artifacts/*
!.claude/artifacts/homelab-mcp-health-sweep_2026-07-23.html
!.claude/artifacts/homelab-mcp-health-sweep_2026-07-23.md

# Machine-local overrides must never enter this (public) repo. Blocks `chezmoi add`
# on any *.local.* file so a permission/secret override can't be swept upstream.
**/*.local.json
**/*.local.md
**/*.local.zsh
**/*.local.env
**/local.config

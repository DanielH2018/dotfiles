{{ if and (eq .chezmoi.os "linux") (ne .profile "minimal") (not (includeTemplate "is-agent" .)) (not (includeTemplate "is-toolbox" .)) -}}
#!/bin/sh
# Not in a distrobox/toolbox: it shares ~/.local/bin and chezmoi's run_onchange_ state with the
# host, so a build there would replace the host's tmux and stop the host rebuilding after a bump.
# The container builds its own copy in ~/.config/distrobox/claude-packages.sh.
# Builds tmux from the release tarball into ~/.local, shadowing the older distro tmux (Ubuntu
# ships 3.6a) because ~/.local/bin is ahead of /usr/bin on PATH. Needed because Claude Code's
# fullscreen TUI ("tui": "fullscreen") blanks / goes stale on a tmux pane-split until you scroll:
# tmux only implements synchronized output (DECSET 2026) from 3.7, with the end-of-update redraw
# fix in 3.7b. Upgrading tmux beats dropping to "tui":"default".
# run_onchange_after_: re-runs whenever this script's rendered content changes — bump TMUX_VERSION
# to pull a newer build. Linux + non-minimal only (the Pi opts out; macOS gets tmux via Brewfile).
# A sudo-less run defers the build-deps and exits 1 so chezmoi retries next apply, but the after_
# placement means that does NOT block dotfile deployment.
# The binary links the host's libtinfo, so an ncurses upgrade can leave it unable to start, and a
# broken tmux in BIN_DIR shadows the working distro one. The comment below renders the installed
# ncurses version, so chezmoi re-runs this script when that version changes; the skip check then
# rebuilds only a binary that no longer starts. A binary that does not start is deleted, so a
# deferred or failed rebuild leaves the distro tmux on PATH.
set -u
TAG=install-tmux
# host ncurses: {{ output "sh" "-c" "dpkg-query -W -f='${Version}' libtinfo6 2>/dev/null || rpm -q --qf '%{VERSION}-%{RELEASE}' ncurses-libs 2>/dev/null || true" | trim }}
{{ includeTemplate "linux-install.sh" . }}

# Renovate bumps this pin (renovate.json, the install-tmux manager). The release tarball has no
# checksum here, so a bump is the whole change.
# renovate: datasource=github-releases depName=tmux/tmux
TMUX_VERSION=3.8
PREFIX="$HOME/.local"

# Skip if a local build already satisfies the target — so a newer hand-build isn't clobbered and a
# running server's binary isn't needlessly churned (the fix only reaches sessions on a fresh server,
# so rebuilding an already-current tmux buys nothing). sort -V orders 3.6a < 3.7 < 3.7b < 3.8.
if [ -x "$BIN_DIR/tmux" ]; then
  have="$("$BIN_DIR/tmux" -V 2>/dev/null | awk '{print $2}')"
  if [ -n "$have" ] && [ "$(printf '%s\n%s\n' "$have" "$TMUX_VERSION" | sort -V | head -1)" = "$TMUX_VERSION" ]; then
    echo "$TAG: ~/.local/bin/tmux is $have (>= $TMUX_VERSION); skipping build" >&2
    exit 0
  fi
  if [ -z "$have" ]; then
    echo "$TAG: $BIN_DIR/tmux does not start; removing it so the system tmux is used, then rebuilding" >&2
    rm -f "$BIN_DIR/tmux"
  fi
fi

# Build-time deps only, so kept out of the shared tools.toml runtime inventory. Named per distro
# family — Debian's build-essential/-dev split has no single Fedora equivalent, so the Fedora list
# spells out the compiler and toolchain packages. Needs sudo, which prompts in an interactive
# terminal. An unrecognised distro (PM="") skips straight to the build and lets ./configure be the
# one to complain about a missing toolchain, rather than deferring on packages it cannot name.
# PM comes from linux-install.sh's own apt/dnf detection, included above.
case "$PM" in
  apt) DEPS="build-essential libevent-dev libncurses-dev pkg-config bison" ;;
  dnf) DEPS="gcc make libevent-devel ncurses-devel pkgconf-pkg-config bison" ;;
  *)   DEPS="" ;;
esac

missing=""
for p in $DEPS; do
  pkg_installed "$p" || missing="$missing $p"
done
if [ -n "$missing" ]; then
  if have_sudo; then
    # shellcheck disable=SC2086  # $missing is a space-separated package list; splitting intended
    pkg_install $missing
  else
    echo "$TAG: sudo unavailable; deferring build deps:$missing — re-run 'chezmoi apply' in a terminal where sudo can prompt." >&2
    exit 1
  fi
fi

# Fetch + build the release tarball into ~/.local (--prefix puts the binary at ~/.local/bin/tmux).
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
url="https://github.com/tmux/tmux/releases/download/${TMUX_VERSION}/tmux-${TMUX_VERSION}.tar.gz"
echo "$TAG: building tmux $TMUX_VERSION from source ..." >&2
if ! curl -fsSL "$url" -o "$tmp/tmux.tar.gz"; then
  echo "$TAG: failed to fetch $url" >&2; exit 1
fi
tar xzf "$tmp/tmux.tar.gz" -C "$tmp"
src="$tmp/tmux-${TMUX_VERSION}"
if ! ( cd "$src" && ./configure --prefix="$PREFIX" >/dev/null && make >/dev/null && make install >/dev/null ); then
  echo "$TAG: build failed" >&2; exit 1
fi
if ! built="$("$BIN_DIR/tmux" -V 2>&1)"; then
  echo "$TAG: the built tmux does not start ($built); removing it so the system tmux is used" >&2
  rm -f "$BIN_DIR/tmux"; exit 1
fi
echo "$TAG: installed $built to $BIN_DIR (run 'tmux kill-server' or restart WSL to pick it up)" >&2
{{ end -}}

#!/usr/bin/env bash
#
# land — integrate a branch through its PR, one branch at a time.
#
# Work here is fast-forward-linear and gets merged locally, after which the PR
# that a background job opened is closed unmerged: 10 of the first 27 went that
# way. The cost isn't bookkeeping. A branch rebased locally and merged leaves its
# remote ref behind, so the PR ends up holding commits that are byte-identical
# duplicates of what is already on main under different SHAs — PR #20 reached
# exactly that state before it was closed. Nothing serialises this either, so two
# sessions landing at once rebase onto a main the other is still moving.
#
# So: rebase, push the rebased branch, then fast-forward main onto that same ref.
# Same linear history, the PR is still the record, your signatures survive because
# main ends up on the very objects you signed, and the flock means the second
# lander waits for a settled main instead of racing it.
#
# Background jobs must not run this — they open draft PRs and stop there. This is
# the operator half: it is the only thing here that force-pushes, takes a PR out
# of draft, or merges.
#
#   land                 land the current branch
#   land <branch>        land <branch> (must be checked out in this worktree)
#   land --dry-run       print the plan, touch nothing
#
# Kept bash-3.2 clean, like the gate it leans on.
set -u

DRY=0
BRANCH=''
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) printf 'land: unknown flag %s\n' "$1" >&2; exit 2 ;;
    *) BRANCH=$1 ;;
  esac
  shift
done

die() { printf 'land: %s\n' "$1" >&2; exit 1; }
say() { printf '  %s\n' "$1"; }

command -v gh >/dev/null 2>&1 || die "gh is required (it does the merge)"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not in a git repo"

ROOT=$(git rev-parse --show-toplevel) || exit 1
CURRENT=$(git rev-parse --abbrev-ref HEAD) || exit 1
[ -n "$BRANCH" ] || BRANCH=$CURRENT

[ "$BRANCH" = "$CURRENT" ] ||
  die "$BRANCH is not checked out here (on $CURRENT) — run land from its worktree"

case "$BRANCH" in
  main|master|HEAD) die "refusing to land $BRANCH — it is the integration branch" ;;
esac

[ -z "$(git status --porcelain)" ] ||
  die "worktree is dirty — commit or set aside first, a rebase needs it clean"

# A rebase or merge already in flight would make everything below ambiguous.
GITDIR=$(git rev-parse --git-dir)
if [ -d "$GITDIR/rebase-merge" ] || [ -d "$GITDIR/rebase-apply" ]; then
  die "a rebase is in progress — finish or abort it first"
fi
if [ -f "$GITDIR/MERGE_HEAD" ]; then
  die "a merge is in progress — finish or abort it first"
fi

PR=$(gh pr list --head "$BRANCH" --state open --json number --jq '.[0].number' 2>/dev/null) || PR=''
[ -n "$PR" ] ||
  die "no open PR for $BRANCH — open one first (gh pr create), so the merge has a record"

# One lander at a time, across every worktree of this repo: the common dir is
# shared by all of them, a per-worktree lock would not be.
COMMON=$(git rev-parse --git-common-dir)
case "$COMMON" in /*) ;; *) COMMON=$ROOT/$COMMON ;; esac
LOCK="$COMMON/land.lock"

if [ "$DRY" -eq 1 ]; then
  printf 'land --dry-run: %s (PR #%s)\n' "$BRANCH" "$PR"
  say "lock    $LOCK"
  say "fetch   origin"
  say "rebase  $BRANCH onto origin/main"
  say "push    --force-with-lease (runs the pre-push gate)"
  say "ready   gh pr ready $PR (only if it is still a draft)"
  say "merge   git push origin $BRANCH:main (fast-forward; keeps your signatures)"
  say "close   gh pr close $PR (only if GitHub has not marked it merged)"
  say "delete  git push origin --delete $BRANCH"
  exit 0
fi

land() {
  printf 'landing %s (PR #%s)\n' "$BRANCH" "$PR"

  git fetch origin || return 1

  # Rebase before the gate, so what gets tested is what gets merged.
  if ! git rebase origin/main; then
    git rebase --abort 2>/dev/null
    printf 'land: %s does not rebase cleanly onto origin/main — resolve by hand\n' "$BRANCH" >&2
    return 1
  fi

  # --force-with-lease, never plain --force: if someone else moved the remote
  # branch while we held the lock, this refuses rather than discarding their work.
  # The push runs the pre-push gate, so a red suite stops the landing here.
  git push --force-with-lease origin "$BRANCH" || return 1

  # Every PR here arrives as a draft — that is the convention background jobs
  # follow — and GitHub refuses to merge one: "Pull Request is still a draft".
  # Landing it is the operator saying it is ready, so say so and carry on.
  if [ "$(gh pr view "$PR" --json isDraft --jq '.isDraft' 2>/dev/null)" = "true" ]; then
    say "PR #$PR is a draft — marking it ready"
    gh pr ready "$PR" || return 1
  fi

  # Fast-forward main onto the branch rather than `gh pr merge --rebase`. That
  # replayed the commits server-side into fresh objects carrying no signature, so
  # every landing put unsigned commits on main — 12 of the 16 before this changed,
  # including 4f52f8b, the commit that added the signing gate. Worse, a branch
  # rebased onto that main inherited them into its own push range and the gate
  # rejected the push for history the branch never wrote.
  #
  # The branch was rebased onto origin/main and pushed above, so main can just be
  # moved to that same ref: identical objects, signatures intact, history still
  # linear, and the PR still holds exactly the commits that landed. This is not
  # the local-merge trap in the header either — there the PR kept pre-rebase SHAs
  # while main got different ones; here they are the same objects.
  git push -q origin "$BRANCH:main" || return 1

  # GitHub marks a PR merged once its head commits are reachable from the base.
  # If it has not, say what happened rather than leaving it open unexplained.
  if [ "$(gh pr view "$PR" --json state --jq '.state' 2>/dev/null)" = "OPEN" ]; then
    gh pr close "$PR" --comment "Landed on main as $(git rev-parse --short HEAD)." ||
      say "PR #$PR is still open — close it by hand"
  fi

  # Deliberately not gh's --delete-branch. Its local half checks out the default
  # branch, which cannot work here: main is held by the primary worktree, so gh
  # fails with "'main' is already used by worktree at ..." *after* the landing has
  # gone through. The landing then reports as failed when it succeeded, and the
  # branch it promised to delete is still on the remote. Delete the remote ref
  # with git, which has no opinion about checkouts.

  if git ls-remote --exit-code --heads origin "$BRANCH" >/dev/null 2>&1; then
    git push -q origin --delete "$BRANCH" ||
      say "could not delete origin/$BRANCH — delete it by hand"
  fi

  printf 'landed %s (PR #%s)\n' "$BRANCH" "$PR"
  # The local branch is checked out right here, so it cannot delete itself — even
  # though main now points at exactly these commits, which is new: before the
  # fast-forward the landed SHAs differed and -d would have refused them too.
  say "worktree still holds $BRANCH; from the primary: git worktree remove <path> && git branch -D $BRANCH"
}

if command -v flock >/dev/null 2>&1; then
  exec 9>"$LOCK" || die "cannot open $LOCK"
  if ! flock -n 9; then
    say "another worktree is landing; waiting for it to finish..."
    flock 9 || die "could not take $LOCK"
  fi
  land
  rc=$?
  exec 9>&-
  exit $rc
fi

# No flock (macOS): still worth doing, just without the mutual exclusion.
say "flock unavailable — landing without the cross-worktree lock"
land

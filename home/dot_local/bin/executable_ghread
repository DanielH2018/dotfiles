#!/usr/bin/env python3
"""ghread — read GitHub through gh without a prompt, and never write to it.

Exists for the same reason as `jsonq` and `otelq`. `gh` is the GitHub path here
(WebFetch to github.com is denied), and `gh` cannot run in the sandbox: it loses
the keychain token and macOS TLS trust (settings.base.json has the measurement).
So every useful call runs unsandboxed, where an allow rule is the only gate, and
gh's own surface is too wide for a blanket rule: `gh api` takes a method, a
request body and graphql, and the shell redirect a caller adds to keep a big
response out of context prompts on its own.

What makes a blanket `Bash(ghread:*)` allow rule defensible is construction, not
a check on gh's argv. Every subcommand below builds a fixed gh invocation from
constants and validated values:

  - No caller string is passed through as an argument of its own. A value
    travels inside one `--flag=value` element, and the one positional (a PR,
    issue or run selector, or an api path) sits after `--` and must not start
    with `-`. So no caller text can become a gh flag.
  - `gh api` only ever sends a GET. With no field it sends no method flag and
    stays on gh's default GET. With fields it sends `--method=GET` itself, so a
    field becomes a query parameter and never a request body. Every field
    travels as `--raw-field`, so gh's `-F key=@file` never reads a local file.
    `--input` is never sent, and `api` refuses a graphql path.
  - `graphql` is the one POST. It sends a query document to gh's fixed
    `graphql` endpoint, and refuses a document that names `mutation` or
    `subscription` anywhere, so only a read operation can reach GitHub.
  - `--out` writes only under a scratch root, and refuses a symlink or hard link
    as the target, so it replaces `> file` without becoming a write primitive.
  - gh is found in fixed system directories, never through the caller's $PATH,
    and its environment drops GH_HOST, GH_CONFIG_DIR, the enterprise tokens and
    every DYLD_/LD_ variable, with HOME pinned to the account's home. So a
    prefix such as `PATH=./bin ghread ...` or `GH_HOST=x ghread ...` cannot
    choose the binary or aim the token at another host.
  - `run failures` is the one subcommand that makes several gh calls. Each is an
    `api` GET or a `run view --log`, built the same way from constants and
    validated numbers or a hex sha, and ghread reads the responses itself to
    choose the next call.
  - On a host with the homelab package, each call is counted in the GitHub quota
    ledger before gh runs. The ledger module loads from one fixed path, never
    through sys.path, and its GH_QUOTA_DIR override is dropped with the variables
    above, so no caller value picks the module or the directory it writes. A
    module that is absent or fails to load leaves the call as it would be without
    it.

  ghread pr view 123 -R owner/repo --json title,state
  ghread pr comments 123 -R owner/repo --kind issue
  ghread run logs 4567 --failed --out /tmp/run.log
  ghread run logs 4567 --attempt 1 --failed
  ghread run failures --pr 123 -R owner/repo
  ghread run failures 4567
  ghread run failures 3f2a9c1
  ghread api repos/owner/repo/pulls --paginate --jq '.[].number'
  ghread api -X GET search/issues -f q='repo:owner/repo is:open' -f per_page=10
  ghread graphql -f query='{ repository(owner:"o", name:"r") { stargazerCount } }'
  ghread graphql -f query='query($n: Int!) { viewer { login } }' -F n=1 --jq .data
  ghread search prs -R owner/repo --state open -- 'review:required'
  ghread stack view --short

gh's exit status is ghread's exit status. A refusal ghread raises itself exits 2.
`run failures` exits 0 once it has read every failed run, and otherwise with the
status of the first gh call that failed.
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
import pwd
import re
import stat
import subprocess
import sys

PROG = "ghread"

# Where gh is looked up. Not $PATH: a caller-supplied PATH would let a repo file
# named `gh` run unsandboxed under this rule.
GH_DIRS = ("/opt/homebrew/bin", "/usr/local/bin", "/usr/bin")
_DROP_ENV = (
    "GH_HOST",
    "GH_CONFIG_DIR",
    "GH_ENTERPRISE_TOKEN",
    "GITHUB_ENTERPRISE_TOKEN",
    "DYLD_",
    "LD_",
    "GH_QUOTA_DIR",
)
# The GitHub quota ledger from the homelab host package. Absent off those hosts.
GH_QUOTA = "/usr/lib/homelab/gh_quota.py"

# A selector is a PR or issue number, a branch name, or a github.com URL. The
# first character class is what keeps a value from ever reading as a flag.
_SELECTOR = re.compile(
    r"^(?:[0-9]+"
    r"|[A-Za-z0-9][A-Za-z0-9._/-]*"
    r"|https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/(?:pull|issues)/[0-9]+)$"
)
_NUMBER = re.compile(r"^[0-9]+$")
# gh reads `--attempt=0` as "the latest attempt", the opposite of naming one.
_ATTEMPT = re.compile(r"^[1-9][0-9]*$")
_SHA = re.compile(r"^[0-9a-f]{7,40}$")
_REPO = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9_.-]+$")
_FIELDS = re.compile(r"^[A-Za-z]+(?:,[A-Za-z]+)*$")
# An api path: relative or rooted, gh's {owner}/{repo}/{branch} placeholders,
# and a query string. `:` is allowed because search qualifiers (`q=repo:x`)
# need it, so build_api refuses `//` separately: gh treats a full URL as the
# endpoint and would send the token to whatever host it names.
_API_PATH = re.compile(r"^/?[A-Za-z0-9{][A-Za-z0-9_.~{}/?=&,%:+@-]*$")
# gh's jq is gojq, which exposes the process environment as `$ENV` and `env`.
# Nothing else in it reaches outside the response, so these are all it refuses.
# A field name for `api -f/-F`: gh's `key[]` array form is allowed, nothing
# that could carry an `=` or a nested path.
_FIELD_KEY = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*(?:\[\])?$")
_JQ_ENV = re.compile(r"\$ENV\b|\benv\b|\$__prog_env\b")
_CONTROL = re.compile(r"[\x00-\x1f\x7f]")

MAX_TEXT = 4096
# A graphql document with a dozen aliased pullRequest lookups passes 4096 easily.
MAX_QUERY = 65536
# GraphQL names are [_A-Za-z][_0-9A-Za-z]*, with no escape that could spell one, so an
# operation keyword appears in the document as these letters in a row or not at all. A
# plain substring match is therefore enough, and it over-refuses a field or string that
# merely contains the word, which costs a rewording and nothing else.
_GRAPHQL_WRITE = re.compile(r"mutation|subscription", re.IGNORECASE)
# A document may span lines; every other control character is still refused.
_QUERY_CONTROL = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")
MAX_LIMIT = 1000

# Scratch roots for --out. TMPDIR comes from the caller's environment, so it is
# trusted only when it resolves under one of these; a prefix assignment such as
# `TMPDIR=$HOME ghread ...` therefore cannot widen where --out may write.
_FIXED_SCRATCH = ("/tmp", "/private/tmp")
_TMPDIR_PARENTS = ("/tmp", "/private/tmp", "/private/var/folders")


class GhreadError(Exception):
    """A refusal ghread raises itself, reported without a traceback."""


def _within(path: str, root: str) -> bool:
    return path == root or path.startswith(root.rstrip("/") + "/")


def _check(pattern: re.Pattern, value: str, what: str) -> str:
    if not pattern.match(value):
        raise GhreadError(f"refusing {what} {value!r}")
    return value


def _text(value: str, what: str) -> str:
    """A free-text filter value such as a search query or a label name."""
    if len(value) > MAX_TEXT or _CONTROL.search(value):
        raise GhreadError(f"refusing {what}: too long or contains a control character")
    return value


def _jq(expr: str) -> str:
    _text(expr, "--jq")
    if _JQ_ENV.search(expr):
        raise GhreadError("refusing --jq that reads the environment ($ENV or env)")
    return expr


def _limit(value: str) -> int:
    try:
        n = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a number: {value!r}") from None
    if not 1 <= n <= MAX_LIMIT:
        raise argparse.ArgumentTypeError(f"must be 1..{MAX_LIMIT}")
    return n


def scratch_roots() -> list[str]:
    roots = [os.path.realpath(r) for r in _FIXED_SCRATCH if os.path.isdir(r)]
    tmpdir = os.environ.get("TMPDIR")
    if tmpdir:
        real = os.path.realpath(tmpdir)
        parents = [os.path.realpath(p) for p in _TMPDIR_PARENTS]
        if any(_within(real, p) and real != p for p in parents):
            roots.append(real)
    return list(dict.fromkeys(roots))


def open_out(path: str) -> int:
    """Open --out for writing, or refuse.

    The parent directory is resolved, so `/tmp` reaching `/private/tmp` through a
    symlink is fine. The final component is not: O_NOFOLLOW refuses a symlink
    there. The file is opened without O_TRUNC and truncated only after fstat
    shows a regular file with one link, because a hard link planted in /tmp to a
    file under $HOME shares a filesystem with it and would otherwise be written
    through.

    Returns:
      An open file descriptor, truncated and ready to receive gh's stdout.

    Raises:
      GhreadError: the path is outside every scratch root, or is not a plain
        single-link regular file.
    """
    absolute = os.path.abspath(path)
    name = os.path.basename(absolute)
    if not name or name in (".", ".."):
        raise GhreadError(f"--out {path!r} names a directory, not a file")
    parent = os.path.realpath(os.path.dirname(absolute))
    target = os.path.join(parent, name)
    roots = scratch_roots()
    if not any(_within(parent, r) for r in roots):
        raise GhreadError(
            f"--out {path!r} is outside the scratch roots ({', '.join(roots)})"
        )
    try:
        fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError as exc:
        raise GhreadError(
            f"--out {path!r}: {exc.strerror} (symlinks are refused)"
        ) from None
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
        os.close(fd)
        raise GhreadError(f"--out {path!r} is not a single-link regular file")
    os.ftruncate(fd, 0)
    return fd


def _repo_flag(ns) -> list[str]:
    return [f"--repo={_check(_REPO, ns.repo, '--repo')}"] if ns.repo else []


def _json_flags(ns) -> list[str]:
    out = []
    if ns.json:
        out.append(f"--json={_check(_FIELDS, ns.json, '--json')}")
    if ns.jq:
        if not ns.json:
            raise GhreadError("--jq needs --json")
        out.append(f"--jq={_jq(ns.jq)}")
    return out


def _value_flags(ns, names: tuple[str, ...]) -> list[str]:
    out = []
    for name in names:
        value = getattr(ns, name)
        if value is not None:
            out.append(f"--{name}={_text(str(value), '--' + name)}")
    return out


def build_pr(ns) -> list[str]:
    if ns.verb == "list":
        return (
            ["pr", "list"]
            + _repo_flag(ns)
            + _value_flags(
                ns, ("state", "limit", "author", "base", "head", "label", "search")
            )
            + _json_flags(ns)
        )
    if ns.verb == "comments":
        number = _check(_NUMBER, ns.selector, "PR number")
        repo = _check(_REPO, ns.repo, "--repo") if ns.repo else "{owner}/{repo}"
        kind = "pulls" if ns.kind == "review" else "issues"
        argv = ["api", "--paginate"]
        if ns.jq:
            argv.append(f"--jq={_jq(ns.jq)}")
        return argv + ["--", f"repos/{repo}/{kind}/{number}/comments"]
    selector = _check(_SELECTOR, ns.selector, "selector")
    argv = ["pr", ns.verb] + _repo_flag(ns)
    if ns.verb == "view":
        argv += (["--comments"] if ns.comments else []) + _json_flags(ns)
    elif ns.verb == "checks":
        argv += (["--required"] if ns.required else []) + _json_flags(ns)
    elif ns.verb == "diff":
        argv += ["--color=never"] + (["--name-only"] if ns.name_only else [])
    return argv + ["--", selector]


def build_issue(ns) -> list[str]:
    if ns.verb == "list":
        return (
            ["issue", "list"]
            + _repo_flag(ns)
            + _value_flags(
                ns, ("state", "limit", "author", "assignee", "label", "search")
            )
            + _json_flags(ns)
        )
    selector = _check(_SELECTOR, ns.selector, "selector")
    return (
        ["issue", "view"]
        + _repo_flag(ns)
        + (["--comments"] if ns.comments else [])
        + _json_flags(ns)
        + ["--", selector]
    )


def build_run(ns) -> list[str]:
    if ns.verb == "list":
        return (
            ["run", "list"]
            + _repo_flag(ns)
            + _value_flags(
                ns, ("branch", "workflow", "status", "limit", "created", "commit")
            )
            + _json_flags(ns)
        )
    run_id = _check(_NUMBER, ns.run_id, "run id")
    argv = ["run", "view"] + _repo_flag(ns)
    if ns.job:
        argv.append(f"--job={_check(_NUMBER, ns.job, '--job')}")
    if ns.attempt is not None:
        argv.append(f"--attempt={_check(_ATTEMPT, ns.attempt, '--attempt')}")
    if ns.verb == "logs":
        argv.append("--log-failed" if ns.failed else "--log")
    else:
        argv += _json_flags(ns)
    return argv + ["--", run_id]


def _api_fields(ns) -> list[str]:
    """`-f`/`-F` as GET query parameters, each sent as one `--raw-field`.

    gh switches to POST as soon as a field is present, so a field never reaches
    gh without `--method=GET` ahead of it. `-F` is sent as a raw field as well:
    gh's typed `-F` reads a file for `key=@path` and stdin for `key=@-`, and a
    query string has no use for its type conversion.
    """
    out = []
    for flag, items in (("-f", ns.raw_field or []), ("-F", ns.field or [])):
        for item in items:
            key, sep, value = item.partition("=")
            if not sep:
                raise GhreadError(f"refusing {flag} {item!r}: expected key=value")
            _check(_FIELD_KEY, key, f"{flag} key")
            _text(value, f"{flag} {key}")
            if flag == "-F" and value.startswith("@"):
                raise GhreadError(f"refusing -F {key}=@...: gh would read a file")
            out.append(f"--raw-field={key}={value}")
    return ["--method=GET"] + out if out else []


def build_api(ns) -> list[str]:
    path = _check(_API_PATH, ns.path, "api path")
    if "//" in path:
        raise GhreadError(f"refusing api path {path!r}: a URL, not a path")
    if "graphql" in path.lower():
        raise GhreadError("refusing graphql: it carries mutations over the same POST")
    argv = ["api"] + _api_fields(ns)
    if ns.paginate:
        argv.append("--paginate")
    if ns.jq:
        argv.append(f"--jq={_jq(ns.jq)}")
    return argv + ["--", path]


def _graphql_query(doc: str) -> str:
    if len(doc) > MAX_QUERY or _QUERY_CONTROL.search(doc):
        raise GhreadError("refusing query: too long or contains a control character")
    if _GRAPHQL_WRITE.search(doc):
        raise GhreadError(
            "refusing a graphql document that contains `mutation` or `subscription`:"
            " graphql reads only"
        )
    return doc


def build_graphql(ns) -> list[str]:
    """One POST to gh's fixed `graphql` endpoint, carrying a read-only document.

    The document is the `query` field and nothing else may carry one: `--input` is never
    sent and every field goes through `_graphql_query` or `_text`. Unlike `api`, `-F` is
    sent as gh's typed `--field`, because a variable declared `Int!` rejects the string
    a raw field would send. An `@` value is still refused, so `-F` never reads a file.
    """
    query = None
    out = []
    for flag, items in (("-f", ns.raw_field or []), ("-F", ns.field or [])):
        for item in items:
            key, sep, value = item.partition("=")
            if not sep:
                raise GhreadError(f"refusing {flag} {item!r}: expected key=value")
            _check(_FIELD_KEY, key, f"{flag} key")
            # gh lifts `query` and `operationName` out of the variables by their base
            # name, so `query[]=...` would carry a second document past the check.
            if key != "query" and key.removesuffix("[]") in ("query", "operationName"):
                raise GhreadError(f"refusing {flag} {key}: only one plain query field")
            if key == "query":
                if query is not None:
                    raise GhreadError("refusing a second query field")
                query = _graphql_query(value)
                continue
            _text(value, f"{flag} {key}")
            if flag == "-F" and value.startswith("@"):
                raise GhreadError(f"refusing -F {key}=@...: gh would read a file")
            kind = "field" if flag == "-F" else "raw-field"
            out.append(f"--{kind}={key}={value}")
    if query is None:
        raise GhreadError("graphql needs -f query='...'")
    argv = ["api", f"--raw-field=query={query}"] + out
    if ns.paginate:
        argv.append("--paginate")
    if ns.jq:
        argv.append(f"--jq={_jq(ns.jq)}")
    return argv + ["--", "graphql"]


def build_search(ns) -> list[str]:
    terms = [_text(t, "search term") for t in ns.terms]
    if not terms:
        raise GhreadError("search needs at least one query term")
    return (
        ["search", ns.kind]
        + _repo_flag(ns)
        + _value_flags(
            ns,
            ("owner", "state", "limit", "author", "label", "language", "sort", "order"),
        )
        + _json_flags(ns)
        + ["--", *terms]
    )


def build_stack(ns) -> list[str]:
    return (
        ["stack", "view"]
        + (["--json"] if ns.json else [])
        + (["--short"] if ns.short else [])
    )


# `gh run view --log` prefixes every line with the job, the step and the time GitHub
# received it, and a step's first line with a byte-order mark.
_LOG_PREFIX = re.compile(r"^(?:[^\t]*\t){2}\ufeff?(?:\d{4}-\d\d-\d\dT[\d:.]+Z )?")
# Colour codes and every other control character, so the digest is plain text.
_ESCAPES = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|[\x00-\x08\x0b-\x1f\x7f]")
# The id of a failing test, one pattern per runner: pytest, TAP (node:test, bats),
# node:test's spec reporter, and go test.
_FAILED_TEST = (
    re.compile(r"^(?:FAILED|ERROR) (\S+)"),
    re.compile(r"^\s*not ok \d+ - (.+?)(?: # .*)?$"),
    re.compile(r"^\s*✖ (.+?)(?: \([\d.]+m?s\))?$"),
    re.compile(r"^\s*--- FAIL: (\S+)"),
)
# Lines that say what went wrong or how many tests failed. `##[error]` is GitHub's
# own marker, so a failed lint or install step shows up without a test runner.
_ERROR_LINE = re.compile(
    r"^E   "
    r"|^##\[error\]"
    r"|\b\w*(?:Error|Exception)(?::| \[)"
    r"|^=+ .*\b(?:failed|errors?)\b.* =+$"
    r"|^# (?:fail|pass) \d+$"
    r"|^\s+error: (?!\|)"
)
# node:test's TAP block for a failure holds a multi-line message as `error: |-`;
# its first line is the one that says what went wrong.
_TAP_ERROR_BLOCK = re.compile(r"^\s+error: \|-?$")
FAILED_CONCLUSIONS = ("failure", "timed_out", "startup_failure")
MAX_TESTS = 30
MAX_ERRORS = 40
MAX_ANNOTATIONS = 20
MAX_LINE = 300


class GhFailed(Exception):
    """A gh call that exited non-zero; `code` is its exit status."""

    def __init__(self, code: int, message: str):
        super().__init__(message)
        self.code = code


def digest_log(log: str) -> tuple[list[str], list[str]]:
    """The failing test ids and the error lines in one job's raw log, deduplicated."""
    tests: dict[str, None] = {}
    errors: dict[str, None] = {}
    in_block = False
    for raw in log.splitlines():
        line = _ESCAPES.sub("", _LOG_PREFIX.sub("", raw)).rstrip()
        if in_block and line.strip():
            errors.setdefault(line[:MAX_LINE], None)
            in_block = False
            continue
        in_block = bool(_TAP_ERROR_BLOCK.match(line))
        for pattern in _FAILED_TEST:
            m = pattern.match(line)
            if m:
                tests.setdefault(m.group(1), None)
                break
        if _ERROR_LINE.search(line):
            errors.setdefault(line[:MAX_LINE], None)
    return list(tests)[:MAX_TESTS], list(errors)[-MAX_ERRORS:]


def gh_output(gh: str, env: dict, args: list[str]) -> str:
    """stdout of `gh <args>`, recorded in the quota ledger first.

    Raises:
      GhFailed: gh exited non-zero.
    """
    record_quota(args, env, gh)
    out = subprocess.run(
        [gh, *args],
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        env=env,
        check=False,
    )
    if out.returncode:
        cmd = f"gh {args[0]} {args[-1]}"
        raise GhFailed(out.returncode, f"{cmd}: {out.stderr.strip()[-500:]}")
    return out.stdout


def _api(call, path: str, fields: tuple = ()):
    """The parsed JSON of a `gh api` GET of `path`, `fields` as query parameters."""
    args = ["api"]
    if fields:
        args += ["--method=GET"] + [f"--raw-field={k}={v}" for k, v in fields]
    return json.loads(call(args + ["--", path]))


def _failed_runs(call, repo: str, ns) -> list[int]:
    if ns.target and _NUMBER.match(ns.target):
        return [int(ns.target)]
    if ns.pr:
        pr = _check(_NUMBER, ns.pr, "--pr")
        sha = _api(call, f"repos/{repo}/pulls/{pr}")["head"]["sha"]
    else:
        short = _check(_SHA, ns.target, "run id or sha")
        sha = _api(call, f"repos/{repo}/commits/{short}")["sha"]
    _check(_SHA, sha, "head sha")
    runs = _api(
        call, f"repos/{repo}/actions/runs", (("head_sha", sha), ("per_page", "100"))
    )["workflow_runs"]
    return [r["id"] for r in runs if r.get("conclusion") in FAILED_CONCLUSIONS]


def _annotations(call, repo: str, job: dict) -> list[str]:
    m = re.search(r"/check-runs/([0-9]+)$", job.get("check_run_url") or "")
    if not m:
        return []
    out = []
    for a in _api(call, f"repos/{repo}/check-runs/{m.group(1)}/annotations"):
        where = a.get("path") or ""
        if a.get("start_line"):
            where += f":{a['start_line']}"
        message = " ".join((a.get("message") or "").split())[:MAX_LINE]
        level = a.get("annotation_level")
        out.append(" ".join(x for x in (level, where, message) if x))
    return out[:MAX_ANNOTATIONS]


def run_failures(ns, call) -> str:
    """The `run failures` digest: each failed job's tests, errors and annotations.

    Args:
      ns: the parsed `run failures` arguments.
      call: `gh_output` with gh and its environment bound.

    Raises:
      GhreadError: the target is missing, doubled or malformed.
      GhFailed: a gh call failed.
    """
    if bool(ns.pr) == bool(ns.target):
        raise GhreadError("run failures needs exactly one of: a run id, a sha, --pr N")
    if ns.target and not (_NUMBER.match(ns.target) or _SHA.match(ns.target)):
        raise GhreadError(f"refusing run id or sha {ns.target!r}")
    repo = _check(_REPO, ns.repo, "--repo") if ns.repo else "{owner}/{repo}"
    run_ids = _failed_runs(call, repo, ns)
    if not run_ids:
        return "no failed runs\n"
    lines = []
    for run_id in run_ids:
        run = _api(call, f"repos/{repo}/actions/runs/{run_id}")
        jobs = _api(
            call,
            f"repos/{repo}/actions/runs/{run_id}/jobs",
            (("filter", "latest"), ("per_page", "100")),
        )["jobs"]
        failed = [j for j in jobs if j.get("conclusion") in FAILED_CONCLUSIONS]
        lines.append(
            f"run {run_id} {run.get('name', '')} ({run.get('conclusion')})"
            f" {run.get('html_url', '')}".rstrip()
        )
        if not failed:
            lines.append("  no failed jobs")
        for job in failed:
            lines.append(
                f"  job {job['name']} ({job['conclusion']})"
                f" {job.get('html_url', '')}".rstrip()
            )
            steps = [
                s["name"]
                for s in job.get("steps") or []
                if s.get("conclusion") in FAILED_CONCLUSIONS
            ]
            if steps:
                lines.append(f"    failed steps: {', '.join(steps)}")
            # `api .../jobs/ID/logs` refuses a log with escape codes in it; `run view`
            # prints it.
            log = call(
                ["run", "view", *_repo_flag(ns), f"--job={job['id']}", "--log"]
                + ["--", str(run_id)]
            )
            tests, errors = digest_log(log)
            for title, rows in (
                ("failing tests", tests),
                ("errors", errors),
                ("annotations", _annotations(call, repo, job)),
            ):
                if rows:
                    lines.append(f"    {title}:")
                    lines += [f"      {r}" for r in rows]
    return "\n".join(lines) + "\n"


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Read GitHub through gh: REST GET or a graphql query.",
    )
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "--out",
        metavar="PATH",
        help="write gh's stdout here; must be under $TMPDIR or /tmp",
    )
    repo = argparse.ArgumentParser(add_help=False)
    repo.add_argument("-R", "--repo", help="OWNER/REPO (default: the cwd's repository)")
    json_ = argparse.ArgumentParser(add_help=False)
    json_.add_argument("--json", metavar="FIELDS", help="comma-separated JSON fields")
    json_.add_argument("-q", "--jq", metavar="EXPR", help="filter --json output")
    listing = argparse.ArgumentParser(add_help=False)
    listing.add_argument("--state", choices=("open", "closed", "merged", "all"))
    listing.add_argument("-L", "--limit", type=_limit)
    listing.add_argument("--author")
    listing.add_argument("--label")
    listing.add_argument("--search")

    top = parser.add_subparsers(dest="cmd", required=True)

    pr = top.add_parser("pr", help="pull requests").add_subparsers(
        dest="verb", required=True
    )
    p = pr.add_parser("view", parents=[common, repo, json_])
    p.add_argument("selector")
    p.add_argument("--comments", action="store_true")
    p = pr.add_parser("list", parents=[common, repo, json_, listing])
    p.add_argument("--base")
    p.add_argument("--head")
    p = pr.add_parser("checks", parents=[common, repo, json_])
    p.add_argument("selector")
    p.add_argument("--required", action="store_true")
    p = pr.add_parser("diff", parents=[common, repo])
    p.add_argument("selector")
    p.add_argument("--name-only", action="store_true")
    p = pr.add_parser(
        "comments",
        parents=[common, repo],
        help="review comments (default) or issue comments, via the REST API",
    )
    p.add_argument("selector", help="PR number")
    p.add_argument("--kind", choices=("review", "issue"), default="review")
    p.add_argument("-q", "--jq", metavar="EXPR")

    issue = top.add_parser("issue", help="issues").add_subparsers(
        dest="verb", required=True
    )
    p = issue.add_parser("view", parents=[common, repo, json_])
    p.add_argument("selector")
    p.add_argument("--comments", action="store_true")
    p = issue.add_parser("list", parents=[common, repo, json_, listing])
    p.add_argument("--assignee")

    run = top.add_parser("run", help="workflow runs").add_subparsers(
        dest="verb", required=True
    )
    p = run.add_parser("list", parents=[common, repo, json_])
    p.add_argument("-b", "--branch")
    p.add_argument("-w", "--workflow")
    p.add_argument("-s", "--status")
    p.add_argument("-L", "--limit", type=_limit)
    p.add_argument("--created", help="e.g. >2026-10-01")
    p.add_argument("-c", "--commit", help="a commit SHA")
    p = run.add_parser("view", parents=[common, repo, json_])
    p.add_argument("run_id")
    p.add_argument("--job")
    p.add_argument("-a", "--attempt", help="an attempt number (default: the latest)")
    p = run.add_parser("logs", parents=[common, repo], help="gh run view --log")
    p.add_argument("run_id")
    p.add_argument("--job")
    p.add_argument("-a", "--attempt", help="an attempt number (default: the latest)")
    p.add_argument("--failed", action="store_true", help="only the failed steps")
    p = run.add_parser(
        "failures",
        parents=[common, repo],
        help="each failed job's test ids, error lines and annotations",
    )
    p.add_argument("target", nargs="?", metavar="RUN_ID|SHA")
    p.add_argument("--pr", metavar="N", help="the failed runs on this PR's head commit")

    p = top.add_parser("api", parents=[common], help="GET one REST path")
    p.add_argument("path")
    p.add_argument(
        "-X",
        "--method",
        choices=("GET",),
        help="accepted for gh compatibility; GET is the only method",
    )
    p.add_argument(
        "-f",
        "--raw-field",
        action="append",
        metavar="KEY=VALUE",
        help="a query parameter (repeatable)",
    )
    p.add_argument(
        "-F",
        "--field",
        action="append",
        metavar="KEY=VALUE",
        help="same as -f; sent raw, and an @file value is refused",
    )
    p.add_argument("--paginate", action="store_true")
    p.add_argument("-q", "--jq", metavar="EXPR")

    p = top.add_parser(
        "graphql", parents=[common], help="POST one read-only graphql query document"
    )
    p.add_argument(
        "-f",
        "--raw-field",
        action="append",
        metavar="KEY=VALUE",
        help="query=DOCUMENT (required, once), or a string variable",
    )
    p.add_argument(
        "-F",
        "--field",
        action="append",
        metavar="KEY=VALUE",
        help="a typed variable (number, true, false, null); an @file value is refused",
    )
    p.add_argument("--paginate", action="store_true", help="follow $endCursor")
    p.add_argument("-q", "--jq", metavar="EXPR")

    p = top.add_parser(
        "search", parents=[common, repo, json_], help="gh search; query after --"
    )
    p.add_argument("kind", choices=("prs", "issues", "code", "repos", "commits"))
    p.add_argument("terms", nargs="*", metavar="TERM")
    p.add_argument("--owner")
    p.add_argument("--state", choices=("open", "closed"))
    p.add_argument("-L", "--limit", type=_limit)
    p.add_argument("--author")
    p.add_argument("--label")
    p.add_argument("--language")
    p.add_argument("--sort")
    p.add_argument("--order", choices=("asc", "desc"))

    stack = top.add_parser("stack", help="gh stack").add_subparsers(
        dest="verb", required=True
    )
    p = stack.add_parser("view", parents=[common])
    p.add_argument("--json", action="store_true")
    p.add_argument("-s", "--short", action="store_true")
    return parser


BUILDERS = {
    "pr": build_pr,
    "issue": build_issue,
    "run": build_run,
    "api": build_api,
    "graphql": build_graphql,
    "search": build_search,
    "stack": build_stack,
}


def find_gh() -> str:
    for d in GH_DIRS:
        path = os.path.join(d, "gh")
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    raise GhreadError(f"gh is not in {', '.join(GH_DIRS)}")


def gh_env() -> dict:
    env = {k: v for k, v in os.environ.items() if not k.startswith(_DROP_ENV)}
    env["HOME"] = pwd.getpwuid(os.getuid()).pw_dir
    env["PATH"] = ":".join(GH_DIRS + ("/bin", "/usr/sbin", "/sbin"))
    # gh pages to $PAGER on a terminal and prompts on stdin; neither belongs in
    # a non-interactive reader.
    env.update(GH_PAGER="cat", GH_PROMPT_DISABLED="1", GH_NO_UPDATE_NOTIFIER="1")
    return env


def record_quota(gh_args: list[str], env: dict, gh: str) -> None:
    """Count this gh call in the GitHub quota ledger, when the host has one.

    Loads the ledger module from GH_QUOTA only. Any failure to load or record is
    swallowed: the ledger only counts, and must never stop a read.
    """
    if not os.path.isfile(GH_QUOTA):
        return
    try:
        spec = importlib.util.spec_from_file_location("gh_quota", GH_QUOTA)
        module = importlib.util.module_from_spec(spec)
        sys.modules["gh_quota"] = module
        spec.loader.exec_module(module)
        module.record(gh_args, env=env, gh=gh)
    except Exception:
        pass


def parse(argv: list[str]) -> argparse.Namespace:
    # A search query goes after `--`, and ghread hands it to argparse only after
    # parsing the rest. Once an option follows a `nargs="*"` positional, argparse
    # stops filling that positional, so it rejects the terms after `--` as
    # unrecognized arguments. CPython before 3.12.7 does this even with no term
    # before the option (`search prs --state open -- -label:bug`).
    if argv[:1] == ["search"] and "--" in argv:
        cut = argv.index("--")
        ns = _parser().parse_args(argv[:cut])
        ns.terms += argv[cut + 1 :]
        return ns
    return _parser().parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    ns = parse(sys.argv[1:] if argv is None else argv)
    if ns.cmd == "run" and ns.verb == "failures":
        return main_failures(ns)
    try:
        gh_args = BUILDERS[ns.cmd](ns)
        gh = find_gh()
        out_fd = open_out(ns.out) if ns.out else None
    except GhreadError as exc:
        print(f"{PROG}: {exc}", file=sys.stderr)
        return 2
    env = gh_env()
    record_quota(gh_args, env, gh)
    try:
        return subprocess.run(
            [gh, *gh_args],
            stdin=subprocess.DEVNULL,
            stdout=out_fd,
            env=env,
            check=False,
        ).returncode
    finally:
        if out_fd is not None:
            os.close(out_fd)


def main_failures(ns) -> int:
    out_fd = None
    try:
        gh, env = find_gh(), gh_env()
        if ns.out:
            out_fd = open_out(ns.out)
        digest = run_failures(ns, lambda args: gh_output(gh, env, args))
    except (GhreadError, GhFailed) as exc:
        if out_fd is not None:
            os.close(out_fd)
        print(f"{PROG}: {exc}", file=sys.stderr)
        return exc.code if isinstance(exc, GhFailed) else 2
    if out_fd is None:
        sys.stdout.write(digest)
    else:
        with os.fdopen(out_fd, "w") as f:
            f.write(digest)
    return 0


if __name__ == "__main__":
    sys.exit(main())

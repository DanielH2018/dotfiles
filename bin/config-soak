#!/usr/bin/env node
'use strict';
// config-soak — deterministic review + soak gate for behavior-affecting config.
//
// Treats ~/.claude config (settings.base.json, hooks, agents, skills, CLAUDE.md)
// like code: a change must be consciously acknowledged (`land`) before it is
// considered reviewed, and is only flagged `stable` after an observation window.
// This is the deterministic, mechanical complement to the agent-driven
// `review-setup` skill: no LLM, no judgement, just a fingerprint ledger.
//
// Usage:
//   config-soak status [--json] [--strict]   report + exit non-zero if unreviewed
//                                             changes exist (--strict also fails on
//                                             "landed, never fired" entries)
//   config-soak land [PATH...]               record current config as reviewed
//                                             (starts soak clock)
//   config-soak outcomes [--since PATH]       query Loki for evidence that each
//                                             hook/settings entry inside its soak
//                                             window actually fired, and write the
//                                             result back as that entry's `outcome`
//   config-soak list                         print the tracked path set and exit
//   config-soak --help
//
// The ledger lives at <repo>/config-soak.json and is committed. Fingerprints are
// taken over the chezmoi SOURCE files (executable_*, *.tmpl) — the reviewable
// source of truth — not the deployed/rendered output.

const fs = require('node:fs');
const path = require('node:path');
const lib = require('./config-soak-lib.js');

const REPO_ROOT = path.resolve(__dirname, '..');
const MANIFEST_PATH = path.join(REPO_ROOT, 'config-soak.json');
const HOOKS_CONFIG_SOURCE = path.join(REPO_ROOT, 'home/.chezmoitemplates/settings.base.json');

// Loki, this machine only. No other host, no other port — the query text is
// caller-controlled (a LogQL string), but the destination never is, the same
// defensibility argument home/dot_local/bin/executable_otelq makes for why a
// fixed-destination query tool is a smaller grant than curl. Deliberately
// bare 127.0.0.1 rather than otelq's ClusterIP fallback: a workstation
// running claude-otel's docker-compose stack answers here directly (see
// home/claude-otel/README.md); a k3s host whose Loki lives behind a
// ClusterIP (daniel-box, daniel-server — see the otel-review skill) does
// not, and `outcomes` reports that honestly as source:"none" rather than
// reaching past localhost to find it.
const LOKI_BASE = 'http://127.0.0.1:3100';
const LOKI_TIMEOUT_MS = 5000;

async function queryLoki(logql, atSeconds) {
  const url = `${LOKI_BASE}/loki/api/v1/query?query=${encodeURIComponent(logql)}&time=${Math.floor(atSeconds)}`;
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), LOKI_TIMEOUT_MS);
  try {
    const res = await fetch(url, { signal: controller.signal });
    if (!res.ok) throw new Error(`Loki HTTP ${res.status}`);
    return await res.json();
  } finally {
    clearTimeout(timer);
  }
}

// Behavior-affecting config surface. `file` = a single path; `dir` = recurse.
// Paths are repo-relative and use forward slashes in the ledger.
// settings.json is generated from all three templates below, so all three are policy.
// Listed individually rather than tracking .chezmoitemplates as a dir: the rest of that
// directory is installer scripts and OS probes, which are not this gate's surface.
// tests/settings/settings-templates-tracked.test.js fails if a fourth appears without a line here.
const TRACKED = [
  { type: 'file', path: 'home/.chezmoitemplates/settings.base.json' },
  { type: 'file', path: 'home/.chezmoitemplates/settings.permissions.json' },
  { type: 'file', path: 'home/.chezmoitemplates/settings.safe-floor.json' },
  { type: 'file', path: 'home/private_dot_claude/CLAUDE.md.tmpl' },
  { type: 'dir', path: 'home/private_dot_claude/hooks' },
  { type: 'dir', path: 'home/private_dot_claude/agents' },
  { type: 'dir', path: 'home/private_dot_claude/skills' },
  { type: 'dir', path: 'home/private_dot_claude/rules' },
  { type: 'dir', path: 'home/private_dot_claude/output-styles' },
];

function walk(absDir, acc) {
  for (const ent of fs.readdirSync(absDir, { withFileTypes: true }).sort((a, b) => (a.name < b.name ? -1 : 1))) {
    const abs = path.join(absDir, ent.name);
    if (ent.isDirectory()) walk(abs, acc);
    else if (ent.isFile()) acc.push(abs);
  }
  return acc;
}

// Scan the tracked surface into { repoRelPath: sha256 }. Missing roots are skipped.
function scanTracked() {
  const files = [];
  for (const spec of TRACKED) {
    const abs = path.join(REPO_ROOT, spec.path);
    if (!fs.existsSync(abs)) continue;
    if (spec.type === 'dir') walk(abs, files);
    else files.push(abs);
  }
  const tracked = {};
  for (const abs of files) {
    const rel = path.relative(REPO_ROOT, abs).split(path.sep).join('/');
    tracked[rel] = lib.fingerprint(fs.readFileSync(abs));
  }
  return tracked;
}

function readManifest() {
  if (!fs.existsSync(MANIFEST_PATH)) return { windowDays: lib.DEFAULT_WINDOW_DAYS, entries: [] };
  try {
    const m = JSON.parse(fs.readFileSync(MANIFEST_PATH, 'utf8'));
    m.entries = m.entries || [];
    return m;
  } catch (e) {
    process.stderr.write(`config-soak: cannot parse ${MANIFEST_PATH}: ${e.message}\n`);
    process.exit(2);
  }
}

function writeManifest(m) {
  fs.writeFileSync(MANIFEST_PATH, JSON.stringify(m, null, 2) + '\n');
}

function pluralLine(label, items, render) {
  if (!items.length) return '';
  return `\n${label} (${items.length}):\n` + items.map((i) => '  ' + render(i)).join('\n') + '\n';
}

function outcomeSuffix(outcome) {
  if (!outcome) return '';
  if (outcome.source === 'none') return `  [outcome: unattributed — ${outcome.note}]`;
  return `  [outcome: fired=${outcome.fired} denied=${outcome.denied} errors=${outcome.errors}` +
    ` @ ${outcome.checkedAt}]`;
}

function cmdStatus(argv) {
  const json = argv.includes('--json');
  const strict = argv.includes('--strict');
  const tracked = scanTracked();
  const manifest = readManifest();
  const now = new Date().toISOString();
  const report = lib.buildReport({ tracked, manifest, now });
  const failures = lib.gateFailures(report, { strict });

  if (json) {
    process.stdout.write(JSON.stringify({ ...report, failures, ok: failures === 0, strict }, null, 2) + '\n');
    return failures === 0 ? 0 : 1;
  }

  const d1 = (n) => n.toFixed(1);
  let out = `config soak status  (window: ${report.windowDays}d${strict ? ', --strict' : ''})\n`;
  out += pluralLine('UNREVIEWED — new config, run `config-soak land`', report.unrecorded, (i) => i.path);
  out += pluralLine('CHANGED — content differs from ledger, re-review then `land`', report.changed, (i) => i.path);
  out += pluralLine('REMOVED — deleted since last land, `land` to acknowledge', report.removed, (i) => i.path);
  out += pluralLine('SOAKING — reviewed, not yet stable', report.soaking,
    (i) => `${i.path}  (${d1(i.daysRemaining)}d remaining)${outcomeSuffix(i.outcome)}`);
  out += pluralLine('STABLE — soaked past the window', report.stable,
    (i) => `${i.path}  (${d1(i.ageDays)}d)${outcomeSuffix(i.outcome)}`);
  out += pluralLine(
    `NEVER FIRED — landed, soak window elapsed, zero Loki hits the whole time` +
      (strict ? ' (gates under --strict)' : ' (warning only — pass --strict to gate on it)'),
    report.neverFired, (i) => `${i.path}  (${d1(i.ageDays)}d, checked ${i.outcome.checkedAt}) — a scaffolding-delete-pass candidate`
  );
  out += failures === 0
    ? '\nGATE PASS — all behavior-affecting config is acknowledged.\n'
    : `\nGATE FAIL — ${failures} unreviewed change(s)${strict ? ' (incl. never-fired, --strict)' : ''}. Review the diff, then \`config-soak land\`.\n`;
  process.stdout.write(out);
  return failures === 0 ? 0 : 1;
}

function cmdLand(argv) {
  const paths = argv.filter((a) => !a.startsWith('-'));
  const tracked = scanTracked();
  const manifest = readManifest();
  const now = new Date().toISOString();
  const before = lib.buildReport({ tracked, manifest, now });
  const next = lib.land({ tracked, manifest, now, paths });
  writeManifest(next);
  const after = lib.buildReport({ tracked, manifest: next, now });
  const acknowledged = lib.gateFailures(before) - lib.gateFailures(after);
  process.stdout.write(
    `config-soak: landed ${acknowledged} change(s); ${after.soaking.length} soaking, ${after.stable.length} stable.\n` +
    `Ledger written to ${path.relative(REPO_ROOT, MANIFEST_PATH)}. Commit it to persist the soak clock.\n`
  );
  return 0;
}

function cmdList() {
  const tracked = scanTracked();
  process.stdout.write(Object.keys(tracked).sort().join('\n') + '\n');
  return 0;
}

// `config-soak outcomes [--since PATH]` — for every ledger entry inside its
// soak window (soaking or stable) that names a hook or a settings file, ask
// Loki whether the landed config actually fired since it landed, and write
// the answer back into the entry as `outcome`. Read-only against Loki (GET
// only, one fixed host — see queryLoki above); a query failure downgrades
// that entry to source:"none" rather than aborting the run.
//
// `--since PATH` resumes a partial run: entries are processed in sorted
// path order, and this skips every path before PATH (each entry costs a
// live Loki round trip, so a run over dozens of entries is resumable rather
// than all-or-nothing).
async function cmdOutcomes(argv) {
  const sinceIdx = argv.indexOf('--since');
  const sinceArg = sinceIdx !== -1 ? argv[sinceIdx + 1] : null;

  const tracked = scanTracked();
  const manifest = readManifest();
  const now = new Date();
  const nowIso = now.toISOString();
  const report = lib.buildReport({ tracked, manifest, now: nowIso });
  const inWindow = [...report.soaking, ...report.stable].map((x) => x.path).sort();
  const paths = sinceArg ? inWindow.filter((p) => p >= sinceArg) : inWindow;

  let hooksConfig = null;
  try {
    hooksConfig = lib.parseHooksConfig(fs.readFileSync(HOOKS_CONFIG_SOURCE, 'utf8'));
  } catch (_e) {
    hooksConfig = null; // every hooks/ path below reports its own unattributed note
  }

  const byPath = new Map(manifest.entries.map((e) => [e.path, e]));
  let checked = 0;
  let attributed = 0;
  let unattributed = 0;

  for (const p of paths) {
    const attribution = lib.attributeEntry(p, hooksConfig);
    if (!attribution.inScope) continue; // not a hook or settings file — outcomes doesn't touch it
    const entry = byPath.get(p);
    if (!entry) continue;
    checked++;

    if (!attribution.attributable) {
      entry.outcome = lib.unattributedOutcome({ checkedAt: nowIso, note: attribution.note });
      unattributed++;
      continue;
    }

    const sinceSeconds = (now.getTime() - Date.parse(entry.landed)) / 1000;
    const queries = lib.buildOutcomeQueries(attribution.slices, sinceSeconds);
    const atSeconds = now.getTime() / 1000;
    try {
      const [fired, denied, errors] = await Promise.all([
        queryLoki(queries.fired, atSeconds).then(lib.parseLokiScalar),
        queryLoki(queries.denied, atSeconds).then(lib.parseLokiScalar),
        queryLoki(queries.errors, atSeconds).then(lib.parseLokiScalar),
      ]);
      entry.outcome = lib.makeOutcome({ fired, denied, errors, checkedAt: nowIso });
      attributed++;
    } catch (e) {
      entry.outcome = lib.unattributedOutcome({
        checkedAt: nowIso,
        note: `Loki did not answer at ${LOKI_BASE}: ${e.message}`,
      });
      unattributed++;
    }
  }

  writeManifest(manifest);
  process.stdout.write(
    `config-soak: checked ${checked} hook/settings entr${checked === 1 ? 'y' : 'ies'} in window ` +
    `(${attributed} attributed via Loki, ${unattributed} unattributed).\n` +
    `Ledger written to ${path.relative(REPO_ROOT, MANIFEST_PATH)}. Commit it to persist the outcomes.\n`
  );
  return 0;
}

const HELP = `config-soak — deterministic review + soak gate for behavior-affecting config

  config-soak status [--json] [--strict]  report; exit 1 if any unreviewed change
                                           exists. --strict also fails the gate on
                                           "landed, never fired" entries (soaked out
                                           with zero Loki hits) instead of only
                                           warning about them.
  config-soak land [PATH...]              record current config as reviewed
                                           (start soak clock)
  config-soak outcomes [--since PATH]     query Loki for every hook/settings entry
                                           inside its soak window and record whether
                                           it actually fired, as that entry's
                                           \`outcome\`. Read-only, localhost only.
                                           --since PATH resumes a partial run.
                                           A "landed, never fired" entry (see
                                           \`status\`) is the scaffolding-delete-pass
                                           skill's raw material for what to remove.
  config-soak list                        print the tracked config paths
  config-soak --help
`;

async function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  switch (cmd) {
    case undefined:
    case 'status': return cmdStatus(rest);
    case 'land': return cmdLand(rest);
    case 'outcomes': return cmdOutcomes(rest);
    case 'list': return cmdList();
    case '-h':
    case '--help': process.stdout.write(HELP); return 0;
    default:
      process.stderr.write(`config-soak: unknown command '${cmd}'\n\n${HELP}`);
      return 2;
  }
}

main().then((code) => process.exit(code));

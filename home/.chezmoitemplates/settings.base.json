{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "env": {
    "EDITOR": "vim",
    "PAGER": "less -R",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    {{/* Compact at 85% rather than the previous 60%. At 60% we discarded 40% of the
         window unconditionally, and long sessions were compacting 3-6 times each —
         every compaction also truncates history before the remember pipeline can
         save it, so the aggressive setting was degrading tomorrow's memory too.
         85 keeps a safety margin without paying full-window cache-read latency. */}}
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "85",
    "CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE": "true",
    "CLAUDE_CODE_ALT_SCREEN_FULL_REPAINT": "1",
    "CTS_REMOTE_ROOTS": "~/server"{{ if has .chezmoi.hostname (list "daniel-wsl" "daniel-desktop") }},
    {{/* OTEL export targets the claude-otel stack on daniel-wsl (:4317); daniel-desktop reaches it via WSL2 localhost forwarding */}}
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000",
    "OTEL_LOGS_EXPORT_INTERVAL": "5000",
    {{/* session_id MUST stay on. Without it every concurrent Claude Code process
         collapses into one Prometheus series, and the collector's prometheus exporter
         is last-writer-wins per label set — so cumulative counters (tokens, cost,
         sessions, active_time) stop accumulating. Measured with it off: 7549 api_request
         events reported only 1.86M tokens (246 tokens/request, ~10x low), while
         increase()[7d] over-corrected for the false counter resets by ~274x. */}}
    "OTEL_METRICS_INCLUDE_SESSION_ID": "true"{{ end }}
  },
  "attribution": {
    "commit": "🤖 Generated with [Claude Code](https://claude.com/claude-code)\n\nCo-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "🤖 Generated with [Claude Code](https://claude.com/claude-code)"
  },

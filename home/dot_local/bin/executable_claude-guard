#!/usr/bin/env bash
# claude-guard — CLI entry for the claude_guard package: explain, replay, segment.
#
# Not a hook. The hook shims live in ~/.claude/hooks and carry the per-event failure
# contracts (spec: docs/specs/2026-09-06-claude-guard-design.md). This one is for a human or
# a test, so a missing interpreter is an error, not a silent no-decision.
#
# The package is 3.15-only and runs under uv's managed interpreter. `--no-project` stops uv
# reading a pyproject in cwd (on the server repo that answers with a different 3.15 and a
# different sys.path); `--system` stops it answering with a valid, version-matching virtualenv
# it finds by walking up from cwd instead — measured returning such a worktree's own
# `.venv/bin/python3` in place of the managed interpreter. It also stops uv answering with an
# inherited VIRTUAL_ENV, which any command started from a `uv run` session carries. (A
# dangling or wrong-version cwd venv is not the risk: uv already probes it and falls back to
# the managed toolchain on its own.) `--managed-python` restricts the answer to a uv-managed install. `-S` skips
# site-packages; the package needs only the stdlib and PYTHONPATH still applies without site.
# `-P` keeps the working directory off sys.path, where `python -m` puts it ahead of
# PYTHONPATH: a `claude_guard/` directory in cwd would otherwise run in place of the
# deployed package.
set -eu
SHARE="${CLAUDE_GUARD_HOME:-$HOME/.local/share/claude-guard}"
if ! PY=$(uv python find --no-project --managed-python --system 3.15 2>/dev/null); then
  echo "claude-guard: no uv-managed Python 3.15 found; run: uv python install 3.15" >&2
  exit 2
fi
PYTHONPATH="$SHARE" exec "$PY" -S -P -m claude_guard.cli "$@"

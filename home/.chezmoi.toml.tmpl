{{- $work := promptBoolOnce . "work" "Is this a work machine" false -}}
# Pin umask so target file modes are deterministic regardless of the login shell's
# umask (this server runs umask 0007, which would otherwise make chezmoi want 0660).
umask = 0o022

[data]
    work = {{ $work }}
{{- if eq .chezmoi.os "windows" }}

# Windows has no shebang support, so chezmoi would otherwise try to exec the /bin/sh
# modify_settings.json script (target ext .json) directly and fail. Run it via Git Bash.
[interpreters.json]
    command = "bash"
{{- end }}

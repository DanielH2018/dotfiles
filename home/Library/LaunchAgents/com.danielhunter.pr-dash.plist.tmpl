<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.danielhunter.pr-dash</string>
	<key>ProgramArguments</key>
	<array>
		<!-- Reached through fnm's aliases/default symlink, not a version-pinned path, so an
		     fnm upgrade does not silently strand this agent on a removed Node version. -->
		<string>{{ .chezmoi.homeDir }}/.local/share/fnm/aliases/default/bin/node</string>
		<string>{{ .chezmoi.homeDir }}/.local/share/pr-dash/src/main.ts</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PR_DASH_PORT</key>
		<string>8770</string>
		<!-- src/token.ts invokes `op` by bare name through execFile, and launchd's default
		     PATH is just /usr/bin:/bin:/usr/sbin:/sbin. Without /opt/homebrew/bin here, the
		     first /api/prs comes back as a 500 carrying an ENOENT. -->
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<!-- Bare <true/>, never a dict with SuccessfulExit <false/>. The idle exit (main-lib.ts's
	     createIdleExit) exits status 0 by design. Under SuccessfulExit: false, launchd reads
	     a clean exit as "do not restart", so the port would go dead until the next login and
	     nothing in this suite would notice. -->
	<key>KeepAlive</key>
	<true/>
	<!-- launchd's own default, named explicitly so the dependency is visible rather than
	     inherited. It bounds how long the port sits unheld after an idle exit. -->
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/.local/state/pr-dash/agent.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/.local/state/pr-dash/agent.log</string>
</dict>
</plist>

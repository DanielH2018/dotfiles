#!/usr/bin/env node
'use strict';
// gen-skill-router — generate the "all installed skills" block in skill-router's SKILL.md,
// and fail if the hand-written lane prose in that same file references a skill that no
// longer exists.
//
// skill-router/SKILL.md.tmpl says its own failure mode at the top: "Hand-curated. When it
// drifts from what's installed, reconcile against `ls ~/.claude/skills` + the plugin list."
// That's a chore someone has to remember to run; this makes the generated half of the file
// impossible to drift (it's regenerated from the tree) and the hand-written half impossible
// to drift silently (a reference to a renamed/removed skill fails the build instead of
// quietly pointing nowhere).
//
// Reads home/private_dot_claude/skills/*/SKILL.md — the chezmoi SOURCE tree, not a deployed
// ~/.claude/skills — so this is reproducible from a clean git checkout: same reasoning as
// config-soak.json fingerprinting the source rather than the rendered output.
//
// Usage:
//   gen-skill-router            regenerate home/private_dot_claude/skills/skill-router/SKILL.md.tmpl
//   gen-skill-router --check    regenerate to memory, diff against the committed file, exit
//                               non-zero on any difference (the CI gate; see
//                               tests/gen-skill-router.test.js, which runs this in --check
//                               mode against the real repo tree)

const fs = require('node:fs');
const path = require('node:path');
const { spawnSync } = require('node:child_process');
const lib = require('./gen-skill-router-lib.js');

const REPO_ROOT = path.resolve(__dirname, '..');
const SKILLS_DIR = path.join(REPO_ROOT, 'home', 'private_dot_claude', 'skills');
const AGENTS_DIR = path.join(REPO_ROOT, 'home', 'private_dot_claude', 'agents');
const TEMPLATE_PATH = path.join(SKILLS_DIR, 'skill-router', 'SKILL.md.tmpl');

function readSkillFiles(skillsDir) {
  const out = {};
  if (!fs.existsSync(skillsDir)) return out;
  for (const ent of fs.readdirSync(skillsDir, { withFileTypes: true })) {
    if (!ent.isDirectory()) continue;
    // SKILL.md.tmpl (skill-router's own file, chezmoi strips .tmpl on deploy) falls back
    // to SKILL.md — this generator would otherwise never see itself in its own output.
    // Frontmatter is plain YAML in both cases; only the body carries {{ }} actions.
    const md = path.join(skillsDir, ent.name, 'SKILL.md');
    const mdTmpl = path.join(skillsDir, ent.name, 'SKILL.md.tmpl');
    const src = fs.existsSync(md) ? md : (fs.existsSync(mdTmpl) ? mdTmpl : null);
    if (src) out[ent.name] = fs.readFileSync(src, 'utf8');
  }
  return out;
}

// Which of the skill directories feeding the generated block are untracked in git.
//
// The generator reads the source TREE, so a skill directory someone left untracked changes
// the generated block while the committed template does not follow -- and `--check` then
// reports drift no commit caused, in the pre-push gate, for every session in the checkout
// (DanielH2018/server#2271). Naming the path turns that into a readable error. The verdict
// does not change: an untracked skill is still a real difference, and skipping one would
// drop a deployed skill from the router with no signal at all.
//
// Returns null when git cannot answer -- a missing binary, a directory that is no repo (the
// staged fixture trees in tests/gen-skill-router.test.js are exactly that). The annotation is
// diagnostic, so losing it must not change what the check decides.
//
// GIT_DIR and friends are stripped: the pre-push gate exports them, and they would point this
// lookup at whatever repo invoked the hook rather than at REPO_ROOT.
function untrackedSkillDirs(repoRoot, skillsDir, skillNames) {
  const env = { ...process.env };
  for (const key of Object.keys(env)) {
    if (key.startsWith('GIT_')) delete env[key];
  }
  const rel = path.relative(repoRoot, skillsDir);
  const res = spawnSync(
    'git',
    ['-C', repoRoot, 'ls-files', '--others', '--exclude-standard', '--directory', '--', rel],
    { encoding: 'utf8', env },
  );
  if (res.error || res.status !== 0) return null;

  const names = new Set();
  for (const line of res.stdout.split('\n')) {
    if (!line) continue;
    // `<rel>/<skill>` or `<rel>/<skill>/...` -- a whole untracked directory, or an untracked
    // file inside a tracked one, which changes the block just the same.
    const under = path.relative(rel, line.replace(/\/$/, ''));
    const name = under.split(path.sep)[0];
    if (skillNames.includes(name)) names.add(name);
  }
  return [...names].sort().map((name) => path.join(rel, name));
}

function readAgentNames(agentsDir) {
  if (!fs.existsSync(agentsDir)) return [];
  return fs.readdirSync(agentsDir)
    .filter((f) => f.endsWith('.md'))
    .map((f) => f.slice(0, -3));
}

function firstDiffLine(a, b) {
  const al = a.split('\n');
  const bl = b.split('\n');
  const n = Math.max(al.length, bl.length);
  for (let i = 0; i < n; i += 1) {
    if (al[i] !== bl[i]) {
      return { lineNo: i + 1, expected: al[i] ?? '(end of file)', got: bl[i] ?? '(end of file)' };
    }
  }
  return null;
}

function main() {
  const check = process.argv.includes('--check');

  const skillFiles = readSkillFiles(SKILLS_DIR);
  const skills = lib.collectSkills(skillFiles);
  const skillNames = skills.map((s) => s.name);
  const agentNames = readAgentNames(AGENTS_DIR);

  if (!fs.existsSync(TEMPLATE_PATH)) {
    process.stderr.write(`gen-skill-router: template not found at ${TEMPLATE_PATH}\n`);
    process.exit(2);
  }
  const currentTemplate = fs.readFileSync(TEMPLATE_PATH, 'utf8');

  // Drift check: every bare skill/agent-shaped reference in the hand-written lane prose
  // (work-gated content and the generated block itself stripped first — the former belongs
  // to a different repo's skill surface, the latter is generator-authored description text
  // that routinely carries unrelated backtick spans) must resolve to a real skill, a real
  // agent, or the small reviewed EXTERNAL_ALLOWLIST.
  const stripped = lib.stripWorkBlocks(lib.stripGeneratedBlock(currentTemplate));
  const missing = lib.findMissingReferences(stripped, skillNames, agentNames);
  if (missing.length > 0) {
    process.stderr.write(
      `gen-skill-router: the lane prose references ${missing.length} name(s) that are not `
      + `an installed skill, an agent in ${path.relative(REPO_ROOT, AGENTS_DIR)}, or in `
      + `EXTERNAL_ALLOWLIST: ${missing.join(', ')}\n`
      + 'Either the skill/agent was renamed and the prose is stale, or this is a new '
      + 'external reference that belongs in EXTERNAL_ALLOWLIST (bin/gen-skill-router-lib.js) '
      + 'with a comment saying what it is.\n',
    );
    process.exit(1);
  }

  const regenerated = lib.injectGenerated(currentTemplate, skills);

  if (check) {
    if (regenerated === currentTemplate) {
      process.stdout.write(`gen-skill-router --check: ${path.relative(REPO_ROOT, TEMPLATE_PATH)} is up to date (${skills.length} skills).\n`);
      return;
    }
    const diff = firstDiffLine(regenerated, currentTemplate);
    process.stderr.write(
      `gen-skill-router --check: ${path.relative(REPO_ROOT, TEMPLATE_PATH)} is out of date. `
      + 'Run `bin/gen-skill-router` and commit the result.\n',
    );
    if (diff) {
      process.stderr.write(`  first difference at line ${diff.lineNo}:\n`);
      process.stderr.write(`    generated: ${diff.expected}\n`);
      process.stderr.write(`    committed: ${diff.got}\n`);
    }
    const untracked = untrackedSkillDirs(REPO_ROOT, SKILLS_DIR, skillNames);
    if (untracked && untracked.length > 0) {
      process.stderr.write(
        `  ${untracked.length} skill director${untracked.length === 1 ? 'y is' : 'ies are'} `
        + `untracked, which is what this generator read: ${untracked.join(', ')}\n`
        + '  Track it and rerun the generator, or remove it. Until then the check reports '
        + 'drift no commit caused, and the pre-push gate fails for everyone in this '
        + 'checkout.\n',
      );
    }
    process.exit(1);
  }

  fs.writeFileSync(TEMPLATE_PATH, regenerated);
  process.stdout.write(`gen-skill-router: wrote ${path.relative(REPO_ROOT, TEMPLATE_PATH)} (${skills.length} skills).\n`);
}

main();

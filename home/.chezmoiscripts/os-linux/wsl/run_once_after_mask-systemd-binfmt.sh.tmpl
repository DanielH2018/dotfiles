{{ if eq .chezmoi.os "linux" -}}
{{ if includeTemplate "is-wsl" . -}}
#!/bin/sh
# WSL-only: mask systemd-binfmt.service. On every boot it tries to flush binfmt_misc
# rules and fails ("Read-only file system") because WSL owns that mount and registers
# its own WSLInterop entry via /init — the unit is redundant here and only produces a
# failed-unit journal error. The mask was originally applied by hand; codifying it so a
# distro rebuild doesn't resurrect the noise. Interop is unaffected by the mask.
#
# chezmoi manages $HOME only, so masking needs sudo. run_once_after_: a sudo-less run
# fails loud (exit 1 -> retries next apply) without blocking deployment.
set -u

# Already masked -> converged (no sudo needed).
if [ "$(systemctl is-enabled systemd-binfmt.service 2>/dev/null)" = "masked" ]; then
  exit 0
fi

if ! sudo -v; then
  echo "mask-systemd-binfmt: sudo unavailable; deferring mask (retries next apply)" >&2
  exit 1
fi

sudo systemctl mask --now systemd-binfmt.service \
  && echo "mask-systemd-binfmt: systemd-binfmt.service masked (silences boot-time binfmt flush failure)"
{{ end -}}
{{ end -}}

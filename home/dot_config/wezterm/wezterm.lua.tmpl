-- WezTerm configuration — WINDOWS ONLY (chezmoi ignores this on non-Windows).
-- Mirrors the Ghostty config used on macOS/Linux (~/.config/ghostty/config) as closely
-- as WezTerm's Lua allows: same font, Catppuccin Mocha, padding, cursor, scrollback, and
-- the shift+enter -> newline binding for Claude Code. Keep the two in sync by hand.

local wezterm = require("wezterm")
local act = wezterm.action
local config = wezterm.config_builder()

-- ---------------------------------------------------------------------------
-- HELPERS
-- Resolve the Git Bash launcher ONCE. The local domain plus the agentview/homelab
-- tabs all spawn it; probing here keeps the path in a single place and survives a
-- machine where Git isn't under Program Files (winget-per-user / Scoop). Falls back
-- to the canonical path so a fresh box still gets a sensible default.
-- ---------------------------------------------------------------------------
local function first_existing(paths, fallback)
	for _, p in ipairs(paths) do
		if p and p ~= "" then
			local f = io.open(p, "r")
			if f then
				f:close()
				return p
			end
		end
	end
	return fallback
end
local git_bash = first_existing({
	"C:\\Program Files\\Git\\bin\\bash.exe",
	"C:\\Program Files (x86)\\Git\\bin\\bash.exe",
	(os.getenv("LOCALAPPDATA") or "") .. "\\Programs\\Git\\bin\\bash.exe",
	(os.getenv("USERPROFILE") or "") .. "\\scoop\\apps\\git\\current\\bin\\bash.exe",
}, "C:\\Program Files\\Git\\bin\\bash.exe")

-- ---------------------------------------------------------------------------
-- FONT  (shared values from .chezmoidata/terminal.toml — keeps Ghostty + WezTerm in sync).
-- Windows registers the Mono family as "IosevkaTerm NFM", so list the full name first and
-- the abbreviation as a fallback.
-- ---------------------------------------------------------------------------
config.font = wezterm.font_with_fallback({
	{ family = "{{ .terminal.font_family }}", weight = "{{ .terminal.font_weight }}" },
	{ family = "IosevkaTerm NFM", weight = "{{ .terminal.font_weight }}" },
})
config.font_size = {{ .terminal.font_size }}.0
config.harfbuzz_features = { {{ range $i, $f := .terminal.font_features }}{{ if $i }}, {{ end }}"{{ $f }}=1"{{ end }} }
-- Don't pop a toast when a glyph falls back to another font (Nerd Font symbols,
-- Claude's spinner braille, the agentview status icons). Fallback renders fine.
config.warn_about_missing_glyphs = false

-- ---------------------------------------------------------------------------
-- THEME  (Ghostty: theme = "Catppuccin Mocha") — built into WezTerm.
-- ---------------------------------------------------------------------------
config.color_scheme = "{{ .terminal.theme }}"

-- ---------------------------------------------------------------------------
-- CURSOR  (Ghostty: block, blink, same cursor_color) — colors merge over the scheme.
-- ---------------------------------------------------------------------------
config.default_cursor_style = "BlinkingBlock"
config.cursor_blink_rate = 500
-- Hard on/off blink: the default EaseIn/EaseOut fade repaints the GPU every frame of the
-- transition (kept alive even under animation_fps=1). A block cursor gains nothing from a
-- fade, so make it a step so the GPU can idle between blinks.
config.cursor_blink_ease_in = "Constant"
config.cursor_blink_ease_out = "Constant"
config.colors = {
	cursor_bg = "{{ .terminal.cursor_color }}",
	cursor_border = "{{ .terminal.cursor_color }}",
	cursor_fg = "{{ .terminal.cursor_fg }}",
}

-- ---------------------------------------------------------------------------
-- WINDOW / BEHAVIOR  (Ghostty: 120x24, padding 20, scrollback 100000, no close confirm)
-- ---------------------------------------------------------------------------
config.initial_cols = {{ .terminal.cols }}
config.initial_rows = {{ .terminal.rows }}
config.window_padding = { left = {{ .terminal.padding }}, right = {{ .terminal.padding }}, top = {{ .terminal.padding }}, bottom = {{ .terminal.padding }} }
config.window_background_opacity = 1.0
config.window_close_confirmation = "NeverPrompt"
-- Drop the native Windows title bar and fold the min/max/close buttons into the fancy tab
-- bar. Do NOT pair this with hide_tab_bar_if_only_one_tab — the integrated buttons live in
-- the tab bar, so hiding it (with NeverPrompt + no title bar) would leave no pointer way to
-- close the window. The tab bar always shows; this box lives in tabs anyway.
config.window_decorations = "INTEGRATED_BUTTONS|RESIZE"
-- Render the fancy tab bar in Iosevka (shared data keys) instead of WezTerm's built-in UI
-- font, a couple points down so tab titles don't crowd the bar.
config.window_frame = {
	font = wezterm.font({ family = "{{ .terminal.font_family }}", weight = "{{ .terminal.font_weight }}" }),
	font_size = {{ .terminal.font_size }}.0 - 4.0,
}
-- Don't reflow the whole window when zooming the font (CTRL+= / CTRL+-); keep its size.
config.adjust_window_size_when_changing_font_size = false
config.scrollback_lines = {{ .terminal.scrollback }}
config.hide_mouse_cursor_when_typing = true
-- Dim unfocused panes (ghostty: unfocused-split-opacity = 0.6). WezTerm's default
-- inactive_pane_hsb only drops brightness to ~0.8 — pull it to 0.6 to match Ghostty.
config.inactive_pane_hsb = { saturation = 0.9, brightness = 0.6 }
-- Snap interactive window resizes to cell increments (ghostty: window-step-resize).
config.use_resize_increments = true
-- Bell OFF: the readline boundary bell (e.g. arrow past end-of-line) otherwise fires
-- Windows MessageBeep, which flashes the window when "visual notifications for sounds"
-- accessibility is on. Disable audible + zero-duration visual so nothing beeps or flashes.
config.audible_bell = "Disabled"
config.visual_bell = { fade_in_duration_ms = 0, fade_out_duration_ms = 0 }
-- Command-finish notifications (ghostty: notify-on-command-finish = unfocused):
-- shell/common.sh emits OSC 777 when a command ran >= 10s under WezTerm; showing it
-- only for unfocused panes reproduces Ghostty's `unfocused` mode.
config.notification_handling = "SuppressFromFocusedPane"
-- Kitty graphics protocol is OFF by default in WezTerm; enable it for any
-- kitty-graphics tools. (The fastfetch banner itself uses the iterm2 protocol,
-- which WezTerm supports natively — see the fastfetch config.)
config.enable_kitty_graphics = true

-- ---------------------------------------------------------------------------
-- PERFORMANCE — pin the GPU front end so latency doesn't ride on WezTerm's runtime
-- auto-pick, prefer the discrete GPU, and drop the animation smoothing a block cursor
-- doesn't need. max_fps is capped at 255 by the option's type (u8) — on the 299Hz
-- display take all the headroom it allows; WezTerm still clamps to the display.
-- ---------------------------------------------------------------------------
config.front_end = "WebGpu"
config.webgpu_power_preference = "HighPerformance"
config.animation_fps = 1
config.max_fps = 255
-- Mailbox presentation + a 1-frame swapchain queue: the maintainer-verified Windows
-- input-latency fix (wezterm/wezterm#5400). Both options are nightly-only — the 20240203
-- stable rejects them, and config_builder raises on unknown fields — so pcall-guard the
-- pair: on a stable build they're skipped and the rest of the config still loads.
pcall(function()
	config.webgpu_present_mode = "Mailbox"
	config.webgpu_max_frame_latency = 1
end)

-- ---------------------------------------------------------------------------
-- DOMAINS / SHELL
--   Default domain is WSL (Ubuntu): new windows, tabs, and splits open straight
--   into the Linux login shell, starting in the Linux $HOME on fast ext4 — not a
--   translated /mnt/c path over the slow 9p bridge. This box runs dev + Claude Code
--   in UNIX, so Linux is the daily driver. Git Bash stays one keypress away on
--   CTRL+SHIFT+B (a local-domain tab), and the agentview / homelab tabs pin
--   DomainName="local" explicitly, so they're unaffected by the default flip.
-- ---------------------------------------------------------------------------
config.wsl_domains = {
	{
		name = "WSL:Ubuntu",
		distribution = "Ubuntu",
		-- Land in ~/dev on ext4 (a dedicated, trusted workspace), not $HOME or the Windows
		-- cwd under /mnt/c. Claude Code's trust prompt never persists for a $HOME workspace
		-- (claude-code#43958), so new shells/tabs/windows start in ~/dev to dodge it.
		default_cwd = "~/dev",
	},
}
config.default_domain = "WSL:Ubuntu"

-- Local-domain shell — Git Bash (login + interactive). Governs the local domain only:
-- the CTRL+SHIFT+B Git Bash tab and the agentview / homelab tabs (all DomainName="local").
-- The WSL default domain ignores this and runs its own login shell (bash + ble.sh).
config.default_prog = { git_bash, "-l", "-i" }

-- ---------------------------------------------------------------------------
-- KEYBINDINGS  — mirror ~/.config/ghostty/config. On macOS `cmd` is free of the
-- terminal's Ctrl codes; on Windows it isn't, so `cmd` -> CTRL+SHIFT, and a
-- Ghostty `cmd+shift` chord adds ALT (SHIFT is already spent standing in for
-- cmd). Copy / paste / reload keep the bare CTRL+SHIFT chord — that's the
-- Windows-terminal standard and matches the Ghostty letter anyway. Bracket keys
-- use `phys:` so holding Shift doesn't remap "[" to "{". Exceptions: split (cmd+d)
-- and close (cmd+w) map to BARE ctrl+d / ctrl+w so they match Ghostty's muscle
-- memory exactly — these override the shell's EOF / delete-word. Keep in sync with Ghostty.
-- ---------------------------------------------------------------------------

-- ONE dedicated Agent View tab, always reused — CTRL+Left / CTRL+SHIFT+S must NEVER pile up a
-- fresh tab. The tab carries a stable MuxTab title ("Agent View", set from Lua — NOT agentview's
-- retired OSC stamp), so we can find it whatever state its pane is in. First press spawns the one
-- and only tab: a login shell runs the picker, then `exec bash -li` leaves a normal (closable)
-- shell behind when the picker exits after a jump/dismiss. Every later press just activates that
-- tab and, if the picker isn't currently up (we're back at its shell), retypes `agentview` to
-- bring it back. A tab is created ONLY when no marked tab exists — the single time one is spawned.
-- pcall-guarded throughout: a probe/spawn hiccup can never wedge the key.
local AGENTVIEW_TITLE = "Agent View"

local function open_agentview(window, _pane)
	local mux = window:mux_window()
	local target = nil
	pcall(function()
		for _, item in ipairs(mux:tabs_with_info()) do
			if (item.tab:get_title() or "") == AGENTVIEW_TITLE then
				target = item.tab
				break
			end
		end
	end)
	if target then
		target:activate()
		-- Relaunch the picker only if it isn't already live (the tab fell back to its shell
		-- after a jump); if fzf is already up, activating is enough.
		pcall(function()
			local ap = target:active_pane()
			local proc = (ap:get_foreground_process_name() or ""):lower()
			if not proc:find("fzf") then
				ap:send_text("agentview\n")
			end
		end)
		return
	end
	-- No Agent View tab yet — spawn the one-and-only, mark it, and launch the picker.
	pcall(function()
		local tab = mux:spawn_tab({
			domain = { DomainName = "WSL:Ubuntu" },   -- the unified WSL picker (see CTRL+SHIFT+S)
			args = { "bash", "-lc", "agentview; exec bash -li" },
		})
		tab:set_title(AGENTVIEW_TITLE)
	end)
end

-- ---------------------------------------------------------------------------
-- SSH-AWARE SPLITS (CTRL+D / CTRL+SHIFT+D)
-- A split spawns a shell in the pane's own domain, so splitting a pane that is ssh'd
-- somewhere puts you back on THIS machine — and it inherits the pane's OSC 7 cwd, so a
-- remote /home/ubuntu reopens as a LOCAL /home/ubuntu (or `/` when that path doesn't
-- exist here). Splitting a remote view should stay remote, so probe the pane three ways,
-- cheapest first — each one covers a shape the others are blind to:
--   * the ssh process — a local-domain pane (the CTRL+SHIFT+H homelab tab) exposes its
--     foreground process, so reuse that command's destination AND its options
--     (-p / -i / -J ...). Everything past the destination is dropped: the homelab tab
--     runs `tmux new-session -A -s main`, and replaying that would mirror the SAME tmux
--     session into the split instead of giving you a second shell on the box.
--   * OSC 7 — a WSL pane is opaque (WezTerm only ever sees wslhost.exe), but a remote
--     shell that reached a prompt reports its host and cwd, so the split can cd there.
--   * the WSL helper — neither of the above reaches a WSL pane attached to a REMOTE tmux
--     session (an agentview homelab jump): remote tmux swallows OSC 7 and WSL hides the
--     process, so nothing on this side can see the hop. `wezterm-pane-ssh` answers from
--     inside Linux, matching $WEZTERM_PANE out of /proc. It costs a wsl.exe round trip, so
--     it is gated behind both cheap probes failing, and a split with no directory to land
--     in — the remote tmux pane's cwd isn't worth a second ssh to go fetch.
-- The destination doubles as the ssh alias, matching agentview's HOST_SSH fallback: an
-- unknown host surfaces ssh's own error IN the new pane, never a silently local shell.
-- ---------------------------------------------------------------------------

-- WEZTERM_PANE is a Windows-side variable, and a WSL pane is launched through wsl.exe, which
-- forwards only what WSLENV names — so without this the helper above matches nothing and every
-- agentview jump splits locally. WezTerm appends its own list to this value rather than replacing
-- it (a live pane ends up naming TERM and friends twice), so repeating that list here is redundant
-- — it stays as insurance in case that ever becomes an overwrite.
config.set_environment_variables = {
	WSLENV = "WEZTERM_PANE:TERM:COLORTERM:TERM_PROGRAM:TERM_PROGRAM_VERSION",
}

local LOCAL_HOSTS = {                          -- OSC 7 authorities that mean "this machine"
	[(wezterm.hostname() or ""):lower()] = true,   -- the Windows box (local-domain panes)
	["daniel-wsl"] = true,                         -- the WSL distro (WSL-domain panes)
	["localhost"] = true,
}

-- ssh flags that consume the NEXT argv entry — skipped as a pair so their value is never
-- mistaken for the destination (`ssh -p 2222 host`, `ssh -o Foo=bar host`).
local SSH_FLAG_TAKES_VALUE = {}
for flag in ("-B -b -c -D -E -e -F -I -i -J -L -l -m -O -o -p -Q -R -S -W -w"):gmatch("%S+") do
	SSH_FLAG_TAKES_VALUE[flag] = true
end

local function squote(str)   -- POSIX single-quoting, for the path we hand the remote shell
	local escaped = tostring(str):gsub("'", "'\\''")
	return "'" .. escaped .. "'"
end

-- An ssh argv cut off at its destination: the flags (plus the value of any that takes one)
-- and the host, dropping whatever remote command followed. nil if there is no destination.
local function truncate_at_destination(argv)
	local out = { argv[1] }
	local i = 2
	while i <= #argv do
		local arg = argv[i]
		table.insert(out, arg)
		if arg:sub(1, 1) ~= "-" then return out end           -- the destination — stop here
		if SSH_FLAG_TAKES_VALUE[arg] and argv[i + 1] then
			table.insert(out, argv[i + 1])
			i = i + 1
		end
		i = i + 1
	end
	return nil                                                -- flags only, no destination
end

local function pane_domain(pane)
	local domain = ""
	pcall(function() domain = pane:get_domain_name() or "" end)
	return domain
end

-- The pane's ssh invocation, truncated at the destination (nil when it isn't running ssh).
local function ssh_command(pane)
	local info
	pcall(function() info = pane:get_foreground_process_info() end)
	if not info or type(info.argv) ~= "table" then return nil end
	if ((info.name or ""):lower():gsub("%.exe$", "")) ~= "ssh" then return nil end
	local argv = { info.executable or info.argv[1] or "ssh" }
	for i = 2, #info.argv do argv[i] = info.argv[i] end
	return truncate_at_destination(argv)
end

-- Last resort for a WSL pane — the one shape both probes above are blind to. WezTerm sees
-- nothing but wslhost.exe there, and an agentview jump runs `ssh -t host 'tmux attach'`
-- whose REMOTE tmux eats OSC 7, so neither signal fires. The Linux side can still answer:
-- $WEZTERM_PANE is readable out of /proc, and the ssh client hangs below it (or below the
-- local tmux session the pane is attached to). Costs a wsl.exe round trip, so it only runs
-- once the two cheap probes have come back empty. A missing helper just returns nil and the
-- split stays local, exactly as it did before.
local PANE_SSH_PROBE = 'exec "$HOME/.local/bin/wezterm-pane-ssh" "$1"'
local function wsl_ssh_command(pane)
	local distro = pane_domain(pane):match("^WSL:(.+)$")
	if not distro then return nil end
	local id
	pcall(function() id = pane:pane_id() end)
	if not id then return nil end
	local ok, stdout
	pcall(function()
		ok, stdout = wezterm.run_child_process({
			"wsl.exe", "-d", distro, "--", "sh", "-c", PANE_SSH_PROBE, "_", tostring(id),
		})
	end)
	if not ok or not stdout then return nil end
	local argv = {}
	for line in stdout:gmatch("[^\r\n]+") do table.insert(argv, line) end
	if #argv < 2 then return nil end                          -- needs at least `ssh <host>`
	return truncate_at_destination(argv)
end

-- Host + directory from OSC 7, when the pane's shell is reporting from another machine.
local function osc7_remote(pane)
	local host, dir
	pcall(function()
		local cwd = pane:get_current_working_dir()
		if cwd then host, dir = cwd.host, cwd.file_path end
	end)
	if not host or host == "" or LOCAL_HOSTS[host:lower()] then return nil end
	return host, dir
end

-- SpawnCommand for a split: an ssh hop when the pane is remote, otherwise the plain
-- inherit-this-pane's-cwd split (exactly what WezTerm did before).
local function split_command(pane)
	local host, dir = osc7_remote(pane)
	local argv = ssh_command(pane)
	if not argv and not host then argv = wsl_ssh_command(pane) end
	if not argv and not host then return { domain = "CurrentPaneDomain" } end
	argv = argv or { "ssh", host }
	if dir then
		-- Land in the same remote directory, falling back to $HOME once it's gone. `exec` so
		-- the pane's shell IS the login shell, with no wrapper left holding the pane open.
		-- A remote command suppresses ssh's automatic tty, hence the explicit -t.
		table.insert(argv, 2, "-t")
		table.insert(argv, "cd " .. squote(dir) .. " 2>/dev/null || cd; exec ${SHELL:-/bin/sh} -l")
	end
	-- Pin a launch dir that exists on THIS machine. Left alone the split inherits the pane's
	-- OSC 7 cwd — the REMOTE path — and the spawn then chdirs into it locally: WSL logs
	-- `CreateProcessCommon:788: chdir(/home/ubuntu) failed 2` before falling back to `/`, and
	-- the Windows domain has no such path at all. ssh replaces the process immediately, so
	-- this is only ever the directory ssh itself is launched from.
	return {
		domain = "CurrentPaneDomain",
		args = argv,
		cwd = pane_domain(pane):find("WSL") and "/" or wezterm.home_dir,
	}
end

config.keys = {
	-- Claude Code multiline (ghostty: shift+enter=text:\n)
	{ key = "Enter", mods = "SHIFT", action = act.SendString("\n") },

	-- Config management (ghostty: cmd+shift+r)
	{ key = "R", mods = "CTRL|SHIFT", action = act.ReloadConfiguration },

	-- Clipboard (ghostty: cmd+shift+c / cmd+shift+v)
	{ key = "C", mods = "CTRL|SHIFT", action = act.CopyTo("Clipboard") },
	{ key = "V", mods = "CTRL|SHIFT", action = act.PasteFrom("Clipboard") },

	-- Tabs & windows (ghostty: cmd+t / cmd+w / cmd+shift+t / cmd+shift+w)
	-- new-tab (cmd+t) and close (cmd+w) map to BARE ctrl+t / ctrl+w to match Ghostty
	-- muscle memory. Those eat readline's transpose-chars / delete-previous-word —
	-- accepted tradeoff. Lowercase `key`: an uppercase letter implies Shift and would
	-- only fire on the ctrl+shift chord.
	{ key = "t", mods = "CTRL",       action = act.SpawnTab("CurrentPaneDomain") },
	-- Close the pane, always. The one exception: when fzf is the LIVE foreground process
	-- (the agentview picker), send ESC so fzf aborts cleanly. That branch is a nicety, not
	-- a requirement — the mux round-trip and lingering-ConPTY hangs that once made a
	-- force-close dangerous are gone (mux retired; agentview's reload job dies with its EXIT
	-- trap), so falling through to CloseCurrentPane is always safe. Detection is a live
	-- process check ONLY: the old code also honored a sticky `agentview` user var, but that
	-- var survives the picker's exit, so a pane where you once ran the picker kept reporting
	-- it forever and CTRL+W silently sent ESC (a no-op) instead of closing. pcall-guarded so
	-- a nil/throwing probe can never swallow the keypress — on any error we still close.
	{ key = "w", mods = "CTRL", action = wezterm.action_callback(function(window, pane)
		local ok, proc = pcall(function()
			return (pane:get_foreground_process_name() or ""):lower()
		end)
		if ok and proc:find("fzf") then
			window:perform_action(act.SendKey({ key = "Escape" }), pane)
		else
			window:perform_action(act.CloseCurrentPane({ confirm = false }), pane)
		end
	end) },
	-- New window (ghostty: cmd+shift+t). With OSC 7 now reporting the cwd, a plain
	-- SpawnWindow would inherit the active pane's dir — but a *window* should reset to the
	-- default (a new *tab* is what follows the cwd). Spawn through the mux with no cwd so it
	-- falls through to the WSL:Ubuntu domain's default_cwd ("~/dev").
	{ key = "T", mods = "CTRL|SHIFT", action = wezterm.action_callback(function()
		wezterm.mux.spawn_window({ domain = { DomainName = "WSL:Ubuntu" } })
	end) },
	{ key = "W", mods = "CTRL|SHIFT", action = act.QuitApplication },

	-- Splits (ghostty: cmd+d right / cmd+shift+d down). cmd+d maps to a BARE ctrl+d to
	-- match Ghostty. That eats the shell's EOF (exit) on ctrl+d — IGNOREEOF in
	-- ~/.config/shell/common.sh guards accidental exits in panes WezTerm doesn't intercept.
	-- Lowercase `key="d"` for the bare chord; `key="D"` (implies Shift) for the down-split.
	-- Both go through split_command so a split of an ssh'd pane stays on that host.
	{ key = "d", mods = "CTRL", action = wezterm.action_callback(function(window, pane)
		window:perform_action(act.SplitHorizontal(split_command(pane)), pane)
	end) },
	{ key = "D", mods = "CTRL|SHIFT", action = wezterm.action_callback(function(window, pane)
		window:perform_action(act.SplitVertical(split_command(pane)), pane)
	end) },

	-- Navigate splits (ghostty: cmd+[ previous / cmd+] next)
	{ key = "phys:LeftBracket",  mods = "CTRL|SHIFT", action = act.ActivatePaneDirection("Prev") },
	{ key = "phys:RightBracket", mods = "CTRL|SHIFT", action = act.ActivatePaneDirection("Next") },

	-- Resize splits (ghostty: cmd+shift+[ left / cmd+shift+] right)
	{ key = "phys:LeftBracket",  mods = "CTRL|SHIFT|ALT", action = act.AdjustPaneSize({ "Left", 10 }) },
	{ key = "phys:RightBracket", mods = "CTRL|SHIFT|ALT", action = act.AdjustPaneSize({ "Right", 10 }) },

	-- Jump between prompts (ghostty default: cmd+up / cmd+down = jump_to_prompt), via the
	-- OSC 133 marks shell/common.sh emits under WezTerm. Overrides WezTerm's default
	-- CTRL+SHIFT+arrow pane navigation — pane nav lives on the bracket keys here.
	{ key = "UpArrow",   mods = "CTRL|SHIFT", action = act.ScrollToPrompt(-1) },
	{ key = "DownArrow", mods = "CTRL|SHIFT", action = act.ScrollToPrompt(1) },

	-- --- WezTerm extras (no Ghostty equivalent) ---
	-- Agent View switcher (agentview): the UNIFIED picker, run WSL-side in a WSL:Ubuntu tab so
	-- ONE picker aggregates WSL + Windows + homelab sessions (Windows rows over /mnt/c, homelab
	-- over ssh). It MUST run inside a WezTerm pane so its Windows-pane focus (wezterm.exe cli
	-- activate-pane) can reach the GUI — a WSL-domain tab gives it $WEZTERM_PANE + the gui socket.
	-- `bash -lc` for a login PATH (~/.local/bin/agentview + jq/fzf); dismiss with ESC — it also
	-- closes itself after a jump.
	{ key = "S", mods = "CTRL|SHIFT", action = wezterm.action_callback(open_agentview) },
	-- CTRL+Left: back to Agent View from inside a session pane.
	-- WSL panes run tmux (shell/common.sh wraps a bare claude in one for exactly this reason),
	-- and tmux OWNS C-Left (~/.tmux.conf): shell -> word-left, app -> the dedicated `agentview`
	-- tmux window. So for any WSL pane we pass C-Left straight through and let tmux decide;
	-- we must NOT intercept here, or a pane whose title/proc trips the app-heuristic (e.g. tmux
	-- forwarding Claude's "✳ Claude Code" title) would spawn a WezTerm tab instead of the popup —
	-- that was the intermittent "sometimes a tab, sometimes the popup" bug. The tab path below is
	-- only for NON-WSL panes (git-bash / Windows) where there is no tmux and thus no popup.
	-- pcall-guarded; on any probe error we still pass the key through (word-left), never a dead key.
	{ key = "LeftArrow", mods = "CTRL", action = wezterm.action_callback(function(window, pane)
		local dom = ""
		pcall(function() dom = pane:get_domain_name() or "" end)
		if dom:find("WSL") then
			-- tmux's own C-Left binding handles it (word-left OR the agentview popup).
			window:perform_action(act.SendKey({ key = "LeftArrow", mods = "CTRL" }), pane)
			return
		end
		-- Non-WSL pane: no tmux popup available. Use the title/proc heuristic to tell an app
		-- pane from a shell, and fall back to the dedicated Agent View tab for app panes.
		local title = ""
		pcall(function() title = (pane:get_title() or ""):lower() end)
		local is_agent = title:find("claude code", 1, true) ~= nil
		local ok, proc = pcall(function()
			return (pane:get_foreground_process_name() or ""):lower()
		end)
		local base = ((ok and proc or ""):match("([^/\\]+)$") or ""):gsub("%.exe$", "")
		local shells = {
			zsh = true, bash = true, fish = true, sh = true, login = true, pwsh = true,
			powershell = true, cmd = true, ubuntu = true, wsl = true, wslhost = true,
		}
		if is_agent or (base ~= "" and not shells[base]) then
			open_agentview(window, pane)   -- jump to the one dedicated Agent View tab (never a new one)
		else
			window:perform_action(act.SendKey({ key = "LeftArrow", mods = "CTRL" }), pane)
		end
	end) },
	-- CTRL+SHIFT+N: start a NEW claude-sandbox session (pick repo + branch) without the
	-- picker. agentview --spawn runs its fzf pickers in this tab, then wezterm cli spawn
	-- opens the launched session in a fresh tab (the wezterm backend, no tmux here).
	{ key = "N", mods = "CTRL|SHIFT", action = act.SpawnCommandInNewTab({
		domain = { DomainName = "local" },
		args = { git_bash, "--noprofile", "--norc", "-c", "agentview --spawn" },
	}) },
	-- Homelab entry: a local tab that ssh's in and attaches (or creates) a `main`
	-- tmux session. tmux is the multiplexer now (not WezTerm-mux), so this is a plain
	-- local tab running ssh -t — no mux domain round-trip.
	{ key = "H", mods = "CTRL|SHIFT", action = act.SpawnCommandInNewTab({
		domain = { DomainName = "local" },
		args = { git_bash, "-l", "-c",
			"ssh -t daniel-server 'tmux new-session -A -s main'" },
	}) },
	-- Local Git Bash tab (pins the built-in local domain for a Windows shell).
	{ key = "B", mods = "CTRL|SHIFT", action = act.SpawnTab({ DomainName = "local" }) },
	-- WSL tab, pinned. CTRL+T follows the current pane's domain, so from a Git Bash
	-- pane it spawns another Git Bash tab — this always lands in WSL:Ubuntu.
	{ key = "t", mods = "CTRL|ALT", action = act.SpawnTab({ DomainName = "WSL:Ubuntu" }) },
}

-- Jump straight to tab 1-9 (CTRL+<n>). No Ghostty equivalent — standard terminal
-- convention. ActivateTab is 0-indexed, so CTRL+1 -> tab 0.
for i = 1, 9 do
	table.insert(config.keys, { key = tostring(i), mods = "CTRL", action = act.ActivateTab(i - 1) })
end

-- ---------------------------------------------------------------------------
-- MOUSE  — Windows-terminal conventions on top of the CTRL+SHIFT+C/V keybinds.
-- No Ghostty equivalent (mouse config is terminal-specific). Left-drag release copies
-- the selection AND still opens a hyperlink on a plain click (OrOpenLink keeps the
-- default link-open behavior); right-click pastes.
-- ---------------------------------------------------------------------------
config.mouse_bindings = {
	{
		event = { Up = { streak = 1, button = "Left" } },
		mods = "NONE",
		action = act.CompleteSelectionOrOpenLinkAtMouseCursor("ClipboardAndPrimarySelection"),
	},
	{
		event = { Down = { streak = 1, button = "Right" } },
		mods = "NONE",
		action = act.PasteFrom("Clipboard"),
	},
}

-- ---------------------------------------------------------------------------
-- REMOTE ACCESS — the homelab is reached via ssh + tmux (CTRL+SHIFT+H), NOT a
-- WezTerm mux domain. tmux is the portable multiplexer across machines; retiring the
-- mux domain also removes the CTRL+W GUI-hang class (which was the mux round-trip over
-- WireGuard). The agentview picker (CTRL+SHIFT+S) aggregates WSL + Windows (PC) + homelab
-- sessions and attaches to remote ones by spawning an ssh+tmux tab. Default domain
-- stays local; nothing to configure.
-- ---------------------------------------------------------------------------
config.ssh_domains = {}

-- ---------------------------------------------------------------------------
-- RELOAD FEEDBACK — WezTerm reloads config silently (on CTRL+SHIFT+R and on save
-- via automatic_reload). With no confirmation the reload key feels like a no-op, so
-- surface a short toast on every reload. But `window-config-reloaded` ALSO fires once
-- at startup, which pops an unwanted toast on launch — suppress that first fire via
-- wezterm.GLOBAL (persists across reloads, resets only on a full GUI restart).
-- ---------------------------------------------------------------------------
wezterm.on("window-config-reloaded", function(window)
	if not wezterm.GLOBAL.startup_toast_shown then
		wezterm.GLOBAL.startup_toast_shown = true
		return
	end
	window:toast_notification("WezTerm", "Configuration reloaded ✳", nil, 1500)
end)

-- ---------------------------------------------------------------------------
-- TAB TITLES — index + a domain glyph (WSL vs local Windows) + the pane title, so the
-- WSL / git-bash / agentview / homelab-ssh tabs are distinguishable at a glance. Prefer an
-- explicitly-set tab_title first: agentview stamps pane titles over OSC, and this only
-- computes one when the process left the default. No Ghostty equivalent (WezTerm-only).
-- ---------------------------------------------------------------------------
wezterm.on("format-tab-title", function(tab)
	local title = tab.tab_title
	if title == nil or title == "" then
		title = tab.active_pane.title
	end
	local glyph = (tab.active_pane.domain_name or ""):find("WSL") and " " or " "
	return string.format(" %d %s%s ", tab.tab_index + 1, glyph, title)
end)

-- ---------------------------------------------------------------------------
-- OPEN-URI — make file:// links that point INTO WSL actually openable.
-- WezTerm is a Windows process and the WSL shell is only a relay pane, so a clicked
-- hyperlink goes to Windows ShellExecute. `file:///home/daniel/report.html` then
-- resolves against the Windows root as C:\home\daniel\report.html and fails silently —
-- which is every path a WSL-side tool emits, Claude's HTML artifacts included.
-- Rewrite those onto the \\wsl.localhost share, which Windows does resolve (verified
-- 2026-07-29 from a native process: the share root, the distro tree and a 42KB file all
-- readable, under networkingMode=mirrored). Anything already meaningful to Windows —
-- a drive-letter path, an explicit host, a non-file scheme — is passed through
-- untouched rather than guessed at.
-- ---------------------------------------------------------------------------
local WSL_UNC_DISTRO = "Ubuntu"

-- Kept as a free function taking `distro`, with no upvalues and no wezterm calls, so the
-- test suite can lift it straight out of this template and exercise it under plain `lua`.
-- The Windows-only render tests skip on Linux, and this is the half worth checking.
local function wsl_file_uri_to_unc(uri, distro)
	local host, path = uri:match("^file://([^/]*)(/.*)$")
	if not path then
		return nil
	end
	-- An explicit host is either already a UNC target (file://wsl.localhost/...) or
	-- another machine entirely. Neither is ours to rewrite.
	if host ~= "" and host ~= "localhost" then
		return nil
	end
	local decoded = path:gsub("%%(%x%x)", function(hex)
		return string.char(tonumber(hex, 16))
	end)
	-- Decode BEFORE this check: file:///c%3A/... is a drive path too, and Windows
	-- already knows what to do with it.
	if decoded:match("^/%a[:|]") then
		return nil
	end
	-- A percent-escape that decodes to a separator or a NUL would let the link name one
	-- path and open another. Refuse instead of building it.
	if decoded:find("\\", 1, true) or decoded:find("\0", 1, true) then
		return nil
	end
	return "\\\\wsl.localhost\\" .. distro .. (decoded:gsub("/", "\\"))
end

wezterm.on("open-uri", function(window, pane, uri)
	local unc = wsl_file_uri_to_unc(uri, WSL_UNC_DISTRO)
	if not unc then
		return true -- not a WSL file link; let WezTerm handle it as usual
	end
	wezterm.open_with(unc)
	return false -- handled here; suppress the default open
end)

return config

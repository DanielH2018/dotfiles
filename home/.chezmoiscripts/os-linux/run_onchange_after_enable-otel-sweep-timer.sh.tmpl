#!/usr/bin/env bash
# Enable the daily telemetry-export check on daniel-box only; disable it on every other Linux
# host. From daniel-box, otel-sweep covers the local store, daniel-box and daniel-server, so a
# second copy on daniel-server was pure duplication. run_onchange re-runs (and reloads systemd)
# whenever the unit files or this gate change; their hashes are embedded so edits retrigger it,
# and the gate change itself retriggers it once on every host to clean up.
# Idempotent; a no-op where user systemd isn't running (macOS, a non-lingering headless box).
#   service: {{ include "dot_config/systemd/user/otel-sweep-watch.service" | sha256sum }}
#   timer:   {{ include "dot_config/systemd/user/otel-sweep-watch.timer" | sha256sum }}
set -eu
if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  systemctl --user daemon-reload || true
{{ if and (eq .chezmoi.hostname "daniel-box") (not (includeTemplate "is-agent" .)) -}}
  systemctl --user enable --now otel-sweep-watch.timer || true
{{ else -}}
  systemctl --user disable --now otel-sweep-watch.timer 2>/dev/null || true
{{ end -}}
fi

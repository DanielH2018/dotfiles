{
  "repo": {
    "name": "general",
    "type": "chezmoi",
    "path": "~/.local/share/chezmoi",
    "remote": "git@github.com:DanielH2018/dotfiles.git"
  },
  "ignore": {
    "globs": [
      "~/.claude/settings.json",
      "~/.claude/projects/**",
      "~/.config/gh/hosts.yml",
      "~/.cache/**",
      "~/.local/state/**",
      "~/.config/op/**",
      "~/.config/dotsync/INVENTORY.md",
      "~/.claude/plugins/**",
      "~/.claude/file-history/**",
      "~/.claude/shell-snapshots/**",
      "~/.claude/tasks/**",
      "~/.claude/plans/**",
      "~/.claude/backups/**",
      "~/.claude/paste-cache/**",
      "~/.claude/logs/**",
      "~/.claude/cache/**",
      "~/.claude/todos/**",
      "~/.claude/statsig/**",
      "~/.claude/sandbox/**",
      "~/.config/chezmoi/**",
      "~/.zsh_sessions/**",
      "~/.zsh_history",
      "~/.bash_history",
      "~/.zcompdump*",
      "~/.viminfo",
      "~/.python_history",
      "~/.node_repl_history",
      "~/.lesshst"
    ]
  }
}

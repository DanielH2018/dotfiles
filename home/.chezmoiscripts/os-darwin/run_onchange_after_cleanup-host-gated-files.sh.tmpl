{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# Managed by chezmoi (run_onchange). Clears stale copies of the hooks/test_*.py suites, which
# deploy to ~/.claude/hooks where none of them can run — each finds its subject by the source
# tree's executable_-prefixed name, which chezmoi strips before deploying. `.chezmoiremove`
# cannot do this: a target BOTH ignored (home/.chezmoiignore) and listed there is a silent
# no-op, verified against a scratch --destination before this script was written. See the
# matching os-linux and os-windows scripts for the other two platforms' share of the same
# cleanup — the desktop-only, sandbox and Warp cleanups there have no darwin counterpart:
# darwin was never in their target host set.
#
# Idempotent: every removal is skip-if-absent, and prints only what it actually took.
set -eu
TAG=cleanup-host-gated-files
# The glob is the same pattern home/.chezmoiignore uses, so chezmoi deploys nothing it matches
# and every regular file it matches is a leftover. A list of names missed the suites retired
# before this script existed. A symlink is skipped because chezmoi never deploys one here, so
# it belongs to the work overlay.
for p in "$HOME"/.claude/hooks/test_*.py "$HOME"/.claude/hooks/_testkit.py; do
  if [ -f "$p" ] && [ ! -L "$p" ]; then
    rm -f "$p"
    echo "$TAG: removed ${p#"$HOME"/}"
  fi
done
echo "$TAG: done."
{{- end -}}

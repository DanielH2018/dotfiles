#!/usr/bin/env bash
# cts — run claude-sandbox in its OWN named tmux session (sibling to `ct`), so Agent
# View captures a real tmux: locator for the session and <enter> can jump to it. A bare
# `claude-sandbox .` from a WezTerm/WSL shell registers backend:none — WEZTERM_PANE
# doesn't cross into WSL — and is not jumpable; running it inside tmux fixes that.
# Usage: cts [dir] [claude-sandbox args…]
#   dir defaults to $PWD; the first arg is the dir only if it isn't a flag. Everything
#   else forwards verbatim to claude-sandbox (e.g. -b BRANCH). The session name is
#   deterministic per repo(+branch), so re-running attaches instead of duplicating and
#   each worktree stays independently jumpable.
set -u

case "${1:-}" in
  -h|--help)
    echo "usage: cts [dir] [claude-sandbox args…]   run claude-sandbox in a named tmux session (local)"
    echo "       cts --ssh[=HOST] [remote-dir]       start a native claude tmux session on HOST over ssh"
    echo "                                           HOST defaults to daniel-server (\$CTS_REMOTE_HOST); also -H/--host HOST"
    exit 0 ;;
esac

# ---- remote (SSH) mode -------------------------------------------------------
# `cts --ssh [dir]` starts a NATIVE `claude` session inside a named tmux session on a
# remote host by invoking the deployed `ct` launcher over `ssh -t`, attaching to it now.
# `ct` uses `tmux new-session -A`, so re-running resumes rather than duplicates; the
# remote's Agent View state hook registers a tmux locator for it, so the session also
# shows up in `agentview` and can be re-entered later. Host defaults to daniel-server —
# the single homelab the picker aggregates — overridable with --ssh=HOST, -H/--host HOST,
# or $CTS_REMOTE_HOST. Only tmux/claude + the ct launcher are needed on the remote (no
# Docker/claude-sandbox). Note: an unquoted leading ~ in remote-dir is expanded by YOUR
# shell — quote it ('~/repo') or pass a plain path to expand on the remote; a remote path
# with spaces isn't supported.
_remote=0
for _a in "$@"; do case "$_a" in --ssh|--ssh=*|-H|--host) _remote=1; break ;; esac; done
if [ "$_remote" -eq 1 ]; then
  host="${CTS_REMOTE_HOST:-daniel-server}"
  rdir=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --ssh)     shift ;;
      --ssh=*)   host="${1#--ssh=}"; shift ;;
      -H|--host) host="${2:?cts: --host requires a HOST value}"; shift 2 ;;
      -*)        printf 'cts: unknown flag in --ssh mode: %s\n' "$1" >&2; exit 2 ;;
      *)         if [ -z "$rdir" ]; then rdir="$1"; shift
                 else printf 'cts: --ssh mode takes at most one remote-dir (extra: %s)\n' "$1" >&2; exit 2; fi ;;
    esac
  done
  [ -n "$host" ] || { printf 'cts: no remote host (set --host or $CTS_REMOTE_HOST)\n' >&2; exit 1; }
  command -v ssh >/dev/null 2>&1 || { printf 'cts: ssh not found on PATH\n' >&2; exit 1; }
  # ct is deployed to ~/.local/bin/ct; reference it explicitly since a non-login ssh shell
  # may not have ~/.local/bin on PATH. $HOME is expanded on the remote, not here.
  remote_ct="${CTS_REMOTE_CT:-\$HOME/.local/bin/ct}"
  if [ -n "$rdir" ]; then exec ssh -t "$host" "$remote_ct $rdir"; fi
  exec ssh -t "$host" "$remote_ct"
fi

command -v tmux >/dev/null 2>&1 || { printf 'cts: tmux not found on PATH\n' >&2; exit 1; }

# Resolve the launcher exactly as agentview does: prefer it on PATH, else its deployed path.
sandbox_bin="${CLAUDE_SANDBOX_BIN:-}"
if [ -z "$sandbox_bin" ]; then
  if command -v claude-sandbox >/dev/null 2>&1; then sandbox_bin="claude-sandbox"
  else sandbox_bin="$HOME/.claude/sandbox/claude-sandbox"; fi
fi

# First arg is the target dir only when it isn't a flag; the rest pass through.
dir="$PWD"
if [ "$#" -gt 0 ]; then
  case "$1" in
    -*) ;;
    *) dir="$1"; shift ;;
  esac
fi

# Absolute path -> a stable session name AND a clean repo arg for claude-sandbox.
absdir="$(cd "$dir" 2>/dev/null && pwd)" || { printf 'cts: no such directory: %s\n' "$dir" >&2; exit 1; }

# Session name mirrors ct's scheme (basename + 6-digit cksum of the abs path) with an
# `sb-` prefix so `tmux ls` distinguishes sandboxed sessions from host ones.
base="$(basename "$absdir" | tr -c 'a-zA-Z0-9._-' '-' | sed 's/^-*//;s/-*$//')"
[ -n "$base" ] || base="repo"
h="$(printf '%s' "$absdir" | cksum | cut -d' ' -f1)"
name="sb-${base}-${h: -6}"

# Give each worktree its own session: pull -b/-w's VALUE out of the passthrough args
# (skip if the next token is another flag — -w's name is optional).
branch=""
args=("$@")
i=0
while [ "$i" -lt "${#args[@]}" ]; do
  case "${args[$i]}" in
    -b|--branch|-w|--worktree)
      j=$((i + 1))
      if [ "$j" -lt "${#args[@]}" ]; then
        case "${args[$j]}" in -*) ;; *) branch="${args[$j]}" ;; esac
      fi ;;
  esac
  i=$((i + 1))
done
if [ -n "$branch" ]; then
  slug="$(printf '%s' "$branch" | tr -c 'a-zA-Z0-9._-' '-' | sed 's/^-*//;s/-*$//')"
  [ -n "$slug" ] && name="${name}-${slug}"
fi

# printf %q shell-quotes every element so tmux's `sh -c` re-parses it intact — the same
# pattern agentview's --spawn uses for new-window.
cmd="$(printf '%q ' "$sandbox_bin" "$absdir" "$@")"

if [ -z "${TMUX:-}" ]; then
  # Plain shell: attach-or-create. -A reuses a live session (never double-launches).
  exec tmux new-session -A -s "$name" -c "$absdir" "$cmd"
fi

# Inside tmux we can't nest an attach: jump if it's already live, else create it
# detached and switch the current client onto it.
if tmux has-session -t "$name" 2>/dev/null; then
  exec tmux switch-client -t "$name"
fi
tmux new-session -d -s "$name" -c "$absdir" "$cmd"
exec tmux switch-client -t "$name"

#!/bin/sh
# Managed by chezmoi (run_onchange). Installs a watchdog that recovers Bluetooth HID devices
# whose HID-over-GATT profile has wedged, plus a udev rule keeping the BT dongle awake.
#
# The fault, diagnosed 2026-08-03 on a Pebble M350s:
#
#     bluetoothd[1031]: profiles/input/hog-lib.c:report_map_read_cb() Report Map read failed:
#     Request attribute has encountered an unlikely error
#
# The LE link is genuinely fine afterwards — `bluetoothctl info` reports Connected, Bonded and a
# live battery percentage — but the peripheral refused the HID report-map read, so bluetoothd
# never created a uhid device and the mouse moves nothing. ATT error 0x0E is generated by the
# *peripheral*, which Logitech BT mice do in the not-ready window right after a reconnect, and
# BlueZ does not retry that read. So the profile stays wedged indefinitely.
#
# `bluetoothctl disconnect` + `connect` does NOT clear it (the reconnect does not even re-attempt
# the read). Only restarting bluetoothd does; the bond survives, so no re-pairing is needed.
#
# Rare — one occurrence in 14 days across a 24-boot journal — so this is a watchdog, not a fix.
# Unlike the reap timer these are *system* units restarting a *system* service, which is why they
# are written here rather than deployed as files under home/: chezmoi's source root is $HOME.
# Running as root keeps the automatic path free of any polkit or sudoers grant.
#
# The manual path costs exactly one narrow grant, and it is not avoidable. When the mouse wedges
# there is no pointer, so a hardware key is the one control surface left — but MIN_RESTART_INTERVAL
# below makes `systemctl start bt-hid-health.service` a no-op for up to 10 minutes, which is
# precisely when someone would press it. That limit exists to bound an *automatic* retry loop, not
# a deliberate human press, so the button gets its own unit running the watchdog with --force, and
# a polkit rule scoped to that one unit and that one verb.
#
# The udev rule is a second, weaker mitigation. btusb sets enable_autosuspend=Y and the adapter
# idles after 2s, so the radio is reliably asleep exactly when a HID peripheral reconnects.
# Whether that actually causes the refused read is unproven — the watchdog above is what is
# verified to recover the symptom. The rule matches one VID/PID and is inert on any other machine.
#
# Idempotent: rewrites the same bytes and reloads; run_onchange retriggers whenever this file
# changes, which covers the payloads below since they are inlined.
# bump-to-reinstall: bt-hid-recovery v2
set -u
TAG=setup-bt-hid-recovery
{{ includeTemplate "linux-install.sh" . }}

# --- Gate: is there a Bluetooth stack to babysit? --------------------------------------------
# Deliberately gated on the software stack, not on an adapter being plugged in right now: the
# watchdog exits immediately when no HID device is connected, so installing it on a machine
# whose dongle is currently absent costs nothing and survives plugging one in later.
command -v bluetoothctl >/dev/null 2>&1 || exit 0
systemctl list-unit-files bluetooth.service >/dev/null 2>&1 || exit 0

# exit 1, not 0: run_onchange records success by hash, so skipping quietly here would leave the
# watchdog uninstalled until this file next changes. Failing makes the next apply retry.
have_sudo || { echo "$TAG: needs sudo to install system units — re-run 'chezmoi apply' where sudo can prompt" >&2; exit 1; }

echo "$TAG: installing bt-hid-health watchdog"

sudo tee /usr/local/bin/bt-hid-health >/dev/null <<'BT_HID_HEALTH'
#!/usr/bin/env bash
# Recover Bluetooth HID devices wedged by a failed HoG report-map read.
# Installed by chezmoi (setup-bt-hid-recovery) — edit the source there, not here.
#
# --force is the Stream Deck key's path (via bt-hid-health-force.service). It skips the confirm
# delay and the rate limit, and restarts regardless of what the detector sees: both guards exist
# to bound an automatic retry loop, and a human pressing a key already knows the mouse is dead —
# possibly in a shape the detector misses, such as a device that dropped out of Connected
# entirely. It still writes the stamp, so the timer cannot pile a second restart on top of a
# manual one two minutes later.
set -uo pipefail

FORCE=0
[[ ${1:-} == --force ]] && FORCE=1

MIN_RESTART_INTERVAL=600 # seconds between restarts, guards against a restart loop
CONFIRM_DELAY=10         # seconds, to ignore the transient window during a normal connect
HID_UUID=00001812-0000-1000-8000-00805f9b34fb
STATE_DIR=/var/lib/bt-hid-health
STAMP="$STATE_DIR/last-restart"

log() { logger -t bt-hid-health -- "$*"; }

# Print the MAC of every connected HoG device that has no corresponding input node.
wedged_devices() {
	local mac info uniq
	while read -r _ mac _; do
		[ -n "${mac:-}" ] || continue
		info=$(bluetoothctl info "$mac" 2>/dev/null) || continue
		grep -qF "$HID_UUID" <<<"$info" || continue
		uniq=${mac,,}
		grep -qi "Uniq=$uniq" /proc/bus/input/devices || printf '%s\n' "$mac"
	done < <(bluetoothctl devices Connected 2>/dev/null)
}

mapfile -t wedged < <(wedged_devices)
if [ "$FORCE" -eq 0 ]; then
	[ "${#wedged[@]}" -gt 0 ] || exit 0

	# A device is briefly "connected with no input node" during any normal connect,
	# so only act once the condition survives a recheck.
	sleep "$CONFIRM_DELAY"
	mapfile -t wedged < <(wedged_devices)
	[ "${#wedged[@]}" -gt 0 ] || exit 0
fi

now=$(date +%s)
if [ "$FORCE" -eq 0 ] && [ -r "$STAMP" ]; then
	last=$(cat "$STAMP" 2>/dev/null || echo 0)
	[[ $last =~ ^[0-9]+$ ]] || last=0
	if [ $((now - last)) -lt "$MIN_RESTART_INTERVAL" ]; then
		log "still wedged (${wedged[*]}) but last restart was $((now - last))s ago; skipping"
		exit 0
	fi
fi

install -d -m 0755 "$STATE_DIR"
printf '%s\n' "$now" >"$STAMP"
log "restarting bluetooth.service to recover: ${wedged[*]:-none detected (forced)}"
# --no-block: this unit is ordered After=bluetooth.service, so waiting on a restart job for it
# from inside a oneshot risks a job conflict that would hang until TimeoutStartSec.
systemctl restart --no-block bluetooth
BT_HID_HEALTH
sudo chmod 0755 /usr/local/bin/bt-hid-health

sudo tee /etc/systemd/system/bt-hid-health.service >/dev/null <<'BT_HID_SERVICE'
[Unit]
Description=Restart bluetoothd if a Bluetooth HID device is connected but has no input node
Documentation=https://github.com/bluez/bluez/blob/master/profiles/input/hog-lib.c
After=bluetooth.service
ConditionPathExists=/usr/local/bin/bt-hid-health

[Service]
Type=oneshot
ExecStart=/usr/local/bin/bt-hid-health
# The check sleeps 10s to confirm; nothing here should ever approach this.
TimeoutStartSec=60
StateDirectory=bt-hid-health
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
BT_HID_SERVICE

# The Stream Deck key's unit. Separate from bt-hid-health.service rather than an argument on it,
# because `systemctl start` cannot pass one — and because the polkit grant below has to name a
# single unit, so the forced path must be nameable on its own.
sudo tee /etc/systemd/system/bt-hid-health-force.service >/dev/null <<'BT_HID_FORCE_SERVICE'
[Unit]
Description=Restart bluetoothd now to recover a wedged Bluetooth HID device (manual trigger)
After=bluetooth.service
ConditionPathExists=/usr/local/bin/bt-hid-health

[Service]
Type=oneshot
ExecStart=/usr/local/bin/bt-hid-health --force
# --force skips the 10s confirm delay, so this should return almost immediately.
TimeoutStartSec=30
StateDirectory=bt-hid-health
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
BT_HID_FORCE_SERVICE

# One user, one unit, one verb. Scoped this tightly because the grant is permanent and the thing
# it authorises restarts a system service: anything broader (the whole action id, or wheel) would
# hand out control of every unit on the box to buy one key.
#
# Matching on the username rather than subject.active/local on purpose. The Stream Deck runs the
# trigger through the Flatpak portal, whose spawned process is not reliably attached to the login
# session, so an active-session test would fail exactly when the button is pressed.
sudo tee /etc/polkit-1/rules.d/49-bt-hid-health-force.rules >/dev/null <<'BT_HID_POLKIT'
// Managed by chezmoi (setup-bt-hid-recovery). Lets the desktop user start the manual Bluetooth
// HID recovery unit without a password prompt -- there is no pointer to answer one with, which
// is the entire situation this recovers from.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "bt-hid-health-force.service" &&
        action.lookup("verb") == "start" &&
        subject.user == "{{ .chezmoi.username }}") {
        return polkit.Result.YES;
    }
});
BT_HID_POLKIT

sudo tee /etc/systemd/system/bt-hid-health.timer >/dev/null <<'BT_HID_TIMER'
[Unit]
Description=Periodically check for Bluetooth HID devices wedged with no input node

[Timer]
OnBootSec=3min
OnUnitActiveSec=2min
AccuracySec=30s
Unit=bt-hid-health.service

[Install]
WantedBy=timers.target
BT_HID_TIMER

# ASUS USB-BT500. One VID/PID, so this is inert on a machine without that dongle.
sudo tee /etc/udev/rules.d/50-bt500-no-autosuspend.rules >/dev/null <<'BT_UDEV'
# Keep the ASUS USB-BT500 permanently powered: btusb autosuspends it after 2s, so the radio is
# asleep at the moment a Bluetooth HID peripheral reconnects. Managed by chezmoi.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0b05", ATTR{idProduct}=="190e", TEST=="power/control", ATTR{power/control}="on"
BT_UDEV

command -v restorecon >/dev/null 2>&1 && sudo restorecon -F \
	/usr/local/bin/bt-hid-health \
	/etc/systemd/system/bt-hid-health.service \
	/etc/systemd/system/bt-hid-health-force.service \
	/etc/systemd/system/bt-hid-health.timer \
	/etc/polkit-1/rules.d/49-bt-hid-health-force.rules \
	/etc/udev/rules.d/50-bt500-no-autosuspend.rules 2>/dev/null

sudo systemctl daemon-reload
sudo systemctl enable --now bt-hid-health.timer >/dev/null 2>&1 \
	|| echo "$TAG: could not enable bt-hid-health.timer" >&2
sudo udevadm control --reload 2>/dev/null || true

echo "$TAG: bt-hid-health.timer active; journal tag 'bt-hid-health' records any recovery"
{{ end -}}

{{- if eq .chezmoi.os "windows" -}}
# Managed by chezmoi (run_onchange). Re-applies stored Windows customization after the
# app installer (name sorts after install-apps / install-node-lsps). Idempotent; re-runs
# only when this file or the referenced exports change.
#
# ExplorerPatcher: all HKCU, no elevation. Import re-applies the exported settings.
# Winaero Tweaker: no CLI import exists, so this only reminds you to import it in the GUI.
# bump-to-reinstall: win-tweaks v1

$ErrorActionPreference = 'Stop'
$PSNativeCommandUseErrorActionPreference = $false

$dir = Join-Path $env:USERPROFILE '.config\windows-provisioning'
$ep  = Join-Path $dir 'explorerpatcher.reg'

if (Get-Command reg.exe -ErrorAction SilentlyContinue) {
    if ((Test-Path $ep) -and (Test-Path 'HKCU:\Software\ExplorerPatcher')) {
        Write-Host "[apply] ExplorerPatcher settings <- explorerpatcher.reg"
        reg.exe import $ep 2>&1 | Out-Null
        Write-Host "        (restart File Explorer for changes to take full effect)"
    } elseif (Test-Path $ep) {
        Write-Host "[skip] ExplorerPatcher not installed yet; re-run 'chezmoi apply' after it installs."
    }
}

Write-Host "[manual] Winaero Tweaker has no CLI import. Open Winaero -> Tools -> Import and"
Write-Host "         select $dir\winaero-tweaker.ini"

# Put ~/.local/bin and ~/bin on the *User* PATH so name-resolution works in ANY
# Windows-spawned process, not just login shells that source the profile. This matters
# because the WezTerm CTRL+SHIFT+S keybind launches `bash --noprofile --norc -c agentview`
# (no profile, for speed): it only finds `agentview` + the `jq` LF-shim (both in
# ~/.local/bin) and TaskbarAutoHideFix.exe (~/bin) if these dirs are on the Windows PATH.
# Idempotent (append-if-missing); User scope = no elevation.
$userPath = [Environment]::GetEnvironmentVariable('Path', 'User')
foreach ($sub in '.local\bin', 'bin') {
    $d = Join-Path $env:USERPROFILE $sub
    if (($userPath -split ';') -notcontains $d) {
        $userPath = $userPath.TrimEnd(';') + ';' + $d
        [Environment]::SetEnvironmentVariable('Path', $userPath, 'User')
        Write-Host "[apply] added $d to the User PATH (open a new shell to pick it up)"
    } else {
        Write-Host "[skip] $d already on the User PATH"
    }
}
{{- end -}}

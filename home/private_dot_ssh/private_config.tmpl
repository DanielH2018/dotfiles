# Managed by chezmoi — edit home/private_dot_ssh/private_config, not ~/.ssh/config.

Host daniel-server homelab
    HostName 10.0.0.161
    User ubuntu
    IdentityFile ~/.ssh/daniel-server
    # Renders Claude Code's artifact links. The server serves ~/.claude/artifacts on
    # loopback, which VS Code Remote-SSH forwarded automatically and a plain ssh
    # session does not, so http://127.0.0.1:8182/... only resolves with this in place.
    # sshd allows it via `Match User ubuntu -> AllowTcpForwarding local`; -R stays off.
    #
    # 8182, not the 8181 default, because this machine runs its own artifact server on
    # 8181 (the SessionStart hook is gated on linux, and WSL is linux). Sharing the port
    # means this forward can't bind and the browser quietly hits the local server, which
    # lists local artifacts and 404s every remote one. daniel-server sets a matching
    # CLAUDE_ARTIFACTS_PORT=8182 in settings.base.json so the links it emits agree.
    LocalForward 127.0.0.1:8182 127.0.0.1:8182

Host daniel-pi
    HostName 10.0.0.139
    User ubuntu
    IdentityFile ~/.ssh/daniel-pi
    ServerAliveInterval 60
    ServerAliveCountMax 10

Host daniel-box
    HostName 10.0.0.215
    User ubuntu
    # The machines authenticate here differently: Windows has a per-host key, Fedora uses
    # the default key — that's what bring-up's ssh-copy-id installed. This used to list
    # both unconditionally and rely on ssh skipping a missing IdentityFile, but ssh warns
    # `no such identity: ~/.ssh/daniel-box` on every Fedora connection, so gate it instead.
    #
    # The `daniel-box` keypair on the shared NTFS drive is WINDOWS key material (comment
    # daniel@windows); don't copy it here. Per the fedora-homelab-keys convention,
    # generate separate Fedora material if this host should get a per-host key — and drop
    # the gate below if you do.
{{- if eq .chezmoi.os "windows" }}
    IdentityFile ~/.ssh/daniel-box
{{- end }}
    IdentityFile ~/.ssh/id_ed25519
